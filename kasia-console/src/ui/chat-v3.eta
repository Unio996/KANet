<%~ include('partials/page-open', { _page: 'chat', ...it }) %>

<style>
.thinking-dots span { display:inline-block; width:5px; height:5px; margin:0 2px; border-radius:50%; background:#9496a1; animation:thinking 1.4s infinite; }
.thinking-dots span:nth-child(2) { animation-delay:.2s; }
.thinking-dots span:nth-child(3) { animation-delay:.4s; }
@keyframes thinking { 0%,80%,100%{opacity:.3;transform:scale(.8)} 40%{opacity:1;transform:scale(1)} }
</style>

<div class="flex h-[calc(100vh-0px)]" x-data="{
  channel: '',
  messages: [],
  accounts: <%= JSON.stringify(it.relays.map(r => ({ id: r.id, name: r.name, address: r.address }))) %>,
  selectedAccount: '<%= it.relays[0]?.id || '' %>',
  mode: 'local',
  msgInput: '',
  sending: false,
  error: '',
  polling: null,
  lastTime: '',

  // Channel sidebar state
  channels: [],
  newChannelInput: 'kanet-public',
  lastChainChannel: '',
  channelsLastChecked: '',  // 页面加载基线时间，不随轮询更新
  _readChannels: new Set(),  // 本次会话已读频道，loadChannels 后清零其 new_count
  contextMenu: null,
  newChannelDesc: '',
  contextTimeout: null,

  async init() {
    this.newChannelInput = 'kanet-public';
    // 首次加载用 1 小时前作为基线，显示近期未读
    this.channelsLastChecked = new Date(Date.now() - 3600000).toISOString();
    await this.loadChannels(this.channelsLastChecked);
    if (this.mode === 'local') {
      this.channel = this._agentChannel();
    } else {
      this.channel = this.channels.length > 0 ? this.channels[0].channel_name : 'kanet-public';
      this.newChannelInput = this.channel;
    }
    // 过滤掉内部频道（_local 后缀），只显示链上频道
    this.channels = this.channels.filter(ch => !ch.channel_name.endsWith('_local'));
    await this.loadMessages();
    this.polling = setInterval(() => this.poll(), 3000);
  },

  // ── Channel list management ──────────────────────────────────────────

  async loadChannels(after) {
    try {
      let url = '/api/chat/channels';
      if (after) url += '?after=' + encodeURIComponent(after);
      const res = await fetch(url);
      const data = await res.json();
      const localChannels = this._loadLocalChannels();
      const serverChannels = (data.channels || []).map(c => ({ ...c, source: 'server' }));
      this.channels = this._mergeChannels(localChannels, serverChannels);
      // 已读频道清零 new_count
      for (const ch of this.channels) {
        if (this._readChannels.has(ch.channel_name)) ch.new_count = 0;
      }
      // 过滤掉内部频道（_local 后缀），只显示链上频道
      this.channels = this.channels.filter(ch => !ch.channel_name.endsWith('_local'));
    } catch {}
  },

  _mergeChannels(local, server) {
    const map = new Map();
    for (const ch of local) map.set(ch.channel_name, { ...ch, source: 'local' });
    for (const ch of server) {
      const existing = map.get(ch.channel_name);
      if (existing) {
        map.set(ch.channel_name, {
          channel_name: ch.channel_name,
          description: ch.description || existing.description || null,
          msg_count: Math.max(existing.msg_count || 0, ch.msg_count || 0),
          new_count: ch.new_count || existing.new_count || 0,
          last_message_at: new Date(ch.last_message_at) > new Date(existing.last_message_at)
            ? ch.last_message_at : existing.last_message_at,
          source: ch.source === 'local' ? 'local' : 'server'
        });
      } else {
        map.set(ch.channel_name, { ...ch, source: 'server' });
      }
    }
    return [...map.values()].sort((a, b) => {
      const ta = a.last_message_at ? new Date(a.last_message_at).getTime() : 0;
      const tb = b.last_message_at ? new Date(b.last_message_at).getTime() : 0;
      return tb - ta;
    });
  },

  _persistChannels() {
    try {
      const local = this.channels.filter(ch => ch.source === 'local');
      localStorage.setItem('chat_channels', JSON.stringify(local));
    } catch {}
  },

  _loadLocalChannels() {
    try {
      const raw = localStorage.getItem('chat_channels');
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return parsed.filter(ch => !ch.channel_name.endsWith('_local'));
    } catch { return []; }
  },

  async joinChannel() {
    const trimmed = this.newChannelInput.trim();
    if (!trimmed) return;
    const desc = this.newChannelDesc.trim() || undefined;
    // 切到链上模式 + 创建/更新频道记录
    this.mode = 'chain';
    this.lastChainChannel = trimmed;
    try {
      await fetch('/api/chat/channels', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: trimmed, description: desc }) });
    } catch {}
    // 已存在 → 直接切换
    const exists = this.channels.find(ch => ch.channel_name === trimmed);
    if (!exists) {
      const newCh = { channel_name: trimmed, description: desc || null, msg_count: 0, last_message_at: null, source: 'local' };
      this.channels = [newCh, ...this.channels];
      this._persistChannels();
    }
    this.channel = trimmed;
    this.messages = [];
    this.lastTime = '';
    this.newChannelDesc = '';
    await this.loadMessages();
  },

  async leaveChannel(channelName) {
    this.channels = this.channels.filter(ch => ch.channel_name !== channelName);
    this._persistChannels();
    try {
      await fetch('/api/chat/channels/' + encodeURIComponent(channelName), { method: 'DELETE' });
    } catch {}
    this.hideContextMenu();
    if (this.channel === channelName) {
      const first = this.channels[0];
      if (first) { this.channel = first.channel_name; this.messages = []; this.lastTime = ''; this.loadMessages(); }
    }
  },

  async refreshChannels() {
    await this.loadChannels();
    if (!this.channels.find(ch => ch.channel_name === this.channel)) {
      const first = this.channels[0];
      if (first) { this.channel = first.channel_name; this.messages = []; this.lastTime = ''; this.loadMessages(); }
    }
  },

  async editChannelDesc(ch) {
    this.hideContextMenu();
    const trimmed = window.prompt('编辑备注:', ch.description || '');
    if (trimmed === null) return; // cancelled
    try {
      await fetch('/api/chat/channels', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: ch.channel_name, description: trimmed || null }) });
    } catch { return; }
    ch.description = trimmed || null;
    await this.loadChannels(this.channelsLastChecked || undefined);
  },

  // ── Context menu ──────────────────────────────────────────────────────

  showContextMenu(channel, event) {
    event.preventDefault();
    this.contextMenu = { channel, x: event.clientX, y: event.clientY };
  },

  hideContextMenu() {
    this.contextMenu = null;
    if (this.contextTimeout) { clearTimeout(this.contextTimeout); this.contextTimeout = null; }
  },

  startLongPress(channel, event) {
    this.contextTimeout = setTimeout(() => {
      const cx = event.touches?.[0]?.clientX || window.innerWidth / 2;
      const cy = event.touches?.[0]?.clientY || window.innerHeight / 2;
      this.showContextMenu(channel, { preventDefault: () => {}, clientX: cx, clientY: cy });
    }, 500);
  },

  endLongPress() {
    if (this.contextTimeout) { clearTimeout(this.contextTimeout); this.contextTimeout = null; }
  },

  // ── UI helpers ────────────────────────────────────────────────────────

  relativeTime(dateStr) {
    if (!dateStr) return '';
    try {
      const diff = Date.now() - new Date(dateStr).getTime();
      const mins = Math.floor(diff / 60000);
      if (mins < 1) return '刚刚';
      if (mins < 60) return mins + '分钟前';
      const hours = Math.floor(mins / 60);
      if (hours < 24) return hours + '小时前';
      return Math.floor(hours / 24) + '天前';
    } catch { return dateStr; }
  },

  channelIconClass() {
    return 'text-ink-500';
  },

  channelActive(name) { return this.mode === 'chain' && this.channel === name; },
  displayChannelName(name) {
    // Strip _local suffix for display
    return name && name.endsWith('_local') ? name.slice(0, -6) : name;
  },

  // ── Original chat methods ────────────────────────────────────────────

  _agentChannel() {
    if (this.selectedAccount === '__all__') return 'group_local';
    const acct = this.accounts.find(a => a.id === this.selectedAccount);
    return acct ? acct.name + '_local' : 'home_local';
  },
  switchAgent() {
    if (this.mode === 'local') { this.channel = this._agentChannel(); this.messages = []; this.lastTime = ''; this.loadMessages(); }
  },
  async loadMessages() {
    try {
      const res = await fetch('/api/chat/messages?channel=' + encodeURIComponent(this.channel) + '&limit=100');
      const data = await res.json();
      this.messages = data.messages || [];
      if (this.messages.length > 0) this.lastTime = this.messages[this.messages.length - 1].created_at;
      this.$nextTick(() => this.scrollBottom());
    } catch {}
  },
  async poll() {
    if (!this.lastTime) return this.loadMessages();
    try {
      const res = await fetch('/api/chat/messages?channel=' + encodeURIComponent(this.channel) + '&after=' + encodeURIComponent(this.lastTime));
      const data = await res.json();
      if (data.messages?.length > 0) {
        this.messages.push(...data.messages);
        this.lastTime = data.messages[data.messages.length - 1].created_at;
        this.$nextTick(() => this.scrollBottom());
      }
    } catch {}
    // 同时刷新频道列表未读数
    await this.loadChannels(this.channelsLastChecked || undefined);
  },
  async send() {
    if (!this.msgInput.trim() || !this.selectedAccount || this.sending) return;
    const content = this.msgInput.trim();
    this.msgInput = ''; this.error = ''; this.sending = true;
    const now = new Date().toISOString();
    this.messages.push({ id: 'temp-' + Date.now(), sender_address: 'owner:' + this.selectedAccount, content, created_at: now, _temp: true });
    const isGroup = this.selectedAccount === '__all__';
    const targets = isGroup ? this.accounts : [this.accounts.find(a => a.id === this.selectedAccount)].filter(Boolean);
    for (const acct of targets) this.messages.push({ id: 'thinking-' + acct.id, sender_address: acct.address, content: '', created_at: now, _thinking: true });
    this.$nextTick(() => this.scrollBottom());
    if (this.polling) clearInterval(this.polling);
    try {
      const endpoint = this.mode === 'local' ? '/api/chat/local' : '/api/chat/send';
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ relayId: this.selectedAccount, channel: this.channel, message: content }) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Send failed');
    } catch (e) { this.error = e.message; }
    await this.loadMessages(); this.sending = false;
    this.polling = setInterval(() => this.poll(), 3000);
  },
  scrollBottom() { const el = document.getElementById('chat-messages'); if (el) el.scrollTop = el.scrollHeight; },
  displayName(addr) { if (!addr) return '?'; if (addr.startsWith('owner:')) return 'You'; const acct = this.accounts.find(a => a.address === addr); return acct ? acct.name : addr.slice(-8); },
  isMe(addr) { return addr && addr.startsWith('owner:'); },
  isLocalAgent(addr) { return this.accounts.some(a => a.address === addr); },
  isConfirmCard(c) { if (!c) return false; try { const p = JSON.parse(c); return p.type === 'confirm' && p.token; } catch { return false; } },
  isQueryCard(c) { if (!c) return false; try { const p = JSON.parse(c); return p.type === 'query_card'; } catch { return false; } },
  parseCard(c) { try { return JSON.parse(c); } catch { return null; } },
  cardDataEntries(data) { if (!data || typeof data !== 'object') return []; const e = []; const f = (o, p) => { for (const [k,v] of Object.entries(o)) { if (v == null) continue; const key = p ? p+'.'+k : k; if (Array.isArray(v)) e.push([key, v.length+' items']); else if (typeof v === 'object') f(v,key); else e.push([key, String(v)]); } }; f(data,''); return e.slice(0,12); },
  async doConfirm(msg) { const card = this.parseCard(msg.content); if (!card) return; try { const r = await fetch('/api/chat/confirm', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({relayNodeId:this.selectedAccount,token:card.token}) }); const d = await r.json(); msg.content = d.ok ? '已执行: ' + (typeof d.result === 'string' ? d.result : JSON.stringify(d.result)) : '失败: ' + (d.error||'unknown'); } catch(e) { msg.content = '执行失败: ' + e.message; } },
  fmtTime(t) { if (!t) return ''; try { return new Date(t).toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'}); } catch { return t; } },
}">

  <!-- Left: Channel list + Agent selector -->
  <div class="w-56 border-r border-warm-200 flex flex-col bg-warm-50/50 flex-shrink-0">
    <!-- Top: Channel section (flex-1) -->
    <div class="flex flex-col min-h-0 flex-1">
      <!-- Channel header -->
      <div class="px-3 py-2.5 border-b border-warm-200 flex items-center justify-between">
        <span class="text-xs font-semibold text-ink-500 uppercase tracking-wider">频道</span>
        <button @click="refreshChannels()" class="text-ink-400 hover:text-ink-600 transition-colors p-0.5" title="刷新频道列表">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </button>
      </div>

      <!-- Add channel input -->
      <div class="px-3 py-1.5 border-b border-warm-200">
        <div class="flex gap-1 mb-1">
          <input x-model="newChannelInput" @keydown.enter="joinChannel()"
            placeholder="输入频道名..."
            class="flex-1 text-xs border border-warm-200 rounded px-2 py-1.5 bg-white focus:outline-none focus:border-brand-300" />
          <button @click="joinChannel()"
            class="text-brand-500 hover:text-brand-700 px-1.5 transition-colors" title="加入频道">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          </button>
        </div>
        <input x-model="newChannelDesc" @keydown.enter="joinChannel()"
          placeholder="备注（可选）"
          class="w-full text-xs border border-warm-200 rounded px-2 py-1 bg-white focus:outline-none focus:border-brand-300" />
      </div>

      <!-- Channel list -->
      <div class="flex-1 overflow-y-auto px-1 py-1">
        <template x-for="ch in channels" :key="ch.channel_name">
          <button @click="mode='chain'; lastChainChannel=ch.channel_name; channel=ch.channel_name; ch.new_count=0; _readChannels.add(ch.channel_name); messages=[]; lastTime=''; loadMessages()"
            @contextmenu="showContextMenu(ch, $event)"
            @touchstart="startLongPress(ch, $event)"
            @touchend="endLongPress()"
            @touchmove="endLongPress()"
            @mousedown="hideContextMenu()"
            class="w-full flex flex-col items-start gap-0 px-2 py-1.5 rounded-md text-left transition-colors mb-0.5 min-h-[28px]"
            :class="channelActive(ch.channel_name)
              ? 'bg-brand-50 text-brand-600 font-medium'
              : ch.new_count ? 'text-ink-800 font-semibold hover:bg-warm-100' : 'text-ink-600 hover:bg-warm-100'">
            <div class="flex items-center gap-1.5 w-full min-w-0">
              <span class="font-bold text-[11px] flex-shrink-0" :class="channelIconClass(ch.channel_name)">#</span>
              <span class="flex-1 truncate" x-text="displayChannelName(ch.channel_name)"></span>
              <span x-show="ch.new_count" class="text-[10px] bg-brand-500 text-white rounded-full px-1.5 min-w-[18px] text-center flex-shrink-0" x-text="ch.new_count"></span>
              <span x-show="!ch.new_count" class="text-[10px] text-ink-300 tabular-nums flex-shrink-0" x-text="ch.msg_count || ''"></span>
              <span class="text-[10px] text-ink-300 tabular-nums flex-shrink-0 hidden lg:inline" x-show="ch.last_message_at && !ch.new_count" x-text="relativeTime(ch.last_message_at)"></span>
            </div>
            <span class="text-[9px] text-ink-300 truncate w-full" x-show="ch.description" x-text="ch.description"></span>
          </button>
        </template>
      </div>
    </div>

    <!-- Separator -->
    <div class="border-t border-warm-200"></div>

    <!-- Bottom: Agent selector + mode toggle -->
    <div class="px-3 py-3 border-b border-warm-200 space-y-2">
      <select x-model="selectedAccount" @change="switchAgent()"
        class="w-full bg-white border border-warm-200 rounded-lg px-3 py-2 text-sm text-ink-700 focus:outline-none focus:border-brand-400">
        <template x-for="a in accounts" :key="a.id">
          <option :value="a.id" x-text="a.name"></option>
        </template>
        <option value="__all__">全体 Agent</option>
      </select>
      <div class="flex gap-1">
        <button @click="lastChainChannel=channel; mode='local'; channel=_agentChannel(); messages=[]; lastTime=''; loadMessages();"
          class="flex-1 text-[11px] py-1 rounded transition-colors"
          :class="mode==='local' ? 'bg-green-50 text-green-700 font-medium' : 'text-ink-400 hover:bg-warm-100'">
          内部
        </button>
        <button @click="mode='chain'; channel=lastChainChannel||channel||'kanet-public'; newChannelInput=channel; messages=[]; lastTime=''; loadMessages();"
          class="flex-1 text-[11px] py-1 rounded transition-colors"
          :class="mode==='chain' ? 'bg-brand-50 text-brand-700 font-medium' : 'text-ink-400 hover:bg-warm-100'">
          链上
        </button>
      </div>
    </div>
  </div>

  <!-- Right: conversation -->
  <div class="flex-1 flex flex-col min-w-0">
    <!-- Header -->
    <div class="px-5 py-3 border-b border-warm-200 flex items-center justify-between bg-white flex-shrink-0">
      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold text-ink-700">
          <template x-if="mode === 'local'">
            <span x-text="selectedAccount === '__all__' ? '全体对话' : displayChannelName(_agentChannel())"></span>
          </template>
          <template x-if="mode === 'chain'">
            <span>#<span x-text="channel"></span></span>
          </template>
        </span>
        <span class="text-xs text-ink-300" x-text="messages.length + ' 条'"></span>
      </div>
    </div>

    <!-- Messages -->
    <div id="chat-messages" class="flex-1 overflow-y-auto px-5 py-4 space-y-3">
      <div x-show="messages.length === 0" class="flex items-center justify-center h-full">
        <div class="text-center text-ink-300 text-sm">
          <p x-text="mode==='local' ? '和 ' + displayChannelName(_agentChannel()) + ' 说点什么' : '#' + channel + ' 暂无消息'"></p>
        </div>
      </div>

      <template x-for="msg in messages" :key="msg.id">
        <div class="flex gap-2.5" :class="isMe(msg.sender_address) ? 'flex-row-reverse' : ''">
          <!-- Avatar -->
          <div class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-bold"
            :class="isMe(msg.sender_address) ? 'bg-brand-100 text-brand-600' : isLocalAgent(msg.sender_address) ? 'bg-green-50 text-green-600' : 'bg-warm-200 text-ink-400'"
            x-text="displayName(msg.sender_address).slice(0,2)"></div>
          <!-- Bubble -->
          <div class="max-w-[70%]">
            <div x-show="!isMe(msg.sender_address)" class="text-[10px] font-medium mb-0.5"
              :class="isLocalAgent(msg.sender_address) ? 'text-green-600' : 'text-ink-400'"
              x-text="displayName(msg.sender_address)"></div>
            <div class="rounded-xl px-3.5 py-2 text-sm leading-relaxed"
              :class="isMe(msg.sender_address)
                ? 'bg-brand-500 text-white rounded-br-sm'
                : 'bg-white border border-warm-200 text-ink-700 rounded-bl-sm shadow-sm'">
              <template x-if="msg._thinking">
                <div class="thinking-dots py-1"><span></span><span></span><span></span></div>
              </template>
              <template x-if="!msg._thinking && !isConfirmCard(msg.content) && !isQueryCard(msg.content)">
                <p class="whitespace-pre-wrap" x-text="msg.content"></p>
              </template>
              <!-- Query card -->
              <template x-if="!msg._thinking && isQueryCard(msg.content)">
                <div>
                  <div class="bg-brand-50 border border-brand-100 rounded-lg p-2.5 mb-1.5">
                    <div class="text-[10px] font-semibold text-brand-700 mb-1.5" x-text="parseCard(msg.content)?.label"></div>
                    <div class="grid grid-cols-2 gap-x-3 gap-y-0.5 text-[11px]">
                      <template x-for="[k,v] in cardDataEntries(parseCard(msg.content)?.data)" :key="k">
                        <div class="contents">
                          <span class="text-brand-400 truncate" x-text="k"></span>
                          <span class="text-brand-800 font-mono text-right" x-text="v"></span>
                        </div>
                      </template>
                    </div>
                  </div>
                  <p class="text-sm" x-text="parseCard(msg.content)?.summary"></p>
                </div>
              </template>
              <!-- Confirm card -->
              <template x-if="!msg._thinking && isConfirmCard(msg.content)">
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-2.5 my-0.5">
                  <div class="text-[10px] font-semibold text-amber-800 mb-1.5" x-text="'待确认：' + parseCard(msg.content)?.label"></div>
                  <div class="text-[11px] text-amber-700 space-y-0.5 mb-2">
                    <template x-for="[k,v] in Object.entries(parseCard(msg.content)?.params || {})" :key="k">
                      <div><span class="font-medium" x-text="k"></span>: <span class="font-mono" x-text="v"></span></div>
                    </template>
                  </div>
                  <div class="flex gap-2">
                    <button @click="doConfirm(msg)" class="px-2.5 py-1 text-[11px] font-medium text-white bg-amber-600 rounded hover:bg-amber-700">确认</button>
                    <button @click="msg.content='已取消'" class="px-2.5 py-1 text-[11px] font-medium text-amber-700 bg-white border border-amber-300 rounded hover:bg-amber-50">取消</button>
                  </div>
                  <div class="text-[9px] text-amber-400 mt-1">30秒后过期</div>
                </div>
              </template>
            </div>
            <div x-show="!msg._temp && !msg._thinking" class="text-[10px] text-ink-300 mt-0.5 px-1"
              :class="isMe(msg.sender_address) ? 'text-right' : ''"
              x-text="fmtTime(msg.created_at)"></div>
          </div>
        </div>
      </template>
    </div>

    <!-- Input -->
    <div class="px-5 py-3 border-t border-warm-200 bg-white flex-shrink-0">
      <div class="flex gap-2 items-end">
        <input type="text" x-model="msgInput" @keydown.enter="send()"
          :placeholder="mode!=='local' ? '链上广播...' : selectedAccount==='__all__' ? '对全体 Agent 说...' : '对 ' + displayChannelName(_agentChannel()) + ' 说...'"
          class="flex-1 px-4 py-2.5 border border-warm-200 rounded-xl text-sm text-ink-700 placeholder-ink-300 bg-warm-50/50 focus:outline-none focus:border-brand-400 focus:ring-1 focus:ring-brand-100" />
        <button @click="send()" :disabled="sending || !msgInput.trim()"
          class="px-5 py-2.5 rounded-xl text-sm font-medium transition-colors flex-shrink-0"
          :class="sending || !msgInput.trim() ? 'bg-warm-200 text-ink-300' : 'bg-brand-500 text-white hover:bg-brand-600'">
          <span x-show="!sending">发送</span>
          <span x-show="sending">...</span>
        </button>
      </div>
      <div x-show="error" class="mt-1 text-xs text-red-500" x-text="error"></div>
    </div>
  </div>

  <!-- Context menu -->
  <div x-show="contextMenu"
    x-bind:style="'position:fixed;left:'+Math.min(contextMenu.x, window.innerWidth-180)+'px;top:'+Math.min(contextMenu.y, window.innerHeight-90)+'px'"
    @click.outside="hideContextMenu()"
    @mousedown.stop
    class="bg-white border border-warm-200 rounded shadow-md z-50 text-xs w-28">
    <button @click="editChannelDesc(contextMenu.channel)"
      class="w-full text-left px-3 py-2 hover:bg-warm-100 text-ink-700 transition-colors border-b border-warm-100">
      编辑备注
    </button>
    <button @click="leaveChannel(contextMenu.channel.channel_name)"
      class="w-full text-left px-3 py-2 hover:bg-warm-100 text-red-600 transition-colors">
      退出频道
    </button>
  </div>

</div>

<%~ include('partials/page-close', it) %>

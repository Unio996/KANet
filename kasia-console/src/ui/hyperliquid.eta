<%~ include('partials/page-open', { _page: 'hyperliquid', pageTitle: 'Hyperliquid Perps', ...it }) %>

<div class="h-full flex flex-col" x-data="hyperApp()">

  <!-- ═══ HEADER ═══ -->
  <div class="flex-shrink-0 bg-white border-b border-warm-200 px-5 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center text-white font-bold text-xs">H</div>
      <div>
        <div class="text-sm font-semibold text-ink-700">Hyperliquid Perpetuals</div>
        <div class="text-[10px] text-ink-400">On-chain perps with orderbook — Arbitrum deposits</div>
      </div>
    </div>
    <div class="flex items-center gap-3 text-xs">
      <button @click="loadAll(); loadIntel()" class="text-brand-500 hover:text-brand-700 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Refresh
      </button>
    </div>
  </div>

  <!-- ═══ CONNECTION BAR ═══ -->
  <div class="flex-shrink-0 border-b border-warm-200 px-5 py-2.5"
       :class="selectedWalletId ? 'bg-gradient-to-r from-green-50 to-emerald-50' : 'bg-gradient-to-r from-amber-50 to-orange-50'">
    <div class="flex items-center justify-between">
      <!-- Disconnected state -->
      <template x-if="!selectedWalletId">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></div>
          <span class="text-xs font-medium text-amber-800">Not connected</span>
          <span class="text-[11px] text-amber-600" x-show="arbWallets.length === 0">No Arbitrum wallet in any agent. Create one in /agent.</span>
          <span class="text-[11px] text-amber-600" x-show="arbWallets.length > 0" x-text="arbWallets.length + ' Arbitrum wallet(s) available — click Connect'"></span>
        </div>
      </template>
      <!-- Connected state -->
      <template x-if="selectedWalletId">
        <div class="flex items-center gap-4 text-xs">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-green-500"></div>
            <span class="font-semibold text-green-800">Connected</span>
          </div>
          <div class="text-ink-600">
            <span x-text="connectedWallet?.name"></span>
            <span class="font-mono text-ink-400" x-text="' · ' + connectedWallet?.address?.slice(0,6) + '...' + connectedWallet?.address?.slice(-4)"></span>
          </div>
          <!-- Two-sided balance view: Arbitrum wallet vs Hyperliquid account -->
          <div class="flex items-center gap-2 text-[11px]">
            <div class="bg-white border border-warm-200 rounded px-2 py-0.5">
              <span class="text-[9px] text-ink-400 uppercase">Arb Wallet</span>
              <span class="ml-1 font-semibold tabular-nums" x-text="(arbBalances.usdc || 0).toFixed(2) + ' USDC'"></span>
              <span class="ml-1 text-[9px] text-ink-400 tabular-nums" x-text="'· ' + (arbBalances.eth || 0).toFixed(4) + ' ETH'"></span>
            </div>
            <span class="text-ink-400">→</span>
            <div class="bg-white border border-warm-200 rounded px-2 py-0.5">
              <span class="text-[9px] text-ink-400 uppercase">Hyperliquid</span>
              <span class="ml-1 font-semibold tabular-nums" x-text="'$' + (account.accountValue || 0).toFixed(2)"></span>
              <span class="ml-1 text-[9px] text-ink-400" x-text="positions.length + ' pos'"></span>
            </div>
          </div>
        </div>
      </template>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <template x-if="!selectedWalletId">
          <div class="flex items-center gap-2" x-show="arbWallets.length > 0">
            <select x-model="pendingWalletId" class="pl-2 pr-6 py-1 border border-warm-200 rounded text-[11px] bg-white">
              <option value="">— choose wallet —</option>
              <template x-for="w in arbWallets" :key="w.id">
                <option :value="w.id" x-text="w.name + ' · ' + w.address?.slice(0,6) + '...' + w.address?.slice(-4)"></option>
              </template>
            </select>
            <button @click="connect()" :disabled="!pendingWalletId" class="px-3 py-1 bg-green-500 text-white rounded text-[11px] font-medium hover:bg-green-600 disabled:opacity-40">
              🔌 Connect
            </button>
          </div>
        </template>
        <template x-if="selectedWalletId">
          <div class="flex items-center gap-2">
            <button @click="openDeposit()" :disabled="(arbBalances.usdc || 0) < 5"
                    class="px-3 py-1 bg-brand-500 text-white rounded text-[11px] font-medium hover:bg-brand-600 disabled:opacity-40"
                    :title="(arbBalances.usdc || 0) < 5 ? 'Need at least 5 USDC in Arb wallet' : 'Deposit USDC to Hyperliquid'">
              💰 充值
            </button>
            <button @click="openWithdraw()" :disabled="(account.available || 0) < 2"
                    class="px-3 py-1 bg-white border border-warm-300 text-ink-700 rounded text-[11px] font-medium hover:bg-warm-50 disabled:opacity-40"
                    :title="(account.available || 0) < 2 ? 'HL 可用余额不足 2 USDC' : '从 HL 提回 Arbitrum'">
              ↩ 提现
            </button>
            <button @click="disconnect()" class="px-3 py-1 bg-white border border-warm-300 text-ink-600 rounded text-[11px] font-medium hover:bg-warm-50">
              断开
            </button>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- ═══ MAIN — 3 COLUMNS ═══ -->
  <div class="flex-1 flex min-h-0 overflow-hidden">

    <!-- ── LEFT: Markets (perps list) ── -->
    <div class="flex-1 border-r border-warm-200 overflow-y-auto bg-warm-50/30">
      <div class="p-5">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h2 class="text-sm font-semibold text-ink-700">Perpetual Markets <span class="text-[11px] text-ink-400 font-normal" x-text="'(' + filteredMarkets.length + ' / ' + markets.length + ')'"></span></h2>
            <p class="text-[10px] text-ink-400">Funding rate pays every 8 hours</p>
          </div>
        </div>

        <!-- Filter + Search + Sort bar -->
        <div class="flex items-center gap-2 mb-3">
          <div class="relative flex-1">
            <input type="text" x-model="marketSearch" placeholder="🔍 Search BTC, ETH, PEPE..." class="w-full px-3 py-1.5 border border-warm-200 rounded text-xs bg-white focus:border-brand-400 focus:outline-none" />
          </div>
          <select x-model="marketCategory" class="px-2 py-1.5 border border-warm-200 rounded text-xs bg-white">
            <option value="all">All</option>
            <option value="majors">Majors</option>
            <option value="l1s">L1s</option>
            <option value="defi">DeFi</option>
            <option value="ai">AI</option>
            <option value="memes">Memes</option>
            <option value="hl">HL Native</option>
            <option value="others">Others</option>
          </select>
          <select x-model="marketSort" class="px-2 py-1.5 border border-warm-200 rounded text-xs bg-white">
            <option value="volume">Vol ▼</option>
            <option value="gainers">Gainers</option>
            <option value="losers">Losers</option>
            <option value="funding_high">Fund+</option>
            <option value="funding_low">Fund−</option>
            <option value="oi">OI ▼</option>
          </select>
        </div>

        <div class="space-y-2">
          <template x-for="m in visibleMarkets" :key="m.asset">
            <div class="bg-white border border-warm-200 rounded-lg p-4 hover:border-brand-300 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-gradient-to-br from-slate-500 to-slate-700 text-white flex items-center justify-center text-[10px] font-bold" x-text="m.asset.slice(0,3)"></div>
                  <div>
                    <div class="font-medium text-ink-700 text-sm" x-text="m.asset + '-PERP'"></div>
                    <div class="text-[10px] text-ink-400">Max leverage 50x</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-semibold text-ink-700 tabular-nums" x-text="'$' + (m.markPrice || 0).toFixed(2)"></div>
                  <div class="text-[10px] tabular-nums" :class="(m.change24h || 0) >= 0 ? 'text-green-600' : 'text-red-600'" x-text="((m.change24h || 0) >= 0 ? '+' : '') + (m.change24h || 0).toFixed(2) + '%'"></div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 text-[11px] mb-3">
                <div class="bg-warm-50 rounded p-2">
                  <div class="text-[9px] text-ink-400 uppercase">Funding</div>
                  <div class="font-semibold tabular-nums" :class="(m.fundingRate || 0) >= 0 ? 'text-green-700' : 'text-red-600'" x-text="((m.fundingRate || 0) * 100).toFixed(4) + '%'"></div>
                </div>
                <div class="bg-warm-50 rounded p-2">
                  <div class="text-[9px] text-ink-400 uppercase">Open Interest</div>
                  <div class="font-semibold text-ink-700 tabular-nums" x-text="'$' + ((m.openInterest || 0) * (m.markPrice || 0) / 1e6).toFixed(0) + 'M'"></div>
                </div>
                <div class="bg-warm-50 rounded p-2">
                  <div class="text-[9px] text-ink-400 uppercase">24h Vol</div>
                  <div class="font-semibold text-ink-700 tabular-nums" x-text="'$' + ((m.volume24h || 0) / 1e6).toFixed(0) + 'M'"></div>
                </div>
              </div>

              <div class="flex gap-2">
                <button @click="openTrade('long', m)" class="flex-1 py-1.5 bg-green-500 text-white rounded text-[11px] font-medium hover:bg-green-600">
                  Long
                </button>
                <button @click="openTrade('short', m)" class="flex-1 py-1.5 bg-red-500 text-white rounded text-[11px] font-medium hover:bg-red-600">
                  Short
                </button>
                <button @click="analyze(m)" :disabled="!selectedWalletId" title="AI 分析"
                        class="px-3 py-1.5 bg-white border border-warm-300 text-ink-600 rounded text-[11px] font-medium hover:bg-warm-50 disabled:opacity-40">
                  分析
                </button>
              </div>
            </div>
          </template>

          <!-- Load more -->
          <div x-show="visibleCount < filteredMarkets.length" class="pt-2">
            <button @click="visibleCount += 20" class="w-full py-2 border border-warm-200 rounded text-[11px] text-ink-600 hover:bg-warm-50">
              Load more <span x-text="'(' + Math.min(20, filteredMarkets.length - visibleCount) + ' / ' + (filteredMarkets.length - visibleCount) + ' remaining)'"></span>
            </button>
          </div>
          <div x-show="filteredMarkets.length === 0" class="text-center text-xs text-ink-400 py-6">No markets match filter</div>
        </div>
      </div>
    </div>

    <!-- ── CENTER: Account + Positions ── -->
    <div class="w-[340px] flex-shrink-0 border-r border-warm-200 overflow-y-auto bg-white">
      <div class="p-5">
        <h2 class="text-sm font-semibold text-ink-700 mb-3">Your Account</h2>

        <div class="space-y-3 mb-4">
          <div class="bg-warm-50 rounded-lg p-3">
            <div class="text-[10px] text-ink-400 uppercase tracking-wider">Account Value</div>
            <div class="text-xl font-bold text-ink-700 tabular-nums" x-text="'$' + (account.accountValue || 0).toFixed(2)"></div>
          </div>
          <div class="bg-warm-50 rounded-lg p-3">
            <div class="text-[10px] text-ink-400 uppercase tracking-wider">Unrealized PnL</div>
            <div class="text-xl font-bold tabular-nums" :class="(account.unrealizedPnl || 0) >= 0 ? 'text-green-600' : 'text-red-600'" x-text="((account.unrealizedPnl || 0) >= 0 ? '+$' : '-$') + Math.abs(account.unrealizedPnl || 0).toFixed(2)"></div>
          </div>
          <div class="bg-warm-50 rounded-lg p-3">
            <div class="flex items-center justify-between mb-1">
              <div class="text-[10px] text-ink-400 uppercase tracking-wider">Margin Usage</div>
              <span class="text-xs font-bold tabular-nums" :class="(account.marginUsedPct || 0) > 80 ? 'text-red-600' : (account.marginUsedPct || 0) > 60 ? 'text-yellow-600' : 'text-green-600'" x-text="(account.marginUsedPct || 0).toFixed(0) + '%'"></span>
            </div>
            <div class="h-2 bg-warm-200 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all" :class="(account.marginUsedPct || 0) > 80 ? 'bg-red-500' : (account.marginUsedPct || 0) > 60 ? 'bg-yellow-500' : 'bg-green-500'" :style="'width:' + Math.min(100, (account.marginUsedPct || 0)) + '%'"></div>
            </div>
          </div>
        </div>

        <!-- Open Positions -->
        <div class="mb-3">
          <div class="text-[10px] text-ink-400 uppercase tracking-wider mb-2">Open Positions (<span x-text="positions.length"></span>)</div>
          <div x-show="positions.length === 0" class="text-center py-4 text-xs text-ink-400">No open positions</div>
          <div class="space-y-2">
            <template x-for="p in positions" :key="p.asset">
              <div class="bg-white border border-warm-200 rounded-lg p-2.5">
                <div class="flex items-center justify-between mb-1">
                  <div class="flex items-center gap-1.5">
                    <span class="font-medium text-ink-700 text-xs" x-text="p.asset"></span>
                    <span class="text-[9px] px-1 rounded" :class="p.side === 'long' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'" x-text="p.side?.toUpperCase()"></span>
                    <span class="text-[9px] text-ink-400" x-text="p.leverage + 'x'"></span>
                  </div>
                  <button @click="closePosition(p.asset)" class="text-[9px] text-red-500 hover:text-red-700">Close</button>
                </div>
                <div class="grid grid-cols-2 gap-1 text-[10px]">
                  <div><span class="text-ink-400">Size:</span> <span class="tabular-nums" x-text="p.size"></span></div>
                  <div><span class="text-ink-400">Entry:</span> <span class="tabular-nums" x-text="'$' + (p.entryPrice || 0).toFixed(2)"></span></div>
                  <div><span class="text-ink-400">Mark:</span> <span class="tabular-nums" x-text="'$' + (p.markPrice || 0).toFixed(2)"></span></div>
                  <div><span class="text-ink-400">Liq:</span> <span class="tabular-nums text-orange-600" x-text="'$' + (p.liqPrice || 0).toFixed(2)"></span></div>
                </div>
                <div class="mt-1 flex justify-between text-[10px]">
                  <span class="text-ink-400">PnL</span>
                  <span class="font-medium tabular-nums" :class="(p.pnl || 0) >= 0 ? 'text-green-600' : 'text-red-600'" x-text="((p.pnl || 0) >= 0 ? '+$' : '-$') + Math.abs(p.pnl || 0).toFixed(2)"></span>
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>

    <!-- ── RIGHT: Intel Panel ── -->
    <div class="w-[300px] flex-shrink-0 overflow-y-auto bg-gradient-to-b from-slate-50 to-warm-50/30">
      <div class="p-4">
        <div class="flex items-center gap-1.5 mb-3">
          <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <h2 class="text-sm font-semibold text-ink-700">Intel Panel</h2>
        </div>

        <!-- Hot Markets (by 24h volume) -->
        <div class="mb-4">
          <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold mb-1.5 flex items-center gap-1">🔥 Hot Markets</div>
          <div class="space-y-1">
            <template x-for="m in hotMarkets" :key="'hot-'+m.asset">
              <div @click="openTrade('long', m)" class="bg-white border border-warm-100 rounded px-2 py-1.5 flex items-center justify-between cursor-pointer hover:border-brand-300">
                <div class="flex items-center gap-1.5">
                  <span class="text-[11px] font-semibold text-ink-700" x-text="m.asset"></span>
                  <span class="text-[9px] tabular-nums" :class="m.change24h >= 0 ? 'text-green-600' : 'text-red-600'" x-text="(m.change24h >= 0 ? '+' : '') + m.change24h.toFixed(1) + '%'"></span>
                </div>
                <span class="text-[10px] text-ink-500 tabular-nums" x-text="'$' + (m.volume24h / 1e6).toFixed(0) + 'M'"></span>
              </div>
            </template>
            <div x-show="hotMarkets.length === 0" class="text-[10px] text-ink-400 text-center py-2">loading…</div>
          </div>
        </div>

        <!-- Funding Extremes -->
        <div class="mb-4">
          <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold mb-1.5">⚡ Funding Extremes</div>
          <div class="text-[9px] text-ink-400 mb-1">High |rate| = contrarian signal</div>
          <div class="space-y-1">
            <template x-for="m in fundingExtremes" :key="'fund-'+m.asset">
              <div @click="openTrade(m.fundingRate > 0 ? 'short' : 'long', m)" class="bg-white border border-warm-100 rounded px-2 py-1.5 flex items-center justify-between cursor-pointer hover:border-brand-300">
                <div class="flex items-center gap-1.5">
                  <span class="text-[11px] font-semibold text-ink-700" x-text="m.asset"></span>
                  <span class="text-[9px] px-1 rounded"
                        :class="m.fundingRate > 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'"
                        x-text="m.fundingRate > 0 ? 'SHORT' : 'LONG'"></span>
                </div>
                <span class="text-[10px] font-semibold tabular-nums"
                      :class="m.fundingRate > 0 ? 'text-red-600' : 'text-green-600'"
                      x-text="(m.fundingRate >= 0 ? '+' : '') + (m.fundingRate * 100).toFixed(4) + '%'"></span>
              </div>
            </template>
            <div x-show="fundingExtremes.length === 0" class="text-[10px] text-ink-400 text-center py-2">No extremes</div>
          </div>
        </div>

        <!-- Smart Wallets (leaderboard) -->
        <div class="mb-4">
          <div class="flex items-center justify-between mb-1.5">
            <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold">🐋 Smart Wallets</div>
            <select x-model="leaderWindow" @change="loadIntel()" class="text-[9px] border border-warm-200 rounded px-1 py-0.5 bg-white">
              <option value="day">24h</option>
              <option value="week">7d</option>
              <option value="month">30d</option>
              <option value="allTime">All</option>
            </select>
          </div>
          <div class="space-y-1">
            <template x-for="(l, i) in leaders" :key="'ldr-'+l.address">
              <div @click="viewTrader(l)" class="bg-white border border-warm-100 rounded px-2 py-1.5 cursor-pointer hover:border-brand-300">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <span class="text-[9px] text-ink-400 tabular-nums w-3" x-text="(i+1)"></span>
                    <span class="text-[10px] font-mono text-ink-600 truncate" x-text="l.displayName || (l.address?.slice(0,6) + '...' + l.address?.slice(-4))"></span>
                  </div>
                  <span class="text-[10px] font-semibold text-green-600 tabular-nums flex-shrink-0" x-text="'+$' + (l.pnl >= 1000 ? (l.pnl/1000).toFixed(1)+'k' : l.pnl.toFixed(0))"></span>
                </div>
                <div class="flex items-center justify-between mt-0.5">
                  <span class="text-[9px] text-ink-400" x-text="'ROI ' + l.roi.toFixed(0) + '%'"></span>
                  <span class="text-[9px] text-ink-400" x-text="'Vol $' + (l.volume/1e6).toFixed(1) + 'M'"></span>
                </div>
              </div>
            </template>
            <div x-show="leaders.length === 0" class="text-[10px] text-ink-400 text-center py-2">loading…</div>
          </div>
        </div>
      </div>
    </div>

  <!-- ═══ SMART TRADER DRAWER ═══ -->
  <div x-show="traderOpen" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" @click.self="traderOpen = false">
    <div class="bg-white rounded-xl shadow-2xl p-5 w-[520px] max-h-[80vh] overflow-y-auto" @click.stop>
      <div class="flex items-center justify-between mb-3">
        <div>
          <h3 class="text-sm font-semibold text-ink-700">🐋 Smart Trader</h3>
          <div class="text-[10px] font-mono text-ink-500" x-text="selectedTrader?.address"></div>
        </div>
        <button @click="traderOpen = false" class="text-ink-400 hover:text-ink-600 text-2xl leading-none">&times;</button>
      </div>
      <div class="grid grid-cols-3 gap-2 mb-3 text-xs">
        <div class="bg-warm-50 rounded p-2">
          <div class="text-[9px] text-ink-400 uppercase">PnL</div>
          <div class="font-semibold text-green-600 tabular-nums" x-text="'+$' + (selectedTrader?.pnl || 0).toFixed(0)"></div>
        </div>
        <div class="bg-warm-50 rounded p-2">
          <div class="text-[9px] text-ink-400 uppercase">ROI</div>
          <div class="font-semibold tabular-nums" x-text="(selectedTrader?.roi || 0).toFixed(0) + '%'"></div>
        </div>
        <div class="bg-warm-50 rounded p-2">
          <div class="text-[9px] text-ink-400 uppercase">Account</div>
          <div class="font-semibold tabular-nums" x-text="'$' + ((selectedTrader?.accountValue || 0) / 1000).toFixed(0) + 'k'"></div>
        </div>
      </div>
      <!-- Loading state -->
      <div x-show="traderLoading" class="text-xs text-ink-400 text-center py-6">
        <svg class="animate-spin w-4 h-4 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="3" opacity="0.3"/><path d="M12 2 A10 10 0 0 1 22 12" stroke-width="3" stroke-linecap="round"/></svg>
        loading trader intel…
      </div>

      <!-- Vault-like warning -->
      <div x-show="!traderLoading && traderIsVault" class="bg-amber-50 border border-amber-200 rounded p-2.5 text-[11px] text-amber-800 mb-3">
        ⚠ This address is a <b>vault / staker</b> (likely HLP or a strategy vault). It earns profit passively without directly placing orders, so there are no positions or fills to show. Large account value + no activity = capital deposited into an on-chain strategy.
      </div>

      <!-- Current positions (primary signal) -->
      <div x-show="!traderLoading && !traderIsVault" class="mb-3">
        <div class="flex items-center justify-between mb-1.5">
          <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold">Current Positions (<span x-text="traderPositions.length"></span>)</div>
          <div class="text-[9px] text-ink-400">most valuable first</div>
        </div>
        <div x-show="traderPositions.length === 0" class="text-[11px] text-ink-400 text-center py-3 bg-warm-50 rounded">No open positions</div>
        <div class="space-y-1">
          <template x-for="p in traderPositions" :key="'tp-'+p.asset">
            <div class="bg-white border border-warm-200 rounded px-2.5 py-2">
              <div class="flex items-center justify-between mb-1">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-ink-700 text-[11px]" x-text="p.asset"></span>
                  <span class="text-[9px] px-1 rounded" :class="p.side === 'long' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'" x-text="p.side.toUpperCase()"></span>
                  <span class="text-[9px] text-ink-400" x-text="p.leverage + 'x'"></span>
                </div>
                <span class="text-[11px] font-semibold tabular-nums" x-text="'$' + (p.value >= 1000 ? (p.value/1000).toFixed(1)+'k' : p.value.toFixed(0))"></span>
              </div>
              <div class="flex items-center justify-between text-[10px]">
                <span class="text-ink-400 tabular-nums" x-text="'Size ' + p.size + ' @ $' + p.entryPrice.toFixed(2)"></span>
                <span class="font-medium tabular-nums" :class="p.pnl >= 0 ? 'text-green-600' : 'text-red-600'" x-text="(p.pnl >= 0 ? '+' : '') + '$' + Math.abs(p.pnl).toFixed(0) + ' (' + (p.pnlPct >= 0 ? '+' : '') + p.pnlPct.toFixed(1) + '%)'"></span>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- Recent fills (secondary) -->
      <div x-show="!traderLoading && !traderIsVault && traderFills.length > 0">
        <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold mb-1.5">Recent Fills</div>
        <div class="space-y-1">
          <template x-for="(f, i) in traderFills" :key="'f-'+i">
            <div class="bg-warm-50 border border-warm-100 rounded px-2 py-1.5 flex items-center justify-between text-[11px]">
              <div class="flex items-center gap-2">
                <span class="font-semibold" :class="f.side === 'long' ? 'text-green-600' : 'text-red-600'" x-text="f.side.toUpperCase()"></span>
                <span class="text-ink-700" x-text="f.asset"></span>
                <span class="text-[9px] text-ink-400" x-text="f.dir"></span>
              </div>
              <div class="flex items-center gap-2 tabular-nums">
                <span class="text-ink-500" x-text="f.size + ' @ $' + f.price.toFixed(2)"></span>
                <span x-show="f.pnl !== 0" :class="f.pnl > 0 ? 'text-green-600' : 'text-red-600'" x-text="(f.pnl > 0 ? '+' : '') + f.pnl.toFixed(0)"></span>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>

  </div>

  <!-- ═══ AI ANALYZE MODAL ═══ -->
  <div x-show="analyzeOpen" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="analyzeOpen = false">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-[540px] max-h-[85vh] overflow-y-auto" @click.stop>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-base font-semibold text-ink-700 flex items-center gap-2">
            <span x-text="analyzeMarket?.asset + '-PERP'"></span>
            <span class="text-xs font-normal text-ink-400">分析</span>
          </h3>
          <div class="text-[10px] text-ink-400 mt-0.5" x-text="analyzeAgent ? '由 ' + analyzeAgent + ' 本地模型分析' : '准备中…'"></div>
        </div>
        <button @click="analyzeOpen = false" class="text-ink-400 hover:text-ink-600 text-2xl leading-none">&times;</button>
      </div>

      <!-- Loading -->
      <div x-show="analyzeLoading" class="py-8 text-center">
        <svg class="animate-spin w-8 h-8 mx-auto mb-3 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="3" opacity="0.3"/><path d="M12 2 A10 10 0 0 1 22 12" stroke-width="3" stroke-linecap="round"/></svg>
        <div class="text-xs text-ink-500">Gathering intel + running AI analysis…</div>
        <div class="text-[10px] text-ink-400 mt-1">Market data · Your account · Top 5 whale positioning</div>
      </div>

      <!-- Error -->
      <div x-show="!analyzeLoading && analyzeError" class="py-4 text-xs text-red-600" x-text="analyzeError"></div>

      <!-- Parsed result -->
      <div x-show="!analyzeLoading && analyzeResult" class="space-y-4">
        <!-- Direction + confidence headline -->
        <div class="rounded-lg p-4"
             :class="analyzeResult?.direction === 'LONG' ? 'bg-gradient-to-br from-green-50 to-emerald-100' :
                     analyzeResult?.direction === 'SHORT' ? 'bg-gradient-to-br from-red-50 to-rose-100' :
                     'bg-gradient-to-br from-amber-50 to-orange-100'">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-[10px] uppercase tracking-wider opacity-60">Recommendation</div>
              <div class="text-2xl font-bold"
                   :class="analyzeResult?.direction === 'LONG' ? 'text-green-700' :
                           analyzeResult?.direction === 'SHORT' ? 'text-red-700' : 'text-amber-700'"
                   x-text="analyzeResult?.direction || '—'"></div>
            </div>
            <div class="text-right">
              <div class="text-[10px] uppercase tracking-wider opacity-60">Confidence</div>
              <div class="text-2xl font-bold tabular-nums" x-text="(analyzeResult?.confidence || 0) + '%'"></div>
            </div>
          </div>
          <div x-show="analyzeResult?.summary" class="mt-2 text-xs text-ink-700" x-text="analyzeResult?.summary"></div>
        </div>

        <!-- Trade params -->
        <div x-show="analyzeResult?.direction !== 'SKIP'" class="grid grid-cols-3 gap-2">
          <div class="bg-warm-50 rounded p-2"><div class="text-[9px] text-ink-400 uppercase">Size (USD)</div><div class="font-semibold tabular-nums text-sm" x-text="'$' + (analyzeResult?.sizeUsd || 0).toFixed(0)"></div></div>
          <div class="bg-warm-50 rounded p-2"><div class="text-[9px] text-ink-400 uppercase">Leverage</div><div class="font-semibold tabular-nums text-sm" x-text="(analyzeResult?.leverage || 1) + 'x'"></div></div>
          <div class="bg-warm-50 rounded p-2"><div class="text-[9px] text-ink-400 uppercase">Entry</div><div class="font-semibold tabular-nums text-sm" x-text="'$' + (analyzeResult?.entryPrice || 0).toFixed(2)"></div></div>
          <div class="bg-red-50 rounded p-2"><div class="text-[9px] text-red-500 uppercase">Stop Loss</div><div class="font-semibold tabular-nums text-sm text-red-700" x-text="'$' + (analyzeResult?.stopLoss || 0).toFixed(2)"></div></div>
          <div class="bg-green-50 rounded p-2"><div class="text-[9px] text-green-600 uppercase">Take Profit</div><div class="font-semibold tabular-nums text-sm text-green-700" x-text="'$' + (analyzeResult?.takeProfit || 0).toFixed(2)"></div></div>
          <div class="bg-warm-50 rounded p-2"><div class="text-[9px] text-ink-400 uppercase">R:R</div><div class="font-semibold tabular-nums text-sm" x-text="computeRR()"></div></div>
        </div>

        <!-- Reasoning -->
        <div x-show="analyzeResult?.reasoning?.length">
          <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold mb-1">✓ Reasoning</div>
          <ul class="space-y-0.5">
            <template x-for="r in (analyzeResult?.reasoning || [])">
              <li class="text-xs text-ink-700 flex gap-1.5"><span class="text-green-500">•</span><span x-text="r"></span></li>
            </template>
          </ul>
        </div>

        <!-- Risks -->
        <div x-show="analyzeResult?.risks?.length">
          <div class="text-[10px] text-ink-500 uppercase tracking-wider font-semibold mb-1">⚠ Risks</div>
          <ul class="space-y-0.5">
            <template x-for="r in (analyzeResult?.risks || [])">
              <li class="text-xs text-ink-700 flex gap-1.5"><span class="text-amber-500">•</span><span x-text="r"></span></li>
            </template>
          </ul>
        </div>

        <!-- Intel snapshot -->
        <div x-show="analyzeIntel" class="text-[10px] text-ink-400 bg-warm-50 rounded p-2">
          <div class="font-semibold text-ink-500 mb-0.5">Intel used</div>
          <div>Available: $<span x-text="(analyzeIntel?.account?.available || 0).toFixed(2)"></span> · Smart wallets on this asset: <span x-text="(analyzeIntel?.leaderPositions || []).length"></span></div>
        </div>

        <!-- Actions -->
        <div class="flex gap-2 pt-2">
          <button @click="analyzeOpen = false" class="flex-1 py-2 bg-warm-200 text-ink-600 rounded-lg text-sm font-medium hover:bg-warm-300">Close</button>
          <button x-show="analyzeResult?.direction !== 'SKIP'" @click="applyAnalysisToTrade()"
                  class="flex-1 py-2 rounded-lg text-sm font-medium text-white"
                  :class="analyzeResult?.direction === 'LONG' ? 'bg-green-500 hover:bg-green-600' : 'bg-red-500 hover:bg-red-600'">
            Apply to Trade →
          </button>
        </div>
      </div>

      <!-- Raw fallback -->
      <div x-show="!analyzeLoading && !analyzeResult && analyzeRaw" class="bg-warm-50 rounded p-3 text-xs text-ink-700 whitespace-pre-wrap" x-text="analyzeRaw"></div>
    </div>
  </div>

  <!-- ═══ DEPOSIT MODAL ═══ -->
  <div x-show="depositOpen" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" @click.self="depositOpen = false">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-[420px]" @click.stop>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-ink-700">💰 Deposit to Hyperliquid</h3>
        <button @click="depositOpen = false" class="text-ink-400 hover:text-ink-600 text-2xl leading-none">&times;</button>
      </div>

      <!-- Flow diagram -->
      <div class="bg-gradient-to-r from-blue-50 to-emerald-50 rounded-lg p-3 mb-4 text-[11px]">
        <div class="flex items-center justify-between">
          <div class="text-center">
            <div class="text-[9px] text-ink-400 uppercase">Arbitrum Wallet</div>
            <div class="font-mono text-[10px] text-ink-600" x-text="connectedWallet?.address?.slice(0,6) + '...' + connectedWallet?.address?.slice(-4)"></div>
            <div class="font-semibold tabular-nums mt-1" x-text="(arbBalances.usdc || 0).toFixed(2) + ' USDC'"></div>
          </div>
          <svg class="w-5 h-5 text-ink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          <div class="text-center">
            <div class="text-[9px] text-ink-400 uppercase">Hyperliquid</div>
            <div class="font-mono text-[10px] text-ink-600">Bridge contract</div>
            <div class="font-semibold tabular-nums mt-1" x-text="'$' + (account.accountValue || 0).toFixed(2)"></div>
          </div>
        </div>
      </div>

      <!-- Amount input -->
      <label class="block mb-3">
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs text-ink-500">Amount (USDC)</span>
          <span class="text-[10px] text-ink-400">Min 5 USDC · Gas ~0.0003 ETH</span>
        </div>
        <div class="relative">
          <input type="number" x-model="depositAmount" step="0.01" min="5" :max="arbBalances.usdc || 0"
                 placeholder="0.00"
                 class="w-full px-3 py-2 pr-16 border border-warm-300 rounded-lg text-sm bg-white focus:border-brand-400 focus:outline-none tabular-nums" />
          <button @click="depositAmount = Math.max(0, ((arbBalances.usdc || 0) - 0.01)).toFixed(2)"
                  class="absolute right-1 top-1 bottom-1 px-2 bg-warm-100 text-ink-600 rounded text-[10px] font-medium hover:bg-warm-200">
            MAX
          </button>
        </div>
      </label>

      <!-- Quick amounts -->
      <div class="flex gap-1 mb-3">
        <template x-for="pct in [25, 50, 75, 100]" :key="pct">
          <button @click="depositAmount = (((arbBalances.usdc || 0) - 0.01) * pct / 100).toFixed(2)"
                  class="flex-1 py-1 bg-warm-50 border border-warm-200 rounded text-[10px] text-ink-600 hover:bg-warm-100" x-text="pct + '%'"></button>
        </template>
      </div>

      <!-- Warnings -->
      <div class="text-[10px] text-ink-500 space-y-0.5 bg-warm-50 rounded p-2 mb-3">
        <div>• Funds appear in Hyperliquid ~1 minute after confirmation</div>
        <div>• Transaction is irreversible — check amount carefully</div>
        <div>• You'll see the TX on Arbiscan immediately</div>
      </div>

      <div x-show="depositError" class="mb-2 text-xs text-red-600" x-text="depositError"></div>
      <div x-show="depositSuccess" class="mb-2 text-xs text-green-600">
        ✓ Deposit TX sent!
        <a :href="depositSuccess" target="_blank" class="underline">View on Arbiscan</a>
      </div>

      <div class="flex gap-2">
        <button @click="depositOpen = false" class="flex-1 py-2 bg-warm-200 text-ink-600 rounded-lg text-sm font-medium hover:bg-warm-300">Cancel</button>
        <button @click="confirmDeposit()"
                :disabled="depositLoading || !depositAmount || parseFloat(depositAmount) < 5 || parseFloat(depositAmount) > (arbBalances.usdc || 0)"
                class="flex-1 py-2 bg-brand-500 text-white rounded-lg text-sm font-medium hover:bg-brand-600 disabled:opacity-40">
          <span x-show="!depositLoading">Confirm Deposit</span>
          <span x-show="depositLoading">Sending TX...</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ WITHDRAW MODAL ═══ -->
  <div x-show="withdrawOpen" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" @click.self="withdrawOpen = false">
    <div class="bg-white rounded-xl shadow-2xl p-5 w-[440px] max-h-[92vh] overflow-y-auto" @click.stop>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-semibold text-ink-700">↩ 提现到 Arbitrum</h3>
        <button @click="withdrawOpen = false" class="text-ink-400 hover:text-ink-600 text-2xl leading-none">&times;</button>
      </div>

      <!-- ⚠ 大字警告 — 最显眼位置 —— -->
      <div class="bg-amber-50 border border-amber-300 rounded-lg p-3 mb-4 text-xs text-amber-900">
        <div class="font-semibold mb-1">⚠ 重要说明（请先读）</div>
        <div class="space-y-0.5 text-[11px]">
          <div>• <b>固定 $1 USDC 手续费</b>（不是百分比，小额不划算）</div>
          <div>• <b>你请求的金额 = HL 账户扣除的金额</b>（含手续费）</div>
          <div>• <b>实收 = 请求金额 - $1</b>（例: 提 5，实收 4）</div>
          <div>• 提现不可逆，约 1 分钟到 Arbitrum</div>
          <div>• MAX 按钮已自动预留 $1 手续费 buffer</div>
        </div>
      </div>

      <!-- 流向图 -->
      <div class="bg-gradient-to-r from-emerald-50 to-blue-50 rounded-lg p-3 mb-3 text-[11px]">
        <div class="flex items-center justify-between">
          <div class="text-center">
            <div class="text-[9px] text-ink-400 uppercase">Hyperliquid</div>
            <div class="font-mono text-[10px] text-ink-600">可用</div>
            <div class="font-semibold tabular-nums mt-1" x-text="'$' + (account.available || 0).toFixed(2)"></div>
          </div>
          <svg class="w-5 h-5 text-ink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          <div class="text-center">
            <div class="text-[9px] text-ink-400 uppercase">Arbitrum 钱包</div>
            <div class="font-mono text-[10px] text-ink-600" x-text="connectedWallet?.address?.slice(0,6) + '...' + connectedWallet?.address?.slice(-4)"></div>
            <div class="font-semibold tabular-nums mt-1" x-text="(arbBalances.usdc || 0).toFixed(2) + ' USDC'"></div>
          </div>
        </div>
      </div>

      <!-- 金额输入 -->
      <label class="block mb-3">
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs text-ink-500">提现金额 (USDC)</span>
          <span class="text-[10px] text-ink-400">最少 3 USDC（含 $1 费）</span>
        </div>
        <div class="relative">
          <input type="number" x-model="withdrawAmount" step="0.01" min="3" :max="account.available || 0"
                 placeholder="0.00"
                 class="w-full px-3 py-2 pr-16 border border-warm-300 rounded-lg text-sm bg-white focus:border-brand-400 focus:outline-none tabular-nums" />
          <button @click="withdrawAmount = Math.max(0, ((account.available || 0) - 1)).toFixed(2)"
                  class="absolute right-1 top-1 bottom-1 px-2 bg-warm-100 text-ink-600 rounded text-[10px] font-medium hover:bg-warm-200"
                  title="预留 $1 手续费 buffer">
            MAX
          </button>
        </div>
        <!-- 实时收款预览 -->
        <div class="mt-1.5 flex items-center justify-between text-[11px]" x-show="withdrawAmount && parseFloat(withdrawAmount) >= 2">
          <span class="text-ink-500">HL 账户扣除:</span>
          <span class="font-semibold tabular-nums text-ink-700" x-text="'$' + (parseFloat(withdrawAmount) || 0).toFixed(2)"></span>
        </div>
        <div class="flex items-center justify-between text-[11px]" x-show="withdrawAmount && parseFloat(withdrawAmount) >= 2">
          <span class="text-ink-500">- 手续费:</span>
          <span class="font-semibold tabular-nums text-red-600">-$1.00</span>
        </div>
        <div class="mt-0.5 flex items-center justify-between text-xs border-t border-warm-200 pt-1" x-show="withdrawAmount && parseFloat(withdrawAmount) >= 2">
          <span class="text-ink-600 font-medium">你将收到:</span>
          <span class="font-bold tabular-nums text-green-700" x-text="'$' + Math.max(0, parseFloat(withdrawAmount) - 1).toFixed(2) + ' USDC'"></span>
        </div>
      </label>

      <!-- 快捷百分比 —— 都自动预留 $1 fee -->
      <div class="flex gap-1 mb-3">
        <template x-for="pct in [25, 50, 75, 100]" :key="'w'+pct">
          <button @click="withdrawAmount = Math.max(0, ((account.available || 0) - 1) * pct / 100).toFixed(2)"
                  class="flex-1 py-1 bg-warm-50 border border-warm-200 rounded text-[10px] text-ink-600 hover:bg-warm-100"
                  x-text="pct + '%'"
                  :title="'可提现金额的 ' + pct + '%（已预留 $1 手续费）'"></button>
        </template>
      </div>

      <div x-show="withdrawError" class="mb-2 text-xs text-red-600 bg-red-50 border border-red-200 rounded p-2" x-text="withdrawError"></div>
      <div x-show="withdrawSuccess" class="mb-2 text-xs text-green-700 bg-green-50 border border-green-200 rounded p-2" x-text="withdrawSuccess"></div>

      <div class="flex gap-2">
        <button @click="withdrawOpen = false" class="flex-1 py-2 bg-warm-200 text-ink-600 rounded-lg text-sm font-medium hover:bg-warm-300">取消</button>
        <button @click="confirmWithdraw()"
                :disabled="withdrawLoading || !withdrawAmount || parseFloat(withdrawAmount) < 2 || parseFloat(withdrawAmount) > (account.available || 0)"
                class="flex-1 py-2 bg-brand-500 text-white rounded-lg text-sm font-medium hover:bg-brand-600 disabled:opacity-40">
          <span x-show="!withdrawLoading">确认提现</span>
          <span x-show="withdrawLoading">处理中...</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ TRADE MODAL ═══ -->
  <div x-show="modalOpen" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" @click.self="modalOpen = false">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-96" @click.stop>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-ink-700">
          <span :class="modalSide === 'long' ? 'text-green-600' : 'text-red-600'" x-text="modalSide?.toUpperCase()"></span>
          <span x-text="modalMarket?.asset + '-PERP'"></span>
        </h3>
        <button @click="modalOpen = false" class="text-ink-400 hover:text-ink-600 text-2xl leading-none">&times;</button>
      </div>

      <div class="bg-warm-50 rounded-lg p-3 mb-4 text-xs space-y-1">
        <div class="flex justify-between"><span class="text-ink-400">Mark Price:</span> <span class="tabular-nums" x-text="'$' + (modalMarket?.markPrice || 0).toFixed(2)"></span></div>
        <div class="flex justify-between"><span class="text-ink-400">Funding:</span> <span class="tabular-nums" x-text="((modalMarket?.fundingRate || 0) * 100).toFixed(4) + '%'"></span></div>
        <div class="flex justify-between"><span class="text-ink-400">Available:</span> <span class="tabular-nums" x-text="'$' + (account.available || 0).toFixed(2)"></span></div>
      </div>

      <div class="space-y-3">
        <label class="block">
          <span class="text-xs text-ink-500">Size</span>
          <input type="number" x-model="modalSize" step="0.01" placeholder="0.00" class="w-full mt-1 px-3 py-2 border border-warm-300 rounded-lg text-sm bg-white focus:border-brand-400 focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs text-ink-500">Leverage (1-5x)</span>
          <input type="number" x-model="modalLeverage" min="1" max="5" step="1" class="w-full mt-1 px-3 py-2 border border-warm-300 rounded-lg text-sm bg-white focus:border-brand-400 focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs text-ink-500">Stop Loss <span class="text-red-500">*</span> (mandatory)</span>
          <input type="number" x-model="modalStopLoss" step="0.01" placeholder="Price" class="w-full mt-1 px-3 py-2 border border-warm-300 rounded-lg text-sm bg-white focus:border-brand-400 focus:outline-none" />
        </label>
      </div>

      <div x-show="modalError" class="mt-2 text-xs text-red-600" x-text="modalError"></div>

      <div class="flex gap-2 mt-4">
        <button @click="modalOpen = false" class="flex-1 py-2 bg-warm-200 text-ink-600 rounded-lg text-sm font-medium hover:bg-warm-300">Cancel</button>
        <button @click="confirmTrade()" :disabled="modalLoading || !modalSize || !modalStopLoss"
          class="flex-1 py-2 rounded-lg text-sm font-medium text-white disabled:opacity-50"
          :class="modalSide === 'long' ? 'bg-green-500 hover:bg-green-600' : 'bg-red-500 hover:bg-red-600'">
          <span x-show="!modalLoading">Confirm</span>
          <span x-show="modalLoading">Processing...</span>
        </button>
      </div>
    </div>
  </div>

</div>

<script>
function hyperApp() {
  return {
    selectedWalletId: null,
    pendingWalletId: '',
    arbWallets: [],
    account: { accountValue: 0, unrealizedPnl: 0, marginUsedPct: 0, available: 0 },
    positions: [],
    funding: [],
    markets: [],
    history: [],
    // Arb wallet balances (separate from HL account)
    arbBalances: { eth: 0, usdc: 0 },
    // Deposit modal
    depositOpen: false,
    depositAmount: '',
    depositError: '',
    depositSuccess: '',
    depositLoading: false,
    // Withdraw modal
    withdrawOpen: false,
    withdrawAmount: '',
    withdrawError: '',
    withdrawSuccess: '',
    withdrawLoading: false,
    // Market filters + pagination
    marketSearch: '',
    marketCategory: 'all',
    marketSort: 'volume',
    visibleCount: 20,
    // AI analyze
    analyzeOpen: false,
    analyzeLoading: false,
    analyzeMarket: null,
    analyzeResult: null,
    analyzeRaw: '',
    analyzeError: '',
    analyzeAgent: '',
    analyzeIntel: null,
    // Intel
    leaders: [],
    leaderWindow: 'day',
    // Trader drawer
    traderOpen: false,
    traderLoading: false,
    selectedTrader: null,
    traderPositions: [],
    traderFills: [],
    traderIsVault: false,
    // Trade modal
    modalOpen: false,
    modalSide: 'long',
    modalMarket: null,
    modalSize: '',
    modalLeverage: 3,
    modalStopLoss: '',
    modalError: '',
    modalLoading: false,

    get connectedWallet() {
      return this.arbWallets.find(w => w.id == this.selectedWalletId) || null;
    },
    get filteredMarkets() {
      const q = (this.marketSearch || '').trim().toLowerCase();
      let list = this.markets || [];
      if (this.marketCategory !== 'all') list = list.filter(m => m.category === this.marketCategory);
      if (q) list = list.filter(m => m.asset.toLowerCase().includes(q));
      const sorters = {
        volume:       (a, b) => (b.volume24h || 0) - (a.volume24h || 0),
        gainers:      (a, b) => (b.change24h || 0) - (a.change24h || 0),
        losers:       (a, b) => (a.change24h || 0) - (b.change24h || 0),
        funding_high: (a, b) => (b.fundingRate || 0) - (a.fundingRate || 0),
        funding_low:  (a, b) => (a.fundingRate || 0) - (b.fundingRate || 0),
        oi:           (a, b) => (b.openInterest || 0) - (a.openInterest || 0),
      };
      return [...list].sort(sorters[this.marketSort] || sorters.volume);
    },
    get visibleMarkets() {
      return this.filteredMarkets.slice(0, this.visibleCount);
    },
    get hotMarkets() {
      return [...(this.markets || [])]
        .filter(m => m.volume24h > 0)
        .sort((a, b) => (b.volume24h || 0) - (a.volume24h || 0))
        .slice(0, 5);
    },
    get fundingExtremes() {
      return [...(this.markets || [])]
        .filter(m => Math.abs(m.fundingRate || 0) > 0.0001)
        .sort((a, b) => Math.abs(b.fundingRate) - Math.abs(a.fundingRate))
        .slice(0, 5);
    },

    async init() {
      await this.init2(); // load markets first (public data)
      await this.loadWallets();
      await this.loadIntel();
      // Restore last session if present — else honor loadWallets() auto-select
      const last = localStorage.getItem('hyper_wallet_id');
      if (last && this.arbWallets.find(w => w.id == last)) {
        this.selectedWalletId = last;
      }
      // If we have any selection (restored or auto-picked), load everything
      if (this.selectedWalletId) {
        await this.loadAll();
      }
    },

    async connect() {
      if (!this.pendingWalletId) return;
      this.selectedWalletId = this.pendingWalletId;
      localStorage.setItem('hyper_wallet_id', this.selectedWalletId);
      await this.loadAll();
    },
    disconnect() {
      this.selectedWalletId = null;
      this.pendingWalletId = '';
      localStorage.removeItem('hyper_wallet_id');
      this.account = { accountValue: 0, unrealizedPnl: 0, marginUsedPct: 0, available: 0 };
      this.positions = [];
    },

    async loadIntel() {
      try {
        const d = await fetch('/api/defi/hyperliquid/leaderboard?limit=10&window=' + this.leaderWindow).then(r => r.json());
        if (d.ok) this.leaders = d.leaders || [];
      } catch {}
    },

    async viewTrader(leader) {
      this.selectedTrader = leader;
      this.traderPositions = [];
      this.traderFills = [];
      this.traderIsVault = false;
      this.traderLoading = true;
      this.traderOpen = true;
      try {
        const d = await fetch('/api/defi/hyperliquid/trader?address=' + leader.address + '&limit=20').then(r => r.json());
        if (d.ok) {
          this.traderPositions = d.positions || [];
          this.traderFills = d.fills || [];
          this.traderIsVault = !!d.isVaultLike;
        }
      } catch {}
      this.traderLoading = false;
    },

    async loadWallets() {
      try {
        const relays = await fetch('/api/agent/profile').then(r => r.json());
        const wallets = [];
        for (const r of (relays || [])) {
          try {
            const w = await fetch('/api/relay/' + r.id + '/wallets').then(rr => rr.json());
            for (const c of (w.chains || [])) {
              if (c.chain === 'arbitrum') wallets.push({ id: c.id, name: r.name, address: c.address });
            }
          } catch {}
        }
        this.arbWallets = wallets;
        if (wallets.length > 0 && !this.selectedWalletId) this.selectedWalletId = wallets[0].id;
      } catch {}
    },

    async loadAll() {
      if (!this.selectedWalletId) return;
      try {
        const [d, b] = await Promise.all([
          fetch('/api/defi/hyperliquid/status?walletId=' + this.selectedWalletId).then(r => r.json()),
          fetch('/api/defi/hyperliquid/balances?walletId=' + this.selectedWalletId).then(r => r.json()),
        ]);
        if (d.ok) {
          this.account = d.account || this.account;
          this.positions = d.positions || [];
          this.funding = d.funding || [];
          this.markets = d.markets || [];
        }
        if (b.ok) {
          this.arbBalances = { eth: b.eth || 0, usdc: b.usdc || 0 };
        }
      } catch {}
    },

    openDeposit() {
      this.depositAmount = Math.max(0, (this.arbBalances.usdc || 0) - 0.01).toFixed(2);
      this.depositError = '';
      this.depositSuccess = '';
      this.depositOpen = true;
    },

    openWithdraw() {
      this.withdrawAmount = (this.account.available || 0).toFixed(2);
      this.withdrawError = '';
      this.withdrawSuccess = '';
      this.withdrawOpen = true;
    },

    async confirmWithdraw() {
      const amt = parseFloat(this.withdrawAmount);
      if (isNaN(amt) || amt < 2) { this.withdrawError = '最少 2 USDC'; return; }
      if (amt > (this.account.available || 0)) { this.withdrawError = '超出 HL 可用余额'; return; }
      this.withdrawLoading = true;
      this.withdrawError = '';
      this.withdrawSuccess = '';
      try {
        const r = await fetch('/api/defi/hyperliquid/withdraw', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ walletId: this.selectedWalletId, amount: amt }),
        });
        const d = await r.json();
        if (d.ok) {
          this.withdrawSuccess = '✓ 提现已发起 · ' + (d.note || '约 1 分钟到账');
          // Refresh — HL 账户立即减少，Arb 余额 ~1min 后增加
          await this.loadAll();
          setTimeout(() => this.loadAll(), 75000);
        } else {
          this.withdrawError = d.error || '提现失败';
        }
      } catch (e) {
        this.withdrawError = e.message;
      } finally {
        this.withdrawLoading = false;
      }
    },

    async confirmDeposit() {
      const amt = parseFloat(this.depositAmount);
      if (isNaN(amt) || amt < 5) { this.depositError = 'Minimum 5 USDC'; return; }
      if (amt > (this.arbBalances.usdc || 0)) { this.depositError = 'Exceeds Arb wallet balance'; return; }
      this.depositLoading = true;
      this.depositError = '';
      this.depositSuccess = '';
      try {
        const r = await fetch('/api/defi/hyperliquid/deposit', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ walletId: this.selectedWalletId, amount: amt }),
        });
        const d = await r.json();
        if (d.ok) {
          this.depositSuccess = d.explorer;
          // Refresh balances — Hyperliquid account takes ~1 min to reflect
          await this.loadAll();
          // Schedule a follow-up refresh after 70s
          setTimeout(() => this.loadAll(), 70000);
        } else {
          this.depositError = d.error || 'Deposit failed';
        }
      } catch (e) {
        this.depositError = e.message;
      } finally {
        this.depositLoading = false;
      }
    },
    async init2() {
      // Load markets even without wallet (public data)
      try {
        const d = await fetch('/api/defi/hyperliquid/markets?limit=10').then(r => r.json());
        if (d.ok) this.markets = d.markets || [];
      } catch {}
    },

    openTrade(side, market) {
      this.modalSide = side;
      this.modalMarket = market;
      this.modalSize = '';
      this.modalStopLoss = '';
      this.modalError = '';
      this.modalOpen = true;
    },

    async confirmTrade() {
      if (!this.modalSize || !this.modalStopLoss || !this.selectedWalletId) return;
      this.modalLoading = true;
      this.modalError = '';
      try {
        const r = await fetch('/api/defi/hyperliquid/order', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            walletId: this.selectedWalletId,
            asset: this.modalMarket.asset,
            side: this.modalSide,
            size: this.modalSize,
            leverage: parseInt(this.modalLeverage),
            stopLoss: this.modalStopLoss,
            type: 'market',
          }),
        });
        const d = await r.json();
        if (d.ok) {
          alert('Order placed!');
          this.modalOpen = false;
          await this.loadAll();
        } else {
          this.modalError = d.error || 'Order failed';
        }
      } catch (e) {
        this.modalError = e.message;
      } finally {
        this.modalLoading = false;
      }
    },

    async analyze(market) {
      if (!this.selectedWalletId) return;
      this.analyzeMarket = market;
      this.analyzeResult = null;
      this.analyzeRaw = '';
      this.analyzeError = '';
      this.analyzeAgent = '';
      this.analyzeIntel = null;
      this.analyzeLoading = true;
      this.analyzeOpen = true;
      try {
        const r = await fetch('/api/defi/hyperliquid/analyze', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ walletId: this.selectedWalletId, asset: market.asset }),
        });
        const d = await r.json();
        if (d.ok) {
          this.analyzeAgent = d.agent || '';
          this.analyzeIntel = d.intel || null;
          if (d.parsed) this.analyzeResult = d.parsed;
          else this.analyzeRaw = d.raw || 'AI returned unparseable response';
        } else {
          this.analyzeError = d.error || 'Analysis failed';
        }
      } catch (e) {
        this.analyzeError = e.message;
      } finally {
        this.analyzeLoading = false;
      }
    },

    computeRR() {
      const r = this.analyzeResult;
      if (!r || !r.entryPrice || !r.stopLoss || !r.takeProfit) return '—';
      const risk = Math.abs(r.entryPrice - r.stopLoss);
      const reward = Math.abs(r.takeProfit - r.entryPrice);
      return risk > 0 ? '1 : ' + (reward / risk).toFixed(2) : '—';
    },

    applyAnalysisToTrade() {
      const r = this.analyzeResult;
      if (!r) return;
      const side = r.direction === 'LONG' ? 'long' : 'short';
      this.modalSide = side;
      this.modalMarket = this.analyzeMarket;
      // Convert USD size back to asset size at entry price
      this.modalSize = r.entryPrice > 0 ? (r.sizeUsd / r.entryPrice).toFixed(6) : '';
      this.modalLeverage = Math.min(5, Math.max(1, r.leverage || 2));
      this.modalStopLoss = String(r.stopLoss || '');
      this.modalError = '';
      this.analyzeOpen = false;
      this.modalOpen = true;
    },

    async closePosition(asset) {
      if (!confirm('Close ' + asset + ' position?')) return;
      try {
        const r = await fetch('/api/defi/hyperliquid/close', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ walletId: this.selectedWalletId, asset }),
        });
        const d = await r.json();
        if (d.ok) { alert('Closed!'); await this.loadAll(); }
        else alert('Error: ' + (d.error || 'Unknown'));
      } catch (e) { alert('Error: ' + e.message); }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

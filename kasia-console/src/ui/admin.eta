<%~ include('partials/page-open', { _page: 'admin', pageTitle: 'Admin Control Room', ...it }) %>

<div class="h-full flex flex-col" x-data="adminControlRoom()" x-init="loadAll()">

  <!-- ═══ HEADER BAR ═══ -->
  <div class="flex-shrink-0 bg-white border-b border-warm-200 px-5 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-xs">A</div>
      <div>
        <div class="text-sm font-semibold text-ink-700">KANet Admin Control Room</div>
        <div class="text-[10px] text-ink-400">Phase 1A — market state + stuck escrow surface</div>
      </div>
    </div>
    <div class="flex items-center gap-3 text-xs">
      <span class="text-ink-400" x-show="lastRefresh">上次刷新 <span x-text="lastRefreshRel"></span></span>
      <label class="flex items-center gap-1 text-ink-500">
        <input type="checkbox" x-model="autoRefresh" @change="toggleAutoRefresh()" class="w-3 h-3">
        <span>30s 自动刷新</span>
      </label>
      <button @click="loadAll()" class="text-brand-500 hover:text-brand-700 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        刷新
      </button>
    </div>
  </div>

  <!-- ═══ MAIN CONTENT ═══ -->
  <div class="flex-1 overflow-y-auto p-5 space-y-5">

    <!-- ═══ MARKET STATE ═══ -->
    <section class="bg-white rounded-lg shadow-sm border border-warm-200">
      <div class="px-5 py-3 border-b border-warm-200 flex items-center gap-2">
        <span class="text-green-600">✅</span>
        <h2 class="text-sm font-semibold text-ink-700">MARKET STATE (24h)</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 p-5">
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">活跃挂单</p>
          <p class="mt-1 text-2xl font-bold text-ink-700" x-text="market.active_offers ?? '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">已匹配</p>
          <p class="mt-1 text-2xl font-bold text-blue-600" x-text="market.matched ?? '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">24h 完成</p>
          <p class="mt-1 text-2xl font-bold text-green-600" x-text="market.completed_24h ?? '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">24h 取消</p>
          <p class="mt-1 text-2xl font-bold text-ink-500" x-text="market.cancelled_24h ?? '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">争议中</p>
          <p class="mt-1 text-2xl font-bold" :class="(market.disputed ?? 0) > 0 ? 'text-red-600' : 'text-ink-500'" x-text="market.disputed ?? '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">24h KAS 量</p>
          <p class="mt-1 text-2xl font-bold text-brand-500" x-text="market.kas_volume_24h?.toFixed(2) ?? '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">KAS 价</p>
          <p class="mt-1 text-2xl font-bold text-purple-600" x-text="market.mid_price ? '$' + market.mid_price.toFixed(4) : '—'"></p>
        </div>
      </div>
    </section>

    <!-- ═══ BROKER STATE PANEL (KI-64 1B.2 — cross-product) ═══ -->
    <section class="bg-white rounded-lg shadow-sm border border-warm-200">
      <div class="px-5 py-3 border-b border-warm-200 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-blue-600">🤖</span>
          <h2 class="text-sm font-semibold text-ink-700">Broker 状态 (cross-product)</h2>
        </div>
        <span class="text-xs text-ink-400">
          <span x-text="brokers.filter(b => b.status === 'alive').length"></span>/<span x-text="brokers.length"></span> alive
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="bg-warm-50 text-ink-500">
            <tr>
              <th class="px-3 py-2 text-left">名字</th>
              <th class="px-3 py-2 text-left">Scope</th>
              <th class="px-3 py-2 text-right">KAS 池</th>
              <th class="px-3 py-2 text-left">USDT 各链</th>
              <th class="px-3 py-2 text-center">Hedge 24h</th>
              <th class="px-3 py-2 text-right">DM 用量</th>
              <th class="px-3 py-2 text-right">活跃</th>
              <th class="px-3 py-2 text-center">状态</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            <template x-if="brokers.length === 0">
              <tr>
                <td colspan="8" class="px-3 py-8 text-center text-ink-300">
                  尚未注册 broker. <span class="text-ink-200">[+ Spawn New Broker] (Phase 2 排日)</span>
                </td>
              </tr>
            </template>
            <template x-for="b in brokers" :key="b.id">
              <tr class="hover:bg-warm-50">
                <td class="px-3 py-2 font-medium text-ink-700" x-text="b.name"></td>
                <td class="px-3 py-2">
                  <template x-for="s in b.scope" :key="s">
                    <span class="inline-block px-1.5 py-0.5 mr-1 rounded text-[10px] font-medium"
                          :class="s === 'exchange' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'"
                          x-text="s"></span>
                  </template>
                  <span x-show="!b.scope || b.scope.length === 0" class="text-ink-300 text-[10px]">—</span>
                </td>
                <td class="px-3 py-2 text-right font-mono">
                  <span x-text="b.kas_pool != null ? b.kas_pool.toFixed(2) : '—'"></span>
                </td>
                <td class="px-3 py-2 text-[10px] text-ink-500">
                  <template x-for="(amt, chain) in b.usdt_by_chain" :key="chain">
                    <span class="inline-block mr-2"><span class="font-medium" x-text="chain.toUpperCase()"></span> $<span x-text="amt.toFixed(2)"></span></span>
                  </template>
                  <span x-show="Object.keys(b.usdt_by_chain || {}).length === 0" class="text-ink-300">—</span>
                </td>
                <td class="px-3 py-2 text-center">
                  <span class="text-green-600" x-text="b.hedge_24h.placed"></span>✓
                  <span x-show="b.hedge_24h.failed > 0" class="text-red-600 ml-1">/<span x-text="b.hedge_24h.failed"></span>✗</span>
                  <span x-show="b.hedge_24h.skipped > 0" class="text-ink-400 ml-1">/<span x-text="b.hedge_24h.skipped"></span>⊘</span>
                </td>
                <td class="px-3 py-2 text-right">
                  <span class="font-mono" x-text="b.dm_count_today"></span>/<span class="text-ink-400" x-text="b.dm_cap"></span>
                  <div class="w-full bg-warm-200 rounded h-1 mt-0.5">
                    <div class="bg-blue-500 h-1 rounded" :style="`width: ${Math.min(100, (b.dm_count_today / b.dm_cap) * 100)}%`"></div>
                  </div>
                </td>
                <td class="px-3 py-2 text-right text-ink-500"
                    x-text="b.age_min != null ? (b.age_min < 60 ? b.age_min + 'min前' : Math.floor(b.age_min / 60) + 'h前') : '—'"></td>
                <td class="px-3 py-2 text-center">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium"
                        :class="b.status === 'alive' ? 'bg-green-100 text-green-700' : b.status === 'idle' ? 'bg-yellow-100 text-yellow-700' : b.status === 'down' ? 'bg-red-100 text-red-700' : 'bg-warm-100 text-ink-500'"
                        x-text="b.status === 'alive' ? '✅ alive' : b.status === 'idle' ? '⚠ idle' : b.status === 'down' ? '❌ down' : '— unknown'"></span>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ═══ FINANCIAL KPI PANEL (KI-64 1B.3 — 24h aggregate cross-product) ═══ -->
    <section class="bg-white rounded-lg shadow-sm border border-warm-200">
      <div class="px-5 py-3 border-b border-warm-200 flex items-center gap-2">
        <span class="text-emerald-600">💰</span>
        <h2 class="text-sm font-semibold text-ink-700">财务 KPI (24h 全 broker 合计)</h2>
        <span class="text-[10px] text-ink-400 ml-auto">per-broker 拆分待 v138 排日</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 p-5">
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">Exchange Fee</p>
          <p class="mt-1 text-xl font-bold text-ink-400" title="broker_fee_kas col 排日"
             x-text="financials_total?.fee_exchange_24h != null ? '$' + financials_total.fee_exchange_24h.toFixed(2) : 'N/A'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">Prediction Fee</p>
          <p class="mt-1 text-xl font-bold text-ink-400" title="Bettor B2 mainnet merge 后启用"
             x-text="financials_total?.fee_prediction_24h != null ? '$' + financials_total.fee_prediction_24h.toFixed(2) : 'N/A'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">Hedge KAS 量</p>
          <p class="mt-1 text-xl font-bold text-blue-600"
             x-text="financials_total?.hedge_24h_kas_volume != null ? financials_total.hedge_24h_kas_volume.toFixed(2) : '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">Hedge USD 值</p>
          <p class="mt-1 text-xl font-bold text-blue-600"
             x-text="financials_total?.hedge_24h_usd_value != null ? '$' + financials_total.hedge_24h_usd_value.toFixed(2) : '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">Hedge 均价</p>
          <p class="mt-1 text-xl font-bold text-ink-500"
             x-text="financials_total?.hedge_24h_avg_price != null ? '$' + financials_total.hedge_24h_avg_price.toFixed(6) : '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">完成单数</p>
          <p class="mt-1 text-xl font-bold text-ink-600" x-text="financials_total?.completed_offers_24h ?? 0"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">完成 KAS</p>
          <p class="mt-1 text-xl font-bold text-ink-600"
             x-text="financials_total?.completed_kas_volume_24h != null ? financials_total.completed_kas_volume_24h.toFixed(2) : '—'"></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-ink-400 uppercase tracking-wider">净盈亏</p>
          <p class="mt-1 text-xl font-bold text-ink-400" title="fee tracking ship 后启用"
             x-text="financials_total?.net_pnl_24h != null ? (financials_total.net_pnl_24h >= 0 ? '+' : '') + '$' + financials_total.net_pnl_24h.toFixed(2) : 'N/A'"></p>
        </div>
      </div>
      <div class="px-5 py-2 text-[10px] text-ink-300 border-t border-warm-100">
        注: Exchange Fee / 净盈亏 = N/A 待 broker_fee_kas col ship. Prediction Fee = N/A 待 Bettor B2 mainnet merge. 现 hedge + 完成 stats 是全 broker aggregate, per-broker 拆分待 chain_events.broker_relay_id col (v138 排日). broker 合计 = <span x-text="financials_total?.broker_count ?? 0"></span> brokers.
      </div>
    </section>

    <!-- ═══ STUCK ESCROW PANEL (KI-63 实证 — silent stuck surface) ═══ -->
    <section class="bg-white rounded-lg shadow-sm border border-warm-200">
      <div class="px-5 py-3 border-b border-warm-200 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span :class="stuck.length > 0 ? 'text-red-600' : 'text-green-600'" x-text="stuck.length > 0 ? '⚠' : '✅'"></span>
          <h2 class="text-sm font-semibold text-ink-700">卡住 Escrow 监控 (active &gt; 1h 或 refunded 但无 refund_tx)</h2>
        </div>
        <span class="text-xs px-2 py-0.5 rounded"
              :class="stuck.length > 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'">
          <span x-text="stuck.length"></span> 笔
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="bg-warm-50 text-ink-500">
            <tr>
              <th class="px-3 py-2 text-left">ID</th>
              <th class="px-3 py-2 text-left">方向</th>
              <th class="px-3 py-2 text-right">金额</th>
              <th class="px-3 py-2 text-left">资产</th>
              <th class="px-3 py-2 text-left">链</th>
              <th class="px-3 py-2 text-left">用户</th>
              <th class="px-3 py-2 text-left">状态</th>
              <th class="px-3 py-2 text-right">年龄(h)</th>
              <th class="px-3 py-2 text-left">原因</th>
              <th class="px-3 py-2 text-left">付款 TX</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            <template x-if="stuck.length === 0">
              <tr>
                <td colspan="10" class="px-3 py-8 text-center text-ink-300">无卡住 escrow ✓</td>
              </tr>
            </template>
            <template x-for="e in stuck" :key="e.id">
              <tr class="hover:bg-warm-50">
                <td class="px-3 py-2 font-mono text-ink-600" x-text="e.id?.slice(0,8)"></td>
                <td class="px-3 py-2" x-text="e.side"></td>
                <td class="px-3 py-2 text-right font-mono" x-text="e.amount ?? '—'"></td>
                <td class="px-3 py-2" x-text="e.asset"></td>
                <td class="px-3 py-2" x-text="e.chain"></td>
                <td class="px-3 py-2 font-mono text-ink-500" x-text="(e.user_addr || '').slice(0,12) + '…'"></td>
                <td class="px-3 py-2">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium"
                        :class="e.status === 'refunded' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'"
                        x-text="e.status"></span>
                </td>
                <td class="px-3 py-2 text-right" x-text="e.age_hours"></td>
                <td class="px-3 py-2">
                  <span class="text-[10px]"
                        :class="e.stuck_reason === 'refund_tx_lie' ? 'text-red-700' : 'text-yellow-700'"
                        x-text="e.stuck_reason === 'refund_tx_lie' ? 'refund_tx=NULL (KI 63 lie)' : '超时未settle'"></span>
                </td>
                <td class="px-3 py-2 font-mono text-ink-400 text-[10px]" x-text="(e.paytx || '').slice(0,16) + (e.paytx ? '…' : '—')"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ═══ HISTORY PANEL (KI-64 1B.4 — pagination + filter + search + sort) ═══ -->
    <section class="bg-white rounded-lg shadow-sm border border-warm-200">
      <div class="px-5 py-3 border-b border-warm-200 flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <span class="text-violet-600">📋</span>
          <h2 class="text-sm font-semibold text-ink-700">历史单子</h2>
          <span class="text-[10px] text-ink-400">
            <span x-text="historyTotal"></span> 条 / 第 <span x-text="historyPage"></span>/<span x-text="historyTotalPages || 1"></span> 页
          </span>
        </div>
        <div class="flex items-center gap-2 text-xs flex-wrap">
          <select x-model="historyFilters.range" @change="loadHistory(1)" class="px-2 py-1 border border-warm-300 rounded text-ink-600">
            <option value="24h">最近 24h</option>
            <option value="7d">最近 7d</option>
            <option value="30d">最近 30d</option>
            <option value="all">全部</option>
          </select>
          <select x-model="historyFilters.status" @change="loadHistory(1)" class="px-2 py-1 border border-warm-300 rounded text-ink-600">
            <option value="all">全部状态</option>
            <option value="completed">完成</option>
            <option value="cancelled">取消</option>
            <option value="disputed">争议</option>
            <option value="expired">过期</option>
            <option value="open">活跃</option>
          </select>
          <select x-model="historyFilters.scope" @change="loadHistory(1)" class="px-2 py-1 border border-warm-300 rounded text-ink-600">
            <option value="all">全部 scope</option>
            <option value="exchange">Exchange</option>
            <option value="prediction">Prediction (待)</option>
          </select>
          <input x-model="historyFilters.search" @keydown.enter="loadHistory(1)" placeholder="搜索 ID / TX / 地址"
                 class="px-2 py-1 border border-warm-300 rounded text-ink-600 w-44">
          <button @click="loadHistory(1)" class="px-2 py-1 bg-brand-500 text-white rounded hover:bg-brand-600">搜</button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="bg-warm-50 text-ink-500">
            <tr>
              <th class="px-3 py-2 text-left cursor-pointer hover:bg-warm-100" @click="sortBy('updated_at')">
                时间 <span x-show="historyFilters.sort === 'updated_at'" x-text="historyFilters.dir === 'desc' ? '↓' : '↑'"></span>
              </th>
              <th class="px-3 py-2 text-left">ID</th>
              <th class="px-3 py-2 text-left">Scope</th>
              <th class="px-3 py-2 text-left">方向</th>
              <th class="px-3 py-2 text-right cursor-pointer hover:bg-warm-100" @click="sortBy('give_amount')">
                给 <span x-show="historyFilters.sort === 'give_amount'" x-text="historyFilters.dir === 'desc' ? '↓' : '↑'"></span>
              </th>
              <th class="px-3 py-2 text-right">收</th>
              <th class="px-3 py-2 text-left cursor-pointer hover:bg-warm-100" @click="sortBy('protocol_status')">
                状态 <span x-show="historyFilters.sort === 'protocol_status'" x-text="historyFilters.dir === 'desc' ? '↓' : '↑'"></span>
              </th>
              <th class="px-3 py-2 text-left">Source</th>
              <th class="px-3 py-2 text-left">Settle TX</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            <template x-if="history.length === 0 && !historyLoading">
              <tr>
                <td colspan="9" class="px-3 py-8 text-center text-ink-300">
                  尚无历史 (当前 filter / 范围内). 试调整 filter OR 时间范围.
                </td>
              </tr>
            </template>
            <template x-if="historyLoading">
              <tr><td colspan="9" class="px-3 py-4 text-center text-ink-400">加载中...</td></tr>
            </template>
            <template x-for="h in history" :key="h.id">
              <tr class="hover:bg-warm-50">
                <td class="px-3 py-2 text-ink-500" :title="'UTC: ' + h.updated_at" x-text="formatLocalTime(h.updated_at)"></td>
                <td class="px-3 py-2 font-mono text-ink-600" x-text="h.id?.slice(0,8)"></td>
                <td class="px-3 py-2">
                  <span class="px-1.5 py-0.5 rounded text-[10px] bg-blue-100 text-blue-700" x-text="h.scope"></span>
                </td>
                <td class="px-3 py-2" x-text="h.side"></td>
                <td class="px-3 py-2 text-right font-mono" x-text="h.give.amount + ' ' + h.give.asset"></td>
                <td class="px-3 py-2 text-right font-mono" x-text="h.want.amount + ' ' + h.want.asset"></td>
                <td class="px-3 py-2">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium"
                        :class="statusBadgeClass(h.status)"
                        x-text="h.status"></span>
                </td>
                <td class="px-3 py-2 text-[10px] text-ink-500" x-text="h.source || '—'"></td>
                <td class="px-3 py-2 font-mono text-ink-400 text-[10px]" x-text="h.settle_tx ? h.settle_tx.slice(0,12) + '…' : '—'"></td>
              </tr>
            </template>
          </tbody>
        </table>
        <!-- Pagination -->
        <div class="px-5 py-3 border-t border-warm-100 flex items-center justify-between text-xs">
          <div class="text-ink-500">
            显示 <span x-text="history.length > 0 ? ((historyPage - 1) * historyLimit + 1) : 0"></span>-<span x-text="(historyPage - 1) * historyLimit + history.length"></span> 共 <span x-text="historyTotal"></span> 条
            <span class="text-[10px] text-ink-300 ml-2">时区: 本地 UTC+7 (源 UTC)</span>
          </div>
          <div class="flex items-center gap-2">
            <button @click="loadHistory(Math.max(1, historyPage - 1))" :disabled="historyPage <= 1 || historyLoading"
                    class="px-2 py-1 border border-warm-300 rounded text-ink-600 hover:bg-warm-50 disabled:opacity-40">上一页</button>
            <span class="font-mono"><span x-text="historyPage"></span> / <span x-text="historyTotalPages || 1"></span></span>
            <button @click="loadHistory(historyPage + 1)" :disabled="historyPage >= historyTotalPages || historyLoading"
                    class="px-2 py-1 border border-warm-300 rounded text-ink-600 hover:bg-warm-50 disabled:opacity-40">下一页</button>
            <select x-model="historyLimit" @change="loadHistory(1)" class="px-2 py-1 border border-warm-300 rounded text-ink-600">
              <option value="20">20/页</option>
              <option value="50">50/页</option>
              <option value="100">100/页</option>
            </select>
          </div>
        </div>
      </div>
    </section>

    <div class="text-center text-[10px] text-ink-300 pt-2">
      Phase 1A + 1B v3 — Owner '重点中的重点'. v5 spec NWT N19.174/175/177/180/181. 后续 Phase 1C/1D / Phase 2 排日.
    </div>

  </div>
</div>

<script>
function adminControlRoom() {
  return {
    market: {},
    brokers: [],
    financials_total: null,
    stuck: [],
    history: [],
    historyTotal: 0,
    historyPage: 1,
    historyLimit: 50,
    historyTotalPages: 0,
    historyLoading: false,
    historyFilters: {
      range: '24h',
      status: 'all',
      scope: 'all',
      search: '',
      sort: 'updated_at',
      dir: 'desc',
    },
    lastRefresh: null,
    lastRefreshRel: '',
    autoRefresh: true,
    _timer: null,

    async loadAll() {
      await Promise.all([this.loadOverview(), this.loadHistory(this.historyPage)]);
    },

    async loadOverview() {
      try {
        const r = await fetch('/api/admin/overview');
        if (!r.ok) {
          console.error('[admin] /api/admin/overview HTTP', r.status);
          return;
        }
        const data = await r.json();
        if (!data.ok) {
          console.error('[admin] /api/admin/overview error', data.error);
          return;
        }
        this.market = data.market || {};
        this.brokers = data.brokers || [];
        this.financials_total = data.financials_total || null;
        this.stuck = data.stuck || [];
        this.lastRefresh = Date.now();
        this._updateRel();
      } catch (e) {
        console.error('[admin] load fail', e);
      }
    },

    async loadHistory(page) {
      this.historyLoading = true;
      try {
        const params = new URLSearchParams({
          range: this.historyFilters.range,
          status: this.historyFilters.status,
          scope: this.historyFilters.scope,
          search: this.historyFilters.search,
          sort: this.historyFilters.sort,
          dir: this.historyFilters.dir,
          page: String(page || 1),
          limit: String(this.historyLimit),
        });
        const r = await fetch('/api/admin/history?' + params);
        if (!r.ok) { console.error('[admin] /api/admin/history HTTP', r.status); return; }
        const data = await r.json();
        if (!data.ok) { console.error('[admin] /api/admin/history error', data.error); return; }
        this.history = data.items || [];
        this.historyTotal = data.total || 0;
        this.historyTotalPages = data.total_pages || 0;
        this.historyPage = data.page || 1;
      } catch (e) {
        console.error('[admin] history load fail', e);
      } finally {
        this.historyLoading = false;
      }
    },

    sortBy(field) {
      if (this.historyFilters.sort === field) {
        this.historyFilters.dir = this.historyFilters.dir === 'desc' ? 'asc' : 'desc';
      } else {
        this.historyFilters.sort = field;
        this.historyFilters.dir = 'desc';
      }
      this.loadHistory(1);
    },

    formatLocalTime(utcStr) {
      if (!utcStr) return '—';
      try {
        let iso = utcStr;
        if (!iso.includes('T')) iso = iso.replace(' ', 'T') + 'Z';
        const d = new Date(iso);
        if (isNaN(d.getTime())) return utcStr;
        // UTC+7 Bangkok
        const local = new Date(d.getTime() + 7 * 60 * 60 * 1000);
        const Y = local.getUTCFullYear();
        const M = String(local.getUTCMonth() + 1).padStart(2, '0');
        const D = String(local.getUTCDate()).padStart(2, '0');
        const h = String(local.getUTCHours()).padStart(2, '0');
        const m = String(local.getUTCMinutes()).padStart(2, '0');
        return `${M}-${D} ${h}:${m}`;
      } catch { return utcStr; }
    },

    statusBadgeClass(status) {
      const map = {
        completed: 'bg-green-100 text-green-700',
        cancelled: 'bg-gray-100 text-gray-700',
        disputed: 'bg-red-100 text-red-700',
        expired: 'bg-yellow-100 text-yellow-700',
        open: 'bg-blue-100 text-blue-700',
        matched: 'bg-indigo-100 text-indigo-700',
      };
      return map[status] || 'bg-warm-100 text-ink-500';
    },

    _updateRel() {
      if (!this.lastRefresh) return;
      const sec = Math.floor((Date.now() - this.lastRefresh) / 1000);
      this.lastRefreshRel = sec < 5 ? '刚刚' : sec < 60 ? `${sec}s 前` : `${Math.floor(sec/60)}m 前`;
    },

    toggleAutoRefresh() {
      if (this._timer) { clearInterval(this._timer); this._timer = null; }
      if (this.autoRefresh) {
        this._timer = setInterval(() => { this.loadAll(); this._updateRel(); }, 30000);
      }
    },

    init() {
      this.toggleAutoRefresh();
      // tick rel time every 5s without full refresh
      setInterval(() => this._updateRel(), 5000);
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

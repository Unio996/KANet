<%~ include('partials/page-open', { _page: 'predictions', pageTitle: '预测市场', ...it }) %>

<!-- KANet-UI 2026-06-06 (Bettor 关1 派 r265+r265b 7 条): 预测市场首页. 干净 0 jargon. -->
<div class="p-6 max-w-6xl mx-auto" x-data="predictionsListPage()" x-init="init()">

  <div class="flex items-center justify-between mb-5">
    <div>
      <h1 class="text-2xl font-display text-ink-800">预测市场</h1>
      <p class="text-xs text-ink-400 mt-1">看现在能押什么. 押对的人均分输家池子.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/my-markets" class="btn btn-secondary btn-sm">看我建的</a>
      <a href="/predictions/pool/create" class="btn btn-primary btn-sm">+ 发起预测</a>
    </div>
  </div>

  <!-- 门D 零售首访 tour (Bettor r509): 用自己钱包押的零售用户 — 领钱→找单→押, 3 步. 不建 agent. -->
  <div x-show="showRetailHint" x-cloak class="card card-flush overflow-hidden mb-5 border-emerald-200">
    <div class="px-5 py-3 bg-emerald-50 border-b border-emerald-100 flex items-center justify-between">
      <span class="text-sm font-medium text-emerald-800">第一次来？用你自己的钱包押，3 步开始</span>
      <button @click="dismissRetailHint()" class="text-xs text-emerald-500 hover:text-emerald-700">知道了</button>
    </div>
    <div class="px-5 py-4 grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
      <div class="bg-warm-50 rounded-lg p-3">
        <div class="font-medium text-ink-700 mb-1">① 领测试 KAS</div>
        <p class="text-ink-500 mb-2">没有 testnet KAS？输地址领一点（够押注 + 链上 fee）。币零价值，纯试玩。</p>
        <a href="/faucet" class="inline-block px-2.5 py-1 rounded bg-emerald-500 text-white hover:bg-emerald-600">去领 KAS →</a>
      </div>
      <div class="bg-warm-50 rounded-lg p-3">
        <div class="font-medium text-ink-700 mb-1">② 找一个能押的市场</div>
        <p class="text-ink-500 mb-2">点下方 <strong>“进行中”</strong> 只看还在收押注的市场，挑个你有看法的。</p>
        <button @click="filterMode = 'open'" class="inline-block px-2.5 py-1 rounded bg-emerald-500 text-white hover:bg-emerald-600">只看进行中 →</button>
      </div>
      <div class="bg-warm-50 rounded-lg p-3">
        <div class="font-medium text-ink-700 mb-1">③ 用钱包押注</div>
        <p class="text-ink-500">点市场的 <strong>“押 →”</strong>，选 <strong>“用我的钱包付”</strong>，按提示用你钱包付到生成的地址。押对均分输家池。</p>
      </div>
    </div>
  </div>

  <!-- KANet-UI 2026-06-07 Track B (Bettor r335 关 1 PASS): filter + 排序 + 题目搜 -->
  <!-- KANet-UI 2026-06-08 DoD 问 1 (Bettor r369 关 1 PASS): broker 推荐 filter mode -->
  <div class="flex flex-wrap items-center gap-2 mb-4 text-xs">
    <button @click="filterMode = 'all'" :class="filterMode === 'all' ? 'bg-brand-500 text-white' : 'bg-white border border-warm-300 text-ink-600 hover:bg-warm-50'" class="px-3 py-1.5 rounded-lg transition">全部 (<span x-text="counts.all"></span>)</button>
    <button @click="filterMode = 'open'" :class="filterMode === 'open' ? 'bg-brand-500 text-white' : 'bg-white border border-warm-300 text-ink-600 hover:bg-warm-50'" class="px-3 py-1.5 rounded-lg transition">进行中 (<span x-text="counts.open"></span>)</button>
    <button @click="filterMode = 'settled'" :class="filterMode === 'settled' ? 'bg-brand-500 text-white' : 'bg-white border border-warm-300 text-ink-600 hover:bg-warm-50'" class="px-3 py-1.5 rounded-lg transition">已结算 (<span x-text="counts.settled"></span>)</button>
    <button @click="filterMode = 'recommended'" :class="filterMode === 'recommended' ? 'bg-amber-500 text-white' : 'bg-white border border-warm-300 text-ink-600 hover:bg-warm-50'" class="px-3 py-1.5 rounded-lg transition">🌟 Broker 推荐 (<span x-text="counts.recommended"></span>)</button>
    <div class="flex-1"></div>
    <input type="text" x-model.debounce.300ms="searchQuery" placeholder="搜题目..." class="px-3 py-1.5 rounded-lg border border-warm-300 text-xs w-40 focus:outline-none focus:border-brand-400" />
    <select x-model="sortMode" class="px-3 py-1.5 rounded-lg border border-warm-300 bg-white text-xs">
      <option value="newest">最新建</option>
      <option value="deadline">截止最近</option>
      <option value="pool">押注池最大</option>
      <option value="bettors">押注人最多</option>
    </select>
    <span class="text-[10px] text-ink-400" title="排序限当前加载页 (testnet 范围)">📌 排序限当前加载</span>
  </div>

  <div x-show="loading" class="text-center py-16 text-ink-400">载入中...</div>

  <div x-show="!loading && filtered().length === 0" class="text-center py-16 bg-warm-50 rounded-lg">
    <div class="text-3xl mb-3">🪧</div>
    <p class="text-ink-500" x-text="filterMode === 'open' ? '现在没有进行中的市场.' : (filterMode === 'settled' ? '还没有已结算的市场.' : '还没有市场.')"></p>
    <a href="/predictions/pool/create" class="text-brand-500 hover:text-brand-700 text-sm mt-2 inline-block">发起第一个 →</a>
  </div>

  <div x-show="!loading && filtered().length > 0" class="space-y-2">
    <template x-for="m in filtered()" :key="m.id">
      <div class="card p-4 hover:border-brand-300 hover:bg-warm-50 transition"
           :class="m._recommended ? 'border-amber-300 bg-amber-50/30' : ''">
        <div class="flex items-start gap-3">
          <a :href="`/predictions/pool/${encodeURIComponent(m.id)}`" class="flex-1 min-w-0 cursor-pointer">
            <div class="text-sm font-medium text-ink-700 leading-snug" x-text="m.title || m.id.slice(0, 20)"></div>
            <div class="flex items-center gap-3 mt-2 text-xs text-ink-500 flex-wrap">
              <span class="px-2 py-0.5 rounded font-medium" :class="statusBadge(m.statusKind)" x-text="statusLabel(m.statusKind)"></span>
              <!-- DoD 问 1: broker 推荐 badge (= 三层制衡第 1 层 透明) -->
              <span x-show="m._recommended" class="px-2 py-0.5 rounded font-medium bg-amber-100 text-amber-700">🌟 <span x-text="m._broker_name + ' 推荐'"></span></span>
              <span x-show="m._recommended && m._prevet_score != null" class="text-ink-500" x-text="'易裁度 ' + m._prevet_score + '/10'"></span>
              <span x-show="m._recommended && m._broker_history_accuracy != null" class="text-ink-500" x-text="'broker 历史准确率 ' + (m._broker_history_accuracy * 100).toFixed(0) + '%'"></span>
              <span x-show="m.deadlineDate" x-text="'截止 ' + m.deadlineDate"></span>
              <span x-text="'出单人: ' + makerLabel(m)"></span>
            </div>
          </a>
          <div class="text-right text-xs text-ink-500 shrink-0 min-w-[180px]">
            <!-- KANet-UI 2026-06-07 P1-#2 (Bettor r327 关 1 PASS): 隐含概率 + 赔率 tooltip
                 注: pre-fee 毛值 (= 没扣 broker 3% 等), 当估算非保证 -->
            <div :title="oddsTooltip(m, 'YES')">YES <span class="font-medium text-ink-700" x-text="m.yes_pool_kas?.toFixed(2) ?? '?'"></span> KAS
              <span x-show="m.yes_implied_prob != null" class="text-ink-400" x-text="'(' + (m.yes_implied_prob * 100).toFixed(1) + '%)'"></span>
            </div>
            <div :title="oddsTooltip(m, 'NO')">NO <span class="font-medium text-ink-700" x-text="m.no_pool_kas?.toFixed(2) ?? '?'"></span> KAS
              <span x-show="m.no_implied_prob != null" class="text-ink-400" x-text="'(' + (m.no_implied_prob * 100).toFixed(1) + '%)'"></span>
            </div>
            <div x-show="m.yes_implied_prob != null" class="text-[10px] text-ink-400 mt-0.5">赔率 估算 (扣费前)</div>
            <a x-show="m.statusKind === 'open'" :href="`/predictions/pool/${encodeURIComponent(m.id)}#bet`"
               class="inline-block mt-1.5 px-2.5 py-1 text-xs rounded bg-brand-500 hover:bg-brand-600 text-white font-medium">押 →</a>
          </div>
        </div>
      </div>
    </template>
  </div>
</div>

<script>
function predictionsListPage() {
  return {
    loading: true,
    markets: [],
    filterMode: 'open',
    counts: { all: 0, open: 0, settled: 0, recommended: 0 },
    // KANet-UI 2026-06-08 DoD 问 1 (Bettor r369 关 1 PASS): broker 推荐 state (= J2 endpoint /api/broker/recommendations)
    recommended: [],
    // KANet-UI 2026-06-07 Track B (Bettor r335 关 1 PASS): 搜 + 排序 state
    searchQuery: '',
    sortMode: 'newest',
    // 门D 零售首访 tour (Bettor r509): 用自己钱包押的零售用户引导, 1 次 dismiss persist
    showRetailHint: !localStorage.getItem('kanet_predict_retail_hint_seen'),

    async init() {
      // KANet-UI 2026-06-08 DoD 问 1: 并行拉 broker 推荐 (= J2 r409 endpoint live)
      this.loadRecommendations().catch(() => {});
      try {
        const r = await fetch('/api/pool/markets?limit=200').then(x => x.json());
        const raw = (r.markets || []);
        this.markets = raw.map(m => {
          let title = m.id;
          try { const o = JSON.parse(m.resolution_rule_spec || ''); title = o.title || title; } catch {}
          const statusKind = this.classifyStatus(m.protocol_status);
          let deadlineDate = '';
          if (m.deadline) {
            const d = new Date(Number(m.deadline) * 1000);
            if (!Number.isNaN(+d)) {
              const pad = n => n < 10 ? '0' + n : '' + n;
              deadlineDate = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
            }
          }
          return { ...m, title, statusKind, deadlineDate };
        });
        this.counts.all = this.markets.length;
        this.counts.open = this.markets.filter(m => m.statusKind === 'open' || m.statusKind === 'awaiting').length;
        this.counts.settled = this.markets.filter(m => m.statusKind === 'settled').length;
      } catch (e) { console.warn('predictions list load fail', e); }
      this.loading = false;
    },
    dismissRetailHint() {
      this.showRetailHint = false;
      localStorage.setItem('kanet_predict_retail_hint_seen', '1');
    },
    classifyStatus(s) {
      if (s === 'completed') return 'settled';
      if (s === 'collecting_sigs' || s === 'verifying') return 'awaiting';
      if (s === 'cancelled' || s === 'refunded') return 'closed';
      if (s === 'pending_bettors') return 'open';
      return 'open';
    },
    statusLabel(k) {
      return ({ open: '押注中', awaiting: '等开奖', settled: '已结算', closed: '已取消' })[k] || k;
    },
    statusBadge(k) {
      return ({
        open: 'bg-emerald-100 text-emerald-700',
        awaiting: 'bg-amber-100 text-amber-700',
        settled: 'bg-brand-100 text-brand-700',
        closed: 'bg-warm-200 text-ink-500',
      })[k] || 'bg-warm-100 text-ink-500';
    },
    // KANet-UI 2026-06-08 DoD 问 1 (Bettor r369, J2 r409): broker 推荐 endpoint 拉
    // J2 contract: GET /api/broker/recommendations?broker_id=X&limit=10 → { ok, broker_id, recommendations: [...] }
    async loadRecommendations() {
      try {
        const agResp = await fetch('/api/agent/profile').then(r => r.json()).catch(() => ([]));
        const agents = Array.isArray(agResp) ? agResp : (agResp.agents || []);
        const brokers = agents.filter(a => a.is_dex_broker);
        if (!brokers.length) { this.counts.recommended = 0; return; }
        const all = [];
        for (const b of brokers) {
          try {
            const r = await fetch(`/api/broker/recommendations?broker_id=${encodeURIComponent(b.id)}&limit=10`).then(x => x.json());
            const list = r?.recommendations || [];
            for (const rec of list) all.push({ ...rec, broker_name: b.name, broker_id: b.id });
          } catch {}
        }
        this.recommended = all;
        this.counts.recommended = all.length;
        const byId = new Map(all.map(r => [r.market_id, r]));
        for (const m of this.markets) {
          const rec = byId.get(m.id);
          if (rec) {
            m._recommended = true;
            m._prevet_score = rec.prevet_score;
            m._broker_name = rec.broker_name;
            m._broker_history_accuracy = rec.broker_history_accuracy;
          }
        }
      } catch {}
    },
    // KANet-UI 2026-06-07 r308: maker_name (本节点) 优先, 否则跨节点显短 id
    makerLabel(m) {
      if (m.maker_name) return m.maker_name;
      if (m.maker_relay_id) return '跨节点 ' + String(m.maker_relay_id).slice(0, 8);
      return '?';
    },
    // KANet-UI 2026-06-07 P1-#2 (Bettor r327 关 1 PASS): 赔率 tooltip 估算
    // pre-fee 毛值; 仅估算非保证 (Bettor 校准 r327)
    oddsTooltip(m, side) {
      const yes = Number(m.yes_pool_kas || 0);
      const no = Number(m.no_pool_kas || 0);
      if (yes + no <= 0) return '押注池为空, 还没赔率';
      const myPool = side === 'YES' ? yes : no;
      const otherPool = side === 'YES' ? no : yes;
      if (myPool <= 0) return '此边为空, 无法算赔率';
      const mult = ((myPool + otherPool) / myPool).toFixed(2);
      return `押 ${side} 估算赔率 ${mult}x (= 押注池总额 / ${side} 池). 扣费前估算非保证.`;
    },
    filtered() {
      let arr = this.markets;
      if (this.filterMode === 'open') arr = arr.filter(m => m.statusKind === 'open' || m.statusKind === 'awaiting');
      else if (this.filterMode === 'settled') arr = arr.filter(m => m.statusKind === 'settled');
      else if (this.filterMode === 'recommended') arr = arr.filter(m => m._recommended);  // DoD 问 1
      // KANet-UI 2026-06-07 Track B (Bettor r335): 题目搜 (= 客户端 includes, 复用现 m.title)
      const q = (this.searchQuery || '').trim().toLowerCase();
      if (q) arr = arr.filter(m => (m.title || m.id || '').toLowerCase().includes(q));
      // 排序 (= 当前加载页, Bettor r335 校准: testnet demo 可接受, 标提示)
      const sorted = [...arr];
      if (this.sortMode === 'deadline') sorted.sort((a, b) => Number(a.deadline || 0) - Number(b.deadline || 0));
      else if (this.sortMode === 'pool') sorted.sort((a, b) => Number(b.yes_pool_kas || 0) + Number(b.no_pool_kas || 0) - Number(a.yes_pool_kas || 0) - Number(a.no_pool_kas || 0));
      else if (this.sortMode === 'bettors') sorted.sort((a, b) => Number(b.bettor_count || 0) - Number(a.bettor_count || 0));
      // 'newest' default = 已 ORDER BY created_at DESC, 不排
      return sorted;
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

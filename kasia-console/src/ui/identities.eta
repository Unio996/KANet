<!DOCTYPE html>
<html lang="<%= it.t.html_lang %>" dir="<%= it.dir %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= it.t.page_identities %> — KANet Console</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="flex h-screen bg-gray-100 font-sans">

  <!-- Sidebar -->
  <aside class="w-56 bg-gray-900 text-gray-100 flex flex-col flex-shrink-0">
    <div class="px-4 py-4 border-b border-gray-700 flex items-center space-x-3">
      <img src="/public/kanet-logo.png" alt="KANet" class="h-8 w-8 object-contain flex-shrink-0" />
      <span class="text-base font-bold tracking-wide text-white leading-tight">KANet<br/><span class="text-xs font-normal text-gray-400">Console</span></span>
    </div>
    <nav class="flex-1 py-4 space-y-1 px-3 overflow-y-auto">
      <a href="/agent" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        我的 Agent
      </a>
      <a href="/conversations" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
        会话
      </a>
      <a href="/identities" class="flex items-center px-3 py-2 rounded-md text-sm font-medium bg-gray-700 text-white">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        通讯录
      </a>
      <a href="/network" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
        网络
      </a>
      <a href="/chat" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        聊天
      </a>
      <div class="pt-4 border-t border-gray-700 mt-4 space-y-1">
        <a href="/events" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          活动日志
        </a>
        <div class="flex items-center px-3 py-2 text-xs font-medium text-gray-500 uppercase tracking-wider">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          系统设置
        </div>
        <a href="/relays" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors pl-9">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
          账户管理
        </a>
        <a href="/adapters" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors pl-9">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          AI 引擎
        </a>
      </div>
    </nav>
    <div class="px-3 pb-2">
      <form method="POST" action="/lang">
        <select name="lang" onchange="this.form.submit()"
          class="w-full bg-gray-800 text-gray-200 text-xs rounded px-2 py-1.5 border border-gray-700 focus:outline-none cursor-pointer">
          <% Object.entries(it.langs).forEach(function([code, label]) { %>
          <option value="<%= code %>" <%= it.lang === code ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </form>
    </div>
    <div class="px-5 py-3 border-t border-gray-700 text-xs text-gray-500">
      KANet Console v0.1
    </div>
  </aside>

  <!-- Main content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between flex-shrink-0">
      <h1 class="text-xl font-semibold text-gray-800"><%= it.t.page_identities %></h1>
      <form method="GET" action="/identities" class="flex items-center gap-2">
        <input type="hidden" name="filter" value="<%= it.filter %>" />
        <label class="text-sm text-gray-500"><%= it.t.label_account || 'Account' %>:</label>
        <select name="account" onchange="this.form.submit()"
          class="border border-gray-300 rounded-md px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 cursor-pointer min-w-[160px]">
          <option value="" <%= !it.selectedAccount ? 'selected' : '' %>><%= it.t.filter_all %></option>
          <% it.relayNodes.forEach(function(rn) { %>
          <option value="<%= rn.id %>" <%= it.selectedAccount === rn.id ? 'selected' : '' %>>
            <%= rn.name %> (<%= rn.address ? rn.address.slice(-8) : '...' %>)
          </option>
          <% }) %>
        </select>
      </form>
    </header>

    <main class="flex-1 overflow-y-auto p-6 space-y-6">

      <!-- Address book summary for selected account -->
      <% if (it.selectedAccount) { %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200" x-data="{
        counts: { connected: 0, incoming: 0, outgoing: 0 },
        loading: true,
        async init() {
          await this.load();
        },
        async load() {
          try {
            const accountId = '<%= it.selectedAccount %>';
            const res = await fetch('/api/discovery/list?accountId=' + encodeURIComponent(accountId));
            const rows = await res.json();
            this.counts = { connected: 0, incoming: 0, outgoing: 0 };
            for (const r of rows) {
              if (this.counts[r.status] !== undefined) this.counts[r.status]++;
            }
          } catch {}
          this.loading = false;
        }
      }">
        <div class="px-5 py-4 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-gray-700">握手状态</h2>
          <a href="/discovered?account=<%= it.selectedAccount %>"
            class="text-xs text-blue-600 hover:text-blue-800 transition-colors">查看详情 &rarr;</a>
        </div>
        <div class="px-5 pb-4 flex items-center space-x-6" x-show="!loading">
          <div class="text-center">
            <div class="text-2xl font-bold text-green-600" x-text="counts.connected"></div>
            <div class="text-xs text-gray-500">已连接</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-amber-600" x-text="counts.incoming"></div>
            <div class="text-xs text-gray-500">待回应</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-blue-600" x-text="counts.outgoing"></div>
            <div class="text-xs text-gray-500">等待中</div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Contacts -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-200">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-gray-700"><%= it.t.contacts %></h2>
            <span class="text-xs text-gray-400"><%= it.remote.length %></span>
          </div>
          <!-- Filter tabs + tag filter -->
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex space-x-1">
              <% const filters = [
                { key: 'all', label: it.t.filter_all },
                { key: 'owner', label: it.t.filter_owner },
                { key: 'recommended', label: it.t.filter_recommended },
                { key: 'normal', label: it.t.filter_normal },
                { key: 'blocked', label: it.t.filter_blocked },
              ]; %>
              <% filters.forEach(function(f) { %>
              <a href="/identities?filter=<%= f.key %><%= it.selectedAccount ? '&account=' + it.selectedAccount : '' %><%= it.selectedTag ? '&tag=' + encodeURIComponent(it.selectedTag) : '' %>"
                class="px-3 py-1 rounded-full text-xs font-medium transition-colors
                  <%= it.filter === f.key ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                <%= f.label %>
              </a>
              <% }) %>
            </div>
            <% if (it.knownTags && it.knownTags.length > 0) { %>
            <select onchange="location.href='/identities?filter=<%= it.filter %><%= it.selectedAccount ? '&account=' + it.selectedAccount : '' %>' + (this.value ? '&tag=' + encodeURIComponent(this.value) : '')"
              class="border border-gray-300 rounded-md px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 cursor-pointer">
              <option value=""><%= it.t.label_tags %>: <%= it.t.filter_all %></option>
              <% it.knownTags.forEach(function(tag) { %>
              <option value="<%= tag %>" <%= it.selectedTag === tag ? 'selected' : '' %>><%= tag %></option>
              <% }) %>
            </select>
            <% } %>
          </div>
        </div>
        <% if (!it.remote || it.remote.length === 0) { %>
        <p class="px-5 py-6 text-center text-sm text-gray-400"><%= it.t.no_contacts %></p>
        <% } else { %>
        <div class="divide-y divide-gray-100">
          <% it.remote.forEach(function(id) { %>
          <div class="px-5 py-3" x-data="{ editing: false }">
            <div class="flex items-center justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <!-- Trust level badge -->
                  <% if (id.trust_level === 'owner') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700"><%= it.t.trust_owner %></span>
                  <% } else if (id.trust_level === 'recommended') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700"><%= it.t.trust_recommended %></span>
                  <% } else if (id.trust_level === 'blocked') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700"><%= it.t.trust_blocked %></span>
                  <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600"><%= it.t.trust_normal %></span>
                  <% } %>
                  <span class="text-sm font-medium text-gray-800"><%= id.display_name || id.address.slice(-8) %></span>
                  <% if (it.msgCounts[id.id]) { %>
                  <span class="text-xs text-gray-400"><%= it.t.msg_count %>: <%= it.msgCounts[id.id] %></span>
                  <% } %>
                  <% if (id.tags) { %>
                  <% id.tags.split(',').filter(Boolean).forEach(function(tag) { %>
                  <span class="inline-flex items-center px-1.5 py-0 rounded text-xs bg-blue-50 text-blue-600"><%= tag.trim() %></span>
                  <% }) %>
                  <% } %>
                </div>
                <p class="text-xs text-gray-500 font-mono mt-1 truncate"><%= id.address %></p>
                <% if (id.notes) { %>
                <p class="text-xs text-gray-400 mt-0.5 whitespace-pre-line"><%= id.notes %></p>
                <% } %>
              </div>
              <div class="ml-4 flex-shrink-0 flex items-center space-x-1">
                <!-- Link to conversation -->
                <% if (it.convLinks[id.id]) { %>
                <a href="/conversations/<%= it.convLinks[id.id] %>" class="text-xs text-blue-600 hover:text-blue-800 px-2 py-1 rounded hover:bg-blue-50" title="<%= it.t.view_conversation %>">
                  <svg class="h-4 w-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                </a>
                <% } %>
                <!-- Edit button -->
                <button @click="editing = !editing" class="text-xs text-blue-600 hover:text-blue-800 px-2 py-1 rounded hover:bg-blue-50">
                  <svg class="h-4 w-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </button>
                <!-- Quick block/unblock -->
                <form method="POST" action="/identities/<%= id.id %>/block" class="inline"
                  onsubmit="return confirm('<%= id.trust_level === 'blocked' ? it.t.confirm_unblock : it.t.confirm_block %>')">
                  <button type="submit" class="text-xs px-2 py-1 rounded
                    <%= id.trust_level === 'blocked' ? 'text-green-600 hover:text-green-800 hover:bg-green-50' : 'text-red-600 hover:text-red-800 hover:bg-red-50' %>">
                    <%= id.trust_level === 'blocked' ? it.t.btn_unblock : it.t.btn_block %>
                  </button>
                </form>
              </div>
            </div>
            <!-- Edit form -->
            <div x-show="editing" x-transition class="mt-3 pt-3 border-t border-gray-100">
              <form method="POST" action="/identities/<%= id.id %>" class="space-y-3">
                <div class="grid grid-cols-3 gap-3">
                  <div>
                    <label class="block text-xs text-gray-500 mb-1"><%= it.t.label_display_name %></label>
                    <input type="text" name="display_name" value="<%= id.display_name || '' %>"
                      class="w-full text-sm border border-gray-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                  </div>
                  <div x-data="tagPicker($el.dataset.tags)" data-tags="<%= id.tags || '' %>">
                    <label class="block text-xs text-gray-500 mb-1"><%= it.t.label_tags %></label>
                    <input type="hidden" name="tags" :value="selected.join(',')" />
                    <div class="flex flex-wrap gap-1 mb-1">
                      <% it.knownTags.forEach(function(tag) { %>
                      <button type="button" @click="toggle('<%= tag %>')"
                        class="px-2 py-0.5 rounded text-xs transition-colors"
                        :class="selected.includes('<%= tag %>') ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'">
                        <%= tag %>
                      </button>
                      <% }) %>
                    </div>
                    <div class="flex items-center space-x-1">
                      <input type="text" x-model="newTag" @keydown.enter.prevent="addCustom()" placeholder="<%= it.t.tag_custom_ph || '+' %>"
                        class="flex-1 text-xs border border-gray-300 rounded px-2 py-1 focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                      <button type="button" @click="addCustom()" class="text-xs text-blue-600 hover:text-blue-800 px-2">+</button>
                    </div>
                  </div>
                  <div>
                    <label class="block text-xs text-gray-500 mb-1"><%= it.t.category %></label>
                    <select name="trust_level"
                      class="w-full text-sm border border-gray-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-blue-500 focus:border-blue-500">
                      <option value="owner" <%= id.trust_level === 'owner' ? 'selected' : '' %>><%= it.t.trust_owner %></option>
                      <option value="recommended" <%= id.trust_level === 'recommended' ? 'selected' : '' %>><%= it.t.trust_recommended %></option>
                      <option value="normal" <%= (id.trust_level === 'normal' || !id.trust_level) ? 'selected' : '' %>><%= it.t.trust_normal %></option>
                      <option value="blocked" <%= id.trust_level === 'blocked' ? 'selected' : '' %>><%= it.t.trust_blocked %></option>
                    </select>
                  </div>
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1"><%= it.t.label_notes %></label>
                  <textarea name="notes" rows="2"
                    class="w-full text-sm border border-gray-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-blue-500 focus:border-blue-500"><%= id.notes || '' %></textarea>
                </div>
                <div class="flex justify-end">
                  <button type="submit" class="bg-blue-600 text-white text-xs px-4 py-1.5 rounded hover:bg-blue-700 transition-colors"><%= it.t.btn_save %></button>
                </div>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- Add Contact -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-200">
          <h2 class="text-sm font-semibold text-gray-700"><%= it.t.add_contact %></h2>
        </div>
        <form method="POST" action="/identities" class="p-5 space-y-3">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs text-gray-500 mb-1"><%= it.t.label_address %> *</label>
              <input type="text" name="address" required placeholder="kaspa:qr..."
                class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 font-mono" />
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1"><%= it.t.label_display_name %></label>
              <input type="text" name="display_name"
                class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1"><%= it.t.category %></label>
              <select name="trust_level"
                class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-blue-500 focus:border-blue-500">
                <option value="normal"><%= it.t.trust_normal %></option>
                <option value="owner"><%= it.t.trust_owner %></option>
                <option value="recommended"><%= it.t.trust_recommended %></option>
                <option value="blocked"><%= it.t.trust_blocked %></option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1"><%= it.t.label_notes %></label>
            <textarea name="notes" rows="2"
              class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:ring-1 focus:ring-blue-500 focus:border-blue-500"></textarea>
          </div>
          <input type="hidden" name="network" value="mainnet" />
          <div class="flex justify-end">
            <button type="submit" class="bg-blue-600 text-white text-sm px-5 py-2 rounded hover:bg-blue-700 transition-colors"><%= it.t.btn_save %></button>
          </div>
        </form>
      </div>

      <!-- Tag Management -->
      <% if (it.knownTags && it.knownTags.length > 0) { %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-200">
          <h2 class="text-sm font-semibold text-gray-700"><%= it.t.tag_management || 'Tag Management' %></h2>
        </div>
        <div class="p-5">
          <div class="flex flex-wrap gap-2">
            <% it.knownTags.forEach(function(tag) { %>
            <div x-data="{ renaming: false, newName: '<%= tag %>' }" class="inline-flex items-center bg-gray-50 border border-gray-200 rounded-lg px-3 py-1.5 text-sm group">
              <template x-if="!renaming">
                <div class="flex items-center space-x-2">
                  <span class="text-gray-700 font-medium"><%= tag %></span>
                  <span class="text-xs text-gray-400">(<%= it.tagCounts[tag] || 0 %>)</span>
                  <button @click="renaming = true" class="text-gray-400 hover:text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity" title="<%= it.t.btn_rename || 'Rename' %>">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </button>
                  <form method="POST" action="/identities/tags/delete" class="inline"
                    onsubmit="return confirm('<%= it.t.confirm_delete_tag || 'Delete this tag from all contacts?' %> (<%= it.tagCounts[tag] || 0 %>)')">
                    <input type="hidden" name="tag" value="<%= tag %>" />
                    <button type="submit" class="text-gray-400 hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity" title="<%= it.t.btn_delete || 'Delete' %>">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                  </form>
                </div>
              </template>
              <template x-if="renaming">
                <form method="POST" action="/identities/tags/rename" class="flex items-center space-x-1">
                  <input type="hidden" name="old_tag" value="<%= tag %>" />
                  <input type="text" name="new_tag" x-model="newName"
                    class="w-24 text-xs border border-blue-300 rounded px-2 py-1 focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                  <button type="submit" class="text-blue-600 hover:text-blue-800 text-xs px-1">OK</button>
                  <button type="button" @click="renaming = false" class="text-gray-400 hover:text-gray-600 text-xs px-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </form>
              </template>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>

    </main>
  </div>

<script>
function tagPicker(initial) {
  return {
    selected: initial ? initial.split(',').map(t => t.trim()).filter(Boolean) : [],
    newTag: '',
    toggle(tag) {
      const i = this.selected.indexOf(tag);
      if (i >= 0) this.selected.splice(i, 1);
      else this.selected.push(tag);
    },
    addCustom() {
      const tag = this.newTag.trim().toLowerCase().replace(/[^a-z0-9_\u4e00-\u9fff]/g, '');
      if (tag && !this.selected.includes(tag)) {
        this.selected.push(tag);
      }
      this.newTag = '';
    }
  };
}
</script>
</body>
</html>

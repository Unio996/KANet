<%~ include('partials/page-open', { _page: 'identities', pageTitle: it.t.page_identities, headerRight: '<form method="GET" action="/identities" class="flex items-center gap-2"><input type="hidden" name="filter" value="' + it.filter + '" /><label class="text-sm text-ink-400">' + (it.t.label_account || 'Account') + ':</label><select name="account" onchange="this.form.submit()" class="border border-warm-300 rounded-md px-3 py-1.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 cursor-pointer min-w-[160px]"><option value=""' + (!it.selectedAccount ? ' selected' : '') + '>' + it.t.filter_all + '</option>' + it.relayNodes.map(function(rn) { return '<option value="' + rn.id + '"' + (it.selectedAccount === rn.id ? ' selected' : '') + '>' + rn.name + ' (' + (rn.address ? rn.address.slice(-8) : '...') + ')</option>'; }).join('') + '</select></form>', ...it }) %>

    <div class="p-6 space-y-6">

      <!-- Address book summary for selected account -->
      <% if (it.selectedAccount) { %>
      <div class="bg-white rounded-lg shadow-sm border border-warm-200" x-data="{
        counts: { connected: 0, incoming: 0, outgoing: 0 },
        loading: true,
        async init() {
          await this.load();
        },
        async load() {
          try {
            const accountId = '<%= it.selectedAccount %>';
            const res = await fetch('/api/discovery/list?accountId=' + encodeURIComponent(accountId));
            const rows = await res.json();
            this.counts = { connected: 0, incoming: 0, outgoing: 0 };
            for (const r of rows) {
              if (this.counts[r.status] !== undefined) this.counts[r.status]++;
            }
          } catch {}
          this.loading = false;
        }
      }">
        <div class="px-5 py-4 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-ink-600">握手状态</h2>
          <a href="/discovered?account=<%= it.selectedAccount %>"
            class="text-xs text-brand-500 hover:text-brand-700 transition-colors">查看详情 &rarr;</a>
        </div>
        <div class="px-5 pb-4 flex items-center space-x-6" x-show="!loading">
          <div class="text-center">
            <div class="text-2xl font-bold text-green-600" x-text="counts.connected"></div>
            <div class="text-xs text-ink-400">已连接</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-amber-600" x-text="counts.incoming"></div>
            <div class="text-xs text-ink-400">待回应</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-brand-500" x-text="counts.outgoing"></div>
            <div class="text-xs text-ink-400">等待中</div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Contacts -->
      <div class="bg-white rounded-lg shadow-sm border border-warm-200">
        <div class="px-5 py-4 border-b border-warm-200">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-ink-600"><%= it.t.contacts %></h2>
            <span class="text-xs text-ink-300"><%= it.remote.length %></span>
          </div>
          <!-- Filter tabs + tag filter -->
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex space-x-1">
              <% const filters = [
                { key: 'all', label: it.t.filter_all },
                { key: 'owner', label: it.t.filter_owner },
                { key: 'recommended', label: it.t.filter_recommended },
                { key: 'normal', label: it.t.filter_normal },
                { key: 'blocked', label: it.t.filter_blocked },
              ]; %>
              <% filters.forEach(function(f) { %>
              <a href="/identities?filter=<%= f.key %><%= it.selectedAccount ? '&account=' + it.selectedAccount : '' %><%= it.selectedTag ? '&tag=' + encodeURIComponent(it.selectedTag) : '' %>"
                class="px-3 py-1 rounded-full text-xs font-medium transition-colors
                  <%= it.filter === f.key ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200' %>">
                <%= f.label %>
              </a>
              <% }) %>
            </div>
            <% if (it.knownTags && it.knownTags.length > 0) { %>
            <select onchange="location.href='/identities?filter=<%= it.filter %><%= it.selectedAccount ? '&account=' + it.selectedAccount : '' %>' + (this.value ? '&tag=' + encodeURIComponent(this.value) : '')"
              class="border border-warm-300 rounded-md px-2 py-1 text-xs focus:ring-1 focus:ring-brand-500 focus:border-brand-500 cursor-pointer">
              <option value=""><%= it.t.label_tags %>: <%= it.t.filter_all %></option>
              <% it.knownTags.forEach(function(tag) { %>
              <option value="<%= tag %>" <%= it.selectedTag === tag ? 'selected' : '' %>><%= tag %></option>
              <% }) %>
            </select>
            <% } %>
          </div>
        </div>
        <% if (!it.remote || it.remote.length === 0) { %>
        <p class="px-5 py-6 text-center text-sm text-ink-300"><%= it.t.no_contacts %></p>
        <% } else { %>
        <div class="divide-y divide-warm-100">
          <% it.remote.forEach(function(id) { %>
          <div class="px-5 py-3" x-data="{ editing: false }">
            <div class="flex items-center justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <!-- Trust level badge -->
                  <% if (id.trust_level === 'owner') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700"><%= it.t.trust_owner %></span>
                  <% } else if (id.trust_level === 'recommended') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700"><%= it.t.trust_recommended %></span>
                  <% } else if (id.trust_level === 'blocked') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700"><%= it.t.trust_blocked %></span>
                  <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warm-100 text-ink-500"><%= it.t.trust_normal %></span>
                  <% } %>
                  <span class="text-sm font-medium text-ink-700"><%= id.display_name || id.address.slice(-8) %></span>
                  <% if (it.msgCounts[id.id]) { %>
                  <span class="text-xs text-ink-300"><%= it.t.msg_count %>: <%= it.msgCounts[id.id] %></span>
                  <% } %>
                  <% if (id.tags) { %>
                  <% id.tags.split(',').filter(Boolean).forEach(function(tag) { %>
                  <span class="inline-flex items-center px-1.5 py-0 rounded text-xs bg-blue-50 text-blue-600"><%= tag.trim() %></span>
                  <% }) %>
                  <% } %>
                </div>
                <p class="text-xs text-ink-400 font-mono mt-1 truncate"><%= id.address %></p>
                <% if (id.notes) { %>
                <p class="text-xs text-ink-300 mt-0.5 whitespace-pre-line"><%= id.notes %></p>
                <% } %>
              </div>
              <div class="ml-4 flex-shrink-0 flex items-center space-x-1">
                <!-- Link to conversation -->
                <% if (it.convLinks[id.id]) { %>
                <a href="/conversations/<%= it.convLinks[id.id] %>" class="text-xs text-brand-500 hover:text-brand-700 px-2 py-1 rounded hover:bg-blue-50" title="<%= it.t.view_conversation %>">
                  <svg class="h-4 w-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                </a>
                <% } %>
                <!-- Edit button -->
                <button @click="editing = !editing" class="text-xs text-brand-500 hover:text-brand-700 px-2 py-1 rounded hover:bg-blue-50">
                  <svg class="h-4 w-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </button>
                <!-- Quick block/unblock -->
                <form method="POST" action="/identities/<%= id.id %>/block" class="inline"
                  onsubmit="return confirm('<%= id.trust_level === 'blocked' ? it.t.confirm_unblock : it.t.confirm_block %>')">
                  <button type="submit" class="text-xs px-2 py-1 rounded
                    <%= id.trust_level === 'blocked' ? 'text-green-600 hover:text-green-800 hover:bg-green-50' : 'text-red-600 hover:text-red-800 hover:bg-red-50' %>">
                    <%= id.trust_level === 'blocked' ? it.t.btn_unblock : it.t.btn_block %>
                  </button>
                </form>
              </div>
            </div>
            <!-- Edit form -->
            <div x-show="editing" x-transition class="mt-3 pt-3 border-t border-warm-100">
              <form method="POST" action="/identities/<%= id.id %>" class="space-y-3">
                <div class="grid grid-cols-3 gap-3">
                  <div>
                    <label class="block text-xs text-ink-400 mb-1"><%= it.t.label_display_name %></label>
                    <input type="text" name="display_name" value="<%= id.display_name || '' %>"
                      class="w-full text-sm border border-warm-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-brand-500 focus:border-brand-500" />
                  </div>
                  <div x-data="tagPicker($el.dataset.tags)" data-tags="<%= id.tags || '' %>">
                    <label class="block text-xs text-ink-400 mb-1"><%= it.t.label_tags %></label>
                    <input type="hidden" name="tags" :value="selected.join(',')" />
                    <div class="flex flex-wrap gap-1 mb-1">
                      <% it.knownTags.forEach(function(tag) { %>
                      <button type="button" @click="toggle('<%= tag %>')"
                        class="px-2 py-0.5 rounded text-xs transition-colors"
                        :class="selected.includes('<%= tag %>') ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'">
                        <%= tag %>
                      </button>
                      <% }) %>
                    </div>
                    <div class="flex items-center space-x-1">
                      <input type="text" x-model="newTag" @keydown.enter.prevent="addCustom()" placeholder="<%= it.t.tag_custom_ph || '+' %>"
                        class="flex-1 text-xs border border-warm-300 rounded px-2 py-1 focus:ring-1 focus:ring-brand-500 focus:border-brand-500" />
                      <button type="button" @click="addCustom()" class="text-xs text-brand-500 hover:text-brand-700 px-2">+</button>
                    </div>
                  </div>
                  <div>
                    <label class="block text-xs text-ink-400 mb-1"><%= it.t.category %></label>
                    <select name="trust_level"
                      class="w-full text-sm border border-warm-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-brand-500 focus:border-brand-500">
                      <option value="owner" <%= id.trust_level === 'owner' ? 'selected' : '' %>><%= it.t.trust_owner %></option>
                      <option value="recommended" <%= id.trust_level === 'recommended' ? 'selected' : '' %>><%= it.t.trust_recommended %></option>
                      <option value="normal" <%= (id.trust_level === 'normal' || !id.trust_level) ? 'selected' : '' %>><%= it.t.trust_normal %></option>
                      <option value="blocked" <%= id.trust_level === 'blocked' ? 'selected' : '' %>><%= it.t.trust_blocked %></option>
                    </select>
                  </div>
                </div>
                <div>
                  <label class="block text-xs text-ink-400 mb-1"><%= it.t.label_notes %></label>
                  <textarea name="notes" rows="2"
                    class="w-full text-sm border border-warm-300 rounded px-2 py-1.5 focus:ring-1 focus:ring-brand-500 focus:border-brand-500"><%= id.notes || '' %></textarea>
                </div>
                <div class="flex justify-end">
                  <button type="submit" class="bg-brand-500 text-white text-xs px-4 py-1.5 rounded hover:bg-brand-600 transition-colors"><%= it.t.btn_save %></button>
                </div>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- Add Contact -->
      <div class="bg-white rounded-lg shadow-sm border border-warm-200">
        <div class="px-5 py-4 border-b border-warm-200">
          <h2 class="text-sm font-semibold text-ink-600"><%= it.t.add_contact %></h2>
        </div>
        <form method="POST" action="/identities" class="p-5 space-y-3">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs text-ink-400 mb-1"><%= it.t.label_address %> *</label>
              <input type="text" name="address" required placeholder="kaspa:qr..."
                class="w-full text-sm border border-warm-300 rounded px-3 py-2 focus:ring-1 focus:ring-brand-500 focus:border-brand-500 font-mono" />
            </div>
            <div>
              <label class="block text-xs text-ink-400 mb-1"><%= it.t.label_display_name %></label>
              <input type="text" name="display_name"
                class="w-full text-sm border border-warm-300 rounded px-3 py-2 focus:ring-1 focus:ring-brand-500 focus:border-brand-500" />
            </div>
            <div>
              <label class="block text-xs text-ink-400 mb-1"><%= it.t.category %></label>
              <select name="trust_level"
                class="w-full text-sm border border-warm-300 rounded px-3 py-2 focus:ring-1 focus:ring-brand-500 focus:border-brand-500">
                <option value="normal"><%= it.t.trust_normal %></option>
                <option value="owner"><%= it.t.trust_owner %></option>
                <option value="recommended"><%= it.t.trust_recommended %></option>
                <option value="blocked"><%= it.t.trust_blocked %></option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs text-ink-400 mb-1"><%= it.t.label_notes %></label>
            <textarea name="notes" rows="2"
              class="w-full text-sm border border-warm-300 rounded px-3 py-2 focus:ring-1 focus:ring-brand-500 focus:border-brand-500"></textarea>
          </div>
          <input type="hidden" name="network" value="mainnet" />
          <div class="flex justify-end">
            <button type="submit" class="bg-brand-500 text-white text-sm px-5 py-2 rounded hover:bg-brand-600 transition-colors"><%= it.t.btn_save %></button>
          </div>
        </form>
      </div>

      <!-- Tag Management -->
      <% if (it.knownTags && it.knownTags.length > 0) { %>
      <div class="bg-white rounded-lg shadow-sm border border-warm-200">
        <div class="px-5 py-4 border-b border-warm-200">
          <h2 class="text-sm font-semibold text-ink-600"><%= it.t.tag_management || 'Tag Management' %></h2>
        </div>
        <div class="p-5">
          <div class="flex flex-wrap gap-2">
            <% it.knownTags.forEach(function(tag) { %>
            <div x-data="{ renaming: false, newName: '<%= tag %>' }" class="inline-flex items-center bg-warm-100 border border-warm-200 rounded-lg px-3 py-1.5 text-sm group">
              <template x-if="!renaming">
                <div class="flex items-center space-x-2">
                  <span class="text-ink-600 font-medium"><%= tag %></span>
                  <span class="text-xs text-ink-300">(<%= it.tagCounts[tag] || 0 %>)</span>
                  <button @click="renaming = true" class="text-ink-300 hover:text-brand-500 opacity-0 group-hover:opacity-100 transition-opacity" title="<%= it.t.btn_rename || 'Rename' %>">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </button>
                  <form method="POST" action="/identities/tags/delete" class="inline"
                    onsubmit="return confirm('<%= it.t.confirm_delete_tag || 'Delete this tag from all contacts?' %> (<%= it.tagCounts[tag] || 0 %>)')">
                    <input type="hidden" name="tag" value="<%= tag %>" />
                    <button type="submit" class="text-ink-300 hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity" title="<%= it.t.btn_delete || 'Delete' %>">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                  </form>
                </div>
              </template>
              <template x-if="renaming">
                <form method="POST" action="/identities/tags/rename" class="flex items-center space-x-1">
                  <input type="hidden" name="old_tag" value="<%= tag %>" />
                  <input type="text" name="new_tag" x-model="newName"
                    class="w-24 text-xs border border-brand-300 rounded px-2 py-1 focus:ring-1 focus:ring-brand-500 focus:border-brand-500" />
                  <button type="submit" class="text-brand-500 hover:text-brand-700 text-xs px-1">OK</button>
                  <button type="button" @click="renaming = false" class="text-ink-300 hover:text-ink-500 text-xs px-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </form>
              </template>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>

    </div>

<script>
function tagPicker(initial) {
  return {
    selected: initial ? initial.split(',').map(t => t.trim()).filter(Boolean) : [],
    newTag: '',
    toggle(tag) {
      const i = this.selected.indexOf(tag);
      if (i >= 0) this.selected.splice(i, 1);
      else this.selected.push(tag);
    },
    addCustom() {
      const tag = this.newTag.trim().toLowerCase().replace(/[^a-z0-9_\u4e00-\u9fff]/g, '');
      if (tag && !this.selected.includes(tag)) {
        this.selected.push(tag);
      }
      this.newTag = '';
    }
  };
}
</script>
<%~ include('partials/page-close', it) %>

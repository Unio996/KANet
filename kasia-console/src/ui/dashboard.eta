<%~ include('partials/page-open', { _page: 'dashboard', pageTitle: it.t.page_dashboard, ...it }) %>

<script src="https://unpkg.com/htmx.org@1.9.10"></script>

      <div class="p-6">
      <!-- Stats cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-5">
          <p class="text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.stat_total_convs %></p>
          <p class="mt-2 text-3xl font-bold text-ink-700"><%= it.stats.total %></p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-5">
          <p class="text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.stat_active_convs %></p>
          <p class="mt-2 text-3xl font-bold text-green-600"><%= it.stats.active %></p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-5">
          <p class="text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.stat_today_msgs %></p>
          <p class="mt-2 text-3xl font-bold text-brand-500"><%= it.stats.todayMsgs %></p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-5">
          <p class="text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.stat_today_replies %></p>
          <p class="mt-2 text-3xl font-bold text-purple-600"><%= it.stats.todayReplies %></p>
        </div>
      </div>

      <!-- Event stats -->
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4 flex items-center space-x-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-warm-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-ink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-xs text-ink-400"><%= it.t.stat_total_events %></p>
            <p class="text-xl font-bold text-ink-700"><%= it.eventStats.total %></p>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4 flex items-center space-x-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-xs text-ink-400"><%= it.t.level_error %></p>
            <p class="text-xl font-bold text-red-600"><%= it.eventStats.errors %></p>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4 flex items-center space-x-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <p class="text-xs text-ink-400"><%= it.t.level_warn %></p>
            <p class="text-xl font-bold text-yellow-600"><%= it.eventStats.warns %></p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">

        <!-- Recent Events -->
        <div class="bg-white rounded-lg shadow-sm border border-warm-200">
          <div class="px-5 py-4 border-b border-warm-200 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-ink-600"><%= it.t.recent_events %></h2>
            <a href="/events" class="text-xs text-brand-500 hover:text-brand-700"><%= it.t.view_all %></a>
          </div>
          <div class="divide-y divide-warm-100">
            <% if (!it.recentEvents || it.recentEvents.length === 0) { %>
            <p class="px-5 py-8 text-center text-sm text-ink-300"><%= it.t.no_events %></p>
            <% } else { %>
            <% it.recentEvents.forEach(function(ev) { %>
            <div class="px-5 py-3 flex items-start space-x-3">
              <% if (ev.level === 'error') { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700 flex-shrink-0 mt-0.5"><%= it.t.level_error %></span>
              <% } else if (ev.level === 'warn') { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-700 flex-shrink-0 mt-0.5"><%= it.t.level_warn %></span>
              <% } else if (ev.level === 'info') { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 flex-shrink-0 mt-0.5"><%= it.t.level_info %></span>
              <% } else { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warm-100 text-ink-500 flex-shrink-0 mt-0.5"><%= it.t.level_debug %></span>
              <% } %>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-ink-700 truncate"><%= ev.summary %></p>
                <p class="text-xs text-ink-300 mt-0.5"><%= ev.source %> · <%= it.relativeTime(ev.created_at) %></p>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Recent Conversations -->
        <div class="bg-white rounded-lg shadow-sm border border-warm-200">
          <div class="px-5 py-4 border-b border-warm-200 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-ink-600"><%= it.t.recent_convs %></h2>
            <a href="/conversations" class="text-xs text-brand-500 hover:text-brand-700"><%= it.t.view_all %></a>
          </div>
          <div class="divide-y divide-warm-100">
            <% if (!it.stats.recentConvs || it.stats.recentConvs.length === 0) { %>
            <p class="px-5 py-8 text-center text-sm text-ink-300"><%= it.t.no_convs %></p>
            <% } else { %>
            <% it.stats.recentConvs.forEach(function(conv) { %>
            <a href="/conversations/<%= conv.id %>" class="block px-5 py-3 hover:bg-warm-100 transition-colors">
              <div class="flex items-center justify-between">
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-ink-700 truncate"><%= conv.remote_name || conv.remote_address %></p>
                  <p class="text-xs text-ink-300 mt-0.5 truncate font-mono"><%= conv.remote_address %></p>
                </div>
                <div class="ml-4 flex-shrink-0 text-right">
                  <% if (conv.status === 'active') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700"><%= it.t.status_active %></span>
                  <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-warm-100 text-ink-500"><%= conv.status %></span>
                  <% } %>
                  <p class="text-xs text-ink-300 mt-1"><%= it.relativeTime(conv.last_message_at) %></p>
                </div>
              </div>
            </a>
            <% }) %>
            <% } %>
          </div>
        </div>

      </div>
      </div>

<%~ include('partials/page-close', it) %>

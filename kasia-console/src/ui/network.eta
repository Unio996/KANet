<%~ include('partials/page-open', { _page: 'network', pageTitle: 'Kasia Network', headerRight: '<span class="text-sm text-ink-300" x-data x-text="\'Last refresh: \' + new Date().toLocaleTimeString()"></span>', ...it }) %>

    <div class="p-6" x-data="{
      profiles: [],
      handshakes: [],
      stats: null,
      loading: true,
      scanner: null,
      sortBy: 'total',
      sortAsc: false,
      expanded: null,
      async init() { await this.load(); },
      async load() {
        this.loading = true;
        try {
          const res = await fetch('/api/discovery/activity?limit=200');
          const data = await res.json();
          this.profiles = data.profiles;
          this.handshakes = data.handshakes;
          this.stats = data.stats;
        } catch (e) { console.error(e); }
        try {
          const sr = await fetch('/api/discovery/scanner/status');
          const scannerData = await sr.json();
          this.scanner = scannerData.scanner;
        } catch {}
        this.loading = false;
      },
      sorted() {
        const key = this.sortBy;
        const dir = this.sortAsc ? 1 : -1;
        return [...this.profiles].sort((a, b) => {
          const av = a[key] ?? 0, bv = b[key] ?? 0;
          return av < bv ? dir : av > bv ? -dir : 0;
        });
      },
      toggleSort(col) {
        if (this.sortBy === col) { this.sortAsc = !this.sortAsc; }
        else { this.sortBy = col; this.sortAsc = false; }
      },
      shortAddr(addr) {
        if (!addr) return '?';
        return '...' + addr.slice(-16);
      },
      fmtDate(d) {
        if (!d) return '-';
        try { return new Date(d).toLocaleString(undefined, {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); } catch { return d; }
      },
      hsFor(addr) {
        return this.handshakes.filter(h => h.from_addr === addr || h.to_addr === addr);
      },
      actBar(p) {
        const max = this.profiles[0]?.total || 1;
        return Math.max(2, Math.round(p.total / max * 100));
      },
      typeColor(t) {
        const m = {comm:'#6366f1',handshake:'#f59e0b',self_stash:'#10b981',legacy:'#6b7280',bcast:'#ec4899'};
        return m[t] || '#ccc';
      }
    }">

      <!-- Loading -->
      <div x-show="loading" class="flex items-center justify-center py-12">
        <svg class="animate-spin h-6 w-6 text-brand-500" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
        <span class="ml-2 text-sm text-ink-400">Loading network data...</span>
      </div>

      <template x-if="!loading && stats">
        <div>

          <!-- Scanner status bar (system-level) -->
          <div class="flex items-center justify-between bg-white rounded-lg border border-warm-200 px-4 py-3 mb-4">
            <div class="flex items-center space-x-3">
              <span class="relative flex h-2.5 w-2.5" x-show="scanner?.running">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
              </span>
              <span class="relative flex h-2.5 w-2.5" x-show="!scanner?.running">
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-ink-200"></span>
              </span>
              <span class="text-sm" :class="scanner?.running ? 'text-green-700' : 'text-ink-400'"
                x-text="scanner?.running ? '链上探针运行中' : '链上探针已停止'"></span>
            </div>
            <div class="flex items-center space-x-2">
              <button x-show="scanner?.running" @click="
                fetch('/api/discovery/scanner/stop', { method: 'POST' }).then(() => load())
              " class="px-3 py-1 text-xs font-medium text-red-600 bg-red-50 rounded-md hover:bg-red-100 transition-colors">
                停止
              </button>
              <button x-show="!scanner?.running" @click="
                fetch('/api/discovery/scanner/start', { method: 'POST' }).then(() => load())
              " class="px-3 py-1 text-xs font-medium text-green-600 bg-green-50 rounded-md hover:bg-green-100 transition-colors">
                启动
              </button>
            </div>
          </div>

          <!-- Stats cards -->
          <div class="grid grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-lg border border-warm-200 p-4">
              <div class="text-2xl font-bold text-indigo-600" x-text="stats.total_interactions.toLocaleString()"></div>
              <div class="text-xs text-ink-400 mt-1">Total Interactions</div>
            </div>
            <div class="bg-white rounded-lg border border-warm-200 p-4">
              <div class="text-2xl font-bold text-ink-700" x-text="stats.unique_senders"></div>
              <div class="text-xs text-ink-400 mt-1">Unique Addresses</div>
            </div>
            <div class="bg-white rounded-lg border border-warm-200 p-4">
              <div class="text-2xl font-bold text-amber-600" x-text="stats.total_handshakes"></div>
              <div class="text-xs text-ink-400 mt-1">Handshakes</div>
            </div>
            <div class="bg-white rounded-lg border border-warm-200 p-4">
              <div class="text-sm text-ink-500" x-text="fmtDate(stats.earliest) + ' — ' + fmtDate(stats.latest)"></div>
              <div class="text-xs text-ink-400 mt-1">Time Range</div>
            </div>
          </div>

          <!-- Handshake graph -->
          <div class="bg-white rounded-lg border border-warm-200 p-4 mb-6" x-show="handshakes.length > 0">
            <h2 class="text-sm font-semibold text-ink-600 mb-3">Handshake Connections</h2>
            <div class="space-y-1.5">
              <template x-for="h in handshakes" :key="h.tx_hash">
                <div class="flex items-center text-xs font-mono">
                  <span class="text-ink-300 w-32 flex-shrink-0" x-text="fmtDate(h.occurred_at)"></span>
                  <span class="text-indigo-700 font-medium" x-text="shortAddr(h.from_addr)" :title="h.from_addr"></span>
                  <span class="mx-2 text-amber-500">&#8594;</span>
                  <span class="text-indigo-700 font-medium" x-text="shortAddr(h.to_addr)" :title="h.to_addr"></span>
                </div>
              </template>
            </div>
          </div>

          <!-- Activity table -->
          <div class="bg-white rounded-lg border border-warm-200 overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-warm-100 border-b border-warm-200">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase w-8">#</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase">Address</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase cursor-pointer select-none" @click="toggleSort('total')">
                    Activity <span x-show="sortBy==='total'" x-text="sortAsc ? '&#9650;' : '&#9660;'"></span>
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase">Types</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase cursor-pointer select-none" @click="toggleSort('first_active')">
                    First Active <span x-show="sortBy==='first_active'" x-text="sortAsc ? '&#9650;' : '&#9660;'"></span>
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase cursor-pointer select-none" @click="toggleSort('last_active')">
                    Last Active <span x-show="sortBy==='last_active'" x-text="sortAsc ? '&#9650;' : '&#9660;'"></span>
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase">Duration</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase cursor-pointer select-none" @click="toggleSort('freq_per_hour')">
                    Freq <span x-show="sortBy==='freq_per_hour'" x-text="sortAsc ? '&#9650;' : '&#9660;'"></span>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-warm-100">
                <template x-for="(p, idx) in sorted()" :key="p.address">
                  <tr class="hover:bg-warm-100 transition-colors cursor-pointer" @click="expanded = expanded === p.address ? null : p.address">
                    <td class="px-4 py-2.5 text-xs text-ink-300" x-text="idx + 1"></td>
                    <td class="px-4 py-2.5">
                      <div class="flex flex-col">
                        <span class="font-medium text-ink-700 text-xs" x-show="p.display_name" x-text="p.display_name"></span>
                        <span class="font-mono text-xs text-ink-400" x-text="shortAddr(p.address)" :title="p.address"></span>
                        <template x-if="p.card_mode">
                          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-purple-100 text-purple-700 w-fit mt-0.5">
                            KANet <span x-text="p.card_entity_type || ''"></span>
                          </span>
                        </template>
                      </div>
                    </td>
                    <td class="px-4 py-2.5">
                      <div class="flex items-center space-x-2">
                        <span class="font-semibold text-ink-700 text-sm" x-text="p.total.toLocaleString()"></span>
                        <div class="w-20 h-1.5 bg-warm-100 rounded-full overflow-hidden">
                          <div class="h-full bg-indigo-400 rounded-full" :style="'width:' + actBar(p) + '%'"></div>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-2.5">
                      <div class="flex items-center space-x-1.5">
                        <template x-if="p.comm > 0">
                          <span title="加密通信消息 (self-send encrypted)" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-indigo-50 text-indigo-600 cursor-help" x-text="'通信' + p.comm"></span>
                        </template>
                        <template x-if="p.handshake > 0">
                          <span title="与对方建立加密会话" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-amber-50 text-amber-700 cursor-help" x-text="'握手' + p.handshake"></span>
                        </template>
                        <template x-if="p.self_stash > 0">
                          <span title="向自己存储加密数据" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-emerald-50 text-emerald-700 cursor-help" x-text="'存储' + p.self_stash"></span>
                        </template>
                        <template x-if="p.legacy > 0">
                          <span title="旧版 Kasia 协议消息" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-warm-100 text-ink-500 cursor-help" x-text="'旧版' + p.legacy"></span>
                        </template>
                        <template x-if="p.bcast > 0">
                          <span title="公开频道广播消息" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-pink-50 text-pink-600 cursor-help" x-text="'广播' + p.bcast"></span>
                        </template>
                      </div>
                    </td>
                    <td class="px-4 py-2.5 text-xs text-ink-400" x-text="fmtDate(p.first_active)"></td>
                    <td class="px-4 py-2.5 text-xs text-ink-400" x-text="fmtDate(p.last_active)"></td>
                    <td class="px-4 py-2.5 text-xs text-ink-400" x-text="p.hours_active ? p.hours_active + 'h' : '<1h'"></td>
                    <td class="px-4 py-2.5 text-xs font-medium" :class="p.freq_per_hour > 50 ? 'text-red-600' : p.freq_per_hour > 10 ? 'text-amber-600' : 'text-ink-500'" x-text="p.freq_per_hour ? p.freq_per_hour + '/h' : '-'"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <div class="mt-3 text-xs text-ink-300">
            Data sourced from on-chain Kasia protocol activity.
          </div>

        </div>
      </template>

    </div>

<%~ include('partials/page-close', it) %>

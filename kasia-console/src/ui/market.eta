<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= it.title %> — KANet</title>
<script src="https://cdn.tailwindcss.com"></script>
<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>
tailwind.config={theme:{extend:{colors:{base:{900:'#0a0e17',800:'#0f1520',700:'#161d2e',600:'#1e2740',500:'#283350'},cyan:{400:'#00f0ff',500:'#00d4e0'},buy:'#10b981',sell:'#ef4444',pending:'#f59e0b',dispute:'#f97316'},fontFamily:{mono:['JetBrains Mono','monospace'],sans:['Noto Sans SC','system-ui','sans-serif']}}}}
</script>
<style>
body{background:#0a0e17;color:#e2e8f0;font-family:'Noto Sans SC',sans-serif}
.font-data{font-family:'JetBrains Mono',monospace}
.glass{background:rgba(15,21,32,0.8);border:1px solid rgba(0,240,255,0.08);backdrop-filter:blur(12px)}
.glass:hover{border-color:rgba(0,240,255,0.18)}
.manifesto{background:linear-gradient(90deg,rgba(0,240,255,0.03) 0%,rgba(0,240,255,0.10) 50%,rgba(0,240,255,0.03) 100%);border-top:1px solid rgba(0,240,255,0.12);border-bottom:1px solid rgba(0,240,255,0.12)}
.sn{width:10px;height:10px;border-radius:50%;transition:all .3s;flex-shrink:0}
.sn.done{background:#10b981;box-shadow:0 0 6px rgba(16,185,129,0.4)}
.sn.active{background:#00f0ff;box-shadow:0 0 10px rgba(0,240,255,0.5);animation:pc 2s infinite}
.sn.wait{background:#1e2740}
.sl{height:2px;flex:1;transition:background .5s}
.sl.done{background:rgba(16,185,129,0.5)}.sl.cur{background:linear-gradient(90deg,#10b981,#00f0ff)}.sl.wait{background:#1e2740}
@keyframes pc{0%,100%{box-shadow:0 0 6px rgba(0,240,255,0.3)}50%{box-shadow:0 0 16px rgba(0,240,255,0.7)}}
.checkpoint{display:flex;align-items:center;gap:10px;padding:6px 0;margin:4px 0}
.checkpoint-line{flex:1;height:1px}
.checkpoint-line.done{background:linear-gradient(90deg,transparent,rgba(16,185,129,0.3),transparent)}
.checkpoint-line.active{background:linear-gradient(90deg,transparent,rgba(0,240,255,0.3),transparent)}
.checkpoint-line.wait{background:linear-gradient(90deg,transparent,rgba(30,39,64,0.8),transparent)}
.bubble{max-width:85%;padding:8px 12px;border-radius:12px;font-size:13px;line-height:1.5}
.bubble-peer{background:rgba(30,39,64,0.8);border:1px solid rgba(255,255,255,0.04);border-radius:12px 12px 12px 2px}
.bubble-self{background:rgba(0,240,255,0.06);border:1px solid rgba(0,240,255,0.1);border-radius:12px 12px 2px 12px}
.sys-card{background:rgba(15,21,32,0.6);border:1px solid rgba(255,255,255,0.05);border-radius:8px;padding:8px 12px}
.sys-card.success{border-left:3px solid #10b981}.sys-card.lock{border-left:3px solid #f59e0b}.sys-card.verify{border-left:3px solid #00f0ff}.sys-card.fail{border-left:3px solid #ef4444}
.approval-card{border:1px solid rgba(245,158,11,0.25);animation:ga 3s infinite}
@keyframes ga{0%,100%{box-shadow:0 0 10px rgba(245,158,11,0.06)}50%{box-shadow:0 0 24px rgba(245,158,11,0.15)}}
.order-card{transition:transform .12s,border-color .2s;cursor:pointer}.order-card:hover{transform:translateX(3px)}.order-card.sel{border-color:rgba(0,240,255,0.35)!important;background:rgba(0,240,255,0.04)!important}
.conf-bar{height:3px;border-radius:2px;background:#1e2740;overflow:hidden}.conf-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,#10b981,#00f0ff);transition:width 1s}
.wallet-bar{background:linear-gradient(180deg,rgba(15,21,32,0.95),rgba(10,14,23,1));border-top:1px solid rgba(0,240,255,0.08)}
::-webkit-scrollbar{width:3px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(0,240,255,0.12);border-radius:2px}
[x-cloak]{display:none!important}
</style>
</head>

<body class="min-h-screen flex flex-col" x-data="market()" x-init="init()" x-cloak>

<!-- NWT N6.3 Phase α 5/18: OTC deprecation banner. market.eta 整体是 OTC market UI, exchange 是 successor. -->
<div class="bg-amber-900/40 border-b border-amber-600/60 px-4 py-1.5 text-amber-200 text-xs flex items-center justify-between gap-2">
  <span><strong>⚠ OTC pool deprecated 5/18</strong> — mm_orders frozen, /api/trade/mm-orders/* returns 410. 请用 <a href="/exchange" class="underline text-amber-100 font-semibold">Exchange</a> 下单接单。本页 read-only。</span>
  <span class="text-amber-300/70 hidden sm:inline">参考: NWT #N6.3</span>
</div>

<!-- 顶栏 -->
<header class="flex items-center justify-between px-5 py-2.5 border-b border-base-700">
  <div class="flex items-center gap-4">
    <a href="/" class="text-base font-semibold tracking-tight">
      <span class="text-cyan-400 font-data font-bold">K</span><span class="text-slate-300">ANet</span>
      <span class="text-slate-500 font-normal text-sm ml-1.5">自由市场</span>
    </a>
    <div class="h-4 w-px bg-base-600"></div>
    <select x-model="agentId" @change="switchAgent()"
      class="bg-base-700 border border-base-600 text-sm rounded px-3 py-1 font-data text-cyan-400 focus:border-cyan-400/40 focus:outline-none">
      <% it.relays.forEach(function(r) { %>
      <option value="<%= r.id %>"><%= r.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex rounded overflow-hidden border border-base-600">
      <template x-for="m in [{id:'manual',l:'手动'},{id:'approval',l:'审批'},{id:'auto',l:'自动'}]" :key="m.id">
        <button @click="setMode(m.id)" :class="mode===m.id?'bg-cyan-400/10 text-cyan-400':'text-slate-500 hover:text-slate-300'"
          class="px-3 py-1 text-[11px] tracking-wide transition-all border-r border-base-600 last:border-0" x-text="m.l"></button>
      </template>
    </div>
    <a href="/trading" class="text-[10px] text-slate-600 hover:text-slate-400">旧版</a>
    <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-buy animate-pulse"></div><span class="text-[10px] text-slate-500 font-data">LIVE</span></div>
  </div>
</header>

<!-- 宣言 -->
<div class="manifesto py-1.5 px-5 flex items-center justify-center gap-3">
  <span class="text-[11px] font-data text-cyan-400/50 tracking-widest uppercase">Three-Layer Verifiable</span>
  <span class="text-slate-600">/</span>
  <span class="text-[12px] text-slate-400 tracking-wide">不是"请相信我们"，是<span class="text-cyan-400/70">三层可验证</span>。链上可查，规则透明，过程可审。</span>
</div>

<!-- 主体 -->
<main class="flex-1 flex overflow-hidden">

  <!-- 左栏：市场订单 -->
  <aside class="w-[300px] border-r border-base-700 flex flex-col flex-shrink-0">
    <div class="flex border-b border-base-700">
      <button @click="tab='market';loadOrders()" :class="tab==='market'?'text-cyan-400 border-b-2 border-cyan-400':'text-slate-500'" class="flex-1 py-2 text-xs tracking-wide">
        市场 <span class="font-data text-[10px]" x-text="ordersTotal||''"></span>
      </button>
      <button @click="tab='history';loadOrders()" :class="tab==='history'?'text-cyan-400 border-b-2 border-cyan-400':'text-slate-500'" class="flex-1 py-2 text-xs tracking-wide">历史</button>
    </div>
    <div class="flex-1 overflow-y-auto p-2.5 space-y-1.5">
      <template x-for="o in displayOrders" :key="o.id">
        <div @click="selectDeal(o)" :class="deal?.id===o.id?'sel':''" class="order-card glass rounded-lg px-3 py-2.5 border border-transparent">
          <div class="flex items-center justify-between mb-1">
            <div class="flex items-center gap-2">
              <span :class="o.side==='buy'?'bg-buy/15 text-buy':'bg-sell/15 text-sell'" class="text-[10px] font-data font-bold px-1.5 py-0.5 rounded" x-text="o.side==='buy'?'买':'卖'"></span>
              <span class="font-data text-[13px] font-semibold text-white" x-text="o.kas_amount+' KAS'"></span>
            </div>
            <span class="font-data text-xs" :class="o.side==='buy'?'text-buy':'text-sell'" x-text="'$'+o.price"></span>
          </div>
          <div class="flex items-center justify-between text-[10px] text-slate-500">
            <span x-text="(o.chain||'bnb').toUpperCase()+' 链'"></span>
            <div class="flex items-center gap-1"><div class="w-1 h-1 rounded-full" :class="stDot(o.status)"></div><span class="font-data" x-text="stL(o.status)"></span></div>
          </div>
          <div class="text-[10px] text-slate-600 mt-0.5" x-text="o._peerName || ('...'+(o.peer_address||o.agent_address||'').slice(-8))"></div>
        </div>
      </template>
      <div x-show="displayOrders.length===0 && !ordersLoading" class="py-16 text-center text-slate-600 text-[11px]">暂无订单</div>
      <div x-show="ordersLoading" class="py-8 text-center text-slate-600 text-[11px]">加载中...</div>
      <!-- 加载更多 -->
      <button x-show="ordersHasMore && !ordersLoading" @click="loadMore()"
        class="w-full py-2 text-[11px] text-cyan-400/50 hover:text-cyan-400 transition-colors">
        加载更多 (<span x-text="orders.length"></span>/<span x-text="ordersTotal"></span>)
      </button>
    </div>
    <div class="p-2.5 border-t border-base-700">
      <button @click="showPublish=true" class="w-full py-2 rounded-lg bg-cyan-400/8 text-cyan-400 border border-cyan-400/15 text-xs font-semibold hover:bg-cyan-400/15 transition-all">+ 发布订单</button>
    </div>
  </aside>

  <!-- 右栏：交易对话 -->
  <section class="flex-1 flex flex-col overflow-hidden">
    <!-- 空状态 -->
    <div x-show="!deal" class="flex-1 flex items-center justify-center">
      <div class="text-center"><div class="text-5xl text-base-600 mb-3 font-data opacity-30">&lbrace; &rbrace;</div><div class="text-sm text-slate-500">选择一个订单开始交易</div></div>
    </div>

    <div x-show="deal" class="flex-1 flex flex-col overflow-hidden">
      <!-- 交易头 + 管线 -->
      <div class="px-5 py-3 border-b border-base-700">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <span :class="deal?.side==='buy'?'text-buy':'text-sell'" class="font-data font-bold text-base" x-text="(deal?.side==='buy'?'买入 ':'卖出 ')+deal?.kas_amount+' KAS'"></span>
            <span class="text-slate-500">@</span>
            <span class="font-data text-base text-white" x-text="'$'+deal?.price"></span>
            <span class="px-1.5 py-0.5 rounded text-[9px] font-data bg-base-600 text-slate-400" x-text="(deal?.chain||'bnb').toUpperCase()"></span>
          </div>
          <span class="text-[10px] text-slate-600 font-data" x-text="deal?.id?.slice(0,8)"></span>
        </div>
        <div class="flex items-center gap-0.5">
          <template x-for="(s,i) in pipe" :key="s.id">
            <div class="flex items-center" :class="i>0?'flex-1':''">
              <div x-show="i>0" class="sl" :class="lnCls(i)"></div>
              <div class="relative cursor-pointer" @click="toggleStory(s.id)">
                <div class="sn" :class="ndCls(s.id)" :style="ndCls(s.id)!=='wait'?'cursor:pointer':''"></div>
                <span class="absolute top-3 left-1/2 -translate-x-1/2 text-[8px] font-data whitespace-nowrap"
                  :class="ndCls(s.id)==='active'?'text-cyan-400':ndCls(s.id)==='done'?'text-buy/50':'text-slate-600'" x-text="s.label"></span>
              </div>
            </div>
          </template>
        </div>
        <!-- 故事卡片：点击管线节点展开 -->
        <div x-show="storyNode" x-transition class="mt-4 glass rounded-lg p-3 border-l-2"
          :class="storyData?.ok ? 'border-buy' : storyData?.active ? 'border-cyan-400' : 'border-base-500'">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold" x-text="storyData?.title || ''"></span>
              <span x-show="storyData?.ok" class="text-[9px] font-data text-buy">DONE</span>
              <span x-show="storyData?.active" class="text-[9px] font-data text-cyan-400 animate-pulse">IN PROGRESS</span>
            </div>
            <button @click="storyNode=null" class="text-slate-500 hover:text-slate-300 text-[10px]">关闭</button>
          </div>
          <!-- 故事内容 -->
          <div class="text-[12px] text-slate-300 leading-relaxed" x-show="storyData?.summary" x-text="storyData?.summary"></div>
          <!-- TX 印记（可点击跳转浏览器）-->
          <div x-show="storyData?.tx" class="mt-2 flex items-center gap-2">
            <span class="text-[9px] text-slate-500">TX:</span>
            <a :href="KANet.explorerTxUrl(storyData?.tx?.startsWith('0x') ? (deal?.chain || 'bnb') : 'kaspa', storyData.tx)"
              target="_blank" class="font-data text-[10px] text-cyan-400/60 hover:text-cyan-400 underline decoration-cyan-400/15 hover:decoration-cyan-400/40 transition-all" x-text="storyData?.tx"></a>
          </div>
          <!-- 时间 -->
          <div x-show="storyData?.time" class="mt-1 text-[9px] font-data text-slate-600" x-text="storyData?.time"></div>
          <!-- Agent 推理 -->
          <div x-show="storyData?.reasoning" class="mt-2 px-2 py-1.5 rounded bg-base-800/60 border-l-2 border-cyan-400/20">
            <div class="text-[8px] font-data text-cyan-400/40 uppercase tracking-widest mb-0.5">Agent 推理</div>
            <div class="text-[11px] text-slate-400 italic" x-text="storyData?.reasoning"></div>
          </div>
          <!-- 链上证据 -->
          <div x-show="storyData?.proof" class="mt-2 text-[10px] font-data text-slate-500 space-y-0.5">
            <template x-for="(v,k) in storyData?.proof||{}" :key="k">
              <div><span class="text-slate-600" x-text="k+': '"></span><span :class="k==='TX'||k==='链上TX'?'text-cyan-400/50':''" x-text="v"></span></div>
            </template>
          </div>
          <!-- 未来节点 -->
          <div x-show="storyData?.future" class="text-[11px] text-slate-500 italic" x-text="storyData?.future"></div>
        </div>
      </div>

      <!-- 对话流 -->
      <div class="flex-1 overflow-y-auto px-5 py-3 space-y-1" x-ref="chatScroll">
        <template x-for="(item, idx) in flow" :key="idx">
          <div>
            <!-- 检查点 -->
            <template x-if="item.t==='cp'">
              <div class="checkpoint">
                <div class="checkpoint-line" :class="item.done?'done':item.now?'active':'wait'"></div>
                <div class="flex items-center gap-2">
                  <div class="sn" style="width:6px;height:6px" :class="item.done?'done':item.now?'active':'wait'"></div>
                  <span class="text-[10px] font-data uppercase tracking-widest" :class="item.now?'text-cyan-400':item.done?'text-buy/60':'text-slate-600'" x-text="item.label"></span>
                  <span class="text-[9px] font-data text-slate-600" x-text="item.time||''"></span>
                </div>
                <div class="checkpoint-line" :class="item.done?'done':item.now?'active':'wait'"></div>
              </div>
            </template>
            <!-- 对手方消息 -->
            <template x-if="item.t==='peer'">
              <div class="flex gap-2 mb-2">
                <div class="w-6 h-6 rounded-full bg-base-600 flex items-center justify-center flex-shrink-0 mt-1"><span class="text-[9px] font-data text-slate-400" x-text="item.av"></span></div>
                <div><div class="text-[10px] text-slate-500 mb-0.5" x-text="item.who+' '+item.time"></div><div class="bubble bubble-peer text-slate-300" x-text="item.msg"></div></div>
              </div>
            </template>
            <!-- 我方 Agent -->
            <template x-if="item.t==='agent'">
              <div class="flex gap-2 mb-2 justify-end">
                <div class="text-right"><div class="text-[10px] text-slate-500 mb-0.5" x-text="item.who+' '+item.time"></div><div class="bubble bubble-self text-slate-200" x-text="item.msg"></div>
                  <div x-show="item.why" class="mt-1 text-[10px] text-cyan-400/40 italic text-right" x-text="item.why"></div></div>
                <div class="w-6 h-6 rounded-full bg-cyan-400/10 flex items-center justify-center flex-shrink-0 mt-1"><span class="text-[9px] font-data text-cyan-400" x-text="item.av"></span></div>
              </div>
            </template>
            <!-- Owner -->
            <template x-if="item.t==='owner'">
              <div class="flex gap-2 mb-2 justify-end"><div class="text-right"><div class="text-[10px] text-slate-500 mb-0.5">你 <span x-text="item.time"></span></div>
                <div class="bubble bubble-self text-white" style="background:rgba(0,240,255,0.1);border-color:rgba(0,240,255,0.2)" x-text="item.msg"></div></div></div>
            </template>
            <!-- 系统卡片 -->
            <template x-if="item.t==='sys'">
              <div class="my-2 mx-4"><div class="sys-card" :class="item.style||''">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-[12px]" x-text="item.icon"></span>
                    <!-- TX 链接可点击跳转浏览器 -->
                    <template x-if="item.txUrl && item.txUrl !== '#'">
                      <a :href="item.txUrl" target="_blank" class="font-data text-[12px] text-cyan-400/70 hover:text-cyan-400 underline decoration-cyan-400/20 hover:decoration-cyan-400/50 transition-all" x-text="item.msg"></a>
                    </template>
                    <template x-if="!item.txUrl || item.txUrl === '#'">
                      <span class="text-[12px]" x-text="item.msg"></span>
                    </template>
                  </div>
                  <span class="text-[9px] font-data text-slate-600" x-text="item.time"></span>
                </div>
                <button x-show="item.proof" @click="item._o=!item._o" class="text-[9px] font-data text-cyan-400/30 hover:text-cyan-400/60 mt-1 transition-colors" x-text="item._o?'收起 \u25b4':'查看详情 \u25be'"></button>
                <div x-show="item._o" x-transition class="mt-1 pt-1 border-t border-base-700 text-[10px] font-data text-slate-500 space-y-0.5">
                  <template x-for="(v,k) in item.proof" :key="k">
                    <div>
                      <span class="text-slate-600" x-text="k+': '"></span>
                      <template x-if="k==='链上TX' && v && v.length > 10">
                        <a :href="KANet.explorerTxUrl(v.startsWith('0x') ? (deal?.chain || 'bnb') : 'kaspa', v)" target="_blank"
                          class="text-cyan-400/50 hover:text-cyan-400 underline decoration-cyan-400/15 hover:decoration-cyan-400/40 transition-all" x-text="v"></a>
                      </template>
                      <template x-if="k!=='链上TX' || !v || v.length <= 10">
                        <span x-text="v"></span>
                      </template>
                    </div>
                  </template>
                </div>
              </div></div>
            </template>
            <!-- 审批 -->
            <template x-if="item.t==='approval'">
              <div class="my-3 mx-2"><div class="approval-card glass rounded-xl p-4">
                <div class="flex items-center justify-between mb-2"><div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-pending animate-pulse"></div><span class="text-[11px] text-pending">等待你的确认</span></div>
                  <span class="font-data text-sm text-pending" x-text="item.countdown||''"></span></div>
                <p class="text-[13px] text-slate-200 leading-relaxed" x-text="item.summary"></p>
                <div x-show="item.reasoning" class="mt-2 px-3 py-1.5 rounded bg-base-800/60 border-l-2 border-cyan-400/20"><div class="text-[9px] font-data text-cyan-400/40 uppercase tracking-widest mb-0.5">Agent 推理</div>
                  <p class="text-[11px] text-slate-400" x-text="item.reasoning"></p></div>
                <div class="flex gap-2.5 mt-3">
                  <button @click="approveExec(item.execId)" class="flex-1 py-2 rounded-lg bg-buy/10 text-buy border border-buy/20 text-sm font-semibold hover:bg-buy/20 transition-all">确认执行</button>
                  <button @click="rejectExec(item.execId)" class="flex-1 py-2 rounded-lg bg-sell/8 text-sell border border-sell/15 text-sm font-semibold hover:bg-sell/15 transition-all">拒绝</button>
                </div>
              </div></div>
            </template>
          </div>
        </template>

        <!-- 操作按钮 -->
        <div x-show="deal && !hasPendingApproval" class="flex gap-2 pt-2 pb-1">
          <button x-show="deal?.status==='published' && deal?.relay_node_id !== agentId" @click="doAction('accept')"
            class="flex-1 py-2.5 rounded-lg bg-cyan-400/8 text-cyan-400 border border-cyan-400/15 text-sm font-semibold hover:bg-cyan-400/15 transition-all"
            x-text="'接受订单（以 ' + agentName + ' 身份）'"></button>
          <span x-show="deal?.status==='published' && deal?.relay_node_id === agentId" class="flex-1 py-2.5 text-center text-slate-500 text-sm">等待对手方接单...</span>
          <button x-show="deal?.status==='accepted' && deal?.relay_node_id === agentId && deal?.side==='buy'" @click="doAction('pay_usdt')"
            class="flex-1 py-2.5 rounded-lg bg-buy/10 text-buy border border-buy/20 text-sm font-semibold hover:bg-buy/20 transition-all">支付 USDT</button>
          <button x-show="deal?.status==='paid' && deal?.relay_node_id === agentId" @click="doAction('verify_payment')"
            class="flex-1 py-2.5 rounded-lg bg-cyan-400/8 text-cyan-400 border border-cyan-400/15 text-sm font-semibold hover:bg-cyan-400/15 transition-all">验证到账</button>
          <button x-show="deal?.status==='verified' && deal?.relay_node_id === agentId && deal?.side==='sell'" @click="doAction('send_kas')"
            class="flex-1 py-2.5 rounded-lg bg-buy/10 text-buy border border-buy/20 text-sm font-semibold hover:bg-buy/20 transition-all">发送 KAS</button>
          <button x-show="deal && deal?.relay_node_id === agentId && !TERM.includes(deal?.status)" @click="doAction('cancel')"
            class="py-2.5 px-4 rounded-lg text-slate-500 text-sm hover:bg-sell/10 hover:text-sell transition-all">取消</button>
          <span x-show="deal && deal?.relay_node_id !== agentId && !TERM.includes(deal?.status) && deal?.status !== 'published'"
            class="flex-1 py-2.5 text-center text-slate-500 text-[11px]">等待对方操作...</span>
          <span x-show="deal && TERM.includes(deal?.status)"
            class="flex-1 py-2.5 text-center text-slate-500 text-[11px]" x-text="deal?.status === 'completed' ? '交易已完成 ✓' : '订单已关闭'"></span>
        </div>
      </div>

      <!-- 输入栏 -->
      <div class="px-5 py-2.5 border-t border-base-700 flex gap-2">
        <input x-model="chatInput" @keydown.enter="sendChat()" :placeholder="deal?.peer_address ? '给对手方留言（交易专属频道）...' : '发布到市场频道...'" class="flex-1 bg-base-700 border border-base-600 rounded-lg px-3 py-2 text-sm focus:border-cyan-400/30 focus:outline-none placeholder-slate-600">
        <button @click="sendChat()" class="px-4 py-2 rounded-lg bg-cyan-400/10 text-cyan-400 text-sm font-semibold hover:bg-cyan-400/20 transition-all border border-cyan-400/15">发送</button>
      </div>
    </div>
  </section>
</main>

<!-- 钱包栏（可点击展开管理） -->
<footer class="wallet-bar relative">
  <!-- 钱包管理弹出面板 -->
  <div x-show="walletPanel" x-transition class="absolute bottom-full left-0 right-0 glass border-t border-cyan-400/10 p-4 max-h-80 overflow-y-auto">
    <div class="flex items-center justify-between mb-3">
      <h4 class="text-sm font-semibold"><span x-text="walletPanel==='kas'?'Kaspa 钱包':(walletPanel?.toUpperCase()+' 链钱包')"></span></h4>
      <button @click="walletPanel=null" class="text-slate-500 hover:text-slate-300 text-xs">关闭</button>
    </div>

    <!-- KAS 钱包 -->
    <template x-if="walletPanel==='kas'">
      <div class="space-y-2 text-[12px]">
        <div class="flex items-center justify-between"><span class="text-slate-500">地址</span>
          <span class="font-data text-cyan-400/70 text-[10px] cursor-pointer" @click="copyAddr(agentAddr)" x-text="agentAddr" title="点击复制"></span></div>
        <div class="flex items-center justify-between"><span class="text-slate-500">余额</span><span class="font-data" x-text="(wallet.kas||0).toFixed(2)+' KAS'"></span></div>
        <div x-show="wallet.kasLocked>0" class="flex items-center justify-between"><span class="text-slate-500">锁定</span><span class="font-data text-pending" x-text="(wallet.kasLocked||0).toFixed(2)+' KAS'"></span></div>
        <div class="flex items-center justify-between"><span class="text-slate-500">可用</span><span class="font-data text-buy" x-text="((wallet.kas||0)-(wallet.kasLocked||0)).toFixed(2)+' KAS'"></span></div>
        <!-- KAS 提现 -->
        <div x-data="{showSend:false,sendAddr:'',sendAmt:''}" class="mt-2">
          <button @click="showSend=!showSend" class="text-[11px] text-cyan-400/50 hover:text-cyan-400">提现 KAS</button>
          <div x-show="showSend" class="mt-2 space-y-2">
            <input x-model="sendAddr" placeholder="目标 kaspa:q... 地址" class="w-full bg-base-700 border border-base-600 rounded px-2 py-1.5 text-[11px] font-data focus:border-cyan-400/30 focus:outline-none">
            <input x-model.number="sendAmt" placeholder="金额 (KAS)" type="number" class="w-full bg-base-700 border border-base-600 rounded px-2 py-1.5 text-[11px] font-data focus:border-cyan-400/30 focus:outline-none">
            <button @click="$dispatch('send-kas',{addr:sendAddr,amt:sendAmt})" class="w-full py-1.5 rounded bg-sell/10 text-sell border border-sell/15 text-[11px] font-semibold hover:bg-sell/20">发送</button>
          </div>
        </div>
      </div>
    </template>

    <!-- EVM/SOL/TRON 链钱包（显示所有钱包） -->
    <template x-if="walletPanel && walletPanel!=='kas'">
      <div class="space-y-3">
        <template x-for="w in panelWallets" :key="w.id||w.address">
          <div class="p-3 rounded-lg border border-base-600 bg-base-800/40">
            <div class="flex items-center justify-between mb-2">
              <span class="font-data text-[10px] cursor-pointer text-cyan-400/70" @click="copyAddr(w.address)" x-text="w.address" title="点击复制"></span>
              <span x-show="w.isDefault" class="text-[9px] bg-cyan-400/10 text-cyan-400 px-1.5 py-0.5 rounded">默认</span>
            </div>
            <div class="grid grid-cols-4 gap-2 text-[11px]">
              <div><span class="text-slate-500">USDT</span><div class="font-data" x-text="(w.usdt||0).toFixed(2)"></div></div>
              <div><span class="text-slate-500">USDC</span><div class="font-data" x-text="(w.usdc||0).toFixed(2)"></div></div>
              <div><span class="text-slate-500">Gas (<span x-text="w.chain==='polygon'?'MATIC':w.chain.toUpperCase()"></span>)</span><div class="font-data" x-text="(w.gas||0).toFixed(4)"></div></div>
              <div x-show="w.locked>0"><span class="text-slate-500">锁定</span><div class="font-data text-pending" x-text="(w.locked||0).toFixed(2)+' USDT'"></div></div>
            </div>
            <!-- 操作按钮 -->
            <div class="flex gap-2 mt-2">
              <button @click="copyAddr(w.address)" class="px-2 py-1 rounded text-[10px] bg-base-600 text-slate-400 hover:text-slate-200">复制</button>
              <button @click="withdrawPrompt(w)" class="px-2 py-1 rounded text-[10px] bg-base-600 text-slate-400 hover:text-sell">提现</button>
              <button @click="showPrivkeyFor(w)" class="px-2 py-1 rounded text-[10px] bg-base-600 text-slate-400 hover:text-pending">私钥</button>
            </div>
          </div>
        </template>
        <!-- 创建新钱包 -->
        <button @click="createWallet(walletPanel)" class="w-full py-2 rounded-lg border border-dashed border-base-500 text-[11px] text-slate-500 hover:text-cyan-400 hover:border-cyan-400/20 transition-all">
          + 创建新 <span x-text="walletPanel?.toUpperCase()"></span> 钱包
        </button>
      </div>
    </template>
  </div>
  <!-- 钱包栏本体 -->
  <div class="px-5 py-2 flex items-center justify-between">
    <div class="flex items-center gap-5">
      <button @click="openWalletPanel('kas')" class="flex items-center gap-1.5 hover:text-cyan-400 transition-colors">
        <span class="text-[10px] text-slate-500">KAS</span><span class="font-data text-sm text-white" x-text="(wallet.kas||0).toFixed(1)"></span>
        <span x-show="wallet.kasLocked>0" class="font-data text-[10px] text-pending" x-text="'('+(wallet.kasLocked||0).toFixed(1)+' 锁定)'"></span>
      </button>
      <div class="h-3 w-px bg-base-700"></div>
      <template x-for="c in chainSummary" :key="c.chain">
        <button @click="openWalletPanel(c.chain)" class="flex items-center gap-1 hover:text-cyan-400 transition-colors">
          <span class="text-[9px] font-data text-slate-600" x-text="c.name"></span>
          <span class="font-data text-[11px] text-slate-300" x-text="((c.usdt||0)>0?(c.usdt||0).toFixed(2)+' USDT':'') + ((c.usdc||0)>0?((c.usdt||0)>0?' / ':'')+(c.usdc||0).toFixed(2)+' USDC':'') + ((c.usdt||0)===0&&(c.usdc||0)===0?'0 USDT':'')"></span>
          <span x-show="c.count>1" class="text-[8px] text-slate-600" x-text="'('+c.count+'个钱包)'"></span>
          <span x-show="c.locked>0" class="font-data text-[9px] text-pending" x-text="'('+(c.locked||0).toFixed(2)+' 锁定)'"></span>
        </button>
      </template>
    </div>
    <div class="text-[10px] font-data text-slate-600"><span x-text="agentName"></span> · <span x-text="modeL"></span></div>
  </div>
</footer>

<!-- 发布订单弹窗 -->
<div x-show="showPublish" x-transition class="fixed inset-0 z-50 flex items-center justify-center bg-black/60" @click.self="showPublish=false">
  <div class="glass rounded-xl p-6 w-96">
    <h3 class="text-base font-semibold mb-4">发布订单</h3>
    <div class="space-y-3">
      <div class="flex gap-2">
        <button @click="pubForm.side='sell'" :class="pubForm.side==='sell'?'bg-sell/15 text-sell border-sell/30':'text-slate-500 border-base-600'" class="flex-1 py-2 rounded-lg border text-sm font-semibold transition-all">卖出 KAS</button>
        <button @click="pubForm.side='buy'" :class="pubForm.side==='buy'?'bg-buy/15 text-buy border-buy/30':'text-slate-500 border-base-600'" class="flex-1 py-2 rounded-lg border text-sm font-semibold transition-all">买入 KAS</button>
      </div>
      <div><label class="text-[11px] text-slate-500">数量 (KAS)</label><input x-model.number="pubForm.amount" type="number" class="w-full mt-1 bg-base-700 border border-base-600 rounded px-3 py-2 text-sm font-data focus:border-cyan-400/30 focus:outline-none"></div>
      <div><label class="text-[11px] text-slate-500">价格 (USD) <span x-show="kasPrice" class="text-cyan-400/50" x-text="'— 当前市场 $'+kasPrice"></span></label><input x-model.number="pubForm.price" type="number" step="0.0001" class="w-full mt-1 bg-base-700 border border-base-600 rounded px-3 py-2 text-sm font-data focus:border-cyan-400/30 focus:outline-none"></div>
      <div><label class="text-[11px] text-slate-500">结算链</label>
        <select x-model="pubForm.chain" class="w-full mt-1 bg-base-700 border border-base-600 rounded px-3 py-2 text-sm font-data focus:border-cyan-400/30 focus:outline-none">
          <option value="bnb">BNB Chain</option><option value="eth">Ethereum</option><option value="sol">Solana</option><option value="tron">TRON</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2 mt-4">
      <button @click="publishOrder()" class="flex-1 py-2.5 rounded-lg bg-cyan-400/10 text-cyan-400 border border-cyan-400/15 text-sm font-semibold hover:bg-cyan-400/20 transition-all">发布到市场</button>
      <button @click="showPublish=false" class="px-4 py-2.5 rounded-lg text-slate-500 text-sm hover:text-slate-300 transition-all">取消</button>
    </div>
  </div>
</div>

<script>
function market() {
  const agents = [<% it.relays.forEach(function(r,i) { %>{id:'<%=r.id%>',name:'<%=r.name%>',addr:'<%=r.address%>'}<%if(i<it.relays.length-1){%>,<%}%><%})%>];
  const TERM = ['completed','cancelled','expired','resolved','escalated'];
  const ST = {published:'待接',accepted:'已接',paying:'付款中',paid:'已付',verified:'已验证',delivering:'交割中',completed:'已完成',cancelled:'已取消',expired:'已过期',disputed:'争议中',escalated:'已升级',resolved:'已解决'};
  // 管线 5 步（用户反馈：付款+已付=付款，交割+完成=交割完成）
  const PIPE = [{id:'accepted',label:'接受'},{id:'paid',label:'付款'},{id:'verified',label:'验证'},{id:'completed',label:'交割完成'}];
  // 状态 → 管线节点映射（多个状态对应同一节点）
  const STATUS_TO_NODE = { published:'_pre', accepted:'accepted', paying:'paid', paid:'paid', verified:'verified', delivering:'completed', completed:'completed', disputed:'completed', escalated:'completed' };

  return {
    agents, TERM, pipe: PIPE,
    agentId: agents[0]?.id || '',
    mode: '<%= it.mode %>',
    tab: 'market',
    deal: null,
    orders: [],
    flow: [],       // 对话流
    chatInput: '',
    showPublish: false,
    pubForm: { side: 'sell', amount: 100, price: 0, chain: 'bnb' },
    kasPrice: 0,
    wallet: { kas: 0, kasLocked: 0, chains: [] },
    _pollTimer: null,

    get agentName() { return this.agents.find(a => a.id === this.agentId)?.name || ''; },
    get agentAddr() { return this.agents.find(a => a.id === this.agentId)?.addr || ''; },
    get modeL() { return { manual:'手动', approval:'审批', auto:'自动' }[this.mode] || this.mode; },
    get activeOrders() { return this.orders.filter(o => !TERM.includes(o.status)); },
    get displayOrders() { return this.orders; }, // API 已按 tab 的 status 参数过滤
    get hasPendingApproval() { return this.flow.some(f => f.t === 'approval'); },

    stL(s) { return ST[s] || s; },
    stDot(s) { return { completed:'bg-buy', published:'bg-cyan-400', accepted:'bg-pending', paying:'bg-pending', paid:'bg-pending', verified:'bg-cyan-400', delivering:'bg-pending', cancelled:'bg-sell', disputed:'bg-sell', escalated:'bg-sell' }[s] || 'bg-slate-600'; },
    ndCls(id) {
      if (!this.deal) return 'wait';
      const pipeIds = PIPE.map(p=>p.id);
      const curNode = STATUS_TO_NODE[this.deal.status] || '_pre';
      const curIdx = pipeIds.indexOf(curNode);
      const nodeIdx = pipeIds.indexOf(id);
      if (curIdx < 0) return nodeIdx >= 0 ? 'wait' : 'wait'; // published = 全灰
      if (nodeIdx < curIdx) return 'done';
      if (nodeIdx === curIdx) return 'active';
      return 'wait';
    },
    lnCls(i) {
      if (!this.deal) return 'wait';
      const pipeIds = PIPE.map(p=>p.id);
      const curNode = STATUS_TO_NODE[this.deal.status] || '_pre';
      const curIdx = pipeIds.indexOf(curNode);
      if (curIdx < 0) return 'wait';
      return i<=curIdx?'done':i===curIdx+1?'cur':'wait';
    },

    async init() {
      // 订单先加载（快），钱包后台加载（可能慢）
      this.loadOrders();
      this.loadWallet(); // 不 await，不阻塞页面渲染
      // 读当前模式 + 市场价
      try { const r = await fetch('/api/trade/agent-mode').then(r=>r.json()); if (r?.mode) this.mode = r.mode; } catch {}
      try { const r = await fetch('/api/trade/kas-price').then(r=>r.json()); if (r?.price) { this.kasPrice = r.price; this.pubForm.price = r.price; } } catch {}
      // 轮询刷新
      this._pollTimer = setInterval(() => {
        this.loadOrders();
        if (this.deal) this.loadDealFlow(this.deal.id);
        this.loadWallet();
      }, 15000); // 15s（钱包查链上余额慢，不要太频繁）
    },

    // 分页状态
    ordersTotal: 0,
    ordersOffset: 0,
    ordersLimit: 20,
    ordersHasMore: false,
    ordersLoading: false,

    // 钱包管理
    walletPanel: null,  // 点击哪个链展开：'kas' | 'bnb' | 'eth' | 'sol' | 'tron' | null
    walletDetail: null, // { address, privkey, mnemonic, ... }

    async loadOrders(append = false) {
      if (this.ordersLoading) return;
      this.ordersLoading = true;
      try {
        const offset = append ? this.ordersOffset + this.ordersLimit : 0;
        const statusParam = this.tab === 'market' ? '&status=active' : '';
        const url = '/api/trade/mm-orders?page=1&limit=' + this.ordersLimit + '&offset=' + offset + statusParam;
        const data = await fetch(url).then(r => r.json());
        const rows = data.orders || data || [];
        for (const o of rows) {
          if (!o._peerName && o.peer_address) {
            o._peerName = o.peer_address.slice(-8);
          }
        }
        if (append) {
          this.orders = [...this.orders, ...rows];
        } else {
          this.orders = rows;
        }
        this.ordersTotal = data.total || rows.length;
        this.ordersOffset = offset;
        this.ordersHasMore = data.hasMore || false;
        // 如果当前 deal 有更新
        if (this.deal) {
          const fresh = this.orders.find(o => o.id === this.deal.id);
          if (fresh && fresh.status !== this.deal.status) {
            this.deal = fresh;
            this.loadDealFlow(fresh.id);
          }
        }
      } catch {} finally { this.ordersLoading = false; }
    },

    loadMore() { if (this.ordersHasMore && !this.ordersLoading) this.loadOrders(true); },

    async loadWallet() {
      try {
        const data = await fetch('/api/relay/' + this.agentId + '/wallets').then(r => r.json());
        // 保留所有钱包（同链可以有多个）
        const allWallets = (data.chains || []).map(w => ({
          id: w.id, chain: w.chain, name: w.chain === 'polygon' ? 'POLYGON' : w.chain.toUpperCase(),
          address: w.address, label: w.label || (w.isDefault ? '默认' : ''),
          isDefault: w.isDefault,
          usdt: w.usdtBalance || 0, usdc: w.usdcBalance || 0, gas: w.nativeBalance || 0, locked: 0,
        }));

        // 查锁定
        try {
          const locks = await fetch('/api/trade/fund-locks?relay_node_id=' + encodeURIComponent(this.agentId)).then(r => r.json());
          const lockedMap = {};
          for (const l of (locks || [])) {
            if (l.status !== 'locked') continue;
            lockedMap[l.asset] = (lockedMap[l.asset] || 0) + l.amount;
          }
          for (const w of allWallets) { w.locked = lockedMap['usdt_' + w.chain] || 0; }
          this.wallet = { kas: data.kaspa?.balance || 0, kasLocked: lockedMap['kas'] || 0, chains: allWallets };
        } catch {
          this.wallet = { kas: data.kaspa?.balance || 0, kasLocked: 0, chains: allWallets };
        }
      } catch {}
    },

    async selectDeal(order) {
      this.deal = order;
      await this.loadDealFlow(order.id);
    },

    async loadDealFlow(orderId) {
      // 从 execution_states 构建对话流
      try {
        const [execs, order] = await Promise.all([
          fetch('/api/trade/order-executions?orderId=' + orderId).then(r => r.json()),
          fetch('/api/trade/mm-orders/' + orderId).then(r => r.json()).catch(() => this.deal),
        ]);
        if (order && order.id) this.deal = order;

        const flow = [];
        const storyCache = {};  // nodeId → story data
        const pipeIds = PIPE.map(p => p.id);
        const curNode = STATUS_TO_NODE[this.deal.status] || '_pre';
        const curIdx = pipeIds.indexOf(curNode);
        const peerName = this.deal._peerName || this.deal.peer_address?.slice(-8) || '对手方';
        const myName = this.agentName;

        // 发布故事
        storyCache['published'] = {
          title: '发布', ok: true, time: this.deal.created_at?.slice(0, 19).replace('T', ' '),
          summary: `${peerName} 发布了${this.deal.side === 'buy' ? '买入' : '卖出'} ${this.deal.kas_amount} KAS @ $${this.deal.price} 的订单，通过 Kasia 协议广播到 ${(this.deal.chain||'bnb').toUpperCase()} 链市场。`,
        };

        // 发布检查点
        flow.push({ t: 'cp', label: '发布', done: curIdx >= 0, time: this.deal.created_at?.slice(11, 16) });
        flow.push({ t: 'peer', who: peerName, av: peerName[0], time: this.deal.created_at?.slice(11, 16),
          msg: `发布${this.deal.side === 'buy' ? '买入' : '卖出'}订单: ${this.deal.kas_amount} KAS @ $${this.deal.price} (${(this.deal.chain || 'bnb').toUpperCase()} 链)` });

        // 从 execution_states 生成后续检查点和事件
        let lastCheckpoint = 'published';
        for (const ex of (execs || []).sort((a, b) => a.created_at > b.created_at ? 1 : -1)) {
          const time = ex.created_at?.slice(11, 16);
          const typeLabel = { accept_order: '接受', pay_usdt: '付款', verify_payment: '验证', send_kas: '交割', cancel_order: '取消' }[ex.type] || ex.type;

          // 插入对应的检查点
          const checkpointMap = { accept_order: 'accepted', pay_usdt: 'paying', verify_payment: 'verified', send_kas: 'delivering' };
          const cpId = checkpointMap[ex.type];
          if (cpId && cpId !== lastCheckpoint) {
            const cpIdx = pipeIds.indexOf(cpId);
            flow.push({ t: 'cp', label: PIPE[cpIdx]?.label || cpId, done: cpIdx < curIdx, now: cpIdx === curIdx, time });
            lastCheckpoint = cpId;
          }

          // 构建故事缓存
          const storyNodeMap = { accept_order: 'accepted', pay_usdt: 'paid', verify_payment: 'verified', send_kas: 'completed' };
          const storyNodeId = storyNodeMap[ex.type];
          if (storyNodeId && ex.status === 'completed') {
            const details = ex.action_details ? JSON.parse(ex.action_details || '{}') : {};
            storyCache[storyNodeId] = {
              title: typeLabel, ok: true,
              time: ex.created_at?.slice(0, 19).replace('T', ' '),
              summary: ex.display_summary || (typeLabel + '完成'),
              tx: ex.output_txid || null,
              reasoning: details.reasoning || null,
              proof: ex.output_txid ? { '链上TX': ex.output_txid, '来源': ex.source, '执行规则': ex.type } : null,
            };
          } else if (storyNodeId && ex.status === 'executing') {
            storyCache[storyNodeId] = { title: typeLabel, active: true, time: ex.created_at?.slice(11, 19), summary: ex.display_summary || (typeLabel + '执行中...') };
          } else if (storyNodeId && ex.status === 'failed') {
            storyCache[storyNodeId] = { title: typeLabel, summary: '失败: ' + (ex.error_text || ''), time: ex.created_at?.slice(11, 19) };
          }

          // 根据 execution 状态生成对话项
          if (ex.status === 'pending') {
            // 审批卡片
            flow.push({ t: 'approval', summary: ex.display_summary, reasoning: ex.action_details ? (JSON.parse(ex.action_details || '{}').reasoning || '') : '',
              execId: ex.id, countdown: '' });
          } else if (ex.status === 'completed') {
            flow.push({ t: 'agent', who: myName + '·Agent', av: myName[0], time, msg: ex.display_summary || typeLabel, why: '' });
            if (ex.output_txid) {
              const txShort = ex.output_txid.slice(0, 16) + '...' + ex.output_txid.slice(-6);
              const isKasTx = !ex.output_txid.startsWith('0x');
              const explorerUrl = KANet.explorerTxUrl(isKasTx ? 'kaspa' : (this.deal?.chain || 'bnb'), ex.output_txid);
              flow.push({ t: 'sys', icon: '🔗', msg: txShort, time, style: 'success', txUrl: explorerUrl, txFull: ex.output_txid,
                proof: { '链上TX': ex.output_txid, '执行规则': ex.type, '来源': ex.source, '时间': time }, _o: false });
            }
          } else if (ex.status === 'executing') {
            flow.push({ t: 'agent', who: myName + '·Agent', av: myName[0], time, msg: ex.display_summary || (typeLabel + '执行中...'), why: '' });
          } else if (ex.status === 'failed') {
            flow.push({ t: 'sys', icon: '❌', msg: typeLabel + '失败: ' + (ex.error_text || ''), time, style: 'fail', proof: { '执行规则': ex.type, '错误': ex.error_text }, _o: false });
          } else if (ex.status === 'rejected') {
            flow.push({ t: 'sys', icon: '🚫', msg: '拒绝: ' + (ex.error_text || ''), time, style: 'fail', proof: null, _o: false });
          }
        }

        // 补全未来检查点
        for (let i = curIdx + 1; i < PIPE.length; i++) {
          flow.push({ t: 'cp', label: PIPE[i].label, wait: true });
        }

        // 加载交易专属频道的聊天消息，插入对话流末尾
        try {
          const tradeChannel = 'trade-' + orderId;
          const chatRes = await fetch('/api/chat/messages?channel=' + encodeURIComponent(tradeChannel) + '&limit=30').then(r => r.json());
          const chatMsgs = chatRes.messages || chatRes || [];
          for (const cm of chatMsgs) {
            const isMe = cm.sender_address === this.agentAddr;
            const senderName = isMe ? this.agentName : (peerName || cm.sender_address?.slice(-8));
            flow.push({
              t: isMe ? 'owner' : 'peer',
              who: senderName, av: senderName?.[0] || '?',
              time: cm.created_at?.slice(11, 16) || '',
              msg: cm.content || cm.message || '',
            });
          }
        } catch {}

        this._storyCache = storyCache;
        this.flow = flow;
        // 如果故事卡片打开着，刷新数据
        if (this.storyNode && storyCache[this.storyNode]) this.storyData = storyCache[this.storyNode];
        this.$nextTick(() => { if (this.$refs.chatScroll) this.$refs.chatScroll.scrollTop = this.$refs.chatScroll.scrollHeight; });
      } catch (err) {
        console.log('loadDealFlow error:', err);
      }
    },

    // ── 故事系统：管线节点 → 故事卡片 ──
    storyNode: null,   // 当前展开的节点 id
    storyData: null,   // { title, summary, tx, time, reasoning, proof, ok, active, future }

    toggleStory(nodeId) {
      if (this.storyNode === nodeId) { this.storyNode = null; this.storyData = null; return; }
      const cls = this.ndCls(nodeId);
      if (cls === 'wait') {
        // 未来节点——展示预告
        const futureStories = {
          published: '订单将发布到市场，所有参与者可见。通过 Kasia 协议广播到链上。',
          accepted: '对手方接受订单。系统自动锁定双方资金，检查限额，建立链上连接。',
          paying: '买方发起 USDT 转账。交易广播到目标链，等待区块确认。',
          paid: '转账已入链。系统等待确认数达标（BNB: 15 blocks, ETH: 12, SOL: 32 slots）。',
          verified: '到账金额和收款地址经链上验证，匹配无误。卖方准备发送 KAS。',
          delivering: 'KAS 通过 Kaspa 链发送给买方。Relay 签名广播。',
          completed: '双方交割完成。资金锁定释放，交易记录永久上链。',
        };
        this.storyNode = nodeId;
        this.storyData = { title: this.pipe.find(p=>p.id===nodeId)?.label, future: futureStories[nodeId] || '等待执行...' };
        return;
      }
      // 已完成或进行中的节点——从 execution_states 查故事
      const execMap = {
        published: null, // 发布阶段没有 execution
        accepted: 'accept_order',
        paying: 'pay_usdt',
        paid: 'pay_usdt',
        verified: 'verify_payment',
        delivering: 'send_kas',
        completed: 'send_kas',
      };
      const execType = execMap[nodeId];
      const exec = this.flow.filter(f =>
        (f.t === 'sys' || f.t === 'agent') && f._execType === execType
      );
      // 从 flow 中找对应的执行记录
      const relevantItems = this.flow.filter(f => {
        if (f.t === 'cp' && f.label === this.pipe.find(p=>p.id===nodeId)?.label) return true;
        return false;
      });

      // 构建故事
      const stageLabels = {
        published: '发布', accepted: '接受', paying: '付款中', paid: '已付款',
        verified: '已验证', delivering: '交割中', completed: '交易完成'
      };
      const pipeIds = this.pipe.map(p=>p.id);
      const curNode = STATUS_TO_NODE[this.deal?.status] || '_pre';
      const curIdx = pipeIds.indexOf(curNode);
      const nodeIdx = pipeIds.indexOf(nodeId);

      // 从 _storyCache 获取（loadDealFlow 时预建）
      const cached = this._storyCache?.[nodeId];
      if (cached) {
        this.storyNode = nodeId;
        this.storyData = cached;
        return;
      }

      // 降级：基础信息
      this.storyNode = nodeId;
      this.storyData = {
        title: stageLabels[nodeId] || nodeId,
        summary: nodeIdx <= curIdx ? '此步骤已完成' : '进行中...',
        ok: nodeIdx < curIdx,
        active: nodeIdx === curIdx,
      };
    },

    switchAgent() {
      this.deal = null;
      this.flow = [];
      this.walletPanel = null;
      this.wallet = { kas: 0, kasLocked: 0, chains: [] };
      this.orders = [];
      this.loadOrders();
      this.loadWallet();
      // 读当前 agent 的 mode
      fetch('/api/trade/agent-mode').then(r=>r.json()).then(r=>{ if(r?.mode) this.mode=r.mode; }).catch(()=>{});
    },

    async setMode(m) {
      if (m === 'auto' && !confirm('切换到全自动模式？\n\nAgent 将自主接单和执行交易。\n单笔上限: 200 KAS / 20 USDT\n自动限额 = 手动限额的 30%')) return;
      try {
        await fetch('/api/trade/agent-mode', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: m }) });
        this.mode = m;
      } catch {}
    },

    async doAction(action) {
      if (!this.deal) return;

      // ── Accept: broadcast kanet_accept_v1 to order's channel ──
      if (action === 'accept') {
        const order = this.deal;
        const myRelayId = this.agentId;
        const myAddr = this.agentAddr;

        if (order.relay_node_id === myRelayId) {
          // Own order — direct action (unusual case)
          return this._doActionRaw(order.id, 'accept');
        }

        try {
          const counterSide = order.side === 'sell' ? 'buy' : 'sell';
          const counterId = crypto.randomUUID();

          // Get my cross-chain wallet for pay_from
          let chainAddr = '';
          try {
            const walletRes = await fetch('/api/relay/' + myRelayId + '/wallets').then(r => r.json());
            const wallets = walletRes.wallets || walletRes || [];
            const chainWallet = wallets.find(w => w.chain === (order.chain || 'bnb'));
            chainAddr = chainWallet?.address || '';
          } catch {}

          // Build accept protocol message
          const acceptPayload = {
            t: 'kanet_accept_v1',
            v: 1,
            ref: order.id,
            counter_id: counterId,
            chain: order.chain || 'bnb',
            kas_addr: myAddr,
          };
          // Add pay_from if I'm the buyer
          if (counterSide === 'buy') {
            acceptPayload.pay_from = chainAddr;
          }

          // Broadcast to order's channel
          const bcastRes = await fetch('/api/chat/send', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ relayId: myRelayId, channel: order.id, message: JSON.stringify(acceptPayload) }),
          });
          const bcastData = await bcastRes.json();
          if (!bcastData.ok) { alert('广播失败: ' + (bcastData.error || '')); return; }

          // Poll for filter to process the accept (max 3s)
          let accepted = false;
          for (let i = 0; i < 6; i++) {
            await new Promise(r => setTimeout(r, 500));
            try {
              const check = await fetch('/api/trade/mm-orders?broadcast_txid=' + encodeURIComponent(bcastData.txId)).then(r => r.json());
              const orders = Array.isArray(check) ? check : (check.orders || []);
              if (orders.length > 0) { accepted = true; break; }
            } catch {}
          }

          if (!accepted) {
            console.log('Accept broadcast OK but index not yet synced');
          }

          // Switch to my counter-order view
          await this.loadOrders();
          const myOrder = this.orders.find(o => o.id === counterId);
          if (myOrder) {
            this.deal = myOrder;
            await this.loadDealFlow(counterId);
          }
          return;
        } catch (err) {
          alert('接单失败: ' + err.message);
          return;
        }
      }

      // ── 其他操作：直接在当前订单上执行 ──
      return this._doActionRaw(this.deal.id, action);
    },

    async _doActionRaw(orderId, action) {
      try {
        const res = await fetch('/api/trade/mm-orders/' + orderId + '/action', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        });
        const data = await res.json();
        if (data.ok) {
          await this.loadOrders();
          if (this.deal) await this.loadDealFlow(this.deal.id);
        } else {
          alert(data.error || '操作失败');
        }
      } catch (err) { alert('请求失败: ' + err.message); }
    },

    async approveExec(execId) {
      try {
        await fetch('/api/trade/approve-execution', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ executionId: execId }) });
        await this.loadDealFlow(this.deal.id);
      } catch {}
    },

    async rejectExec(execId) {
      try {
        await fetch('/api/trade/reject-execution', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ executionId: execId }) });
        await this.loadDealFlow(this.deal.id);
      } catch {}
    },

    async publishOrder() {
      try {
        const f = this.pubForm;
        const amt = parseFloat(f.amount);
        const price = parseFloat(f.price);
        if (!amt || !price) { alert('请填写数量和价格'); return; }

        // Generate order ID
        const orderId = crypto.randomUUID();

        // Get agent's cross-chain wallet address for recv/pay_from
        let chainAddr = '';
        try {
          const walletRes = await fetch('/api/relay/' + this.agentId + '/wallets').then(r => r.json());
          const wallets = walletRes.wallets || walletRes || [];
          const chainWallet = wallets.find(w => w.chain === f.chain);
          chainAddr = chainWallet?.address || '';
        } catch {}

        // Build protocol message
        const side = f.side;
        const payload = side === 'sell'
          ? { t: 'kanet_sell_v1', v: 1, id: orderId, amt, price, want: 'USDT', chain: f.chain, recv: chainAddr }
          : { t: 'kanet_buy_v1', v: 1, id: orderId, amt, price, pay: 'USDT', chain: f.chain, pay_from: chainAddr };

        // Broadcast to chain (channel = orderId)
        const bcastRes = await fetch('/api/chat/send', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayId: this.agentId, channel: orderId, message: JSON.stringify(payload) }),
        });
        const bcastData = await bcastRes.json();
        if (!bcastData.ok) { alert('广播失败: ' + (bcastData.error || '')); return; }

        // Optimistic: close publish form
        this.showPublish = false;

        // Poll for filter to index the order (max 3s)
        let found = false;
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 500));
          try {
            const check = await fetch('/api/trade/mm-orders?broadcast_txid=' + encodeURIComponent(bcastData.txId)).then(r => r.json());
            const orders = Array.isArray(check) ? check : (check.orders || []);
            if (orders.length > 0) { found = true; break; }
          } catch {}
        }
        if (!found) {
          console.log('Order broadcast OK but index not yet synced, will appear on next refresh');
        }
        await this.loadOrders();
      } catch (err) { alert('发布失败: ' + err.message); }
    },

    // 当前面板显示的钱包列表
    // 当前面板的钱包列表
    get panelWallets() {
      if (!this.walletPanel || this.walletPanel === 'kas') return [];
      return this.wallet.chains.filter(w => w.chain === this.walletPanel);
    },

    // 底栏按链聚合显示（同链多钱包余额加总）
    get chainSummary() {
      const map = {};
      for (const w of this.wallet.chains) {
        const key = w.chain;
        if (!map[key]) map[key] = { name: w.name, chain: key, usdt: 0, usdc: 0, locked: 0, count: 0 };
        map[key].usdt += w.usdt || 0;
        map[key].usdc += w.usdc || 0;
        map[key].locked += w.locked || 0;
        map[key].count++;
      }
      return Object.values(map);
    },

    openWalletPanel(chain) {
      if (this.walletPanel === chain) { this.walletPanel = null; return; }
      this.walletPanel = chain;
    },

    copyAddr(addr) {
      if (!addr) return;
      navigator.clipboard.writeText(addr);
      // 简单反馈
      const prev = event?.target?.textContent;
      if (event?.target) { event.target.textContent = '已复制 ✓'; setTimeout(() => { event.target.textContent = prev; }, 1500); }
    },

    async showPrivkeyFor(wallet) {
      if (!confirm('确定查看私钥？请确保周围环境安全。')) return;
      try {
        const res = await fetch('/api/relay/' + encodeURIComponent(this.agentId) + '/wallets/' + encodeURIComponent(wallet.id) + '/privkey').then(r => r.json());
        if (res.privkey) {
          prompt('私钥（请妥善保管）:', res.privkey);
        } else {
          alert(res.error || '无法获取私钥');
        }
      } catch { alert('获取失败'); }
    },

    withdrawPrompt(wallet) {
      const chainName = wallet.chain.toUpperCase();
      const assetChoice = prompt(
        '提现资产类型:\n' +
        '  1 = USDT (' + (wallet.usdt||0).toFixed(2) + ' 可用)\n' +
        '  2 = ' + chainName + ' 原生币 (' + (wallet.gas||0).toFixed(4) + ' 可用)\n\n' +
        '输入 1 或 2:'
      );
      if (!assetChoice) return;
      const asset = assetChoice.trim() === '2' ? 'native' : 'usdt';
      const assetLabel = asset === 'native' ? chainName : 'USDT';

      const toAddr = prompt('提现目标地址 (' + chainName + '):');
      if (!toAddr) return;
      const amt = prompt('提现金额 (' + assetLabel + '):');
      if (!amt || isNaN(amt)) return;
      if (!confirm('确认提现 ' + amt + ' ' + assetLabel + '\n→ ' + toAddr + '\n链: ' + chainName + '\n从: ' + wallet.address?.slice(0, 12) + '...')) return;
      this.doWithdraw(wallet, toAddr, parseFloat(amt), asset);
    },

    async doWithdraw(wallet, toAddr, amount, asset = 'usdt') {
      try {
        const res = await fetch('/api/trade/withdraw', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ walletId: wallet.id, chain: wallet.chain, to: toAddr, amount, asset }),
        });
        const data = await res.json();
        if (data.ok || data.txHash) {
          alert('提现成功！TX: ' + (data.txHash || '').slice(0, 20) + '...');
          await this.loadWallet();
        } else {
          alert('提现失败: ' + (data.error || '未知错误'));
        }
      } catch (err) { alert('提现失败: ' + err.message); }
    },

    async createWallet(chain) {
      try {
        await fetch('/api/relay/' + this.agentId + '/wallets', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chain }),
        });
        await this.loadWallet();
        this.openWalletPanel(chain);
      } catch (err) { alert('创建失败: ' + err.message); }
    },

    async sendChat() {
      if (!this.chatInput.trim() || !this.deal) return;
      const msg = this.chatInput;
      this.chatInput = '';
      // 本地立即显示
      this.flow.push({ t: 'owner', time: new Date().toTimeString().slice(0, 5), msg });
      this.$nextTick(() => { if (this.$refs.chatScroll) this.$refs.chatScroll.scrollTop = this.$refs.chatScroll.scrollHeight; });
      // 发到交易专属频道（每笔交易独立，不污染 Chat）
      // 频道名 = trade-{orderId}，双方都知道 orderId，链上公开透明
      const tradeChannel = 'trade-' + (this.deal.id || 'unknown');
      try {
        await fetch('/api/chat/send', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayId: this.agentId, channel: tradeChannel, message: msg }),
        });
      } catch {}
    },
  };
}
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Predictions Quick Bet — L1 Agent 智能下单</title>
<script src="https://unpkg.com/alpinejs@3.13.0/dist/cdn.min.js" defer></script>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; background: #0a0a0a; color: #eee; margin: 0; padding: 20px; }
  h1 { margin: 0 0 8px; font-size: 22px; }
  .sub { color: #888; font-size: 13px; margin-bottom: 24px; }
  .bar { display: flex; gap: 8px; margin-bottom: 16px; align-items: center; }
  .amt-input { background: #111; border: 1px solid #333; color: #eee; padding: 8px 12px; border-radius: 6px; width: 100px; font-size: 14px; }
  .market { background: #151515; border: 1px solid #2a2a2a; border-radius: 10px; padding: 16px; margin-bottom: 12px; }
  .q { font-size: 15px; font-weight: 500; margin-bottom: 4px; }
  .meta { color: #888; font-size: 12px; margin-bottom: 12px; }
  .btns { display: flex; gap: 10px; }
  .btn { flex: 1; padding: 14px; border-radius: 8px; border: 0; cursor: pointer; font-size: 15px; font-weight: 600; transition: transform 0.1s; }
  .btn:active { transform: scale(0.96); }
  .btn.yes { background: #16a34a22; color: #4ade80; border: 1px solid #16a34a; }
  .btn.no { background: #dc262622; color: #f87171; border: 1px solid #dc2626; }
  .btn.yes:hover { background: #16a34a44; }
  .btn.no:hover { background: #dc262644; }
  .btn:disabled { opacity: 0.5; cursor: wait; }
  .price { font-size: 11px; opacity: 0.7; display: block; margin-top: 2px; }
  .toast { position: fixed; top: 20px; right: 20px; min-width: 320px; max-width: 480px; background: #1a1a1a; border-left: 4px solid #4ade80; padding: 14px 18px; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); font-size: 13px; animation: slide 0.2s ease-out; }
  .toast.err { border-left-color: #f87171; }
  .toast a { color: #60a5fa; text-decoration: none; }
  .toast a:hover { text-decoration: underline; }
  @keyframes slide { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .hint { background: #0ea5e922; border-left: 3px solid #0ea5e9; padding: 10px 14px; border-radius: 4px; font-size: 12px; color: #7dd3fc; margin-bottom: 16px; }
</style>

</head>
<body>
<div x-data="quickbet()" x-init="init()">
  <h1>⚡ Predictions Quick Bet</h1>
  <div class="sub">L1 Agent 智能下单 · 选方向 → Agent 自动补价/size/签名/反馈</div>

  <div class="hint">
    💡 点 Yes / No 即 "买 $<span x-text="defaultAmount"></span> 该方向 outcome, 市价吃 best ask 自动成交".
    默认金额记忆上次下单值（首次 $5）。
  </div>

  <div class="bar">
    <label style="font-size:13px;color:#888">每次金额 ($ USDC):</label>
    <input class="amt-input" type="number" step="0.5" min="0.5" x-model.number="defaultAmount">
    <span style="font-size:12px;color:#666">（改了之后按按钮会记忆）</span>
  </div>

  <template x-if="loading">
    <div style="color:#888;padding:40px;text-align:center">加载市场中...</div>
  </template>

  <template x-for="m in markets" :key="m.conditionId || m.id">
    <div class="market">
      <div class="q" x-text="m.question || m.title || '?'"></div>
      <div class="meta">
        <span x-text="'End: ' + (m.endDate?.slice(0,10) || '?')"></span>
        · <span x-text="'Vol: ' + (m.volume ? '$'+Math.round(m.volume).toLocaleString() : '?')"></span>
      </div>
      <div class="btns">
        <button class="btn yes" :disabled="busy[m.conditionId+'_yes']"
                @click="bet(m, 'yes')">
          ✓ Yes · $<span x-text="defaultAmount"></span>
          <span class="price" x-text="m.outcomePrices ? ('@ ' + (parseFloat(m.outcomePrices?.[0])).toFixed(2)) : ''"></span>
        </button>
        <button class="btn no" :disabled="busy[m.conditionId+'_no']"
                @click="bet(m, 'no')">
          ✗ No · $<span x-text="defaultAmount"></span>
          <span class="price" x-text="m.outcomePrices ? ('@ ' + (parseFloat(m.outcomePrices?.[1])).toFixed(2)) : ''"></span>
        </button>
      </div>
    </div>
  </template>

  <template x-for="t in toasts" :key="t.id">
    <div class="toast" :class="{err: t.error}" x-show="t.visible" x-transition>
      <div x-text="t.msg"></div>
      <template x-if="t.tx">
        <div style="margin-top:6px;font-size:11px">
          TX: <a :href="'https://polygonscan.com/tx/'+t.tx" target="_blank" x-text="t.tx.slice(0,10)+'...'"></a>
        </div>
      </template>
    </div>
  </template>
</div>

<script>
  function quickbet() {
    return {
      RELAY_ID: '<%= relayId || "" %>',  // 不再默认 J2 relayId — 由 UI 调用方从 relay context 传, 避免身份冒用
      defaultAmount: 5,
      markets: [],
      loading: true,
      busy: {},
      toasts: [],

      async init() {
        // 拉默认金额
        try {
          const r = await fetch(`/api/predictions/default-amount?relay_node_id=${this.RELAY_ID}`);
          const d = await r.json();
          this.defaultAmount = d.default || 5;
        } catch {}

        // 拉市场 (前 5 个)
        try {
          const r = await fetch('/api/predictions/markets');
          const d = await r.json();
          const all = d.data || d.markets || [];
          this.markets = all.filter(m => !m.closed).slice(0, 5);
        } catch (e) {
          this.toast('加载市场失败: ' + e.message, true);
        }
        this.loading = false;
      },

      async bet(m, sideStr) {
        // sideStr = 'yes' or 'no' — 对应 outcome index 0 或 1
        // Polymarket 每个市场有 2 个 outcome token, clobTokenIds[0] = Yes, [1] = No (通常)
        const tokenIds = m.clobTokenIds ? (typeof m.clobTokenIds === 'string' ? JSON.parse(m.clobTokenIds) : m.clobTokenIds) : [];
        if (tokenIds.length < 2) {
          this.toast('市场 tokenIds 缺失，无法下单', true);
          return;
        }
        const tokenId = sideStr === 'yes' ? tokenIds[0] : tokenIds[1];
        const busyKey = (m.conditionId || m.id) + '_' + sideStr;
        this.busy[busyKey] = true;

        try {
          const res = await fetch('/api/predictions/quick-bet', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
              relay_node_id: this.RELAY_ID,
              tokenId,
              side: 'BUY',
              amount: this.defaultAmount,
            }),
          });
          const d = await res.json();
          if (d.ok) {
            this.toast(`✓ ${sideStr.toUpperCase()} ${d.size} shares @ $${d.price} (花 $${d.spent})`, false, d.raw?.transactionsHashes?.[0]);
          } else {
            this.toast('下单失败: ' + (d.error || 'unknown'), true);
          }
        } catch (e) {
          this.toast('请求失败: ' + e.message, true);
        } finally {
          this.busy[busyKey] = false;
        }
      },

      toast(msg, error = false, tx = null) {
        const id = Date.now() + Math.random();
        this.toasts.push({ id, msg, error, tx, visible: true });
        setTimeout(() => {
          const t = this.toasts.find(x => x.id === id);
          if (t) t.visible = false;
          setTimeout(() => { this.toasts = this.toasts.filter(x => x.id !== id); }, 300);
        }, 6000);
      },
    };
  }
</script>
</body>
</html>

<%~ include('partials/page-open', { _page: 'proto-market-list', pageTitle: '市场（原型）', ...it }) %>

<!-- 原型 v0.3(1325 派工·线框稿 §3, Bettor 1328 裁定): 独立新页。GET /api/proto-markets 已落码
     (J2 分支 coord/j2-proto-v0-backend b6a63d27, 读源码逐字段核过): 响应行原样透传 proto_markets 表
     (JOIN token_name/token_ticker), 不是"title/ticker/deadline/status(open..)"这套猜测字段名——本页
     字段/状态值已按真实 schema 对齐(question/token_ticker/deadline_ms/status IN betting|sealed|resolved|
     cancelled), 见 kasia-console/src/db/migrate.js v206。 -->

<div class="p-6 max-w-5xl mx-auto" x-data="protoMarketListPage()" x-init="init()">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h1 class="text-2xl font-display text-ink-800">市场（原型）</h1>
      <p class="text-xs text-ink-400 mt-1">用代币开的原型市场，可以下注。</p>
    </div>
    <a href="/proto-markets/create" class="btn btn-primary btn-sm">创建市场 →</a>
  </div>

  <div x-show="loading" class="text-center py-12 text-ink-400">载入中...</div>

  <div x-show="!loading && loadFailed" class="text-center py-12 bg-red-50 rounded-lg text-red-600 text-sm">
    加载失败：<span x-text="loadFailed"></span>（后端接口 /api/proto-markets 可能尚未上线）
  </div>

  <div x-show="!loading && !loadFailed && markets.length === 0" class="text-center py-16 bg-warm-50 rounded-lg">
    <div class="text-3xl mb-3">🎲</div>
    <p class="text-ink-500">还没有市场。</p>
    <a href="/proto-markets/create" class="text-brand-500 hover:text-brand-700 text-sm mt-2 inline-block">创建第一个 →</a>
  </div>

  <div x-show="!loading && !loadFailed && markets.length > 0" class="card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-warm-50 text-ink-500 text-xs">
        <tr>
          <th class="text-left py-2 px-3">议题</th>
          <th class="text-left py-2 px-3">代币</th>
          <th class="text-center py-2 px-3">状态</th>
          <th class="text-right py-2 px-3">截止时间</th>
          <th class="text-center py-2 px-3"></th>
        </tr>
      </thead>
      <tbody>
        <template x-for="m in markets" :key="m.id">
          <tr class="border-t border-warm-100 hover:bg-warm-50">
            <td class="py-2 px-3 max-w-[320px] truncate" :title="m.question" x-text="m.question || '(无标题)'"></td>
            <td class="py-2 px-3 text-ink-500 text-xs" x-text="m.token_ticker || '?'"></td>
            <td class="py-2 px-3 text-center">
              <span class="text-[10px] px-1.5 py-0.5 rounded font-medium" :class="statusBadge(m.status)" x-text="statusLabel(m.status)"></span>
            </td>
            <td class="py-2 px-3 text-right text-[11px] text-ink-400" x-text="fmtDeadline(m.deadline_ms)"></td>
            <td class="py-2 px-3 text-center">
              <a :href="'/proto-markets/' + m.id" class="text-brand-500 hover:text-brand-700 text-xs">详情 →</a>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>

<script>
function protoMarketListPage() {
  return {
    loading: true,
    loadFailed: '',
    markets: [],
    async init() {
      try {
        const res = await fetch('/api/proto-markets');
        if (!res.ok) { this.loadFailed = 'HTTP ' + res.status; this.loading = false; return; }
        const data = await res.json().catch(() => ({}));
        this.markets = data.markets || data || [];
      } catch (err) { this.loadFailed = err.message; }
      this.loading = false;
    },
    // 状态值对齐真实 schema(migrate.js v206 proto_markets.status CHECK): betting/sealed/resolved/cancelled。
    statusBadge(s) {
      if (s === 'resolved') return 'bg-emerald-100 text-emerald-700';
      if (s === 'cancelled') return 'bg-warm-200 text-ink-500';
      return 'bg-amber-100 text-amber-700';
    },
    statusLabel(s) {
      const m = { betting: '押注中', sealed: '等待结算', resolved: '已结算', cancelled: '已取消/退款' };
      return m[s] || s || '?';
    },
    fmtDeadline(ms) {
      if (!ms) return '';
      try { return new Date(Number(ms)).toISOString().slice(0, 16).replace('T', ' '); } catch { return ''; }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

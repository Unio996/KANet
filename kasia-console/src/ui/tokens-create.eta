<%~ include('partials/page-open', { _page: 'tokens-create', pageTitle: '创建代币定义', ...it }) %>

<!-- 原型 v0.3(1325 派工·线框稿 §1, 改自 v0.1/v0.2 — J2 合约约束核实, ledger 1335, Bettor 转达):
     KTT 从铸造起就绑定某个市场, 不存在"通用余额"——铸币发生在下注那一步(§3 两步流程: 铸筹码→下注),
     不在这一屏。这一屏只是保存一个"代币定义"(名称/ticker/默认面额/描述)到 DB, 不广播、不产生 TX、
     不需要出单人。市场创建时从定义列表选一个当结算单位; 真正的铸币+归属发生在具体某次下注。
     提交端点 POST /api/tokens/create(语义已变: 现在是"存定义")尚未落地(J2), 具体字段名与 J2 对齐后
     可能微调, 失败态如实显示, 不假装成功(NO TX NO STATE CHANGE)。 -->

<div class="p-6 max-w-xl mx-auto" x-data="tokensCreatePage()" x-init="init()" x-cloak>
  <div class="mb-5">
    <h1 class="text-2xl font-display text-ink-800">创建代币定义</h1>
    <p class="text-xs text-ink-400 mt-1">填几个字段，保存一个代币定义，之后开市场时选它做结算单位。（代币本身在下注时才铸造，这一步不上链。）</p>
  </div>

  <!-- 已完成态: 只是 DB 保存成功, 没有 TX -->
  <template x-if="shipped">
    <div class="card card-flush overflow-hidden mb-5 border border-warm-200">
      <div class="px-6 py-5 border-b border-warm-200">
        <h2 class="text-lg font-semibold text-ink-700">✓ 定义已保存</h2>
        <p class="text-xs text-ink-400 mt-1"><span x-text="result.name"></span> (<span x-text="result.ticker"></span>)<span x-show="result.faceValue"> · 默认面额 <span x-text="result.faceValue"></span></span></p>
      </div>
      <div class="px-6 py-4 border-t border-warm-200 flex gap-3">
        <a href="/proto-markets/create" class="btn btn-primary text-sm">去建市场 →</a>
        <a href="/tokens" class="btn btn-secondary text-sm">查看定义列表</a>
        <button @click="resetForm()" class="btn btn-ghost text-sm">再造一个</button>
      </div>
    </div>
  </template>

  <!-- 表单态 -->
  <template x-if="!shipped">
    <div class="card p-6 space-y-4">
      <div>
        <label class="text-xs text-ink-400">名称</label>
        <input x-model="form.name" type="text" maxlength="60" placeholder="例如 Kanet Test Token"
          class="w-full mt-1 border border-warm-300 rounded-lg px-3 py-2 text-sm focus:border-brand-400 focus:outline-none bg-warm-50">
      </div>
      <div>
        <label class="text-xs text-ink-400">Ticker</label>
        <input x-model="form.ticker" type="text" maxlength="6" placeholder="例如 KTT"
          @input="form.ticker = form.ticker.toUpperCase()"
          class="w-full mt-1 border border-warm-300 rounded-lg px-3 py-2 text-sm focus:border-brand-400 focus:outline-none bg-warm-50">
      </div>
      <div>
        <label class="text-xs text-ink-400">默认面额（可选，市场创建时预填，可改）</label>
        <input x-model.number="form.faceValue" type="number" min="0" step="any" placeholder="例如 100"
          class="w-full mt-1 border border-warm-300 rounded-lg px-3 py-2 text-sm focus:border-brand-400 focus:outline-none bg-warm-50">
      </div>
      <div>
        <label class="text-xs text-ink-400">描述（可选）</label>
        <textarea x-model="form.description" rows="2" maxlength="200"
          class="w-full mt-1 border border-warm-300 rounded-lg px-3 py-2 text-sm focus:border-brand-400 focus:outline-none bg-warm-50"></textarea>
      </div>

      <div x-show="errorMsg" class="text-xs text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2" x-text="errorMsg"></div>

      <button @click="submit()" :disabled="submitting || !canSubmit" class="btn btn-primary w-full" :class="(submitting || !canSubmit) ? 'opacity-50 cursor-not-allowed' : ''">
        <span x-show="!submitting">保存定义</span>
        <span x-show="submitting">保存中...</span>
      </button>
    </div>
  </template>
</div>

<script>
function tokensCreatePage() {
  return {
    form: { name: '', ticker: '', faceValue: null, description: '' },
    submitting: false,
    errorMsg: '',
    shipped: false,
    result: null,
    init() {},
    get canSubmit() {
      return !!(this.form.name.trim() && this.form.ticker.trim());
    },
    async submit() {
      if (!this.canSubmit || this.submitting) return;
      this.submitting = true;
      this.errorMsg = '';
      try {
        const res = await fetch('/api/tokens/create', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: this.form.name, ticker: this.form.ticker, faceValue: this.form.faceValue, description: this.form.description }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          this.errorMsg = '保存失败: ' + (data.error || ('HTTP ' + res.status)) + (res.status === 404 ? '（后端接口尚未上线）' : '');
          return;
        }
        this.result = { name: this.form.name, ticker: this.form.ticker, faceValue: this.form.faceValue };
        this.shipped = true;
      } catch (err) {
        this.errorMsg = '请求失败: ' + err.message;
      } finally {
        this.submitting = false;
      }
    },
    resetForm() {
      this.shipped = false;
      this.result = null;
      this.form = { name: '', ticker: '', faceValue: null, description: '' };
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

<%~ include('partials/page-open', { _page: 'predictions-pool-create', pageTitle: '发起预测', ...it }) %>

<!-- KANet-UI A.1 maker create market — V2 Editorial Dashboard 双栏
     spec: docs/b2-pool-ui-spec-v0.1.md Section 1 A.1
     美学: Editorial Financial Instrument (= Fraunces serif display + 古铜金 #b08a44 accent + verify-layer pattern)
     backend: POST /api/pool/market/create per Bettor r449 4 决策 (= 5 required fields, 6 backend defaults)
-->

<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet">

<style>
  .font-display { font-family: 'Fraunces', Georgia, serif; font-feature-settings: 'opsz' 36; }
  .accent-gold { color: #b08a44; }
  .accent-gold-bg { background: #b08a44; }
  .accent-gold-bg:hover { background: #97742d; }
  .accent-gold-border { border-color: #b08a44; }
  .accent-gold-hover-bg:hover { background: #fef9eb; border-color: #b08a44; }
  .stake-slider {
    -webkit-appearance: none; appearance: none;
    height: 4px; background: #e4e2dc; border-radius: 2px; outline: none;
  }
  .stake-slider::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 18px; height: 18px; background: #b08a44; border-radius: 50%; cursor: pointer;
    box-shadow: 0 0 0 4px rgba(176,138,68,0.15);
  }
  .timeline-step {
    display: flex; align-items: center; gap: 10px; padding: 6px 0;
    font-size: 13px; color: #6b6d7b;
  }
  .timeline-step.done { color: #16a34a; font-weight: 500; }
  .timeline-step.active { color: #b08a44; font-weight: 500; }
  .timeline-step.active .step-icon { animation: pulse 1.5s infinite; }
  .step-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px; border-radius: 50%;
    flex-shrink: 0; font-size: 11px;
  }
  .timeline-step.done .step-icon { background: #16a34a; color: white; }
  .timeline-step.active .step-icon { background: #b08a44; color: white; }
  .timeline-step.pending .step-icon { background: #e4e2dc; color: #9496a1; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(176,138,68,0.4); } 50% { box-shadow: 0 0 0 6px rgba(176,138,68,0); } }
</style>

<div class="p-6 max-w-5xl mx-auto" x-data="createPoolPage()" x-init="init()" x-cloak>

  <!-- ============================================ -->
  <!-- 钱包状态栏 (= 复用 predictions.eta pattern) -->
  <!-- ============================================ -->
  <div class="card card-compact mb-5 flex items-center gap-4 flex-wrap">
    <label class="flex items-center gap-2 text-sm">
      <span class="text-ink-500">出单人:</span>
      <select x-model="selectedRelayId" @change="onAgentChange()"
              class="rounded-lg border border-warm-300 px-3 py-1.5 text-sm bg-white font-medium">
        <%
          const eligibleMakers = it.relayNodes.filter(r => !r.is_oracle);
        %>
        <% if (eligibleMakers.length === 0) { %>
        <option value="">没有可用的出单人</option>
        <% } %>
        <% eligibleMakers.forEach(r => { %>
        <option value="<%= r.id %>"><%= r.name %></option>
        <% }) %>
      </select>
    </label>
    <template x-if="walletAddress">
      <div class="flex items-center gap-3 text-sm">
        <span class="font-mono text-xs text-ink-400 cursor-pointer"
              @click="navigator.clipboard.writeText(walletAddress)"
              :title="walletAddress"
              x-text="walletAddress.slice(0,12) + '...' + walletAddress.slice(-8)"></span>
        <span class="font-bold" :class="kasBalance > 0 ? 'text-ink-700' : 'text-red-500'"
              x-text="(kasBalance ?? 0).toFixed(4) + ' KAS'"
              :title="kasBalance < 4 ? '余额 < 4 KAS, 最大押注上限受余额限制' : ''"></span>
      </div>
    </template>
  </div>

  <!-- ============================================ -->
  <!-- ship 完成态: 显示 chain TX timeline -->
  <!-- ============================================ -->
  <template x-if="shipped">
    <div class="card card-flush overflow-hidden mb-5 border border-warm-200">
      <!-- KANet-UI 2026-06-07 P1-#1 (Bettor r324 关 1 PASS): jargon → 大白话 -->
      <div class="px-6 py-5 border-b border-warm-200">
        <h2 class="font-display text-2xl text-ink-700">押金 <span x-text="form.maker_stake_kas"></span> KAS 已锁</h2>
        <p class="text-xs text-ink-400 mt-1">议题编号: <span class="font-mono" x-text="result.market_id?.slice(-12)"></span></p>
      </div>
      <div class="px-6 py-5 space-y-1">
        <template x-for="(step, i) in timeline" :key="step.id">
          <div class="timeline-step" :class="step.state">
            <span class="step-icon" x-text="step.state === 'done' ? '✓' : step.state === 'active' ? '◉' : (i+1)"></span>
            <span x-text="step.label"></span>
            <span class="text-xs text-ink-300 ml-auto" x-show="step.note" x-text="step.note"></span>
          </div>
        </template>
      </div>
      <div class="px-6 py-4 bg-warm-50 border-t border-warm-200 space-y-2 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-ink-500 w-24">本金锁单 TX</span>
          <a class="font-mono accent-gold hover:underline" target="_blank"
             :href="'https://explorer-tn12.kaspa.org/txs/' + result.spine_lock_tx"
             x-text="result.spine_lock_tx?.slice(0,16) + '...' + result.spine_lock_tx?.slice(-8)"></a>
        </div>
        <!-- 高级 detail 折叠默认: market id 完整 + 本金锁地址 -->
        <button type="button" @click="showAdvancedShipDetail = !showAdvancedShipDetail"
                class="text-[11px] text-ink-400 hover:underline">
          <span x-text="showAdvancedShipDetail ? '收起高级详情 ↑' : '看高级详情 (议题 ID 全 + 本金锁地址) →'"></span>
        </button>
        <div x-show="showAdvancedShipDetail" class="space-y-2 pt-1 border-t border-warm-200">
          <div class="flex items-center gap-2">
            <span class="text-ink-400 w-24">议题 ID 全</span>
            <span class="font-mono text-ink-500 break-all" x-text="result.market_id"></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-ink-400 w-24">本金锁地址</span>
            <span class="font-mono text-ink-500" x-text="result.spine_p2sh?.slice(0,18) + '...' + result.spine_p2sh?.slice(-12)"></span>
          </div>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-warm-200 flex gap-3">
        <a :href="'/predictions/pool/' + result.market_id"
           class="btn btn-secondary text-sm">查看市场详情 →</a>
        <button @click="resetForm()" class="btn btn-ghost text-sm">再发一个</button>
      </div>
    </div>
  </template>

  <!-- ============================================ -->
  <!-- Polymarket 关键字搜索 (= Owner r455 钦定, iteration 2) -->
  <!-- ============================================ -->
  <template x-if="!shipped">
    <div class="card card-flush overflow-hidden mb-5">
      <div class="px-6 py-4 border-b border-warm-200">
        <label class="block text-xs font-medium text-ink-500 mb-2">找现成议题（关键字搜索 · 不强求）</label>
        <input type="text" x-model="searchQuery" @input.debounce.500ms="searchPolymarket()"
               placeholder="例: BTC / Trump / 美联储 / Fed / election"
               class="w-full text-sm px-4 py-2.5 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none">
      </div>
      <template x-if="searching">
        <div class="px-6 py-4 text-sm text-ink-400">搜索中...</div>
      </template>
      <template x-if="!searching && searchResults && searchResults.length > 0">
        <div class="px-6 py-4 space-y-2.5">
          <template x-for="r in searchResults" :key="r.condition_id">
            <div class="border border-warm-200 rounded-lg p-4 hover:border-amber-300 transition">
              <h3 class="font-display text-base text-ink-700 mb-1" x-text="r.question"></h3>
              <div class="flex items-center gap-3 text-xs text-ink-500 mb-2">
                <span x-text="'Vol $' + (r.volume_24h ? r.volume_24h.toLocaleString(undefined,{maximumFractionDigits:0}) : '0')"></span>
                <template x-if="r.yes_price !== null">
                  <span x-text="'YES @' + (r.yes_price * 100).toFixed(0) + '¢'"></span>
                </template>
                <template x-if="r.end_date">
                  <span x-text="'截止 ' + new Date(r.end_date).toLocaleDateString()"></span>
                </template>
              </div>
              <button @click="usePolymarketMarket(r)"
                      class="accent-gold-bg text-white text-xs px-3 py-1.5 rounded">
                选用这个 →
              </button>
            </div>
          </template>
        </div>
      </template>
      <template x-if="!searching && searchQuery && searchQuery.length >= 2 && searchResults && searchResults.length === 0">
        <div class="px-6 py-4 text-sm text-ink-400">
          没找到匹配议题.
          <button @click="useManualMode()" class="text-amber-700 underline ml-2">自己出题 →</button>
        </div>
      </template>
      <template x-if="form.polymarketCondition">
        <div class="px-6 py-3 bg-amber-50 border-t border-warm-200 text-xs text-amber-700 flex items-center justify-between">
          <span>已选用现成议题 (= 4 input 自动填好, 可调押金 + 勾 disclaimer + 发起)</span>
          <button @click="clearPolymarketChoice()" class="underline text-amber-700">换一个 →</button>
        </div>
      </template>
    </div>
  </template>

  <!-- ============================================ -->
  <!-- 主表单 (= V2 Editorial Dashboard 双栏) -->
  <!-- ============================================ -->
  <template x-if="!shipped">
    <div class="card card-flush overflow-hidden">
      <!-- Header -->
      <div class="px-6 py-5 border-b border-warm-200 flex items-baseline justify-between">
        <h1 class="font-display text-3xl text-ink-700">发起预测</h1>
        <span class="text-xs text-ink-400" title="V2 极简 4 input 30s 完整">极简表单 · 4 input · ~30s</span>
      </div>

      <div class="px-6 py-6 grid grid-cols-1 md:grid-cols-5 gap-6">

        <!-- 左栏 内容 (= col-span-3) -->
        <div class="md:col-span-3 space-y-5">

          <!-- KANet-UI 2026-06-07 P0-#1 A (Bettor r321 关 1 PASS): 题目+题干合一为'议题'. backend spec 写 title=question 同值. -->
          <div>
            <label class="block text-xs font-medium text-ink-500 mb-1.5">议题 <span class="text-red-500">*</span></label>
            <input type="text" x-model="form.title" @blur="touched.title = true" maxlength="200"
                   placeholder="例: BTC 2026-06-30 23:59 UTC Binance 收盘价 ≥ 80,000?"
                   class="w-full font-display text-xl px-4 py-3 rounded-lg border focus:border-amber-400 focus:ring-2 focus:ring-amber-100 focus:outline-none"
                   :class="touched.title && !form.title.trim() ? 'border-red-400' : 'border-warm-300'">
            <p class="text-xs text-ink-400 mt-1">一句话, 用户和 oracle 都看懂赌什么 (≤ 200 字)</p>
            <p x-show="touched.title && !form.title.trim()" class="text-xs text-red-500 mt-1">请填议题</p>
          </div>

          <!-- 截止 -->
          <div>
            <label class="block text-xs font-medium text-ink-500 mb-1.5">截止时间 (UTC) <span class="text-red-500">*</span></label>
            <input type="datetime-local" x-model="form.outcome_end_date_local" @blur="touched.deadline = true"
                   :min="minDeadlineLocal" :max="maxDeadlineLocal"
                   class="w-full font-mono text-sm px-4 py-2.5 rounded-lg border focus:border-amber-400 focus:outline-none"
                   :class="touched.deadline && !form.outcome_end_date_local ? 'border-red-400' : 'border-warm-300'">
            <p class="text-xs text-ink-400 mt-1">必 ≥ 现在 + <span x-text="minDeadlineMin"></span> 分钟 · ≤ <span x-text="maxDeadlineDay"></span> 天 (testnet)</p>
            <p x-show="touched.deadline && !form.outcome_end_date_local" class="text-xs text-red-500 mt-1">请选截止时间</p>
          </div>

          <!-- KANet-UI 2026-06-07 P0-#1 C (Bettor r321 关 1 PASS): 数据源 + 规则合 1 card '判定凭据'. 内部 2 input 不动. -->
          <div class="card bg-warm-50 p-4 border border-warm-200">
            <div class="text-xs font-medium text-ink-700 mb-1">判定凭据 <span class="text-red-500">*</span></div>
            <p class="text-[11px] text-ink-500 mb-3">oracle 凭什么判 YES/NO. 数据来源 + 怎么解读两件.</p>

            <!-- 数据来源 (子项 1) -->
            <div class="mb-3">
              <label class="block text-[11px] text-ink-500 mb-1">数据来源</label>
              <select x-model="form.source_kind" @change="onSourceKindChange()"
                      class="w-full text-sm px-3 py-2 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none bg-white">
                <option value="binance">大所收盘价 (Binance 日线)</option>
                <option value="polymarket">Polymarket 议题</option>
                <option value="sport">体育/事件 (测试占位)</option>
                <option value="kaspa-onchain">Kaspa 链上事件</option>
                <option value="manual">我自己填 URL (高级)</option>
              </select>
              <div x-show="form.source_kind === 'binance'" class="mt-2">
                <input type="text" x-model="form.source_params.symbol" maxlength="20"
                       placeholder="例: BTCUSDT / ETHUSDT / KASUSDT"
                       class="w-full text-sm px-3 py-2 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none font-mono" />
                <p class="text-[11px] text-ink-400 mt-1">填 Binance 交易对. 仲裁人自动取日线收盘价判定.</p>
              </div>
              <div x-show="form.source_kind === 'polymarket'" class="mt-2">
                <input type="text" x-model="form.source_params.condition_id" maxlength="200"
                       placeholder="Polymarket condition_id (= 上面议题搜索自动填)"
                       class="w-full text-sm px-3 py-2 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none font-mono" />
                <p class="text-[11px] text-ink-400 mt-1">用上面"找现成议题"搜出来直接选, condition_id 自动填.</p>
              </div>
              <div x-show="form.source_kind === 'sport'" class="mt-2">
                <input type="text" x-model="form.source_params.event_id" maxlength="100"
                       placeholder="例: world_cup_final_2026_yes"
                       class="w-full text-sm px-3 py-2 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none font-mono" />
                <p class="text-[11px] text-ink-400 mt-1">测试网占位 (= 走 mock test-oracle 演示). 末尾 _yes / _no 决判定方向.</p>
              </div>
              <div x-show="form.source_kind === 'kaspa-onchain'" class="mt-2">
                <input type="text" x-model="form.source_params.tx_hash" maxlength="80"
                       placeholder="64 hex TX hash"
                       class="w-full text-sm px-3 py-2 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none font-mono" />
                <p class="text-[11px] text-ink-400 mt-1">填 Kaspa 链上 TX hash. 仲裁人查该 TX 状态判定.</p>
              </div>
              <div x-show="form.source_kind === 'manual'" class="mt-2">
                <input type="text" x-model="form.data_source_canonical" maxlength="500"
                       placeholder="例: https://api.example.com/.../outcome"
                       class="w-full text-sm px-3 py-2 rounded-lg border border-warm-300 focus:border-amber-400 focus:outline-none font-mono" />
                <p class="text-[11px] text-ink-400 mt-1">高级: 自填可信公开 URL. 仲裁人自动 fetch 该 URL 提取 outcome.</p>
              </div>
            </div>

            <!-- 判定规则 (子项 2) -->
            <div>
              <label class="block text-[11px] text-ink-500 mb-1">判定规则</label>
              <textarea x-model="form.resolution_rule_spec" @blur="touched.rule = true" rows="4" maxlength="1000"
                        placeholder="例: 看 6/30 23:59 UTC Binance BTC/USDT 收盘价。 ≥80,000 = YES, 否则 NO."
                        class="w-full text-sm px-3 py-2 rounded-lg border focus:border-amber-400 focus:outline-none font-sans leading-relaxed"
                        :class="touched.rule && !form.resolution_rule_spec.trim() ? 'border-red-400' : 'border-warm-300'"></textarea>
              <div class="flex items-center justify-between mt-1">
                <p class="text-[11px] text-ink-400">明确数据源 + 时间 + 阈值 = 减少 oracle 分歧</p>
                <button @click="llmCheckRule()" :disabled="!form.resolution_rule_spec || llmChecking"
                        class="text-[11px] accent-gold hover:underline disabled:opacity-40">
                  <span x-text="llmChecking ? '检查中...' : '🤖 LLM 检查规则清晰度'"></span>
                </button>
              </div>
              <p x-show="touched.rule && !form.resolution_rule_spec.trim()" class="text-xs text-red-500 mt-1">请填判定规则</p>
              <template x-if="llmResult">
                <div class="mt-2 text-xs px-3 py-2 rounded-lg" :class="llmResult.score >= 7 ? 'bg-green-50 text-green-700' : llmResult.score >= 4 ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700'">
                  <span class="font-medium">清晰度 <span x-text="llmResult.score"></span>/10:</span>
                  <span x-text="llmResult.advice"></span>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- 右栏 押注 (= col-span-2) -->
        <div class="md:col-span-2 space-y-5 border-l border-warm-200 pl-6">

          <!-- YES/NO -->
          <div>
            <label class="block text-xs font-medium text-ink-500 mb-1.5">你押哪边 <span class="text-red-500">*</span></label>
            <div class="grid grid-cols-2 gap-2">
              <button @click="form.outcome_side = 'YES'; touched.outcome_side = true"
                      class="py-3 rounded-lg border-2 transition font-display text-lg"
                      :class="form.outcome_side === 'YES' ? 'accent-gold-bg text-white accent-gold-border' : 'border-warm-300 text-ink-500 accent-gold-hover-bg'">
                YES
              </button>
              <button @click="form.outcome_side = 'NO'; touched.outcome_side = true"
                      class="py-3 rounded-lg border-2 transition font-display text-lg"
                      :class="form.outcome_side === 'NO' ? 'accent-gold-bg text-white accent-gold-border' : 'border-warm-300 text-ink-500 accent-gold-hover-bg'">
                NO
              </button>
            </div>
          </div>

          <!-- 押金 -->
          <div>
            <label class="block text-xs font-medium text-ink-500 mb-1.5 flex items-baseline justify-between">
              <span>押 <span class="font-display text-base text-ink-700" x-text="form.maker_stake_kas"></span> KAS</span>
              <span class="text-xs text-ink-400">(最低 100 KAS)</span>
            </label>
            <input type="range" x-model.number="form.maker_stake_kas"
                   :min="poolConfig?.maker_stake_min_kas ?? 100"
                   :max="poolConfig?.maker_stake_max_kas ?? 10000"
                   step="0.5"
                   class="w-full stake-slider">
          </div>

          <!-- 成交费 (Oracle v0.3 §8 disclose mandatory + 1 input + 1:1:1 split) -->
          <div>
            <label class="block text-xs font-medium text-ink-500 mb-1.5 flex items-baseline justify-between">
              <span>成交费 <span class="font-display text-base text-ink-700" x-text="form.total_fee_pct"></span>%</span>
              <span class="text-xs text-ink-400">(默认 3% · 范围 1-10)</span>
            </label>
            <input type="range" x-model.number="form.total_fee_pct" min="1" max="10" step="1"
                   class="w-full stake-slider">
            <!-- §8 4 disclose mandatory -->
            <div class="mt-1.5 text-[11px] text-ink-400 space-y-0.5">
              <div>📋 <span class="text-ink-500">类型</span>: 预测市场 (pool)</div>
              <div>💰 <span class="text-ink-500">分账</span>: maker <span x-text="(form.total_fee_pct / 3).toFixed(1)"></span>% / oracle <span x-text="(form.total_fee_pct / 3).toFixed(1)"></span>% / broker <span x-text="(form.total_fee_pct / 3).toFixed(1)"></span>%</div>
              <div>⚖ <span class="text-ink-500">最大费</span>: 同 <span x-text="form.total_fee_pct"></span>% (= 无 dispute)</div>
            </div>
            <button type="button" @click="form.showAdvancedFee = !form.showAdvancedFee"
                    class="text-[11px] text-amber-700 underline mt-1">
              <span x-text="form.showAdvancedFee ? '收起 ↑' : '调整分配比例 →'"></span>
            </button>
            <!-- Advanced collapse: 3 fee channel 分别调 -->
            <div x-show="form.showAdvancedFee" x-transition class="mt-2 space-y-2 bg-warm-50 p-2 rounded">
              <div>
                <label class="text-[11px] text-ink-500">maker fee <span x-text="form.maker_fee_pct"></span>%</label>
                <input type="range" x-model.number="form.maker_fee_pct" min="0" max="5" step="0.5" class="w-full">
              </div>
              <div>
                <label class="text-[11px] text-ink-500">oracle fee <span x-text="form.oracle_fee_pct"></span>% (= range 5-20% spec lock)</label>
                <input type="range" x-model.number="form.oracle_fee_pct" min="0" max="20" step="1" class="w-full">
              </div>
              <div>
                <label class="text-[11px] text-ink-500">broker fee <span x-text="form.broker_fee_pct"></span>%</label>
                <input type="range" x-model.number="form.broker_fee_pct" min="0" max="5" step="0.5" class="w-full">
              </div>
            </div>
          </div>


          <label class="flex items-center gap-2 text-xs cursor-pointer">
            <input type="checkbox" x-model="acceptedDisclaimer" class="accent-amber-600">
            <span class="text-ink-600">我准备签名锁押金</span>
          </label>

          <!-- 发起 button -->
          <button @click="submitMarket()" :disabled="!canSubmit || submitting"
                  class="w-full py-3.5 rounded-lg font-display text-lg transition"
                  :class="canSubmit && !submitting ? 'accent-gold-bg text-white shadow-sm' : 'bg-warm-200 text-ink-300 cursor-not-allowed'">
            <span x-text="submitting ? '锁押金中...' : '发起预测 →'"></span>
          </button>
          <!-- KANet-UI 2026-06-07 P0-#1 B (Bettor r321): missing list 显缺啥 -->
          <div x-show="!canSubmit && missingList().length > 0" class="text-xs text-amber-700 bg-amber-50 rounded px-3 py-2 text-center">
            还差: <span x-text="missingList().join(' · ')"></span>
          </div>
          <template x-if="submitError">
            <div class="text-xs text-red-600 px-3 py-2 bg-red-50 rounded-lg" x-text="submitError"></div>
          </template>
        </div>
      </div>
    </div>
  </template>

</div>

<script>
function createPoolPage() {
  return {
    selectedRelayId: '<%= it.relayNodes[0]?.id || "" %>',
    walletAddress: '',
    kasBalance: null,
    poolConfig: null,
    minDeadlineMin: 15,
    maxDeadlineDay: 30,
    // KANet-UI 2026-06-07 P0-#1 B (Bettor r321): touched 状态 — 失焦才显红字, 防 init 就红
    touched: { title: false, deadline: false, rule: false, outcome_side: false },
    // KANet-UI 2026-06-07 P1-#1 (Bettor r324): ship 后高级 detail 折叠 (议题 ID 全 / 本金锁地址 默认收)
    showAdvancedShipDetail: false,
    form: {
      outcome_end_date_local: '',
      outcome_side: '',
      maker_stake_kas: 100,
      title: '',                        // KANet-UI 2026-06-07 P0-#1 A (Bettor r321): 题目+题干合一字段 (= '议题')
      // KANet-UI 2026-06-07 P0-#5 form 软化 (Bettor r291b 关1 PASS):
      // source_kind 下拉 + source_params 后端 derive canonical. data_source_canonical 仅 manual 模式.
      source_kind: 'binance',           // default = Binance 大所收盘价 (= UMA 现可裁 + 用户最熟)
      source_params: { symbol: '', condition_id: '', event_id: '', tx_hash: '' },
      data_source_canonical: '',        // 仅 source_kind=manual 模式下用
      resolution_rule_spec: '',
      polymarketCondition: null,  // iteration 2: set when 选用 Polymarket result
      // Oracle v0.3 §8/O2/§9 fold sub #7 — 5/26 final lock
      total_fee_pct: 3,             // 主 input default 3%
      maker_fee_pct: 1,             // advanced split default 1:1:1
      oracle_fee_pct: 10,           // 议题 B spec range 5-20%, default 10
      broker_fee_pct: 1,            // advanced split default 1:1:1
      commit_reveal_enabled: false, // O2 Phase 2 defer, testnet default off
      showAdvancedFee: false,       // collapse default
    },
    brokerOracleMutexWarning: '',  // pool v0.5 L52 互斥 friendly warning
    acceptedDisclaimer: false,
    llmChecking: false,
    llmResult: null,
    submitting: false,
    submitError: '',
    shipped: false,
    result: null,
    timeline: [],
    pollHandle: null,
    // iteration 2 — Polymarket 关键字搜索 (= Owner r455 钦定)
    searchQuery: '',
    searching: false,
    searchResults: null,

    async init() {
      // load /api/pool/config first → set min/max + default stake
      try {
        const r = await fetch('/api/pool/config');
        const j = await r.json();
        if (j.ok) {
          this.poolConfig = j;
          this.minDeadlineMin = parseInt(j.disagreement_timeout_min, 10) || 15;
          // 实 backend min deadline 15 min override 通过 env, UI 用 hardcode 15 显示
          this.maxDeadlineDay = parseInt(j.deadline_max_days, 10) || 30;
          this.form.maker_stake_kas = j.maker_stake_min_kas || 100;
        }
      } catch (e) { console.warn('pool config load fail', e); }
      this.setDefaultDeadline();
      await this.onAgentChange();
    },

    setDefaultDeadline() {
      // default = now + 1 hour (= 测试网 demo 友好)
      const d = new Date(Date.now() + 60 * 60_000);
      this.form.outcome_end_date_local = d.toISOString().slice(0, 16);
    },

    get minDeadlineLocal() {
      return new Date(Date.now() + this.minDeadlineMin * 60_000).toISOString().slice(0, 16);
    },
    get maxDeadlineLocal() {
      return new Date(Date.now() + this.maxDeadlineDay * 86400_000).toISOString().slice(0, 16);
    },

    get canSubmit() {
      return this.missingList().length === 0;
    },
    // KANet-UI 2026-06-07 P0-#1 B (Bettor r321): 必填缺啥清单 (= submit button 旁显)
    missingList() {
      const out = [];
      if (!this.form.title.trim()) out.push('议题');
      if (!this.form.outcome_end_date_local) out.push('截止时间');
      if (!this.form.outcome_side) out.push('押方向');
      if (!this.form.resolution_rule_spec.trim()) out.push('判定规则');
      const sk = this.form.source_kind;
      const p = this.form.source_params || {};
      let srcOk = false;
      if (sk === 'binance') srcOk = !!(p.symbol || '').trim();
      else if (sk === 'polymarket') srcOk = !!(p.condition_id || '').trim();
      else if (sk === 'sport') srcOk = !!(p.event_id || '').trim();
      else if (sk === 'kaspa-onchain') srcOk = /^[0-9a-fA-F]{64}$/.test((p.tx_hash || '').trim());
      else if (sk === 'manual') srcOk = !!(this.form.data_source_canonical || '').trim();
      if (!srcOk) out.push('数据来源');
      if (!this.acceptedDisclaimer) out.push('勾签名确认');
      if (!(this.form.maker_stake_kas > 0)) out.push('押金');
      return out;
    },

    onSourceKindChange() {
      // 切换源时清自填 canonical (= 防上次残留漂回 manual 模式)
      if (this.form.source_kind !== 'manual') this.form.data_source_canonical = '';
    },

    async onAgentChange() {
      if (!this.selectedRelayId) return;
      try {
        const r = await fetch('/api/relay/' + this.selectedRelayId);
        const j = await r.json();
        this.walletAddress = j.address || '';
      } catch (e) { this.walletAddress = ''; }
      try {
        const r = await fetch('/api/relay/' + this.selectedRelayId + '/balance');
        const j = await r.json();
        this.kasBalance = typeof j.kas === 'number' ? j.kas : null;
      } catch (e) { this.kasBalance = null; }
      // broker/oracle 互斥 check (= pool v0.5 L52 + J1 #10 fold sub #7)
      await this.checkBrokerOracleMutex();
    },

    async checkBrokerOracleMutex() {
      this.brokerOracleMutexWarning = '';
      if (!this.selectedRelayId) return;
      try {
        // 查 oracle_registry — 如 maker_relay 同时 oracle → warning
        const r = await fetch('/api/oracle/registry');
        const j = await r.json();
        const oracleList = j.oracles || [];
        const isOracle = oracleList.some(o => o.relay_node_id === this.selectedRelayId);
        if (isOracle) {
          this.brokerOracleMutexWarning = '当前 agent 同时注册了 oracle role — broker 兼 oracle 有 manipulation 向量风险';
        }
      } catch (e) { /* silent fail = no warning, backend hard 403 兜底 */ }
    },

    // iteration 2 — Polymarket 关键字搜索 handlers (= Owner r455 钦定)
    async searchPolymarket() {
      const q = (this.searchQuery || '').trim();
      if (q.length < 2) { this.searchResults = null; return; }
      this.searching = true;
      try {
        const r = await fetch('/api/predictions/polymarket/search?q=' + encodeURIComponent(q));
        const j = await r.json();
        this.searchResults = j.ok ? (j.results || []) : [];
      } catch (e) { this.searchResults = []; }
      this.searching = false;
    },

    usePolymarketMarket(r) {
      // auto-fill 议题 / 截止 / 规则 + outcome_condition_id (= polymarket condition 真链)
      // KANet-UI 2026-06-07 P0-#1 A (Bettor r321): 合一字段 → 写 form.title (替换 form.question)
      this.form.title = r.question || '';
      if (r.end_date) {
        try {
          const d = new Date(r.end_date);
          if (!isNaN(d.getTime())) this.form.outcome_end_date_local = d.toISOString().slice(0, 16);
        } catch {}
      }
      if (r.description) {
        // truncate to fit 1000 char limit; if no description fallback to question reference
        this.form.resolution_rule_spec = (r.description || '').slice(0, 800).trim() || `参考 Polymarket 议题 "${r.question}" 的官方 resolution rules.`;
      } else {
        this.form.resolution_rule_spec = `看 Polymarket 议题 "${r.question}" 的官方判定 (slug: ${r.slug || r.condition_id}).`;
      }
      this.form.polymarketCondition = r.condition_id;
      // KANet-UI 2026-06-07 P0-#5: 选用 Polymarket 议题自动切 source_kind + condition_id
      this.form.source_kind = 'polymarket';
      this.form.source_params.condition_id = r.condition_id;
      this.searchResults = null;
      this.searchQuery = '';
      this.llmResult = null;
    },

    clearPolymarketChoice() {
      this.form.polymarketCondition = null;
      this.form.title = '';
      this.form.resolution_rule_spec = '';
      this.setDefaultDeadline();
      this.searchQuery = '';
      this.searchResults = null;
    },

    useManualMode() {
      this.searchResults = null;
      this.searchQuery = '';
    },

    async llmCheckRule() {
      if (!this.form.resolution_rule_spec) return;
      this.llmChecking = true;
      this.llmResult = null;
      // LLM endpoint 待 Bettor architect 钦定 — 现 placeholder stub.
      // 替换为 POST /api/pool/llm-check-rule { rule, question } → { score, advice }
      await new Promise(r => setTimeout(r, 800));
      const r = this.form.resolution_rule_spec.trim();
      const hasSource = /binance|coinbase|coingecko|polymarket|官方|UTC|GMT|\d/i.test(r);
      const hasThreshold = /[><=]|大于|小于|等于|超过|不超|多少|\d/.test(r);
      const score = (hasSource ? 5 : 0) + (hasThreshold ? 5 : 0);
      this.llmResult = {
        score,
        advice: score >= 7 ? '规则清晰, oracle 易判定' : score >= 4 ? '建议加明确数据源 + 阈值 + 时间, 减少 oracle 分歧' : '规则太模糊, oracle 多半投不同 → refund_disagreement',
      };
      this.llmChecking = false;
    },

    async submitMarket() {
      if (!this.canSubmit) return;
      this.submitting = true;
      this.submitError = '';
      try {
        const outcomeEndIso = new Date(this.form.outcome_end_date_local).toISOString();
        // KANet-UI 2026-06-07 P0-#5 form 软化 (Bettor r291b 关1 PASS):
        // source_kind != manual: 只塞 title + resolution_criteria, backend derive canonical 后塞 spec.
        // source_kind == manual: 同时塞自填 canonical.
        // KANet-UI 2026-06-07 P0-#1 A (Bettor r321): title=question 同值. spec 含两字段 = isStructuredSpec 不破 + downstream 兼容.
        const _q = this.form.title.trim();
        const specObj = {
          title: _q,
          question: _q,
          resolution_criteria: this.form.resolution_rule_spec.trim(),
        };
        if (this.form.source_kind === 'manual') {
          specObj.data_source_canonical = this.form.data_source_canonical.trim();
          specObj.source = 'manual';
        }
        const structuredSpec = JSON.stringify(specObj);
        const body = {
          maker_relay_id: this.selectedRelayId,
          outcome_side: this.form.outcome_side,
          outcome_end_date: outcomeEndIso,
          resolution_rule_spec: structuredSpec,
          maker_stake_kas: String(this.form.maker_stake_kas),
        };
        // source_kind 非 manual → 带 source_kind + source_params, backend derive canonical
        if (this.form.source_kind !== 'manual') {
          body.source_kind = this.form.source_kind;
          body.source_params = { ...this.form.source_params };
        }
        // backend r449 4 决策: 不传 oracle_relay_ids / broker_relay_id / broker_fee_pct / oracle_bond_kas
        // / outcome_market_source / outcome_condition_id / outcome_token_id — 全 backend defaults fill
        // iteration 2 (= r455 Polymarket): 如选 Polymarket 议题, 覆盖 outcome_market_source + condition_id 真链
        if (this.form.polymarketCondition) {
          body.outcome_market_source = 'polymarket';
          body.outcome_condition_id = this.form.polymarketCondition;
        }
        const r = await fetch('/api/pool/market/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || 'create fail');
        this.result = j;
        this.shipped = true;
        this.initTimeline();
        this.startStatusPoll();
      } catch (e) {
        this.submitError = e.message;
      }
      this.submitting = false;
    },

    initTimeline() {
      // KANet-UI 2026-06-07 P1-#1 (Bettor r324): jargon → 大白话, 抽块 label 删, Oracle→仲裁人
      this.timeline = [
        { id: 'broadcast',   label: '本金锁单 TX 广播',                              state: 'done', note: '' },
        { id: 'mined',       label: '上链确认',                                       state: 'active', note: '约 5-15 秒' },
        { id: 'sampling',    label: '抽仲裁人',                                       state: 'pending', note: '约 10 秒' },
        { id: 'oracle_deps', label: '仲裁人接单',                                     state: 'pending', note: '' },
        { id: 'deadline',    label: '等截止 + 投票',                                  state: 'pending', note: '' },
        { id: 'settle',      label: '结算',                                           state: 'pending', note: '' },
      ];
    },

    startStatusPoll() {
      if (this.pollHandle) clearInterval(this.pollHandle);
      const poll = async () => {
        try {
          const r = await fetch('/api/pool/market/' + this.result.market_id);
          const j = await r.json();
          if (j.ok && j.market) this.updateTimeline(j);
        } catch (e) { /* transient */ }
      };
      poll();
      // smart poll: 可见 + active 时 5s, hidden tab 时 30s
      const interval = document.hidden ? 30_000 : 5_000;
      this.pollHandle = setInterval(poll, interval);
      document.addEventListener('visibilitychange', () => {
        if (this.pollHandle) clearInterval(this.pollHandle);
        this.pollHandle = setInterval(poll, document.hidden ? 30_000 : 5_000);
      });
    },

    updateTimeline(data) {
      const m = data.market;
      const status = data.protocol_status || m.status;
      const oracleDeposited = data.oracle_deposits_count || 0;
      // KANet-UI 2026-06-07 P1-#1 (Bettor r324 校准): 委员数动态取本市场, 非硬码 3 或 5
      // 来源优先: audit.committee.members.length > committee_pks length > oracle_relay_ids length > 5 fallback
      let total = 5;
      try {
        if (Array.isArray(data.audit?.committee?.members) && data.audit.committee.members.length) total = data.audit.committee.members.length;
        else if (Array.isArray(m?.committee_pks) && m.committee_pks.length) total = m.committee_pks.length;
        else if (m?.committee_pks && typeof m.committee_pks === 'string') {
          try { const arr = JSON.parse(m.committee_pks); if (Array.isArray(arr) && arr.length) total = arr.length; } catch {}
        }
        else if (m?.oracle_relay_ids) {
          try { const arr = JSON.parse(m.oracle_relay_ids); if (Array.isArray(arr) && arr.length) total = arr.length; } catch {}
        }
      } catch {}
      const set = (id, state, note) => {
        const t = this.timeline.find(x => x.id === id);
        if (t) { t.state = state; if (note !== undefined) t.note = note; }
      };
      // upgrade timeline based on backend state
      if (status === 'pending_oracle_sampling' || status === 'pending_oracle_deposits' || status === 'pending_bettors' || status === 'verifying' || status === 'collecting_sigs' || status === 'completed' || status === 'refunded') {
        set('mined', 'done', '');
      }
      if (status === 'pending_oracle_deposits' || status === 'pending_bettors' || status === 'verifying' || status === 'collecting_sigs' || status === 'completed' || status === 'refunded') {
        set('sampling', 'done', '');
        set('oracle_deps', 'active', oracleDeposited + '/' + total);
      }
      if (status === 'pending_bettors' || status === 'verifying' || status === 'collecting_sigs' || status === 'completed' || status === 'refunded') {
        set('oracle_deps', 'done', total + '/' + total);
        set('deadline', 'active', '');
      }
      if (status === 'verifying' || status === 'collecting_sigs' || status === 'completed' || status === 'refunded') {
        set('deadline', 'done', '');
        set('settle', 'active', status);
      }
      if (status === 'completed' || status === 'refunded') {
        set('settle', 'done', status);
        if (this.pollHandle) { clearInterval(this.pollHandle); this.pollHandle = null; }
      }
    },

    resetForm() {
      this.shipped = false;
      this.result = null;
      this.submitError = '';
      this.llmResult = null;
      this.acceptedDisclaimer = false;
      this.form.title = '';
      this.form.outcome_side = '';
      this.form.resolution_rule_spec = '';
      this.touched = { title: false, deadline: false, rule: false, outcome_side: false };
      this.form.polymarketCondition = null;
      this.searchQuery = '';
      this.searchResults = null;
      this.setDefaultDeadline();
      if (this.pollHandle) { clearInterval(this.pollHandle); this.pollHandle = null; }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

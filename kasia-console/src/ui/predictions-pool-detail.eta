<%~ include('partials/page-open', { _page: 'predictions-pool-detail', pageTitle: '市场详情', ...it }) %>

<!-- KANet Oracle UI piece 1+2 (Bettor r128/r129) — pool market detail
     piece 1: live 投票进度 (未结算) · piece 2: settle 结果透明 (已结算)
     数据: /api/pool/market/:id + /api/oracle/markets/:id/audit
     NOTE: page-open partial 加载 Alpine.js + layout (= Bettor r130 实测抓漏 → 必加).
     所有逻辑在 script 块 (= 避免 eta 把 JS 当模板). eta tag 内仅 it.marketId 注入. -->
<div x-data="poolDetailPage('<%= it.marketId %>')" x-init="init()" class="max-w-3xl mx-auto px-4 py-6 font-body text-ink-700">

  <!-- back link -->
  <a href="/oracle" class="text-xs text-ink-400 hover:text-ink-600">&larr; Oracle 信任系统</a>

  <!-- loading -->
  <div x-show="loading" class="text-center py-16 text-ink-400">加载市场详情...</div>

  <!-- not found -->
  <div x-show="!loading && !market" class="text-center py-16">
    <div class="text-3xl mb-3">🔍</div>
    <p class="text-ink-500">市场不存在</p>
    <p class="text-[11px] text-ink-400 font-mono mt-1" x-text="marketId"></p>
  </div>

  <div x-show="!loading && market">
    <!-- header -->
    <div class="mb-5">
      <h1 class="text-xl font-display text-ink-800" x-text="marketLabel()"></h1>
      <div class="text-[11px] text-ink-400 font-mono mt-1" x-text="marketId"></div>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="text-[11px] px-2 py-0.5 rounded font-medium" :class="statusBadgeClass()" x-text="statusLabel()"></span>
        <span class="text-[11px] px-2 py-0.5 rounded font-medium" :class="mappingBadge().cls" x-text="mappingBadge().label"></span>
        <span class="text-[11px] text-ink-400" x-text="'deadline ' + (market?.deadline || '?')"></span>
      </div>
    </div>

    <!-- state machine viz -->
    <div class="flex items-center gap-1 mb-4 text-[10px]">
      <template x-for="(st, i) in stateMachine" :key="st.key">
        <div class="flex items-center gap-1">
          <div class="px-2 py-1 rounded"
               :class="stateReached(st.key) ? 'bg-emerald-100 text-emerald-700 font-medium' : 'bg-warm-100 text-ink-400'"
               x-text="st.label"></div>
          <span x-show="i < stateMachine.length - 1" class="text-ink-300">&rarr;</span>
        </div>
      </template>
    </div>

    <!-- KANet-UI 2026-06-07 P0-#4 UX 实时进度 (Bettor r291b 关1 PASS):
         chain_events 时间线 — 每步带时间 + TX explorer link + 大白话 hint.
         数据源: /api/pool/market/:id/events 拉 chain_events ASC.
         event_type 名 (NWT r335 实测): pool_oracle_vote / pool_oracle_tx_sig /
         pool_settle_consensual_dispatched / pool_oracle_deposit / pool_oracle_refund_disagreement_tx_sig. -->
    <div class="card p-4 mb-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm font-medium text-ink-700">链上进度</span>
        <span class="text-[10px] text-ink-400" x-text="events.length + ' 条记录'"></span>
      </div>
      <div x-show="events.length === 0" class="text-[11px] text-ink-400 py-2 text-center" x-text="currentStageHint()"></div>
      <div x-show="events.length > 0" class="space-y-1.5">
        <template x-for="(ev, i) in events" :key="ev.id">
          <div class="flex items-center gap-2 text-xs bg-warm-50 rounded px-3 py-2">
            <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-medium flex-shrink-0" x-text="i+1"></div>
            <div class="flex-1 min-w-0">
              <div class="text-ink-700 font-medium" x-text="eventLabel(ev.event_type)"></div>
              <div class="text-[10px] text-ink-400" x-text="formatEventTime(ev.observed_at)"></div>
            </div>
            <a :href="explorerTxUrl(ev.txid)" target="_blank" class="text-brand-500 hover:text-brand-700 text-[11px] flex-shrink-0" :title="ev.txid">🔗 TX</a>
          </div>
        </template>
      </div>
      <div x-show="!isSettled()" class="mt-3 text-[11px] text-ink-500 bg-amber-50 rounded px-3 py-2" x-text="currentStageHint()"></div>
    </div>

    <!-- KANet-UI 2026-06-07 P0-#2 (Bettor r319 关 1 PASS): web 押注 panel — 折叠默认收 -->
    <div id="bet" x-show="canBet()" class="card p-4 mb-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium text-ink-700">我要押</div>
          <div class="text-[11px] text-ink-400 mt-0.5">从你自家 agent 锁 KAS 押注. 押对均分输家池.</div>
        </div>
        <button @click="bet.open = !bet.open" class="px-3 py-1.5 rounded bg-brand-500 hover:bg-brand-600 text-white text-xs font-medium">
          <span x-text="bet.open ? '收起 ↑' : '我要押 →'"></span>
        </button>
      </div>

      <div x-show="bet.open" x-transition class="mt-4 space-y-3">
        <!-- bettor agent 选 -->
        <div>
          <label class="block text-[11px] text-ink-500 mb-1">出押人 (你的 agent)</label>
          <select x-model="bet.bettorRelayId" class="w-full px-3 py-2 rounded border border-warm-300 bg-white text-sm">
            <option value="">选一个 agent</option>
            <template x-for="a in bet.agents" :key="a.id">
              <option :value="a.id" :disabled="isOracleAgent(a.id) || isMakerAgent(a.id)"
                      x-text="a.name + (isOracleAgent(a.id) ? ' (本市场仲裁人, 不可押)' : '') + (isMakerAgent(a.id) ? ' (本市场出单人, 已押)' : '')"></option>
            </template>
          </select>
        </div>

        <!-- YES / NO -->
        <div>
          <label class="block text-[11px] text-ink-500 mb-1">押哪边</label>
          <div class="grid grid-cols-2 gap-2">
            <button @click="bet.direction = 0"
                    class="py-2 rounded border-2 transition font-medium"
                    :class="bet.direction === 0 ? 'bg-emerald-100 text-emerald-700 border-emerald-300' : 'border-warm-300 text-ink-500 hover:bg-warm-100'">YES</button>
            <button @click="bet.direction = 1"
                    class="py-2 rounded border-2 transition font-medium"
                    :class="bet.direction === 1 ? 'bg-red-100 text-red-700 border-red-300' : 'border-warm-300 text-ink-500 hover:bg-warm-100'">NO</button>
          </div>
        </div>

        <!-- stake KAS -->
        <div>
          <label class="block text-[11px] text-ink-500 mb-1">押多少 KAS</label>
          <input type="number" x-model.number="bet.stakeKas" min="1" step="0.1"
                 placeholder="例: 100"
                 class="w-full px-3 py-2 rounded border border-warm-300 text-sm" />
          <div class="text-[10px] text-ink-400 mt-1">最低 1 KAS · testnet 币零经济价值</div>
        </div>

        <!-- 提交 -->
        <button @click="submitBet()" :disabled="!canSubmitBet() || bet.submitting"
                class="w-full py-2.5 rounded font-medium text-sm transition"
                :class="canSubmitBet() && !bet.submitting ? 'bg-brand-500 hover:bg-brand-600 text-white' : 'bg-warm-200 text-ink-400 cursor-not-allowed'">
          <span x-text="bet.submitting ? '锁押金中...' : lockButtonLabel()"></span>
        </button>

        <!-- 成功 -->
        <div x-show="bet.txResult" class="bg-emerald-50 rounded p-3 text-xs">
          <div class="font-medium text-emerald-700">✓ 已锁 <span x-text="bet.stakeKas"></span> KAS 押 <span x-text="bet.direction === 0 ? 'YES' : 'NO'"></span></div>
          <div class="mt-1 text-ink-500">side_lock TX:</div>
          <a x-show="bet.txResult?.side_lock_tx" :href="explorerTxUrl(bet.txResult.side_lock_tx)" target="_blank"
             class="font-mono text-[10px] text-brand-500 hover:underline break-all" x-text="bet.txResult?.side_lock_tx"></a>
        </div>

        <!-- 失败 -->
        <div x-show="bet.error" class="bg-red-50 text-red-700 rounded p-3 text-xs" x-text="bet.error"></div>
      </div>
    </div>

    <!-- ===== UMA finalization 状态 (Phase 1 Sub6, Bettor r156 option A) — protocol_status 驱动 ===== -->
    <div x-show="umaFinalizationStatus()" class="mb-4 rounded-lg px-4 py-3 border text-xs font-medium"
         :class="umaFinalizationStatus()?.cls" x-text="umaFinalizationStatus()?.label"></div>

    <!-- ===== piece 1: live 投票进度 (未结算) ===== -->
    <div x-show="!isSettled()" class="card p-4 mb-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm font-medium text-ink-700">仲裁人投票进度</span>
        <span class="text-xs text-ink-500" x-text="votedCount() + ' / ' + oracleList.length + ' 已投'"></span>
      </div>
      <!-- progress bar -->
      <div class="w-full bg-warm-100 rounded-full h-2 mb-4">
        <div class="bg-brand-500 h-2 rounded-full transition-all"
             :style="'width: ' + (oracleList.length ? Math.round(votedCount()/oracleList.length*100) : 0) + '%'"></div>
      </div>
      <!-- 空态 -->
      <div x-show="oracleList.length === 0" class="text-[11px] text-ink-400 py-2 text-center">
        暂无预言机分配 (= 等 maker publish + oracle deposit)
      </div>
      <!-- oracle list + each vote -->
      <div class="space-y-1.5">
        <template x-for="o in oracleList" :key="o.relay_id">
          <div class="flex items-center gap-2 text-xs bg-warm-50 rounded px-3 py-2">
            <div class="w-2 h-2 rounded-full flex-shrink-0" :class="o.voted ? 'bg-emerald-500' : 'bg-warm-300'"></div>
            <span class="font-mono text-ink-500 flex-1 truncate" x-text="o.relay_id.slice(0, 16)"></span>
            <span x-show="o.voted" class="px-1.5 py-0.5 rounded font-medium"
                  :class="o.vote === 'YES' ? 'bg-emerald-100 text-emerald-700' : (o.vote === 'NO' ? 'bg-red-100 text-red-700' : 'bg-warm-200 text-ink-500')"
                  x-text="o.vote"></span>
            <span x-show="!o.voted" class="text-ink-400">等待中</span>
          </div>
        </template>
      </div>
    </div>

    <!-- ===== piece 2: settle 结果透明 (已结算) ===== -->
    <div x-show="isSettled()" class="card p-4 mb-4">
      <div class="text-sm font-medium text-ink-700 mb-3">结算结果</div>
      <!-- winner -->
      <div class="bg-emerald-50 rounded-lg p-3 mb-4 text-center">
        <div class="text-[11px] text-ink-500 mb-1">最终判定 (= 5 oracle 共识)</div>
        <div class="text-2xl font-display text-emerald-700" x-text="consensusOutcome() || '—'"></div>
      </div>
      <!-- 5 oracle 各投啥 -->
      <div class="text-[11px] text-ink-500 mb-2">各仲裁人投票 (= 验证凭什么判这方赢)</div>
      <div class="space-y-1.5 mb-4">
        <template x-for="h in auditHistory" :key="h.id">
          <div class="flex items-center gap-2 text-xs bg-warm-50 rounded px-3 py-2">
            <span class="font-mono text-ink-500 flex-1 truncate" x-text="(h.oracle_relay_id || '').slice(0, 16)"></span>
            <span class="px-1.5 py-0.5 rounded font-medium"
                  :class="h.vote === h.consensus_outcome ? 'bg-emerald-100 text-emerald-700' : (h.vote === 'silent' ? 'bg-warm-200 text-ink-500' : 'bg-red-100 text-red-700')"
                  x-text="h.vote || '—'"></span>
            <span x-show="h.reward_amount > 0" class="text-emerald-600 text-[11px]" x-text="'+' + (h.reward_amount || 0).toFixed(1)"></span>
            <span x-show="h.slashed_amount > 0" class="text-red-600 text-[11px]" x-text="'-' + (h.slashed_amount || 0).toFixed(1)"></span>
          </div>
        </template>
      </div>
      <!-- 空态 -->
      <div x-show="auditHistory.length === 0" class="text-[11px] text-ink-400 py-2 text-center">
        暂无投票记录
      </div>
      <!-- payout TX explorer link -->
      <div x-show="market?.settle_txid" class="mt-3">
        <a :href="explorerTxUrl(market?.settle_txid)" target="_blank"
           class="block text-center bg-brand-500 hover:bg-brand-600 text-white rounded-lg py-2 text-xs font-medium">
          🔗 结算 TX (Kaspa explorer)
        </a>
        <div class="text-[10px] text-ink-400 font-mono break-all mt-1 text-center" x-text="market?.settle_txid"></div>
      </div>
    </div>

    <!-- ===== piece 3 (v0.7+): 三方分账证据链 (= 用户可验机制公正) ===== -->
    <div x-show="audit && (audit.committee || (audit.bettor_sides||[]).length)" class="card p-4 mb-4">
      <div class="text-sm font-medium text-ink-700 mb-1">证据链 · 全程可审计</div>
      <div class="text-[11px] text-ink-400 mb-3">每段都是链上真 TX, 点 🔗 看 explorer 验。</div>

      <!-- maker 发市场 (KANet-UI 2026-06-07 r308: 加 maker_name 主显, address 退次) -->
      <div x-show="audit?.maker" class="mb-3">
        <div class="text-[11px] text-ink-500 mb-1">① 主持人 (出市场+赌池本金)</div>
        <div class="bg-warm-50 rounded px-3 py-2 text-xs flex items-center gap-2">
          <span class="text-ink-700 font-medium flex-shrink-0" x-text="makerLabel()"></span>
          <span class="text-ink-400 font-mono text-[10px] truncate flex-1" x-text="(audit.maker?.address || '').slice(0, 18) + '…'"></span>
          <span class="text-ink-600" x-text="(audit.maker?.stake_kas || 0) + ' KAS'"></span>
          <a x-show="audit.maker?.explorer_url" :href="audit.maker.explorer_url" target="_blank" class="text-brand-500">🔗</a>
        </div>
      </div>

      <!-- bettor sides -->
      <div x-show="(audit?.bettor_sides||[]).length" class="mb-3">
        <div class="text-[11px] text-ink-500 mb-1">② 押注人 (各自独立锁仓 TX) · <span x-text="(audit?.bettor_sides||[]).length"></span> 笔</div>
        <div class="space-y-1">
          <template x-for="b in (audit?.bettor_sides||[])" :key="b.bettor_pk + b.side_lock_txid">
            <div class="bg-warm-50 rounded px-3 py-2 text-xs flex items-center gap-2">
              <span class="px-1.5 py-0.5 rounded font-medium text-[10px]"
                    :class="b.direction === 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'"
                    x-text="b.direction === 0 ? 'YES' : 'NO'"></span>
              <span class="text-ink-500 font-mono truncate flex-1" x-text="(b.bettor_pk || '').slice(0, 16) + '…'"></span>
              <span class="text-ink-600" x-text="(b.stake_kas || 0) + ' KAS'"></span>
              <a x-show="b.side_lock_explorer_url" :href="b.side_lock_explorer_url" target="_blank" class="text-brand-500" title="锁仓 TX">🔗</a>
              <a x-show="b.claim_explorer_url" :href="b.claim_explorer_url" target="_blank" class="text-emerald-600" title="领奖 TX">🏆</a>
            </div>
          </template>
        </div>
      </div>

      <!-- committee -->
      <div x-show="audit?.committee?.members?.length" class="mb-3">
        <div class="text-[11px] text-ink-500 mb-1">
          ③ 仲裁人 · 池子里随机抽 <span x-text="(audit?.committee?.members||[]).length"></span> 个 (阈值 <span x-text="audit?.committee?.threshold || '?'"></span>/<span x-text="(audit?.committee?.members||[]).length"></span>)
        </div>
        <div class="text-[10px] text-ink-400 mb-1">
          抽样时间: <span x-text="audit?.committee?.sampled_at || '?'"></span>
          · 抽样种子: <code class="font-mono" x-text="(audit?.committee?.vrf_seed || '').slice(0, 16) + '…'"></code>
        </div>
        <div class="space-y-1">
          <template x-for="m in (audit?.committee?.members||[])" :key="m.pk_x">
            <div class="bg-warm-50 rounded px-3 py-2 text-xs flex items-center gap-2">
              <span class="text-ink-500 font-mono truncate flex-1" x-text="(m.mapped?.relay_address || m.pk_x || '').slice(0, 24) + '…'"></span>
              <span class="text-ink-400 text-[10px]" x-text="m.mapped?.source || '?'"></span>
            </div>
          </template>
        </div>
      </div>

      <!-- settle TX outputs hint -->
      <div x-show="audit?.settle_txid" class="border-t border-warm-200 pt-3 mt-3">
        <div class="text-[11px] text-ink-500 mb-1">④ 结算 TX · 一笔分给 (赢家 + 仲裁人 + 主持人)</div>
        <a :href="audit.settle_explorer_url || explorerTxUrl(audit.settle_txid)" target="_blank"
           class="block bg-warm-50 hover:bg-warm-100 rounded px-3 py-2 text-xs text-ink-600">
          <div class="font-mono break-all">🔗 <span x-text="audit.settle_txid"></span></div>
          <div class="text-[10px] text-ink-400 mt-1">点开看 explorer 7 输出 (= broker 抽成 + N 个仲裁人报酬 + 赢家本金+池)</div>
        </a>
      </div>
    </div>

    <!-- market meta -->
    <div class="card p-4 text-[11px] text-ink-500 space-y-1">
      <div class="flex justify-between"><span>maker stake</span><span x-text="(market?.maker_stake_amount || '?') + ' KAS'"></span></div>
      <div class="flex justify-between"><span>oracle bond (each)</span><span x-text="(market?.oracle_bond_amount || '?') + ' KAS'"></span></div>
      <div class="flex justify-between"><span>bettor 数</span><span x-text="bettorCount"></span></div>
      <div class="flex justify-between"><span>sigs collected</span><span x-text="sigsCollected"></span></div>
    </div>
  </div>

</div>

<script>
function poolDetailPage(marketId) {
  return {
    marketId: marketId,
    loading: true,
    market: null,
    bettorCount: 0,
    sigsCollected: 0,
    oracleList: [],
    auditHistory: [],
    events: [],             // KANet-UI 2026-06-07 P0-#4: chain_events 时间线 (ORDER ASC)
    // KANet-UI 2026-06-07 P0-#2 (Bettor r319 关 1 PASS): web 押注 panel state
    bet: {
      open: false,
      agents: [],
      bettorRelayId: '',
      direction: null,      // 0=YES, 1=NO
      stakeKas: 100,
      submitting: false,
      txResult: null,
      error: '',
    },
    mapping: null,          // condition_id_mapping row (mirror_only / independent_source) OR null=未映射
    audit: null,            // /api/pool/market/:id/settle-audit (= 证据链 v0.7 全链路, KANet-UI #12 P0.1)
    explorerBase: 'https://explorer-tn12.kaspa.org',   // fallback, audit.explorer_base overrides
    // KANet-UI 2026-06-07 P1-#5 (Bettor r325 关 1 PASS + 一致性): 全'仲裁人'贯穿 (与 P0-#4 hint/eventLabel 一致)
    stateMachine: [
      { key: 'pending_oracle_deposits', label: '等仲裁人接单' },
      { key: 'pending_bettors', label: '等用户押注' },
      { key: 'verifying', label: '等仲裁人投票' },
      { key: 'collecting_sigs', label: '收仲裁人签名' },
      { key: 'completed', label: '已结算' },
    ],

    async init() {
      await this.load();
      // KANet-UI 2026-06-07 P0-#2: 加载自家 agent list (= 同 create form 模式)
      try {
        const agResp = await fetch('/api/agent/profile').then(r => r.json()).catch(() => ({}));
        this.bet.agents = (agResp.agents || agResp || []).filter(a => !a.is_dex_broker);
      } catch {}
      // 详情页 #bet 锚跳: /predictions 行点'押 →' 跳进来自动展开
      if (window.location.hash === '#bet') {
        this.bet.open = true;
        this.$nextTick(() => document.getElementById('bet')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      }
    },

    async load() {
      this.loading = true;
      try {
        const [mR, aR, sR, evR] = await Promise.all([
          fetch('/api/pool/market/' + encodeURIComponent(this.marketId)),
          fetch('/api/oracle/markets/' + encodeURIComponent(this.marketId) + '/audit'),
          fetch('/api/pool/market/' + encodeURIComponent(this.marketId) + '/settle-audit'),
          fetch('/api/pool/market/' + encodeURIComponent(this.marketId) + '/events'),  // KANet-UI 2026-06-07 P0-#4
        ]);
        const mJ = await mR.json();
        const aJ = await aR.json();
        const sJ = await sR.json();
        const evJ = await evR.json().catch(() => ({ ok: false }));
        this.events = (evJ.ok && Array.isArray(evJ.events)) ? evJ.events : [];
        if (mJ.ok) {
          this.market = mJ.market;
          this.bettorCount = mJ.bettor_count || 0;
          this.sigsCollected = mJ.sigs_collected || 0;
        }
        this.auditHistory = (aJ.ok ? aJ.history : []) || [];
        if (sJ && sJ.ok) {
          this.audit = sJ;
          if (sJ.explorer_base) this.explorerBase = sJ.explorer_base;
        }
        this.buildOracleList();
        await this.loadMapping();
      } catch (e) {
        console.warn('pool detail load fail', e);
      }
      this.loading = false;
    },

    explorerTxUrl(txid) {
      return txid ? (this.explorerBase + '/txs/' + txid) : '#';
    },

    // KANet-UI 2026-06-07 P0-#4: chain_events 大白话 label (NWT r335 实测 event_type).
    // KANet-UI 2026-06-07 P0-#2 (Bettor r319): web 押注 helpers
    canBet() {
      // 仅 pending_bettors 阶段 + deadline 未过 (= 5min buffer 防截止前抢押)
      const st = this.market?.protocol_status;
      if (st !== 'pending_bettors') return false;
      const dl = Number(this.market?.deadline || 0);
      if (dl && dl * 1000 < Date.now() + 5 * 60_000) return false;
      return true;
    },
    isOracleAgent(agentId) {
      // Bettor r319 ② 校准: 用本市场 oracle_relay_ids 集 (= pool_markets.oracle_relay_ids JSON 列), 非全局 registry
      try {
        const ids = JSON.parse(this.market?.oracle_relay_ids || '[]');
        return Array.isArray(ids) && ids.includes(agentId);
      } catch { return false; }
    },
    isMakerAgent(agentId) {
      return this.market?.maker_relay_id === agentId;
    },
    canSubmitBet() {
      return this.bet.bettorRelayId
        && this.bet.direction !== null
        && Number(this.bet.stakeKas) >= 1
        && !this.isOracleAgent(this.bet.bettorRelayId)
        && !this.isMakerAgent(this.bet.bettorRelayId);
    },
    lockButtonLabel() {
      // Bettor r319 ① 校准: '锁押金'按钮写清'从 [agent X] 锁 N KAS' 防误点
      if (!this.canSubmitBet()) return '锁押金';
      const a = (this.bet.agents || []).find(x => x.id === this.bet.bettorRelayId);
      const name = a?.name || '?';
      const side = this.bet.direction === 0 ? 'YES' : 'NO';
      return `从 ${name} 锁 ${this.bet.stakeKas} KAS 押 ${side}`;
    },
    async submitBet() {
      if (!this.canSubmitBet()) return;
      this.bet.submitting = true;
      this.bet.error = '';
      this.bet.txResult = null;
      try {
        const r = await fetch(`/api/pool/market/${encodeURIComponent(this.marketId)}/bettor/register`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            bettor_relay_id: this.bet.bettorRelayId,
            direction: this.bet.direction,
            stake_kas: String(this.bet.stakeKas),
          }),
        });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || `HTTP ${r.status}`);
        this.bet.txResult = j;
        // 押后自动 reload market + events 看进度
        setTimeout(() => this.load(), 1500);
      } catch (e) {
        this.bet.error = String(e.message || e);
      }
      this.bet.submitting = false;
    },
    // KANet-UI 2026-06-07 r308: maker_name 主持人显. 跨节点 fallback 短 id.
    makerLabel() {
      if (this.market?.maker_name) return this.market.maker_name;
      if (this.market?.maker_relay_id) return '跨节点 ' + String(this.market.maker_relay_id).slice(0, 8);
      return '?';
    },
    eventLabel(t) {
      // KANet-UI 2026-06-07 P1-#5 (Bettor r325): '委员' → '仲裁人' 贯穿
      const map = {
        pool_oracle_deposit: '仲裁人入金',
        pool_oracle_vote: '仲裁人投票',
        pool_oracle_tx_sig: '仲裁人签名',
        pool_settle_consensual_dispatched: '结算分发 (赢家+仲裁人+主持人)',
        pool_oracle_refund_disagreement_tx_sig: '争议退款签名',
        pool_settle_silent_detected: '侦测静默仲裁人',
        pool_refund_request: '申请退款',
        pool_market_published: '市场上链',
      };
      return map[t] || t || '?';
    },
    formatEventTime(ts) {
      if (!ts) return '?';
      try { return new Date(ts).toLocaleString('zh-CN', { hour12: false }); }
      catch { return ts; }
    },
    // 当前阶段大白话提示 (= 用户不见 jargon)
    currentStageHint() {
      const st = this.market?.protocol_status;
      const total = (this.audit?.committee?.members || []).length || 5;
      const voted = this.votedCount?.() ?? 0;
      const sigs = this.sigsCollected || 0;
      if (!st) return '加载中...';
      // KANet-UI 2026-06-07 P1-#5 (Bettor r325): '委员' → '仲裁人' 贯穿
      if (st === 'pending_oracle_deposits') return '等仲裁人接单 (= 仲裁人押 bond 接单).';
      if (st === 'pending_oracle_sampling' || st === 'pending_oracle_sample') return '抽仲裁人中 (约 10 秒).';
      if (st === 'pending_bettors') return '等用户押注 (= 截止前任何人可押 YES/NO).';
      if (st === 'verifying') return `等仲裁人投票 (${voted}/${total} 已投).`;
      if (st === 'collecting_sigs') return `等仲裁人签名 (${sigs}/${total} 已签).`;
      if (st === 'completed') return '已结算. 链上 TX 见上面 🔗.';
      if (st === 'refunded' || st === 'cancelled') return '已退款.';
      return st;
    },

    // condition_id_mapping lookup (J2 Sub1 endpoint) — 404 = 未映射 (graceful)
    async loadMapping() {
      this.mapping = null;
      const cond = this.market && this.market.outcome_condition_id;
      if (!cond) return;
      try {
        const r = await fetch('/api/oracle/mapping/' + encodeURIComponent(cond));
        if (r.ok) {
          const j = await r.json();
          this.mapping = j.ok ? j.mapping : null;
        }
      } catch (e) {
        this.mapping = null;
      }
    },

    // v0.5/v0.6: oracle_relay_ids (legacy 3 oracle). v0.7+: committee_pks (= settle-audit.committee.members PK 列表).
    buildOracleList() {
      var ids = [];
      var voteByKey = {};
      this.auditHistory.forEach(function(h){
        // 既 key by relay_id (legacy) 又 key by voter_pubkey (v0.7), 兼容两路.
        if (h.oracle_relay_id) voteByKey[h.oracle_relay_id] = h.vote;
        if (h.voter_pubkey) voteByKey[h.voter_pubkey] = h.vote;
      });
      // v0.7 优先 audit.committee.members (= 池抽样实委员, 链派生).
      if (this.audit && this.audit.committee && Array.isArray(this.audit.committee.members) && this.audit.committee.members.length) {
        this.oracleList = this.audit.committee.members.map(function(m){
          var key = m.pk_x;
          var label = (m.mapped && m.mapped.relay_address) ? m.mapped.relay_address : m.pk_x;
          var vote = voteByKey[m.pk_x] || null;
          return { relay_id: label, voted: vote != null, vote: vote };
        });
        return;
      }
      // v0.5/v0.6 legacy path.
      if (this.market && this.market.oracle_relay_ids) {
        try {
          var parsed = JSON.parse(this.market.oracle_relay_ids);
          if (Array.isArray(parsed)) ids = parsed;
        } catch (e) {
          ids = String(this.market.oracle_relay_ids).split(',').map(function(s){ return s.trim(); }).filter(Boolean);
        }
      }
      this.oracleList = ids.map(function(id){
        return { relay_id: id, voted: voteByKey[id] != null, vote: voteByKey[id] || null };
      });
    },

    isSettled() {
      return this.market && (this.market.protocol_status === 'completed' || this.market.settle_txid);
    },
    votedCount() {
      return this.oracleList.filter(function(o){ return o.voted; }).length;
    },
    consensusOutcome() {
      var h = this.auditHistory.find(function(x){ return x.consensus_outcome; });
      return h ? h.consensus_outcome : null;
    },
    // ---- mirror_only / 并行判定 badge (Phase 1 Sub6) ----
    mappingBadge() {
      if (!this.mapping) return { label: '未映射 UMA', cls: 'bg-warm-200 text-ink-500' };
      if (this.mapping.mirror_only === 1) {
        return { label: '🪞 镜像 UMA · 钱跟 UMA 不并行打分', cls: 'bg-sky-100 text-sky-700' };
      }
      var src = this.mapping.independent_source || '独立源';
      return { label: '⚖ 真并行判定 · 源 ' + src, cls: 'bg-emerald-100 text-emerald-700' };
    },
    // ---- UMA finalization 状态 (Phase 1 Sub6, Bettor r156 option A) ----
    // protocol_status-driven (not precise countdown): voter only votes (→ verifying) after the
    // 48h UMA gate passes, so verifying+ = 已最终化. polymarket-sourced only.
    umaFinalizationStatus() {
      if (!this.market || this.market.outcome_market_source !== 'polymarket') return null;
      var s = this.market.protocol_status;
      if (['verifying', 'collecting_sigs', 'completed'].includes(s)) {
        return { label: '✅ UMA 已最终化 · 验证已通过', cls: 'bg-emerald-50 border-emerald-200 text-emerald-700' };
      }
      if (['refunded'].includes(s)) return null;
      return { label: '⏳ 待验证 · 验证时校验 UMA 48h 最终化', cls: 'bg-amber-50 border-amber-200 text-amber-700' };
    },
    marketLabel() {
      if (!this.market) return '';
      var src = this.market.outcome_market_source || 'market';
      var cond = (this.market.outcome_condition_id || '').slice(0, 40);
      return src + ' / ' + cond;
    },
    statusLabel() {
      return this.market ? (this.market.protocol_status || 'unknown') : '';
    },
    statusBadgeClass() {
      var s = this.market ? this.market.protocol_status : '';
      if (s === 'completed') return 'bg-emerald-100 text-emerald-700';
      if (s === 'collecting_sigs' || s === 'verifying') return 'bg-amber-100 text-amber-700';
      return 'bg-warm-200 text-ink-600';
    },
    stateReached(key) {
      var order = ['pending_oracle_deposits', 'pending_bettors', 'verifying', 'collecting_sigs', 'completed'];
      var cur = this.market ? this.market.protocol_status : '';
      // map aliases / terminal variants to the canonical viz step
      var aliasMap = { matched: 'verifying', settled: 'completed', refunded: 'completed', disputed: 'collecting_sigs', active: 'pending_bettors' };
      if (aliasMap[cur]) cur = aliasMap[cur];
      var curIdx = order.indexOf(cur);
      var keyIdx = order.indexOf(key);
      return curIdx >= 0 && keyIdx <= curIdx;
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

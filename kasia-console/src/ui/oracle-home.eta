<%~ include('partials/page-open', { _page: 'oracle', pageTitle: 'Oracle', ...it }) %>

<!--
  Oracle 系统 UI — Owner 钦定 ② 独立 oracle 系统 cohesive UI (v0.6 path A 经济安全展示).
  Bettor r33 scope: 2 tab 设计
    [信任系统] (default, view 2, bettor 视角, 批 1 优先 = b 池透明 + c 每市场信任 + g onboarding)
    [我的 oracle] (view 1, operator 视角, 批 2, 5 块 role-home 模板)
  数据源:
    - /api/oracles (relay_nodes is_oracle=1 list) = b 池透明聚合源
    - /api/pool/markets ?status= & per-market /api/pool/market/:id/v06-settle-decode = c 每市场信任
    - /api/relay/:id/pubkey, /api/oracle/income/:pk, /api/oracle/max-pot/:pk = view 1 operator
-->

<style>
  .rh-display { font-family: 'Fraunces', Georgia, serif; font-feature-settings: 'opsz' 36; }
  .rh-block { @apply bg-white rounded-lg border border-warm-200 p-5; }
  .rh-block-title { @apply text-[10px] uppercase tracking-wider text-ink-400 mb-3 flex items-center gap-1.5; }
  .rh-block-dot { @apply w-1.5 h-1.5 rounded-full; }
  .rh-stat-label { @apply text-[10px] uppercase tracking-wider text-ink-400; }
  .rh-stat-value { @apply text-lg font-semibold text-ink-700 tabular-nums; }
  .rh-tab { @apply px-4 py-2 text-sm font-medium border-b-2 cursor-pointer transition-colors; }
  .rh-tab-active { @apply border-brand-500 text-brand-600; }
  .rh-tab-inactive { @apply border-transparent text-ink-400 hover:text-ink-600; }
  .rh-pill { @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium; }
  .rh-pill-good { @apply bg-green-50 text-green-700 border border-green-200; }
  .rh-pill-warn { @apply bg-amber-50 text-amber-700 border border-amber-200; }
  .rh-pill-mute { @apply bg-warm-50 text-ink-500 border border-warm-200; }
</style>

<div class="p-6" x-data="oracleHome()" x-cloak>

  <!-- TAB NAV -->
  <div class="flex items-end gap-1 border-b border-warm-200 mb-5">
    <div class="rh-tab" :class="tab === 'trust' ? 'rh-tab-active' : 'rh-tab-inactive'" @click="switchTab('trust')">
      <span class="mr-1">信任系统</span><span class="text-[10px] text-ink-300">bettor 视角</span>
    </div>
    <div class="rh-tab" :class="tab === 'mine' ? 'rh-tab-active' : 'rh-tab-inactive'" @click="switchTab('mine')">
      <span class="mr-1">我的 oracle</span><span class="text-[10px] text-ink-300">operator</span>
    </div>
    <div class="flex-1"></div>
    <div class="text-[10px] text-ink-300 pb-2">v0.6 path A · 5 sig · t=4-of-5 · VRF stake-weighted</div>
  </div>

  <!-- ════════════════ TAB 1: 信任系统 (默认, bettor 视角) ════════════════ -->
  <div x-show="tab === 'trust'" class="space-y-5">

    <!-- ① 池透明 (= b panel) -->
    <div class="rh-block">
      <div class="rh-block-title"><span class="rh-block-dot bg-brand-500"></span>① 池透明 · oracle 池总览</div>
      <div x-show="trustLoading" class="text-xs text-ink-300 py-2">加载中...</div>
      <template x-if="!trustLoading && pool">
        <div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
            <div>
              <div class="rh-stat-label">池中 oracle 数</div>
              <div class="rh-stat-value rh-display" x-text="pool.count"></div>
              <div class="text-[10px] text-ink-400 mt-0.5">is_oracle=1 注册可被抽签</div>
            </div>
            <div>
              <div class="rh-stat-label">总锁仓 KAS</div>
              <div class="rh-stat-value rh-display" x-text="fmtKas(pool.totalStake)"></div>
              <div class="text-[10px] text-ink-400 mt-0.5">stake_locked_kas sum</div>
            </div>
            <div>
              <div class="rh-stat-label">前 5 集中度</div>
              <div class="rh-stat-value rh-display" :class="pool.top5Pct > 60 ? 'text-amber-700' : ''" x-text="pool.top5Pct.toFixed(1) + '%'"></div>
              <div class="text-[10px] text-ink-400 mt-0.5">越低 = 越分散 = 越抗共谋</div>
            </div>
            <div>
              <div class="rh-stat-label">无违规率</div>
              <div class="rh-stat-value rh-display text-green-700" x-text="pool.cleanPct.toFixed(1) + '%'"></div>
              <div class="text-[10px] text-ink-400 mt-0.5">voter_misbehave_count = 0 占比</div>
            </div>
          </div>
          <div class="mt-3">
            <div class="text-[10px] uppercase tracking-wider text-ink-400 mb-2">stake 分布 (top 10)</div>
            <div class="space-y-1">
              <template x-for="(o, i) in pool.top10" :key="o.id">
                <div class="flex items-center gap-2 text-xs">
                  <div class="w-5 text-ink-300 text-[10px]" x-text="'#' + (i+1)"></div>
                  <div class="w-40 truncate text-ink-600" :title="o.name" x-text="o.name || '—'"></div>
                  <div class="flex-1 bg-warm-100 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-brand-400 h-full" :style="`width:${pool.totalStake > 0 ? ((o.oracle_stake_locked_kas || 0) / pool.totalStake * 100) : 0}%`"></div>
                  </div>
                  <div class="w-24 text-right tabular-nums text-ink-600" x-text="fmtKas(o.oracle_stake_locked_kas) + ' KAS'"></div>
                  <div class="w-12 text-right tabular-nums text-ink-400" x-text="pool.totalStake > 0 ? ((o.oracle_stake_locked_kas || 0) / pool.totalStake * 100).toFixed(1) + '%' : '—'"></div>
                  <div class="w-10 text-right">
                    <span x-show="(o.voter_misbehave_count || 0) === 0" class="rh-pill rh-pill-good">OK</span>
                    <span x-show="(o.voter_misbehave_count || 0) > 0" class="rh-pill rh-pill-warn">⚠</span>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
      <div x-show="trustError" class="text-xs text-red-500 mt-2" x-text="trustError"></div>
    </div>

    <!-- ② 每市场信任读数 (= c panel) -->
    <div class="rh-block">
      <div class="rh-block-title"><span class="rh-block-dot bg-blue-500"></span>② 每市场信任读数 · v0.6 path A 池/委员会绑定</div>
      <div x-show="marketsLoading" class="text-xs text-ink-300 py-2">加载中...</div>
      <template x-if="!marketsLoading && markets.length === 0">
        <div class="text-xs text-ink-300 py-3">还没有 v0.6 池市场.</div>
      </template>
      <template x-if="!marketsLoading && markets.length > 0">
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead class="text-[10px] uppercase tracking-wider text-ink-400 border-b border-warm-200">
              <tr>
                <th class="text-left py-2 pr-3">market</th>
                <th class="text-left py-2 pr-3">状态</th>
                <th class="text-right py-2 pr-3">pool size</th>
                <th class="text-center py-2 pr-3">阈值</th>
                <th class="text-center py-2 pr-3">委员会</th>
                <th class="text-right py-2 pr-3">bond KAS</th>
                <th class="text-left py-2">链上证据</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="m in markets" :key="m.market.id">
                <tr class="border-b border-warm-100 last:border-0">
                  <td class="py-2 pr-3 font-mono text-ink-700 max-w-[160px] truncate" :title="m.market.id" x-text="m.market.id.slice(0,18) + '...'"></td>
                  <td class="py-2 pr-3">
                    <span class="rh-pill rh-pill-mute" x-text="m.market.protocol_status"></span>
                  </td>
                  <td class="py-2 pr-3 text-right tabular-nums text-ink-600" x-text="m.decode?.pool_size ?? '—'"></td>
                  <td class="py-2 pr-3 text-center text-ink-600" x-text="m.decode?.threshold_t_of_n || '4-of-5'"></td>
                  <td class="py-2 pr-3 text-center">
                    <span x-show="m.decode?.committee_pre_settle" class="rh-pill rh-pill-mute" title="VRF 抽签后,签名前匿名">🔒 匿名</span>
                    <span x-show="m.decode && !m.decode.committee_pre_settle && m.decode.committee_pks" class="rh-pill rh-pill-good" :title="(m.decode.committee_pks || []).map(p => p.slice(0,8)).join(', ')">✓ 已暴露 (5 PK)</span>
                    <span x-show="!m.decode" class="rh-pill rh-pill-warn">—</span>
                  </td>
                  <td class="py-2 pr-3 text-right tabular-nums text-ink-600" x-text="fmtKas((m.market.oracle_bond_amount || 0) / 1e8)"></td>
                  <td class="py-2">
                    <a x-show="m.decode?.settle_txid"
                       :href="`/event?txid=${m.decode.settle_txid}`"
                       class="font-mono text-[10px] text-brand-500 hover:text-brand-700"
                       :title="m.decode.settle_txid"
                       x-text="m.decode?.settle_txid ? (m.decode.settle_txid.slice(0,10) + '...') : '—'"></a>
                    <span x-show="!m.decode?.settle_txid" class="text-ink-300 text-[10px]">—</span>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </template>
    </div>

    <!-- ③ onboarding (= g panel) -->
    <div class="rh-block">
      <div class="rh-block-title"><span class="rh-block-dot bg-purple-500"></span>③ onboarding · 信任范式转换教学</div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 text-xs">
        <div>
          <div class="text-ink-700 font-semibold mb-1">为什么不用单一 oracle?</div>
          <div class="text-ink-500 leading-relaxed">
            单一 oracle = 单点信任 = 单点贿赂可破. v0.6 path A 用 5-of-N 委员会:
            VRF stake-weighted 随机抽 5 个 oracle, 投票前匿名 (防定向贿赂),
            t=4 阈值 (4 票即结算, 1 票偏离不阻塞). 共谋成本 = 同时贿赂 ≥4 个匿名委员.
          </div>
        </div>
        <div>
          <div class="text-ink-700 font-semibold mb-1">stake 怎么保护我?</div>
          <div class="text-ink-500 leading-relaxed">
            每个 oracle 都锁仓 KAS. 票偏离共识 ≥ slash 锁仓
            (bond × misbehave_count). 退出池需 ≥ 7 天延期, 跑路也罚得到.
            上表 ① 看池规模 + 集中度 + 无违规率 = 判断池健康度.
          </div>
        </div>
        <div>
          <div class="text-ink-700 font-semibold mb-1">每个市场怎么验?</div>
          <div class="text-ink-500 leading-relaxed">
            上表 ② 看每市场的 pool size + 阈值 + 委员会暴露状态 + 链上 settle TX.
            未结算时委员会 PK 隐藏 (匿名), 结算后 5 个 PK 公开 + 链上 TX 可独立验证 (≥4 sig 才能出钱).
            点 TX hash 链接看 explorer.
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-warm-100 text-[10px] text-ink-400">
        参考: Bettor r19 path A spec / Owner 钦定 ② cohesive oracle 系统 UI / v0.6 = path A 5 individual sig + position-aware merkle.
      </div>
    </div>

  </div>

  <!-- ════════════════ TAB 2: 我的 oracle (operator 视角) ════════════════ -->
  <div x-show="tab === 'mine'" class="space-y-5">

    <!-- LOADING SKELETON -->
    <div x-show="mineLoading" class="space-y-4">
      <div class="skeleton" style="width:200px;height:36px;border-radius:8px;"></div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="skeleton" style="height:140px;border-radius:8px;"></div>
        <div class="skeleton" style="height:140px;border-radius:8px;"></div>
      </div>
    </div>

    <!-- EMPTY -->
    <div x-show="!mineLoading && agents.length === 0" class="rh-block text-center py-10">
      <div class="text-sm text-ink-500 mb-2">还没有 oracle 角色的 agent.</div>
      <a href="/agent" class="text-xs text-brand-500 hover:text-brand-700">→ 去 /agent 把某个 relay 改成 oracle 角色</a>
    </div>

    <template x-if="!mineLoading && agents.length > 0">
      <div class="space-y-5">

        <!-- AGENT SELECTOR -->
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3">
            <select x-model.number="selectedIdx" @change="loadMine()"
              class="px-4 py-2 border border-warm-300 rounded-lg text-sm font-medium text-ink-600 bg-white focus:ring-2 focus:ring-brand-200 focus:border-brand-400 focus:outline-none">
              <template x-for="(a, idx) in agents" :key="a.id">
                <option :value="idx" x-text="a.name"></option>
              </template>
            </select>
            <span class="text-[10px] uppercase tracking-wider text-ink-400">Oracle</span>
          </div>
          <div x-show="agent" class="flex items-center gap-3">
            <button class="text-[11px] font-mono text-ink-400 hover:text-brand-500 cursor-pointer"
              @click="copyAddr()" x-text="shortAddr(agent?.address)" :title="agent?.address"></button>
            <span class="text-sm font-bold text-ink-700 tabular-nums" x-text="agent?.kasBalance != null ? agent.kasBalance.toFixed(4) + ' KAS' : '--'"></span>
          </div>
        </div>

        <!-- ① 角色身份 -->
        <div class="rh-block">
          <div class="rh-block-title"><span class="rh-block-dot bg-brand-500"></span>角色身份</div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <div class="rh-stat-label">名称</div>
              <div class="rh-stat-value" x-text="agent?.name"></div>
            </div>
            <div>
              <div class="rh-stat-label">角色</div>
              <div class="rh-stat-value">Oracle</div>
              <div class="text-[10px] text-ink-400 mt-0.5" x-show="agent?.role">role: <span x-text="agent.role"></span></div>
            </div>
            <div>
              <div class="rh-stat-label">投票地址 (公钥派生)</div>
              <div class="font-mono text-xs text-ink-600 break-all mt-1" x-text="agent?.address"></div>
              <div class="text-[10px] text-ink-400 mt-0.5" x-show="oraclePk">PK: <span class="font-mono" x-text="oraclePk.slice(0,16) + '...'"></span></div>
            </div>
          </div>
        </div>

        <!-- ② 收入 -->
        <div class="rh-block">
          <div class="rh-block-title"><span class="rh-block-dot bg-green-500"></span>收入</div>
          <div x-show="incomeLoading" class="text-xs text-ink-300">加载中...</div>
          <template x-if="!incomeLoading && income">
            <div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <div class="rh-stat-label">v0.6 已结算市场累计收入</div>
                  <div class="rh-stat-value rh-display" x-text="fmtKas(income.total_income_kas)"></div>
                  <div class="text-[10px] text-ink-400 mt-0.5">KAS · 委员会 settle TX outputs sum</div>
                </div>
                <div>
                  <div class="rh-stat-label">本人参与的委员会次数</div>
                  <div class="rh-stat-value" x-text="income.per_market?.length ?? 0"></div>
                  <div class="text-[10px] text-ink-400 mt-0.5">market 数 · 各市场 1 次出席</div>
                </div>
              </div>
              <div x-show="income.pending_tx_count > 0" class="text-[11px] text-amber-700 bg-amber-50 border border-amber-200 rounded px-2 py-1 mt-3">
                <span x-text="income.pending_tx_count"></span> 笔 settle TX 还在等链上索引,显示值可能偏低
              </div>
            </div>
          </template>
          <div x-show="incomeError" class="text-xs text-red-500 mt-2" x-text="incomeError"></div>
        </div>

        <!-- ③ 状态 -->
        <div class="rh-block">
          <div class="rh-block-title"><span class="rh-block-dot bg-blue-500"></span>状态</div>
          <div x-show="maxPotLoading" class="text-xs text-ink-300">加载中...</div>
          <template x-if="!maxPotLoading && maxPot">
            <div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <div class="rh-stat-label">当前 active 委员会</div>
                  <div class="rh-stat-value" x-text="maxPot.per_market?.length ?? 0"></div>
                  <div class="text-[10px] text-ink-400 mt-0.5">市场数 · 我被 VRF 抽中且未 settle</div>
                </div>
                <div>
                  <div class="rh-stat-label">最大暴露 (bond × 抽中市场 oracle_bond)</div>
                  <div class="rh-stat-value rh-display text-amber-700" x-text="fmtKas(maxPot.total_pot_at_risk_kas)"></div>
                  <div class="text-[10px] text-ink-400 mt-0.5">KAS · 若全部 dispute 输败的最大被罚总额</div>
                </div>
              </div>
            </div>
          </template>
          <div x-show="maxPotError" class="text-xs text-red-500 mt-2" x-text="maxPotError"></div>
        </div>

        <!-- ④ 配置 -->
        <div class="rh-block">
          <div class="rh-block-title"><span class="rh-block-dot bg-purple-500"></span>配置</div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div>
              <div class="rh-stat-label">投票方式</div>
              <div class="text-ink-600 mt-1">
                事前匿名: 市场创建时 VRF stake-weighted 随机抽 5-of-N 委员, 投票前不公开身份 (防定向贿赂).
                结算时暴露 5 个签名者 PK + 阈值 ≥4 of 5 必达.
              </div>
            </div>
            <div>
              <div class="rh-stat-label">stake 解锁延期</div>
              <div class="text-ink-600 mt-1">
                退出 oracle 池需 ≥7 天延期 (护栏 #4, Bettor r19 path A spec §2).
                巨鲸跑路也罚得到, 防 dispute 期 stake 已撤.
              </div>
            </div>
          </div>
        </div>

        <!-- ⑤ 历史 -->
        <div class="rh-block">
          <div class="rh-block-title"><span class="rh-block-dot bg-ink-400"></span>历史</div>
          <div x-show="incomeLoading" class="text-xs text-ink-300">加载中...</div>
          <template x-if="!incomeLoading && income">
            <div>
              <div x-show="(income.per_market || []).length === 0" class="text-xs text-ink-300 py-3">
                此 oracle 尚未参与任何已结算市场.
              </div>
              <div class="space-y-1.5">
                <template x-for="m in (income.per_market || []).slice(0, 20)" :key="m.market_id">
                  <div class="flex items-center justify-between text-xs py-1.5 border-b border-warm-100 last:border-0">
                    <div class="flex-1 min-w-0">
                      <div class="font-mono text-ink-700 truncate" :title="m.market_id" x-text="m.market_id"></div>
                      <div class="text-[10px] text-ink-400 mt-0.5">
                        <span x-show="m.status">status: <span x-text="m.status"></span></span>
                        <span x-show="m.position != null" class="ml-2">committee 位置 #<span x-text="m.position"></span></span>
                      </div>
                    </div>
                    <div class="text-right tabular-nums text-ink-700 ml-3" x-text="fmtKas(m.income_kas)"></div>
                  </div>
                </template>
              </div>
            </div>
          </template>
        </div>

      </div>
    </template>
  </div>

</div>

<script>
function oracleHome() {
  return {
    tab: 'trust',                                // default = view 2 信任系统 (Bettor r33 priority)

    // ─── trust tab state (view 2 = b + c + g) ───
    trustLoading: true, trustError: '',
    pool: null,                                  // { count, totalStake, top5Pct, cleanPct, top10[] }
    marketsLoading: true,
    markets: [],                                 // [{ market, decode }]

    // ─── mine tab state (view 1 = operator) ───
    mineLoading: true,
    agents: [], selectedIdx: 0, oraclePk: '',
    income: null, incomeLoading: false, incomeError: '',
    maxPot: null, maxPotLoading: false, maxPotError: '',
    get agent() { return this.agents[this.selectedIdx] || null; },

    fmtKas(n) {
      const x = parseFloat(n);
      if (!Number.isFinite(x)) return '0';
      return x.toFixed(4);
    },
    shortAddr(a) {
      if (!a) return '';
      return a.slice(0, 14) + '...' + a.slice(-6);
    },
    copyAddr() {
      if (!this.agent?.address) return;
      navigator.clipboard.writeText(this.agent.address).catch(() => {});
    },

    async init() {
      // Trust tab loads first (default view); mine tab loads on switch.
      await this.loadTrust();
      // Pre-load mine agents but don't fetch per-agent data until tab switch.
      await this.loadMineAgents();
    },

    switchTab(t) {
      this.tab = t;
      if (t === 'mine' && this.agents.length > 0 && !this.income && !this.maxPot) {
        this.loadMine();
      }
    },

    // ─── TRUST TAB (b 池透明 + c 每市场信任) ───

    async loadTrust() {
      this.trustLoading = true; this.marketsLoading = true; this.trustError = '';
      try {
        const [orcResp, mktResp] = await Promise.allSettled([
          fetch('/api/oracles').then(r => r.json()),
          fetch('/api/pool/markets?limit=50').then(r => r.json()),
        ]);

        // b 池透明
        if (orcResp.status === 'fulfilled' && orcResp.value?.ok) {
          const list = orcResp.value.oracles || [];
          const stakes = list.map(o => parseFloat(o.oracle_stake_locked_kas) || 0);
          const totalStake = stakes.reduce((a, b) => a + b, 0);
          const sorted = [...list].sort((a, b) => (parseFloat(b.oracle_stake_locked_kas) || 0) - (parseFloat(a.oracle_stake_locked_kas) || 0));
          const top5Sum = sorted.slice(0, 5).reduce((s, o) => s + (parseFloat(o.oracle_stake_locked_kas) || 0), 0);
          const cleanCount = list.filter(o => (o.voter_misbehave_count || 0) === 0).length;
          this.pool = {
            count: list.length,
            totalStake,
            top5Pct: totalStake > 0 ? (top5Sum / totalStake * 100) : 0,
            cleanPct: list.length > 0 ? (cleanCount / list.length * 100) : 100,
            top10: sorted.slice(0, 10),
          };
        } else {
          this.trustError = '池数据接口异常: /api/oracles';
        }
        this.trustLoading = false;

        // c 每市场信任 — only v0.6 markets, fetch decode in parallel (cap 20 to avoid spam)
        if (mktResp.status === 'fulfilled' && mktResp.value?.ok) {
          const raw = (mktResp.value.markets || []).slice(0, 20);
          const decoded = await Promise.allSettled(raw.map(m =>
            fetch(`/api/pool/market/${m.id}/v06-settle-decode`).then(r => r.ok ? r.json() : null).catch(() => null)
          ));
          this.markets = raw.map((m, i) => ({
            market: m,
            decode: decoded[i].status === 'fulfilled' && decoded[i].value?.ok ? decoded[i].value : null,
          })).filter(x => x.decode);   // only show v0.6 (decode returns 400 for v0.5, filtered)
        }
        this.marketsLoading = false;
      } catch (e) {
        this.trustError = '加载信任系统失败: ' + e.message;
        this.trustLoading = false;
        this.marketsLoading = false;
      }
    },

    // ─── MINE TAB (view 1 operator, 5 块) ───

    async loadMineAgents() {
      try {
        const r = await fetch('/api/relays');
        const j = await r.json();
        this.agents = (j.relays || j || [])
          .filter(x => x.role === 'oracle' || x.is_oracle)
          .map(x => ({ ...x, kasBalance: null }));
      } catch (e) {
        console.error('load oracle agents fail:', e);
      } finally {
        this.mineLoading = false;
      }
    },

    async loadMine() {
      const a = this.agent;
      if (!a) return;
      this.income = null; this.maxPot = null;
      this.incomeError = ''; this.maxPotError = '';
      this.oraclePk = '';

      const fetchJson = async (url) => {
        const r = await fetch(url);
        if (!r.ok) {
          const txt = await r.text().catch(() => '');
          throw new Error('HTTP ' + r.status + (txt ? (' ' + txt.slice(0,80)) : ''));
        }
        return r.json();
      };

      // step 1: derive PK
      let pk = '';
      try {
        const pkResp = await fetchJson(`/api/relay/${a.id}/pubkey`);
        pk = (pkResp.pubkey || pkResp.pk || '').toLowerCase();
        this.oraclePk = pk;
      } catch (e) {
        this.incomeError = 'pubkey 获取失败: ' + e.message;
        this.maxPotError = this.incomeError;
        return;
      }

      // step 2: parallel fetch
      this.incomeLoading = true; this.maxPotLoading = true;
      try {
        const [bal, inc, mp] = await Promise.allSettled([
          fetchJson(`/api/relay/${a.id}/balance`),
          fetchJson(`/api/oracle/income/${pk}`),
          fetchJson(`/api/oracle/max-pot/${pk}`),
        ]);
        if (bal.status === 'fulfilled') {
          a.kasBalance = (typeof bal.value === 'number') ? bal.value : (bal.value?.balance ?? null);
        }
        if (inc.status === 'fulfilled') {
          this.income = inc.value;
        } else {
          this.incomeError = '收入接口报错: ' + (inc.reason?.message || 'unknown');
        }
        if (mp.status === 'fulfilled') {
          this.maxPot = mp.value;
        } else {
          this.maxPotError = '最大暴露接口报错: ' + (mp.reason?.message || 'unknown');
        }
      } finally {
        this.incomeLoading = false; this.maxPotLoading = false;
      }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

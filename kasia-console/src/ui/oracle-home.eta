<%~ include('partials/page-open', { _page: 'oracle', pageTitle: '仲裁人中心', ...it }) %>

<!--
  KANet-UI 2026-06-07 Track C (Bettor r335b 设计 关 1 PASS):
  弃旧 2 jargon tab (信任系统/我的 oracle), 改 3 段 (= 仲裁人中心):
    段 1: 仲裁人名册 (observer 视角, Owner 5 维度 大白话)
    段 2: 进行中裁决 (de-jargon 旧 ② 表格)
    段 3: 我注册仲裁人 (operator 视角)
  钉死 (Bettor 设计 §3): 0 shadow → '暂无评分' 不假分; licensed_domains 全 null → '未分领域执照'; testnet 测试币不报经济价值.
  Endpoints (现有, 0 backend 改):
    /api/oracle/registry             — 段 1 名册底
    /api/oracle-pool/chain-snapshot  — 段 1 质押状态 (stake_locked)
    /api/oracle/:id/reputation       — 段 1 工作/盈利 (total_reward; accuracy 永显'暂无')
    /api/pool/markets?status=...     — 段 2 进行中
    /api/agent/profile               — 段 3 我的 agent list
-->

<style>
  .ar-display { font-family: 'Fraunces', Georgia, serif; }
  .ar-card { @apply bg-white rounded-lg border border-warm-200 p-4 hover:border-brand-300 transition; }
  .ar-pill { @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium; }
  .ar-pill-good { @apply bg-emerald-50 text-emerald-700 border border-emerald-200; }
  .ar-pill-warn { @apply bg-amber-50 text-amber-700 border border-amber-200; }
  .ar-pill-mute { @apply bg-warm-50 text-ink-500 border border-warm-200; }
  .ar-section-title { @apply text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3 flex items-center gap-2; }
  .ar-section-dot { @apply w-2 h-2 rounded-full; }
  .ar-stat-label { @apply text-[10px] text-ink-400 uppercase tracking-wider; }
  .ar-stat-value { @apply text-sm font-medium text-ink-700 tabular-nums; }
  .ar-empty-note { @apply text-[11px] text-ink-400 italic; }
</style>

<div class="p-6 max-w-7xl mx-auto" x-data="arbiterHome()" x-init="init()" x-cloak>

  <!-- HEADER -->
  <div class="mb-6">
    <h1 class="text-2xl ar-display text-ink-800">仲裁人中心</h1>
    <p class="text-xs text-ink-400 mt-1">看哪些仲裁人在岗 · 哪些题在裁 · 我注册自家 agent 当仲裁人.</p>
  </div>

  <!-- ============================================================ -->
  <!-- 段 1: 仲裁人名册                                                  -->
  <!-- ============================================================ -->
  <section class="mb-8">
    <div class="ar-section-title">
      <span class="ar-section-dot bg-brand-500"></span>
      <span>① 仲裁人名册</span>
      <span class="text-ink-400 normal-case tracking-normal" x-show="!loading">· <span x-text="oracles.length"></span> 位</span>
    </div>

    <div x-show="loading" class="text-xs text-ink-400 py-4">载入中...</div>

    <div x-show="!loading && oracles.length === 0" class="ar-card text-center py-8">
      <div class="text-3xl mb-2">📋</div>
      <p class="text-sm text-ink-500">还没有注册仲裁人.</p>
      <p class="ar-empty-note mt-1">下面段 3 注册自家 agent 当首批仲裁人.</p>
    </div>

    <div x-show="!loading && oracles.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <template x-for="o in oracles" :key="o.relay_node_id">
        <div class="ar-card">
          <!-- 谁 -->
          <div class="flex items-center justify-between mb-2">
            <div>
              <div class="text-sm font-medium text-ink-700" x-text="o.name || '(未命名)'"></div>
              <div class="text-[10px] text-ink-400 mt-0.5" x-text="tierLabel(o.tier)"></div>
            </div>
            <div>
              <span x-show="o.frozen" class="ar-pill ar-pill-warn">⛔ 已冻结</span>
              <span x-show="!o.frozen && o.status === 'active'" class="ar-pill ar-pill-good">在岗</span>
              <span x-show="!o.frozen && o.status !== 'active'" class="ar-pill ar-pill-mute" x-text="o.status || '?'"></span>
            </div>
          </div>

          <!-- 能裁什么 -->
          <div class="mb-2 pb-2 border-b border-warm-100">
            <div class="ar-stat-label">能裁什么</div>
            <div class="text-xs text-ink-600 mt-1" x-text="capabilitiesLabel(o.capabilities)"></div>
            <div class="text-[11px] text-ink-500 mt-0.5">
              <span x-show="(o.licensed_domains || []).length === 0">通用 · 未分领域执照</span>
              <span x-show="(o.licensed_domains || []).length > 0" x-text="(o.licensed_domains || []).join(' · ')"></span>
            </div>
          </div>

          <!-- 工作状态 -->
          <div class="mb-2 pb-2 border-b border-warm-100">
            <div class="ar-stat-label">工作状态</div>
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-ink-600">近期裁决 <span class="ar-stat-value" x-text="o._stats?.total_votes ?? '—'"></span> 次</span>
              <!-- KANet-UI 2026-06-07 Track C 钉死 (Bettor r335b §3): 0 shadow → '暂无评分' 不造假 -->
              <span class="ar-pill ar-pill-mute" title="并行判定攒分中, 等 Track D 产出对照 UMA 的 shadow 分">暂无评分</span>
            </div>
          </div>

          <!-- 盈利状态 -->
          <div class="mb-2 pb-2 border-b border-warm-100">
            <div class="ar-stat-label">盈利状态 (测试币)</div>
            <div class="text-xs text-ink-600 mt-1">
              <span x-show="(o._stats?.total_reward ?? 0) > 0">
                累计仲裁收益 <span class="ar-stat-value" x-text="fmtKas((o._stats.total_reward || 0) / 1e8)"></span> KAS
              </span>
              <span x-show="!o._stats || (o._stats.total_reward ?? 0) === 0" class="ar-empty-note">暂无收益</span>
            </div>
          </div>

          <!-- 质押状态 -->
          <div>
            <div class="ar-stat-label">质押状态</div>
            <div class="text-xs text-ink-600 mt-1">
              <span x-show="o._stakeKas > 0">
                已质押 <span class="ar-stat-value" x-text="fmtKas(o._stakeKas)"></span> KAS
              </span>
              <span x-show="!(o._stakeKas > 0)" class="ar-empty-note">未质押</span>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div x-show="oraclesError" class="text-xs text-red-500 mt-3" x-text="oraclesError"></div>
  </section>

  <!-- ============================================================ -->
  <!-- 段 2: 进行中裁决                                                  -->
  <!-- ============================================================ -->
  <section class="mb-8">
    <div class="ar-section-title">
      <span class="ar-section-dot bg-amber-500"></span>
      <span>② 进行中裁决</span>
      <span class="text-ink-400 normal-case tracking-normal" x-show="!marketsLoading">· <span x-text="activeMarkets.length"></span> 题</span>
    </div>

    <div x-show="marketsLoading" class="text-xs text-ink-400 py-4">载入中...</div>

    <div x-show="!marketsLoading && activeMarkets.length === 0" class="ar-card text-center py-6">
      <p class="ar-empty-note">现在没有进行中的裁决.</p>
    </div>

    <div x-show="!marketsLoading && activeMarkets.length > 0" class="card overflow-hidden">
      <table class="w-full text-xs">
        <thead class="bg-warm-50 text-ink-500 text-[11px]">
          <tr>
            <th class="text-left py-2 px-3">题目</th>
            <th class="text-left py-2 px-3">现在哪步</th>
            <th class="text-left py-2 px-3">谁在裁</th>
            <th class="text-right py-2 px-3">抵押 (每位)</th>
            <th class="text-left py-2 px-3">链上 TX</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="m in activeMarkets" :key="m.id">
            <tr class="border-t border-warm-100 hover:bg-warm-50">
              <td class="py-2 px-3 max-w-[260px] truncate">
                <a :href="`/predictions/pool/${encodeURIComponent(m.id)}`" :title="m.title" class="text-ink-700 hover:text-brand-500" x-text="m.title || m.id.slice(0, 16)"></a>
              </td>
              <td class="py-2 px-3"><span class="ar-pill ar-pill-mute" x-text="statusLabel(m.protocol_status)"></span></td>
              <td class="py-2 px-3 text-ink-500 text-[11px]" x-text="committeeLabel(m)"></td>
              <td class="py-2 px-3 text-right tabular-nums text-ink-600" x-text="fmtKas((m.oracle_bond_amount || 0) / 1e8) + ' KAS'"></td>
              <td class="py-2 px-3">
                <a x-show="m.settle_txid" :href="`https://explorer-tn12.kaspa.org/txs/${m.settle_txid}`" target="_blank"
                   class="font-mono text-[10px] text-brand-500 hover:underline" x-text="(m.settle_txid || '').slice(0, 10) + '...'"></a>
                <span x-show="!m.settle_txid" class="text-ink-300 text-[10px]">未结算</span>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 段 3: 我注册仲裁人                                                -->
  <!-- ============================================================ -->
  <section class="mb-4">
    <div class="ar-section-title">
      <span class="ar-section-dot bg-purple-500"></span>
      <span>③ 我注册仲裁人</span>
    </div>

    <div x-show="agentsLoading" class="text-xs text-ink-400 py-4">载入中...</div>

    <div x-show="!agentsLoading && myAgents.length === 0" class="ar-card text-center py-6">
      <p class="text-sm text-ink-500 mb-1">还没有 agent 可注册.</p>
      <a href="/agent" class="text-xs text-brand-500 hover:underline">去 /agent 建一个 →</a>
    </div>

    <template x-if="!agentsLoading && myAgents.length > 0">
      <div class="space-y-3">
        <div class="ar-card">
          <div class="text-xs text-ink-500 mb-2">从自家 agent 选一个注册为仲裁人:</div>
          <select x-model="selectedAgentId" @change="onAgentChange()" class="w-full text-sm px-3 py-2 rounded border border-warm-300 bg-white">
            <option value="">选一个 agent</option>
            <template x-for="a in myAgents" :key="a.id">
              <option :value="a.id" x-text="a.name + (isOracleRegistered(a.id) ? ' (已注册仲裁人)' : '')"></option>
            </template>
          </select>

          <template x-if="selectedAgent">
            <div class="mt-4 pt-3 border-t border-warm-200 space-y-3">
              <!-- 已注册: 显其状态 + 5 维度 (= 同段 1 卡片) -->
              <div x-show="myOracleRecord">
                <div class="text-xs font-medium text-ink-700 mb-2">已注册状态</div>
                <div class="grid grid-cols-2 gap-3 text-xs">
                  <div>
                    <div class="ar-stat-label">级别</div>
                    <div class="text-ink-600" x-text="tierLabel(myOracleRecord?.tier)"></div>
                  </div>
                  <div>
                    <div class="ar-stat-label">状态</div>
                    <div class="text-ink-600" x-text="(myOracleRecord?.frozen ? '已冻结' : (myOracleRecord?.status === 'active' ? '在岗' : (myOracleRecord?.status || '?')))"></div>
                  </div>
                  <div>
                    <div class="ar-stat-label">能裁什么</div>
                    <div class="text-ink-600" x-text="capabilitiesLabel(myOracleRecord?.capabilities)"></div>
                  </div>
                  <div>
                    <div class="ar-stat-label">执照域</div>
                    <div class="text-ink-600">
                      <span x-show="(myOracleRecord?.licensed_domains || []).length === 0">通用 · 未分领域执照</span>
                      <span x-show="(myOracleRecord?.licensed_domains || []).length > 0" x-text="(myOracleRecord.licensed_domains || []).join(' · ')"></span>
                    </div>
                  </div>
                </div>
                <p class="ar-empty-note mt-3">提交申请改配置 + 执照域: Phase2 上线后开放. 当前 Phase1 走通用执照.</p>
              </div>

              <!-- 未注册: 注册按钮 -->
              <div x-show="!myOracleRecord">
                <p class="text-xs text-ink-500 mb-2">该 agent 尚未注册为仲裁人. 注册流程包含 stake 锁仓 + 链上声明.</p>
                <a href="/agent?tab=oracle" class="inline-block px-3 py-1.5 rounded bg-brand-500 hover:bg-brand-600 text-white text-xs font-medium">去 /agent 注册仲裁人 →</a>
                <p class="ar-empty-note mt-2">注册成功后此处显 5 维度状态 + 工作记录.</p>
              </div>
            </div>
          </template>
        </div>
      </div>
    </template>
  </section>

  <!-- 诚实边界声明 (Bettor 设计 §3 钉死) -->
  <div class="mt-6 pt-4 border-t border-warm-200 text-[11px] text-ink-400 space-y-1">
    <div>📌 <strong>准确率</strong>: 现 0 shadow 记录 (= 并行判定攒分中), 等 Track D 产出后才显真分. 严禁占位假分.</div>
    <div>📌 <strong>执照域</strong>: Phase2 硬 gate 未解, 现全 '通用 · 未分领域执照', 不显 '已毕业 / 可裁长尾'.</div>
    <div>📌 <strong>测试币</strong>: testnet 仲裁收益是测试币, 不报经济价值.</div>
  </div>
</div>

<script>
function arbiterHome() {
  return {
    loading: true,
    oracles: [],
    oraclesError: '',
    marketsLoading: true,
    activeMarkets: [],
    agentsLoading: true,
    myAgents: [],
    selectedAgentId: '',
    chainSnapshot: null,    // { leaves: [{pk_x, stake_sompi, ...}] }

    get selectedAgent() {
      return this.myAgents.find(a => a.id === this.selectedAgentId) || null;
    },
    get myOracleRecord() {
      if (!this.selectedAgentId) return null;
      return this.oracles.find(o => o.relay_node_id === this.selectedAgentId) || null;
    },

    fmtKas(n) {
      const x = parseFloat(n);
      if (!Number.isFinite(x)) return '0';
      return x.toFixed(4);
    },
    tierLabel(t) {
      if (t === 1) return '1 级仲裁人';
      if (t === 2) return '2 级仲裁人';
      if (t === 3) return '3 级仲裁人';
      return '(级别待定 · 未走 registry 注册)';
    },
    capabilitiesLabel(caps) {
      const arr = Array.isArray(caps) ? caps : [];
      if (arr.length === 0) return '二元 YES/NO 判定';
      // 已知 capability → 中文
      const map = { binary_outcome: '二元 YES/NO 判定', multi_outcome: '多选项判定', numeric: '数值判定' };
      return arr.map(c => map[c] || c).join(' · ');
    },
    statusLabel(s) {
      const m = {
        pending_oracle_deposits: '等仲裁人接单',
        pending_oracle_sampling: '抽仲裁人中',
        pending_oracle_sample: '抽仲裁人中',
        pending_bettors: '押注中',
        verifying: '等仲裁人投票',
        collecting_sigs: '收仲裁人签名',
        completed: '已结算',
        cancelled: '已取消',
        refunded: '已退款',
      };
      return m[s] || s || '?';
    },
    committeeLabel(m) {
      // m.committee_pks 是 PK 集 — 抽样后才有; 之前显 '等抽签'
      if (!m.committee_pks) return '等抽签';
      try {
        const arr = typeof m.committee_pks === 'string' ? JSON.parse(m.committee_pks) : m.committee_pks;
        if (Array.isArray(arr) && arr.length) return arr.length + ' 位 (匿名)';
      } catch {}
      return '等抽签';
    },
    isOracleRegistered(agentId) {
      return this.oracles.some(o => o.relay_node_id === agentId);
    },

    async init() {
      // 并行拉 3 数据源
      await Promise.all([
        this.loadOracles(),
        this.loadActiveMarkets(),
        this.loadAgents(),
      ]);
    },

    async loadOracles() {
      this.loading = true;
      this.oraclesError = '';
      try {
        // KANet-UI 2026-06-07 Track C catch: oracle_registry 实空 (= count=0, Bettor 设计 doc Sec1 估算误).
        // 主源改 /api/oracles (= legacy is_oracle=1, 5 个 active). 再尝试 fetch registry tier/caps (= 缺则默认).
        const [oraResp, regResp, snapResp] = await Promise.all([
          fetch('/api/oracles').then(x => x.json()).catch(() => ({ oracles: [] })),
          fetch('/api/oracle/registry?include_expired=1').then(x => x.json()).catch(() => ({ oracles: [] })),
          fetch('/api/oracle-pool/chain-snapshot').then(x => x.json()).catch(() => ({ leaves: [] })),
        ]);

        const baseList = (oraResp.oracles || []);
        const regList = (regResp.oracles || []);
        const regById = {};
        for (const r of regList) regById[r.relay_node_id] = r;

        const stakeByPk = {};
        if (snapResp?.leaves && Array.isArray(snapResp.leaves)) {
          for (const l of snapResp.leaves) stakeByPk[l.pk_x] = Number(l.stake_sompi || 0) / 1e8;
        }

        const oracles = baseList.map(o => {
          const reg = regById[o.id] || null;
          return {
            relay_node_id: o.id,
            name: o.name,
            pubkey: reg?.pubkey || null,
            tier: reg?.tier || null,                  // null = '(级别待定)' 不假分
            capabilities: reg?.capabilities || [],    // [] → 默认 '二元 YES/NO 判定'
            licensed_domains: reg?.licensed_domains || [],
            frozen: reg?.frozen || false,
            status: reg?.status || 'active',          // 缺则默认 active (= legacy is_oracle=1)
            _stats: null,
            _stakeKas: 0,
          };
        });

        // 并行拉每 oracle reputation (= 工作 + 盈利)
        const repResults = await Promise.all(
          oracles.map(o => fetch(`/api/oracle/${encodeURIComponent(o.relay_node_id)}/reputation`).then(x => x.json()).catch(() => null))
        );
        for (let i = 0; i < oracles.length; i++) {
          const o = oracles[i];
          const rep = repResults[i];
          o._stats = rep?.history || null;
          // 质押: pubkey 在则查 chain_snapshot; 不在 (= registry 空) 则 0
          o._stakeKas = (o.pubkey && stakeByPk[o.pubkey]) ? stakeByPk[o.pubkey] : 0;
        }
        this.oracles = oracles;
      } catch (e) {
        this.oraclesError = '加载仲裁人名册失败: ' + (e.message || e);
      }
      this.loading = false;
    },

    async loadActiveMarkets() {
      this.marketsLoading = true;
      try {
        // 进行中 = pending_oracle_deposits / pending_bettors / verifying / collecting_sigs
        const r = await fetch('/api/pool/markets?limit=200').then(x => x.json());
        const all = (r?.markets || []);
        const activeStatus = new Set(['pending_oracle_deposits', 'pending_oracle_sampling', 'pending_bettors', 'verifying', 'collecting_sigs']);
        const list = all.filter(m => activeStatus.has(m.protocol_status)).map(m => {
          let title = m.id;
          try { const o = JSON.parse(m.resolution_rule_spec || ''); title = o.title || title; } catch {}
          return { ...m, title };
        });
        this.activeMarkets = list;
      } catch {}
      this.marketsLoading = false;
    },

    async loadAgents() {
      this.agentsLoading = true;
      try {
        const r = await fetch('/api/agent/profile').then(x => x.json());
        const list = Array.isArray(r) ? r : (r.agents || []);
        this.myAgents = list.filter(a => !a.is_dex_broker);
      } catch {}
      this.agentsLoading = false;
    },

    onAgentChange() {
      // selectedAgent + myOracleRecord 是 getter, 切换自动 render
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

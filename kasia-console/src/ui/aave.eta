<%~ include('partials/page-open', { _page: 'aave', pageTitle: 'Aave Lending', ...it }) %>

<div class="h-full flex flex-col" x-data="aaveApp()">

  <!-- ═══ HEADER BAR ═══ -->
  <div class="flex-shrink-0 bg-white border-b border-warm-200 px-5 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-xs">A</div>
      <div>
        <div class="text-sm font-semibold text-ink-700">Aave V3</div>
        <div class="text-[10px] text-ink-400">Decentralized lending on Arbitrum</div>
      </div>
    </div>
    <div class="flex items-center gap-4 text-xs">
      <div class="flex items-center gap-1.5">
        <span class="text-ink-400">Agent:</span>
        <select x-model="selectedWalletId" @change="loadAll()" class="pl-2 pr-6 py-1 border border-warm-200 rounded text-xs bg-white">
          <template x-for="w in arbWallets" :key="w.id">
            <option :value="w.id" x-text="w.name + ' — ' + w.address?.slice(0,8) + '...' + w.address?.slice(-4)"></option>
          </template>
        </select>
      </div>
      <button @click="loadAll()" class="text-brand-500 hover:text-brand-700 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Refresh
      </button>
    </div>
  </div>

  <!-- ═══ MAIN CONTENT — 3 COLUMNS ═══ -->
  <div class="flex-1 flex min-h-0 overflow-hidden">

    <!-- ── LEFT: Markets List ── -->
    <div class="flex-1 border-r border-warm-200 overflow-y-auto bg-warm-50/30">
      <div class="p-5">
        <div class="mb-3">
          <h2 class="text-sm font-semibold text-ink-700">Markets</h2>
          <p class="text-[10px] text-ink-400">Supply to earn interest or borrow against collateral</p>
        </div>

        <!-- Market cards -->
        <div class="space-y-2">
          <template x-for="asset in assets" :key="asset.symbol">
            <div class="bg-white border border-warm-200 rounded-lg p-4 hover:border-brand-300 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-bold text-white"
                    :class="asset.symbol === 'USDC' ? 'bg-blue-500' : asset.symbol === 'WETH' ? 'bg-indigo-500' : 'bg-green-500'"
                    x-text="asset.symbol.slice(0,3)"></div>
                  <div>
                    <div class="font-medium text-ink-700 text-sm" x-text="asset.symbol"></div>
                    <div class="text-[10px] text-ink-400" x-text="asset.name"></div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] text-ink-400">Wallet</div>
                  <div class="font-medium text-ink-600 tabular-nums text-xs" x-text="(asset.walletBalance || 0).toFixed(2)"></div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 text-[11px] mb-3">
                <div class="bg-green-50 rounded p-2">
                  <div class="text-[9px] text-green-600 uppercase tracking-wider">Supply APY</div>
                  <div class="text-sm font-semibold text-green-700 tabular-nums" x-text="(asset.supplyAPY || 0).toFixed(2) + '%'"></div>
                </div>
                <div class="bg-orange-50 rounded p-2">
                  <div class="text-[9px] text-orange-600 uppercase tracking-wider">Borrow APY</div>
                  <div class="text-sm font-semibold text-orange-700 tabular-nums" x-text="(asset.borrowAPY || 0).toFixed(2) + '%'"></div>
                </div>
                <div class="bg-warm-100 rounded p-2">
                  <div class="text-[9px] text-ink-500 uppercase tracking-wider">Max LTV</div>
                  <div class="text-sm font-semibold text-ink-700 tabular-nums" x-text="(asset.ltv || 0) + '%'"></div>
                </div>
              </div>

              <div class="flex gap-2">
                <button @click="openAction('supply', asset)"
                  class="flex-1 py-1.5 bg-green-500 text-white rounded text-[11px] font-medium hover:bg-green-600">
                  Supply
                </button>
                <button @click="openAction('borrow', asset)"
                  class="flex-1 py-1.5 bg-orange-500 text-white rounded text-[11px] font-medium hover:bg-orange-600"
                  :class="!canBorrow && 'opacity-50 cursor-not-allowed'"
                  :disabled="!canBorrow">
                  Borrow
                </button>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>

    <!-- ── CENTER: Your Position ── -->
    <div class="w-[320px] flex-shrink-0 border-r border-warm-200 overflow-y-auto bg-white">
      <div class="p-5">
        <h2 class="text-sm font-semibold text-ink-700 mb-3">Your Position</h2>

        <!-- Total stats -->
        <div class="space-y-3 mb-4">
          <div class="bg-warm-50 rounded-lg p-3">
            <div class="text-[10px] text-ink-400 uppercase tracking-wider">Total Supplied</div>
            <div class="text-xl font-bold text-ink-700 tabular-nums" x-text="'$' + (account.totalCollateralUSD || 0).toFixed(2)"></div>
          </div>
          <div class="bg-warm-50 rounded-lg p-3">
            <div class="text-[10px] text-ink-400 uppercase tracking-wider">Total Borrowed</div>
            <div class="text-xl font-bold tabular-nums"
              :class="(account.totalDebtUSD || 0) > 0 ? 'text-orange-600' : 'text-ink-700'"
              x-text="'$' + (account.totalDebtUSD || 0).toFixed(2)"></div>
          </div>
          <div class="bg-warm-50 rounded-lg p-3">
            <div class="text-[10px] text-ink-400 uppercase tracking-wider">Available to Borrow</div>
            <div class="text-xl font-bold text-blue-600 tabular-nums" x-text="'$' + (account.availableBorrowUSD || 0).toFixed(2)"></div>
          </div>
        </div>

        <!-- Health Factor -->
        <div class="bg-white border border-warm-200 rounded-lg p-3 mb-4">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] text-ink-400 uppercase tracking-wider">Health Factor</span>
            <span class="text-lg font-bold tabular-nums"
              :class="(account.healthFactor || 999) > 2 ? 'text-green-600' : (account.healthFactor || 999) > 1.5 ? 'text-yellow-600' : 'text-red-600'"
              x-text="account.healthFactor === null || account.healthFactor > 100 ? '∞' : (account.healthFactor || 0).toFixed(2)"></span>
          </div>
          <div class="h-3 bg-warm-200 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all"
              :class="(account.healthFactor || 999) > 2 ? 'bg-green-500' : (account.healthFactor || 999) > 1.5 ? 'bg-yellow-500' : 'bg-red-500'"
              :style="'width:' + Math.min(100, ((account.healthFactor || 0) / 3) * 100) + '%'"></div>
          </div>
          <div class="flex justify-between text-[9px] text-ink-400 mt-1">
            <span>Liquidation &lt; 1.0</span>
            <span>Safe &gt; 2.0</span>
          </div>
        </div>

        <!-- Your Supplies -->
        <div x-show="yourSupplies.length > 0" class="mb-4">
          <div class="text-[10px] text-ink-400 uppercase tracking-wider mb-2">Your Supplies</div>
          <div class="space-y-1.5">
            <template x-for="s in yourSupplies" :key="s.symbol">
              <div class="flex items-center justify-between py-1.5 border-b border-warm-100 last:border-0">
                <span class="font-medium text-ink-600 text-xs" x-text="s.symbol"></span>
                <div class="text-right">
                  <div class="font-medium tabular-nums text-xs" x-text="s.amount?.toFixed(2)"></div>
                  <div class="text-[9px] text-green-600">+<span x-text="s.apy?.toFixed(2)"></span>%</div>
                </div>
              </div>
            </template>
          </div>
        </div>

        <!-- Your Borrows -->
        <div x-show="yourBorrows.length > 0" class="mb-4">
          <div class="text-[10px] text-ink-400 uppercase tracking-wider mb-2">Your Borrows</div>
          <div class="space-y-1.5">
            <template x-for="b in yourBorrows" :key="b.symbol">
              <div class="flex items-center justify-between py-1.5 border-b border-warm-100 last:border-0">
                <span class="font-medium text-ink-600 text-xs" x-text="b.symbol"></span>
                <div class="text-right">
                  <div class="font-medium tabular-nums text-xs text-orange-600" x-text="b.amount?.toFixed(2)"></div>
                  <div class="text-[9px] text-orange-600">-<span x-text="b.apy?.toFixed(2)"></span>%</div>
                </div>
              </div>
            </template>
          </div>
        </div>

        <!-- Empty state -->
        <div x-show="yourSupplies.length === 0 && yourBorrows.length === 0" class="text-center py-6 text-xs text-ink-400">
          No active positions.<br/>
          Supply an asset to earn interest.
        </div>
      </div>
    </div>

    <!-- ── RIGHT: Transaction History ── -->
    <div class="w-[300px] flex-shrink-0 overflow-y-auto bg-warm-50/30">
      <div class="p-5">
        <h2 class="text-sm font-semibold text-ink-700 mb-3">Transaction History</h2>
        <div x-show="history.length === 0" class="text-center py-6 text-xs text-ink-400">
          No transactions yet.
        </div>
        <div class="space-y-2">
          <template x-for="tx in history" :key="tx.id">
            <div class="bg-white border border-warm-200 rounded-lg p-2.5">
              <div class="flex items-center justify-between mb-1">
                <span class="text-[10px] font-medium uppercase tracking-wider"
                  :class="{ 'text-green-600': tx.type === 'supply', 'text-orange-600': tx.type === 'borrow', 'text-blue-600': tx.type === 'withdraw', 'text-purple-600': tx.type === 'repay' }"
                  x-text="tx.type"></span>
                <span class="text-[9px] text-ink-400" x-text="tx.time"></span>
              </div>
              <div class="text-xs text-ink-700 tabular-nums" x-text="tx.amount + ' ' + tx.asset"></div>
              <a :href="'https://arbiscan.io/tx/' + tx.txHash" target="_blank"
                class="text-[9px] text-brand-500 hover:underline font-mono" x-text="tx.txHash?.slice(0, 10) + '...'"></a>
            </div>
          </template>
        </div>
      </div>
    </div>

  </div>

  <!-- ═══ ACTION MODAL ═══ -->
  <div x-show="modalOpen" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" @click.self="modalOpen = false">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-96" @click.stop>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-ink-700">
          <span x-text="modalAction.charAt(0).toUpperCase() + modalAction.slice(1) + ' ' + modalAsset?.symbol"></span>
        </h3>
        <button @click="modalOpen = false" class="text-ink-400 hover:text-ink-600 text-2xl leading-none">&times;</button>
      </div>

      <div class="bg-warm-50 rounded-lg p-3 mb-4 text-xs space-y-1">
        <div class="flex justify-between"><span class="text-ink-400">Wallet Balance:</span> <span class="tabular-nums" x-text="(modalAsset?.walletBalance || 0).toFixed(4) + ' ' + modalAsset?.symbol"></span></div>
        <div class="flex justify-between" x-show="modalAction === 'supply' || modalAction === 'withdraw'"><span class="text-ink-400">Supply APY:</span> <span class="text-green-600 tabular-nums" x-text="(modalAsset?.supplyAPY || 0).toFixed(2) + '%'"></span></div>
        <div class="flex justify-between" x-show="modalAction === 'borrow' || modalAction === 'repay'"><span class="text-ink-400">Borrow APY:</span> <span class="text-orange-600 tabular-nums" x-text="(modalAsset?.borrowAPY || 0).toFixed(2) + '%'"></span></div>
        <div class="flex justify-between" x-show="modalAction === 'borrow'"><span class="text-ink-400">Available:</span> <span class="tabular-nums" x-text="'$' + (account.availableBorrowUSD || 0).toFixed(2)"></span></div>
      </div>

      <label class="block">
        <span class="text-xs text-ink-500">Amount</span>
        <input type="number" x-model="modalAmount" step="0.01" min="0" placeholder="0.00"
          class="w-full mt-1 px-3 py-2 border border-warm-300 rounded-lg text-sm bg-white focus:border-brand-400 focus:outline-none" />
      </label>

      <div x-show="modalError" class="mt-2 text-xs text-red-600" x-text="modalError"></div>

      <div class="flex gap-2 mt-4">
        <button @click="modalOpen = false" class="flex-1 py-2 bg-warm-200 text-ink-600 rounded-lg text-sm font-medium hover:bg-warm-300">Cancel</button>
        <button @click="confirmAction()" :disabled="modalLoading || !modalAmount"
          class="flex-1 py-2 rounded-lg text-sm font-medium text-white disabled:opacity-50"
          :class="{ 'bg-green-500 hover:bg-green-600': modalAction === 'supply', 'bg-orange-500 hover:bg-orange-600': modalAction === 'borrow', 'bg-blue-500 hover:bg-blue-600': modalAction === 'withdraw', 'bg-purple-500 hover:bg-purple-600': modalAction === 'repay' }">
          <span x-show="!modalLoading" x-text="'Confirm ' + modalAction"></span>
          <span x-show="modalLoading">Processing...</span>
        </button>
      </div>
    </div>
  </div>

</div>

<script>
function aaveApp() {
  return {
    // State
    selectedWalletId: null,
    arbWallets: [],
    account: { totalCollateralUSD: 0, totalDebtUSD: 0, availableBorrowUSD: 0, healthFactor: null, ltv: 0 },
    assets: [
      { symbol: 'USDC', name: 'USD Coin', walletBalance: 0, supplyAPY: 3.2, borrowAPY: 5.5, ltv: 80 },
      { symbol: 'WETH', name: 'Wrapped Ether', walletBalance: 0, supplyAPY: 1.8, borrowAPY: 3.2, ltv: 80 },
      { symbol: 'USDT', name: 'Tether', walletBalance: 0, supplyAPY: 3.0, borrowAPY: 5.2, ltv: 75 },
    ],
    yourSupplies: [],
    yourBorrows: [],
    history: [],
    modalOpen: false,
    modalAction: 'supply',
    modalAsset: null,
    modalAmount: '',
    modalError: '',
    modalLoading: false,

    get canBorrow() {
      return (this.account.totalCollateralUSD || 0) > 0 && (this.account.healthFactor === null || this.account.healthFactor > 1.5);
    },

    async init() {
      await this.loadWallets();
      if (this.selectedWalletId) await this.loadAll();
    },

    async loadWallets() {
      try {
        const relays = await fetch('/api/agent/profile').then(r => r.json());
        const wallets = [];
        for (const r of (relays || [])) {
          try {
            const w = await fetch('/api/relay/' + r.id + '/wallets').then(rr => rr.json());
            for (const c of (w.chains || [])) {
              if (c.chain === 'arbitrum') wallets.push({ id: c.id, name: r.name, address: c.address });
            }
          } catch {}
        }
        this.arbWallets = wallets;
        if (wallets.length > 0 && !this.selectedWalletId) this.selectedWalletId = wallets[0].id;
      } catch {}
    },

    async loadAll() {
      if (!this.selectedWalletId) return;
      try {
        const d = await fetch('/api/defi/aave/status?walletId=' + this.selectedWalletId).then(r => r.json());
        if (d.ok) {
          this.account = d.account || {};
          if (d.walletBalance?.usdc !== undefined) {
            const usdc = this.assets.find(a => a.symbol === 'USDC');
            if (usdc) usdc.walletBalance = d.walletBalance.usdc;
          }
        }
      } catch {}
      // TODO: load yourSupplies/yourBorrows/history from chain_events
    },

    openAction(action, asset) {
      this.modalAction = action;
      this.modalAsset = asset;
      this.modalAmount = '';
      this.modalError = '';
      this.modalOpen = true;
    },

    async confirmAction() {
      if (!this.modalAmount || !this.selectedWalletId) return;
      this.modalLoading = true;
      this.modalError = '';
      try {
        const r = await fetch('/api/defi/aave/' + this.modalAction, {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            walletId: this.selectedWalletId,
            asset: this.modalAsset.symbol.toLowerCase(),
            amount: this.modalAmount,
          }),
        });
        const d = await r.json();
        if (d.ok) {
          alert('Success! TX: ' + d.txHash);
          this.modalOpen = false;
          await this.loadAll();
        } else {
          this.modalError = d.error || 'Transaction failed';
        }
      } catch (e) {
        this.modalError = e.message;
      } finally {
        this.modalLoading = false;
      }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

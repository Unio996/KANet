<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title %> — KANet Console</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="sidebar-brand">
      <span class="brand-icon">⬡</span>
      <span class="brand-name">KANet Console</span>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="nav-link">Dashboard</a></li>
      <li><a href="/conversations" class="nav-link">Conversations</a></li>
      <li><a href="/events" class="nav-link">Events</a></li>
      <li class="nav-section">Config</li>
      <li><a href="/relay" class="nav-link">Relay</a></li>
      <li><a href="/adapter" class="nav-link">Adapter</a></li>
    </ul>
  </nav>
  <main class="main-content">
    <header class="page-header">
      <h1 class="page-title"><%= it.title %></h1>
    </header>
    <div class="page-body">
      <%~ it.body %>
    </div>
  </main>
</body>
</html>

<%~ include('partials/page-open', { _page: 'stocks', pageTitle: '股票市场', ...it }) %>

<div class="p-6" x-data="stocksPage()" x-init="init()">

  <!-- ═══ Stats bar ═══ -->
  <div class="flex items-center gap-3 mb-5 text-sm flex-wrap">
    <template x-if="showPositionPanel && brokerAccount?.ok">
      <span class="font-medium text-ink-700" x-text="'净值 $' + (brokerAccount.netLiquidation?.toLocaleString(undefined,{minimumFractionDigits:0}) || '--')"></span>
    </template>
    <template x-if="sentiment">
      <span class="px-2 py-0.5 rounded-full text-xs font-medium"
        :class="sentiment.value < 25 ? 'bg-red-50 text-red-600' : sentiment.value > 75 ? 'bg-green-50 text-green-600' : 'bg-warm-100 text-ink-500'"
        x-text="'恐贪 ' + sentiment.value + ' ' + sentiment.label"></span>
    </template>
    <template x-if="healthData.avgBeta != null">
      <span class="px-2 py-0.5 rounded-full text-xs font-medium"
        :class="healthData.avgBeta >= 2.0 ? 'bg-red-50 text-red-600' : healthData.avgBeta >= 1.5 ? 'bg-amber-50 text-amber-600' : 'bg-green-50 text-green-600'"
        x-text="'波动性 ' + (healthData.avgBeta >= 2.0 ? '高' : healthData.avgBeta >= 1.5 ? '偏高' : '正常')"></span>
    </template>
    <template x-if="healthData.maxSectorPct >= 0.6">
      <span class="px-2 py-0.5 rounded-full text-xs font-medium"
        :class="healthData.maxSectorPct >= 0.8 ? 'bg-red-50 text-red-600' : 'bg-amber-50 text-amber-600'"
        x-text="'行业集中 ' + Math.round(healthData.maxSectorPct * 100) + '%'"></span>
    </template>
    <div class="ml-auto flex items-center gap-2">
      <select x-model="selectedAgent" class="rounded-lg border border-warm-300 px-2 py-1 text-xs bg-white">
        <% it.relayNodes.forEach(r => { %>
        <option value="<%= r.id %>"><%= r.name %></option>
        <% }) %>
      </select>
      <button @click="showTools = !showTools" class="btn btn-sm btn-secondary" x-text="showTools ? '收起' : '设置'"></button>
    </div>
  </div>

  <!-- ═══ Tools panel — 紧跟按钮下方 ═══ -->
  <div x-show="showTools" x-transition class="space-y-3 mb-5">
    <!-- 添加自选股 -->
    <div class="card">
      <div class="text-xs font-medium text-ink-700 mb-2">添加自选股</div>
      <div class="flex gap-3 items-end">
        <div class="flex-1">
          <input x-model="addSymbol" placeholder="AAPL, NVDA, 0700.HK..." class="w-full rounded-lg border border-warm-300 px-3 py-2 text-sm" @keydown.enter="addStock()" />
        </div>
        <div class="w-28">
          <select x-model="addMarket" class="w-full rounded-lg border border-warm-300 px-3 py-2 text-sm bg-white">
            <option value="us">美股</option><option value="hk">港股</option><option value="cn">A股</option><option value="other">其他</option>
          </select>
        </div>
        <button @click="addStock()" :disabled="adding || !addSymbol.trim()" class="btn btn-sm btn-primary" x-text="adding ? '...' : '添加'"></button>
      </div>
      <div x-show="addError" class="text-xs text-red-500 mt-2" x-text="addError"></div>
    </div>
    <!-- 搜索+下单 -->
    <template x-if="activeBrokerId">
      <div class="card">
        <div class="text-xs font-medium text-ink-700 mb-2">搜索标的下单</div>
        <div class="flex gap-2 mb-2">
          <input x-model="searchQuery" placeholder="搜索股票..." @keydown.enter="searchStock()" class="flex-1 text-sm border border-warm-300 rounded-lg px-3 py-2" />
          <button @click="searchStock()" :disabled="searching || !searchQuery.trim()" class="btn btn-primary btn-sm" x-text="searching ? '...' : '搜索'"></button>
        </div>
        <template x-if="searchResults.length > 0">
          <div class="divide-y divide-warm-100 border border-warm-200 rounded-lg overflow-hidden">
            <template x-for="r in searchResults" :key="r.conid">
              <div class="flex items-center gap-3 px-3 py-2 hover:bg-warm-50">
                <span class="font-bold text-ink-700 w-16 text-xs" x-text="r.symbol"></span>
                <span class="text-xs text-ink-500 flex-1 truncate" x-text="r.name"></span>
                <span class="text-[10px] text-ink-300" x-text="r.exchange"></span>
                <button @click="prepareOrder(r.symbol, r.conid, 'BUY')" class="btn btn-sm btn-primary text-[10px]">买入</button>
              </div>
            </template>
          </div>
        </template>
      </div>
    </template>
    <!-- 下单面板 -->
    <template x-if="orderForm.symbol">
      <div class="card border-brand-300">
        <div class="flex items-center justify-between mb-3">
          <div class="text-sm font-medium text-ink-700"><span x-text="orderForm.side === 'BUY' ? '买入' : '卖出'"></span> <span class="font-bold" x-text="orderForm.symbol"></span></div>
          <button @click="orderForm.symbol = ''" class="text-ink-300 hover:text-ink-600">&times;</button>
        </div>
        <div class="grid grid-cols-4 gap-3 mb-3">
          <div><label class="text-[10px] text-ink-400 block mb-1">方向</label><div class="flex gap-1"><button @click="orderForm.side = 'BUY'" class="flex-1 btn btn-sm text-[10px]" :class="orderForm.side === 'BUY' ? 'btn-primary' : 'btn-ghost'">买入</button><button @click="orderForm.side = 'SELL'" class="flex-1 btn btn-sm text-[10px]" :class="orderForm.side === 'SELL' ? 'btn-primary bg-red-500 hover:bg-red-600' : 'btn-ghost'">卖出</button></div></div>
          <div><label class="text-[10px] text-ink-400 block mb-1">数量</label><input type="number" x-model.number="orderForm.qty" min="1" class="w-full text-sm border border-warm-300 rounded-lg px-3 py-1.5" /></div>
          <div><label class="text-[10px] text-ink-400 block mb-1">类型</label><select x-model="orderForm.type" class="w-full text-sm border border-warm-300 rounded-lg px-3 py-1.5 bg-white"><option value="market">市价</option><option value="limit">限价</option></select></div>
          <div><label class="text-[10px] text-ink-400 block mb-1" x-text="orderForm.type === 'limit' ? '限价' : '—'"></label><input type="number" step="0.01" x-model.number="orderForm.price" :disabled="orderForm.type !== 'limit'" class="w-full text-sm border border-warm-300 rounded-lg px-3 py-1.5" :class="orderForm.type !== 'limit' ? 'bg-warm-100' : ''" /></div>
        </div>
        <button @click="submitBrokerOrder()" :disabled="ordering || !orderForm.qty" class="btn w-full" :class="orderForm.side === 'BUY' ? 'btn-primary' : 'btn-primary bg-red-500 hover:bg-red-600'" x-text="ordering ? '提交中...' : (orderForm.side === 'BUY' ? '确认买入' : '确认卖出') + ' ' + orderForm.qty + ' 股 ' + orderForm.symbol"></button>
        <div x-show="orderMsg" class="mt-2 text-xs" :class="orderMsg.includes('成功') ? 'text-green-600' : 'text-red-500'" x-text="orderMsg"></div>
      </div>
    </template>
    <!-- 券商管理 -->
    <div class="card">
      <div class="text-xs font-medium text-ink-700 mb-2">券商连接</div>
      <template x-for="b in brokers" :key="b.id">
        <div class="flex items-center gap-3 py-2 border-b border-warm-100 last:border-0">
          <span class="status-dot" :class="b.status === 'connected' ? 'green' : b.status === 'error' ? 'red' : 'gray'"></span>
          <span class="text-xs font-medium text-ink-700" x-text="b.name"></span>
          <span class="badge badge-neutral text-[9px]" x-text="b.broker_type.toUpperCase()"></span>
          <span class="text-[10px] text-ink-300 ml-auto" x-text="b.status"></span>
          <button @click="testBroker(b.id)" class="btn btn-ghost btn-sm text-[10px]" :disabled="testing">测试</button>
          <button @click="viewBroker(b.id)" class="btn btn-primary btn-sm text-[10px]" x-show="b.status === 'connected'">持仓</button>
          <button @click="removeBroker(b.id)" class="text-ink-300 hover:text-red-500 text-sm">&times;</button>
        </div>
      </template>
      <div class="mt-3 pt-3 border-t border-warm-200">
        <div class="text-[10px] text-ink-500 mb-2">添加券商</div>
        <div class="grid grid-cols-2 gap-3 mb-2">
          <select x-model="brokerForm.broker_type" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 bg-white"><option value="alpaca">Alpaca — 美股</option><option value="ibkr">IBKR — 全球</option><option value="tradier">Tradier — 美股+期权</option><option value="tiger">老虎 — 美/港/A</option></select>
          <input x-model="brokerForm.name" placeholder="名称" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5" />
        </div>
        <template x-if="brokerForm.broker_type === 'alpaca'"><div class="grid grid-cols-2 gap-2 mb-2"><input x-model="brokerForm.api_key" placeholder="API Key" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono" /><input x-model="brokerForm.api_secret" type="password" placeholder="Secret" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono" /></div></template>
        <template x-if="brokerForm.broker_type === 'ibkr'"><div class="grid grid-cols-2 gap-2 mb-2"><input x-model="brokerForm.account_id" placeholder="账户ID" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono" /><input x-model="brokerForm.gateway_url" placeholder="Gateway URL" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono" /></div></template>
        <template x-if="brokerForm.broker_type === 'tradier'"><div class="mb-2"><input x-model="brokerForm.access_token" type="password" placeholder="Access Token" class="w-full text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono" /></div></template>
        <template x-if="brokerForm.broker_type === 'tiger'"><div class="grid grid-cols-2 gap-2 mb-2"><input x-model="brokerForm.tiger_id" placeholder="Tiger ID" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono" /><textarea x-model="brokerForm.private_key" placeholder="RSA Key" class="text-xs border border-warm-300 rounded-lg px-2 py-1.5 font-mono h-12"></textarea></div></template>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-1 text-[10px] text-ink-500 cursor-pointer"><input type="checkbox" x-model="brokerForm.paper_trading" class="rounded" checked /> 模拟盘</label>
          <button @click="addBroker()" :disabled="!brokerForm.name?.trim()" class="btn btn-primary btn-sm text-[10px]">添加</button>
        </div>
      </div>
      <div x-show="brokerMsg" class="mt-2 text-xs" :class="brokerMsg.includes('成功') || brokerMsg.includes('connected') ? 'text-green-600' : 'text-red-500'" x-text="brokerMsg"></div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  Section 1: 我的持仓 — 页面主角                    -->
  <!-- ═══════════════════════════════════════════════════ -->
  <template x-if="brokerPositions.length > 0">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <h2 class="text-sm font-bold text-ink-700">我的持仓</h2>
        <span class="text-xs text-ink-400" x-text="activeBrokerName"></span>
        <span class="status-dot green"></span>
        <button @click="refreshBroker()" class="text-[10px] text-brand-500 hover:text-brand-700 ml-auto">刷新</button>
      </div>

      <!-- 账户概要 — 紧凑一行 -->
      <template x-if="brokerAccount?.ok">
        <div class="flex gap-4 mb-3 text-xs text-ink-500 bg-warm-50 rounded-lg px-3 py-2">
          <span>现金 <b class="text-ink-700" x-text="'$' + (brokerAccount.balance?.toLocaleString(undefined,{minimumFractionDigits:0}) || '--')"></b></span>
          <span>购买力 <b class="text-ink-700" x-text="'$' + (brokerAccount.buyingPower?.toLocaleString(undefined,{minimumFractionDigits:0}) || '--')"></b></span>
          <span>净值 <b class="text-ink-700" x-text="'$' + (brokerAccount.netLiquidation?.toLocaleString(undefined,{minimumFractionDigits:0}) || '--')"></b></span>
          <span>持仓 <b class="text-ink-700" x-text="'$' + (brokerAccount.grossPosition?.toLocaleString(undefined,{minimumFractionDigits:0}) || '--')"></b></span>
        </div>
      </template>

      <!-- 持仓卡片 — 统一卡片样式 + Agent 分析 + 同行 -->
      <div class="space-y-3">
        <template x-for="p in brokerPositions" :key="p.conid || p.symbol">
          <div class="bg-white rounded-xl border border-warm-200 overflow-hidden hover:border-brand-300 transition-colors">
            <!-- Header: symbol + price -->
            <div class="p-4 flex items-start justify-between">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-lg font-bold text-ink-700" x-text="p.symbol"></span>
                  <template x-if="fundData[p.symbol]?.industry">
                    <span class="badge badge-neutral text-[9px]" x-text="fundData[p.symbol].industry"></span>
                  </template>
                  <span class="text-xs text-ink-400 truncate" x-text="quotes[p.symbol]?.name || ''"></span>
                </div>
                <!-- 持仓信息 — 醒目 -->
                <div class="flex items-center gap-3 mt-1">
                  <span class="text-xs font-medium text-ink-600" x-text="p.qty + ' 股'"></span>
                  <span class="text-xs text-ink-400" x-text="'成本 $' + (p.avgCost?.toFixed(2) || '--')"></span>
                  <template x-if="p.pnlPct != null">
                    <span class="text-xs font-bold px-1.5 py-0.5 rounded"
                      :class="p.pnlPct >= 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'"
                      x-text="(p.pnlPct >= 0 ? '+' : '') + p.pnlPct.toFixed(1) + '%'"></span>
                  </template>
                  <template x-if="p.marketValue">
                    <span class="text-xs text-ink-400" x-text="'市值 $' + p.marketValue.toLocaleString(undefined,{minimumFractionDigits:0})"></span>
                  </template>
                </div>
              </div>
              <div class="text-right flex-shrink-0 ml-4">
                <template x-if="quotes[p.symbol]">
                  <div>
                    <div class="text-xl font-bold text-ink-700" x-text="'$' + quotes[p.symbol].price?.toFixed(2)"></div>
                    <div class="text-sm font-semibold"
                      :class="quotes[p.symbol].change24h > 0 ? 'text-green-600' : quotes[p.symbol].change24h < 0 ? 'text-red-500' : 'text-ink-400'"
                      x-text="quotes[p.symbol].change24h != null ? (quotes[p.symbol].change24h > 0 ? '+' : '') + quotes[p.symbol].change24h.toFixed(2) + '%' : '--'"></div>
                  </div>
                </template>
              </div>
              <button @click="prepareOrder(p.symbol, p.conid, 'SELL', p.qty)" class="ml-2 text-ink-200 hover:text-red-500 transition-colors text-xs">卖出</button>
            </div>

            <!-- 同行对比 -->
            <template x-if="getPeersForStock(p.symbol).length > 0">
              <div class="px-4 pb-3">
                <div class="text-[10px] font-medium text-ink-400 mb-2">
                  <span>同行对比</span>
                  <template x-if="getDivergence(p.symbol) && Math.abs(getDivergence(p.symbol).value) >= divergenceThreshold">
                    <span class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-semibold"
                      :class="getDivergence(p.symbol).value > 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'"
                      x-text="p.symbol + ' 偏离同行 ' + (getDivergence(p.symbol).value > 0 ? '+' : '') + getDivergence(p.symbol).value + '%'"></span>
                  </template>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="peer in getPeersForStock(p.symbol)" :key="peer.symbol">
                    <div class="flex items-center gap-1.5 bg-warm-50 rounded-md px-2 py-1">
                      <span class="text-[11px] font-bold text-ink-600" x-text="peer.symbol"></span>
                      <span class="text-[10px] text-ink-500" x-text="peer.price != null ? '$' + peer.price.toFixed(0) : ''"></span>
                      <span class="text-[10px] font-medium"
                        :class="peer.change24h > 0 ? 'text-green-600' : peer.change24h < 0 ? 'text-red-500' : 'text-ink-300'"
                        x-text="peer.change24h != null ? (peer.change24h > 0 ? '+' : '') + peer.change24h.toFixed(1) + '%' : ''"></span>
                    </div>
                  </template>
                </div>
              </div>
            </template>

            <!-- 问 Agent -->
            <div class="px-4 pb-4">
              <button @click="askStockAgent(p.symbol)" :disabled="_getChat(p.symbol).asking"
                class="btn btn-sm btn-secondary text-[10px]"
                x-text="_getChat(p.symbol).asking ? '分析中...' : _getChat(p.symbol).reply ? '再问一次' : '问 Agent'"></button>
              <template x-if="_getChat(p.symbol).reply">
                <div class="mt-3 border border-brand-200 rounded-xl p-4 bg-brand-50/20">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-5 h-5 rounded-full bg-brand-500 text-white text-[10px] flex items-center justify-center font-bold">A</span>
                    <span class="text-xs font-medium text-brand-700">Agent</span>
                    <button @click="_getChat(p.symbol).reply = null; _getChat(p.symbol).history = null" class="ml-auto text-[10px] text-ink-300 hover:text-ink-500">结束对话</button>
                  </div>
                  <template x-if="_getChat(p.symbol).history?.length > 0">
                    <div class="space-y-2 mb-3">
                      <template x-for="(msg, mi) in _getChat(p.symbol).history" :key="mi">
                        <div class="text-sm leading-relaxed whitespace-pre-line"
                          :class="msg.role === 'agent' ? 'text-ink-600' : 'text-brand-700 bg-brand-50 rounded-lg px-3 py-1.5'"
                          x-text="msg.text"></div>
                      </template>
                    </div>
                  </template>
                  <div x-show="!_getChat(p.symbol).history?.length" class="text-sm text-ink-600 leading-relaxed whitespace-pre-line mb-3" x-text="_getChat(p.symbol).reply"></div>
                  <div class="flex gap-2">
                    <input type="text" x-model="_getChat(p.symbol).input" @keydown.enter="replyStockAgent(p.symbol)"
                      :disabled="_getChat(p.symbol).asking" placeholder="继续问..."
                      class="flex-1 text-sm border border-warm-300 rounded-lg px-3 py-1.5" />
                    <button @click="replyStockAgent(p.symbol)" :disabled="_getChat(p.symbol).asking || !_getChat(p.symbol).input"
                      class="btn btn-sm btn-primary text-[10px]" x-text="_getChat(p.symbol).asking ? '...' : '发送'"></button>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>

      <!-- 活跃订单 -->
      <template x-if="brokerOrders.length > 0">
        <div class="card mt-3">
          <div class="text-xs font-medium text-ink-700 mb-2">活跃订单</div>
          <div class="divide-y divide-warm-100">
            <template x-for="o in brokerOrders" :key="o.orderId">
              <div class="flex items-center gap-3 py-2">
                <span class="badge text-[9px]" :class="o.side==='BUY'?'badge-success':'badge-error'" x-text="o.side"></span>
                <span class="font-bold text-ink-700 text-xs" x-text="o.symbol"></span>
                <span class="text-xs text-ink-500" x-text="o.qty + ' 股'"></span>
                <span class="text-xs text-ink-400" x-text="o.orderType + (o.price ? ' $' + o.price : '')"></span>
                <span class="badge badge-neutral text-[8px] ml-auto" x-text="o.status"></span>
                <button @click="cancelBrokerOrder(o.orderId)" class="text-red-400 hover:text-red-600 text-xs">撤单</button>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </template>

  <!-- 无持仓提示 -->
  <template x-if="showPositionPanel && brokerPositions.length === 0">
    <div class="card mb-5 text-center text-ink-300 py-6">
      <p class="text-sm">券商已连接，暂无持仓</p>
    </div>
  </template>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  Section 2: 自选观察 — 辅助                        -->
  <!-- ═══════════════════════════════════════════════════ -->
  <template x-if="watchlist.length > 0">
    <div class="mb-5">
      <div class="flex items-center gap-2 mb-3">
        <h2 class="text-sm font-bold text-ink-700">自选观察</h2>
        <span class="text-xs text-ink-300" x-text="watchlist.length + ' 只'"></span>
      </div>

      <div class="space-y-3">
        <template x-for="item in watchlist" :key="item.id">
          <div class="bg-white rounded-xl border border-warm-200 overflow-hidden hover:border-brand-300 transition-colors">
            <!-- Header -->
            <div class="p-4 flex items-start justify-between">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-lg font-bold text-ink-700" x-text="item.symbol"></span>
                  <span class="badge text-[10px]" :class="item.market === 'us' ? 'badge-info' : item.market === 'hk' ? 'badge-warning' : 'badge-neutral'" x-text="item.market?.toUpperCase()"></span>
                  <template x-if="fundData[item.symbol]?.industry">
                    <span class="badge badge-neutral text-[9px]" x-text="fundData[item.symbol].industry"></span>
                  </template>
                </div>
                <div class="text-xs text-ink-400" x-text="quotes[item.symbol]?.name || item.name || ''"></div>
                <template x-if="quotes[item.symbol]?.high52w">
                  <div class="mt-2 flex items-center gap-2">
                    <span class="text-[10px] text-ink-300" x-text="'$' + quotes[item.symbol].low52w?.toFixed(0)"></span>
                    <div class="flex-1 h-1.5 bg-warm-200 rounded-full relative">
                      <div class="absolute h-full bg-brand-400 rounded-full"
                        :style="'width:' + Math.max(2, Math.min(98, ((quotes[item.symbol].price - quotes[item.symbol].low52w) / (quotes[item.symbol].high52w - quotes[item.symbol].low52w) * 100))) + '%'"></div>
                    </div>
                    <span class="text-[10px] text-ink-300" x-text="'$' + quotes[item.symbol].high52w?.toFixed(0)"></span>
                  </div>
                </template>
              </div>
              <div class="text-right flex-shrink-0 ml-4">
                <template x-if="quotes[item.symbol]">
                  <div>
                    <div class="text-xl font-bold text-ink-700" x-text="'$' + quotes[item.symbol].price?.toFixed(2)"></div>
                    <div class="text-sm font-semibold"
                      :class="quotes[item.symbol].change24h > 0 ? 'text-green-600' : quotes[item.symbol].change24h < 0 ? 'text-red-500' : 'text-ink-400'"
                      x-text="quotes[item.symbol].change24h != null ? (quotes[item.symbol].change24h > 0 ? '+' : '') + quotes[item.symbol].change24h.toFixed(2) + '%' : '--'"></div>
                  </div>
                </template>
                <template x-if="!quotes[item.symbol] && !loading"><span class="text-xs text-ink-300">--</span></template>
                <template x-if="loading"><div class="skeleton" style="width:60px;height:24px;"></div></template>
              </div>
              <button @click="removeStock(item.id)" class="ml-2 text-ink-200 hover:text-red-500 transition-colors text-sm">&times;</button>
            </div>

            <!-- 同行对比 -->
            <template x-if="getPeersForStock(item.symbol).length > 0">
              <div class="px-4 pb-4">
                <div class="text-[10px] font-medium text-ink-400 mb-2">
                  <span>同行对比</span>
                  <template x-if="getDivergence(item.symbol) && Math.abs(getDivergence(item.symbol).value) >= divergenceThreshold">
                    <span class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-semibold"
                      :class="getDivergence(item.symbol).value > 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'"
                      x-text="item.symbol + ' 偏离同行 ' + (getDivergence(item.symbol).value > 0 ? '+' : '') + getDivergence(item.symbol).value + '%'"></span>
                  </template>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="peer in getPeersForStock(item.symbol)" :key="peer.symbol">
                    <div class="flex items-center gap-1.5 bg-warm-50 rounded-md px-2 py-1">
                      <span class="text-[11px] font-bold text-ink-600" x-text="peer.symbol"></span>
                      <span class="text-[10px] text-ink-500" x-text="peer.price != null ? '$' + peer.price.toFixed(0) : ''"></span>
                      <span class="text-[10px] font-medium"
                        :class="peer.change24h > 0 ? 'text-green-600' : peer.change24h < 0 ? 'text-red-500' : 'text-ink-300'"
                        x-text="peer.change24h != null ? (peer.change24h > 0 ? '+' : '') + peer.change24h.toFixed(1) + '%' : ''"></span>
                    </div>
                  </template>
                </div>
              </div>
            </template>

            <!-- 问 Agent -->
            <div class="px-4 pb-4">
              <button @click="askStockAgent(item.symbol)" :disabled="_getChat(item.symbol).asking"
                class="btn btn-sm btn-secondary text-[10px]"
                x-text="_getChat(item.symbol).asking ? '分析中...' : _getChat(item.symbol).reply ? '再问一次' : '问 Agent'"></button>
              <template x-if="_getChat(item.symbol).reply">
                <div class="mt-3 border border-brand-200 rounded-xl p-4 bg-brand-50/20">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-5 h-5 rounded-full bg-brand-500 text-white text-[10px] flex items-center justify-center font-bold">A</span>
                    <span class="text-xs font-medium text-brand-700">Agent</span>
                    <button @click="_getChat(item.symbol).reply = null; _getChat(item.symbol).history = null" class="ml-auto text-[10px] text-ink-300 hover:text-ink-500">结束对话</button>
                  </div>
                  <template x-if="_getChat(item.symbol).history?.length > 0">
                    <div class="space-y-2 mb-3">
                      <template x-for="(msg, mi) in _getChat(item.symbol).history" :key="mi">
                        <div class="text-sm leading-relaxed whitespace-pre-line"
                          :class="msg.role === 'agent' ? 'text-ink-600' : 'text-brand-700 bg-brand-50 rounded-lg px-3 py-1.5'"
                          x-text="msg.text"></div>
                      </template>
                    </div>
                  </template>
                  <div x-show="!_getChat(item.symbol).history?.length" class="text-sm text-ink-600 leading-relaxed whitespace-pre-line mb-3" x-text="_getChat(item.symbol).reply"></div>
                  <div class="flex gap-2">
                    <input type="text" x-model="_getChat(item.symbol).input" @keydown.enter="replyStockAgent(item.symbol)"
                      :disabled="_getChat(item.symbol).asking" placeholder="继续问..."
                      class="flex-1 text-sm border border-warm-300 rounded-lg px-3 py-1.5" />
                    <button @click="replyStockAgent(item.symbol)" :disabled="_getChat(item.symbol).asking || !_getChat(item.symbol).input"
                      class="btn btn-sm btn-primary text-[10px]" x-text="_getChat(item.symbol).asking ? '...' : '发送'"></button>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- 无内容提示 -->
  <div x-show="watchlist.length === 0 && brokerPositions.length === 0 && !loading" class="text-center text-ink-300 py-12">
    <p>尚无持仓或自选股</p>
    <p class="text-xs mt-1">连接券商查看持仓，或添加自选股开始观察</p>
  </div>
  <div x-show="loading && watchlist.length === 0 && brokerPositions.length === 0" class="text-center text-ink-300 py-12">加载中...</div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  Commodities bar                                   -->
  <!-- ═══════════════════════════════════════════════════ -->
  <template x-if="commodities && Object.keys(commodities).length > 0">
    <div class="flex gap-3 mb-5 overflow-x-auto">
      <template x-for="[name, data] in Object.entries(commodities)" :key="name">
        <div class="flex-shrink-0 bg-white rounded-lg border border-warm-200 px-4 py-2.5 min-w-[120px]">
          <div class="text-[10px] text-ink-400" x-text="name"></div>
          <div class="text-sm font-bold text-ink-700" x-text="'$' + data.price?.toFixed(1)"></div>
          <div class="text-[10px]" :class="data.change24h > 0 ? 'text-green-600' : data.change24h < 0 ? 'text-red-500' : 'text-ink-300'"
            x-text="data.change24h != null ? (data.change24h > 0 ? '+' : '') + data.change24h.toFixed(2) + '%' : '--'"></div>
        </div>
      </template>
    </div>
  </template>


</div>

<script>
function stocksPage() {
  return {
    watchlist: [],
    quotes: {},
    commodities: {},
    funding: {},
    sentiment: null,
    fundData: {},
    peersData: {},
    healthData: {},
    divergenceThreshold: 3,
    loading: true,
    showAdd: false,
    showTools: false,
    selectedAgent: '<%= it.relayNodes?.[0]?.id || "" %>',
    _stockChat: {},  // { TSLA: { asking, reply, history, input } }
    addSymbol: '', addMarket: 'us', adding: false, addError: '',
    // 券商
    brokers: [],
    brokerForm: { broker_type: 'alpaca', name: '', account_id: '', gateway_url: 'https://localhost:5000', api_key: '', api_secret: '', access_token: '', tiger_id: '', private_key: '', paper_trading: true },
    brokerMsg: '',
    testing: false,
    showPositionPanel: false,
    activeBrokerId: null,
    activeBrokerName: '',
    activeBrokerAccount: '',
    brokerAccount: null,
    brokerPositions: [],
    brokerOrders: [],
    searchQuery: '', searchResults: [], searching: false,
    orderForm: { symbol: '', conid: null, side: 'BUY', qty: 1, type: 'market', price: 0 },
    ordering: false, orderMsg: '',

    async init() {
      await Promise.all([this.loadAll(), this.loadBrokers()]);
      const connected = this.brokers.find(b => b.status === 'connected');
      if (connected) await this.viewBroker(connected.id);
      // 加载基本面时包含持仓 symbol
      await this.loadFundamentals();
      // 为持仓股票也拉行情
      await this.loadPositionQuotes();
      setInterval(() => this.loadQuotes(), 5 * 60 * 1000);
      setInterval(() => this.loadFundamentals(), 60 * 60 * 1000);
    },

    async loadAll() {
      this.loading = true;
      try {
        const res = await fetch('/api/stocks/overview');
        const data = await res.json();
        this.watchlist = data.watchlist || [];
        this.quotes = data.quotes?.data || {};
        this.commodities = data.commodities?.data || {};
        this.funding = data.funding?.data || {};
        this.sentiment = data.sentiment?.data?.fearGreed || null;
      } catch (e) { console.error(e); }
      this.loading = false;
    },

    async loadQuotes() {
      try {
        const res = await fetch('/api/stocks/quotes');
        const data = await res.json();
        if (data.ok) this.quotes = { ...this.quotes, ...(data.data || {}) };
      } catch {}
      await this.loadPositionQuotes();
    },

    /** 为 broker 持仓股票拉行情（它们可能不在 watchlist 里） */
    async loadPositionQuotes() {
      const posSymbols = this.brokerPositions.map(p => p.symbol).filter(s => !this.quotes[s]);
      for (const sym of posSymbols) {
        try {
          const res = await fetch('/api/stocks/quote/' + encodeURIComponent(sym));
          const data = await res.json();
          if (data?.price) this.quotes[sym] = data;
        } catch {}
      }
    },

    async loadFundamentals() {
      try {
        // 把持仓 symbol 也传给 API，这样持仓也能有基本面分析
        const posSymbols = this.brokerPositions.map(p => p.symbol);
        const extra = posSymbols.length > 0 ? '?extra=' + posSymbols.join(',') : '';
        const res = await fetch('/api/stocks/fundamentals' + extra);
        const data = await res.json();
        this.fundData = data.stocks || {};
        this.peersData = data.peers || {};
        this.healthData = data.health || {};
        if (data.threshold) this.divergenceThreshold = data.threshold;
      } catch (e) { console.error('loadFundamentals:', e); }
    },

    getPeersForStock(symbol) {
      const industry = this.fundData[symbol]?.industry;
      if (!industry) return [];
      return this.peersData[industry] || [];
    },

    getDivergence(symbol) {
      const myChange = this.quotes[symbol]?.change24h;
      const peers = this.getPeersForStock(symbol);
      if (myChange == null || peers.length === 0) return null;
      const peerChanges = peers.map(p => p.change24h).filter(c => c != null);
      if (peerChanges.length === 0) return null;
      const peerAvg = peerChanges.reduce((a, b) => a + b, 0) / peerChanges.length;
      return { value: +(myChange - peerAvg).toFixed(1), myChange, peerAvg };
    },

    fmtRevenue(v) {
      if (!v) return '—';
      if (v >= 1e12) return (v / 1e12).toFixed(1) + 'T';
      if (v >= 1e9) return (v / 1e9).toFixed(1) + 'B';
      if (v >= 1e6) return (v / 1e6).toFixed(0) + 'M';
      return v.toLocaleString();
    },

    /** 构造股票上下文 prompt — Agent 自动知道你在看什么 */
    _buildStockContext(symbol) {
      const q = this.quotes[symbol];
      const f = this.fundData[symbol];
      const pos = this.brokerPositions.find(p => p.symbol === symbol);
      let ctx = `股票: ${symbol}`;
      if (q) ctx += ` 当前价 $${q.price?.toFixed(2)} 今日${q.change24h > 0 ? '+' : ''}${q.change24h?.toFixed(2)}%`;
      if (pos) ctx += `\n你的持仓: ${pos.qty}股 成本$${pos.avgCost?.toFixed(2)} 盈亏${pos.pnlPct?.toFixed(1)}%`;
      if (f) {
        if (f.industry) ctx += `\n行业: ${f.industry}`;
        if (f.recommendationKey) ctx += ` 分析师评级: ${f.recommendationKey}(${f.numberOfAnalysts}人)`;
        if (f.targetMeanPrice) ctx += ` 目标价$${f.targetMeanPrice.toFixed(0)}`;
        if (f.revenue) ctx += `\n营收${this.fmtRevenue(f.revenue)} 利润率${f.profitMargin?.toFixed(1)}% Beta${f.beta?.toFixed(1)}`;
      }
      const peers = this.getPeersForStock(symbol);
      if (peers.length > 0) ctx += `\n同行: ${peers.map(p => p.symbol + ' $' + p.price?.toFixed(0) + ' ' + (p.change24h > 0 ? '+' : '') + p.change24h?.toFixed(1) + '%').join(', ')}`;
      ctx += `\n\nIMPORTANT: You have a connected broker (IBKR). To execute stock trades, you MUST use ACTION tags:`;
      ctx += `\n  [ACTION:BROKER_ORDER symbol=${symbol} side=BUY qty=3 type=market]`;
      ctx += `\n  [ACTION:BROKER_ORDER symbol=${symbol} side=SELL qty=5 type=limit price=430]`;
      ctx += `\nDo NOT pretend to execute trades with text. Only ACTION tags trigger real orders.`;
      ctx += `\nMax 10 shares per order. Owner has requested this trade — you have permission to execute.`;
      return ctx;
    },

    _getChat(symbol) {
      if (!this._stockChat[symbol]) this._stockChat[symbol] = { asking: false, reply: null, history: null, input: '' };
      return this._stockChat[symbol];
    },

    async askStockAgent(symbol) {
      const chat = this._getChat(symbol);
      if (chat.asking) return;
      chat.asking = true; chat.reply = null;
      const ctx = this._buildStockContext(symbol);
      const question = `${ctx}\n\n请分析这只股票：1) 你怎么看当前走势？2) 主要风险是什么？3) 你的建议？`;
      try {
        const res = await fetch('/api/agent/reply', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.selectedAgent, peer: 'owner:stocks', message: question }) });
        const data = await res.json();
        chat.reply = data.reply || data.error || '无回复';
        chat.history = [{ role: 'agent', text: chat.reply }];
      } catch (e) { chat.reply = '分析失败: ' + e.message; }
      chat.asking = false;
    },

    async replyStockAgent(symbol) {
      const chat = this._getChat(symbol);
      const msg = (chat.input || '').trim();
      if (!msg || chat.asking) return;
      chat.asking = true; chat.input = '';
      if (!chat.history) chat.history = [];
      chat.history.push({ role: 'user', text: msg });
      const ctx = this._buildStockContext(symbol);
      try {
        const res = await fetch('/api/agent/reply', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.selectedAgent, peer: 'owner:stocks', message: `${ctx}\n\n用户说: ${msg}` }) });
        const data = await res.json();
        chat.history.push({ role: 'agent', text: data.reply || data.error || '无回复' });
      } catch (e) { chat.history.push({ role: 'agent', text: '回复失败: ' + e.message }); }
      chat.asking = false;
    },

    async addStock() {
      if (!this.addSymbol.trim() || this.adding) return;
      this.adding = true; this.addError = '';
      try {
        const res = await fetch('/api/stocks/watchlist', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: this.addSymbol.trim(), market: this.addMarket }) });
        const data = await res.json();
        if (!res.ok) { this.addError = data.error || 'failed'; this.adding = false; return; }
        this.addSymbol = '';
        await this.loadAll();
        await this.loadFundamentals();
      } catch (e) { this.addError = e.message; }
      this.adding = false;
    },

    async removeStock(id) {
      if (!confirm('删除此自选股？')) return;
      await fetch('/api/stocks/watchlist/' + id, { method: 'DELETE' });
      await this.loadAll();
    },

    async loadBrokers() {
      try { this.brokers = await (await fetch('/api/broker/accounts')).json(); } catch { this.brokers = []; }
    },
    async addBroker() {
      this.brokerMsg = '';
      try {
        const res = await fetch('/api/broker/accounts', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...this.brokerForm, paper_trading: this.brokerForm.paper_trading ? 1 : 0 }) });
        const data = await res.json();
        if (data.ok) {
          this.brokerMsg = '添加成功，请点击"测试"验证';
          this.brokerForm = { broker_type: 'alpaca', name: '', account_id: '', gateway_url: 'https://localhost:5000', api_key: '', api_secret: '', access_token: '', tiger_id: '', private_key: '', paper_trading: true };
          await this.loadBrokers();
        } else { this.brokerMsg = '失败: ' + (data.error || ''); }
      } catch (e) { this.brokerMsg = '失败: ' + e.message; }
    },
    async testBroker(id) {
      this.testing = true; this.brokerMsg = '测试中...';
      try {
        const data = await (await fetch('/api/broker/accounts/' + id + '/test', { method: 'POST' })).json();
        this.brokerMsg = data.ok ? '连接成功' : '失败: ' + (data.error || '');
        await this.loadBrokers();
      } catch (e) { this.brokerMsg = '失败: ' + e.message; }
      this.testing = false;
    },
    async removeBroker(id) {
      if (!confirm('删除此券商？')) return;
      await fetch('/api/broker/accounts/' + id, { method: 'DELETE' });
      await this.loadBrokers();
      if (this.activeBrokerId === id) this.showPositionPanel = false;
    },
    async viewBroker(id) {
      this.activeBrokerId = id;
      const broker = this.brokers.find(b => b.id === id);
      this.activeBrokerName = broker?.name || '';
      this.activeBrokerAccount = broker?.account_id || '';
      this.showPositionPanel = true;
      await this.refreshBroker();
    },
    async refreshBroker() {
      if (!this.activeBrokerId) return;
      const id = this.activeBrokerId;
      try {
        const [accRes, posRes, ordRes] = await Promise.all([
          fetch('/api/broker/' + id + '/account'),
          fetch('/api/broker/' + id + '/positions'),
          fetch('/api/broker/' + id + '/orders'),
        ]);
        this.brokerAccount = await accRes.json();
        this.brokerPositions = (await posRes.json()).positions || [];
        this.brokerOrders = (await ordRes.json()).orders || [];
      } catch (e) { console.error('broker:', e); }
    },
    async disconnectBroker() {
      if (!this.activeBrokerId || !confirm('断开？')) return;
      await fetch('/api/broker/accounts/' + this.activeBrokerId, { method: 'DELETE' });
      this.showPositionPanel = false; this.activeBrokerId = null;
      await this.loadBrokers();
    },
    async searchStock() {
      if (!this.searchQuery.trim() || !this.activeBrokerId || this.searching) return;
      this.searching = true; this.searchResults = [];
      try { this.searchResults = await (await fetch('/api/broker/' + this.activeBrokerId + '/search?q=' + encodeURIComponent(this.searchQuery.trim()))).json(); } catch {}
      this.searching = false;
    },
    prepareOrder(symbol, conid, side, qty) {
      this.orderForm = { symbol, conid, side: side || 'BUY', qty: qty || 1, type: 'market', price: 0 };
      this.orderMsg = ''; this.showTools = true;
    },
    async submitBrokerOrder() {
      if (!this.activeBrokerId || !this.orderForm.symbol || this.ordering) return;
      this.ordering = true; this.orderMsg = '';
      try {
        const data = await (await fetch('/api/broker/' + this.activeBrokerId + '/order', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ symbol: this.orderForm.symbol, conid: this.orderForm.conid, side: this.orderForm.side, qty: this.orderForm.qty, type: this.orderForm.type, price: this.orderForm.type === 'limit' ? this.orderForm.price : undefined }) })).json();
        if (data.ok) { this.orderMsg = '下单成功 #' + (data.orderId || ''); this.orderForm.symbol = ''; setTimeout(() => this.refreshBroker(), 2000); }
        else { this.orderMsg = '失败: ' + (data.error || ''); }
      } catch (e) { this.orderMsg = '失败: ' + e.message; }
      this.ordering = false;
    },
    async cancelBrokerOrder(orderId) {
      if (!this.activeBrokerId || !confirm('撤销？')) return;
      await fetch('/api/broker/' + this.activeBrokerId + '/order/' + orderId, { method: 'DELETE' });
      setTimeout(() => this.refreshBroker(), 1000);
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

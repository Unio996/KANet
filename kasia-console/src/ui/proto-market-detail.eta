<%~ include('partials/page-open', { _page: 'proto-market-detail', pageTitle: '市场详情（原型）', ...it }) %>

<!-- 原型 v0.5(1325 派工·线框稿 §3/§4, Bettor 1328 裁定; v0.5 = D-020 必然改动, 账本1446/1448/1450/1451,
     读 J2 已推分支 coord/j2-market-genesis-bet-mint 40f90d9b 源码字段对齐, 仅对齐单步契约, 无新增交互):
     独立新页, 下注+结算/领取合并一屏。非 ZK 简单路径: 出单人到期手动宣布结果 → 赢家 claim; 无人宣布 →
     全员 refund/cancelled。
     🔴 D-020 取消了原两步"铸筹码→下注"设计(KTT 免费无限铸造, 独立 stake 筹码只制造一个可被第三方
     整笔取走的中间 UTXO, 不证明任何事)——下注现在是 register_append **一笔**交易。POST .../bet 成功
     返回 **202 {ok:true, id:betId, status}**(status 来自 proto_bets.status, pending→confirmed), 无
     steps 字段; 驱动未开启返回 **409 {error:'proto_driver_disabled'}**——前端据此显示专属提示而非笼统
     "下注失败"。没有单笔下注的 GET 端点, 轮询用 GET /api/proto-markets/:id 的 bets[] 数组按 id 找自己
     那笔(读 proto.js 源码确认过, 没有就不发明端点)。
     GET /api/proto-markets/:id 响应形状是 { ok, market, bets, claims }(不是直接就是 market 对象);
     market 行字段 = proto_markets 表原样(question/token_ticker/deadline_ms/status/winning_side, 见
     kasia-console/src/db/migrate.js v206), status CHECK IN (betting/sealed/resolved/cancelled)。
     resolutionNote 目前后端 DB 里还没有对应列(J2 §2.3 TODO), 可能显示为空, 不是 bug。 -->

<div class="p-6 max-w-2xl mx-auto" x-data="protoMarketDetailPage()" x-init="init()" x-cloak>

  <div x-show="loading" class="text-center py-12 text-ink-400">载入中...</div>
  <div x-show="!loading && loadFailed" class="text-center py-12 bg-red-50 rounded-lg text-red-600 text-sm">
    加载失败：<span x-text="loadFailed"></span>（后端接口尚未上线，或该市场不存在）
  </div>

  <template x-if="!loading && !loadFailed && market">
    <div class="space-y-5">
      <div class="card p-6">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] px-1.5 py-0.5 rounded font-medium" :class="statusBadge(market.status)" x-text="statusLabel(market.status)"></span>
          <span class="text-xs text-ink-400">结算代币: <span x-text="market.token_ticker || '?'"></span></span>
        </div>
        <h1 class="text-xl font-display text-ink-800" x-text="market.question"></h1>
        <p class="text-xs text-ink-400 mt-1" x-show="market.resolutionNote" x-text="market.resolutionNote"></p>
        <p class="text-xs text-ink-400 mt-1">截止: <span x-text="fmtDeadline(market.deadline_ms)"></span></p>
      </div>

      <!-- 下注面板(仅 betting 态) — D-020: 单笔交易, 202 后按 id 轮询 bets[] 里自己那笔的 status -->
      <template x-if="market.status === 'betting'">
        <div class="card p-6 space-y-3">
          <h2 class="text-sm font-semibold text-ink-700">下注</h2>
          <div class="flex gap-2">
            <button @click="bet.direction = 0" class="btn flex-1" :class="bet.direction === 0 ? 'btn-primary' : 'btn-ghost'">YES</button>
            <button @click="bet.direction = 1" class="btn flex-1" :class="bet.direction === 1 ? 'btn-danger' : 'btn-ghost'">NO</button>
          </div>
          <div>
            <label class="text-xs text-ink-400">数量（<span x-text="market.token_ticker || '?'"></span>）</label>
            <input x-model.number="bet.amount" type="number" min="0" step="any"
              class="w-full mt-1 border border-warm-300 rounded-lg px-3 py-2 text-sm focus:border-brand-400 focus:outline-none bg-warm-50">
          </div>

          <!-- 提交后状态: pending(轮询中)→confirmed -->
          <div x-show="betId" class="flex items-center gap-2 text-xs border border-warm-200 rounded-lg p-3 bg-warm-50">
            <span x-text="betStatus === 'confirmed' ? '✓' : '◉'"></span>
            <span class="font-medium" x-text="betStatusLabel(betStatus)"></span>
            <span class="text-ink-400 font-mono text-[10px]" x-show="betId" x-text="betId ? betId.slice(0,8)+'...' : ''"></span>
          </div>

          <div x-show="betError" class="text-xs text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2" x-text="betError"></div>
          <button @click="placeBet()" :disabled="betSubmitting || !(bet.direction !== null && bet.amount > 0)" class="btn btn-primary w-full">
            <span x-show="!betSubmitting">提交下注</span>
            <span x-show="betSubmitting">提交中...</span>
          </button>
        </div>
      </template>

      <!-- 出单人宣布结果面板(betting/sealed 态; 后端实际只在 sealed 才接受 resolve, betting 态点了会
           收到 409, 如实透传——前端不模拟 betting→sealed 的自动切换, 那是后端状态机的事) -->
      <template x-if="market.status === 'betting' || market.status === 'sealed'">
        <div class="card p-6 space-y-3">
          <h2 class="text-sm font-semibold text-ink-700">出单人：宣布结果</h2>
          <p class="text-[11px] text-ink-300">只有本市场出单人的操作会被接受；非出单人调用后端会拒绝。</p>
          <div class="flex gap-2">
            <button @click="resolveOutcome(0)" :disabled="resolveSubmitting" class="btn btn-ghost flex-1">判 YES 赢</button>
            <button @click="resolveOutcome(1)" :disabled="resolveSubmitting" class="btn btn-ghost flex-1">判 NO 赢</button>
          </div>
          <div x-show="resolveMsg" class="text-xs" :class="resolveOk ? 'text-emerald-700' : 'text-red-600'" x-text="resolveMsg"></div>
        </div>
      </template>

      <!-- 领取面板(resolved/cancelled 态) -->
      <template x-if="market.status === 'resolved' || market.status === 'cancelled'">
        <div class="card p-6 space-y-3">
          <h2 class="text-sm font-semibold text-ink-700">领取</h2>
          <p class="text-xs text-ink-500" x-show="market.status === 'resolved'">结果：<span class="font-medium" x-text="market.winning_side === 0 ? 'YES 赢' : 'NO 赢'"></span></p>
          <p class="text-xs text-ink-500" x-show="market.status === 'cancelled'">市场已取消/退款。</p>
          <div x-show="claimMsg" class="text-xs" :class="claimOk ? 'text-emerald-700' : 'text-red-600'" x-text="claimMsg"></div>
          <button @click="claim()" :disabled="claimSubmitting" class="btn btn-primary w-full">
            <span x-show="!claimSubmitting">Claim</span>
            <span x-show="claimSubmitting">处理中...</span>
          </button>
        </div>
      </template>
    </div>
  </template>
</div>

<script>
function protoMarketDetailPage() {
  const marketId = location.pathname.split('/').filter(Boolean).pop();
  return {
    marketId,
    loading: true,
    loadFailed: '',
    market: null,
    bet: { direction: null, amount: null },
    betSubmitting: false, betError: '',
    betId: null, betStatus: null, _betPollTimer: null,
    resolveSubmitting: false, resolveMsg: '', resolveOk: false,
    claimSubmitting: false, claimMsg: '', claimOk: false,

    // GET /api/proto-markets/:id 响应形状 { ok, market, bets, claims } — market 在 data.market 里,
    // 不是响应体本身(读 J2 proto.js 源码核实过, 之前的版本这里直接把整个响应体当 market 是个 bug)。
    async init() {
      try {
        const res = await fetch('/api/proto-markets/' + encodeURIComponent(this.marketId));
        if (!res.ok) { this.loadFailed = 'HTTP ' + res.status; this.loading = false; return; }
        const data = await res.json().catch(() => null);
        this.market = data && data.market ? data.market : null;
        if (!this.market) this.loadFailed = data && data.error ? data.error : '返回数据为空';
      } catch (err) { this.loadFailed = err.message; }
      this.loading = false;
    },

    // 状态值对齐真实 schema(migrate.js v206 proto_markets.status CHECK): betting/sealed/resolved/cancelled。
    statusBadge(s) {
      if (s === 'resolved') return 'bg-emerald-100 text-emerald-700';
      if (s === 'cancelled') return 'bg-warm-200 text-ink-500';
      return 'bg-amber-100 text-amber-700';
    },
    statusLabel(s) {
      const m = { betting: '押注中', sealed: '等待结算', resolved: '已结算', cancelled: '已取消/退款' };
      return m[s] || s || '?';
    },
    fmtDeadline(ms) {
      if (!ms) return '';
      try { return new Date(Number(ms)).toISOString().slice(0, 16).replace('T', ' '); } catch { return ''; }
    },

    // D-020: 下注是 register_append 一笔交易。成功 202 {ok:true, id, status}(status 通常 'pending'),
    // 没有单笔查询端点, 轮询 GET /api/proto-markets/:id 的 bets[] 数组按 id 比对拿最新 status。
    // 409 proto_driver_disabled 单独文案(不是"下注失败", 是"这条链路本来就没开"), 其余错误照实展示。
    async placeBet() {
      this.betSubmitting = true; this.betError = ''; this.betId = null; this.betStatus = null;
      if (this._betPollTimer) { clearTimeout(this._betPollTimer); this._betPollTimer = null; }
      try {
        const res = await fetch('/api/proto-markets/' + encodeURIComponent(this.marketId) + '/bet', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ direction: this.bet.direction, amount: this.bet.amount }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 202 && data.ok) {
          this.betId = data.id;
          this.betStatus = data.status || 'pending';
          this._pollBetStatus();
          return;
        }
        if (data.error === 'proto_driver_disabled') {
          this.betError = '原型尚未开启真实交易（proto driver 未启用，等 Owner 打开金丝雀开关）';
          return;
        }
        this.betError = '下注失败: ' + (data.error || ('HTTP ' + res.status)) + (res.status === 404 ? '（后端接口尚未上线）' : '');
      } catch (err) {
        this.betError = '请求失败: ' + err.message;
      } finally { this.betSubmitting = false; }
    },
    betStatusLabel(s) {
      const m = { pending: '已提交，等待上链确认', confirmed: '已下注', orphaned_chip: '异常状态，请联系出单人核实' };
      return m[s] || (s ? '状态: ' + s : '');
    },
    _pollBetStatus() {
      if (!this.betId) return;
      const tick = async () => {
        try {
          const res = await fetch('/api/proto-markets/' + encodeURIComponent(this.marketId));
          const data = await res.json().catch(() => null);
          const bet = data && Array.isArray(data.bets) ? data.bets.find(b => b.id === this.betId) : null;
          if (bet) this.betStatus = bet.status;
        } catch {}
        if (this.betStatus === 'pending') this._betPollTimer = setTimeout(tick, 5000);
      };
      this._betPollTimer = setTimeout(tick, 5000);
    },

    async resolveOutcome(direction) {
      this.resolveSubmitting = true; this.resolveMsg = '';
      try {
        const res = await fetch('/api/proto-markets/' + encodeURIComponent(this.marketId) + '/resolve', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ outcome: direction }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) { this.resolveOk = false; this.resolveMsg = '宣布失败: ' + (data.error || ('HTTP ' + res.status)); return; }
        this.resolveOk = true; this.resolveMsg = '已宣布，刷新页面查看最新状态。';
      } catch (err) { this.resolveOk = false; this.resolveMsg = '请求失败: ' + err.message; }
      finally { this.resolveSubmitting = false; }
    },

    async claim() {
      this.claimSubmitting = true; this.claimMsg = '';
      try {
        const res = await fetch('/api/proto-markets/' + encodeURIComponent(this.marketId) + '/claim', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) { this.claimOk = false; this.claimMsg = 'Claim 失败: ' + (data.error || ('HTTP ' + res.status)); return; }
        this.claimOk = true; this.claimMsg = 'Claim 成功，TX: ' + (data.txId || '').slice(0, 16) + '...';
      } catch (err) { this.claimOk = false; this.claimMsg = '请求失败: ' + err.message; }
      finally { this.claimSubmitting = false; }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

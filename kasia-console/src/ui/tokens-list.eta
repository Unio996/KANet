<%~ include('partials/page-open', { _page: 'tokens-list', pageTitle: '代币', ...it }) %>

<!-- 原型 v0(1325 派工·线框稿 §1 附带小节): 代币列表, 给"市场创建"选代币用的最小来源。
     样式对齐 my-markets.eta 的表格模式。GET /api/tokens 尚未落地(J2), 空/失败态如实显示。 -->

<div class="p-6 max-w-5xl mx-auto" x-data="tokensListPage()" x-init="init()">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h1 class="text-2xl font-display text-ink-800">代币</h1>
      <p class="text-xs text-ink-400 mt-1">已创建的测试代币, 用来开市场。</p>
    </div>
    <a href="/tokens/create" class="btn btn-primary btn-sm">创建代币 →</a>
  </div>

  <div x-show="loading" class="text-center py-12 text-ink-400">载入中...</div>

  <div x-show="!loading && loadFailed" class="text-center py-12 bg-red-50 rounded-lg text-red-600 text-sm">
    加载失败：<span x-text="loadFailed"></span>（后端接口 /api/tokens 可能尚未上线）
  </div>

  <div x-show="!loading && !loadFailed && tokens.length === 0" class="text-center py-16 bg-warm-50 rounded-lg">
    <div class="text-3xl mb-3">🪙</div>
    <p class="text-ink-500">还没有创建过代币。</p>
    <a href="/tokens/create" class="text-brand-500 hover:text-brand-700 text-sm mt-2 inline-block">创建第一个 →</a>
  </div>

  <div x-show="!loading && !loadFailed && tokens.length > 0" class="card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-warm-50 text-ink-500 text-xs">
        <tr>
          <th class="text-left py-2 px-3">名称</th>
          <th class="text-left py-2 px-3">Ticker</th>
          <th class="text-right py-2 px-3">发行量</th>
          <th class="text-left py-2 px-3">出单人</th>
          <th class="text-right py-2 px-3">创建时间</th>
        </tr>
      </thead>
      <tbody>
        <template x-for="tk in tokens" :key="tk.id">
          <tr class="border-t border-warm-100 hover:bg-warm-50">
            <td class="py-2 px-3" x-text="tk.name || '(未命名)'"></td>
            <td class="py-2 px-3 font-mono text-xs" x-text="tk.ticker || '?'"></td>
            <td class="py-2 px-3 text-right tabular-nums text-ink-600" x-text="tk.amount ?? '?'"></td>
            <td class="py-2 px-3 text-ink-500 text-xs" x-text="tk.relay_name || tk.relayId || '?'"></td>
            <td class="py-2 px-3 text-right text-[11px] text-ink-400" x-text="(tk.created_at || '').slice(0, 16)"></td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>

<script>
function tokensListPage() {
  return {
    loading: true,
    loadFailed: '',
    tokens: [],
    async init() {
      try {
        const res = await fetch('/api/tokens');
        if (!res.ok) { this.loadFailed = 'HTTP ' + res.status; this.loading = false; return; }
        const data = await res.json().catch(() => ({}));
        this.tokens = data.tokens || data || [];
      } catch (err) {
        this.loadFailed = err.message;
      }
      this.loading = false;
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

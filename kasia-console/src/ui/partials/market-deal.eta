<!-- Deal Detail Panel -->

<!-- Empty state -->
<div x-show="!deal" class="flex-1 flex items-center justify-center bg-warm-50">
  <div class="text-center">
    <div class="text-4xl text-warm-300 mb-2">{ }</div>
    <div class="text-sm text-ink-400">选择一个订单开始交易</div>
  </div>
</div>

<template x-if="deal">
  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Deal header + Pipeline -->
    <div class="px-5 py-3 border-b border-warm-200 bg-white">
      <!-- Title row -->
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-3">
          <span class="text-base font-semibold text-ink-700"
            x-text="(deal.side==='buy' ? '买入 ' : '卖出 ') + deal.kas_amount + ' KAS'"></span>
          <span class="text-ink-300">@</span>
          <span class="text-base font-medium text-ink-600" x-text="'$' + deal.price"></span>
          <span class="badge badge-neutral text-[10px]" x-text="(deal.chain||'bnb').toUpperCase()"></span>
        </div>
        <span class="text-[10px] text-ink-300 font-mono" x-text="deal.id?.slice(0,8)"></span>
      </div>

      <!-- Pipeline: stepped progress bar -->
      <div class="flex items-center gap-0">
        <template x-for="(s, i) in pipe" :key="s.id">
          <div class="flex items-center" :class="i > 0 ? 'flex-1' : ''">
            <!-- Connector line -->
            <div x-show="i > 0" class="h-0.5 flex-1 transition-colors duration-500"
              :class="{
                'bg-green-400': pipeLineClass(i) === 'done',
                'bg-gradient-to-r from-green-400 to-brand-400': pipeLineClass(i) === 'cur',
                'bg-warm-200': pipeLineClass(i) === 'wait'
              }"></div>
            <!-- Node dot -->
            <div class="relative cursor-pointer group" @click="toggleStory(s.id)">
              <div class="w-2.5 h-2.5 rounded-full transition-all duration-300"
                :class="{
                  'bg-green-500 shadow-sm': pipeNodeClass(s.id) === 'done',
                  'bg-brand-500 shadow-md ring-2 ring-brand-200 animate-pulse': pipeNodeClass(s.id) === 'active',
                  'bg-warm-300': pipeNodeClass(s.id) === 'wait'
                }"></div>
              <span class="absolute top-4 left-1/2 -translate-x-1/2 text-[9px] whitespace-nowrap font-medium"
                :class="{
                  'text-green-600': pipeNodeClass(s.id) === 'done',
                  'text-brand-600': pipeNodeClass(s.id) === 'active',
                  'text-ink-300': pipeNodeClass(s.id) === 'wait'
                }" x-text="s.label"></span>
            </div>
          </div>
        </template>
      </div>

      <!-- Story card (expanded on pipeline node click) -->
      <div x-show="storyNode" x-transition class="mt-5 card card-compact"
        :class="{
          'border-l-[3px] border-l-green-400': storyData?.ok,
          'border-l-[3px] border-l-brand-400': storyData?.active,
          'border-l-[3px] border-l-warm-300': !storyData?.ok && !storyData?.active
        }">
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-ink-700" x-text="storyData?.title || ''"></span>
            <span x-show="storyData?.ok" class="badge badge-success text-[9px]">DONE</span>
            <span x-show="storyData?.active" class="badge badge-info text-[9px] animate-pulse">IN PROGRESS</span>
          </div>
          <button @click="storyNode=null" class="text-ink-300 hover:text-ink-500 text-[10px]">关闭</button>
        </div>
        <div class="text-xs text-ink-500 leading-relaxed" x-show="storyData?.summary" x-text="storyData?.summary"></div>
        <!-- TX link -->
        <div x-show="storyData?.tx" class="mt-2 flex items-center gap-2">
          <span class="text-[9px] text-ink-300">TX:</span>
          <a :href="KANet.explorerTxUrl(storyData?.tx?.startsWith('0x') ? (deal?.chain || 'bnb') : 'kaspa', storyData.tx)"
            target="_blank" class="font-mono text-[10px] text-brand-500 hover:text-brand-700 underline underline-offset-2 decoration-brand-200 hover:decoration-brand-400 transition-colors" x-text="storyData?.tx"></a>
        </div>
        <div x-show="storyData?.time" class="mt-1 text-[9px] text-ink-300" x-text="storyData?.time"></div>
        <!-- Agent reasoning -->
        <div x-show="storyData?.reasoning" class="mt-2 px-2 py-1.5 rounded-lg bg-warm-50 border-l-2 border-brand-200">
          <div class="text-[8px] text-brand-400 uppercase tracking-widest mb-0.5">Agent 推理</div>
          <div class="text-[11px] text-ink-400 italic" x-text="storyData?.reasoning"></div>
        </div>
        <!-- On-chain proof -->
        <div x-show="storyData?.proof" class="mt-2 text-[10px] text-ink-400 space-y-0.5 font-mono">
          <template x-for="(v,k) in storyData?.proof||{}" :key="k">
            <div><span class="text-ink-300" x-text="k+': '"></span><span :class="k==='TX' ? 'text-brand-500' : ''" x-text="v"></span></div>
          </template>
        </div>
        <!-- Future node -->
        <div x-show="storyData?.future" class="text-xs text-ink-400 italic" x-text="storyData?.future"></div>
      </div>
    </div>

    <!-- Chat flow -->
    <div class="flex-1 overflow-y-auto px-5 py-3 space-y-1 bg-warm-50" x-ref="chatScroll">
      <template x-for="(item, idx) in flow" :key="idx">
        <div>
          <!-- Checkpoint -->
          <template x-if="item.t==='cp'">
            <div class="flex items-center gap-3 py-1.5 my-1">
              <div class="flex-1 h-px" :class="item.done ? 'bg-green-200' : item.now ? 'bg-brand-200' : 'bg-warm-200'"></div>
              <div class="flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full"
                  :class="item.done ? 'bg-green-500' : item.now ? 'bg-brand-500 animate-pulse' : 'bg-warm-300'"></div>
                <span class="text-[10px] font-medium uppercase tracking-wider"
                  :class="item.now ? 'text-brand-600' : item.done ? 'text-green-600' : 'text-ink-300'" x-text="item.label"></span>
                <span class="text-[9px] text-ink-300" x-text="item.time||''"></span>
              </div>
              <div class="flex-1 h-px" :class="item.done ? 'bg-green-200' : item.now ? 'bg-brand-200' : 'bg-warm-200'"></div>
            </div>
          </template>

          <!-- Peer message -->
          <template x-if="item.t==='peer'">
            <div class="flex gap-2 mb-2">
              <div class="w-6 h-6 rounded-full bg-warm-200 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[9px] font-medium text-ink-500" x-text="item.av"></span>
              </div>
              <div>
                <div class="text-[10px] text-ink-300 mb-0.5" x-text="item.who + ' ' + item.time"></div>
                <div class="max-w-[85%] px-3 py-2 rounded-xl rounded-tl-sm bg-white border border-warm-200 text-[13px] text-ink-600 leading-relaxed" x-text="item.msg"></div>
              </div>
            </div>
          </template>

          <!-- My Agent message -->
          <template x-if="item.t==='agent'">
            <div class="flex gap-2 mb-2 justify-end">
              <div class="text-right">
                <div class="text-[10px] text-ink-300 mb-0.5" x-text="item.who + ' ' + item.time"></div>
                <div class="max-w-[85%] ml-auto px-3 py-2 rounded-xl rounded-tr-sm bg-brand-50 border border-brand-100 text-[13px] text-ink-600 leading-relaxed" x-text="item.msg"></div>
              </div>
              <div class="w-6 h-6 rounded-full bg-brand-100 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[9px] font-medium text-brand-600" x-text="item.av"></span>
              </div>
            </div>
          </template>

          <!-- Owner message -->
          <template x-if="item.t==='owner'">
            <div class="flex gap-2 mb-2 justify-end">
              <div class="text-right">
                <div class="text-[10px] text-ink-300 mb-0.5">你 <span x-text="item.time"></span></div>
                <div class="max-w-[85%] ml-auto px-3 py-2 rounded-xl rounded-tr-sm bg-brand-500 text-white text-[13px] leading-relaxed" x-text="item.msg"></div>
              </div>
            </div>
          </template>

          <!-- System card -->
          <template x-if="item.t==='sys'">
            <div class="my-2 mx-4">
              <div class="card card-compact"
                :class="{
                  'border-l-[3px] border-l-green-400': item.style==='success',
                  'border-l-[3px] border-l-amber-400': item.style==='lock',
                  'border-l-[3px] border-l-brand-400': item.style==='verify',
                  'border-l-[3px] border-l-red-400': item.style==='fail'
                }">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-[11px]"
                      x-text="item.icon === 'tx' ? '🔗' : item.icon === 'err' ? '❌' : item.icon === 'rej' ? '🚫' : item.icon"></span>
                    <template x-if="item.txUrl && item.txUrl !== '#'">
                      <a :href="item.txUrl" target="_blank" class="font-mono text-xs text-brand-500 hover:text-brand-700 underline underline-offset-2 decoration-brand-200 transition-colors" x-text="item.msg"></a>
                    </template>
                    <template x-if="!item.txUrl || item.txUrl === '#'">
                      <span class="text-xs text-ink-600" x-text="item.msg"></span>
                    </template>
                  </div>
                  <span class="text-[9px] text-ink-300" x-text="item.time"></span>
                </div>
                <button x-show="item.proof" @click="item._o=!item._o" class="text-[9px] text-brand-400 hover:text-brand-600 mt-1 transition-colors" x-text="item._o ? '收起' : '查看详情'"></button>
                <div x-show="item._o" x-transition class="mt-1 pt-1 border-t border-warm-200 text-[10px] font-mono text-ink-400 space-y-0.5">
                  <template x-for="(v,k) in item.proof" :key="k">
                    <div>
                      <span class="text-ink-300" x-text="k+': '"></span>
                      <template x-if="k==='TX' && v && v.length > 10">
                        <a :href="KANet.explorerTxUrl(v.startsWith('0x') ? (deal?.chain || 'bnb') : 'kaspa', v)" target="_blank"
                          class="text-brand-500 hover:text-brand-700 underline underline-offset-2 decoration-brand-200 transition-colors" x-text="v"></a>
                      </template>
                      <template x-if="k!=='TX' || !v || v.length <= 10">
                        <span x-text="v"></span>
                      </template>
                    </div>
                  </template>
                </div>
              </div>
            </div>
          </template>

          <!-- Approval card -->
          <template x-if="item.t==='approval'">
            <div class="my-3 mx-2">
              <div class="approval-card">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <div class="status-dot yellow"></div>
                    <span class="text-xs text-amber-600 font-medium">等待你的确认</span>
                  </div>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed" x-text="item.summary"></p>
                <div x-show="item.reasoning" class="mt-2 px-2.5 py-1.5 rounded-lg bg-warm-50 border-l-2 border-brand-200">
                  <div class="text-[8px] text-brand-400 uppercase tracking-widest mb-0.5">Agent 推理</div>
                  <p class="text-[11px] text-ink-400" x-text="item.reasoning"></p>
                </div>
                <div class="flex gap-2.5 mt-3">
                  <button @click="approveExec(item.execId)" class="btn btn-sm flex-1 bg-green-50 text-green-600 border border-green-200 hover:bg-green-100">确认执行</button>
                  <button @click="rejectExec(item.execId)" class="btn btn-sm flex-1 btn-danger">拒绝</button>
                </div>
              </div>
            </div>
          </template>
        </div>
      </template>

      <!-- Action buttons -->
      <div x-show="deal && !hasPendingApproval" class="flex gap-2 pt-2 pb-1">
        <!-- Accept (not my order) -->
        <button x-show="deal?.status==='published' && deal?.relay_node_id !== agentId" @click="doAction('accept')"
          class="btn btn-primary flex-1" x-text="'接受订单（' + agentName + '）'"></button>
        <!-- Waiting (my order, published) -->
        <span x-show="deal?.status==='published' && deal?.relay_node_id === agentId"
          class="flex-1 py-2.5 text-center text-ink-400 text-sm">等待对手方接单...</span>
        <!-- Pay USDT -->
        <button x-show="deal?.status==='accepted' && deal?.relay_node_id === agentId && deal?.side==='buy'" @click="doAction('pay_usdt')"
          class="btn flex-1 bg-green-50 text-green-600 border border-green-200 hover:bg-green-100">支付 USDT</button>
        <!-- Verify payment -->
        <button x-show="deal?.status==='paid' && deal?.relay_node_id === agentId" @click="doAction('verify_payment')"
          class="btn btn-primary flex-1">验证到账</button>
        <!-- Send KAS -->
        <button x-show="deal?.status==='verified' && deal?.relay_node_id === agentId && deal?.side==='sell'" @click="doAction('send_kas')"
          class="btn flex-1 bg-green-50 text-green-600 border border-green-200 hover:bg-green-100">发送 KAS</button>
        <!-- Cancel -->
        <button x-show="deal && deal?.relay_node_id === agentId && !TERM.includes(deal?.status)" @click="doAction('cancel')"
          class="btn btn-ghost text-red-500 hover:bg-red-50">取消</button>
        <!-- Waiting for peer -->
        <span x-show="deal && deal?.relay_node_id !== agentId && !TERM.includes(deal?.status) && deal?.status !== 'published'"
          class="flex-1 py-2.5 text-center text-ink-300 text-xs">等待对方操作...</span>
        <!-- Closed -->
        <span x-show="deal && TERM.includes(deal?.status)"
          class="flex-1 py-2.5 text-center text-ink-400 text-xs" x-text="deal?.status === 'completed' ? '交易已完成' : '订单已关闭'"></span>
      </div>
    </div>

    <!-- Chat input -->
    <div class="px-5 py-2.5 border-t border-warm-200 bg-white flex gap-2">
      <input x-model="chatInput" @keydown.enter="if(!$event.isComposing){sendChat()}"
        :placeholder="deal?.peer_address ? '给对手方留言...' : '发布到市场频道...'"
        class="flex-1 border border-warm-300 rounded-lg px-3 py-2 text-sm focus:border-brand-400 focus:outline-none bg-warm-50 placeholder-ink-300">
      <button @click="sendChat()" class="btn btn-primary">发送</button>
    </div>
  </div>
</template>

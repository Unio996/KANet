<aside class="w-48 bg-white border-r border-warm-300 flex flex-col flex-shrink-0">
  <!-- Logo -->
  <div class="px-4 py-4 border-b border-warm-200 flex items-center gap-3">
    <img src="/public/kanet-logo.png" alt="KANet" class="h-7 w-7 object-contain flex-shrink-0" />
    <span class="text-sm font-semibold text-ink-700 leading-tight">KANet <span class="text-xs font-normal text-ink-300">Console</span></span>
  </div>

  <!-- Owner 5/26 钦定 6 top tab: Chat / Contacts / Portfolio / Agents / Markets / Settings -->
  <nav class="flex-1 py-3 px-3 space-y-0.5 overflow-y-auto">

    <!-- 1. Chat -->
    <a href="/chat"
      class="flex items-center px-3 py-2.5 rounded-lg text-sm transition-colors <%= it._page === 'chat' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-500 hover:bg-warm-100 hover:text-ink-700' %>">
      聊天
    </a>

    <!-- 2. Contacts (= 社交圈 + Discovery 合并) -->
    <a href="/contacts"
      class="flex items-center px-3 py-2.5 rounded-lg text-sm transition-colors <%= ['contacts','explore','discovered','network','handshakes'].includes(it._page) ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-500 hover:bg-warm-100 hover:text-ink-700' %>">
      联系人
    </a>

    <!-- 3. Portfolio -->
    <a href="/portfolio"
      class="flex items-center px-3 py-2.5 rounded-lg text-sm transition-colors <%= ['portfolio','ledger'].includes(it._page) ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-500 hover:bg-warm-100 hover:text-ink-700' %>">
      资产
    </a>

    <!-- 4. Agents ▶ (Owner 2026-06-06 钦定: 删 Roles 层, Oracle/Broker 提到 Overview 后平级 — 这俩是系统关键) -->
    <% const _isAgent = ['agent','agent-v2','agent-status','agent-history','story','graph','skills','approvals','broker','oracle'].includes(it._page); %>
    <div x-data="{ open: <%= _isAgent ? 'true' : 'false' %> }">
      <button @click="open = !open"
        class="flex items-center justify-between w-full px-3 py-2.5 rounded-lg text-sm transition-colors <%= _isAgent ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-500 hover:bg-warm-100 hover:text-ink-700' %>">
        <span>Agents</span>
        <span class="text-[10px] transition-transform" :class="open ? 'rotate-90' : ''">›</span>
      </button>
      <div x-show="open" x-transition class="mt-1 space-y-0.5">
        <a href="/agent"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'agent' && !it._agentTab ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          总览
        </a>
        <a href="/oracle"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'oracle' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Oracle
        </a>
        <a href="/broker"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'broker' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Broker
        </a>
        <a href="/agent?tab=card"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._agentTab === 'card' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Identity
        </a>
        <a href="/skills"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'skills' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Behavior
        </a>
        <!-- Approvals badge (= 等审批入口) -->
        <a href="/approvals"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'approvals' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Approvals
        </a>
      </div>
    </div>

    <!-- KANet-UI 2026-06-07 Track B (Bettor r335 关 1 PASS): 市场 ▶ 内 '预测市场 ▶' 嵌套子菜单 (建市场/我的市场 收进) -->
    <% const _isMarket = ['exchange','predictions','predictions-pool-create','predictions-pool-detail','my-markets','oracle','market','trading','stocks','hyperliquid','aevo','aave'].includes(it._page); %>
    <% const _isPrediction = ['predictions','predictions-pool-create','predictions-pool-detail','my-markets'].includes(it._page); %>
    <div x-data="{ open: <%= _isMarket ? 'true' : 'false' %> }">
      <button @click="open = !open"
        class="flex items-center justify-between w-full px-3 py-2.5 rounded-lg text-sm transition-colors <%= _isMarket ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-500 hover:bg-warm-100 hover:text-ink-700' %>">
        <span>市场</span>
        <span class="text-[10px] transition-transform" :class="open ? 'rotate-90' : ''">›</span>
      </button>
      <div x-show="open" x-transition class="mt-1 space-y-0.5">
        <a href="/exchange"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'exchange' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          兑换
        </a>
        <!-- 预测市场 ▶ 嵌套 -->
        <div x-data="{ pred: <%= _isPrediction ? 'true' : 'false' %> }">
          <button @click="pred = !pred"
            class="flex items-center justify-between w-full px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= _isPrediction ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
            <span>预测市场</span>
            <span class="text-[9px] transition-transform" :class="pred ? 'rotate-90' : ''">›</span>
          </button>
          <div x-show="pred" x-transition class="mt-0.5 space-y-0.5">
            <a href="/predictions"
              class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-8 <%= ['predictions','predictions-pool-detail'].includes(it._page) ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
              看市场
            </a>
            <a href="/predictions/pool/create"
              class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-8 <%= it._page === 'predictions-pool-create' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
              建市场
            </a>
            <a href="/my-markets"
              class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-8 <%= it._page === 'my-markets' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
              我的市场
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. Settings ▶ (= Network / Relays / Adapters / Language / Security / About) -->
    <% const _isSettings = ['settings','relays','relay','adapters','adapter','events','about','whale-signal'].includes(it._page); %>
    <div class="pt-4 mt-4 border-t border-warm-200" x-data="{ open: <%= _isSettings ? 'true' : 'false' %> }">
      <button @click="open = !open"
        class="flex items-center justify-between w-full px-3 py-2 rounded-lg text-sm transition-colors <%= _isSettings ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
        <span>设置</span>
        <span class="text-[10px] transition-transform" :class="open ? 'rotate-90' : ''">›</span>
      </button>
      <div x-show="open" x-transition class="mt-1 space-y-0.5">
        <a href="/network"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= it._page === 'network' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Network
        </a>
        <a href="/relays"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= ['relays','relay'].includes(it._page) ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Relays
        </a>
        <a href="/adapters"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 <%= ['adapters','adapter'].includes(it._page) ? 'bg-brand-50 text-brand-600 font-medium' : 'text-ink-400 hover:bg-warm-100 hover:text-ink-600' %>">
          Adapters
        </a>
        <a href="#lang"
          class="flex items-center px-3 py-1.5 rounded-lg text-xs transition-colors pl-5 text-ink-400 hover:bg-warm-100 hover:text-ink-600"
          @click.prevent="document.querySelector('select[name=&quot;lang&quot;]')?.focus()">
          Language
        </a>
      </div>
    </div>
  </nav>

  <!-- Language selector (= 底部保留, Settings › Language 入口 focus 此处) -->
  <% if (it.langs) { %>
  <div class="px-3 pb-2">
    <form method="POST" action="/lang">
      <select name="lang" onchange="this.form.submit()"
        class="w-full bg-warm-50 text-ink-500 text-xs rounded-lg px-2 py-1.5 border border-warm-300 focus:outline-none focus:border-brand-300 cursor-pointer">
        <% Object.entries(it.langs).forEach(function([code, label]) { %>
        <option value="<%= code %>" <%= it.lang === code ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </form>
  </div>
  <% } %>

  <!-- Bettor ③ 2026-06-23 — 小范围 invited testnet 披露文案 (满披露铁律) -->
  <div class="px-3 pb-2 border-t border-warm-200 pt-2">
    <div class="bg-amber-50 border border-amber-200 rounded-lg px-2.5 py-2 text-[10px] text-amber-700 leading-relaxed space-y-0.5">
      <div class="font-semibold text-amber-800">⚠ 测试网 · 小范围邀请制</div>
      <div>• 测试网，非主网</div>
      <div>• 托管钱包：节点持 key，真钱请用自己的非托管钱包</div>
      <div>• 约半数市场会 refund 而非结算（结算率 &lt;80%）</div>
      <div>• 结算 enforce driver-side，非 production-trustless</div>
    </div>
  </div>
  <div class="px-4 py-2 text-[10px] text-ink-300">
    KANet v0.1
  </div>
</aside>

<!DOCTYPE html>
<html lang="<%= it.lang || 'zh-CN' %>">
<head>
  <%~ include('./head', it) %>
  <% if (it.extraHead) { %><%~ it.extraHead %><% } %>
</head>
<body class="flex h-screen bg-warm-100 font-sans">
  <%~ include('./sidebar', it) %>
  <div class="flex-1 flex flex-col overflow-hidden">
    <% if (it.pageTitle) { %>
    <header class="bg-white border-b border-warm-200 px-6 py-4 flex-shrink-0 flex items-center justify-between">
      <h1 class="text-lg font-semibold text-ink-700"><%= it.pageTitle %></h1>
      <div class="flex items-center gap-3">
        <!-- T-J2-2026-05-12 #5 — global RPC overview indicator (UI 健康检测 P0, NWT spec sub #5/7) -->
        <a href="/settings" class="flex items-center gap-1.5 px-2 py-1 rounded text-xs hover:bg-warm-100"
           x-data="{ o: null, tip: '...', async load() { try { this.o = await fetch('/api/system/rpc-overview').then(r=>r.json()); const s = this.o.summary; if (!s) { this.tip='no data'; return; } if (s.unreachable>0) this.tip=`${s.unreachable}/${s.total} unreachable`; else if (s.reconnecting>0) this.tip=`${s.reconnecting} reconnecting`; else this.tip=`${s.connected}/${s.total} connected`; } catch { this.tip='probe failed'; } }, get color() { const s = this.o?.summary; if (!s) return 'bg-gray-300'; if (s.unreachable>0) return 'bg-red-500'; if (s.reconnecting>0) return 'bg-yellow-500'; return 'bg-green-500'; } }"
           x-init="load(); setInterval(load, 15000)" :title="tip">
          <span class="inline-block w-2 h-2 rounded-full" :class="color"></span>
          <span class="text-ink-500" x-text="tip"></span>
        </a>
        <!-- Bettor ③ 2026-06-23 — canary settle% badge (近7天), 公测就绪 gate 可视化 -->
        <span x-data="{ pct: null, gate: null, async load() { try { const r = await fetch('/api/system/canary-stats').then(r=>r.json()); this.pct=r.settle_pct; this.gate=r.gate_pass; } catch {} }, get tip() { return this.pct===null ? '结算率加载中' : `近7天结算率 ${this.pct}% (${this.gate?'✅ 可公测':'🔴 <80% gate FAIL'})`; } }"
              x-init="load(); setInterval(load, 60000)" :title="tip"
              class="text-[10px] px-1.5 py-0.5 rounded font-mono"
              :class="pct===null ? 'bg-gray-100 text-gray-400' : gate ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-600'">
          <span x-text="pct===null ? '…' : pct+'%'"></span>
        </span>
        <% if (it.headerRight) { %><%~ it.headerRight %><% } %>
      </div>
    </header>
    <% } %>
    <!-- KANet-UI 2026-06-08 DoD-D.2 (Bettor r373 关 1 PASS): onboarding wizard 全页加 -->
    <%~ include('./wizard', it) %>
    <main class="flex-1 overflow-y-auto">

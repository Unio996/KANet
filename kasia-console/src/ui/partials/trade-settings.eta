<!-- trade-settings partial — Trade mode, agent autonomy, limits, anchor -->
<div x-data="tradeSettings()" x-init="init()">

  <div class="max-w-3xl space-y-5">

    <!-- ═══ Trade Mode ═══ -->
    <div class="card">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-sm font-medium text-ink-700">Trading Mode</span>
          <p class="text-xs text-ink-400 mt-0.5" x-text="$root.mode === 'LIVE' ? 'Real orders will be placed on exchange' : 'Simulation only — no real orders'"></p>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono" :class="$root.mode === 'DRY-RUN' ? 'text-amber-600 font-medium' : 'text-ink-300'">DRY-RUN</span>
          <label class="flex items-center cursor-pointer">
            <div class="relative">
              <input type="checkbox" :checked="$root.mode === 'LIVE'" @change="toggleTradeMode()" class="sr-only" />
              <div class="w-10 h-5 rounded-full transition-colors" :class="$root.mode === 'LIVE' ? 'bg-red-500' : 'bg-warm-300'"></div>
              <div class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white transition-transform" :class="$root.mode === 'LIVE' ? 'translate-x-5' : ''"></div>
            </div>
          </label>
          <span class="text-xs font-mono font-bold" :class="$root.mode === 'LIVE' ? 'text-red-600' : 'text-ink-300'">LIVE</span>
        </div>
      </div>
    </div>

    <!-- ═══ Agent Trade Permissions ═══ -->
    <div class="card">
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-sm font-medium text-ink-700">Agent Trade Permissions</span>
          <p class="text-xs text-ink-400 mt-0.5">Per-agent trade mode control</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-ink-400 uppercase tracking-wider">Anchor</span>
          <button @click="setAnchor(panelAnchor === 'kas' ? 'usd' : 'kas')"
            class="btn btn-sm" :class="panelAnchor === 'kas' ? 'btn-secondary' : 'btn-primary'"
            x-text="panelAnchor === 'kas' ? 'KAS Anchor' : 'USD Anchor'"></button>
        </div>
      </div>

      <!-- Agent rows -->
      <div class="space-y-2">
        <template x-for="a in agentList" :key="a.id">
          <div class="flex items-center gap-3 bg-warm-50 rounded-lg px-3 py-2.5 border border-warm-200 hover:border-warm-300 transition-colors">
            <div class="status-dot" :class="a.mode === 'auto' ? 'green' : a.mode === 'approval' ? 'green' : a.mode === 'disabled' ? 'red' : 'gray'"></div>
            <div class="flex-1 min-w-0">
              <span class="text-sm font-medium text-ink-700" x-text="a.name"></span>
              <span class="text-[10px] text-ink-300 ml-2 font-mono" x-text="'...' + a.address.slice(-8)"></span>
            </div>
            <!-- Mode selector -->
            <div class="flex items-center gap-1">
              <button @click="setMode(a.id, 'disabled')" class="btn btn-sm"
                :class="a.mode === 'disabled' ? 'btn-danger' : 'btn-ghost'">Disabled</button>
              <button @click="setMode(a.id, 'manual')" class="btn btn-sm"
                :class="a.mode === 'manual' ? 'btn-secondary' : 'btn-ghost'">Manual</button>
              <button @click="setMode(a.id, 'approval')" class="btn btn-sm"
                :class="a.mode === 'approval' ? 'btn-primary' : 'btn-ghost'">Approval</button>
              <button @click="setMode(a.id, 'auto')" class="btn btn-sm"
                :class="a.mode === 'auto' ? 'bg-green-600 text-white hover:bg-green-700' : 'btn-ghost'">Auto</button>
            </div>
          </div>
        </template>
      </div>

      <!-- Mode legend -->
      <div class="flex items-center gap-4 mt-3 pt-3 border-t border-warm-200 text-[10px] text-ink-400">
        <span><div class="status-dot red inline-block mr-1" style="vertical-align: middle"></div>Disabled: no trades</span>
        <span><div class="status-dot gray inline-block mr-1" style="vertical-align: middle"></div>Manual: owner only</span>
        <span><div class="status-dot green inline-block mr-1" style="vertical-align: middle"></div>Approval: agent proposes, owner confirms</span>
        <span><div class="status-dot green inline-block mr-1" style="vertical-align: middle"></div>Auto: agent trades within limits</span>
      </div>
    </div>

    <!-- ═══ Agent Trading Configs ═══ -->
    <div class="card">
      <div class="flex items-center justify-between mb-3">
        <div>
          <span class="text-sm font-medium text-ink-700">Trading Limits</span>
          <p class="text-xs text-ink-400 mt-0.5">Per-agent capital and risk limits</p>
        </div>
      </div>

      <div class="space-y-3">
        <template x-for="cfg in agentConfigs" :key="cfg.id">
          <div class="bg-warm-50 rounded-lg p-4 border border-warm-200">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="text-sm font-bold text-ink-700" x-text="cfg.name"></span>
                <label class="flex items-center cursor-pointer">
                  <div class="relative">
                    <input type="checkbox" x-model="cfg.enabled" @change="saveConfig(cfg)" class="sr-only" />
                    <div class="w-8 h-4 rounded-full transition-colors" :class="cfg.enabled ? 'bg-green-500' : 'bg-warm-300'"></div>
                    <div class="absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-white transition-transform" :class="cfg.enabled ? 'translate-x-4' : ''"></div>
                  </div>
                </label>
                <span class="text-xs" :class="cfg.enabled ? 'price-up' : 'text-ink-300'" x-text="cfg.enabled ? 'Enabled' : 'Disabled'"></span>
                <select x-model="cfg.baseCurrency" @change="saveConfig(cfg)"
                  class="bg-white text-xs rounded-lg px-2 py-1 border border-warm-300 ml-2 text-ink-600">
                  <option value="USDT">USDT</option>
                  <option value="KAS">KAS</option>
                </select>
              </div>
              <button @click="saveConfig(cfg)" :disabled="savingConfig" class="btn btn-sm btn-ghost">Save</button>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div>
                <label class="text-xs text-ink-400 block mb-1" x-text="'Capital (' + cfg.baseCurrency + ')'"></label>
                <input type="number" x-model.number="cfg.capital" @change="saveConfig(cfg)"
                  class="w-full bg-white text-ink-600 text-sm rounded-lg px-2 py-1.5 border border-warm-300 focus:outline-none focus:border-brand-500" />
              </div>
              <div>
                <label class="text-xs text-ink-400 block mb-1" x-text="'Max/Trade (' + cfg.baseCurrency + ')'"></label>
                <input type="number" x-model.number="cfg.maxPerTrade" @change="saveConfig(cfg)"
                  class="w-full bg-white text-ink-600 text-sm rounded-lg px-2 py-1.5 border border-warm-300 focus:outline-none focus:border-brand-500" />
              </div>
              <div>
                <label class="text-xs text-ink-400 block mb-1">Max Position %</label>
                <input type="number" x-model.number="cfg.maxPositionPct" @change="saveConfig(cfg)" min="0" max="100"
                  class="w-full bg-white text-ink-600 text-sm rounded-lg px-2 py-1.5 border border-warm-300 focus:outline-none focus:border-brand-500" />
              </div>
              <div>
                <label class="text-xs text-ink-400 block mb-1" x-text="'Daily Loss (' + cfg.baseCurrency + ')'"></label>
                <input type="number" x-model.number="cfg.dailyLossLimit" @change="saveConfig(cfg)"
                  class="w-full bg-white text-ink-600 text-sm rounded-lg px-2 py-1.5 border border-warm-300 focus:outline-none focus:border-brand-500" />
              </div>
            </div>
            <div class="mt-3">
              <label class="text-xs text-ink-400 block mb-1">Strategy / Goal</label>
              <input type="text" x-model="cfg.strategy" @change="saveConfig(cfg)"
                :placeholder="'e.g. Conservative KAS accumulation, buy dips below $0.035'"
                class="w-full bg-white text-ink-600 text-sm rounded-lg px-2 py-1.5 border border-warm-300 focus:outline-none focus:border-brand-500" />
            </div>
          </div>
        </template>
      </div>
    </div>

  </div>
</div>

<script>
function tradeSettings() {
  return {
    agentList: [],
    panelAnchor: 'kas',
    agentConfigs: [],
    savingConfig: false,

    async init() {
      await Promise.all([this.loadAgentModes(), this.loadConfigs()]);
    },

    // ── Trade mode ──
    async toggleTradeMode() {
      const newMode = this.$root.mode === 'LIVE' ? 'DRY-RUN' : 'LIVE';
      if (newMode === 'LIVE' && !confirm('Switch to LIVE mode? Real orders will be placed with real money.')) return;
      try {
        await fetch('/api/trade/mode', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: newMode }) });
        this.$root.mode = newMode;
      } catch (e) { alert('Failed: ' + e.message); }
    },

    // ── Agent modes ──
    async loadAgentModes() {
      try {
        const res = await fetch('/api/trade/agent-modes');
        const data = await res.json();
        this.agentList = data.agents || [];
        this.panelAnchor = data.anchor || 'usd';
      } catch {}
    },

    async setMode(agentId, mode) {
      if (mode === 'auto' && !confirm('Enable auto mode? Agent will trade within limits autonomously.')) return;
      try {
        const res = await fetch('/api/trade/agent-mode', {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode, relayNodeId: agentId }),
        });
        const d = await res.json();
        if (d.ok) {
          const a = this.agentList.find(x => x.id === agentId);
          if (a) { a.mode = mode; a.isPerAgent = true; }
        }
      } catch {}
    },

    async setAnchor(anchor) {
      try {
        const res = await fetch('/api/trade/set-anchor', {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ anchor }),
        });
        const d = await res.json();
        if (d.ok) this.panelAnchor = anchor;
      } catch {}
    },

    // ── Agent configs ──
    async loadConfigs() {
      try { const res = await fetch('/api/trade/config'); this.agentConfigs = await res.json(); } catch {}
    },

    async saveConfig(cfg) {
      this.savingConfig = true;
      try {
        await fetch('/api/trade/config/' + cfg.id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cfg),
        });
      } catch {}
      this.savingConfig = false;
    },
  };
}
</script>

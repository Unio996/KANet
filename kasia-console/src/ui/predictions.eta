    async submitMakerApply() {
      const f = this.makerApplyForm;
      if (!f.relay_node_id) { alert('选 agent'); return; }
      if (!Number.isFinite(f.stake_amount_kas) || f.stake_amount_kas < 100) { alert('stake ≥ 100 KAS'); return; }
      this.makerApplySubmitting = true;
      try {
        const res = await fetch('/api/prediction/maker/whitelist/apply', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relay_node_id: f.relay_node_id, stake_amount_kas: f.stake_amount_kas }),
        });
        const data = await res.json();
        if (!data.ok) { alert('apply 失败: ' + (data.error || 'unknown')); return; }
        this.showMakerApply = false;
        await this.loadMakerWhitelist();
        alert('✓ apply 提交. Owner approval pending.');
      } catch (e) { alert('apply fail: ' + e.message); }
      finally { this.makerApplySubmitting = false; }
    },

    async takePredictionOffer(o) {
      const confirmed = confirm(`TAKE prediction offer?\n\n${o.outcome_side} @ $${(o.published_price || 0).toFixed(3)}\nshares: ${o.give_amount}\npay: ${o.want_amount} KAS\nexpires: ${o.expires_at}`);
      if (!confirmed) return;
      o._taking = true;
      try {
        const res = await fetch('/api/prediction/accept/' + o.id, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ taker_relay_id: this.selectedAgent }),
        });
        const data = await res.json();
        if (!data.ok) { alert('TAKE fail: ' + (data.error || 'unknown')); return; }
        await this.loadPredictionQuoteBook();
        alert('✓ matched! offer ' + data.offer_id);
      } catch (e) { alert('TAKE fail: ' + e.message); }
      finally { o._taking = false; }
    },


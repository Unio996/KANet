    async fossaOwnerAck(rec) {
      const confirmed = confirm(`★ Owner final ack — fire ${rec.decision} @ $${rec.yes_price?.toFixed(3)} size $${rec.size_usd}?\n\nMarket: ${rec.question}\n\nLLM timeline blind spot 提醒: 你独立 verify 过 catalysts 了吗?`);
      if (!confirmed) return;
      rec._acking = true; rec._ackError = null;
      try {
        const res = await fetch('/api/bettor/recommendation/' + rec.id + '/accept', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ owner_final_ack: true }),
        });
        const data = await res.json();
        if (!data.ok && !data.success) { rec._ackError = data.error || 'unknown error'; return; }
        await this.loadFossaStable();
      } catch (e) {
        rec._ackError = e.message;

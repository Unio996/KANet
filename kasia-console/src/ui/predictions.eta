    // Bettor r46 (B) Step 1: 真盘 active position 出清 (placeOrder sell at market bid - $0.01)
    async sellActivePosition(pos) {
      console.log('[出清] click fired, pos=', pos);
      window.alert('debug: 按钮 click 已触发\n持仓: ' + pos.size + ' shares ' + pos.outcome + '\nasset id: ' + (pos.asset || 'MISSING').slice(0, 20) + '...\nstatus: ' + pos.status);
      if (pos.status !== 'active') { alert('当前持仓 status=' + pos.status + ', 仅 active 可出清'); return; }
      if (pos._closing) { console.log('[出清] already closing, skip'); return; }
      // 2 步 confirm (真盘比 sim 严, 防误击)
      const bestBidEst = pos.curPrice || pos.avgPrice || 0.5;
      const estimatedSellPrice = Math.max(0.01, bestBidEst - 0.01);
      const estimatedProceeds = estimatedSellPrice * pos.size;
      const confirmed = confirm(
        `卖出 ${pos.size} ${pos.outcome} shares\n` +
        `估卖价: $${estimatedSellPrice.toFixed(3)} (market bid - $0.01 slippage)\n` +
        `估收回: $${estimatedProceeds.toFixed(2)} USDC\n` +
        `当前 P&L: ${(pos.size - pos.totalCost >= 0 ? '+' : '')}$${(pos.size - pos.totalCost).toFixed(2)}\n\n` +
        `此操作不可撤销, 链上 TX. 确认?`
      );
      if (!confirmed) return;
      const sellConfirm = prompt('真盘操作 — 输入 SELL 确认 (防误击):');
      if (sellConfirm !== 'SELL') { alert('未确认 (需输入 SELL), 已取消'); return; }
      pos._closing = true;
      pos._closeError = '';
      pos._closeTx = '';
      try {
        const r = await fetch('/api/predictions/positions/' + pos.asset + '/close', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relay_node_id: this.selectedAgent, size: pos.size }),
        });
        const j = await r.json();
        if (!j.ok) { pos._closeError = j.error || 'unknown'; pos._closing = false; return; }
        pos._closeTx = j.order_result?.transactionHash || j.order_result?.transactionsHashes?.[0] || j.order_result?.orderID || 'submitted';
        alert(`✓ 卖单已提交\n卖价 $${j.sell_price?.toFixed(3)}, 估收回 $${j.proceeds_usdc?.toFixed(2)} USDC, slippage ${j.slippage_pct?.toFixed(2)}%`);
        // refresh positions after a delay
        setTimeout(() => this.loadPositions(), 5000);
      } catch (e) {
        pos._closeError = e.message;
      }
      pos._closing = false;
    },

    // Bettor r44 architect spec: 一键出清 sim 持仓 (Owner 直接介入, 不走 adjustment 审批)
    // confirm modal: 显示 OPEN 数 + 浮动 PnL preview, 1 步 confirm 足够 (sim 0 风险)
    async closeAllSimPositions() {
      if (this.closingAll) return;
      const open = (this.bettorHistory?.positions || []).filter(p => !p.closed_at);
      if (open.length === 0) { alert('没有 OPEN 持仓可出清'); return; }
      const sumPnl = open.reduce((s, p) => s + (p.latest_snapshot?.unrealized_pnl || 0), 0);
      const sign = sumPnl >= 0 ? '+' : '';
      const ok = confirm(
        `即将 close ${open.length} 笔 sim 持仓\n` +
        `预计锁定浮动 PnL: ${sign}$${sumPnl.toFixed(2)} (按最新 snapshot 计)\n` +
        `此操作不可撤销 (sim 数据 status 同样落记录)\n\n` +
        `确认 close 全部?`
      );
      if (!ok) return;
      this.closingAll = true;
      try {
        const r = await fetch('/api/bettor/positions/close-all', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relay_node_id: this.selectedAgent, decided_by: 'owner-manual-close-all' }),
        });
        const j = await r.json();
        if (!j.ok) { alert('出清失败: ' + (j.error || j.reason)); this.closingAll = false; return; }
        alert(`✓ 出清完成: ${j.closed_count} 笔 close, 锁定 ${j.total_realized_pnl >= 0 ? '+' : ''}$${j.total_realized_pnl.toFixed(2)}`);
        await this.loadBettorHistory();
        if (this.bettorTab === 'record') await this.loadBettorRecord();
      } catch (e) { console.error('[bettor] close-all failed:', e.message); alert('出清失败: ' + e.message); }
      this.closingAll = false;
    },

    async bettorResolveNow() {
      if (this.bettorResolving) return;
      this.bettorResolving = true;
      try {
        await fetch('/api/bettor/resolve-now', { method: 'POST' });
        // Resolver runs async; wait briefly + reload
        await new Promise(r => setTimeout(r, 8000));
        await this.loadBettorRecord();
      } catch (e) {
        console.error('[bettor] resolve failed:', e.message);
      } finally {
        this.bettorResolving = false;
      }
    },

    async loadMarkets() {
      try {
        const res = await fetch('/api/predictions/markets');
        const data = await res.json();
        const catKeywords = {
          'Crypto': ['bitcoin','btc','eth','crypto','token','defi','solana','kaspa'],
          'Politics': ['trump','biden','president','election','congress','vote','democrat','republican','government','regime','war','tariff','sanction'],
          'Economy': ['gdp','recession','fed','interest rate','inflation','oil','crude','s&p','nasdaq','stock','market'],
          'Sports': ['nba','nfl','mlb','soccer','football','championship','world cup','match'],
          'Tech': ['ai','openai','google','apple','tesla','spacex','launch'],
        };
        function classify(q) {
          const lower = (q || '').toLowerCase();
          for (const [cat, kws] of Object.entries(catKeywords)) {
            if (kws.some(k => lower.includes(k))) return cat;
          }
          return 'Other';
        }
        this.markets = (data.data || []).map(m => ({
          ...m, _showRule: false, _asking: false, _agentReply: null, _chatHistory: null, _replyInput: '',
          _cat: classify(m.question),
          _created: m.startDate || m.createdAt || '',
        }));
        // Extract unique categories that have markets
        const catSet = new Set(this.markets.map(m => m._cat));
        this.categories = [...catSet].sort();
      } catch (e) { console.error(e); }
      this.loading = false;
    },

    async createPolygonWallet() {
      this.creatingWallet = true;
      this.walletMsg = '';
      try {
        const res = await fetch('/api/relay/' + this.selectedAgent + '/wallets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chain: 'polygon', label: 'Polymarket' }),
        });
        const data = await res.json();
        if (data.ok) {
          this.walletMsg = '钱包创建成功: ' + data.address;
          await this.loadWalletStatus();
        } else {
          this.walletMsg = '创建失败: ' + (data.error || '');
        }
      } catch (e) { this.walletMsg = '创建失败: ' + e.message; }
      this.creatingWallet = false;
    },

    async logoutPolymarket() {
      const usdc = Number(this.walletStatus?.usdc || 0);
      const msg = '退出 Polymarket 将执行:\n' +
        '  1. 取消所有挂单\n' +
        '  2. 把 ' + usdc.toFixed(2) + ' USDC 扫回你指定的地址\n' +
        '  3. 删除 CLOB API Key\n' +
        '  4. 删除 Polygon 钱包和私钥 (不可恢复)\n\n' +
        '请输入接收 USDC 的 Polygon 地址 (0x...):';
      const dest = prompt(msg);
      if (!dest) return;
      if (!/^0x[a-fA-F0-9]{40}$/.test(dest.trim())) {
        alert('无效地址。必须是 0x 开头的 40 位十六进制。');
        return;
      }
      if (!confirm('确认退出并转移 ' + usdc.toFixed(2) + ' USDC 到 ' + dest.slice(0, 10) + '...' + dest.slice(-6) + ' ?')) return;
      this.walletMsg = '退出中...';
      try {
        const res = await fetch('/api/polymarket/' + this.selectedAgent + '/exit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ destinationAddress: dest.trim() }),
        });
        const data = await res.json();
        if (!data.ok) {
          this.walletMsg = '退出失败 (' + (data.step || '?') + '): ' + (data.error || '');
          return;
        }
        this.walletMsg = '退出完成: 转出 ' + data.steps.sweep.amount + ' USDC, TX ' + data.steps.sweep.txHash.slice(0, 12) + '...';
        this.walletStatus = { hasWallet: false, approved: false, hasClobKey: false, usdc: 0 };
        this.showPositions = false;
        this.positions = [];
        this.orders = [];
        this.tradeIdx = null;
      } catch (e) {
        this.walletMsg = '退出请求失败: ' + e.message;
      }
    },

    async loadWalletStatus() {
      if (!this.selectedAgent) return;
      try {
        const res = await fetch('/api/polymarket/' + this.selectedAgent + '/status');
        this.walletStatus = await res.json();
      } catch { this.walletStatus = { hasWallet: false }; }
    },

    async onAgentChange() {
      this.positions = [];
      this.settled = [];
      this.orders = [];
      this.summary = null;
      await this.loadWalletStatus();
      this.loadBettor();
      this.loadPositions();
    },

    async doApprove() {
      this.approving = true;
      this.walletMsg = '';
      try {
        const res = await fetch('/api/polymarket/' + this.selectedAgent + '/approve', { method: 'POST' });
        const data = await res.json();
        if (data.ok) {
          this.walletMsg = '授权 TX 已发送: ' + (data.txHash?.slice(0,12) || '') + '...';
          // 轮询确认
          const txHash = data.txHash;
          const poll = setInterval(async () => {
            const r = await fetch('/api/polymarket/' + this.selectedAgent + '/approve-status?txHash=' + txHash);
            const s = await r.json();
            if (s.confirmed) {
              clearInterval(poll);
              if (s.status === 'success') {
                this.walletMsg = '授权成功';
                this.walletStatus.approved = true;
              } else {
                this.walletMsg = '授权失败';
              }
              this.approving = false;
            }
          }, 3000);
          // 60s 超时
          setTimeout(() => { clearInterval(poll); this.approving = false; }, 60000);
        } else {
          this.walletMsg = '授权失败: ' + (data.error || '');
          this.approving = false;
        }
      } catch (e) {
        this.walletMsg = '授权失败: ' + e.message;
        this.approving = false;
      }
    },

    async doMigrateV2() {
      this.migratingV2 = true;
      this.walletMsg = '';
      try {
        const res = await fetch('/api/polymarket/' + this.selectedAgent + '/migrate-v2', { method: 'POST' });
        const data = await res.json();
        if (data.ok) {
          const sent = Object.keys(data.txHashes || {}).length;
          this.walletMsg = sent ? `V2 迁移完成: ${sent} 笔 TX, pUSD 余额 ${data.pusdBalance}` : 'V2 已就绪';
          // 刷新 walletStatus 拉新的 pusd / v2Migrated
          await this.loadWalletStatus();
        } else {
          this.walletMsg = '迁移失败: ' + (data.error || '');
        }
      } catch (e) { this.walletMsg = '迁移失败: ' + e.message; }
      this.migratingV2 = false;
    },

    async setupClob() {
      this.settingUp = true;
      this.walletMsg = '';
      try {
        const res = await fetch('/api/predictions/setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relay_node_id: this.selectedAgent }),
        });
        const data = await res.json();
        if (data.ok) {
          this.walletMsg = 'API Key 设置成功';
          this.walletStatus.hasClobKey = true;
        } else {
          this.walletMsg = '设置失败: ' + (data.error || '');
        }
      } catch (e) { this.walletMsg = '设置失败: ' + e.message; }
      this.settingUp = false;
    },

    async toggleTrade(idx) {
      if (this.tradeIdx === idx) { this.tradeIdx = null; return; }
      this.tradeIdx = idx;
      this.tradeMsg = '';
      this.book = null;
      // 加载订单簿
      const m = this.filtered[idx];
      if (m?.clobTokenIds) {
        this.bookLoading = true;
        const tokenId = this.tradeForm.outcome === 'yes'
          ? (m.clobTokenIds[0] || m.clobTokenIds)
          : (m.clobTokenIds[1] || m.clobTokenIds);
        try {
          const res = await fetch('/api/predictions/book/' + tokenId);
          this.book = await res.json();
        } catch {}
        this.bookLoading = false;
      }
    },

    async submitOrder(m) {
      if (this.ordering) return;
      const blocker = this.checkTrade(m);
      if (blocker) { this.tradeMsg = blocker.msg; return; }
      this.ordering = true;
      this.tradeMsg = '';
      // 找 token ID
      const tokenId = this.tradeForm.outcome === 'yes'
        ? (m.clobTokenIds?.[0] || m.clobTokenIds)
        : (m.clobTokenIds?.[1] || m.clobTokenIds);
      if (!tokenId) { this.tradeMsg = '无法获取 Token ID'; this.ordering = false; return; }

      try {
        const res = await fetch('/api/predictions/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            relay_node_id: this.selectedAgent,
            tokenId,
            side: this.tradeForm.side,
            price: this.tradeForm.price,
            size: this.tradeForm.size,
          }),
        });
        const data = await res.json();
        if (data.ok || data.success) {
          this.tradeMsg = '下单成功 #' + (data.orderID || data.orderId || '').slice(0,12);
          this.loadPositions();
        } else {
          this.tradeMsg = '下单失败: ' + (data.error || data.errorMsg || '');
        }
      } catch (e) { this.tradeMsg = '下单失败: ' + e.message; }
      this.ordering = false;
    },

    async loadPositionsAll() {
      // Phase 2.1c — bundle positions + protect rules + adjustments + reactor stale for inline display
      await this.loadPositions();
      await Promise.all([
        this.loadBettorProtectRules().catch(() => {}),
        this.loadBettorAdjustments().catch(() => {}),
        this.loadReactorStale().catch(() => {}),
      ]);
    },

    async loadPositions() {
      if (!this.walletStatus.hasClobKey) return;
      try {
        const [posRes, ordRes] = await Promise.all([
          fetch('/api/predictions/positions?relay_node_id=' + this.selectedAgent),
          fetch('/api/predictions/orders?relay_node_id=' + this.selectedAgent),
        ]);
        const posData = await posRes.json();
        const ordData = await ordRes.json();
        this.positions = posData.positions || [];
        this.settled = posData.settled || [];
        this.summary = posData.summary || null;
        this.orders = ordData.orders || [];
      } catch {}
    },

    async cancelOrd(orderId) {
      if (!confirm('撤销此订单？')) return;
      try {
        await fetch('/api/predictions/order/' + orderId + '?relay_node_id=' + this.selectedAgent, { method: 'DELETE' });
        this.loadPositions();
      } catch {}
    },

    async redeemPosition(pos) {
      console.log('[redeem] clicked', { agent: this.selectedAgent, market: pos.market, redeemable: pos.redeemable });
      if (!this.selectedAgent) {
        pos._redeemError = 'No agent selected';
        return;
      }
      if (!pos.market) {
        pos._redeemError = 'No conditionId (pos.market empty)';
        return;
      }
      pos._redeeming = true;
      pos._redeemError = '';
      try {
        const res = await fetch('/api/polymarket/' + this.selectedAgent + '/redeem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conditionId: pos.market }),
        });
        const data = await res.json();
        console.log('[redeem] response', data);
        if (data.ok) {
          pos._redeemed = true;
          pos._redeemTx = data.txHash;
          this.loadWalletStatus();
        } else {
          pos._redeemError = data.error || 'Redeem failed';
          console.error('[redeem] failed', data);
        }
      } catch (e) {
        pos._redeemError = e.message;
        console.error('[redeem] network error', e);
      } finally {
        pos._redeeming = false;
      }
    },

    async redeemAll() {
      const targets = this.settled.filter(p => p.redeemable && !p._redeemed);
      console.log('[redeemAll] targets=' + targets.length);
      if (!targets.length) return;
      this.redeemingAll = true;
      try {
        for (const pos of targets) {
          await this.redeemPosition(pos);
        }
      } finally {
        this.redeemingAll = false;
      }
    },

    async _ensureRulesDigest(m) {
      if (m._rulesDigest) return m._rulesDigest;
      const id = m.conditionId || m.slug;
      if (!id) return null;
      try {
        const r = await fetch('/api/predictions/market/' + id + '/rules');
        if (r.ok) {
          const d = await r.json();
          if (d?.rules_digest) { m._rulesDigest = d; return d; }
        }
      } catch {}
      m._rulesParsing = true;
      try {
        const r = await fetch('/api/predictions/market/' + id + '/parse-rules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ backend: 'qwen' }),
        });
        const d = await r.json();
        if (d?.ok) { m._rulesDigest = d; return d; }
      } catch {}
      finally { m._rulesParsing = false; }
      return null;
    },

    async _fetchTopOfBook(tokenId) {
      try {
        const res = await fetch('/api/predictions/book/' + tokenId);
        const d = await res.json();
        // bids sorted low→high, asks sorted high→low — top of book is LAST element
        const bids = d.bids || []; const asks = d.asks || [];
        const bestBid = bids.length ? parseFloat(bids[bids.length-1].price) : null;
        const bestAsk = asks.length ? parseFloat(asks[asks.length-1].price) : null;
        return { bestBid, bestAsk };
      } catch { return { bestBid: null, bestAsk: null }; }
    },

    async askAgent(m) {
      if (m._asking) return;
      m._asking = true;
      m._agentReply = null;
      m._chatHistory = [{ role: 'agent', text: '读取规则 + 抓盘口...' }];

      // 1) 规则 digest（缓存优先，没缓存就 Qwen 解析 10-20s）
      const rulesRes = await this._ensureRulesDigest(m);
      if (m._rulesParsing) m._chatHistory[0].text = '规则解析中 (~15s)...';

      // 2) 实时 top-of-book — Yes / No 两侧
      const [yesBook, noBook] = await Promise.all([
        m.clobTokenIds?.[0] ? this._fetchTopOfBook(m.clobTokenIds[0]) : Promise.resolve({}),
        m.clobTokenIds?.[1] ? this._fetchTopOfBook(m.clobTokenIds[1]) : Promise.resolve({}),
      ]);

      // 3) 到期倒计时
      const msLeft = m.endDate ? (new Date(m.endDate).getTime() - Date.now()) : null;
      const timeLeft = msLeft == null ? '未知' :
        msLeft < 0 ? '已过期' :
        msLeft < 3600e3 ? Math.round(msLeft/60e3) + ' 分钟' :
        msLeft < 86400e3 ? (msLeft/3600e3).toFixed(1) + ' 小时' :
        (msLeft/86400e3).toFixed(1) + ' 天';

      // 4) 用户余额
      const balance = (this.walletStatus?.usdc ?? 0).toFixed(2);

      // 5) 规则 digest 结构化字段
      const rd = rulesRes?.rules_digest || {};
      const yesCond = rulesRes?.decision_inputs?.yes_conditions || '-';
      const noCond = rulesRes?.decision_inputs?.no_conditions || '-';
      const risks = (rulesRes?.risks || []).join('; ') || '(无)';

      const question = `你是 Polymarket 预测市场交易顾问。基于下面的全部信息给一个**可执行**的建议，不要含糊、不要"需更多信息"。

# 市场
问题: ${m.question}
截止: ${m.endDate || '未知'} (距今 ${timeLeft})

# 当前定价 (真实 top-of-book)
市场隐含: Yes ${m.yes ?? '?'}% / No ${m.no ?? '?'}%
Yes 盘口: 买入需付 $${yesBook.bestAsk ?? '?'} / 卖出可得 $${yesBook.bestBid ?? '?'}
No  盘口: 买入需付 $${noBook.bestAsk ?? '?'} / 卖出可得 $${noBook.bestBid ?? '?'}
24h 成交: $${this.formatVol(m.volume24h || 0)} | 流动性: $${this.formatVol(m.liquidity || 0)}

# 规则 digest (Qwen 解析)
Yes 赢条件: ${yesCond}
No  赢条件: ${noCond}
数据源: ${rd.data_source || '未指定'} | 时区: ${rd.timezone || '未指定'}
⚠ 风险点: ${risks}

# 完整规则原文
${m.description || '(无)'}

# 用户
Polymarket USDC 余额: $${balance}

# 必答 (按编号回，给数字)
1. 你估计真实概率是多少？(给一个具体数字，如 "真实 Yes ≈ 3%")
2. 对比市场价，哪一边 EV 为正？说明为什么。
3. 推荐下单: direction (Yes/No) + side (BUY/SELL) + 限价 $ + 仓位 $USDC。仓位要参考用户 $${balance} 余额，不能建议超过 30%。
4. 止损/退场条件一句话。

不要复读问题。不要说"因不确定所以无法建议"。你有规则、价格、时间、余额，给具体数字。`;

      try {
        const res = await fetch('/api/agent/consult', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            relayNodeId: this.selectedAgent,
            topic: 'predictions',
            question,
            systemNote: '用户在预测市场面板点击"问 Agent"。给出具体下单建议（方向/限价/仓位/止损）。',
          }),
        });
        const data = await res.json();
        const reply = data.reply || data.error || '无回复';
        m._agentReply = reply;
        m._chatHistory = [{ role: 'agent', text: reply }];
      } catch (e) {
        m._agentReply = '分析失败: ' + e.message;
        m._chatHistory = [{ role: 'agent', text: '分析失败: ' + e.message }];
      }
      m._asking = false;
    },

    async replyToAgent(m) {
      const msg = (m._replyInput || '').trim();
      if (!msg || m._asking) return;
      m._asking = true;
      m._replyInput = '';
      if (!m._chatHistory) m._chatHistory = [];
      m._chatHistory.push({ role: 'user', text: msg });
      try {
        const context = `关于预测市场 "${m.question}" (Yes ${m.yes}%/No ${m.no}%)，用户说: ${msg}`;
        const res = await fetch('/api/agent/consult', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            relayNodeId: this.selectedAgent,
            topic: 'predictions',
            question: context,
            systemNote: '接续刚才的预测市场问答，继续给具体建议。',
          }),
        });
        const data = await res.json();
        const reply = data.reply || data.error || '无回复';
        m._chatHistory.push({ role: 'agent', text: reply });
      } catch (e) {
        m._chatHistory.push({ role: 'agent', text: '回复失败: ' + e.message });
      }
      m._asking = false;
    },

    formatVol(v) {
      if (v > 1e6) return (v / 1e6).toFixed(1) + 'M';
      if (v > 1e3) return (v / 1e3).toFixed(0) + 'K';
      return v.toFixed(0);
    },

    interpret(m) {
      if (m.yes > 90) return '市场几乎确定会发生（' + m.yes + '%）';
      if (m.yes > 70) return '市场认为很可能发生 — 可以据此做决策';
      if (m.yes > 55) return '略偏向发生，但不确定 — 需要关注后续变化';
      if (m.yes > 45) return '市场还拿不准（' + m.yes + '/' + m.no + '）— 高不确定性';
      if (m.yes > 30) return '略偏向不发生，但有变数';
      if (m.yes > 10) return '市场认为不太可能发生';
      return '市场几乎确定不会发生（仅 ' + m.yes + '%）';
    },

  };
}
</script>

<%~ include('partials/page-close', it) %>

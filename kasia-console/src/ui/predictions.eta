    async loadBettorProtectRules() {
      // Owner 5/16 钦定 + Bettor r139 — 持仓保护 rules. Returns 3 status groups
      // (pending_owner_ack / active / triggered_*). UI filters in template.
      try {
        const url = '/api/bettor/position-protect/rules' + (this.selectedAgent ? '?relay_node_id=' + this.selectedAgent : '');
        const r = await fetch(url);
        const data = await r.json();
        // Reset client-side ephemeral _acking / _ackError state per Alpine x-for :key
        // stale proxy KI-Phase-B-UI-4 (Bug U1 Layer 2).
        (data?.rules || []).forEach(rec => { rec._acking = false; rec._ackError = null; });
        this.bettorProtectRules = data;
      } catch (e) {
        console.warn('[bettor] protect rules load failed:', e.message);
        this.bettorProtectRules = { ok: false, count: 0, rules: [] };
      }
    },

    async ackBettorProtectRule(rule) {
      // Owner ACK rule → status='active' + 派 HMAC token (Phase 3 daemon firing 用 token verify).
      console.log('[ackBettorProtectRule] called rule=', rule?.id?.slice(0,8), 'status=', rule?.status);
      const confirmed = confirm(`启用持仓保护 ${rule.market_slug} ${rule.side}?\n止损 ${(rule.stop_loss_pct * 100).toFixed(0)}% / 止盈 $${rule.take_profit_price?.toFixed(4)} / 时间 ${rule.time_close_days}d`);
      if (!confirmed) return;
      rule._acking = true; rule._ackError = null;
      try {
        const res = await fetch('/api/bettor/position-protect/rules/' + rule.id + '/ack', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}),
        });
        const data = await res.json();
        if (data.ok) {
          rule.status = 'active';
          await this.loadBettorProtectRules();
        } else {
          rule._ackError = data.error || 'unknown error';
        }
      } catch (e) {
        rule._ackError = e.message;
      } finally {
        rule._acking = false;
      }
    },

    async loadWatchRules() {
      try {
        const url = '/api/predictions/watch-rules' + (this.selectedAgent ? '?relay_node_id=' + this.selectedAgent : '');
        const r = await fetch(url);
        const data = await r.json();
        this.watchRules = (data?.rules || []).map(rec => ({ ...rec, thresholds: rec.thresholds || [] }));
        // default form's relay to currently selected agent (Owner 不用每次选)
        if (!this.watchAdd.relay_node_id && this.selectedAgent) this.watchAdd.relay_node_id = this.selectedAgent;
      } catch (e) {
        console.warn('[watcher] load rules fail:', e.message);
        this.watchRules = [];
      }
    },

    async watcherTickNow() {
      this.watcherTicking = true;
      try {
        await fetch('/api/predictions/watch-rules/tick', { method: 'POST' });
        await this.loadWatchRules();
      } catch (e) {
        alert('tick fail: ' + e.message);
      } finally {
        this.watcherTicking = false;
      }
    },

    async watchSubmit() {
      const f = this.watchAdd;
      if (!f.relay_node_id || !f.token_id || !f.market_title || !f.current_size || !f.entry_avg_price) {
        alert('relay_node_id / token_id / market_title / current_size / entry_avg_price 必填');
        return;
      }
      if (!Array.isArray(f.thresholds) || f.thresholds.length === 0) {
        alert('至少一个阈值');
        return;
      }
      this.watchSubmitting = true;
      try {
        const res = await fetch('/api/predictions/watch-rules', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            relay_node_id: f.relay_node_id, token_id: f.token_id, market_title: f.market_title,
            outcome: f.outcome, current_size: f.current_size, entry_avg_price: f.entry_avg_price,
            thresholds: f.thresholds,
          }),
        });
        const data = await res.json();
        if (!data.ok) { alert('保存失败: ' + (data.error || 'unknown')); return; }
        this.watchAdd.show = false;
        await this.loadWatchRules();
      } catch (e) {
        alert('保存 fail: ' + e.message);
      } finally {
        this.watchSubmitting = false;
      }
    },

    async watchToggleStatus(rule) {
      const newStatus = rule.status === 'active' ? 'paused' : 'active';
      try {
        await fetch('/api/predictions/watch-rules/' + rule.id, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        await this.loadWatchRules();
      } catch (e) { console.warn('[watcher] toggle fail:', e.message); }
    },

    async watchDelete(id) {
      if (!confirm('删除该 watcher rule?')) return;
      try {
        await fetch('/api/predictions/watch-rules/' + id, { method: 'DELETE' });
        await this.loadWatchRules();
      } catch (e) { console.warn('[watcher] delete fail:', e.message); }
    },

    // ── Fossa-Stable mode (Owner 5/17 + Bettor r173/r178) ──
    async loadFossaStable() {
      try {
        const url = '/api/bettor/recommendations/history?days=7&limit=200' + (this.selectedAgent ? '&relay_node_id=' + this.selectedAgent : '');
        const [recsRes, newsRes, stairRes] = await Promise.all([
          fetch(url).then(r => r.json()).catch(() => ({})),
          fetch('/api/bettor/live-news-inject').then(r => r.json()).catch(() => ({})),
          fetch('/api/bettor/stair-step-audit').then(r => r.json()).catch(() => ({})),
        ]);
        const allRecs = recsRes?.recommendations || [];
        const fossa = allRecs.filter(r => r.strategy === 'fossa-stable');
        fossa.forEach(r => { r._acking = false; r._ackError = null; });
        this.fossaRecs = fossa;
        this.liveNewsActive = newsRes?.injects || [];
        this.stairAudits = stairRes?.audits || [];
      } catch (e) {
        console.warn('[fossa] load fail:', e.message);
        this.fossaRecs = [];
        this.liveNewsActive = [];
        this.stairAudits = [];
      }
    },

    async fossaTickNow() {
      this.fossaTicking = true;
      try {
        await fetch('/api/bettor/fossa-stable/tick', { method: 'POST' });
        await this.loadFossaStable();
      } catch (e) {
        alert('fossa tick fail: ' + e.message);
      } finally {
        this.fossaTicking = false;
      }
    },

    async liveNewsSubmit() {
      if (!this.liveNewsInjectText.trim()) { alert('inject_text 必填'); return; }
      this.liveNewsSubmitting = true;
      try {
        const res = await fetch('/api/bettor/live-news-inject', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ inject_text: this.liveNewsInjectText, effective_hours: this.liveNewsHours || 24 }),
        });
        const data = await res.json();
        if (!data.ok) { alert('保存失败: ' + (data.error || 'unknown')); return; }
        this.liveNewsInjectText = '';
        await this.loadFossaStable();
      } catch (e) {
        alert('保存 fail: ' + e.message);
      } finally {
        this.liveNewsSubmitting = false;
      }
    },


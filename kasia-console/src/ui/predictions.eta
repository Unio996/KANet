    async loadBettorHistoryRecs() {
      // Owner 5/15 严训 "推荐 history 没保存" + Bettor r132: data IS saved (173 rows on
      // Bettor host, similar J1), Owner saw 战绩 tab showing 0 outcome_log rows (legitimate
      // 24-48h oracle delay) and assumed not saved. UI tab to browse raw rec table fills gap.
      try {

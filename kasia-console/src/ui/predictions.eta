<%~ include('partials/page-open', { _page: 'predictions', pageTitle: '预测市场', ...it }) %>

<div class="p-6" x-data="predictionsPage()" x-init="init()">

  <!-- 钱包状态栏 -->
  <div class="card card-compact mb-4 flex items-center gap-4 flex-wrap">
    <select x-model="selectedAgent" @change="onAgentChange()" class="rounded-lg border border-warm-300 px-3 py-1.5 text-sm bg-white font-medium">
      <% it.relayNodes.forEach(r => { %>
      <option value="<%= r.id %>"><%= r.name %></option>
      <% }) %>
    </select>

    <template x-if="walletStatus.hasWallet">
      <div class="flex items-center gap-3 text-sm">
        <span class="font-mono text-xs text-ink-400 cursor-pointer" @click="navigator.clipboard.writeText(walletStatus.address)" title="点击复制" x-text="walletStatus.address?.slice(0,8) + '...' + walletStatus.address?.slice(-6)"></span>
        <span class="font-bold" :class="walletStatus.pusd > 0 ? 'text-green-600' : 'text-ink-400'" x-text="(walletStatus.pusd ?? 0).toFixed(2) + ' pUSD'"
              title="Polymarket V2 抵押 token. 1 pUSD = 1 USDC, 可双向 wrap"></span>
        <template x-if="walletStatus.usdc > 0">
          <span class="text-xs"
                :class="walletStatus.v2Migrated ? 'text-ink-500' : 'text-amber-600'"
                x-text="walletStatus.usdc.toFixed(2) + ' USDC' + (walletStatus.v2Migrated ? '' : ' 未包装')"
                :title="walletStatus.v2Migrated
                  ? 'Polymarket 赎回回款 = USDC（不是 pUSD）。可点 \'包装为 pUSD\' 继续下单，或点 \'退出\' 提现到外部地址。'
                  : 'Polymarket V2 不直接吃 USDC，点 \'迁移到 V2\' 包成 pUSD'"></span>
        </template>
        <template x-if="walletStatus.usdt > 0">
          <span class="text-xs text-ink-500" x-text="walletStatus.usdt.toFixed(2) + ' USDT'"></span>
        </template>
        <template x-if="walletStatus.matic > 0">
          <span class="text-xs text-ink-400" x-text="walletStatus.matic.toFixed(4) + ' MATIC'"></span>
        </template>
        <template x-if="walletStatus.approved">
          <span class="badge badge-success text-[9px]">已授权</span>
        </template>
        <template x-if="!walletStatus.approved && walletStatus.hasWallet">
          <button @click="doApprove()" :disabled="approving" class="btn btn-sm btn-warning text-[10px]">
            <span x-text="approving ? '授权中...' : '授权 USDC'"></span>
          </button>
        </template>
        <template x-if="walletStatus.v2Migrated">
          <span class="badge badge-success text-[9px]" title="pUSD 已 approve V2 exchange">V2 ✓</span>
        </template>
        <template x-if="walletStatus.approved && (!walletStatus.v2Migrated || walletStatus.usdc > 0)">
          <button @click="doMigrateV2()" :disabled="migratingV2"
                  :class="walletStatus.v2Migrated ? 'btn btn-sm btn-ghost text-[10px] text-ink-500' : 'btn btn-sm btn-warning text-[10px]'"
                  :title="walletStatus.v2Migrated ? '把这笔 USDC 包成 pUSD 用于继续下单（不想下单可点 \'退出\' 提现）' : 'Polymarket 4/28 切到 V2 抵押 token, 必须迁移才能下单'">
            <span x-text="migratingV2 ? '迁移中...' : (walletStatus.v2Migrated ? '包装为 pUSD' : '迁移到 V2')"></span>
          </button>
        </template>
        <template x-if="walletStatus.hasClobKey">
          <span class="badge badge-info text-[9px]">API 就绪</span>
        </template>
        <template x-if="!walletStatus.hasClobKey && walletStatus.hasWallet">
          <button @click="setupClob()" :disabled="settingUp" class="btn btn-sm btn-secondary text-[10px]">
            <span x-text="settingUp ? '设置中...' : '设置 API Key'"></span>
          </button>
        </template>
        <button @click="logoutPolymarket()" class="btn btn-sm btn-ghost text-[10px] text-red-400">退出</button>
      </div>
    </template>
    <template x-if="!walletStatus.hasWallet">
      <div class="flex items-center gap-2">
        <span class="text-xs text-ink-400">无 Polygon 钱包</span>
        <button @click="createPolygonWallet()" :disabled="creatingWallet" class="btn btn-sm btn-primary text-[10px]">
          <span x-text="creatingWallet ? '创建中...' : '创建 Polygon 钱包'"></span>
        </button>
        <span x-show="walletMsg && !walletStatus.hasWallet" class="text-xs text-red-500" x-text="walletMsg"></span>
      </div>
    </template>
    <div x-show="walletMsg" class="text-xs ml-2" :class="walletMsg.includes('失败') ? 'text-red-500' : 'text-green-600'" x-text="walletMsg"></div>
  </div>

  <!-- Bettor 入口按钮 (Phase 3a) — 点开弹 modal, 用当前 selectedAgent 的 adapter 扫 -->
  <div class="mb-4 flex items-center gap-3 flex-wrap">
    <button @click="bettorModalOpen = true; loadBettor()"
            class="btn btn-primary text-sm flex items-center gap-2">
      <span>Bettor 今日推荐</span>
      <template x-if="bettorRecs && (bettorRecs.recommendations || []).length">
        <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-white/25" x-text="bettorRecs.recommendations.length"></span>
      </template>
    </button>
    <template x-if="bettorRecs && bettorRecs.scanned_at">
      <span class="text-xs text-ink-400" x-text="'此 Agent 上次扫描于 ' + new Date(bettorRecs.scanned_at).toLocaleString()"></span>
    </template>
    <template x-if="bettorRecs && !bettorRecs.scanned_at">
      <span class="text-xs text-ink-400">此 Agent 尚未扫描</span>
    </template>
  </div>

  <!-- Phase 2.1c Bettor r151 §3.C — Protect rule edit modal (4-field form) -->
  <template x-if="protectEditModal">
    <div class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4" @click="closeProtectEditModal()" @keydown.escape.window="closeProtectEditModal()">
      <div class="card max-w-md w-full" @click.stop>
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-warm-200">
          <div class="text-sm font-bold">✏️ 改 保护规则阈值</div>
          <button @click="closeProtectEditModal()" class="text-ink-400 hover:text-ink-700 text-xl">✕</button>
        </div>
        <div class="text-[10px] text-ink-500 mb-3" x-text="protectEditModal?.market_slug"></div>
        <div class="space-y-3 text-xs">
          <div>
            <label class="block text-ink-500 mb-1">止损 % (负数, 默认 -30%)</label>
            <input type="number" step="0.05" min="-1" max="0" x-model.number="protectEditForm.stop_loss_pct" class="w-full px-2 py-1 border border-warm-300 rounded">
          </div>
          <div>
            <label class="block text-ink-500 mb-1">Cooldown 小时 (默认 12h, 触发止损前最小持仓时间)</label>
            <input type="number" step="1" min="0" x-model.number="protectEditForm.cooldown_hours" class="w-full px-2 py-1 border border-warm-300 rounded">
          </div>
          <div>
            <label class="block text-ink-500 mb-1">时间天数 (默认 60d, 超过自动 close)</label>
            <input type="number" step="1" min="1" x-model.number="protectEditForm.time_close_days" class="w-full px-2 py-1 border border-warm-300 rounded">
          </div>
          <div>
            <label class="block text-ink-500 mb-1">止盈价 (📋 ref only, 待 Phase 3 swap-suggester reactivate)</label>
            <input type="number" step="0.01" min="0" max="1" x-model.number="protectEditForm.take_profit_price" class="w-full px-2 py-1 border border-warm-300 rounded text-ink-400">
          </div>
        </div>
        <div class="flex gap-2 mt-4">
          <button @click="saveProtectEditModal()" class="flex-1 px-3 py-1.5 bg-brand-500 hover:bg-brand-600 text-white rounded text-xs font-bold">💾 保存 (改后需重新 ACK)</button>
          <button @click="closeProtectEditModal()" class="px-3 py-1.5 bg-warm-200 hover:bg-warm-300 text-ink-700 rounded text-xs">取消</button>
        </div>
      </div>
    </div>
  </template>

  <!-- Bettor 推荐 modal -->
  <template x-if="bettorModalOpen">
    <div class="fixed inset-0 z-40 bg-black/50 flex items-start justify-center p-4 overflow-y-auto" @click="bettorModalOpen = false" @keydown.escape.window="bettorModalOpen = false">
      <div class="card max-w-4xl w-full my-8" @click.stop>
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-warm-200">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-lg font-medium text-brand-700">Bettor 今日推荐</span>
            <template x-if="bettorRecs && bettorRecs.scanned_at">
              <span class="text-xs text-ink-400" x-text="'扫描于 ' + new Date(bettorRecs.scanned_at).toLocaleString()"></span>
            </template>
            <template x-if="bettorRecs && (bettorRecs.recommendations || []).length">
              <span class="text-xs text-ink-500" x-text="'(' + bettorRecs.recommendations.length + ' 个)'"></span>
            </template>
          </div>
          <div class="flex items-center gap-2">
            <template x-if="bettorTab === 'recs'">
              <button @click="bettorScan()" :disabled="bettorScanning" class="btn btn-sm btn-secondary text-[11px]">
                <span x-text="bettorScanning ? '扫描中...' : '立即重扫'"></span>
              </button>
            </template>
            <template x-if="bettorTab === 'record'">
              <button @click="bettorResolveNow()" :disabled="bettorResolving" class="btn btn-sm btn-secondary text-[11px]">
                <span x-text="bettorResolving ? '结算中...' : '立即结算'"></span>
              </button>
            </template>
            <!-- close-all sticky button: 任何 tab 都看到, 仅 OPEN > 0 显示 -->
            <template x-if="bettorHistory && (bettorHistory.positions || []).some(p => !p.closed_at)">
              <button @click="closeAllSimPositions()" :disabled="closingAll"
                      class="btn btn-sm bg-amber-500 hover:bg-amber-600 text-white text-[11px]">
                <span x-show="!closingAll" x-text="'一键出清 (' + bettorHistory.positions.filter(p => !p.closed_at).length + ' 笔)'"></span>
                <span x-show="closingAll">出清中...</span>
              </button>
            </template>
            <button @click="bettorModalOpen = false" class="text-ink-400 hover:text-ink-700 text-xl px-2">✕</button>
          </div>
        </div>

        <!-- Tabs -->
        <div class="flex border-b border-warm-200 mb-4">
          <button @click="bettorTab = 'recs'"
                  :class="bettorTab === 'recs' ? 'border-b-2 border-brand-500 text-brand-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm">今日推荐</button>
          <button @click="bettorTab = 'record'; loadBettorRecord()"
                  :class="bettorTab === 'record' ? 'border-b-2 border-brand-500 text-brand-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            战绩
            <template x-if="bettorRecord && bettorRecord.stats && bettorRecord.stats.resolved > 0">
              <span class="text-[10px] text-ink-500" x-text="'(' + bettorRecord.stats.hits + '/' + bettorRecord.stats.resolved + ', ' + ((bettorRecord.stats.hit_rate || 0) * 100).toFixed(0) + '%)'"></span>
            </template>
          </button>
          <button @click="bettorTab = 'history'; loadBettorHistory()"
                  :class="bettorTab === 'history' ? 'border-b-2 border-brand-500 text-brand-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            历史
            <template x-if="bettorHistory && bettorHistory.total > 0">
              <span class="text-[10px] text-ink-500" x-text="'(' + bettorHistory.total + ')'"></span>
            </template>
          </button>
          <button @click="bettorTab = 'adjust'; loadBettorAdjustments()"
                  :class="bettorTab === 'adjust' ? 'border-b-2 border-orange-500 text-orange-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            调仓建议
            <template x-if="bettorAdjustments && bettorAdjustments.count > 0">
              <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-orange-100 text-orange-700" x-text="bettorAdjustments.count"></span>
            </template>
          </button>
          <button @click="bettorTab = 'winrate'; loadBettorWinrate()"
                  :class="bettorTab === 'winrate' ? 'border-b-2 border-brand-500 text-brand-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            胜率轨迹
            <template x-if="bettorWinrate && bettorWinrate.cumulative && bettorWinrate.cumulative.length">
              <span class="text-[10px] text-ink-500" x-text="'(' + ((bettorWinrate.cumulative[bettorWinrate.cumulative.length-1].cum_hit_rate || 0) * 100).toFixed(0) + '%, $' + (bettorWinrate.cumulative[bettorWinrate.cumulative.length-1].cum_pnl || 0).toFixed(0) + ')'"></span>
            </template>
          </button>
          <!-- Owner 5/15 严训 + Bettor r132 spec: browse all 173 recs across all scans -->
          <button @click="bettorTab = 'history-recs'; loadBettorHistoryRecs()"
                  :class="bettorTab === 'history-recs' ? 'border-b-2 border-brand-500 text-brand-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            推荐历史
            <template x-if="bettorHistoryRecs && bettorHistoryRecs.recommendations && bettorHistoryRecs.recommendations.length">
              <span class="text-[10px] text-ink-500" x-text="'(' + bettorHistoryRecs.recommendations.length + ')'"></span>
            </template>
          </button>
          <!-- Owner 5/16 钦定 + Bettor r139 spec: 持仓自动保护 (止损/止盈/时间/redeem) -->
          <button @click="bettorTab = 'protect'; loadBettorProtectRules()"
                  :class="bettorTab === 'protect' ? 'border-b-2 border-brand-500 text-brand-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            持仓保护
            <template x-if="bettorProtectRules && bettorProtectRules.rules">
              <span class="text-[10px] text-ink-500" x-text="'(' + (bettorProtectRules.rules.filter(r => r.status === 'pending_owner_ack').length) + '⏸ + ' + (bettorProtectRules.rules.filter(r => r.status === 'active').length) + '✓)'"></span>
            </template>
          </button>
          <!-- Owner 5/17 钦定 mode 1+2 组合: 阈值 watcher (alert only, ACK 才 fire) -->
          <button @click="bettorTab = 'watcher'; loadWatchRules()"
                  :class="bettorTab === 'watcher' ? 'border-b-2 border-amber-500 text-amber-700 font-medium' : 'text-ink-400 hover:text-ink-600'"
                  class="px-4 py-2 text-sm flex items-center gap-1">
            阈值 Watcher
            <template x-if="watchRules && watchRules.length">
              <span class="text-[10px] text-ink-500" x-text="'(' + watchRules.filter(r => r.status === 'active').length + ' 守)'"></span>
            </template>
          </button>
        </div>

        <!-- Tab content: 调仓建议 (Phase 3e-1 止损队列) -->
        <template x-if="bettorTab === 'adjust'">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="text-xs text-ink-500">
                <span class="font-medium">触发规则:</span>
                反向 drift > 30pp / 浮亏 > 50% / drift>15pp+pnl<-25% (σ-adjusted)
              </div>
              <button @click="bettorEvaluateNow()" :disabled="bettorEvaluating" class="btn btn-sm btn-secondary text-[11px]">
                <span x-text="bettorEvaluating ? '评估中...' : '立即评估'"></span>
              </button>
            </div>
            <template x-if="bettorAdjustments && (bettorAdjustments.adjustments || []).length">
              <div class="space-y-2">
                <template x-for="a in bettorAdjustments.adjustments" :key="a.id">
                  <div class="card card-compact" :class="a.severity === 'critical' ? 'border-l-4 border-l-red-600 bg-red-50/30' : 'border-l-4 border-l-orange-500 bg-orange-50/20'">
                    <div class="flex items-start gap-2 mb-1">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold whitespace-nowrap"
                            :class="a.severity === 'critical' ? 'bg-red-100 text-red-700' : 'bg-orange-100 text-orange-700'"
                            x-text="a.severity === 'critical' ? '🚨 CRITICAL' : '⚠ WARNING'"></span>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-gray-100 text-gray-700" x-text="a.adj_type"></span>
                      <a :href="'https://polymarket.com/event/' + (a.slug || a.condition_id || '')" target="_blank" rel="noopener"
                         class="flex-1 text-sm font-medium text-ink-700 hover:text-brand-600" x-text="a.question"></a>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold"
                            :class="a.direction === 'YES' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'"
                            x-text="'BUY ' + a.direction"></span>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-[11px] text-ink-500 mb-2">
                      <div>入场 yes <span class="font-medium text-ink-700" x-text="(a.entry_yes_price * 100).toFixed(0) + '%'"></span></div>
                      <div>当前 yes <span class="font-medium text-ink-700" x-text="(a.current_yes_price * 100).toFixed(0) + '%'"></span></div>
                      <div>drift <span class="font-medium text-red-500" x-text="(a.drift_pp >= 0 ? '+' : '') + a.drift_pp.toFixed(1) + 'pp'"></span></div>
                      <div>仓位 <span class="font-medium text-ink-700" x-text="'$' + a.size_usd.toFixed(0)"></span></div>
                    </div>
                    <div class="text-[11px] text-ink-600 mb-2">
                      <span class="font-medium">浮动 PnL:</span>
                      <span :class="a.unrealized_pnl >= 0 ? 'text-green-600' : 'text-red-600'" x-text="'$' + a.unrealized_pnl.toFixed(2) + ' (' + a.pnl_pct.toFixed(1) + '% of size)'"></span>
                    </div>
                    <div class="text-[10px] text-ink-500 mb-2">
                      <span class="font-medium">触发原因:</span> <span x-text="a.trigger_reason"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <button @click="bettorDecideAdjustment(a.id, 'approve')" class="btn btn-sm bg-red-600 hover:bg-red-700 text-white text-[11px] px-3 py-1">
                        ✓ 确认止损 (paper)
                      </button>
                      <button @click="bettorDecideAdjustment(a.id, 'reject')" class="btn btn-sm bg-warm-200 hover:bg-warm-300 text-ink-700 text-[11px] px-3 py-1">
                        ✗ 保留持仓
                      </button>
                      <span class="text-[10px] text-ink-400 ml-auto" x-text="'触发于 ' + new Date(a.created_at).toLocaleString()"></span>
                    </div>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="bettorAdjustments && !(bettorAdjustments.adjustments || []).length">
              <div class="text-center py-12 text-sm text-ink-400">
                <div>暂无调仓建议</div>
                <div class="text-[11px] mt-1">所有 open 仓位风险可控. 1h cron 自动评估, 触发即推</div>
              </div>
            </template>
            <template x-if="!bettorAdjustments">
              <div class="text-center py-12 text-sm text-ink-400">载入中...</div>
            </template>
          </div>
        </template>

        <!-- Tab content: 历史 — 全部推荐跨批次, 按 opened_at 倒序, 含 drift / max_DD / max_gain / 浮盈 -->
        <template x-if="bettorTab === 'history'">
          <div>
            <template x-if="bettorHistory && bettorHistory.batches && bettorHistory.batches.length">
              <div class="space-y-1 mb-3 pb-3 border-b border-warm-200">
                <div class="text-xs font-medium text-ink-700 mb-2" x-text="'共 ' + bettorHistory.total + ' 条推荐, 跨 ' + bettorHistory.batches.length + ' 批扫描'"></div>
                <template x-for="b in bettorHistory.batches" :key="b.scanned_at">
                  <div class="text-[11px] text-ink-500 flex items-center gap-3">
                    <span class="font-medium" x-text="new Date(b.scanned_at).toLocaleString()"></span>
                    <span x-text="b.n + ' 条 (' + b.n_open + ' open / ' + b.n_resolved + ' resolved)'"></span>
                    <span class="font-medium" :class="(b.total_unrealized_pnl + b.total_realized_pnl) >= 0 ? 'text-green-600' : 'text-red-500'"
                          x-text="'累计 PnL $' + (b.total_unrealized_pnl + b.total_realized_pnl).toFixed(2)"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- Bettor r44 architect spec: 一键出清 sim 持仓 button (open positions only) -->
            <template x-if="bettorHistory && (bettorHistory.positions || []).some(p => !p.closed_at)">
              <div class="flex items-center justify-between mb-2 px-1 py-1 bg-warm-50 rounded">
                <span class="text-[10px] text-ink-500">
                  <span x-text="'OPEN ' + bettorHistory.positions.filter(p => !p.closed_at).length + ' 笔'"></span>
                  <span class="ml-1" x-text="(() => { const sum = bettorHistory.positions.filter(p => !p.closed_at).reduce((s,p) => s + (p.latest_snapshot?.unrealized_pnl || 0), 0); return '浮动 ' + (sum >= 0 ? '+' : '') + '$' + sum.toFixed(2); })()"
                        :class="bettorHistory.positions.filter(p => !p.closed_at).reduce((s,p) => s + (p.latest_snapshot?.unrealized_pnl || 0), 0) >= 0 ? 'text-green-600' : 'text-red-500'"></span>
                </span>
                <button @click="closeAllSimPositions()" :disabled="closingAll"
                        class="btn btn-sm btn-warning text-[10px]">
                  <span x-show="!closingAll" x-text="'一键出清全部 sim 持仓 (' + bettorHistory.positions.filter(p => !p.closed_at).length + ' 笔)'"></span>
                  <span x-show="closingAll">出清中...</span>
                </button>
              </div>
            </template>
            <template x-if="bettorHistory && (bettorHistory.positions || []).length">
              <div class="space-y-2">
                <template x-for="p in bettorHistory.positions" :key="p.position_id">
                  <div class="card card-compact"
                       :class="p.closed_at ? (p.was_correct === 1 ? 'border-l-4 border-l-green-500' : (p.was_correct === 0 ? 'border-l-4 border-l-red-500' : 'border-l-4 border-l-gray-400')) : (p.latest_snapshot && p.latest_snapshot.unrealized_pnl > 0 ? 'border-l-4 border-l-green-300' : (p.latest_snapshot && p.latest_snapshot.unrealized_pnl < 0 ? 'border-l-4 border-l-red-300' : 'border-l-4 border-l-warm-300'))">
                    <div class="flex items-start gap-2 mb-1">
                      <a :href="'https://polymarket.com/event/' + (p.slug || p.condition_id || '')" target="_blank" rel="noopener"
                         class="flex-1 text-sm font-medium text-ink-700 hover:text-brand-600" x-text="p.question"></a>
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold whitespace-nowrap"
                            :class="p.direction === 'YES' ? 'bg-green-100 text-green-700' : p.direction === 'NO' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600'"
                            x-text="p.direction === 'SKIP' ? 'SKIP' : 'BUY ' + p.direction"></span>
                      <template x-if="p.closed_at">
                        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold"
                              :class="p.was_correct === 1 ? 'bg-green-100 text-green-700' : (p.was_correct === 0 ? 'bg-red-100 text-red-600' : 'bg-gray-100 text-gray-600')"
                              x-text="p.was_correct === 1 ? '✓ HIT' : (p.was_correct === 0 ? '✗ MISS' : '— ' + p.close_reason)"></span>
                      </template>
                      <template x-if="!p.closed_at">
                        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-600">OPEN</span>
                      </template>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-[11px] text-ink-500">
                      <div>入场 yes <span class="font-medium text-ink-700" x-text="(p.entry_yes_price * 100).toFixed(1) + '%'"></span></div>
                      <div>当前 yes
                        <template x-if="p.latest_snapshot">
                          <span class="font-medium text-ink-700" x-text="(p.latest_snapshot.current_yes_price * 100).toFixed(1) + '%'"></span>
                        </template>
                        <template x-if="!p.latest_snapshot && p.outcome">
                          <span class="font-medium" x-text="p.outcome === 'YES' ? '100% (resolved)' : '0% (resolved)'"></span>
                        </template>
                      </div>
                      <div>drift
                        <template x-if="p.latest_snapshot">
                          <span class="font-medium" :class="(p.latest_snapshot.drift_pp || 0) > 0 ? 'text-red-500' : 'text-green-600'"
                                x-text="(p.latest_snapshot.drift_pp >= 0 ? '+' : '') + p.latest_snapshot.drift_pp.toFixed(1) + 'pp'"></span>
                        </template>
                      </div>
                      <div>仓位 <span class="font-medium text-ink-700" x-text="'$' + p.size_usd.toFixed(0)"></span></div>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-[10px] text-ink-400 mt-1">
                      <div>pMid <span class="font-medium text-ink-600" x-text="(p.p_mid * 100).toFixed(1) + '%'"></span></div>
                      <div>σ <span class="font-medium text-ink-600" x-text="(p.sigma * 100).toFixed(1) + '%'"></span></div>
                      <div>max gain <span class="font-medium text-green-600" x-text="(p.max_unrealized_gain_pp || 0).toFixed(1) + '%'"></span></div>
                      <div>max DD <span class="font-medium text-red-500" x-text="(p.max_drawdown_pp || 0).toFixed(1) + '%'"></span></div>
                    </div>
                    <div class="text-[10px] text-ink-400 mt-1">
                      <template x-if="p.closed_at">
                        <span>已结算 PnL <span class="font-medium" :class="(p.realized_pnl || 0) >= 0 ? 'text-green-600' : 'text-red-500'" x-text="'$' + (p.realized_pnl || 0).toFixed(2)"></span></span>
                      </template>
                      <template x-if="!p.closed_at && p.latest_snapshot">
                        <span>浮动 PnL <span class="font-medium" :class="(p.latest_snapshot.unrealized_pnl || 0) >= 0 ? 'text-green-600' : 'text-red-500'" x-text="'$' + (p.latest_snapshot.unrealized_pnl || 0).toFixed(2)"></span></span>
                      </template>
                      <span class="ml-3">扫于 <span x-text="new Date(p.scanned_at).toLocaleString()"></span></span>
                      <span class="ml-3" x-show="p.end_date">到期 <span x-text="new Date(p.end_date).toLocaleDateString()"></span></span>
                      <span class="ml-3">tier <span x-text="p.llm_tier"></span></span>
                    </div>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="bettorHistory && !(bettorHistory.positions || []).length">
              <div class="text-center py-12 text-sm text-ink-400">暂无历史推荐</div>
            </template>
            <template x-if="!bettorHistory">
              <div class="text-center py-12 text-sm text-ink-400">载入中...</div>
            </template>
          </div>
        </template>

        <!-- Tab content: 胜率轨迹 (Module 4b — Owner 5/15 钦定 推荐历史 + 胜率时间变化线) -->
        <template x-if="bettorTab === 'winrate'">
          <div>
            <template x-if="!bettorWinrate">
              <div class="text-center py-12 text-sm text-ink-400">载入中...</div>
            </template>
            <template x-if="bettorWinrate && bettorWinrate.daily && bettorWinrate.daily.length === 0">
              <div class="text-center py-12 text-sm text-ink-400">
                暂无 outcome 数据 — resolver cron 跑 + 推荐 resolve 后会自动 populate (Module 1 v110 表 bettor_outcome_log)
              </div>
            </template>
            <template x-if="bettorWinrate && bettorWinrate.daily && bettorWinrate.daily.length > 0">
              <div>
                <!-- Summary cards (top) -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                  <div class="card card-compact text-center">
                    <div class="text-[10px] text-ink-400">累计胜率</div>
                    <div class="text-xl font-bold text-brand-700" x-text="((bettorWinrate.cumulative.at(-1)?.cum_hit_rate || 0) * 100).toFixed(1) + '%'"></div>
                  </div>
                  <div class="card card-compact text-center">
                    <div class="text-[10px] text-ink-400">累计 P&L</div>
                    <div class="text-xl font-bold" :class="(bettorWinrate.cumulative.at(-1)?.cum_pnl || 0) >= 0 ? 'text-green-600' : 'text-red-600'"
                         x-text="'$' + (bettorWinrate.cumulative.at(-1)?.cum_pnl || 0).toFixed(2)"></div>
                  </div>
                  <div class="card card-compact text-center">
                    <div class="text-[10px] text-ink-400">已结算</div>
                    <div class="text-xl font-bold text-ink-700" x-text="bettorWinrate.cumulative.at(-1)?.cum_total || 0"></div>
                  </div>
                  <div class="card card-compact text-center">
                    <div class="text-[10px] text-ink-400">查询窗口</div>
                    <div class="text-xl font-bold text-ink-700" x-text="bettorWinrate.days + 'd'"></div>
                  </div>
                </div>

                <!-- Daily hit rate bar chart (SVG, no external lib dependency) -->
                <div class="card mb-4">
                  <div class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2">每日命中率 (绿=命中, 红=失败)</div>
                  <div class="overflow-x-auto">
                    <svg :viewBox="'0 0 ' + (Math.max(bettorWinrate.daily.length, 1) * 30 + 40) + ' 120'" class="w-full" style="min-height:120px">
                      <!-- Bars -->
                      <template x-for="(d, i) in bettorWinrate.daily" :key="d.date">
                        <g>
                          <!-- bar -->
                          <rect :x="20 + i * 30" :y="100 - (d.hit_rate || 0) * 80"
                                width="22" :height="(d.hit_rate || 0) * 80"
                                :fill="(d.hit_rate || 0) >= 0.5 ? '#16a34a' : '#dc2626'" />
                          <!-- date label -->
                          <text :x="31 + i * 30" y="115" font-size="8" text-anchor="middle" fill="#6b7280"
                                x-text="d.date ? d.date.slice(5) : ''"></text>
                          <!-- total label above bar -->
                          <text :x="31 + i * 30" :y="98 - (d.hit_rate || 0) * 80" font-size="8" text-anchor="middle" fill="#374151"
                                x-text="(d.correct || 0) + '/' + (d.total || 0)"></text>
                        </g>
                      </template>
                      <!-- 50% line -->
                      <line x1="20" y1="60" :x2="bettorWinrate.daily.length * 30 + 20" y2="60" stroke="#9ca3af" stroke-dasharray="2,2" stroke-width="0.5" />
                      <text x="5" y="63" font-size="7" fill="#9ca3af">50%</text>
                    </svg>
                  </div>
                </div>

                <!-- Cumulative P&L + cum hit rate dual-line -->
                <div class="card">
                  <div class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2">累计 P&L (蓝) + 累计胜率 (橙)</div>
                  <div class="overflow-x-auto">
                    <svg :viewBox="'0 0 ' + (Math.max(bettorWinrate.cumulative.length, 1) * 30 + 40) + ' 120'" class="w-full" style="min-height:120px">
                      <!-- Compute scale once: max abs cum_pnl -->
                      <template x-if="bettorWinrate.cumulative.length > 0">
                        <g>
                          <!-- 0 P&L baseline -->
                          <line x1="20" y1="60" :x2="bettorWinrate.cumulative.length * 30 + 20" y2="60" stroke="#9ca3af" stroke-dasharray="2,2" stroke-width="0.5" />
                          <text x="5" y="63" font-size="7" fill="#9ca3af">$0</text>
                          <!-- P&L polyline -->
                          <polyline fill="none" stroke="#2563eb" stroke-width="1.5"
                            :points="bettorWinrate.cumulative.map((c, i) => {
                              const maxAbs = Math.max(1, ...bettorWinrate.cumulative.map(x => Math.abs(x.cum_pnl || 0)));
                              const y = 60 - ((c.cum_pnl || 0) / maxAbs) * 50;
                              return (31 + i * 30) + ',' + y;
                            }).join(' ')" />
                          <!-- Hit rate polyline (right axis, 0-100% mapped 100-10) -->
                          <polyline fill="none" stroke="#f97316" stroke-width="1.5"
                            :points="bettorWinrate.cumulative.map((c, i) => (31 + i * 30) + ',' + (100 - (c.cum_hit_rate || 0) * 90)).join(' ')" />
                          <!-- Date labels -->
                          <template x-for="(c, i) in bettorWinrate.cumulative" :key="'l' + c.date">
                            <text :x="31 + i * 30" y="115" font-size="8" text-anchor="middle" fill="#6b7280" x-text="c.date ? c.date.slice(5) : ''"></text>
                          </template>
                          <!-- Latest values inline -->
                          <text x="5" y="13" font-size="9" fill="#2563eb" x-text="'P&L $' + (bettorWinrate.cumulative.at(-1)?.cum_pnl || 0).toFixed(0)"></text>
                          <text x="5" y="25" font-size="9" fill="#f97316" x-text="'win ' + ((bettorWinrate.cumulative.at(-1)?.cum_hit_rate || 0) * 100).toFixed(1) + '%'"></text>
                        </g>
                      </template>
                    </svg>
                  </div>
                </div>

                <div class="text-[10px] text-ink-400 mt-2">数据源: bettor_outcome_log (v110 Module 1) · API: /api/bettor/hit-rate-timeline?days=30</div>
              </div>
            </template>
          </div>
        </template>

        <!-- Tab content: 持仓保护 (Owner 5/16 钦定 "你们先搞" + Bettor r139 spec — 止损/止盈/时间/redeem auto-protection) -->
        <template x-if="bettorTab === 'protect'">
          <div>
            <template x-if="!bettorProtectRules">
              <div class="card text-center text-ink-400 py-8">载入中...</div>
            </template>
            <template x-if="bettorProtectRules && bettorProtectRules.rules">
              <div class="space-y-4">
                <!-- Pending Owner Ack -->
                <div>
                  <h3 class="text-xs font-bold text-amber-700 mb-2">⏸ Pending Your ACK
                    <span class="text-ink-400 font-normal" x-text="'(' + bettorProtectRules.rules.filter(r => r.status === 'pending_owner_ack').length + ')'"></span>
                  </h3>
                  <template x-for="r in bettorProtectRules.rules.filter(r => r.status === 'pending_owner_ack')" :key="r.id">
                    <div class="card card-compact mb-2 border-l-4 border-l-amber-400">
                      <div class="flex items-start justify-between gap-2">
                        <div class="flex-1">
                          <div class="text-sm font-medium text-ink-700" x-text="r.market_slug + ' ' + r.side"></div>
                          <div class="text-xs text-ink-500 mt-1">
                            entry $<span x-text="r.entry_avg_price?.toFixed(4)"></span> ·
                            size <span x-text="r.current_size?.toFixed(0)"></span> 股 ·
                            止损 <span x-text="(r.stop_loss_pct * 100).toFixed(0) + '%'"></span> after
                            <span x-text="r.cooldown_hours + 'h'"></span> ·
                            止盈 $<span x-text="r.take_profit_price?.toFixed(4)"></span> ·
                            时间 <span x-text="r.time_close_days + 'd'"></span>
                          </div>
                        </div>
                        <div class="flex gap-1 flex-shrink-0">
                          <button @click="ackBettorProtectRule(r)" :disabled="r._acking"
                                  class="px-3 py-1 rounded text-[10px] font-bold bg-amber-500 hover:bg-amber-600 text-white disabled:opacity-50 disabled:cursor-not-allowed">
                            <span x-text="r._acking ? '中...' : '✓ ACK 启用'"></span>
                          </button>
                          <button @click="deleteBettorProtectRule(r)"
                                  class="px-2 py-1 rounded text-[10px] text-red-600 hover:bg-red-50">删</button>
                        </div>
                      </div>
                      <div x-show="r._ackError" class="mt-1 text-[10px] text-red-500" x-text="'ACK 失败: ' + (r._ackError || '')"></div>
                    </div>
                  </template>
                  <template x-if="!bettorProtectRules.rules.filter(r => r.status === 'pending_owner_ack').length">
                    <div class="text-xs text-ink-400 ml-2">无待 ACK 规则</div>
                  </template>
                </div>

                <!-- Active -->
                <div>
                  <h3 class="text-xs font-bold text-green-700 mb-2">✓ Active
                    <span class="text-ink-400 font-normal" x-text="'(' + bettorProtectRules.rules.filter(r => r.status === 'active').length + ')'"></span>
                  </h3>
                  <template x-for="r in bettorProtectRules.rules.filter(r => r.status === 'active')" :key="r.id">
                    <div class="card card-compact mb-2 border-l-4 border-l-green-400">
                      <div class="flex items-start justify-between gap-2">
                        <div class="flex-1">
                          <div class="text-sm font-medium text-ink-700" x-text="r.market_slug + ' ' + r.side"></div>
                          <!-- Phase 2.1a Owner 5/16 + Bettor r149 — P&L 列 (server-side enrich) -->
                          <div class="text-xs mt-1 flex gap-3 flex-wrap">
                            <span class="text-ink-500">entry $<span x-text="r.entry_avg_price?.toFixed(4)"></span></span>
                            <template x-if="r.current_price != null">
                              <span class="text-ink-500">现 $<span x-text="r.current_price?.toFixed(4)"></span></span>
                            </template>
                            <template x-if="r.unrealized_pnl_usd != null">
                              <span class="font-bold" :class="(r.unrealized_pnl_usd || 0) >= 0 ? 'text-green-600' : 'text-red-600'">
                                P&L <span x-text="(r.unrealized_pnl_usd >= 0 ? '+$' : '-$') + Math.abs(r.unrealized_pnl_usd).toFixed(2)"></span>
                                (<span x-text="((r.unrealized_pnl_pct || 0) * 100).toFixed(1) + '%'"></span>)
                              </span>
                            </template>
                            <template x-if="r.captured_pct != null">
                              <span class="text-ink-400 font-mono text-[10px]">
                                captured <span x-text="((r.captured_pct || 0) * 100).toFixed(0) + '%'"></span> /
                                remaining +<span x-text="((r.remaining_pct || 0) * 100).toFixed(0) + '%'"></span>
                              </span>
                            </template>
                          </div>
                          <!-- Phase 2.1a Owner 5/16 — 止盈 dim (📋 reference only, deprecated per Bettor r148) -->
                          <div class="text-xs text-ink-400 mt-1">
                            止损 $<span x-text="((1 + r.stop_loss_pct) * r.entry_avg_price).toFixed(4)"></span> ·
                            <span class="text-ink-300 italic" :title="'📋 reference only, Owner 5/16 钦定 — 待 Phase 3 swap-suggester'">
                              止盈 $<span x-text="r.take_profit_price?.toFixed(4)"></span> (ref)
                            </span> ·
                            时间 <span x-text="r.time_close_days + 'd'"></span> ·
                            ack <span x-text="(r.owner_ack_at || '').slice(5,16).replace('T',' ')"></span>
                          </div>
                        </div>
                        <button @click="deleteBettorProtectRule(r)"
                                class="px-2 py-1 rounded text-[10px] text-red-600 hover:bg-red-50">删</button>
                      </div>
                    </div>
                  </template>
                  <template x-if="!bettorProtectRules.rules.filter(r => r.status === 'active').length">
                    <div class="text-xs text-ink-400 ml-2">无 active 规则</div>
                  </template>
                </div>

                <!-- Triggered History -->
                <div>
                  <h3 class="text-xs font-bold text-ink-600 mb-2">⚡ Triggered History
                    <span class="text-ink-400 font-normal" x-text="'(' + bettorProtectRules.rules.filter(r => r.status?.startsWith('triggered_') || r.status === 'settled').length + ')'"></span>
                  </h3>
                  <template x-for="r in bettorProtectRules.rules.filter(r => r.status?.startsWith('triggered_') || r.status === 'settled')" :key="r.id">
                    <div class="card card-compact mb-2 border-l-4 border-l-ink-300">
                      <div class="text-sm font-medium text-ink-700" x-text="r.market_slug + ' ' + r.side + ' (' + r.status + ')'"></div>
                      <div class="text-xs text-ink-500 mt-1">
                        triggered <span x-text="(r.triggered_at || '').slice(5,16).replace('T',' ')"></span> ·
                        realized <span :class="r.trigger_realized_pnl > 0 ? 'text-green-600' : 'text-red-600'" x-text="(r.trigger_realized_pnl > 0 ? '+$' : '-$') + Math.abs(r.trigger_realized_pnl || 0).toFixed(2)"></span> ·
                        TX <span class="font-mono" x-text="r.trigger_action_tx_hash?.slice(0,12) + '...'"></span>
                      </div>
                    </div>
                  </template>
                  <template x-if="!bettorProtectRules.rules.filter(r => r.status?.startsWith('triggered_') || r.status === 'settled').length">
                    <div class="text-xs text-ink-400 ml-2">无 trigger 历史</div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </template>

        <!-- Tab content: 推荐历史 (Owner 5/15 严训 + Bettor r132 spec — flat table all recs) -->
        <template x-if="bettorTab === 'history-recs'">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="text-sm text-ink-500">
                <template x-if="bettorHistoryRecs && bettorHistoryRecs.recommendations">
                  <span x-text="'共 ' + bettorHistoryRecs.recommendations.length + ' 条推荐 (近 ' + (bettorHistoryRecs.days || 30) + ' 天)'"></span>
                </template>
                <template x-if="!bettorHistoryRecs">
                  <span class="text-ink-300">加载中...</span>
                </template>
              </div>
              <div class="flex gap-2 text-xs">
                <button @click="bettorHistoryFilter = 'all'; "
                        :class="bettorHistoryFilter === 'all' ? 'bg-brand-100 text-brand-700' : 'bg-ink-50 text-ink-500'"
                        class="px-2 py-1 rounded">全部</button>
                <button @click="bettorHistoryFilter = 'BUY_YES'"
                        :class="bettorHistoryFilter === 'BUY_YES' ? 'bg-green-100 text-green-700' : 'bg-ink-50 text-ink-500'"
                        class="px-2 py-1 rounded">BUY_YES</button>
                <button @click="bettorHistoryFilter = 'BUY_NO'"
                        :class="bettorHistoryFilter === 'BUY_NO' ? 'bg-red-100 text-red-700' : 'bg-ink-50 text-ink-500'"
                        class="px-2 py-1 rounded">BUY_NO</button>
                <button @click="bettorHistoryFilter = 'resolved'"
                        :class="bettorHistoryFilter === 'resolved' ? 'bg-brand-100 text-brand-700' : 'bg-ink-50 text-ink-500'"
                        class="px-2 py-1 rounded">已结算</button>
              </div>
            </div>
            <template x-if="bettorHistoryRecs && bettorHistoryRecs.recommendations && bettorHistoryRecs.recommendations.length">
              <div class="overflow-x-auto">
                <table class="w-full text-xs">
                  <thead class="bg-ink-50 text-ink-500">
                    <tr>
                      <th class="px-2 py-1 text-left">扫描时间</th>
                      <th class="px-2 py-1 text-left">问题</th>
                      <th class="px-2 py-1">决策</th>
                      <th class="px-2 py-1">yes 价</th>
                      <th class="px-2 py-1">fund</th>
                      <th class="px-2 py-1">size</th>
                      <th class="px-2 py-1">状态</th>
                      <th class="px-2 py-1">结果</th>
                      <th class="px-2 py-1">P&L</th>
                    </tr>
                  </thead>
                  <tbody>
                    <template x-for="r in bettorHistoryRecs.recommendations.filter(x => bettorHistoryFilter === 'all' || (bettorHistoryFilter === 'resolved' ? x.outcome !== null : x.decision === bettorHistoryFilter))" :key="r.id">
                      <tr class="border-b border-ink-100 hover:bg-ink-50">
                        <td class="px-2 py-1 text-ink-500 whitespace-nowrap" x-text="(r.scanned_at || '').slice(5,16).replace('T',' ')"></td>
                        <td class="px-2 py-1 text-ink-700 truncate max-w-xs" :title="r.question" x-text="r.question"></td>
                        <td class="px-2 py-1 text-center" :class="r.decision === 'BUY_YES' ? 'text-green-600' : r.decision === 'BUY_NO' ? 'text-red-600' : 'text-ink-400'" x-text="r.decision"></td>
                        <td class="px-2 py-1 text-center text-ink-600" x-text="r.yes_price != null ? (r.yes_price * 100).toFixed(1) + '%' : '-'"></td>
                        <td class="px-2 py-1 text-center text-ink-500" :title="r.fund_source || ''" x-text="r.fund_estimate != null ? (r.fund_estimate * 100).toFixed(0) + '%' : '-'"></td>
                        <td class="px-2 py-1 text-center text-ink-600" x-text="r.size_usd != null ? '$' + r.size_usd.toFixed(0) : '-'"></td>
                        <td class="px-2 py-1 text-center" :class="r.status === 'open' ? 'text-brand-600' : r.status === 'resolved' ? 'text-ink-500' : 'text-ink-400'" x-text="r.status"></td>
                        <td class="px-2 py-1 text-center" :class="r.was_correct === 1 ? 'text-green-600' : r.was_correct === 0 ? 'text-red-600' : 'text-ink-300'" x-text="r.was_correct === 1 ? '✓' : r.was_correct === 0 ? '✗' : (r.outcome === null ? 'pending' : '-')"></td>
                        <td class="px-2 py-1 text-center" :class="r.actual_pnl_usd > 0 ? 'text-green-600' : r.actual_pnl_usd < 0 ? 'text-red-600' : 'text-ink-400'" x-text="r.actual_pnl_usd != null ? (r.actual_pnl_usd > 0 ? '+$' : '-$') + Math.abs(r.actual_pnl_usd).toFixed(2) : '-'"></td>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </div>
            </template>
            <template x-if="bettorHistoryRecs && bettorHistoryRecs.recommendations && !bettorHistoryRecs.recommendations.length">
              <div class="card text-center text-ink-400 py-8">
                <div class="text-sm">暂无推荐历史</div>
                <div class="text-xs mt-2">扫描启动后 recs 自动 populate</div>
              </div>
            </template>
          </div>
        </template>

        <!-- Tab content: 战绩 -->
        <template x-if="bettorTab === 'record'">
          <div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
              <div class="card card-compact text-center">
                <div class="text-[10px] text-ink-400">已结算</div>
                <div class="text-xl font-bold text-ink-700" x-text="((bettorRecord && bettorRecord.stats && bettorRecord.stats.resolved) || 0)"></div>
              </div>
              <div class="card card-compact text-center">
                <div class="text-[10px] text-ink-400">胜率</div>
                <div class="text-xl font-bold text-brand-600" x-text="((bettorRecord && bettorRecord.stats && bettorRecord.stats.hit_rate !== null && bettorRecord.stats.hit_rate !== undefined) ? ((bettorRecord.stats.hit_rate * 100).toFixed(1) + '%') : '—')"></div>
              </div>
              <div class="card card-compact text-center">
                <div class="text-[10px] text-ink-400">实战胜率 (排除 SKIP)</div>
                <div class="text-xl font-bold text-brand-600" x-text="((bettorRecord && bettorRecord.stats && bettorRecord.stats.actionable_hit_rate !== null && bettorRecord.stats.actionable_hit_rate !== undefined) ? ((bettorRecord.stats.actionable_hit_rate * 100).toFixed(1) + '%') : '—')"></div>
              </div>
              <div class="card card-compact text-center">
                <div class="text-[10px] text-ink-400">假想 PnL ($1000 bankroll)</div>
                <div class="text-xl font-bold" :class="((bettorRecord && bettorRecord.stats && bettorRecord.stats.total_pnl_hypothetical) || 0) >= 0 ? 'text-green-600' : 'text-red-500'" x-text="((bettorRecord && bettorRecord.stats && bettorRecord.stats.total_pnl_hypothetical !== null && bettorRecord.stats.total_pnl_hypothetical !== undefined) ? ('$' + bettorRecord.stats.total_pnl_hypothetical.toFixed(2)) : '$0.00')"></div>
              </div>
            </div>
            <div class="text-xs text-ink-500 mb-3">
              <span>平均 Brier: <span class="font-medium" x-text="((bettorRecord && bettorRecord.stats && bettorRecord.stats.mean_brier !== null && bettorRecord.stats.mean_brier !== undefined) ? bettorRecord.stats.mean_brier.toFixed(3) : '—')"></span></span>
              <span class="ml-3">待结算: <span class="font-medium" x-text="(bettorRecord && bettorRecord.stats && bettorRecord.stats.pending) || '0'"></span></span>
              <span class="ml-3">不可结算: <span class="font-medium" x-text="(bettorRecord && bettorRecord.stats && bettorRecord.stats.unresolvable) || '0'"></span></span>
            </div>
            <div class="text-sm font-medium text-ink-700 mb-2">最近 20 笔已结算</div>
            <template x-if="bettorRecord && (bettorRecord.recent || []).length">
              <div class="space-y-2">
                <template x-for="r in bettorRecord.recent" :key="r.id">
                  <div class="card card-compact" :class="r.was_correct ? 'border-l-4 border-l-green-500' : 'border-l-4 border-l-red-500'">
                    <div class="flex items-start gap-2 mb-1">
                      <a :href="'https://polymarket.com/event/' + (r.slug || r.condition_id || '')" target="_blank" rel="noopener"
                         class="flex-1 text-sm font-medium text-ink-700 hover:text-brand-600" x-text="r.question"></a>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold whitespace-nowrap"
                            :class="r.was_correct ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600'"
                            x-text="r.was_correct ? '✓ HIT' : '✗ MISS'"></span>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-[11px] text-ink-500">
                      <div>预测 <span class="font-medium text-ink-700" x-text="r.decision"></span></div>
                      <div>结果 <span class="font-medium text-ink-700" x-text="r.outcome"></span></div>
                      <div>PnL <span class="font-medium" :class="(r.pnl_hypothetical || 0) >= 0 ? 'text-green-600' : 'text-red-500'" x-text="'$' + (r.pnl_hypothetical || 0).toFixed(2)"></span></div>
                      <div>Brier <span class="font-medium text-ink-700" x-text="(r.brier !== null && r.brier !== undefined) ? r.brier.toFixed(3) : '—'"></span></div>
                    </div>
                    <div class="text-[10px] text-ink-400 mt-1">pMid <span x-text="((r.p_mid || 0) * 100).toFixed(1) + '%'"></span> · 押 <span x-text="'$' + (r.size_usd || 0).toFixed(0)"></span> · 结算于 <span x-text="r.outcome_resolved_at ? new Date(r.outcome_resolved_at).toLocaleString() : '?'"></span></div>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="bettorRecord && !(bettorRecord.recent || []).length">
              <div class="text-center py-8 text-sm text-ink-400">
                <div>暂无已结算推荐</div>
                <div class="text-[11px] mt-1">推荐市场到期后, 1h cron 自动拉 Polymarket 真实 outcome 并算战绩</div>
              </div>
            </template>
            <template x-if="!bettorRecord">
              <div class="text-center py-8 text-sm text-ink-400">载入中...</div>
            </template>
          </div>
        </template>

        <!-- Tab content: 阈值 Watcher (Owner 5/17 钦定 mode 1+2 + UI 可设置 — alert only, ACK 才 fire) -->
        <template x-if="bettorTab === 'watcher'">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="text-xs text-ink-500">
                30 min cron 守阈值; 触发 → broadcast dev-coord; Owner ACK 才 fire (R-DAEMON-DRY-RUN)
              </div>
              <div class="flex items-center gap-2">
                <button @click="watcherTickNow()" :disabled="watcherTicking" class="btn btn-sm btn-secondary text-[11px]">
                  <span x-text="watcherTicking ? '查中...' : '立即 tick'"></span>
                </button>
                <button @click="watchAdd.show = true" class="btn btn-sm btn-primary text-[11px]">+ 新建 rule</button>
              </div>
            </div>

            <!-- Add form (collapsed by default) -->
            <template x-if="watchAdd && watchAdd.show">
              <div class="card mb-3 border-l-4 border-l-amber-400">
                <h3 class="text-sm font-bold mb-2">新建 watcher rule</h3>
                <div class="space-y-2 text-[11px]">
                  <div class="grid grid-cols-2 gap-2">
                    <div>
                      <label class="block text-ink-500 mb-1">Relay (agent)</label>
                      <select x-model="watchAdd.relay_node_id" class="input input-xs w-full">
                        <option value="">— 选 agent —</option>
                        <% it.relayNodes.forEach(r => { %>
                        <option value="<%= r.id %>"><%= r.name %> (<%= r.id.slice(0,8) %>)</option>
                        <% }) %>
                      </select>
                    </div>
                    <div>
                      <label class="block text-ink-500 mb-1">Outcome</label>
                      <select x-model="watchAdd.outcome" class="input input-xs w-full">
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                      </select>
                    </div>
                  </div>
                  <div>
                    <label class="block text-ink-500 mb-1">Token ID (Polymarket CLOB)</label>
                    <input type="text" x-model="watchAdd.token_id" class="input input-xs w-full" placeholder="59804740893116830082655722678282357324530422193334657680222344987920273408829">
                  </div>
                  <div>
                    <label class="block text-ink-500 mb-1">Market title (人读)</label>
                    <input type="text" x-model="watchAdd.market_title" class="input input-xs w-full" placeholder="Starmer out by May 31, 2026?">
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <div>
                      <label class="block text-ink-500 mb-1">Current size (sh)</label>
                      <input type="number" step="any" x-model.number="watchAdd.current_size" class="input input-xs w-full">
                    </div>
                    <div>
                      <label class="block text-ink-500 mb-1">Entry avg price</label>
                      <input type="number" step="0.001" x-model.number="watchAdd.entry_avg_price" class="input input-xs w-full">
                    </div>
                  </div>
                  <div class="border-t pt-2 mt-2">
                    <div class="flex items-center justify-between mb-1">
                      <label class="block text-ink-500">阈值 (按触发顺序排, 任意条数)</label>
                      <button @click="watchAdd.thresholds.push({label:'',op:'gte',price:0.5,sell_pct:30,action:''})" class="btn btn-xs btn-ghost text-[10px]">+ 加一行</button>
                    </div>
                    <template x-for="(t, idx) in watchAdd.thresholds" :key="idx">
                      <div class="grid grid-cols-12 gap-1 mb-1 items-center">
                        <input type="text" x-model="t.label" class="input input-xs col-span-3" placeholder="strong_yes">
                        <select x-model="t.op" class="input input-xs col-span-2">
                          <option value="gte">价 ≥</option>
                          <option value="lte">价 ≤</option>
                        </select>
                        <input type="number" step="0.001" x-model.number="t.price" class="input input-xs col-span-2">
                        <input type="number" step="1" x-model.number="t.sell_pct" class="input input-xs col-span-2" placeholder="sell%">
                        <input type="text" x-model="t.action" class="input input-xs col-span-2" placeholder="action note">
                        <button @click="watchAdd.thresholds.splice(idx, 1)" class="text-red-500 text-xs col-span-1">✗</button>
                      </div>
                    </template>
                  </div>
                  <div class="flex gap-2 pt-2">
                    <button @click="watchSubmit()" :disabled="watchSubmitting" class="btn btn-sm btn-primary text-[11px]">
                      <span x-text="watchSubmitting ? '保存中...' : '✓ 保存'"></span>
                    </button>
                    <button @click="watchAdd.show = false" class="btn btn-sm btn-ghost text-[11px]">取消</button>
                  </div>
                </div>
              </div>
            </template>

            <!-- Rules list -->
            <template x-if="!watchRules">
              <div class="card text-center text-ink-400 py-8">载入中...</div>
            </template>
            <template x-if="watchRules && watchRules.length === 0">
              <div class="card text-center text-ink-400 py-8">
                <div>暂无 watcher rule</div>
                <div class="text-[11px] mt-1">点 + 新建 rule 设阈值守某持仓</div>
              </div>
            </template>
            <template x-if="watchRules && watchRules.length > 0">
              <div class="space-y-2">
                <template x-for="r in watchRules" :key="r.id">
                  <div class="card card-compact" :class="r.last_alert_label ? 'border-l-4 border-l-red-500' : (r.status === 'active' ? 'border-l-4 border-l-amber-400' : 'opacity-60')">
                    <div class="flex items-start justify-between gap-2 mb-1">
                      <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-ink-700 truncate" x-text="r.market_title"></div>
                        <div class="text-[11px] text-ink-500">
                          <span x-text="r.outcome"></span> ·
                          <span x-text="r.current_size + ' sh'"></span> ·
                          entry $<span x-text="r.entry_avg_price.toFixed(3)"></span> ·
                          last $<span x-text="(r.last_check_price ?? 0).toFixed(3)"></span>
                          <span x-show="r.last_check_at" class="ml-1 text-ink-400">@<span x-text="new Date(r.last_check_at).toLocaleTimeString()"></span></span>
                        </div>
                      </div>
                      <div class="flex items-center gap-1">
                        <span class="text-[10px] px-1.5 py-0.5 rounded" :class="r.status === 'active' ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-500'" x-text="r.status"></span>
                        <button @click="watchToggleStatus(r)" class="btn btn-xs btn-ghost text-[10px]" x-text="r.status === 'active' ? '暂停' : '激活'"></button>
                        <button @click="watchDelete(r.id)" class="btn btn-xs btn-ghost text-red-500 text-[10px]">✗</button>
                      </div>
                    </div>
                    <div class="grid gap-1 text-[10px] mt-1" :style="'grid-template-columns:repeat(' + Math.min(r.thresholds.length, 4) + ',1fr)'">
                      <template x-for="t in r.thresholds" :key="t.label">
                        <div class="bg-warm-50 px-2 py-1 rounded" :class="r.last_alert_label === t.label ? 'ring-2 ring-red-400' : ''">
                          <div class="font-medium text-ink-700" x-text="t.label"></div>
                          <div class="text-ink-500">
                            <span x-text="t.op === 'gte' ? '≥' : '≤'"></span> $<span x-text="t.price.toFixed(3)"></span>
                            <span x-show="t.sell_pct"> → sell <span x-text="t.sell_pct"></span>%</span>
                          </div>
                        </div>
                      </template>
                    </div>
                    <div x-show="r.last_alert_label" class="mt-1 text-[10px] text-red-600">
                      🚨 last alert: <span x-text="r.last_alert_label"></span> @ <span x-text="r.last_alert_at ? new Date(r.last_alert_at).toLocaleString() : '-'"></span>
                    </div>
                  </div>
                </template>
              </div>
            </template>
          </div>
        </template>

        <!-- Phase 2.3 Owner 5/17 + Bettor r161-r162 — strategy filter chips -->
        <template x-if="bettorTab === 'recs' && bettorRecs && (bettorRecs.recommendations || []).length">
          <div>
            <div class="flex gap-2 mb-3 text-[10px] flex-wrap">
              <button @click="bettorStrategyFilter = 'all'" :class="bettorStrategyFilter === 'all' ? 'bg-brand-100 text-brand-700 font-bold' : 'bg-ink-50 text-ink-500'" class="px-2 py-1 rounded">全部</button>
              <button @click="bettorStrategyFilter = 'scavenger_main'" :class="bettorStrategyFilter === 'scavenger_main' ? 'bg-brand-100 text-brand-700 font-bold' : 'bg-ink-50 text-ink-500'" class="px-2 py-1 rounded">稳单</button>
              <button @click="bettorStrategyFilter = 'scavenger_carrion'" :class="bettorStrategyFilter === 'scavenger_carrion' ? 'bg-red-100 text-red-700 font-bold' : 'bg-ink-50 text-ink-500'" class="px-2 py-1 rounded">捡尸</button>
              <button @click="bettorStrategyFilter = 'scavenger_topN_rank'" :class="bettorStrategyFilter === 'scavenger_topN_rank' ? 'bg-amber-100 text-amber-700 font-bold' : 'bg-ink-50 text-ink-500'" class="px-2 py-1 rounded">top-N</button>
              <button @click="bettorStrategyFilter = 'scavenger_election_locked'" :class="bettorStrategyFilter === 'scavenger_election_locked' ? 'bg-green-100 text-green-700 font-bold' : 'bg-ink-50 text-ink-500'" class="px-2 py-1 rounded">election locked</button>
              <button @click="bettorStrategyFilter = 'scavenger_competitive'" :class="bettorStrategyFilter === 'scavenger_competitive' ? 'bg-orange-100 text-orange-700 font-bold' : 'bg-ink-50 text-ink-500'" class="px-2 py-1 rounded">竞技</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <template x-for="r in (bettorRecs.recommendations || []).filter(x => bettorStrategyFilter === 'all' || (x.strategy || classifyStrategyClient(x)) === bettorStrategyFilter)" :key="r.id">
              <div class="card card-compact"
                   :class="r.decision === 'YES' ? 'border-l-4 border-l-green-500' : r.decision === 'NO' ? 'border-l-4 border-l-red-500' : 'border-l-4 border-l-gray-400'">
                <div class="flex items-start gap-2 mb-2">
                  <a :href="'https://polymarket.com/event/' + (r.slug || r.condition_id || '')"
                     target="_blank" rel="noopener"
                     class="flex-1 text-sm font-medium text-ink-700 hover:text-brand-600"
                     x-text="r.question"></a>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold whitespace-nowrap"
                        :class="r.decision === 'YES' ? 'bg-green-100 text-green-700' : r.decision === 'NO' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600'"
                        x-text="r.decision === 'SKIP' ? 'SKIP' : 'BUY ' + r.decision"></span>
                </div>
                <div class="grid grid-cols-4 gap-2 text-[11px]">
                  <div>
                    <div class="text-ink-400">yes 价</div>
                    <div class="font-bold text-ink-700" x-text="(r.yes_price * 100).toFixed(2) + '%'"></div>
                  </div>
                  <div>
                    <div class="text-ink-400" x-text="r.llm_tier === 'scavenger' ? '锁利' : 'edge'"></div>
                    <div class="font-bold text-ink-700" x-text="(r.edge * 100).toFixed(1) + 'pp'"></div>
                  </div>
                  <div>
                    <div class="text-ink-400">仓位</div>
                    <div class="font-bold text-ink-700" x-text="(r.fraction * 100).toFixed(1) + '%'"></div>
                  </div>
                  <div>
                    <div class="text-ink-400">$ size</div>
                    <div class="font-bold text-ink-700" x-text="'$' + r.size_usd.toFixed(0)"></div>
                  </div>
                </div>
                <div class="flex items-center justify-between mt-2 text-[10px] text-ink-400">
                  <span x-text="r.llm_tier === 'scavenger' ? ('p(NO)=' + (r.p_mid * 100).toFixed(1) + '% tail=' + (r.sigma * 100).toFixed(1) + '%') : (r.llm_tier === 'scavenger+enricher' ? ('p(NO)=' + (r.p_mid * 100).toFixed(1) + '% tail=' + (r.sigma * 100).toFixed(1) + '%') : ('pMid=' + (r.p_mid * 100).toFixed(1) + '% σ=' + (r.sigma * 100).toFixed(1) + '% gap=' + (r.info_gap_months || 0).toFixed(1) + 'mo'))"></span>
                  <span x-show="r.end_date" x-text="'到期 ' + new Date(r.end_date).toLocaleDateString()"></span>
                </div>
                <!-- Phase B Sub B4.1 + Phase B5.1 r159 (c)(d): fundamental enricher display + warning banner + raw reasoning -->
                <template x-if="(r.llm_tier === 'scavenger+enricher' || r.reasoning?.enriched_type === 'fundamental_b5') && r.fundamental_estimate != null">
                  <div class="mt-2 px-2 py-1 rounded border text-[10px]" :class="r.reasoning?.fundamental_warning ? 'bg-red-50 border-red-300' : 'bg-amber-50 border-amber-200'">
                    <div class="flex items-center justify-between">
                      <span class="font-semibold" :class="r.reasoning?.fundamental_warning ? 'text-red-700' : 'text-amber-700'">
                        📊 Fundamental enricher
                        <span x-show="r.reasoning?.fundamental_warning" class="text-red-600 font-bold ml-1" x-text="r.reasoning?.fundamental_warning === 'suspicious_high_confidence_gap' ? '⚠ 可能 LLM 错位 (gap > 30pp + conf > 70%)' : ''"></span>
                      </span>
                      <span :class="r.reasoning?.fundamental_warning ? 'text-red-600' : 'text-amber-600'">conf <span x-text="(r.fundamental_confidence * 100).toFixed(0) + '%'"></span></span>
                    </div>
                    <div class="mt-0.5" :class="r.reasoning?.fundamental_warning ? 'text-red-700' : 'text-amber-700'">
                      market <span x-text="(r.yes_price * 100).toFixed(1) + '%'"></span> vs fund
                      <span class="font-bold" x-text="(r.fundamental_estimate * 100).toFixed(1) + '%'"></span>
                      · gap
                      <span class="font-bold" x-text="(Math.abs(r.fundamental_estimate - r.yes_price) * 100).toFixed(1) + 'pp'"></span>
                    </div>
                    <template x-if="r.fundamental_sources">
                      <div class="text-amber-500 mt-0.5 truncate" :title="JSON.parse(r.fundamental_sources || '[]').join('\n')">
                        sources: <span x-text="JSON.parse(r.fundamental_sources || '[]').length + ' refs'"></span>
                      </div>
                    </template>
                    <!-- Phase B5.1 r159 (d) — LLM reasoning 全文 force-open on warning, collapsed default -->
                    <template x-if="r.reasoning?.fundamental_raw_reasoning">
                      <details :open="!!r.reasoning?.fundamental_warning" class="mt-1">
                        <summary class="text-[10px] text-ink-500 cursor-pointer hover:text-ink-700">▶ LLM reasoning 全文 (展开查 LLM 是否错位)</summary>
                        <div class="mt-1 p-1 bg-white rounded text-[10px] text-ink-600 font-mono whitespace-pre-wrap" x-text="r.reasoning?.fundamental_raw_reasoning"></div>
                      </details>
                    </template>
                  </div>
                </template>
                <!-- Bug U1 fix: Alpine <template x-if> 嵌套 <template x-for> reactivity 不稳 -
                     用 x-show + always-render-in-DOM 替换 conditional render.
                     Sediment KI-Phase-B-UI-1 (Bettor r122 emergency surface, J1 clean re-ship).
                     Pre-fix: 嵌套 x-if 在 x-for 内 inner condition 依赖 iteration item field (r.status/decision)
                     reactive update 漏 → button 不渲染. Recurring pattern: 5+ historical similar fixes
                     (commit 7c08aa809 Sophie close button + 5b66ef730 Redeem button + ab114db7d Bettor 越界 ship). -->
                <div class="flex gap-2 mt-2">
                  <button @click="bettorDetail = r" class="flex-1 text-[10px] text-brand-500 hover:text-brand-700 text-left">查看推理 →</button>
                  <button x-show="r.status === 'pending' && (r.decision === 'YES' || r.decision === 'NO')"
                          @click="acceptBettorRec(r)" :disabled="r._accepting"
                          class="px-3 py-1 rounded text-[10px] font-bold text-white disabled:opacity-50 disabled:cursor-not-allowed"
                          :class="r.decision === 'YES' ? 'bg-green-600 hover:bg-green-700' : 'bg-red-600 hover:bg-red-700'">
                    <span x-text="r._accepting ? '下单中...' : '✓ ACCEPT 下单'"></span>
                  </button>
                  <span x-show="r.status === 'accepted'" class="px-3 py-1 rounded text-[10px] font-bold bg-gray-200 text-gray-600">已下单</span>
                  <span x-show="r.decision === 'SKIP'" class="px-3 py-1 rounded text-[10px] font-bold bg-gray-200 text-gray-500">SKIP (不下)</span>
                </div>
                <div x-show="r._acceptError" class="mt-1 text-[10px] text-red-500" x-text="'下单失败: ' + (r._acceptError || '')"></div>
                <div x-show="r._acceptSuccess" class="mt-1 text-[10px] text-green-600" x-text="'✓ 下单成功 ' + (r._acceptSuccess || '')"></div>
                <!-- Owner 5/16 钦定 "B" + Bettor r141 spec: 3-tier variant expander (激进/适中/保守) -->
                <!-- Phase 2 r146 — same_entity 3 档 responsive grid + cross_entity_same_event 独立 section -->
                <template x-if="bettorVariants && bettorVariants[r.id] && bettorVariants[r.id].length">
                  <div class="mt-3 pt-2 border-t border-ink-100">
                    <!-- Same-entity 3-tier section -->
                    <template x-if="(bettorVariants[r.id] || []).filter(v => v.strategy_tier !== 'cross_entity').length">
                      <div>
                        <div class="text-[10px] text-ink-500 mb-1 font-semibold">📊 变种 (同 insight 不同力度):</div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                          <template x-for="v in (bettorVariants[r.id] || []).filter(x => x.strategy_tier !== 'cross_entity').sort((a,b) => ({aggressive:0,medium:1,conservative:2}[a.strategy_tier] || 9) - ({aggressive:0,medium:1,conservative:2}[b.strategy_tier] || 9))" :key="v.id">
                            <div class="card card-compact text-[10px]" :class="v.strategy_tier === 'aggressive' ? 'border-l-4 border-l-red-400' : v.strategy_tier === 'medium' ? 'border-l-4 border-l-amber-400' : 'border-l-4 border-l-green-400'">
                              <div class="flex items-center justify-between mb-1">
                                <span class="font-bold" :class="v.strategy_tier === 'aggressive' ? 'text-red-600' : v.strategy_tier === 'medium' ? 'text-amber-600' : 'text-green-600'" x-text="v.strategy_tier === 'aggressive' ? '🔴 激进' : v.strategy_tier === 'medium' ? '🟡 适中' : '🟢 保守'"></span>
                                <span class="text-ink-500" x-text="v.side"></span>
                              </div>
                              <div class="text-ink-700 truncate" :title="v.market_slug" x-text="v.market_slug?.replace(/^will-/, '').replace(/-/g, ' ').slice(0, 50)"></div>
                              <div class="flex gap-2 mt-1 text-ink-500">
                                <span x-text="'$' + (v.current_price || 0).toFixed(3)"></span>
                                <span x-text="((v.hit_rate || 0) * 100).toFixed(0) + '% hit'"></span>
                                <span class="text-green-600" x-text="'+' + ((v.payout_pct || 0) * 100).toFixed(0) + '%'"></span>
                                <span :class="(v.ev_per_dollar || 0) > 0 ? 'text-green-700' : 'text-red-600'" :title="'EV per $1'" x-text="'EV ' + ((v.ev_per_dollar || 0) >= 0 ? '+' : '') + ((v.ev_per_dollar || 0) * 100).toFixed(1) + '%'"></span>
                              </div>
                              <div class="flex items-center justify-between mt-1">
                                <span class="text-ink-400 text-[9px]" :class="v._price_stale ? 'text-amber-600' : ''" x-text="v._price_stale ? '⚠ 价格 ≥30s 未更新' : (v._price_refreshed ? '✓ 价格已刷新' : '')"></span>
                                <button @click="acceptBettorVariant(v)" :disabled="v._accepting || v.status !== 'pending'" class="px-2 py-0.5 rounded text-[9px] font-bold text-white disabled:opacity-50 disabled:cursor-not-allowed" :class="v.strategy_tier === 'aggressive' ? 'bg-red-500 hover:bg-red-600' : v.strategy_tier === 'medium' ? 'bg-amber-500 hover:bg-amber-600' : 'bg-green-500 hover:bg-green-600'">
                                  <span x-text="v._accepting ? '...' : v.status === 'superseded' ? '⏸ superseded' : v.status === 'accepted' ? '✓ accepted' : '✓ ACCEPT'"></span>
                                </button>
                              </div>
                            </div>
                          </template>
                        </div>
                      </div>
                    </template>

                    <!-- Cross-entity same_event independent section (Bettor r143 §4 insight-boundary) -->
                    <template x-if="(bettorVariants[r.id] || []).filter(v => v.strategy_tier === 'cross_entity').length">
                      <div class="mt-2">
                        <div class="text-[10px] text-ink-500 mb-1 font-semibold">🎯 同事件可关注 (独立 strong recs):</div>
                        <template x-for="v in (bettorVariants[r.id] || []).filter(x => x.strategy_tier === 'cross_entity')" :key="v.id">
                          <div class="flex items-center justify-between gap-2 text-[10px] py-0.5 px-2 bg-warm-50 rounded">
                            <span class="flex-1 truncate text-ink-700" :title="v.market_slug" x-text="v.market_slug?.replace(/^will-/, '').replace(/-/g, ' ').slice(0, 60)"></span>
                            <span class="text-ink-500 w-10 text-right" x-text="v.side"></span>
                            <span class="text-ink-700 font-mono w-12 text-right" x-text="'$' + (v.current_price || 0).toFixed(2)"></span>
                            <span class="text-ink-500 w-10 text-right" x-text="((v.hit_rate || 0) * 100).toFixed(0) + '%'"></span>
                            <span class="font-mono w-14 text-right" :class="(v.ev_per_dollar || 0) > 0 ? 'text-green-700' : 'text-red-600'" x-text="'EV ' + ((v.ev_per_dollar || 0) >= 0 ? '+' : '') + ((v.ev_per_dollar || 0) * 100).toFixed(1) + '%'"></span>
                            <button @click="acceptBettorVariant(v)" :disabled="v._accepting || v.status !== 'pending'" class="px-2 py-0.5 rounded text-[9px] font-bold bg-brand-500 hover:bg-brand-600 text-white disabled:opacity-50 disabled:cursor-not-allowed">
                              <span x-text="v._accepting ? '...' : v.status === 'superseded' ? '⏸' : v.status === 'accepted' ? '✓' : 'ACCEPT'"></span>
                            </button>
                          </div>
                        </template>
                      </div>
                    </template>
                  </div>
                </template>
                <!-- Explicit empty state (Bettor r143 §1 + Phase 2 r146 §2) -->
                <template x-if="bettorVariants && bettorVariants[r.id] !== undefined && bettorVariants[r.id].length === 0">
                  <div class="mt-2 text-[10px] text-ink-300 italic">无相关市场 variant (entity 未匹配 gamma active markets)</div>
                </template>
              </div>
            </template>
            </div>
          </div>
        </template>

        <template x-if="bettorTab === 'recs' && bettorRecs && !(bettorRecs.recommendations || []).length">
          <div class="text-center py-12 text-sm text-ink-400">
            <span x-show="!bettorRecs.scanned_at">尚未扫描 — 点击"立即重扫"</span>
            <span x-show="bettorRecs.scanned_at">本批次无推荐符合条件 (edge&lt;5pt 或 gap&gt;3 月)</span>
          </div>
        </template>

        <template x-if="bettorTab === 'recs' && !bettorRecs">
          <div class="text-center py-12 text-sm text-ink-400">载入中...</div>
        </template>
      </div>
    </div>
  </template>

  <!-- Bettor 详情弹窗 -->
  <template x-if="bettorDetail">
    <div class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4" @click="bettorDetail = null">
      <div class="card max-w-xl w-full max-h-[80vh] overflow-y-auto" @click.stop>
        <div class="flex items-start justify-between mb-3">
          <div class="text-sm font-medium" x-text="bettorDetail.question"></div>
          <button @click="bettorDetail = null" class="text-ink-400 hover:text-ink-700">✕</button>
        </div>
        <div class="text-xs text-ink-500 space-y-2">
          <div><strong>决策:</strong> <span x-text="bettorDetail.decision === 'SKIP' ? 'SKIP' : 'BUY ' + bettorDetail.decision"></span></div>
          <div><strong>市场报价:</strong> YES @ <span x-text="(bettorDetail.yes_price * 100).toFixed(1) + '%'"></span></div>
          <div><strong>我估:</strong> pMid <span x-text="(bettorDetail.p_mid * 100).toFixed(1) + '%'"></span> σ <span x-text="(bettorDetail.sigma * 100).toFixed(1) + '%'"></span></div>
          <div><strong>edge:</strong> <span x-text="(bettorDetail.edge * 100).toFixed(2) + ' pp'"></span></div>
          <div><strong>仓位:</strong> <span x-text="(bettorDetail.fraction * 100).toFixed(2) + '% (= $' + bettorDetail.size_usd.toFixed(2) + ' on $1000 bankroll)'"></span></div>
          <div><strong>info gap:</strong> <span x-text="bettorDetail.info_gap_months.toFixed(1) + ' 月'"></span></div>
          <div><strong>vol24h:</strong> <span x-text="'$' + (bettorDetail.volume_24h || 0).toLocaleString()"></span></div>
          <div><strong>到期:</strong> <span x-text="bettorDetail.end_date ? new Date(bettorDetail.end_date).toLocaleString() : '?'"></span></div>
          <div><strong>LLM tier:</strong> <span x-text="bettorDetail.llm_tier"></span></div>
          <div><strong>触发:</strong> <span x-text="bettorDetail.trigger_type"></span></div>
          <div class="border-t border-warm-200 pt-2 mt-2">
            <div class="font-medium mb-1">LLM 估值理由:</div>
            <div class="text-ink-600 italic" x-text="(bettorDetail.reasoning && bettorDetail.reasoning.reasoning) || '(无)'"></div>
          </div>
          <div>
            <div class="font-medium mb-1">Kelly 推理 trace:</div>
            <ul class="text-ink-600 list-disc list-inside text-[11px]">
              <template x-for="(line, i) in (bettorDetail.reasoning && bettorDetail.reasoning.trace) || []" :key="i">
                <li x-text="line"></li>
              </template>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- 新手引导 -->
  <template x-if="showGuide">
    <div class="card card-flush overflow-hidden mb-5 border-brand-200">
      <div class="px-5 py-4 bg-brand-50 border-b border-brand-100">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-brand-700">预测市场是什么？</span>
          <button @click="showGuide = false; localStorage.setItem('prediction_guide_seen','1')" class="text-xs text-brand-400 hover:text-brand-600">知道了，不再显示</button>
        </div>
      </div>
      <div class="px-5 py-4 space-y-3 text-sm text-ink-600 leading-relaxed">
        <p><strong>预测市场 = 用真金白银投票的民意调查。</strong></p>
        <p>每个市场是一个问题，比如"美国会进入衰退吗？"。参与者用 USDC 押注 Yes 或 No。</p>
        <div class="bg-warm-50 rounded-lg p-3 text-xs space-y-1">
          <p><strong>怎么参与？</strong></p>
          <p>1. 创建 Polygon 钱包（Agent 页 → 钱包）</p>
          <p>2. 充值 USDC 到 Polygon 钱包地址</p>
          <p>3. 点上方"授权 USDC"+ "设置 API Key"</p>
          <p>4. 在下方市场卡片点"交易"下单</p>
        </div>
      </div>
    </div>
  </template>

  <!-- Header -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-3">
      <span class="text-sm text-ink-400" x-text="filtered.length + '/' + markets.length + ' 个市场'"></span>
      <button x-show="!showGuide" @click="showGuide = true" class="text-[10px] text-brand-500 hover:text-brand-700">新手指南</button>
    </div>
    <div class="flex items-center gap-3">
      <button @click="showPositions = !showPositions" class="btn btn-sm btn-ghost text-[10px]" x-text="showPositions ? '隐藏持仓' : '我的持仓'"></button>
      <input x-model="search" @input="page = 1" placeholder="搜索市场..." class="rounded-lg border border-warm-300 px-3 py-1.5 text-xs w-48" />
      <label class="flex items-center gap-1 text-[10px] text-ink-400 cursor-pointer">
        <input type="checkbox" x-model="showExpired" @change="page = 1" class="w-3 h-3" />
        含历史
      </label>
      <a href="https://polymarket.com" target="_blank" class="text-xs text-brand-500 hover:text-brand-700">Polymarket &nearr;</a>
    </div>
  </div>

  <!-- Sort + Filter tabs -->
  <div class="flex items-center gap-2 mb-4 flex-wrap">
    <div class="tab-bar">
      <button class="tab-item" :class="sortBy === 'volume' && 'active'" @click="sortBy = 'volume'; page = 1">24h 热门</button>
      <button class="tab-item" :class="sortBy === 'total' && 'active'" @click="sortBy = 'total'; page = 1">总押注量</button>
      <button class="tab-item" :class="sortBy === 'ending' && 'active'" @click="sortBy = 'ending'; page = 1">即将到期</button>
      <button class="tab-item" :class="sortBy === 'volatile' && 'active'" @click="sortBy = 'volatile'; page = 1">争议最大</button>
      <button class="tab-item" :class="sortBy === 'newest' && 'active'" @click="sortBy = 'newest'; page = 1">最新</button>
    </div>
    <div class="flex gap-1 ml-2">
      <button class="px-2 py-1 rounded text-[10px] transition-colors" :class="filterCat === '' ? 'bg-brand-100 text-brand-700' : 'text-ink-400 hover:bg-warm-100'" @click="filterCat = ''; page = 1">全部</button>
      <template x-for="cat in categories" :key="cat">
        <button class="px-2 py-1 rounded text-[10px] transition-colors" :class="filterCat === cat ? 'bg-brand-100 text-brand-700' : 'text-ink-400 hover:bg-warm-100'" @click="filterCat = cat; page = 1" x-text="cat"></button>
      </template>
    </div>
  </div>

  <!-- 持仓面板 — Phase 2.1c (Owner 5/16 严训 "盈亏茫然" + Bettor r151-r152 consensus 7/7 ACK):
       (A) P&L 公式 fix (cur × size - cost, not shares - dollar) + max@settle dim 副数
       (B) Aggregate header (total cost / 现值 / P&L sum, client-side computed)
       (C) Inline expandable per-card 4 模块 (保护规则 + 调仓建议 + 出清 + 历史)
       (D) 调仓建议 hide-if-0
       (E) Bettor modal sub-tab → 活跃持仓 scrollIntoView
       (F) Reactor stale warning amber if > 2h since last tick -->
  <template x-if="showPositions">
    <div class="card mb-5 active-positions-section">
      <div class="flex items-center justify-between mb-3">
        <div class="text-sm font-medium text-ink-700">活跃持仓
          <span x-show="positions && positions.length" class="text-xs text-ink-400 font-normal" x-text="'(' + positions.length + ' 笔)'"></span>
        </div>
      </div>
      <!-- (F) Reactor stale warning (Bettor r152 §2) -->
      <div x-show="reactorStaleHours > 2" class="text-[10px] text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded mb-2">
        ⚠ 调仓 reactor 上次 tick <span x-text="reactorStaleHours?.toFixed(1)"></span> 小时前 — 可能 cron 失效, 调仓建议不更新 (r153 backlog dig 真因)
      </div>
      <!-- (B) Aggregate header (client-side computed) -->
      <template x-if="positions && positions.length">
        <div class="bg-warm-50 rounded p-2 mb-3 text-xs">
          <div class="flex items-center gap-4 flex-wrap">
            <span class="text-ink-500">总成本 <span class="font-bold text-ink-700" x-text="'$' + portfolioAggregate.totalCost.toFixed(2)"></span></span>
            <span class="text-ink-500">现值 <span class="font-bold text-ink-700" x-text="'$' + portfolioAggregate.currentValue.toFixed(2)"></span></span>
            <span class="font-bold" :class="portfolioAggregate.pnl >= 0 ? 'text-green-600' : 'text-red-500'"
                  x-text="'P&L ' + (portfolioAggregate.pnl >= 0 ? '+$' : '-$') + Math.abs(portfolioAggregate.pnl).toFixed(2) + ' (' + (portfolioAggregate.pnlPct >= 0 ? '+' : '') + (portfolioAggregate.pnlPct * 100).toFixed(1) + '%)'"></span>
            <span class="text-ink-300 text-[10px]">max @ settle <span x-text="(portfolioAggregate.maxAtSettle >= 0 ? '+$' : '-$') + Math.abs(portfolioAggregate.maxAtSettle).toFixed(2)"></span></span>
          </div>
        </div>
      </template>
      <div x-show="!positions.length" class="text-xs text-ink-400 py-4 text-center">暂无活跃持仓</div>
      <template x-for="pos in positions" :key="pos.asset">
        <div class="py-3 border-b border-warm-100 last:border-0 text-xs">
          <!-- Header row clickable to expand (C) -->
          <div class="flex items-center gap-2 cursor-pointer hover:bg-warm-50 -mx-2 px-2 rounded" @click="pos._expanded = !pos._expanded">
            <span class="text-ink-400 text-[10px] w-3" x-text="pos._expanded ? '▼' : '▶'"></span>
            <a :href="'https://polymarket.com/event/' + pos.market" target="_blank" rel="noopener" @click.stop
              class="font-medium text-brand-600 hover:text-brand-800 flex-1" x-text="pos.question || pos.market?.slice(0,20) + '...'"></a>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-medium" :class="pos.outcome === 'Yes' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'" x-text="pos.outcome"></span>
            <span class="font-bold" x-text="pos.size + ' shares'"></span>
            <span class="text-ink-400" x-text="'@ $' + (pos.avgPrice || 0).toFixed(3)"></span>
          </div>
          <!-- Row 2: cost, P&L (FIXED FORMULA), max@settle dim, end date -->
          <div class="flex items-center gap-4 mt-1.5 flex-wrap">
            <span class="text-[10px] text-ink-500">Cost <span class="font-medium" x-text="'$' + (pos.totalCost || 0).toFixed(2)"></span></span>
            <!-- Phase 2.1c (A) FIX: P&L = (size × curPrice) - totalCost. Previous bug混 shares 数 - dollar cost. -->
            <span class="text-[10px] font-bold"
              :class="((pos.size * (pos.curPrice || pos.avgPrice)) - pos.totalCost) >= 0 ? 'text-green-600' : 'text-red-500'"
              x-text="'P&L ' + (((pos.size * (pos.curPrice || pos.avgPrice)) - pos.totalCost) >= 0 ? '+$' : '-$') + Math.abs((pos.size * (pos.curPrice || pos.avgPrice)) - pos.totalCost).toFixed(2) + ' (' + (pos.totalCost > 0 ? (((pos.size * (pos.curPrice || pos.avgPrice)) - pos.totalCost) / pos.totalCost * 100).toFixed(1) : '0') + '%)'"></span>
            <span class="text-[10px] text-ink-300" :title="'赢极限 if YES settles to $1'" x-text="'max@settle ' + ((pos.size - pos.totalCost) >= 0 ? '+$' : '-$') + Math.abs(pos.size - pos.totalCost).toFixed(2)"></span>
            <span class="text-[10px] text-ink-400" x-show="pos.endDate" x-text="'Ends ' + KANet.relativeTime(pos.endDate)"></span>
            <span class="text-[10px] px-1.5 py-0.5 rounded"
              :class="pos.status === 'expired_pending' ? 'bg-amber-50 text-amber-600' : 'bg-green-50 text-green-600'"
              x-text="pos.status === 'expired_pending' ? 'Awaiting resolution' : 'Active'"></span>
          </div>
          <!-- (C) Expandable inline 4 modules: 保护规则 / 调仓建议 / 出清 / 历史 -->
          <div x-show="pos._expanded" x-collapse class="mt-3 space-y-2">
            <!-- 保护规则 inline -->
            <div class="bg-warm-50 rounded p-2 text-[10px]">
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-ink-600">🛡 保护规则</span>
                <template x-if="getProtectRuleFor(pos)">
                  <div class="flex gap-1">
                    <button @click.stop="openProtectEditModal(getProtectRuleFor(pos))" class="px-2 py-0.5 rounded bg-ink-100 hover:bg-ink-200 text-ink-700">✏️ 改</button>
                    <button @click.stop="ackBettorProtectRule(getProtectRuleFor(pos))" x-show="getProtectRuleFor(pos)?.status === 'pending_owner_ack'" :disabled="getProtectRuleFor(pos)?._acking" class="px-2 py-0.5 rounded bg-amber-500 hover:bg-amber-600 text-white disabled:opacity-50">✓ ACK 启用</button>
                    <span x-show="getProtectRuleFor(pos)?.status === 'active'" class="px-2 py-0.5 rounded bg-green-100 text-green-700 font-bold">✓ Active</span>
                  </div>
                </template>
              </div>
              <template x-if="getProtectRuleFor(pos)">
                <div class="text-ink-500">
                  止损 <span x-text="(getProtectRuleFor(pos).stop_loss_pct * 100).toFixed(0) + '%'"></span> after
                  <span x-text="getProtectRuleFor(pos).cooldown_hours + 'h'"></span> ·
                  时间 <span x-text="getProtectRuleFor(pos).time_close_days + 'd'"></span> ·
                  <span class="text-ink-300 italic" :title="'📋 reference only, 待 Phase 3 swap-suggester'">止盈 $<span x-text="getProtectRuleFor(pos).take_profit_price?.toFixed(4)"></span> (ref)</span>
                </div>
              </template>
              <template x-if="!getProtectRuleFor(pos)">
                <div class="text-ink-400">保护规则待生成 (cron 1 min 内 INSERT)</div>
              </template>
            </div>
            <!-- 调仓建议 hide if 0 -->
            <template x-if="getAdjustmentFor(pos)">
              <div class="bg-amber-50 rounded p-2 text-[10px]">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-amber-700">💡 调仓建议</span>
                  <div class="flex gap-1">
                    <button @click.stop="bettorDecideAdjustment(getAdjustmentFor(pos).id, 'approve')" class="px-2 py-0.5 rounded bg-red-500 hover:bg-red-600 text-white">✓ 确认止损 (paper)</button>
                    <button @click.stop="bettorDecideAdjustment(getAdjustmentFor(pos).id, 'reject')" class="px-2 py-0.5 rounded bg-ink-200 hover:bg-ink-300 text-ink-700">✗ 保留</button>
                  </div>
                </div>
                <div class="text-ink-600">
                  <span x-text="getAdjustmentFor(pos).trigger_reason"></span> · 触发于
                  <span x-text="new Date(getAdjustmentFor(pos).created_at).toLocaleString().slice(5)"></span>
                </div>
              </div>
            </template>
          </div>
          <!-- Row 3: market ID + Polymarket link -->
          <div class="flex items-center gap-3 mt-1">
            <span class="text-[10px] text-ink-300 font-mono" x-text="pos.market?.slice(0,16) + '...'" @click="navigator.clipboard.writeText(pos.market)" title="Click to copy conditionId" style="cursor:pointer"></span>
            <a :href="'https://polymarket.com/event/' + pos.market" target="_blank" rel="noopener"
              class="text-[10px] text-brand-400 hover:text-brand-600">View on Polymarket</a>
          </div>
          <!-- Row 4: 出清 button (Bettor r46 (B) Step 1, 独立显眼一行) -->
          <!-- Owner click 死路 hotfix: 移 x-show 容器 / 显式 cursor / 强制 boolean disabled / 始终渲染 + 内层条件 active 才 click -->
          <div class="flex items-center gap-2 mt-2 pt-2 border-t-2 border-amber-300 bg-amber-50 rounded p-2">
            <button type="button" @click.prevent.stop="sellActivePosition(pos)" :disabled="!!pos._closing"
              style="cursor:pointer"
              class="flex-1 px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded font-bold text-sm disabled:opacity-50 disabled:cursor-not-allowed shadow-md border-2 border-amber-700">
              <span x-show="!pos._closing">💰 一键出清 (sell @ market · <span x-text="pos.size"></span> shares)</span>
              <span x-show="pos._closing">出清中...</span>
            </button>
            <span x-show="pos._closeTx" class="text-[10px] text-green-600 whitespace-nowrap">✓ TX <a :href="'https://polygonscan.com/tx/' + pos._closeTx" target="_blank" rel="noopener" class="font-mono underline" x-text="pos._closeTx?.slice(0,10) + '...'"></a></span>
            <span x-show="pos._closeError" class="text-[10px] text-red-500" x-text="pos._closeError"></span>
          </div>
        </div>
      </template>
      <!-- 战绩汇总卡 — 不依赖 capital, 只要 wins+losses+pending>0 就展示 (sweep 后 capital 可能负) -->
      <template x-if="summary && ((summary.wins || 0) + (summary.losses || 0) + (summary.pending || 0) > 0)">
        <div class="mt-4 pt-3 border-t border-warm-200">
          <div class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-3">战绩统计</div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
            <!-- 本金 → 当前 (capital > 0 才显示, sweep 后 fallback 用 totalStaked) -->
            <div class="bg-gradient-to-br from-brand-50 to-brand-100 rounded-lg p-3 col-span-2" x-show="summary.capital && summary.capital > 0">
              <div class="text-[10px] text-ink-400 uppercase tracking-wide">
                <span x-show="!summary.capitalNote">本金 → 当前账面</span>
                <span x-show="summary.capitalNote === 'swept'">累积投入 → 当前账面 (sweep 过)</span>
              </div>
              <div class="text-lg font-bold text-brand-700 mt-0.5">
                $<span x-text="summary.capital.toFixed(2)"></span>
                <span class="text-ink-400 mx-1">→</span>
                $<span x-text="(summary.currentTotal || 0).toFixed(2)"></span>
              </div>
              <div class="text-xs mt-0.5" :class="(summary.roiTotal || 0) >= 0 ? 'text-green-600 font-semibold' : 'text-red-500 font-semibold'" x-show="summary.capital > 0">
                翻 <span x-text="((summary.currentTotal || 0) / summary.capital).toFixed(2) + '×'"></span>
                · ROI <span x-text="((summary.roiTotal || 0) >= 0 ? '+' : '') + ((summary.roiTotal || 0) * 100).toFixed(0) + '%'"></span>
              </div>
            </div>
            <!-- 战绩 -->
            <div class="bg-warm-50 rounded-lg p-3">
              <div class="text-[10px] text-ink-400 uppercase tracking-wide">战绩</div>
              <div class="text-lg font-bold text-ink-700 mt-0.5">
                <span class="text-green-600" x-text="summary.wins"></span><span class="text-[10px] text-ink-500 mr-1.5">胜</span>
                <span class="text-red-500" x-text="summary.losses"></span><span class="text-[10px] text-ink-500 mr-1.5">负</span>
                <template x-if="summary.pending > 0">
                  <span><span class="text-amber-500" x-text="summary.pending"></span><span class="text-[10px] text-ink-500">待</span></span>
                </template>
              </div>
              <div class="text-xs text-ink-500 mt-0.5">
                <template x-if="summary.winRate != null">
                  <span>胜率 <span class="font-semibold" x-text="(summary.winRate * 100).toFixed(0) + '%'"></span></span>
                </template>
              </div>
            </div>
            <!-- 已实现 -->
            <div class="bg-warm-50 rounded-lg p-3">
              <div class="text-[10px] text-ink-400 uppercase tracking-wide">已实现净利</div>
              <div class="text-lg font-bold mt-0.5" :class="summary.realizedPnl >= 0 ? 'text-green-600' : 'text-red-500'"
                x-text="(summary.realizedPnl >= 0 ? '+$' : '−$') + Math.abs(summary.realizedPnl).toFixed(2)"></div>
              <div class="text-xs text-ink-500 mt-0.5">
                <template x-if="summary.roiRealized != null">
                  <span x-text="(summary.roiRealized >= 0 ? '+' : '') + (summary.roiRealized * 100).toFixed(0) + '% on 本金'"></span>
                </template>
              </div>
            </div>
          </div>
          <!-- 资金效率 + 明细 -->
          <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-ink-500">
            <span>累计下注 <span class="font-semibold text-ink-700" x-text="'$' + summary.totalStaked.toFixed(2)"></span></span>
            <template x-if="summary.turnover != null">
              <span>资金周转 <span class="font-semibold text-ink-700" x-text="summary.turnover.toFixed(1) + '×'"></span></span>
            </template>
            <span>USDC <span class="font-semibold text-ink-700" x-text="'$' + summary.currentUsdc.toFixed(2)"></span></span>
            <span>持仓市值 <span class="font-semibold text-ink-700" x-text="'$' + summary.currentTokenValue.toFixed(2)"></span></span>
            <template x-if="summary.unrealizedPnl !== 0">
              <span :class="summary.unrealizedPnl >= 0 ? 'text-amber-600' : 'text-red-500'">
                浮动 <span class="font-semibold" x-text="(summary.unrealizedPnl >= 0 ? '+$' : '−$') + Math.abs(summary.unrealizedPnl).toFixed(2)"></span>
              </span>
            </template>
          </div>
        </div>
      </template>
      <!-- 资金时间线 -->
      <template x-if="summary && summary.timeline && summary.timeline.length > 0">
        <div class="mt-4 pt-3 border-t border-warm-200">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-ink-500 uppercase tracking-wider">资金时间线</div>
            <button @click="timelineExpanded = !timelineExpanded" class="text-[10px] text-brand-500 hover:text-brand-700"
              x-text="timelineExpanded ? '收起明细' : '展开明细'"></button>
          </div>
          <!-- Sparkline (USDC 余额曲线) -->
          <div class="bg-gradient-to-b from-warm-50 to-white rounded-lg p-3 mb-2 relative">
            <svg :viewBox="'0 0 600 90'" class="w-full h-20" preserveAspectRatio="none">
              <!-- Area fill under line -->
              <path :d="sparklineAreaPath()" fill="rgba(59, 130, 246, 0.08)" stroke="none"></path>
              <!-- Line -->
              <path :d="sparklinePath()" fill="none" stroke="rgb(59, 130, 246)" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
              <!-- Event dot decoration removed (Bettor r134 真根因 + Owner DevTools 5/15):
                   <template x-for> inside SVG namespace breaks Alpine init walk —
                   <template> in SVG ≠ HTMLTemplateElement, no .content DocumentFragment.
                   Alpine "Cannot read properties of undefined (reading 'children')" interrupted
                   directive registration, leaving ACCEPT button :disabled / @click unbound
                   (Bug U1 4-attempt sediment — KI-Phase-B-UI-3 — never use <template x-for>
                   inside SVG; use imperative D3-style render or path-only visualization). -->
            </svg>
            <!-- Endpoints label -->
            <div class="flex justify-between text-[10px] text-ink-400 mt-0.5 font-mono">
              <span>起 $<span x-text="summary.capital.toFixed(2)"></span></span>
              <span class="text-ink-500">
                峰 $<span x-text="sparklinePeak().toFixed(2)"></span>
              </span>
              <span :class="summary.currentUsdc >= summary.capital ? 'text-green-600' : 'text-ink-400'">
                现 $<span x-text="summary.currentUsdc.toFixed(2)"></span>
              </span>
            </div>
          </div>
          <!-- 事件明细 (可折叠) -->
          <div x-show="timelineExpanded" x-transition>
            <template x-for="(ev, idx) in summary.timeline" :key="idx">
              <div class="flex items-center gap-2 py-1.5 border-b border-warm-50 last:border-0 text-[11px]">
                <span class="text-ink-400 font-mono flex-shrink-0 w-20" x-text="ev.date.slice(5, 16).replace('T', ' ')"></span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold flex-shrink-0 w-12 text-center"
                  :class="ev.action === 'WIN' ? 'bg-green-100 text-green-700' : ev.action === 'LOSE' ? 'bg-red-100 text-red-600' : ev.action === 'BUY' ? 'bg-blue-100 text-blue-700' : 'bg-warm-100 text-ink-500'"
                  x-text="ev.action === 'WIN' ? '✓赢' : ev.action === 'LOSE' ? '✗输' : ev.action === 'BUY' ? '买入' : ev.action"></span>
                <span class="font-semibold flex-shrink-0 w-16 text-right"
                  :class="ev.amount > 0 ? 'text-green-600' : ev.amount < 0 ? 'text-ink-600' : 'text-ink-400'"
                  x-text="(ev.amount >= 0 ? '+$' : '−$') + Math.abs(ev.amount).toFixed(2)"></span>
                <span class="flex-1 text-ink-600 min-w-0 truncate" x-text="ev.marketTitle || ''"></span>
                <span class="text-ink-400 flex-shrink-0" x-text="'bal $' + ev.runningUsdc.toFixed(2)"></span>
              </div>
            </template>
          </div>
        </div>
      </template>
      <!-- History (settled + redeemable) -->
      <div x-show="settled.length > 0" class="mt-4 pt-3 border-t border-warm-200">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-semibold text-ink-500 uppercase tracking-wider">历史交易</div>
            <!-- 一键清算全部 redeemable position (绕过单按钮 UI bug 的兜底路径) -->
            <button x-show="settled.some(p => p.redeemable && !p._redeemed)"
              @click="redeemAll()" :disabled="redeemingAll"
              class="px-2 py-0.5 bg-green-600 text-white rounded text-[10px] font-medium hover:bg-green-700 disabled:opacity-50">
              <span x-show="!redeemingAll" x-text="'一键清算 (' + settled.filter(p => p.redeemable && !p._redeemed).length + ')'"></span>
              <span x-show="redeemingAll">清算中...</span>
            </button>
          </div>
          <template x-for="pos in settled" :key="pos.asset">
            <div class="py-3 border-b border-warm-50 last:border-0 text-xs">
              <div class="flex items-center gap-2">
                <!-- Verdict 徽章 (WIN/LOSE/PENDING) -->
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold flex-shrink-0"
                  :class="pos.verdict === 'WIN' ? 'bg-green-100 text-green-700' : pos.verdict === 'LOSE' ? 'bg-red-100 text-red-600' : 'bg-warm-100 text-ink-500'"
                  x-text="pos.verdict === 'WIN' ? '✓ 赢' : pos.verdict === 'LOSE' ? '✗ 输' : '⏳'"></span>
                <!-- 单笔净利 -->
                <span class="text-[11px] font-semibold flex-shrink-0 w-16"
                  :class="(pos.realizedPnl || 0) >= 0 ? 'text-green-600' : 'text-red-500'"
                  x-text="pos.realizedPnl != null ? ((pos.realizedPnl >= 0 ? '+$' : '−$') + Math.abs(pos.realizedPnl).toFixed(2)) : ''"></span>
                <a :href="'https://polymarket.com/event/' + pos.market" target="_blank" rel="noopener"
                  class="flex-1 text-ink-600 hover:text-brand-600 min-w-0 truncate" x-text="pos.question || pos.market?.slice(0,20) + '...'"></a>
                <span class="px-1.5 py-0.5 rounded text-[10px] flex-shrink-0" :class="pos.outcome === 'Yes' ? 'bg-green-50 text-green-600' : 'bg-red-50 text-red-500'" x-text="pos.outcome"></span>
                <span class="text-[10px] text-ink-400 flex-shrink-0" x-text="pos.size + '×$' + (pos.avgPrice || 0).toFixed(3)"></span>
              </div>
              <div class="flex items-center gap-2 mt-1.5 text-[10px] text-ink-400">
                <span>成本 $<span x-text="(pos.totalCost || 0).toFixed(2)"></span></span>
                <template x-if="pos.actualReceived != null && pos.actualReceived > 0">
                  <span>回款 $<span x-text="pos.actualReceived.toFixed(2)"></span></span>
                </template>
                <template x-if="pos.winner">
                  <span>裁决 <span class="font-mono" x-text="pos.winner"></span></span>
                </template>
                <!-- Redeemable: show Redeem button -->
                <button x-show="pos.redeemable && !pos._redeemed" @click="redeemPosition(pos)" :disabled="pos._redeeming"
                  class="px-3 py-1 bg-green-500 text-white rounded text-[10px] font-medium hover:bg-green-600 disabled:opacity-50 transition-colors ml-auto">
                  <span x-show="!pos._redeeming">Redeem</span>
                  <span x-show="pos._redeeming">Redeeming...</span>
                </button>
                <!-- Already redeemed (from API check or just-redeemed) -->
                <span x-show="pos.redeemed || pos._redeemed" class="text-green-600 font-medium px-2 py-0.5 bg-green-50 rounded">Already Redeemed</span>
                <!-- TX link after successful redeem -->
                <a x-show="pos._redeemTx" :href="'https://polygonscan.com/tx/' + pos._redeemTx" target="_blank" rel="noopener"
                  class="text-brand-500 hover:text-brand-700 font-mono" x-text="pos._redeemTx ? 'TX ' + pos._redeemTx.slice(0,12) + '...' : ''"></a>
                <span x-show="pos._redeemError" class="text-red-500" x-text="pos._redeemError"></span>
              </div>
            </div>
          </template>
      </div>
      <!-- 活跃订单 (LIVE limit orders 未成交) — Owner 5/17 04:44 钦定 UI 显示让 user 手动操作 -->
      <div class="mt-3 pt-3 border-t border-warm-200">
        <div class="text-sm font-semibold text-ink-700 mb-2">📋 挂单 (未成交)
          <span x-show="orders && orders.length" class="text-xs text-ink-400 font-normal" x-text="'(' + orders.length + ')'"></span>
        </div>
        <div x-show="!orders.length" class="text-xs text-ink-400 text-center py-2">无挂单</div>
        <template x-for="ord in orders" :key="ord.id">
          <div class="py-2 border-b border-warm-100 last:border-0 text-xs">
            <div class="flex items-center gap-2 mb-1">
              <a :href="'https://polymarket.com/event/' + (ord.slug || ord.market || '')" target="_blank" rel="noopener"
                 class="flex-1 font-medium text-ink-700 hover:text-brand-600 truncate"
                 :title="ord.question || ord.market"
                 x-text="ord.question || ('condition ' + (ord.market?.slice(0,12) + '...'))"></a>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold whitespace-nowrap" :class="ord.side==='BUY'?'bg-green-100 text-green-700':'bg-red-100 text-red-700'" x-text="ord.side + ' ' + (ord.outcome || '')"></span>
            </div>
            <div class="flex items-center gap-3 text-[11px] text-ink-500">
              <span>挂价 <span class="font-bold text-ink-700" x-text="'$' + (ord.price || 0)"></span></span>
              <template x-if="ord.current_price != null">
                <span :class="ord.current_price > parseFloat(ord.price) ? 'text-red-500' : 'text-green-600'"
                      :title="ord.current_price > parseFloat(ord.price) ? '挂价低于市场, 不会 fill — 改高重挂' : '挂价 ≥ 市场, 应即时 fill'"
                      x-text="'现价 $' + ord.current_price.toFixed(4) + (ord.current_price > parseFloat(ord.price) ? ' ⚠ 低于市场' : ' ✓')"></span>
              </template>
              <span class="text-ink-400" x-text="ord.original_size + ' 份'"></span>
              <span class="text-ink-400" x-text="'fill ' + (Number(ord.size_matched || 0)).toFixed(0) + '/' + ord.original_size"></span>
              <template x-if="ord.endDate">
                <span class="text-ink-400" x-text="'到期 ' + new Date(ord.endDate).toLocaleDateString()"></span>
              </template>
              <button @click="cancelOrd(ord.id)" class="ml-auto px-2 py-1 rounded bg-red-50 text-red-600 hover:bg-red-100 text-[10px] font-medium">✗ 撤单</button>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Market list -->
  <div class="space-y-3">
    <template x-for="(m, idx) in paged" :key="idx">
      <div class="bg-white rounded-xl border border-warm-200 p-4 hover:border-brand-300 transition-colors">
        <!-- Question + 概率 -->
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="text-sm font-medium text-ink-700 leading-relaxed" x-text="m.question"></div>
            <template x-if="m.description">
              <div class="text-xs text-ink-400 mt-1 line-clamp-2" x-text="m.description.substring(0, 120) + (m.description.length > 120 ? '...' : '')"></div>
            </template>
          </div>
          <template x-if="m.yes != null">
            <div class="text-right flex-shrink-0">
              <div class="text-2xl font-bold" :class="m.yes > 70 ? 'text-green-600' : m.yes < 30 ? 'text-red-500' : 'text-amber-600'"
                x-text="m.yes + '%'"></div>
              <div class="text-[10px] text-ink-300">Yes 概率</div>
            </div>
          </template>
        </div>

        <!-- 概率条 -->
        <template x-if="m.yes != null">
          <div class="mt-3">
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-green-600 w-8" x-text="m.yes + '%'"></span>
              <div class="flex-1 h-3 bg-warm-200 rounded-full overflow-hidden flex">
                <div class="h-full bg-green-500 rounded-l-full transition-all" :style="'width:' + m.yes + '%'"></div>
                <div class="h-full bg-red-400 rounded-r-full transition-all" :style="'width:' + m.no + '%'"></div>
              </div>
              <span class="text-[10px] text-red-500 w-8 text-right" x-text="m.no + '%'"></span>
            </div>
          </div>
        </template>

        <!-- 交易数据 -->
        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-[11px] text-ink-400">
          <template x-if="m.volume > 0"><span class="font-medium text-ink-500" x-text="'总量: $' + formatVol(m.volume)"></span></template>
          <template x-if="m.volume24h > 0"><span x-text="'24h: $' + formatVol(m.volume24h)"></span></template>
          <template x-if="m.liquidity > 0"><span x-text="'流动性: $' + formatVol(m.liquidity)"></span></template>
          <template x-if="m.spread != null"><span x-text="'价差: ' + (m.spread * 100).toFixed(1) + '%'"></span></template>
          <template x-if="m.endDate"><span x-text="'截止 ' + m.endDate.substring(0, 10)"></span></template>
        </div>

        <!-- 中文解读 -->
        <template x-if="m.yes != null">
          <div class="mt-2 text-xs px-3 py-2 rounded-lg"
            :class="m.yes > 70 ? 'bg-green-50 text-green-700' : m.yes < 30 ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700'"
            x-text="interpret(m)"></div>
        </template>

        <!-- 操作栏 -->
        <div class="flex items-center gap-2 mt-3">
          <button @click="toggleTrade(idx)" class="btn btn-sm btn-primary text-[10px]"
            x-text="tradeIdx === idx ? '收起' : '交易'"></button>
          <button @click="askAgent(m)" :disabled="m._asking" class="btn btn-sm btn-secondary text-[10px]"
            x-text="m._asking ? '分析中...' : m._agentReply ? '再问一次' : '问 Agent'"></button>
          <template x-if="m.slug">
            <a :href="'https://polymarket.com/event/' + m.slug" target="_blank" class="text-[10px] text-brand-500 hover:text-brand-700">详情 &rarr;</a>
          </template>
          <template x-if="m.description">
            <button @click="m._showRule = !m._showRule" class="text-[10px] text-ink-400 hover:text-ink-600" x-text="m._showRule ? '收起规则' : '分辨规则'"></button>
          </template>
        </div>

        <!-- Agent 对话 -->
        <template x-if="m._agentReply">
          <div class="mt-3 border border-brand-200 rounded-xl p-4 bg-brand-50/20">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-5 h-5 rounded-full bg-brand-500 text-white text-[10px] flex items-center justify-center font-bold">A</span>
              <span class="text-xs font-medium text-brand-700">Agent</span>
              <button @click="m._agentReply = null; m._chatHistory = null" class="ml-auto text-[10px] text-ink-300 hover:text-ink-500">结束对话</button>
            </div>
            <!-- Chat history -->
            <template x-if="m._chatHistory?.length > 0">
              <div class="space-y-2 mb-3">
                <template x-for="(msg, mi) in m._chatHistory" :key="mi">
                  <div class="text-sm leading-relaxed whitespace-pre-line"
                    :class="msg.role === 'agent' ? 'text-ink-600' : 'text-brand-700 bg-brand-50 rounded-lg px-3 py-1.5'">
                    <span x-text="msg.text"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- Latest reply (if no history yet) -->
            <div x-show="!m._chatHistory?.length" class="text-sm text-ink-600 leading-relaxed whitespace-pre-line mb-3" x-text="m._agentReply"></div>
            <!-- Reply input -->
            <div class="flex gap-2">
              <input type="text" x-model="m._replyInput" @keydown.enter="replyToAgent(m)"
                :disabled="m._asking" placeholder="回复 Agent..."
                class="flex-1 text-sm border border-warm-300 rounded-lg px-3 py-1.5" />
              <button @click="replyToAgent(m)" :disabled="m._asking || !m._replyInput"
                class="btn btn-sm btn-primary text-[10px]"
                x-text="m._asking ? '...' : '发送'"></button>
            </div>
          </div>
        </template>

        <!-- 分辨规则 -->
        <template x-if="m._showRule">
          <div class="mt-2 text-[11px] text-ink-500 bg-warm-50 rounded-lg p-3 leading-relaxed">
            <p x-text="m.description"></p>
            <template x-if="m.resolutionSource"><p class="mt-1 font-medium" x-text="'信息来源: ' + m.resolutionSource"></p></template>
          </div>
        </template>

        <!-- 交易面板 -->
        <template x-if="tradeIdx === idx">
          <div class="mt-3 border border-brand-200 rounded-xl p-4 bg-brand-50/30">
            <div class="grid grid-cols-2 gap-4">
              <!-- 下单表单 -->
              <div>
                <div class="text-xs font-medium text-ink-700 mb-2">下单</div>
                <div class="space-y-2">
                  <div class="flex gap-2">
                    <button @click="tradeForm.outcome = 'yes'" class="flex-1 btn btn-sm text-[10px]"
                      :class="tradeForm.outcome === 'yes' ? 'btn-primary bg-green-600 hover:bg-green-700' : 'btn-ghost'">Yes</button>
                    <button @click="tradeForm.outcome = 'no'" class="flex-1 btn btn-sm text-[10px]"
                      :class="tradeForm.outcome === 'no' ? 'btn-primary bg-red-500 hover:bg-red-600' : 'btn-ghost'">No</button>
                  </div>
                  <div class="flex gap-2">
                    <button @click="tradeForm.side = 'BUY'" class="flex-1 btn btn-sm text-[10px]"
                      :class="tradeForm.side === 'BUY' ? 'btn-primary' : 'btn-ghost'">买入</button>
                    <button @click="tradeForm.side = 'SELL'" class="flex-1 btn btn-sm text-[10px]"
                      :class="tradeForm.side === 'SELL' ? 'btn-secondary' : 'btn-ghost'">卖出</button>
                  </div>
                  <div>
                    <label class="text-[10px] text-ink-400">价格 (0.01-0.99)</label>
                    <input type="number" step="0.01" min="0.01" max="0.99" x-model.number="tradeForm.price"
                      class="w-full text-sm border border-warm-300 rounded-lg px-3 py-1.5" />
                  </div>
                  <div>
                    <label class="text-[10px] text-ink-400">数量 (USDC)</label>
                    <input type="number" step="1" min="1" x-model.number="tradeForm.size"
                      class="w-full text-sm border border-warm-300 rounded-lg px-3 py-1.5" />
                  </div>
                  <div class="text-[10px] text-ink-400" x-show="tradeForm.price && tradeForm.size">
                    <span x-text="'成本: $' + (tradeForm.price * tradeForm.size).toFixed(2)"></span>
                    <span class="ml-2" x-text="'潜在盈利: $' + ((1 - tradeForm.price) * tradeForm.size).toFixed(2)"></span>
                  </div>
                  <!-- Pre-flight 提示：总是说明为什么下不了/能下 -->
                  <template x-if="checkTrade(m)">
                    <div class="text-[10px] text-amber-700 bg-amber-50 rounded px-2 py-1.5 leading-snug" x-text="checkTrade(m).msg"></div>
                  </template>
                  <button @click="submitOrder(m)" :disabled="ordering || !!checkTrade(m)" class="btn btn-primary w-full text-xs">
                    <span x-text="ordering ? '提交中...' : (checkTrade(m) ? '无法下单' : '提交订单')"></span>
                  </button>
                  <div x-show="tradeMsg" class="text-[10px]" :class="tradeMsg.includes('成功') ? 'text-green-600' : 'text-red-500'" x-text="tradeMsg"></div>
                </div>
              </div>
              <!-- 订单簿 — Polymarket CLOB: bids 低→高，asks 高→低。top-of-book 在末尾 -->
              <div>
                <div class="text-xs font-medium text-ink-700 mb-2">订单簿 (顶部最接近成交价)</div>
                <div x-show="bookLoading" class="text-xs text-ink-300 py-4 text-center">加载中...</div>
                <template x-if="!bookLoading && book">
                  <div class="text-[10px] space-y-1">
                    <div class="text-ink-400 font-medium">卖出 (Asks — 你买入需付)</div>
                    <template x-for="ask in (book.asks || []).slice(-5)" :key="ask.price">
                      <div class="flex justify-between">
                        <span class="text-red-500" x-text="'$' + ask.price"></span>
                        <span class="text-ink-400" x-text="ask.size"></span>
                      </div>
                    </template>
                    <div class="border-t border-warm-200 my-1"></div>
                    <div class="text-ink-400 font-medium">买入 (Bids — 你卖出可得)</div>
                    <template x-for="bid in (book.bids || []).slice(-5).reverse()" :key="bid.price">
                      <div class="flex justify-between">
                        <span class="text-green-600" x-text="'$' + bid.price"></span>
                        <span class="text-ink-400" x-text="bid.size"></span>
                      </div>
                    </template>
                    <div x-show="!(book.asks||[]).length && !(book.bids||[]).length" class="text-ink-300 text-center py-2">暂无订单簿数据</div>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </template>
      </div>
    </template>
    <div x-show="filtered.length === 0 && !loading" class="text-center text-ink-300 py-12">
      <template x-if="search"><span x-text="'未找到包含「' + search + '」的市场'"></span></template>
      <template x-if="!search"><span>暂无预测市场数据</span></template>
    </div>
    <div x-show="loading" class="text-center text-ink-300 py-12">加载中...</div>
  </div>

  <!-- Pagination -->
  <div x-show="totalPages > 1" class="flex items-center justify-center gap-2 mt-5">
    <button @click="page = Math.max(1, page - 1)" :disabled="page <= 1"
      class="btn btn-sm btn-ghost text-xs" :class="page <= 1 && 'opacity-30'">上一页</button>
    <template x-for="p in Array.from({length: Math.min(totalPages, 7)}, (_, i) => {
      if (totalPages <= 7) return i + 1;
      if (page <= 4) return i + 1;
      if (page >= totalPages - 3) return totalPages - 6 + i;
      return page - 3 + i;
    })" :key="p">
      <button @click="page = p; window.scrollTo(0, 300)"
        class="w-8 h-8 rounded-lg text-xs font-medium transition-colors"
        :class="page === p ? 'bg-brand-500 text-white' : 'text-ink-400 hover:bg-warm-100'"
        x-text="p"></button>
    </template>
    <button @click="page = Math.min(totalPages, page + 1)" :disabled="page >= totalPages"
      class="btn btn-sm btn-ghost text-xs" :class="page >= totalPages && 'opacity-30'">下一页</button>
    <span class="text-[10px] text-ink-300 ml-2" x-text="page + '/' + totalPages + ' · ' + filtered.length + ' 个市场'"></span>
  </div>

  <div class="text-[10px] text-ink-300 text-center mt-6">
    数据来源: Polymarket (Polygon) · 概率 = 市场出清价格 · 非投资建议
  </div>
</div>

<script>
function predictionsPage() {
  return {
    markets: [],
    loading: true,
    search: '',
    sortBy: 'volume',
    filterCat: '',
    categories: [],
    page: 1,
    pageSize: 20,
    showExpired: false,
    showGuide: !localStorage.getItem('prediction_guide_seen'),
    selectedAgent: '<%= it.relayNodes[0]?.id || "" %>',
    walletStatus: { hasWallet: false },
    walletMsg: '',
    approving: false,
    migratingV2: false,
    settingUp: false,
    showPositions: true,
    positions: [],
    settled: [],
    summary: null,
    timelineExpanded: false,
    orders: [],
    tradeIdx: null,
    tradeForm: { outcome: 'yes', side: 'BUY', price: 0.50, size: 10 },
    tradeMsg: '',
    ordering: false,
    book: null,
    bookLoading: false,
    creatingWallet: false,
    redeemingAll: false,

    // Bettor (Phase 3a + 3d)
    bettorRecs: null,
    bettorScanning: false,
    bettorModalOpen: false,
    bettorDetail: null,
    bettorTab: 'recs',
    bettorRecord: null,
    bettorResolving: false,
    bettorHistory: null,
    bettorWinrate: null,  // Module 4b — 胜率轨迹 timeline data {days, daily, cumulative}
    bettorHistoryRecs: null,  // Owner 5/15 + Bettor r132 — 推荐历史 raw rec table
    bettorHistoryFilter: 'all',
    bettorProtectRules: null,  // Owner 5/16 + Bettor r139 — 持仓保护 rules + ack/active/triggered
    bettorVariants: null,      // Owner 5/16 + Bettor r141 — Variant Expander 3-tier (per parent rec id keyed map)
    bettorStrategyFilter: 'all',  // Phase 2.3 Owner 5/17 + Bettor r161-r162 — strategy filter chips (all / scavenger_main / carrion / topN_rank / election_locked / competitive)
    reactorStaleHours: 0,      // Phase 2.1c Bettor r152 — reactor stale warning (UI banner if > 2h)
    protectEditModal: null,    // Phase 2.1c Bettor r151 (b) — modal edit form for protect rule thresholds
    protectEditForm: { stop_loss_pct: -0.30, cooldown_hours: 12, take_profit_price: 0.95, time_close_days: 60 },
    bettorAdjustments: null,
    bettorEvaluating: false,
    closingAll: false,

    // Owner 5/17 钦定 mode 1+2 — 阈值 Watcher
    watchRules: null,
    watcherTicking: false,
    watchSubmitting: false,
    watchAdd: { show: false, relay_node_id: '', token_id: '', market_title: '', outcome: 'Yes', current_size: 0, entry_avg_price: 0, thresholds: [
      { label: 'strong_yes', op: 'gte', price: 0.55, sell_pct: 60, action: 'sell 60% lock profit' },
      { label: 'mild_yes',   op: 'gte', price: 0.45, sell_pct: 30, action: 'sell 30% partial' },
      { label: 'mild_no',    op: 'lte', price: 0.25, sell_pct: 50, action: 'sell 50% cut loss' },
      { label: 'strong_no',  op: 'lte', price: 0.18, sell_pct: 100, action: 'full exit 认输' },
    ] },

    get filtered() {
      let list = this.markets;
      // Text search
      if (this.search) {
        const q = this.search.toLowerCase();
        list = list.filter(m =>
          (m.question || '').toLowerCase().includes(q) ||
          (m.description || '').toLowerCase().includes(q)
        );
      }
      // Hide expired markets (endDate passed) unless user opts in
      if (!this.showExpired) {
        const today = new Date().toISOString().slice(0, 10); // "2026-04-01"
        list = list.filter(m => !m.endDate || m.endDate >= today);
      }
      // Category filter
      if (this.filterCat) {
        list = list.filter(m => m._cat === this.filterCat);
      }
      // Sort
      if (this.sortBy === 'volume') {
        list = [...list].sort((a, b) => (b.volume24h || 0) - (a.volume24h || 0));
      } else if (this.sortBy === 'total') {
        list = [...list].sort((a, b) => (b.volume || 0) - (a.volume || 0));
      } else if (this.sortBy === 'ending') {
        const now = new Date().toISOString();
        list = [...list].filter(m => m.endDate && m.endDate > now)
          .sort((a, b) => (a.endDate || '').localeCompare(b.endDate || ''));
      } else if (this.sortBy === 'volatile') {
        // Closest to 50/50 = most controversial
        list = [...list].sort((a, b) => Math.abs((a.yes || 50) - 50) - Math.abs((b.yes || 50) - 50));
      } else if (this.sortBy === 'newest') {
        list = [...list].sort((a, b) => (b._created || '').localeCompare(a._created || ''));
      }
      return list;
    },

    get totalPages() { return Math.ceil(this.filtered.length / this.pageSize) || 1; },

    get paged() {
      const start = (this.page - 1) * this.pageSize;
      return this.filtered.slice(start, start + this.pageSize);
    },

    // Sparkline helpers: USDC-balance trajectory from timeline events
    _sparkValues() {
      if (!this.summary || !this.summary.timeline) return [];
      return [this.summary.capital, ...this.summary.timeline.map(t => t.runningUsdc)];
    },
    _sparkBounds() {
      const values = this._sparkValues();
      if (!values.length) return { min: 0, max: 1, range: 1 };
      const min = Math.min(...values);
      const max = Math.max(...values);
      return { min, max, range: (max - min) || 1 };
    },
    sparklinePoints() {
      const values = this._sparkValues();
      if (values.length < 2) return [];
      const { min, range } = this._sparkBounds();
      const w = 600, h = 90, pad = 8;
      const step = (w - pad * 2) / (values.length - 1);
      return values.slice(1).map((v, i) => ({
        x: (pad + (i + 1) * step).toFixed(1),
        y: (h - pad - ((v - min) / range) * (h - pad * 2)).toFixed(1),
        action: this.summary.timeline[i].action,
      }));
    },
    sparklinePath() {
      const values = this._sparkValues();
      if (values.length < 2) return '';
      const { min, range } = this._sparkBounds();
      const w = 600, h = 90, pad = 8;
      const step = (w - pad * 2) / (values.length - 1);
      return values.map((v, i) => {
        const x = pad + i * step;
        const y = h - pad - ((v - min) / range) * (h - pad * 2);
        return (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1);
      }).join(' ');
    },
    sparklineAreaPath() {
      const line = this.sparklinePath();
      if (!line) return '';
      const values = this._sparkValues();
      const w = 600, h = 90, pad = 8;
      const step = (w - pad * 2) / (values.length - 1);
      const lastX = pad + (values.length - 1) * step;
      return line + ' L' + lastX.toFixed(1) + ',' + (h - pad) + ' L' + pad + ',' + (h - pad) + ' Z';
    },
    sparklinePeak() {
      const values = this._sparkValues();
      return values.length ? Math.max(...values) : 0;
    },

    // Pre-flight check — returns null if order can submit, or {msg} explaining why not.
    // Called from template + submitOrder. 让按钮"会说话"而不是静默灰掉。
    checkTrade(m) {
      if (!this.walletStatus.hasWallet) return { msg: '先创建 Polygon 钱包（顶部按钮）' };
      if (!this.walletStatus.approved) return { msg: '先授权 USDC 给 Polymarket（顶部 "授权 USDC" 按钮）' };
      if (!this.walletStatus.v2Migrated) return { msg: 'Polymarket 4/28 升级到 V2，先迁移到 pUSD（顶部 "迁移到 V2" 按钮）' };
      if (!this.walletStatus.hasClobKey) return { msg: '先设置 CLOB API Key（顶部 "设置 API Key" 按钮）' };
      const price = Number(this.tradeForm.price);
      const size = Number(this.tradeForm.size);
      if (!(price > 0 && price < 1)) return { msg: '价格必须在 $0.01–$0.99 之间，按 0.01 为最小刻度' };
      if (!(size > 0)) return { msg: '数量必须 > 0' };
      const cost = price * size;
      if (cost < 5) {
        const minSize = Math.ceil(5 / price);
        return { msg: `Polymarket 最小订单 $5（当前 $${cost.toFixed(2)}）。数量至少填 ${minSize}` };
      }
      if (this.tradeForm.side === 'BUY') {
        // V2: 抵押是 pUSD（USDC 1:1 wrap）。挂单期间 pUSD 不会从 token balance 扣（V2
        // 用 allowance 锁定模型），但要确保 balance ≥ 已挂单总额 + 当前下单。
        const bal = this.walletStatus.pusd || 0;
        if (cost > bal) {
          const maxSize = Math.floor(bal / price * 100) / 100;
          const wrapBtn = this.walletStatus.v2Migrated ? '"包装为 pUSD"' : '"迁移到 V2"';
          return { msg: `pUSD 不够（需 $${cost.toFixed(2)}，余 $${bal.toFixed(2)}）。当前价最多买 ${maxSize} 份。USDC 还有 $${(this.walletStatus.usdc||0).toFixed(2)}，可点 ${wrapBtn} 把 USDC 包装成 pUSD。` };
        }
      } else {
        // SELL: 必须已持有该 outcome token（CLOB 不支持裸空）
        const tokenId = this.tradeForm.outcome === 'yes'
          ? (m?.clobTokenIds?.[0])
          : (m?.clobTokenIds?.[1]);
        if (!tokenId) return { msg: '无法解析 Token ID（市场数据缺失）' };
        const held = (this.positions || []).find(p => String(p.asset) === String(tokenId));
        const heldSize = held?.size || 0;
        if (heldSize < size) {
          const outOther = this.tradeForm.outcome === 'yes' ? 'No' : 'Yes';
          const mirrorPrice = (1 - price).toFixed(2);
          return { msg: `你持有 ${heldSize} 份 ${this.tradeForm.outcome.toUpperCase()}，不够卖 ${size}。Polymarket 不支持裸空，想押反方向请改「${outOther} + 买入 @ $${mirrorPrice}」（经济等价）` };
        }
      }
      return null;
    },

    async init() {
      // 优先级: 有 redeemable position 的 agent > 只有钱包的 agent
      // (避免选错 agent 后钱卡在另一个账户里看不到)
      const opts = Array.from(document.querySelectorAll('select[x-model="selectedAgent"] option'));
      let redeemableAgent = null;
      let walletAgent = null;
      for (const opt of opts) {
        try {
          const wRes = await fetch('/api/predictions/wallet?relay_node_id=' + opt.value);
          const wData = await wRes.json();
          if (!wData.hasWallet) continue;
          if (!walletAgent) walletAgent = opt.value;
          const pRes = await fetch('/api/predictions/positions?relay_node_id=' + opt.value);
          const pData = await pRes.json();
          const hasRedeemable = (pData.settled || []).some(p => p.redeemable && !p._redeemed);
          if (hasRedeemable) { redeemableAgent = opt.value; break; }
        } catch (e) { console.warn('[init] probe failed for', opt.value, e.message); }
      }
      this.selectedAgent = redeemableAgent || walletAgent || this.selectedAgent;
      console.log('[init] selectedAgent =', this.selectedAgent, redeemableAgent ? '(has redeemable)' : '(wallet only)');
      await Promise.all([this.loadMarkets(), this.loadWalletStatus(), this.loadBettor()]);
      if (this.walletStatus.hasClobKey) this.loadPositionsAll();
    },

    // ── Bettor (Phase 3a) — per-agent scan via selectedAgent's adapter ──────
    async loadBettor() {
      try {
        const url = '/api/bettor/recommendations?limit=10' + (this.selectedAgent ? '&relay_node_id=' + this.selectedAgent : '');
        const r = await fetch(url);
        this.bettorRecs = await r.json();
        // Bug U1 Layer 2 defensive (J1 #208 Hypothesis 9 originally proposed + Bettor r135 越界 ship
        // 83071f9ca confirms via Owner Ctrl+Shift+R 仍 🚫 post Layer 1 SVG circles 删):
        // Alpine x-for :key="r.id" 可能复用 stale _accepting=true proxy state across loadBettor refreshes
        // (same rec id between scans → DOM/proxy preserved → stale field stays).
        // Explicit reset cleans 🚫 cursor stuck after prior failed/hung accept attempts.
        (this.bettorRecs?.recommendations || []).forEach(rec => {
          rec._accepting = false;
          rec._acceptError = null;
          rec._acceptSuccess = null;
        });
      } catch (e) {
        console.warn('[bettor] load failed:', e.message);
        this.bettorRecs = { recommendations: [] };
      }
      // Always load bettorHistory so close-all button visibility computes (any tab open)
      this.loadBettorHistory().catch(() => {});
      // Owner 5/16 + Bettor r141 — load variant 3-tier expander per rec (group by parent_rec_id)
      this.loadBettorVariants().catch(() => {});
    },

    // Phase 2.1c — Bettor r151 §3.B aggregate header (client-side computed)
    get portfolioAggregate() {
      const totalCost = (this.positions || []).reduce((s, p) => s + (p.totalCost || 0), 0);
      const currentValue = (this.positions || []).reduce((s, p) => s + (p.size || 0) * (p.curPrice || p.avgPrice || 0), 0);
      const pnl = currentValue - totalCost;
      const pnlPct = totalCost > 0 ? pnl / totalCost : 0;
      const maxAtSettle = (this.positions || []).reduce((s, p) => s + ((p.size || 0) - (p.totalCost || 0)), 0);
      return { totalCost, currentValue, pnl, pnlPct, maxAtSettle };
    },

    // Phase 2.1c — Bettor r151 §3.C: join protect rule by token_id == position.asset
    getProtectRuleFor(pos) {
      if (!this.bettorProtectRules?.rules) return null;
      return this.bettorProtectRules.rules.find(r => r.token_id === pos.asset && (r.status === 'pending_owner_ack' || r.status === 'active'));
    },
    // Phase 2.1c — Bettor r151 §3.D: join adjustment by condition_id; hide if none
    getAdjustmentFor(pos) {
      if (!this.bettorAdjustments?.adjustments) return null;
      return this.bettorAdjustments.adjustments.find(a => a.condition_id === pos.market || a.market === pos.market);
    },
    // Phase 2.1c — Bettor r151 §3.C: modal edit form for protect rule thresholds
    openProtectEditModal(rule) {
      if (!rule) return;
      this.protectEditModal = rule;
      this.protectEditForm = {
        stop_loss_pct: rule.stop_loss_pct ?? -0.30,
        cooldown_hours: rule.cooldown_hours ?? 12,
        take_profit_price: rule.take_profit_price ?? 0.95,
        time_close_days: rule.time_close_days ?? 60,
      };
    },
    closeProtectEditModal() { this.protectEditModal = null; },
    async saveProtectEditModal() {
      if (!this.protectEditModal) return;
      try {
        await fetch('/api/bettor/position-protect/rules/' + this.protectEditModal.id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(this.protectEditForm),
        });
        await this.loadBettorProtectRules();
        this.closeProtectEditModal();
      } catch (e) {
        console.warn('[bettor] save protect edit failed:', e.message);
      }
    },
    // Phase 2.1c — Bettor r152 §2: reactor stale watcher (warning amber if > 2h)
    async loadReactorStale() {
      try {
        const r = await fetch('/api/bettor/reactor/last-tick');
        const j = await r.json();
        if (j.last_tick) {
          const ms = Date.now() - new Date(j.last_tick).getTime();
          this.reactorStaleHours = ms / 3600000;
        } else this.reactorStaleHours = 0;
      } catch { this.reactorStaleHours = 0; }
    },

    // Phase 2.3 r161-r162 — client-side classifyStrategy fallback for existing recs (strategy column NULL pre-v116)
    // Mirrors server bettor-scavenger.js classifyStrategy(). KISS V1.
    classifyStrategyClient(rec) {
      const q = (rec.question || '').toLowerCase();
      const yesPrice = Number(rec.yes_price || 0);
      const noPrice = 1 - yesPrice;
      const decision = (rec.decision || '').toUpperCase();
      const endDate = rec.end_date;
      const daysToSettle = endDate ? (new Date(endDate).getTime() - Date.now()) / 86400000 : 999;
      if (daysToSettle <= 7 && decision === 'NO' && noPrice >= 0.80) return 'scavenger_carrion';
      if (/(election|primary|governor|president|senate|congress)/.test(q) && (yesPrice > 0.90 || yesPrice < 0.10)) return 'scavenger_election_locked';
      if (/top[\s-]*\d+/.test(q)) return 'scavenger_topN_rank';
      if (/(win the|champion|winner|mvp|trophy)/.test(q) && yesPrice >= 0.20 && yesPrice <= 0.80) return 'scavenger_competitive';
      return 'scavenger_main';
    },

    async loadBettorVariants() {
      try {
        const url = '/api/bettor/variant-recommendations' + (this.selectedAgent ? '?relay_node_id=' + this.selectedAgent : '');
        const r = await fetch(url);
        const data = await r.json();
        const byParent = {};
        // R-ALPINE-UI-2 defensive: reset client-side ephemeral _accepting per Alpine x-for stale proxy
        for (const v of data.variants || []) {
          v._accepting = false;
          v._acceptError = null;
          if (!byParent[v.parent_rec_id]) byParent[v.parent_rec_id] = [];
          byParent[v.parent_rec_id].push(v);
        }
        this.bettorVariants = byParent;
      } catch (e) {
        console.warn('[bettor] variants load failed:', e.message);
        this.bettorVariants = {};
      }
    },

    async acceptBettorVariant(variant) {
      // Phase 2 r146 — accept variant: POST /variant-recommendation/:id/accept → INSERT new rec + sibling supersede,
      // then trigger /recommendation/:new_id/accept for Polymarket order fire (confirm dialog appears).
      console.log('[acceptBettorVariant] variant=', variant?.id?.slice(0,8), 'tier=', variant?.strategy_tier);
      const sizeUsd = 200;  // default size, Phase 2.1 may allow Owner UI override
      const confirmed = confirm(`接受变种 ${variant.strategy_tier} ${variant.side}?\n${variant.market_slug?.slice(0, 80)}\nyes ${(variant.current_price * 100).toFixed(1)}% / EV ${((variant.ev_per_dollar || 0) * 100).toFixed(1)}% / $${sizeUsd}\n\n点 OK 创建 rec, 再 ACCEPT 触发 Polymarket order`);
      if (!confirmed) return;
      variant._accepting = true; variant._acceptError = null;
      try {
        const res = await fetch('/api/bettor/variant-recommendation/' + variant.id + '/accept', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}),
        });
        const data = await res.json();
        if (data.ok) {
          variant.status = 'accepted';
          await this.loadBettorVariants();
          await this.loadBettor();  // refresh primary rec list (new variant_accept rec INSERT)
          alert(`变种 promoted to recommendation:\nnew_rec_id=${data.new_rec_id?.slice(0,8)}\n现刷新推荐列表, 在新 rec 上点 ACCEPT 触发 Polymarket 下单`);
        } else {
          variant._acceptError = data.error || 'unknown error';
        }
      } catch (e) {
        variant._acceptError = e.message;
      } finally {
        variant._accepting = false;
      }
    },

    async bettorScan() {
      if (this.bettorScanning) return;
      this.bettorScanning = true;
      try {
        const r = await fetch('/api/bettor/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trigger_type: 'manual', relay_node_id: this.selectedAgent }),
        });
        const j = await r.json();
        if (!j.ok) console.log('[bettor] scan trigger response:', j.reason);
        for (let i = 0; i < 240; i++) {
          await new Promise(res => setTimeout(res, 5000));
          const sRes = await fetch('/api/bettor/scan/status');
          const sJ = await sRes.json();
          if (!sJ.running) break;
        }
        await this.loadBettor();
      } catch (e) {
        console.error('[bettor] scan failed:', e.message);
      } finally {
        this.bettorScanning = false;
      }
    },


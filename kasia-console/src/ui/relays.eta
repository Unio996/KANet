<%~ include('partials/page-open', { _page: 'relays', pageTitle: it.t.page_relays, ...it }) %>

      <div class="p-6">
      <div class="max-w-3xl mx-auto space-y-6">

        <!-- ═══ Node Configuration ═══ -->
        <div class="bg-white rounded-lg border border-warm-200" x-data="{
          mode: '<%= it.rpcMode %>',
          customUrl: '<%= it.rpcMode === 'custom' ? it.rpcUrl : '' %>',
          discoveredUrl: '<%= it.rpcMode === 'discovered' ? it.rpcUrl : '' %>',
          nodes: [],
          discovering: false,
          testing: false,
          testResult: null,
          get activeUrl() {
            if (this.mode === 'local') return 'ws://127.0.0.1:17110';
            if (this.mode === 'discovered') return this.discoveredUrl;
            if (this.mode === 'custom') return this.customUrl;
            return '';
          },
          async discover() {
            this.discovering = true;
            this.nodes = [];
            try {
              const res = await fetch('/settings/node/discover', { method: 'POST' });
              this.nodes = await res.json();
            } catch {}
            this.discovering = false;
          },
          selectNode(url) {
            this.discoveredUrl = url;
            this.mode = 'discovered';
          },
          async testNode() {
            const url = this.activeUrl;
            if (!url) return;
            this.testing = true;
            this.testResult = null;
            try {
              const res = await fetch('/settings/node/test', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
              });
              this.testResult = await res.json();
            } catch (e) {
              this.testResult = { ok: false, error: e.message };
            }
            this.testing = false;
          }
        }">
          <div class="px-6 py-4 border-b border-warm-200 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <svg class="h-5 w-5 text-ink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
              <h2 class="text-sm font-semibold text-ink-600"><%= it.t.node_config %></h2>
            </div>
            <% if (it.rpcUrl) { %>
            <span class="text-xs text-ink-300 font-mono"><%= it.rpcUrl %></span>
            <% } %>
          </div>

          <form method="POST" action="/settings/node" class="px-6 py-5 space-y-4">

            <!-- Mode tabs -->
            <div class="flex space-x-2">
              <button type="button" @click="mode='local'" :class="mode==='local' ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'" class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors"><%= it.t.local_node %></button>
              <button type="button" @click="discover(); mode='discovered'" :class="mode==='discovered' ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'" class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors"><%= it.t.discover_nodes %></button>
              <button type="button" @click="mode='custom'" :class="mode==='custom' ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'" class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors"><%= it.t.custom_node %></button>
            </div>
            <input type="hidden" name="mode" :value="mode" />

            <!-- Local node -->
            <div x-show="mode==='local'" x-transition class="bg-green-50 border border-green-200 rounded-lg p-4">
              <div class="flex items-center space-x-2">
                <svg class="h-5 w-5 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-sm font-medium text-green-800"><%= it.t.local_node %></span>
                <span class="text-xs text-green-600 font-mono">ws://127.0.0.1:17110</span>
              </div>
              <p class="text-xs text-green-700 mt-1"><%= it.t.local_node_desc %></p>
            </div>

            <!-- Discover nodes -->
            <div x-show="mode==='discovered'" x-transition>
              <!-- Loading state -->
              <div x-show="discovering" class="flex items-center justify-center py-8 text-sm text-ink-400">
                <svg class="animate-spin h-5 w-5 mr-2 text-brand-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                <%= it.t.discovering %>
              </div>

              <!-- Node list -->
              <div x-show="!discovering && nodes.length > 0" class="space-y-1.5">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.available_nodes %></span>
                  <button type="button" @click="discover()" class="text-xs text-brand-500 hover:text-brand-700"><%= it.t.btn_refresh %></button>
                </div>
                <template x-for="node in nodes" :key="node.url">
                  <label class="flex items-center p-3 rounded-lg border cursor-pointer transition-colors"
                    :class="discoveredUrl === node.url ? 'border-brand-500 bg-brand-50' : 'border-warm-200 hover:border-warm-300'"
                    @click="selectNode(node.url)">
                    <input type="radio" name="discovered_url" :value="node.url" :checked="discoveredUrl === node.url" class="text-brand-500" />
                    <span class="ml-3 text-sm font-mono text-ink-600 flex-1 truncate" x-text="node.url"></span>
                    <span class="ml-2 text-xs font-medium px-2 py-0.5 rounded-full"
                      :class="node.latency < 50 ? 'bg-green-100 text-green-700' : node.latency < 100 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'"
                      x-text="node.latency + 'ms'"></span>
                  </label>
                </template>
              </div>

              <!-- No results -->
              <div x-show="!discovering && nodes.length === 0" class="text-center py-6 text-sm text-ink-300">
                <button type="button" @click="discover()" class="px-4 py-2 bg-brand-500 text-white rounded-md hover:bg-brand-600 text-sm"><%= it.t.btn_discover %></button>
              </div>
            </div>

            <!-- Custom URL -->
            <div x-show="mode==='custom'" x-transition>
              <input type="text" name="custom_url" x-model="customUrl" placeholder="ws://hostname:port  /  wss://hostname/path"
                class="w-full px-3 py-2 border border-warm-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>

            <!-- Current + test -->
            <div class="bg-warm-100 rounded-lg p-3 flex items-center justify-between" x-show="activeUrl">
              <div class="min-w-0 flex-1">
                <span class="text-xs text-ink-400"><%= it.t.current_node %></span>
                <p class="text-sm font-mono text-ink-700 truncate" x-text="activeUrl"></p>
              </div>
              <div class="flex items-center space-x-2 ml-3 flex-shrink-0">
                <template x-if="testResult && testResult.ok">
                  <span class="text-xs text-green-600 font-medium" x-text="testResult.latency + 'ms'"></span>
                </template>
                <template x-if="testResult && !testResult.ok">
                  <span class="text-xs text-red-600 font-medium">FAIL</span>
                </template>
                <button type="button" @click="testNode()" :disabled="testing"
                  class="px-2.5 py-1 text-xs font-medium rounded transition-colors"
                  :class="testing ? 'bg-warm-200 text-ink-300' : 'bg-warm-200 text-ink-600 hover:bg-warm-300'">
                  <span x-show="!testing"><%= it.t.btn_test %></span>
                  <span x-show="testing">...</span>
                </button>
              </div>
            </div>

            <!-- Save -->
            <div class="flex justify-end">
              <button type="submit" class="px-5 py-2 bg-brand-500 text-white text-sm font-medium rounded-md hover:bg-brand-600 transition-colors"><%= it.t.btn_save %></button>
            </div>
          </form>
        </div>

        <!-- ═══ Relay list ═══ -->
        <% if (it.relays.length === 0) { %>
        <div class="bg-white rounded-lg border border-warm-200 px-6 py-10 text-center text-sm text-ink-300">
          <%= it.t.no_relays %>
        </div>
        <% } else { %>
        <div class="space-y-3">
          <% it.relays.forEach(function(r) { %>
          <div class="bg-white rounded-lg border border-warm-200 p-5">
            <div class="flex items-start justify-between">
              <div class="flex items-center space-x-3">
                <span class="text-base font-semibold text-ink-700"><%= r.name %></span>
                <% if (r.mnemonic_hint) { %>
                <span class="text-xs text-ink-300 bg-warm-100 px-2 py-0.5 rounded mnemonic-hint-<%= r.id %>"><%= r.mnemonic_hint %></span>
                <button onclick="revealMnemonic('<%= r.id %>')" class="text-xs text-brand-500 hover:text-brand-700 mnemonic-btn-<%= r.id %>"><%= it.t.btn_reveal || 'Reveal' %></button>
                <% } %>
              </div>
              <!-- Mnemonic reveal area (hidden until clicked) -->
              <div class="hidden mt-2 p-3 bg-amber-50 border border-amber-200 rounded-lg mnemonic-area-<%= r.id %>">
                <div class="flex items-center justify-between">
                  <code class="text-sm font-mono text-amber-900 select-all mnemonic-text-<%= r.id %>"></code>
                  <button onclick="copyMnemonic('<%= r.id %>')" class="ml-3 text-xs px-3 py-1 bg-amber-200 text-amber-800 rounded hover:bg-amber-300 flex-shrink-0 mnemonic-copy-<%= r.id %>"><%= it.t.btn_copy || 'Copy' %></button>
                </div>
              </div>
              <form method="POST" action="/relays/<%= r.id %>/delete" onsubmit="return confirm('<%= it.t.confirm_pre %>' + '<%= r.name %>' + '<%= it.t.confirm_post %>')">
                <button type="submit" class="text-xs text-red-500 hover:text-red-700"><%= it.t.btn_delete %></button>
              </form>
            </div>

            <!-- Mind info: vision + style -->
            <% if (r.mind_vision || r.mind_style) { %>
            <div class="mt-3 space-y-1">
              <% if (r.mind_vision) { %>
              <div class="text-sm text-ink-400 italic">"<%= r.mind_vision %>"</div>
              <% } %>
              <% if (r.mind_style) { %>
              <div class="text-xs text-ink-300"><%= r.mind_style %></div>
              <% } %>
            </div>
            <% } %>

            <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
              <div>
                <span class="text-ink-300"><%= it.t.col_address %></span>
                <% if (r.address) { %>
                <span class="font-mono text-ink-600 ml-2 text-xs break-all"><%= r.address %></span>
                <button onclick="navigator.clipboard.writeText('<%= r.address %>');this.textContent='OK';setTimeout(()=>this.textContent='<%= it.t.btn_copy || 'Copy' %>',1200)"
                  class="ml-1.5 px-1.5 py-0.5 text-xs text-ink-300 hover:text-brand-500 bg-warm-100 hover:bg-brand-50 rounded transition-colors flex-shrink-0"><%= it.t.btn_copy || 'Copy' %></button>
                <button onclick="openTransfer('<%= r.id %>', '<%= r.name %>')"
                  class="ml-1 px-1.5 py-0.5 text-xs text-ink-300 hover:text-orange-600 bg-warm-100 hover:bg-orange-50 rounded transition-colors flex-shrink-0"><%= it.t.btn_withdraw || 'Withdraw' %></button>
                <% } else { %>
                <span class="text-ink-200 ml-2"><%= it.t.not_configured %></span>
                <% } %>
              </div>
              <div><span class="text-ink-300"><%= it.t.label_network %></span> <span class="ml-2 text-ink-600"><%= r.network %></span></div>
              <% if (r.address) { %>
              <div x-data="{ balance: null, loading: true }" x-init="
                fetch('/api/relay/<%= r.id %>/balance').then(r=>r.json()).then(d=>{ balance=d.balance; loading=false }).catch(()=>{ loading=false })
              ">
                <span class="text-ink-300">Balance</span>
                <span class="ml-2 text-ink-600" x-show="loading">...</span>
                <span class="ml-2 font-medium" x-show="!loading && balance !== null" :class="balance > 0 ? 'text-green-600' : 'text-ink-300'" x-text="balance !== null ? (balance + ' KAS') : ''"></span>
                <span class="ml-2 text-ink-300 text-xs" x-show="!loading && balance === null">unavailable</span>
              </div>
              <% } %>
              <div>
                <span class="text-ink-300"><%= it.t.col_adapter %></span>
                <% if (r.adapter_name) { %>
                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">
                  <%= r.adapter_name %> (:<%= r.adapter_port %>)
                </span>
                <% } else { %>
                <span class="ml-2 text-yellow-600 text-xs"><%= it.t.unassigned %></span>
                <% } %>
              </div>
            </div>

            <!-- Assign adapter -->
            <form method="POST" action="/relays/<%= r.id %>/assign" class="mt-4 flex items-center space-x-2">
              <select name="adapter_node_id" class="flex-1 px-3 py-1.5 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                <option value=""><%= it.t.no_adapter_opt %></option>
                <% it.adapters.forEach(function(a) { %>
                <option value="<%= a.id %>" <%= r.adapter_node_id === a.id ? 'selected' : '' %>>
                  <%= a.name %> (:<%= a.http_port %>)
                </option>
                <% }) %>
              </select>
              <button type="submit" class="px-3 py-1.5 bg-warm-100 text-ink-600 text-sm rounded-md hover:bg-warm-200"><%= it.t.btn_update_map %></button>
            </form>

            <!-- ── Agent Card ── -->
            <% if (r.address) { %>
            <div class="mt-4 pt-4 border-t border-warm-100" x-data="{
              card: null,
              skills: [],
              editing: false,
              publishing: false,
              published: false,
              error: '',
              form: { name: '', entityType: 'agent', summary: '', mode: 'public' },
              async init() {
                try {
                  const res = await fetch('/api/relay/<%= r.id %>/card');
                  const data = await res.json();
                  this.card = data.card;
                  this.skills = data.skills || [];
                  if (this.card) {
                    this.form.name = this.card.summary ? '<%= r.name %>' : '<%= r.name %>';
                    this.form.entityType = this.card.entityType || 'agent';
                    this.form.summary = this.card.summary || '';
                    this.form.mode = this.card.mode || 'public';
                  }
                } catch {}
              },
              startEdit() {
                if (!this.form.name) this.form.name = '<%= r.name %>';
                this.editing = true;
                this.error = '';
                this.published = false;
              },
              async publish() {
                this.publishing = true;
                this.error = '';
                try {
                  const res = await fetch('/api/relay/<%= r.id %>/publish-card', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.form)
                  });
                  const data = await res.json();
                  if (!res.ok) throw new Error(data.error || 'Failed');
                  this.card = { ...this.form, latestTx: data.txId, skills: this.skills, timestamp: Math.floor(Date.now()/1000) };
                  this.editing = false;
                  this.published = data.txId;
                } catch (e) {
                  this.error = e.message;
                }
                this.publishing = false;
              }
            }">
              <!-- Card: not published yet -->
              <template x-if="!card && !editing">
                <div class="flex items-center justify-between">
                  <div class="text-sm text-ink-300">
                    <span>On-Chain Identity</span>
                    <span class="ml-2 text-xs">— not published</span>
                  </div>
                  <button @click="startEdit()" class="px-3 py-1.5 text-xs font-medium text-purple-600 bg-purple-50 rounded-md hover:bg-purple-100 transition-colors">
                    <%= it.t.btn_setup_card || 'Set Up Agent Card' %>
                  </button>
                </div>
              </template>

              <!-- Card: published (view mode) -->
              <template x-if="card && !editing">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center space-x-2">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">KANet Agent</span>
                      <span class="text-xs text-ink-300" x-text="card.mode"></span>
                    </div>
                    <div class="flex items-center space-x-2">
                      <button @click="startEdit()" class="text-xs text-brand-500 hover:text-brand-700">Edit</button>
                      <a x-show="card.latestTx" :href="KANet.explorerTxUrl('kaspa', card.latestTx)" target="_blank" class="text-xs text-ink-300 hover:text-ink-500">View TX</a>
                    </div>
                  </div>
                  <div class="text-sm font-medium text-ink-700" x-text="form.name || card.entityType"></div>
                  <div class="text-xs text-ink-400 mt-0.5" x-show="card.summary" x-text="card.summary"></div>
                  <div class="flex flex-wrap gap-1 mt-2" x-show="skills.length > 0 || (card.skills && card.skills.length > 0)">
                    <template x-for="s in (card.skills && card.skills.length > 0 ? card.skills : skills)" :key="s">
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-blue-50 text-blue-600" x-text="s"></span>
                    </template>
                  </div>
                </div>
              </template>

              <!-- Published success banner -->
              <div x-show="published" x-transition class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-xs text-green-700">
                Card published! TX: <span class="font-mono" x-text="published"></span>
              </div>

              <!-- Edit form -->
              <template x-if="editing">
                <div class="space-y-3 mt-2">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-ink-600">Agent Card</span>
                    <button @click="editing=false" class="text-xs text-ink-300 hover:text-ink-500"><%= it.t.btn_cancel || 'Cancel' %></button>
                  </div>

                  <!-- Visibility -->
                  <div class="flex space-x-2">
                    <template x-for="m in ['public','mixed','private']" :key="m">
                      <button type="button" @click="form.mode = m"
                        class="px-3 py-1 text-xs font-medium rounded-md transition-colors"
                        :class="form.mode === m ? 'bg-purple-600 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'"
                        x-text="m">
                      </button>
                    </template>
                  </div>

                  <div>
                    <label class="block text-xs text-ink-400 mb-1">Name</label>
                    <input type="text" x-model="form.name" placeholder="Agent name"
                      class="w-full px-3 py-1.5 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
                  </div>

                  <div>
                    <label class="block text-xs text-ink-400 mb-1">Type</label>
                    <div class="flex space-x-3">
                      <template x-for="t in ['agent','human','service','org']" :key="t">
                        <label class="flex items-center space-x-1 text-sm text-ink-500 cursor-pointer">
                          <input type="radio" :value="t" x-model="form.entityType" class="text-purple-600" />
                          <span x-text="t"></span>
                        </label>
                      </template>
                    </div>
                  </div>

                  <div>
                    <label class="block text-xs text-ink-400 mb-1">Summary <span class="text-ink-200">(optional, 280 chars)</span></label>
                    <input type="text" x-model="form.summary" maxlength="280" placeholder="Short description"
                      class="w-full px-3 py-1.5 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
                  </div>

                  <!-- Skills preview -->
                  <div>
                    <div class="flex items-center justify-between">
                      <label class="block text-xs text-ink-400">Skills (from account)</label>
                      <a href="/skills?account=<%= r.id %>" class="text-xs text-brand-500 hover:text-brand-700">Manage</a>
                    </div>
                    <div class="flex flex-wrap gap-1 mt-1" x-show="skills.length > 0">
                      <template x-for="s in skills" :key="s">
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-blue-50 text-blue-600" x-text="s"></span>
                      </template>
                    </div>
                    <span class="text-xs text-ink-200" x-show="skills.length === 0">No active skills</span>
                  </div>

                  <!-- Error -->
                  <div x-show="error" class="text-xs text-red-600" x-text="error"></div>

                  <!-- Publish button -->
                  <div class="flex items-center justify-between pt-1">
                    <span class="text-xs text-ink-300">Writes to Kaspa blockchain (costs ~0.2 KAS)</span>
                    <button @click="publish()" :disabled="publishing || !form.name.trim()"
                      class="px-4 py-1.5 text-sm font-medium rounded-md transition-colors"
                      :class="publishing ? 'bg-warm-300 text-ink-400' : 'bg-purple-600 text-white hover:bg-purple-700'">
                      <span x-show="!publishing" x-text="card ? 'Update on Chain' : 'Publish to Chain'"></span>
                      <span x-show="publishing">Publishing...</span>
                    </button>
                  </div>
                </div>
              </template>
            </div>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } %>

        <!-- ═══ Add Relay form ═══ -->
        <div class="bg-white rounded-lg border border-warm-200">
          <div class="px-6 py-4 border-b border-warm-200">
            <h2 class="text-sm font-semibold text-ink-600"><%= it.t.add_relay %></h2>
          </div>
          <form method="POST" action="/relays" class="px-6 py-5 space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-ink-500 mb-1"><%= it.t.label_name %></label>
                <input type="text" name="name" placeholder="Relay A" required
                  class="w-full px-3 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-ink-500 mb-1"><%= it.t.label_network %></label>
                <select name="network" class="w-full px-3 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="mainnet">mainnet</option>
                  <option value="testnet">testnet</option>
                </select>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-medium text-ink-500"><%= it.t.label_mnemonic %></label>
                <button type="button" onclick="generateMnemonic()"
                  class="text-xs text-brand-500 hover:text-brand-700 font-medium"><%= it.t.btn_generate || 'Generate New' %></button>
              </div>
              <textarea name="mnemonic" id="mnemonic-input" rows="2" placeholder="<%= it.t.mnemonic_ph %>"
                class="w-full px-3 py-2 border border-warm-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-ink-500 mb-1"><%= it.t.label_addr_opt %></label>
                <input type="text" name="address" placeholder="kaspa:q..."
                  class="w-full px-3 py-2 border border-warm-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-ink-500 mb-1"><%= it.t.label_assign_adapter %></label>
                <select name="adapter_node_id" class="w-full px-3 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value=""><%= it.t.assign_later %></option>
                  <% it.adapters.forEach(function(a) { %>
                  <option value="<%= a.id %>"><%= a.name %> (:<%= a.http_port %>)</option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="px-5 py-2 bg-brand-500 text-white text-sm font-medium rounded-md hover:bg-brand-600"><%= it.t.btn_save %></button>
            </div>
          </form>
        </div>

      </div>
      </div>
<script>
async function revealMnemonic(id) {
  const res = await fetch('/relays/' + id + '/mnemonic');
  const { mnemonic } = await res.json();
  if (!mnemonic) return;
  document.querySelector('.mnemonic-text-' + id).textContent = mnemonic;
  document.querySelector('.mnemonic-area-' + id).classList.remove('hidden');
  document.querySelector('.mnemonic-btn-' + id).classList.add('hidden');
  document.querySelector('.mnemonic-hint-' + id).classList.add('hidden');
}
function copyMnemonic(id) {
  const text = document.querySelector('.mnemonic-text-' + id).textContent;
  navigator.clipboard.writeText(text);
  const btn = document.querySelector('.mnemonic-copy-' + id);
  btn.textContent = '<%= it.t.btn_copied || "Copied!" %>';
  setTimeout(() => { btn.textContent = '<%= it.t.btn_copy || "Copy" %>'; }, 1500);
}
async function generateMnemonic() {
  const network = document.querySelector('select[name="network"]').value || 'mainnet';
  const res = await fetch('/relays/generate-mnemonic', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ network })
  });
  const { mnemonic, address } = await res.json();
  if (mnemonic) {
    document.getElementById('mnemonic-input').value = mnemonic;
    const addrInput = document.querySelector('input[name="address"]');
    if (addrInput) addrInput.value = address || '';
  }
}

// ── Transfer / Withdraw ──
let _transferRelayId = null;
function openTransfer(relayId, name) {
  _transferRelayId = relayId;
  document.getElementById('transfer-agent-name').textContent = name;
  document.getElementById('transfer-to').value = '';
  document.getElementById('transfer-amount').value = '';
  document.getElementById('transfer-result').classList.add('hidden');
  document.getElementById('transfer-modal').classList.remove('hidden');
}
function closeTransfer() {
  document.getElementById('transfer-modal').classList.add('hidden');
}
async function submitTransfer() {
  const to = document.getElementById('transfer-to').value.trim();
  const amount = parseFloat(document.getElementById('transfer-amount').value);
  const resultEl = document.getElementById('transfer-result');
  const btn = document.getElementById('transfer-btn');

  if (!to || !amount || amount <= 0) { resultEl.textContent = 'Please enter address and amount'; resultEl.className = 'mt-3 text-sm text-red-600'; resultEl.classList.remove('hidden'); return; }

  btn.disabled = true; btn.textContent = 'Sending...';
  resultEl.classList.add('hidden');

  try {
    const res = await fetch('/api/relay/' + _transferRelayId + '/transfer', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ to, amount })
    });
    const data = await res.json();
    if (res.ok && data.ok) {
      let msg = 'Sent ' + amount + ' KAS';
      if (data.txId) msg += '\nTX: ' + data.txId;
      if (data.fee) msg += '\nFee: ' + data.fee + ' KAS';
      resultEl.innerHTML = '<div class="p-3 bg-green-50 border border-green-200 rounded-lg">'
        + '<div class="font-semibold text-green-700 mb-1">Transfer successful</div>'
        + '<div class="text-green-600 break-all whitespace-pre-line">' + msg + '</div></div>';
      resultEl.className = 'mt-3 text-sm';
      btn.disabled = true; btn.textContent = 'Done';
      document.getElementById('transfer-to').value = '';
      document.getElementById('transfer-amount').value = '';
    } else {
      resultEl.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-600">'
        + (data.error || 'Transfer failed (HTTP ' + res.status + ')') + '</div>';
      resultEl.className = 'mt-3 text-sm';
      btn.disabled = false; btn.textContent = '<%= it.t.btn_send || "Send" %>';
    }
  } catch (e) {
    resultEl.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-600">Network error: ' + e.message + '</div>';
    resultEl.className = 'mt-3 text-sm';
    btn.disabled = false; btn.textContent = '<%= it.t.btn_send || "Send" %>';
  }
  resultEl.classList.remove('hidden');
}
</script>

<!-- Transfer Modal -->
<div id="transfer-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md mx-4">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold"><%= it.t.btn_withdraw || 'Withdraw' %> — <span id="transfer-agent-name"></span></h3>
      <button onclick="closeTransfer()" class="text-ink-300 hover:text-ink-500 text-xl">&times;</button>
    </div>
    <div class="space-y-3">
      <div>
        <label class="block text-sm text-ink-400 mb-1"><%= it.t.col_address || 'To Address' %></label>
        <input id="transfer-to" type="text" placeholder="kaspa:q..."
          class="w-full px-3 py-2 border rounded-lg text-sm font-mono focus:ring-2 focus:ring-brand-300 focus:border-brand-400">
      </div>
      <div>
        <label class="block text-sm text-ink-400 mb-1">KAS</label>
        <input id="transfer-amount" type="number" step="0.01" min="0.01" placeholder="0.1"
          class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-brand-300 focus:border-brand-400">
      </div>
      <p class="text-xs text-ink-300">KIP-9: small UTXOs may send full balance instead of partial amount.</p>
    </div>
    <div id="transfer-result" class="hidden mt-3 text-sm"></div>
    <div class="mt-4 flex justify-end gap-2">
      <button onclick="closeTransfer()" class="px-4 py-2 text-sm text-ink-500 hover:bg-warm-100 rounded-lg"><%= it.t.btn_cancel || 'Cancel' %></button>
      <button id="transfer-btn" onclick="submitTransfer()" class="px-4 py-2 text-sm text-white bg-orange-500 hover:bg-orange-600 rounded-lg"><%= it.t.btn_send || 'Send' %></button>
    </div>
  </div>
</div>

<%~ include('partials/page-close', it) %>

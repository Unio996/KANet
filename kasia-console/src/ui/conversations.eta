<!DOCTYPE html>
<html lang="<%= it.t.html_lang %>" dir="<%= it.dir %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= it.t.page_conversations %> — KANet Console</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="flex h-screen bg-gray-100 font-sans">

  <!-- Sidebar -->
  <aside class="w-56 bg-gray-900 text-gray-100 flex flex-col flex-shrink-0">
    <div class="px-4 py-4 border-b border-gray-700 flex items-center space-x-3">
      <img src="/public/kanet-logo.png" alt="KANet" class="h-8 w-8 object-contain flex-shrink-0" />
      <span class="text-base font-bold tracking-wide text-white leading-tight">KANet<br/><span class="text-xs font-normal text-gray-400">Console</span></span>
    </div>
    <nav class="flex-1 py-4 space-y-1 px-3 overflow-y-auto">
      <a href="/agent" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        我的 Agent
      </a>
      <a href="/conversations" class="flex items-center px-3 py-2 rounded-md text-sm font-medium bg-gray-700 text-white">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
        会话
      </a>
      <a href="/identities" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        通讯录
      </a>
      <a href="/network" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
        网络
      </a>
      <a href="/chat" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        聊天
      </a>
      <div class="pt-4 border-t border-gray-700 mt-4 space-y-1">
        <a href="/events" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          活动日志
        </a>
        <div class="flex items-center px-3 py-2 text-xs font-medium text-gray-500 uppercase tracking-wider">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          系统设置
        </div>
        <a href="/relays" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors pl-9">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
          账户管理
        </a>
        <a href="/adapters" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors pl-9">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          AI 引擎
        </a>
      </div>
    </nav>
    <div class="px-3 pb-2">
      <form method="POST" action="/lang">
        <select name="lang" onchange="this.form.submit()"
          class="w-full bg-gray-800 text-gray-200 text-xs rounded px-2 py-1.5 border border-gray-700 focus:outline-none cursor-pointer">
          <% Object.entries(it.langs).forEach(function([code, label]) { %>
          <option value="<%= code %>" <%= it.lang === code ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </form>
    </div>
    <div class="px-5 py-3 border-t border-gray-700 text-xs text-gray-500">
      KANet Console v0.1
    </div>
  </aside>

  <!-- Main content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top bar -->
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between flex-shrink-0">
      <h1 class="text-xl font-semibold text-gray-800"><%= it.t.page_conversations %></h1>
      <span class="text-sm text-gray-500">KANet Console</span>
    </header>

    <!-- Page content -->
    <main class="flex-1 overflow-y-auto p-6">

      <!-- Search bar -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-4">
        <form method="GET" action="/conversations" class="flex gap-3">
          <div>
            <select name="account" onchange="this.form.submit()"
              class="px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value=""><%= it.t.label_all_accounts || 'All' %></option>
              <% it.relayNodes.forEach(function(r) { %>
              <option value="<%= r.id %>" <%= it.selectedAccount === r.id ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="flex-1 relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input
              type="text"
              name="search"
              value="<%= it.search || '' %>"
              placeholder="<%= it.t.search_placeholder %>"
              class="w-full pl-9 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors">
            <%= it.t.btn_search %>
          </button>
          <% if (it.search) { %>
          <a href="/conversations" class="px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors">
            <%= it.t.btn_clear %>
          </a>
          <% } %>
        </form>
      </div>

      <!-- Conversations table -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.col_contact %></th>
              <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.col_network %></th>
              <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.col_status %></th>
              <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.col_last_msg %></th>
              <th class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.col_msg_count %></th>
              <th class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.col_actions %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% if (!it.conversations || it.conversations.length === 0) { %>
            <tr>
              <td colspan="6" class="px-5 py-10 text-center text-sm text-gray-400">
                <% if (it.search) { %>
                <%= it.t.no_match_pre %><%= it.search %><%= it.t.no_match_post %>
                <% } else { %>
                <%= it.t.no_convs_found %>
                <% } %>
              </td>
            </tr>
            <% } else { %>
            <% it.conversations.forEach(function(conv) { %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-5 py-3">
                <div>
                  <p class="text-sm font-medium text-gray-800"><%= conv.remote_name || it.t.unnamed %></p>
                  <p class="text-xs text-gray-400 font-mono truncate max-w-[200px]" title="<%= conv.remote_address %>"><%= conv.remote_address %></p>
                </div>
              </td>
              <td class="px-5 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700"><%= conv.network || 'mainnet' %></span>
              </td>
              <td class="px-5 py-3">
                <% if (conv.status === 'active') { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
                  <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-green-500"></span><%= it.t.status_active %>
                </span>
                <% } else if (conv.status === 'pending') { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700">
                  <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-yellow-500"></span><%= it.t.status_pending %>
                </span>
                <% } else { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                  <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-gray-400"></span><%= conv.status %>
                </span>
                <% } %>
              </td>
              <td class="px-5 py-3 text-sm text-gray-500">
                <% if (conv.last_message_at) { %>
                <span title="<%= it.fmtDate(conv.last_message_at) %>"><%= it.relativeTime(conv.last_message_at) %></span>
                <% } else { %>
                <span class="text-gray-300">—</span>
                <% } %>
              </td>
              <td class="px-5 py-3 text-right text-sm text-gray-700 font-medium"><%= conv.message_count || 0 %></td>
              <td class="px-5 py-3 text-right">
                <a href="/conversations/<%= conv.id %>" class="text-sm text-blue-600 hover:text-blue-800 font-medium"><%= it.t.btn_view %></a>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination -->
        <% if (it.totalPages && it.totalPages > 1) { %>
        <div class="px-5 py-3 border-t border-gray-200 flex items-center justify-between text-sm text-gray-600">
          <span><%= it.t.pg_page %> <%= it.page %> <%= it.t.pg_of %> <%= it.totalPages %><%= it.t.pg_suffix %><%= it.t.pg_comma_total %> <%= it.totalCount %> <%= it.t.pg_records %></span>
          <div class="flex gap-2">
            <% if (it.page > 1) { %>
            <a href="/conversations?page=<%= it.page - 1 %><%= it.search ? '&search=' + it.search : '' %>" class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50"><%= it.t.btn_prev %></a>
            <% } %>
            <% if (it.page < it.totalPages) { %>
            <a href="/conversations?page=<%= it.page + 1 %><%= it.search ? '&search=' + it.search : '' %>" class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50"><%= it.t.btn_next %></a>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>

    </main>
  </div>

</body>
</html>

<%~ include('partials/page-open', { _page: 'conversations', pageTitle: it.t.page_conversations, ...it }) %>

<script src="https://unpkg.com/htmx.org@1.9.10"></script>

      <div class="p-6">
      <!-- Search bar -->
      <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4 mb-4">
        <form method="GET" action="/conversations" class="flex gap-3">
          <div>
            <select name="account" onchange="this.form.submit()"
              class="px-3 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value=""><%= it.t.label_all_accounts || 'All' %></option>
              <% it.relayNodes.forEach(function(r) { %>
              <option value="<%= r.id %>" <%= it.selectedAccount === r.id ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="flex-1 relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-ink-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input
              type="text"
              name="search"
              value="<%= it.search || '' %>"
              placeholder="<%= it.t.search_placeholder %>"
              class="w-full pl-9 pr-4 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            />
          </div>
          <button type="submit" class="px-4 py-2 bg-brand-500 text-white text-sm font-medium rounded-md hover:bg-brand-600 transition-colors">
            <%= it.t.btn_search %>
          </button>
          <% if (it.search) { %>
          <a href="/conversations" class="px-4 py-2 bg-warm-100 text-ink-600 text-sm font-medium rounded-md hover:bg-warm-200 transition-colors">
            <%= it.t.btn_clear %>
          </a>
          <% } %>
        </form>
      </div>

      <!-- Conversations table -->
      <div class="bg-white rounded-lg shadow-sm border border-warm-200 overflow-hidden">
        <table class="min-w-full divide-y divide-warm-200">
          <thead class="bg-warm-100">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_contact %></th>
              <th class="px-5 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_network %></th>
              <th class="px-5 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_status %></th>
              <th class="px-5 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_last_msg %></th>
              <th class="px-5 py-3 text-right text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_msg_count %></th>
              <th class="px-5 py-3 text-right text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_actions %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-warm-100">
            <% if (!it.conversations || it.conversations.length === 0) { %>
            <tr>
              <td colspan="6" class="px-5 py-10 text-center text-sm text-ink-300">
                <% if (it.search) { %>
                <%= it.t.no_match_pre %><%= it.search %><%= it.t.no_match_post %>
                <% } else { %>
                <%= it.t.no_convs_found %>
                <% } %>
              </td>
            </tr>
            <% } else { %>
            <% it.conversations.forEach(function(conv) { %>
            <tr class="hover:bg-warm-100 transition-colors">
              <td class="px-5 py-3">
                <div>
                  <p class="text-sm font-medium text-ink-700"><%= conv.remote_name || it.t.unnamed %></p>
                  <p class="text-xs text-ink-300 font-mono truncate max-w-[200px]" title="<%= conv.remote_address %>"><%= conv.remote_address %></p>
                </div>
              </td>
              <td class="px-5 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700"><%= conv.network || 'mainnet' %></span>
              </td>
              <td class="px-5 py-3">
                <% if (conv.status === 'active') { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
                  <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-green-500"></span><%= it.t.status_active %>
                </span>
                <% } else if (conv.status === 'pending') { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700">
                  <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-yellow-500"></span><%= it.t.status_pending %>
                </span>
                <% } else { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-warm-100 text-ink-500">
                  <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-ink-300"></span><%= conv.status %>
                </span>
                <% } %>
              </td>
              <td class="px-5 py-3 text-sm text-ink-400">
                <% if (conv.last_message_at) { %>
                <span title="<%= it.fmtDate(conv.last_message_at) %>"><%= it.relativeTime(conv.last_message_at) %></span>
                <% } else { %>
                <span class="text-ink-200">—</span>
                <% } %>
              </td>
              <td class="px-5 py-3 text-right text-sm text-ink-600 font-medium"><%= conv.message_count || 0 %></td>
              <td class="px-5 py-3 text-right">
                <a href="/conversations/<%= conv.id %>" class="text-sm text-brand-500 hover:text-brand-700 font-medium"><%= it.t.btn_view %></a>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination -->
        <% if (it.totalPages && it.totalPages > 1) { %>
        <div class="px-5 py-3 border-t border-warm-200 flex items-center justify-between text-sm text-ink-500">
          <span><%= it.t.pg_page %> <%= it.page %> <%= it.t.pg_of %> <%= it.totalPages %><%= it.t.pg_suffix %><%= it.t.pg_comma_total %> <%= it.totalCount %> <%= it.t.pg_records %></span>
          <div class="flex gap-2">
            <% if (it.page > 1) { %>
            <a href="/conversations?page=<%= it.page - 1 %><%= it.search ? '&search=' + it.search : '' %>" class="px-3 py-1 rounded border border-warm-300 hover:bg-warm-100"><%= it.t.btn_prev %></a>
            <% } %>
            <% if (it.page < it.totalPages) { %>
            <a href="/conversations?page=<%= it.page + 1 %><%= it.search ? '&search=' + it.search : '' %>" class="px-3 py-1 rounded border border-warm-300 hover:bg-warm-100"><%= it.t.btn_next %></a>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      </div>

<%~ include('partials/page-close', it) %>

<%~ include('partials/page-open', { _page: 'agent', pageTitle: '', ...it }) %>

<div class="p-6" x-data="agentHistoryPage()" x-init="init()" x-cloak>

  <!-- Header -->
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
      <h1 class="text-lg font-semibold text-ink-700">Agent 历史记录</h1>
      <select x-model="selectedAgent" @change="loadEpisodes()" class="rounded-lg border border-warm-300 px-3 py-2 text-sm bg-white">
        <% it.relayNodes.forEach(r => { %>
        <option value="<%= r.id %>"><%= r.name %></option>
        <% }) %>
      </select>
    </div>
    <button @click="loadEpisodes()" class="flex items-center gap-1.5 px-3 py-2 text-sm text-ink-500 hover:text-brand-600 bg-white border border-warm-300 rounded-lg transition-colors" :class="loading ? 'opacity-50 pointer-events-none' : ''">
      <svg class="w-4 h-4" :class="loading ? 'animate-spin' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      <span>刷新</span>
    </button>
  </div>

  <!-- Status filter bar -->
  <div class="flex items-center gap-2 mb-5">
    <template x-for="f in [{id:'all',l:'全部'},{id:'in_progress',l:'进行中'},{id:'completed',l:'已完成'},{id:'cancelled',l:'已取消'},{id:'disputed',l:'争议中'}]" :key="f.id">
      <button @click="statusFilter = f.id"
        class="px-3 py-1.5 text-xs font-medium rounded-full border transition-colors"
        :class="statusFilter === f.id
          ? 'bg-brand-500 text-white border-brand-500'
          : 'bg-white text-ink-500 border-warm-300 hover:border-brand-300 hover:text-brand-600'"
        x-text="f.l"></button>
    </template>
    <span class="ml-2 text-xs text-ink-300" x-show="!loading" x-text="filteredEpisodes.length + ' 条记录'"></span>
  </div>

  <!-- Loading skeleton -->
  <div x-show="loading" class="space-y-3">
    <div class="card text-center py-8">
      <div class="skeleton mx-auto mb-2" style="width:160px;height:14px;"></div>
      <div class="skeleton mx-auto" style="width:100px;height:10px;"></div>
    </div>
    <div class="card text-center py-6">
      <div class="skeleton mx-auto mb-2" style="width:200px;height:14px;"></div>
      <div class="skeleton mx-auto" style="width:140px;height:10px;"></div>
    </div>
  </div>

  <!-- Episode cards -->
  <div x-show="!loading" class="space-y-3">
    <template x-for="ep in filteredEpisodes" :key="ep.episode_id">
      <div class="card card-flush overflow-hidden"
        x-data="{
          open: ep.status === 'in_progress' || ep.status === 'disputed',
          innerTab: 'timeline',
          detail: null, detailLoading: false,
          async loadDetail() {
            if (this.detail) return;
            this.detailLoading = true;
            try {
              var params = new URLSearchParams({ relay_node_id: $data.selectedAgent });
              if (ep.episode_type === 'trade') params.set('order_id', ep.episode_id);
              else params.set('peer_address', ep.counterparty_addr);
              var r = await fetch('/api/history/episode-detail?' + params);
              this.detail = await r.json();
            } catch(e) { this.detail = { profile: null, messages: [], evidence: [] }; }
            this.detailLoading = false;
          }
        }">
        <!-- Episode header (always visible) -->
        <button @click="open = !open; if(open) loadDetail()" class="w-full px-5 py-4 flex items-center justify-between hover:bg-warm-50 transition-colors text-left">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center text-sm font-bold flex-shrink-0"
              :class="ep.episode_type === 'trade' ? 'bg-brand-50 text-brand-600' : 'bg-warm-200 text-ink-500'"
              x-text="(ep.counterparty_name || '?').charAt(0).toUpperCase()"></div>
            <div class="min-w-0">
              <div class="text-sm font-medium text-ink-700 truncate" x-text="episodeTitle(ep)"></div>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="badge" :class="episodeStatusBadge(ep)" x-text="episodeStatusLabel(ep)"></span>
                <span class="text-[11px] text-ink-300" x-text="KANet.relativeTime(ep.started_at)"></span>
                <template x-if="ep.ended_at && ep.ended_at !== ep.started_at">
                  <span class="text-[11px] text-ink-300" x-text="'→ ' + KANet.relativeTime(ep.ended_at)"></span>
                </template>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-3 flex-shrink-0">
            <template x-if="episodeResult(ep)">
              <span class="text-sm font-semibold" :class="episodeResultColor(ep)" x-text="episodeResult(ep)"></span>
            </template>
            <svg class="w-4 h-4 text-ink-300 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </button>

        <!-- Expanded content with 4 inner tabs -->
        <div x-show="open" x-transition>
          <!-- Inner tab bar -->
          <div class="flex border-t border-b border-warm-200 bg-warm-50">
            <template x-for="it in [{id:'timeline',l:'故事线'},{id:'contact',l:'通讯录'},{id:'chat',l:'会话'},{id:'evidence',l:'链上凭证'}]" :key="it.id">
              <button @click="innerTab = it.id; if(it.id !== 'timeline') loadDetail()"
                class="flex-1 py-2 text-[11px] font-medium transition-colors border-b-2"
                :class="innerTab === it.id ? 'text-brand-600 border-brand-500 bg-white' : 'text-ink-400 border-transparent hover:text-ink-600'"
                x-text="it.l"></button>
            </template>
          </div>

          <!-- Inner Tab 1: 故事线 (timeline + reasons) -->
          <div x-show="innerTab === 'timeline'" class="px-5 py-4">
            <div class="ml-4 border-l-2 border-warm-200 pl-5 space-y-0">
              <template x-for="(step, idx) in ep.steps" :key="idx">
                <div class="relative py-2.5" :class="!step.done ? 'opacity-60' : ''">
                  <div class="absolute -left-[27px] top-3.5 w-3 h-3 rounded-full"
                    :class="stepDotColor(step.type, step.done)"></div>
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded"
                          :class="stepBadgeColor(step.type)" x-text="stepTypeLabel(step.type)"></span>
                        <span class="text-sm text-ink-600" :class="!step.done ? 'text-ink-400' : ''" x-text="step.label || '—'"></span>
                      </div>
                      <template x-if="step.detail">
                        <div class="text-xs text-ink-300 mt-0.5" x-text="step.detail"></div>
                      </template>
                      <!-- TX hash with copy -->
                      <template x-if="step.txhash">
                        <div class="mt-1">
                          <span class="inline-flex items-center gap-1 text-[10px] font-mono bg-warm-100 text-ink-400 px-1.5 py-0.5 rounded cursor-pointer hover:bg-warm-200 hover:text-ink-600 transition-colors"
                            @click.stop="KANet.copy(step.txhash)"
                            :title="'点击复制: ' + step.txhash">
                            TX <span x-text="step.txhash.slice(0,8) + '...' + step.txhash.slice(-6)"></span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                          </span>
                        </div>
                      </template>
                      <!-- Agent decision reason -->
                      <template x-if="step.reason">
                        <div class="mt-1.5 pl-2 border-l-2 border-ink-100 bg-warm-50 rounded-r py-1.5 px-2.5">
                          <div class="text-[10px] text-ink-300 mb-0.5" x-text="(step.reasonSource === 'agent' ? 'Agent 决策' : step.reasonSource === 'owner' ? '人工操作' : '系统自动')"></div>
                          <div class="text-[11px] text-ink-500 leading-relaxed" x-text="step.reason"></div>
                        </div>
                      </template>
                    </div>
                    <span class="text-[11px] text-ink-300 flex-shrink-0 pt-0.5"
                      x-text="step.ts ? KANet.relativeTime(step.ts) : ''"></span>
                  </div>
                </div>
              </template>
            </div>
          </div>

          <!-- Inner Tab 2: 通讯录 (contact profile) -->
          <div x-show="innerTab === 'contact'" class="px-5 py-4">
            <template x-if="detailLoading">
              <div class="space-y-2">
                <div class="skeleton" style="width:120px;height:14px;"></div>
                <div class="skeleton" style="width:200px;height:12px;"></div>
              </div>
            </template>
            <template x-if="!detailLoading && detail?.profile">
              <div class="space-y-4">
                <!-- Name + address -->
                <div>
                  <div class="text-base font-semibold text-ink-700" x-text="detail.profile.displayName || KANet.shortAddr(detail.profile.address)"></div>
                  <div class="addr text-ink-300 mt-0.5" x-text="detail.profile.address"></div>
                </div>
                <!-- Trust level bar -->
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-xs text-ink-400">信任等级</span>
                    <span class="text-xs font-medium text-ink-600" x-text="detail.profile.trustLevel"></span>
                  </div>
                  <div class="h-2 bg-warm-200 rounded-full overflow-hidden">
                    <div class="h-full bg-brand-500 rounded-full transition-all"
                      :style="'width:' + ({owner:100,recommended:80,normal:50,stranger:20,blocked:0}[detail.profile.trustLevel] || 20) + '%'"></div>
                  </div>
                </div>
                <!-- Stats grid -->
                <div class="grid grid-cols-3 gap-3">
                  <div class="bg-warm-50 rounded-lg p-3 text-center">
                    <div class="text-lg font-bold text-ink-700" x-text="detail.profile.tradeCount"></div>
                    <div class="text-[10px] text-ink-300">历史交易</div>
                  </div>
                  <div class="bg-warm-50 rounded-lg p-3 text-center">
                    <div class="text-lg font-bold text-ink-700" x-text="KANet.formatKas(detail.profile.totalVolume) + ' KAS'"></div>
                    <div class="text-[10px] text-ink-300">累计交易量</div>
                  </div>
                  <div class="rounded-lg p-3 text-center"
                    :class="detail.profile.disputeRate > 20 ? 'bg-red-50' : 'bg-warm-50'">
                    <div class="text-lg font-bold" :class="detail.profile.disputeRate > 20 ? 'text-red-600' : 'text-ink-700'"
                      x-text="detail.profile.disputeRate + '%'"></div>
                    <div class="text-[10px]" :class="detail.profile.disputeRate > 20 ? 'text-red-400' : 'text-ink-300'">争议率</div>
                  </div>
                </div>
                <template x-if="detail.profile.firstContact">
                  <div class="text-xs text-ink-300">首次联系: <span x-text="KANet.relativeTime(detail.profile.firstContact)"></span></div>
                </template>
              </div>
            </template>
            <template x-if="!detailLoading && !detail?.profile">
              <div class="text-xs text-ink-300 text-center py-4">无对手方信息</div>
            </template>
          </div>

          <!-- Inner Tab 3: 会话 (chat bubbles) -->
          <div x-show="innerTab === 'chat'" class="px-5 py-4">
            <template x-if="detailLoading">
              <div class="space-y-2">
                <div class="skeleton" style="width:180px;height:32px;"></div>
                <div class="skeleton ml-auto" style="width:140px;height:32px;"></div>
              </div>
            </template>
            <template x-if="!detailLoading && detail?.messages?.length > 0">
              <div class="space-y-2 max-h-80 overflow-y-auto">
                <template x-for="(msg, mi) in detail.messages" :key="mi">
                  <div class="flex" :class="msg.sender === 'self' ? 'justify-end' : 'justify-start'">
                    <div class="max-w-[75%] px-3 py-2 text-[12px] leading-relaxed"
                      :class="msg.sender === 'self'
                        ? 'bg-brand-50 text-ink-600 border border-brand-100 rounded-xl rounded-tr-sm'
                        : 'bg-white text-ink-600 border border-warm-300 rounded-xl rounded-tl-sm'">
                      <div x-text="msg.text"></div>
                      <div class="text-[10px] mt-1" :class="msg.sender === 'self' ? 'text-brand-400' : 'text-ink-300'"
                        x-text="KANet.relativeTime(msg.ts)"></div>
                    </div>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="!detailLoading && (!detail?.messages || detail.messages.length === 0)">
              <div class="text-xs text-ink-300 text-center py-4">暂无对话记录</div>
            </template>
          </div>

          <!-- Inner Tab 4: 链上凭证 (evidence) -->
          <div x-show="innerTab === 'evidence'" class="px-5 py-4">
            <template x-if="detailLoading">
              <div class="space-y-2">
                <div class="skeleton" style="width:100%;height:28px;"></div>
                <div class="skeleton" style="width:100%;height:28px;"></div>
              </div>
            </template>
            <template x-if="!detailLoading && detail?.evidence?.length > 0">
              <div class="space-y-1.5">
                <template x-for="(ev, ei) in detail.evidence" :key="ei">
                  <div>
                    <!-- Conclusion row (special) -->
                    <template x-if="ev.type === 'conclusion'">
                      <div class="rounded-lg px-3 py-2.5 text-xs font-medium"
                        :class="{
                          'bg-green-50 text-green-700 border border-green-200': ev.status === 'success',
                          'bg-amber-50 text-amber-700 border border-amber-200': ev.status === 'warning',
                          'bg-red-50 text-red-700 border border-red-200': ev.status === 'error',
                          'bg-warm-50 text-ink-500 border border-warm-300': ev.status === 'neutral'
                        }"
                        x-text="ev.description || '—'"></div>
                    </template>
                    <!-- Normal evidence row -->
                    <template x-if="ev.type !== 'conclusion'">
                      <div class="flex items-center gap-3 py-1.5">
                        <!-- Status dot -->
                        <span class="flex-shrink-0 w-4 text-center text-xs font-bold"
                          :class="ev.status === 'confirmed' ? 'text-green-500' : ev.status === 'missing' || ev.status === 'failed' ? 'text-red-500' : 'text-ink-300'"
                          x-text="ev.status === 'confirmed' ? '✓' : ev.status === 'missing' || ev.status === 'failed' ? '✗' : '—'"></span>
                        <!-- Description -->
                        <span class="flex-1 text-xs text-ink-600" x-text="ev.description || '—'"></span>
                        <!-- TX hash -->
                        <template x-if="ev.txhash">
                          <span class="inline-flex items-center gap-1 text-[11px] font-mono text-ink-300 flex-shrink-0 cursor-pointer hover:text-brand-500 transition-colors"
                            @click.stop="KANet.copy(ev.txhash)"
                            :title="'点击复制: ' + ev.txhash">
                            <span x-text="ev.txhash.slice(0,6) + '...' + ev.txhash.slice(-4)"></span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                          </span>
                        </template>
                        <template x-if="!ev.txhash">
                          <span class="text-[11px] text-ink-200 flex-shrink-0">无 TX</span>
                        </template>
                      </div>
                    </template>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="!detailLoading && (!detail?.evidence || detail.evidence.length === 0)">
              <div class="text-xs text-ink-300 text-center py-4">暂无链上凭证</div>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- Empty state -->
    <div x-show="!loading && filteredEpisodes.length === 0"
      class="card text-center py-12">
      <div class="text-ink-300 mb-2">
        <svg class="w-10 h-10 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div class="text-sm text-ink-400" x-text="statusFilter === 'all' ? '暂无交互记录' : '没有符合筛选条件的记录'"></div>
    </div>
  </div>
</div>

<script>
function agentHistoryPage() {
  return {
    agents: [],
    selectedAgent: '',
    episodes: [],
    loading: true,
    statusFilter: 'all',

    async init() {
      try {
        var res = await fetch('/api/agent/profile');
        this.agents = await res.json();
      } catch(e) { console.error(e); }
      if (this.agents.length) {
        this.selectedAgent = String(this.agents[0].id);
        await this.loadEpisodes();
      }
      this.loading = false;
    },

    async loadEpisodes() {
      if (!this.selectedAgent) return;
      this.loading = true;
      try {
        var r = await fetch('/api/history/episodes?relay_node_id=' + this.selectedAgent + '&limit=50');
        this.episodes = await r.json();
      } catch(e) {
        console.error(e);
        this.episodes = [];
      }
      this.loading = false;
    },

    episodeTitle(ep) {
      var peer = ep.counterparty_name || (ep.counterparty_addr ? KANet.shortAddr(ep.counterparty_addr) : '未知');
      if (ep.episode_type === 'trade') return '与 ' + peer + ' 的' + (ep.side === 'buy' ? '买入' : '卖出') + '交易';
      return '与 ' + peer + ' 的连接';
    },

    episodeStatusBadge(ep) {
      return ({ completed: 'badge-success', cancelled: 'badge-neutral', disputed: 'badge-error', in_progress: 'badge-warning' })[ep.status] || 'badge-neutral';
    },

    episodeStatusLabel(ep) {
      return ({ completed: '已完成', cancelled: '已取消', disputed: '争议中', in_progress: '进行中' })[ep.status] || ep.status;
    },

    episodeResult(ep) {
      if (ep.result_kas == null) return null;
      return ep.result_kas > 0 ? '+' + KANet.formatKas(ep.result_kas) + ' KAS' : KANet.formatKas(ep.result_kas) + ' KAS';
    },

    episodeResultColor(ep) {
      return ep.result_kas == null ? 'text-ink-300' : ep.result_kas > 0 ? 'text-green-600' : 'text-red-500';
    },

    stepBadgeColor(type) {
      return ({
        handshake: 'bg-brand-100 text-brand-700',
        publish: 'bg-ink-50 text-ink-500',
        negotiate: 'bg-warm-200 text-ink-500',
        payment: 'bg-amber-100 text-amber-700',
        verify: 'bg-brand-50 text-brand-600',
        transfer: 'bg-green-100 text-green-700',
        complete: 'bg-green-100 text-green-700',
        cancelled: 'bg-warm-200 text-ink-400',
        disputed: 'bg-red-100 text-red-700'
      })[type] || 'bg-warm-100 text-ink-400';
    },

    stepDotColor(type, done) {
      if (!done) return 'border-2 border-warm-300 bg-white';
      return ({
        handshake: 'bg-brand-500',
        publish: 'bg-ink-400',
        negotiate: 'bg-ink-300',
        payment: 'bg-amber-500',
        verify: 'bg-brand-500',
        transfer: 'bg-green-500',
        complete: 'bg-green-500',
        cancelled: 'bg-ink-300',
        disputed: 'bg-red-500'
      })[type] || 'bg-ink-300';
    },

    stepTypeLabel(type) {
      return ({
        handshake: '连接',
        publish: '发布',
        negotiate: '协商',
        payment: '付款',
        verify: '验证',
        transfer: '转账',
        complete: '完成',
        cancelled: '取消',
        disputed: '争议'
      })[type] || type;
    },

    get filteredEpisodes() {
      if (this.statusFilter === 'all') return this.episodes;
      var filter = this.statusFilter;
      return this.episodes.filter(function(ep) { return ep.status === filter; });
    }
  };
}
</script>

<%~ include('partials/page-close', it) %>

<!DOCTYPE html>
<html lang="<%= it.t.html_lang %>" dir="<%= it.dir %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= it.t.page_settings %> — KANet Console</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="flex h-screen bg-gray-100 font-sans">

  <!-- Sidebar -->
  <aside class="w-56 bg-gray-900 text-gray-100 flex flex-col flex-shrink-0">
    <div class="px-4 py-4 border-b border-gray-700 flex items-center space-x-3">
      <img src="/public/kanet-logo.png" alt="KANet" class="h-8 w-8 object-contain flex-shrink-0" />
      <span class="text-base font-bold tracking-wide text-white leading-tight">KANet<br/><span class="text-xs font-normal text-gray-400">Console</span></span>
    </div>
    <nav class="flex-1 py-4 space-y-1 px-3 overflow-y-auto">
      <a href="/agent" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        我的 Agent
      </a>
      <a href="/conversations" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
        会话
      </a>
      <a href="/identities" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        通讯录
      </a>
      <a href="/network" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
        网络
      </a>
      <a href="/chat" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
        <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        聊天
      </a>
      <div class="pt-4 border-t border-gray-700 mt-4 space-y-1">
        <a href="/events" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          活动日志
        </a>
        <div class="flex items-center px-3 py-2 text-xs font-medium text-gray-500 uppercase tracking-wider">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          系统设置
        </div>
        <a href="/relays" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors pl-9">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
          账户管理
        </a>
        <a href="/adapters" class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors pl-9">
          <svg class="mr-2 h-4 w-4 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          AI 引擎
        </a>
      </div>
    </nav>
    <div class="px-3 pb-2">
      <form method="POST" action="/lang">
        <select name="lang" onchange="this.form.submit()"
          class="w-full bg-gray-800 text-gray-200 text-xs rounded px-2 py-1.5 border border-gray-700 focus:outline-none cursor-pointer">
          <% Object.entries(it.langs).forEach(function([code, label]) { %>
          <option value="<%= code %>" <%= it.lang === code ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </form>
    </div>
    <div class="px-5 py-3 border-t border-gray-700 text-xs text-gray-500">KANet Console v0.1</div>
  </aside>

  <div class="flex-1 flex flex-col overflow-hidden">
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between flex-shrink-0">
      <h1 class="text-xl font-semibold text-gray-800"><%= it.t.page_settings %></h1>
      <span class="text-sm text-gray-500">KANet Console</span>
    </header>

    <main class="flex-1 overflow-y-auto p-6">
      <div class="max-w-3xl mx-auto space-y-6">

        <!-- Node Configuration -->
        <div class="bg-white rounded-lg border border-gray-200" x-data="{
          mode: '<%= it.rpcMode %>',
          customUrl: '<%= it.rpcMode === 'custom' ? it.rpcUrl : '' %>',
          testUrl: '',
          testing: false,
          testResult: null,
          rpcStatus: null,
          rpcLoading: true,
          get activeUrl() {
            if (this.mode === 'local') return 'ws://127.0.0.1:17110';
            if (this.mode === 'public') return 'wss://vivi.kaspa.blue/kaspa/mainnet/wrpc/borsh';
            if (this.mode === 'custom') return this.customUrl;
            return '';
          },
          async init() {
            try {
              const res = await fetch('/api/config/rpc-status');
              this.rpcStatus = await res.json();
            } catch {} finally { this.rpcLoading = false; }
          },
          async testNode() {
            const url = this.activeUrl;
            if (!url) { this.testResult = { ok: false, error: 'No URL' }; return; }
            this.testing = true;
            this.testResult = null;
            try {
              const res = await fetch('/settings/node/test', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
              });
              this.testResult = await res.json();
            } catch (e) {
              this.testResult = { ok: false, error: e.message };
            }
            this.testing = false;
          }
        }">
          <div class="px-6 py-4 border-b border-gray-200 flex items-center space-x-2">
            <svg class="h-5 w-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
            <h2 class="text-sm font-semibold text-gray-700"><%= it.t.node_config %></h2>
          </div>

          <form method="POST" action="/settings/node" class="px-6 py-5 space-y-5">

            <!-- Mode selection -->
            <div class="space-y-3">
              <label class="block text-xs font-medium text-gray-600 uppercase tracking-wider"><%= it.t.node_mode %></label>

              <!-- Local node -->
              <label class="flex items-start p-3 rounded-lg border cursor-pointer transition-colors"
                :class="mode === 'local' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300'">
                <input type="radio" name="mode" value="local" x-model="mode" class="mt-0.5 text-blue-600" />
                <div class="ml-3">
                  <span class="text-sm font-medium text-gray-800"><%= it.t.local_node %></span>
                  <p class="text-xs text-gray-500 mt-0.5">ws://127.0.0.1:17110</p>
                </div>
                <span class="ml-auto flex-shrink-0" x-show="mode === 'local'">
                  <svg class="h-5 w-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                </span>
              </label>

              <!-- Public node -->
              <label class="flex items-start p-3 rounded-lg border cursor-pointer transition-colors"
                :class="mode === 'public' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300'">
                <input type="radio" name="mode" value="public" x-model="mode" class="mt-0.5 text-blue-600" />
                <div class="ml-3">
                  <span class="text-sm font-medium text-gray-800"><%= it.t.public_node %></span>
                  <p class="text-xs text-gray-500 mt-0.5">wss://vivi.kaspa.blue/kaspa/mainnet/wrpc/borsh</p>
                </div>
              </label>

              <!-- Auto resolver -->
              <label class="flex items-start p-3 rounded-lg border transition-colors opacity-50 cursor-not-allowed"
                :class="'border-gray-200'">
                <input type="radio" name="mode" value="auto" disabled class="mt-0.5 text-gray-400" />
                <div class="ml-3">
                  <span class="text-sm font-medium text-gray-500"><%= it.t.auto_resolver %></span>
                  <p class="text-xs text-gray-400 mt-0.5"><%= it.t.auto_resolver_desc %></p>
                  <p class="text-xs text-yellow-600 mt-1"><%= it.t.auto_resolver_unstable %></p>
                </div>
              </label>

              <!-- Custom -->
              <label class="flex items-start p-3 rounded-lg border cursor-pointer transition-colors"
                :class="mode === 'custom' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300'">
                <input type="radio" name="mode" value="custom" x-model="mode" class="mt-0.5 text-blue-600" />
                <div class="ml-3 flex-1">
                  <span class="text-sm font-medium text-gray-800"><%= it.t.custom_node %></span>
                  <div x-show="mode === 'custom'" x-transition class="mt-2">
                    <input type="text" name="custom_url" x-model="customUrl"
                      placeholder="ws://hostname:port"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500" />
                  </div>
                </div>
              </label>
            </div>

            <!-- Current config display -->
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-medium text-gray-500 uppercase tracking-wider"><%= it.t.current_node %></span>
                  <p class="text-sm font-mono text-gray-800 mt-1" x-text="activeUrl || '<%= it.t.auto_resolver %>'"></p>
                </div>
                <button type="button" @click="testNode()" :disabled="testing || mode === 'auto'"
                  class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
                  :class="(testing || mode === 'auto') ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'">
                  <span x-show="!testing"><%= it.t.btn_test %></span>
                  <span x-show="testing"><%= it.t.btn_testing %></span>
                </button>
              </div>

              <!-- Test result -->
              <div x-show="testResult" x-transition class="mt-3">
                <template x-if="testResult && testResult.ok">
                  <div class="flex items-center space-x-2 text-sm text-green-700 bg-green-50 rounded-md px-3 py-2">
                    <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    <span><%= it.t.node_connected %> · <span x-text="testResult.latency + 'ms'"></span></span>
                  </div>
                </template>
                <template x-if="testResult && !testResult.ok">
                  <div class="flex items-center space-x-2 text-sm text-red-700 bg-red-50 rounded-md px-3 py-2">
                    <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                    <span><%= it.t.node_failed %> · <span x-text="testResult.error"></span></span>
                  </div>
                </template>
              </div>
            </div>

            <!-- Live connection status -->
            <template x-if="!rpcLoading && rpcStatus">
              <div class="rounded-lg p-4" :class="rpcStatus.configured_reachable ? 'bg-green-50 border border-green-200' : 'bg-amber-50 border border-amber-200'">
                <div class="flex items-start gap-2">
                  <template x-if="rpcStatus.configured_reachable">
                    <svg class="h-4 w-4 text-green-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  </template>
                  <template x-if="!rpcStatus.configured_reachable">
                    <svg class="h-4 w-4 text-amber-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                  </template>
                  <div class="flex-1 text-sm">
                    <template x-if="rpcStatus.configured_reachable">
                      <div class="text-green-800">
                        Node connected: <span class="font-mono text-xs" x-text="rpcStatus.actual.url"></span>
                        <span class="text-green-600 text-xs ml-1" x-text="'(' + rpcStatus.actual.source + ')'"></span>
                      </div>
                    </template>
                    <template x-if="!rpcStatus.configured_reachable && rpcStatus.actual.url">
                      <div>
                        <div class="text-amber-800 font-medium">Configured node unreachable — auto-degraded</div>
                        <div class="text-amber-700 text-xs mt-1">
                          Configured: <span class="font-mono" x-text="rpcStatus.configured.url || 'local (127.0.0.1:17110)'"></span> — offline
                        </div>
                        <div class="text-amber-700 text-xs">
                          Actual: <span class="font-mono" x-text="rpcStatus.actual.url"></span>
                          <span x-text="'(' + rpcStatus.actual.source + ')'"></span>
                        </div>
                      </div>
                    </template>
                    <template x-if="!rpcStatus.configured_reachable && !rpcStatus.actual.url">
                      <div class="text-red-800 font-medium">No RPC node available — chain operations will fail</div>
                    </template>
                  </div>
                </div>
              </div>
            </template>

            <!-- Save -->
            <div class="flex justify-end">
              <button type="submit" class="px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors"><%= it.t.btn_save %></button>
            </div>
          </form>
        </div>

        <!-- T-J2-2026-05-12 #5 — Relay child RPC states (UI 健康检测 P0, NWT spec sub #5/7)
             跟上面 Node Connection (console daemon 自己 RpcClient) 区分: 这里是每个 relay 子进程内部 _rpc 状态. -->
        <div class="bg-white shadow rounded-lg p-6"
             x-data="{ relays: [], loading: true, async load() { this.loading = true; try { const r = await fetch('/api/system/rpc-overview').then(r=>r.json()); this.relays = r.relays || []; } catch {} this.loading = false; }, color(r) { if (!r.ok) return 'text-red-500'; if (r.state?.reconnecting) return 'text-yellow-500'; if (r.state?.connected) return 'text-green-500'; return 'text-gray-400'; }, label(r) { if (!r.ok) return r.error || 'unreachable'; const s = r.state; if (s?.reconnecting) return `reconnecting #${s.attempt} (${s.lastError||''})`.slice(0,80); if (s?.connected) { const age = s.lastConnectedAt ? Math.round((Date.now() - s.lastConnectedAt)/1000) : null; return age!=null ? `connected · ${age}s 前 · ${s.currentUrl||''}` : 'connected'; } return 'disconnected'; } }"
             x-init="load(); setInterval(load, 15000)">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-base font-semibold text-gray-900">Relay 子进程 RPC 状态</h2>
              <p class="text-xs text-gray-500 mt-0.5">每个 relay child 内部 _rpc 连接 (跟上面 console daemon Node Connection 区分, ws-proxy hijack 类 bug 真凶)</p>
            </div>
            <button @click="load" class="text-xs text-blue-600 hover:text-blue-700">刷新</button>
          </div>
          <template x-if="loading"><div class="text-sm text-gray-400">加载中...</div></template>
          <template x-if="!loading">
            <div class="space-y-1">
              <template x-for="r in relays" :key="r.id">
                <div class="flex items-center justify-between text-sm py-1.5 border-b border-gray-100 last:border-0">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="text-lg flex-shrink-0" :class="color(r)">●</span>
                    <span class="font-medium text-gray-800 flex-shrink-0" x-text="r.name"></span>
                  </div>
                  <div class="text-xs text-gray-500 text-right truncate ml-3" x-text="label(r)"></div>
                </div>
              </template>
              <template x-if="relays.length === 0"><div class="text-sm text-gray-400">无 active relay</div></template>
            </div>
          </template>
        </div>

        <!-- Info card -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg px-5 py-4">
          <div class="flex items-start space-x-3">
            <svg class="h-5 w-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
            <div class="text-sm text-blue-800">
              <p class="font-medium"><%= it.t.node_info_title %></p>
              <p class="mt-1 text-blue-700"><%= it.t.node_info_desc %></p>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>
</body>
</html>

<%~ include('partials/page-open', { _page: 'exchange', pageTitle: 'Free Market', ...it }) %>

<div class="p-6 max-w-5xl mx-auto" x-data="exchangeApp()">

  <!-- Node visibility notice -->
  <div class="mb-5 bg-warm-50 border border-warm-200 rounded-lg px-4 py-3 text-xs text-ink-500">
    <span class="font-medium text-ink-600">Protocol-Level Market</span> —
    Broadcast stream observed by your local node. Not a global orderbook.
  </div>

  <!-- Tab bar -->
  <div class="flex items-center border-b border-warm-200 mb-5">
    <button @click="activeTab = 'market'"
      :class="activeTab === 'market' ? 'border-brand-500 text-brand-600' : 'border-transparent text-ink-400 hover:text-ink-600'"
      class="px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors">
      Market
    </button>
    <button @click="activeTab = 'deals'"
      :class="activeTab === 'deals' ? 'border-brand-500 text-brand-600' : 'border-transparent text-ink-400 hover:text-ink-600'"
      class="px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors flex items-center gap-1.5">
      My Deals
      <span x-show="activeDeals.length > 0"
        class="bg-brand-500 text-white text-[10px] leading-none px-1.5 py-0.5 rounded-full"
        x-text="activeDeals.length"></span>
    </button>
    <button @click="activeTab = 'arb'; loadArbitrageData()"
      :class="activeTab === 'arb' ? 'border-brand-500 text-brand-600' : 'border-transparent text-ink-400 hover:text-ink-600'"
      class="px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors">
      Arbitrage
    </button>
    <div class="ml-auto flex items-center gap-2 text-xs pb-1">
      <span class="text-ink-400">Agent:</span>
      <select x-model="form.relayNodeId" @change="onAgentChange()"
        class="px-2 py-1 border border-warm-200 rounded text-xs bg-white focus:ring-1 focus:ring-brand-300">
        <template x-for="r in relays" :key="r.id">
          <option :value="r.id" x-text="r.name"></option>
        </template>
      </select>
    </div>
  </div>

  <!-- ═══ MARKET TAB ═══ -->
  <div x-show="activeTab === 'market'">

    <!-- Market groups bar -->
    <div class="flex items-center gap-2 mb-4 flex-wrap">
      <button @click="filter = ''"
        :class="filter === '' ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'"
        class="px-3 py-1.5 rounded-full text-xs font-medium transition-colors">
        All
      </button>
      <template x-for="g in groups" :key="g.market_key">
        <button @click="filter = g.market_key"
          :class="filter === g.market_key ? 'bg-brand-500 text-white' : 'bg-warm-100 text-ink-500 hover:bg-warm-200'"
          class="px-3 py-1.5 rounded-full text-xs font-medium transition-colors">
          <span x-text="g.market_key"></span>
          <span class="ml-1 opacity-60" x-text="'(' + g.cnt + ')'"></span>
        </button>
      </template>
    </div>

    <!-- Action bar -->
    <div class="flex items-center justify-between mb-4">
      <div class="text-sm text-ink-400">
        <span x-text="filtered.length"></span> offers
        <span x-show="filter" class="ml-1">in <span x-text="filter" class="font-medium text-ink-600"></span></span>
      </div>
      <button @click="showForm = !showForm"
        class="px-4 py-2 bg-brand-500 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors">
        + Publish Offer
      </button>
    </div>

    <!-- Publish form (collapsed) -->
    <div x-show="showForm" x-transition class="mb-6 bg-white border border-warm-200 rounded-lg p-5">
      <h3 class="text-sm font-semibold text-ink-700 mb-4">Publish an Offer</h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-ink-500 mb-1">I give</label>
          <div class="flex gap-2">
            <input x-model="form.give_amount" type="text" placeholder="Amount"
              class="flex-1 px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
            <input x-model="form.give_asset" type="text" placeholder="Asset (e.g. KAS)"
              class="w-32 px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
          </div>
          <input x-model="form.give_chain" type="text" placeholder="Chain (optional, e.g. kaspa)"
            class="mt-2 w-full px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
        </div>
        <div>
          <label class="block text-xs font-medium text-ink-500 mb-1">I want</label>
          <div class="flex gap-2">
            <input x-model="form.want_amount" type="text" placeholder="Amount"
              class="flex-1 px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
            <input x-model="form.want_asset" type="text" placeholder="Asset (e.g. USDT)"
              class="w-32 px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
          </div>
          <input x-model="form.want_chain" type="text" placeholder="Chain (optional, e.g. bnb)"
            class="mt-2 w-full px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4 mt-4">
        <div>
          <label class="block text-xs font-medium text-ink-500 mb-1">Verification</label>
          <select x-model="form.verification"
            class="w-full px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300">
            <option value="manual">Manual (both confirm)</option>
            <option value="cross_chain_tx">Cross-chain TX</option>
            <option value="kaspa_tx">Kaspa TX</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-ink-500 mb-1">Expires</label>
          <select x-model="form.expires_minutes"
            class="w-full px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300">
            <option value="30">30 min</option>
            <option value="60" selected>1 hour</option>
            <option value="360">6 hours</option>
            <option value="1440">24 hours</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-ink-500 mb-1">Agent</label>
          <select x-model="form.relayNodeId"
            class="w-full px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300">
            <template x-for="r in relays" :key="r.id">
              <option :value="r.id" x-text="r.name"></option>
            </template>
          </select>
        </div>
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button @click="showForm = false"
          class="px-4 py-2 text-sm text-ink-500 hover:text-ink-700 transition-colors">Cancel</button>
        <button @click="publishOffer()" :disabled="publishing"
          class="px-4 py-2 bg-brand-500 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors disabled:opacity-50">
          <span x-show="!publishing">Broadcast to Network</span>
          <span x-show="publishing">Broadcasting...</span>
        </button>
      </div>
      <p x-show="formError" x-text="formError" class="mt-2 text-xs text-red-600"></p>
      <p x-show="formSuccess" x-text="formSuccess" class="mt-2 text-xs text-green-600"></p>
    </div>

    <!-- Offer stream -->
    <div class="space-y-3">
      <template x-if="loading">
        <div class="text-center py-12 text-ink-400 text-sm">Loading offers...</div>
      </template>
      <template x-if="!loading && filtered.length === 0">
        <div class="text-center py-12 text-ink-400">
          <p class="text-sm">No offers observed yet</p>
          <p class="text-xs mt-1">Publish the first offer to start the market</p>
        </div>
      </template>
      <template x-for="o in filtered" :key="o.id">
        <div class="bg-white border border-warm-200 rounded-lg p-4 hover:border-brand-200 transition-colors">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3">
                <span class="text-lg font-semibold text-ink-700">
                  <span x-text="o.give_amount"></span>
                  <span x-text="o.give_asset" class="text-brand-600"></span>
                </span>
                <span class="text-ink-300">&rarr;</span>
                <span class="text-lg font-semibold text-ink-700">
                  <span x-text="o.want_amount"></span>
                  <span x-text="o.want_asset" class="text-brand-600"></span>
                </span>
              </div>
              <div class="flex items-center gap-3 mt-2 text-xs text-ink-400">
                <span x-text="'by ' + KANet.shortAddr(o.maker)"></span>
                <span x-show="o.give_chain" x-text="o.give_chain + ' &rarr;'"></span>
                <span x-show="o.want_chain" x-text="o.want_chain"></span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium" :class="statusBadge(o.protocol_status)"
                  x-text="o.protocol_status"></span>
                <span x-text="KANet.relativeTime(o.broadcast_at)"></span>
                <span x-show="o.verification !== 'manual'"
                  class="px-1.5 py-0.5 bg-brand-50 text-brand-600 rounded text-[10px]"
                  x-text="o.verification"></span>
              </div>
            </div>
            <!-- Accept (only open offers that are not mine) -->
            <button x-show="o.protocol_status === 'open' && !isMine(o)"
              @click="acceptOffer(o)"
              class="px-3 py-1.5 bg-green-500 text-white rounded-lg text-xs font-medium hover:bg-green-600 transition-colors">
              Accept
            </button>
            <!-- Cancel (only open offers that I made) -->
            <button x-show="o.protocol_status === 'open' && isMaker(o)"
              @click="cancelOffer(o)"
              class="px-3 py-1.5 bg-warm-200 text-ink-600 rounded-lg text-xs font-medium hover:bg-warm-300 transition-colors">
              Cancel
            </button>
          </div>
        </div>
      </template>
    </div>

    <div class="mt-6 text-center">
      <button @click="loadOffers()" class="text-xs text-ink-400 hover:text-brand-500 transition-colors">Refresh</button>
    </div>
  </div>

  <!-- ═══ MY DEALS TAB ═══ -->
  <div x-show="activeTab === 'deals'">

    <template x-if="myDeals.length === 0">
      <div class="text-center py-16 text-ink-400">
        <p class="text-sm">No deals yet</p>
        <p class="text-xs mt-1">Publish or accept an offer to start trading</p>
      </div>
    </template>

    <!-- Active deals -->
    <div x-show="activeDeals.length > 0" class="mb-8">
      <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-3">Active</h3>
      <div class="space-y-3">
        <template x-for="o in activeDeals" :key="o.id">
          <div class="bg-white border rounded-lg overflow-hidden transition-all"
            :class="expandedId === o.id ? 'border-brand-300 ring-1 ring-brand-100' : 'border-warm-200'">

            <!-- Summary row -->
            <div @click="toggleDetail(o.id)" class="p-4 flex items-center justify-between cursor-pointer hover:bg-warm-50/50 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="text-sm font-semibold text-ink-700 truncate">
                  <span x-text="o.give_amount + ' ' + o.give_asset"></span>
                  <span class="text-ink-300 mx-1">&rarr;</span>
                  <span x-text="o.want_amount + ' ' + o.want_asset"></span>
                </div>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium shrink-0"
                  :class="statusBadge(o.protocol_status)" x-text="statusLabel(o.protocol_status)"></span>
                <span class="text-[10px] px-1.5 py-0.5 rounded-full shrink-0"
                  :class="isMaker(o) ? 'bg-brand-50 text-brand-600' : 'bg-green-50 text-green-700'"
                  x-text="isMaker(o) ? 'maker' : 'taker'"></span>
              </div>
              <svg class="w-4 h-4 text-ink-400 shrink-0 transition-transform" :class="expandedId === o.id && 'rotate-180'"
                fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
              </svg>
            </div>

            <!-- Detail panel -->
            <template x-if="expandedId === o.id">
              <div class="border-t border-warm-100 bg-warm-50/30">
                <!-- Info grid -->
                <div class="px-4 pt-4 pb-2 grid grid-cols-2 gap-x-8 gap-y-1.5 text-xs">
                  <div class="text-ink-500">Maker <span class="text-ink-700 font-mono ml-1" x-text="KANet.shortAddr(o.maker)"></span></div>
                  <div class="text-ink-500">Taker <span class="text-ink-700 font-mono ml-1" x-text="o.taker ? KANet.shortAddr(o.taker) : '—'"></span></div>
                  <div class="text-ink-500">Verification <span class="text-ink-700 ml-1" x-text="o.verification"></span></div>
                  <div class="text-ink-500">Published <span class="text-ink-700 ml-1" x-text="KANet.formatTime(o.broadcast_at)"></span></div>
                </div>

                <!-- Timeline -->
                <div class="px-4 py-3">
                  <template x-for="(step, i) in getTimeline(o)" :key="i">
                    <div class="flex items-start gap-2.5">
                      <div class="flex flex-col items-center" style="min-width:14px">
                        <div class="w-2 h-2 rounded-full shrink-0 mt-1"
                          :class="step.done ? 'bg-green-500' : (step.active ? 'bg-brand-500 ring-2 ring-brand-200' : 'bg-warm-300')"></div>
                        <div x-show="i < getTimeline(o).length - 1"
                          class="w-px grow min-h-[16px]"
                          :class="step.done ? 'bg-green-200' : 'bg-warm-200'"></div>
                      </div>
                      <div class="pb-2 min-w-0">
                        <span class="text-xs font-medium" :class="step.done || step.active ? 'text-ink-700' : 'text-ink-400'" x-text="step.label"></span>
                        <span x-show="step.time" class="text-[10px] text-ink-400 ml-1.5" x-text="KANet.relativeTime(step.time)"></span>
                        <span x-show="step.detail" class="text-[10px] text-ink-400 ml-1" x-text="step.detail"></span>
                      </div>
                    </div>
                  </template>
                </div>

                <!-- Action buttons -->
                <div class="px-4 pb-3 flex flex-wrap gap-2" x-show="canConfirm(o) || canSubmitPayment(o) || canDispute(o)">
                  <button x-show="canConfirm(o)" @click="confirmDeal(o)" :disabled="actionLoading"
                    class="px-3 py-1.5 bg-green-500 text-white rounded text-xs font-medium hover:bg-green-600 transition-colors disabled:opacity-50">
                    Confirm Delivery
                  </button>
                  <button x-show="canSubmitPayment(o)" @click="actionMode = (actionMode === 'payment' ? null : 'payment')"
                    class="px-3 py-1.5 bg-brand-500 text-white rounded text-xs font-medium hover:bg-brand-600 transition-colors">
                    Submit Payment
                  </button>
                  <button x-show="canDispute(o)" @click="actionMode = (actionMode === 'dispute' ? null : 'dispute')"
                    class="px-3 py-1.5 bg-red-50 text-red-600 border border-red-200 rounded text-xs font-medium hover:bg-red-100 transition-colors">
                    Dispute
                  </button>
                </div>

                <!-- Payment form (inline) -->
                <div x-show="actionMode === 'payment' && expandedId === o.id" class="px-4 pb-4">
                  <div class="bg-white border border-warm-200 rounded-lg p-3 space-y-2">
                    <div class="text-xs font-medium text-ink-600 mb-2">Submit cross-chain payment proof</div>
                    <input x-model="paymentTx" type="text" placeholder="TX Hash (e.g. 0xabc...)"
                      class="w-full px-3 py-2 border border-warm-200 rounded text-xs focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
                    <div class="flex gap-2">
                      <select x-model="paymentChain"
                        class="px-3 py-2 border border-warm-200 rounded text-xs focus:ring-1 focus:ring-brand-300">
                        <option value="bnb">BNB</option>
                        <option value="eth">ETH</option>
                        <option value="sol">SOL</option>
                        <option value="tron">TRON</option>
                      </select>
                      <button @click="submitPayment(o)" :disabled="actionLoading || !paymentTx"
                        class="px-4 py-2 bg-brand-500 text-white rounded text-xs font-medium hover:bg-brand-600 disabled:opacity-50 transition-colors">
                        <span x-show="!actionLoading">Submit</span>
                        <span x-show="actionLoading">Verifying...</span>
                      </button>
                      <button @click="actionMode = null" class="px-3 py-2 text-xs text-ink-400 hover:text-ink-600">Cancel</button>
                    </div>
                  </div>
                </div>

                <!-- Dispute form (inline) -->
                <div x-show="actionMode === 'dispute' && expandedId === o.id" class="px-4 pb-4">
                  <div class="bg-red-50 border border-red-200 rounded-lg p-3 space-y-2">
                    <div class="text-xs font-medium text-red-700 mb-2">Raise a dispute</div>
                    <input x-model="disputeReason" type="text" placeholder="Reason for dispute"
                      class="w-full px-3 py-2 border border-red-200 rounded text-xs bg-white focus:ring-1 focus:ring-red-300 focus:border-red-300" />
                    <div class="flex gap-2">
                      <button @click="disputeDeal(o)" :disabled="actionLoading || !disputeReason"
                        class="px-4 py-2 bg-red-500 text-white rounded text-xs font-medium hover:bg-red-600 disabled:opacity-50 transition-colors">
                        Confirm Dispute
                      </button>
                      <button @click="actionMode = null" class="px-3 py-2 text-xs text-ink-400 hover:text-ink-600">Cancel</button>
                    </div>
                  </div>
                </div>

                <!-- Action feedback -->
                <div x-show="actionError" class="px-4 pb-3">
                  <p class="text-xs text-red-600" x-text="actionError"></p>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
    </div>

    <!-- Completed deals -->
    <div x-show="completedDeals.length > 0">
      <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-3">Completed</h3>
      <div class="space-y-2">
        <template x-for="o in completedDeals" :key="o.id">
          <div class="bg-white border border-warm-200 rounded-lg overflow-hidden"
            :class="expandedId === o.id ? 'ring-1 ring-warm-300' : ''">

            <div @click="toggleDetail(o.id)" class="p-3 flex items-center justify-between cursor-pointer hover:bg-warm-50/50 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="text-sm text-ink-600 truncate">
                  <span x-text="o.give_amount + ' ' + o.give_asset"></span>
                  <span class="text-ink-300 mx-1">&rarr;</span>
                  <span x-text="o.want_amount + ' ' + o.want_asset"></span>
                </div>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium shrink-0"
                  :class="statusBadge(o.protocol_status)" x-text="o.protocol_status"></span>
                <span class="text-[10px] text-ink-400 shrink-0" x-text="KANet.relativeTime(o.completed_at || o.disputed_at || o.timed_out_at || o.cancelled_at || o.updated_at)"></span>
              </div>
              <svg class="w-4 h-4 text-ink-400 shrink-0 transition-transform" :class="expandedId === o.id && 'rotate-180'"
                fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
              </svg>
            </div>

            <template x-if="expandedId === o.id">
              <div class="border-t border-warm-100 bg-warm-50/30">
                <div class="px-4 pt-3 pb-2 grid grid-cols-2 gap-x-8 gap-y-1.5 text-xs">
                  <div class="text-ink-500">Maker <span class="text-ink-700 font-mono ml-1" x-text="KANet.shortAddr(o.maker)"></span></div>
                  <div class="text-ink-500">Taker <span class="text-ink-700 font-mono ml-1" x-text="o.taker ? KANet.shortAddr(o.taker) : '—'"></span></div>
                  <div class="text-ink-500">Verification <span class="text-ink-700 ml-1" x-text="o.verification"></span></div>
                  <div class="text-ink-500">Published <span class="text-ink-700 ml-1" x-text="KANet.formatTime(o.broadcast_at)"></span></div>
                </div>
                <div class="px-4 py-3">
                  <template x-for="(step, i) in getTimeline(o)" :key="i">
                    <div class="flex items-start gap-2.5">
                      <div class="flex flex-col items-center" style="min-width:14px">
                        <div class="w-2 h-2 rounded-full shrink-0 mt-1"
                          :class="step.done ? 'bg-green-500' : (step.active ? 'bg-brand-500' : 'bg-warm-300')"></div>
                        <div x-show="i < getTimeline(o).length - 1"
                          class="w-px grow min-h-[16px]"
                          :class="step.done ? 'bg-green-200' : 'bg-warm-200'"></div>
                      </div>
                      <div class="pb-2">
                        <span class="text-xs font-medium" :class="step.done ? 'text-ink-700' : 'text-ink-400'" x-text="step.label"></span>
                        <span x-show="step.time" class="text-[10px] text-ink-400 ml-1.5" x-text="KANet.relativeTime(step.time)"></span>
                        <span x-show="step.detail" class="text-[10px] text-ink-400 ml-1" x-text="step.detail"></span>
                      </div>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
    </div>

    <div class="mt-6 text-center">
      <button @click="loadOffers()" class="text-xs text-ink-400 hover:text-brand-500 transition-colors">Refresh</button>
    </div>
  </div>

  <!-- ═══ ARBITRAGE TAB ═══ -->
  <div x-show="activeTab === 'arb'">

    <!-- ── Area 1: CEX Overview ── -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider">CEX Overview</h3>
        <button @click="loadBalances()" class="text-xs text-ink-400 hover:text-brand-500 transition-colors flex items-center gap-1">
          <span>Refresh</span>
        </button>
      </div>
      <template x-if="arbLoading.balances">
        <div class="flex gap-3">
          <template x-for="i in 3" :key="i">
            <div class="flex-1 bg-warm-100 animate-pulse rounded-lg h-20"></div>
          </template>
        </div>
      </template>
      <template x-if="!arbLoading.balances">
        <div class="flex gap-3 flex-wrap">
          <template x-for="b in cexBalances" :key="b.accountId || b.exchange">
            <div class="bg-white border border-warm-200 rounded-lg px-4 py-3 min-w-[140px]">
              <div class="flex items-center gap-1.5 mb-2">
                <span class="text-sm font-semibold text-ink-700" x-text="b.label || b.exchange.toUpperCase()"></span>
                <span x-show="b.isDefault" class="text-amber-500 text-xs">&#9733;</span>
              </div>
              <template x-if="!b.error">
                <div class="space-y-0.5">
                  <div class="text-xs text-ink-500">KAS <span class="font-medium text-ink-700" x-text="b.kas !== null ? Number(b.kas).toLocaleString(undefined, {maximumFractionDigits: 4}) : '--'"></span></div>
                  <div class="text-xs text-ink-500">USDT <span class="font-medium text-ink-700" x-text="b.usdt !== null ? Number(b.usdt).toLocaleString(undefined, {maximumFractionDigits: 2}) : '--'"></span></div>
                </div>
              </template>
              <template x-if="b.error">
                <div class="text-xs text-red-500 flex items-center gap-1">
                  <span>&#9888;</span> <span x-text="b.error"></span>
                </div>
              </template>
            </div>
          </template>
          <a href="/trading" class="bg-warm-50 border border-dashed border-warm-300 rounded-lg px-4 py-3 min-w-[140px] flex items-center justify-center text-xs text-ink-400 hover:text-brand-500 hover:border-brand-300 transition-colors">
            + Add Account
          </a>
        </div>
      </template>
    </div>

    <!-- ── Area 2: Live Spreads (split: Your Exchanges + Other Markets) ── -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider">Live Spreads</h3>
          <span x-show="fundedExchanges.length" class="text-[10px] text-ink-400"
            x-text="'(' + fundedExchanges.map(e => e.toUpperCase()).join(' · ') + ')'"></span>
          <span x-show="spreadsCachedAt" class="text-[10px] text-ink-300" x-text="'Updated ' + KANet.formatTime(spreadsCachedAt)"></span>
        </div>
        <button @click="loadSpreads()" class="text-xs text-ink-400 hover:text-brand-500 transition-colors">Refresh</button>
      </div>
      <template x-if="arbLoading.spreads">
        <div class="bg-warm-100 animate-pulse rounded-lg h-32"></div>
      </template>
      <template x-if="!arbLoading.spreads">
        <div>
          <template x-if="spreadRows.length === 0">
            <div class="text-center py-8 text-ink-400 text-sm">No spread data available</div>
          </template>
          <template x-if="spreadRows.length > 0">
            <div>
              <!-- Your Exchanges (actionable) -->
              <template x-if="actionableSpreads.length > 0">
                <div class="bg-white border border-warm-200 rounded-lg overflow-hidden mb-3">
                  <div class="px-4 py-2 bg-warm-50 border-b border-warm-100 text-xs font-semibold text-ink-600">Your Exchanges</div>
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-warm-100 text-xs text-ink-400">
                        <th class="text-left px-4 py-2 font-medium">Buy From</th>
                        <th class="text-left px-4 py-2 font-medium">Sell To</th>
                        <th class="text-right px-4 py-2 font-medium">Spread</th>
                        <th class="text-right px-4 py-2 font-medium">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="s in actionableSpreads" :key="'a_' + s.buy_from + s.sell_to">
                        <tr class="border-b border-warm-50 last:border-0 transition-colors"
                          :class="s.opportunity ? 'bg-green-50' : ''">
                          <td class="px-4 py-2 font-medium text-ink-700" x-text="s.buy_from.toUpperCase()"></td>
                          <td class="px-4 py-2 font-medium text-ink-700" x-text="s.sell_to.toUpperCase()"></td>
                          <td class="px-4 py-2 text-right font-mono"
                            :class="s.spread_pct >= 0.3 ? 'text-green-600 font-semibold' : s.spread_pct >= 0 ? 'text-ink-600' : 'text-ink-300'"
                            x-text="(s.spread_pct >= 0 ? '+' : '') + s.spread_pct.toFixed(4) + '%'"></td>
                          <td class="px-4 py-2 text-right">
                            <span x-show="s.opportunity" class="text-[10px] font-semibold text-green-700 bg-green-100 px-2 py-0.5 rounded-full">OPPORTUNITY</span>
                            <span x-show="!s.opportunity" class="text-ink-300">&mdash;</span>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </template>
              <template x-if="actionableSpreads.length === 0">
                <div class="text-center py-4 text-ink-400 text-xs mb-3 bg-white border border-warm-200 rounded-lg">
                  No configured exchanges with balance — <a href="/trading" class="text-brand-500 hover:underline">add account</a>
                </div>
              </template>

              <!-- Other Markets (collapsed) -->
              <div>
                <button @click="showOtherSpreads = !showOtherSpreads"
                  class="text-xs text-ink-400 hover:text-ink-600 transition-colors flex items-center gap-1 mb-2">
                  <span x-text="showOtherSpreads ? '&#9660;' : '&#9654;'"></span>
                  Other Markets (<span x-text="otherSpreads.length"></span>)
                </button>
                <div x-show="showOtherSpreads" x-transition class="bg-white border border-warm-200 rounded-lg overflow-hidden opacity-70">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="border-b border-warm-100 text-ink-400">
                        <th class="text-left px-3 py-1.5 font-medium">Buy From</th>
                        <th class="text-left px-3 py-1.5 font-medium">Sell To</th>
                        <th class="text-right px-3 py-1.5 font-medium">Spread</th>
                        <th class="text-right px-3 py-1.5 font-medium"></th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="s in otherSpreads" :key="'o_' + s.buy_from + s.sell_to">
                        <tr class="border-b border-warm-50 last:border-0">
                          <td class="px-3 py-1.5 text-ink-400" x-text="s.buy_from.toUpperCase()"></td>
                          <td class="px-3 py-1.5 text-ink-400" x-text="s.sell_to.toUpperCase()"></td>
                          <td class="px-3 py-1.5 text-right font-mono text-ink-300"
                            x-text="(s.spread_pct >= 0 ? '+' : '') + s.spread_pct.toFixed(4) + '%'"></td>
                          <td class="px-3 py-1.5 text-right">
                            <a href="/trading" class="text-[10px] text-brand-500 hover:underline">+ Add Account</a>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="mt-2 text-[10px] text-ink-400">Source: public APIs, 30s cache</div>
            </div>
          </template>
        </div>
      </template>
    </div>

    <!-- ── Today's KAS Sales ── -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider">Today's KAS Sales</h3>
        <span class="text-[10px] text-ink-400"
          x-text="new Date().toLocaleDateString(undefined, {month:'short', day:'numeric'})"></span>
      </div>

      <template x-if="arbLoading.usage">
        <div class="bg-warm-100 animate-pulse rounded-lg h-32"></div>
      </template>

      <template x-if="!arbLoading.usage">
        <div class="bg-white border border-warm-200 rounded-lg p-4">

          <!-- Total progress bar -->
          <template x-if="dailyTotal">
            <div class="mb-4">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-sm font-semibold text-ink-700">
                  <span x-text="Number(dailyTotal.sold_kas).toLocaleString()"></span>
                  <span class="text-ink-400 font-normal">
                    / <span x-text="Number(dailyTotal.limit_kas).toLocaleString()"></span> KAS
                  </span>
                </span>
                <span class="text-sm font-mono"
                  :class="dailyTotal.pct_used >= 80 ? 'text-red-500 font-semibold' :
                          dailyTotal.pct_used >= 50 ? 'text-amber-500' : 'text-green-600'"
                  x-text="dailyTotal.pct_used + '%'"></span>
              </div>
              <div class="w-full bg-warm-200 rounded-full h-3 overflow-hidden">
                <div class="h-full rounded-full transition-all duration-500"
                  :class="dailyTotal.pct_used >= 80 ? 'bg-red-500' :
                          dailyTotal.pct_used >= 50 ? 'bg-amber-500' : 'bg-green-500'"
                  :style="'width:' + Math.min(dailyTotal.pct_used, 100) + '%'"></div>
              </div>
              <div x-show="dailyTotal.pct_used >= 100"
                class="mt-2 text-xs text-red-600 font-semibold">
                Daily limit reached — SELL_MAKER paused until midnight UTC
              </div>
              <div x-show="dailyTotal.pct_used >= 80 && dailyTotal.pct_used < 100"
                class="mt-2 text-xs text-amber-600">
                80% used — Brain will reduce sell frequency
              </div>
            </div>
          </template>

          <!-- Per-exchange breakdown -->
          <div class="space-y-1.5 mb-4">
            <template x-for="u in dailyUsage" :key="u.exchange">
              <div class="flex items-center gap-3"
                :class="u.sold_kas === 0 ? 'opacity-50' : ''">
                <span class="text-xs font-medium text-ink-600 w-14 shrink-0"
                  x-text="u.label || u.exchange.toUpperCase()"></span>
                <div class="flex-1 bg-warm-100 rounded-full h-1.5 overflow-hidden">
                  <div class="h-full rounded-full"
                    :class="u.pct_used >= 80 ? 'bg-red-400' :
                            u.pct_used >= 50 ? 'bg-amber-400' : 'bg-green-400'"
                    :style="'width:' + Math.min(u.pct_used, 100) + '%'"></div>
                </div>
                <span class="text-xs text-ink-500 tabular-nums w-28 text-right shrink-0"
                  x-text="Number(u.sold_kas).toLocaleString() + ' KAS'"></span>
              </div>
            </template>
          </div>

          <!-- Editable limit -->
          <div class="flex items-center gap-2 pt-3 border-t border-warm-100">
            <span class="text-xs text-ink-400 shrink-0">Daily limit:</span>
            <input type="number" min="100" step="1000"
              x-model.number="dailyLimitInput"
              class="w-24 text-xs border border-warm-200 rounded px-2 py-1 text-center
                     focus:outline-none focus:border-brand-400"
              @keydown.enter="saveDailyLimit()">
            <span class="text-xs text-ink-400">KAS</span>
            <button @click="saveDailyLimit()"
              :disabled="dailyLimitSaving"
              class="text-xs px-3 py-1 bg-brand-500 text-white rounded hover:bg-brand-600
                     disabled:opacity-50 transition-colors">
              <span x-show="!dailyLimitSaving">Save</span>
              <span x-show="dailyLimitSaving">...</span>
            </button>
            <span class="text-[10px] text-ink-400 ml-auto">Resets midnight UTC</span>
          </div>

        </div>
      </template>
    </div>

    <!-- ── Area 3: Active Arbitrage Offers ── -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider">Active Arbitrage Offers</h3>
        <span class="text-[10px] text-ink-400" x-text="'(' + arbOffers.length + ')'"></span>
      </div>
      <template x-if="arbOffers.length === 0">
        <div class="text-center py-8 text-ink-400 text-sm bg-white border border-warm-200 rounded-lg">No active arbitrage offers</div>
      </template>
      <div class="space-y-3">
        <template x-for="o in arbOffers" :key="o.id">
          <div class="bg-white border border-warm-200 rounded-lg p-4">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-sm font-semibold text-ink-700">
                  <template x-if="o.give_asset === 'KAS'">
                    <span>SELL <span x-text="o.give_amount"></span> KAS @ <span x-text="o.want_amount && o.give_amount ? (parseFloat(o.want_amount) / parseFloat(o.give_amount)).toFixed(5) : '?'"></span></span>
                  </template>
                  <template x-if="o.give_asset !== 'KAS'">
                    <span>BUY KAS: give <span x-text="o.give_amount + ' ' + o.give_asset"></span></span>
                  </template>
                </span>
              </div>
              <span class="text-[10px] px-2 py-0.5 rounded-full"
                :class="o.protocol_status === 'open' ? 'bg-blue-100 text-blue-700' : 'bg-warm-100 text-ink-500'"
                x-text="o.protocol_status"></span>
            </div>
            <div class="mt-2 flex items-center gap-4 text-xs text-ink-400">
              <span>By: <span class="text-ink-600" x-text="arbAgentName(o.maker)"></span></span>
              <span x-text="KANet.relativeTime(o.broadcast_at)"></span>
            </div>
            <div class="mt-3">
              <button @click="cancelArbOffer(o)"
                class="text-xs px-3 py-1.5 border border-red-200 text-red-600 rounded hover:bg-red-50 transition-colors"
                :disabled="o._cancelling">
                <span x-show="!o._cancelling">Cancel</span>
                <span x-show="o._cancelling">Cancelling...</span>
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- ── Area 4: Hedge History ── -->
    <div class="mb-6">
      <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-3">Hedge History</h3>
      <template x-if="arbLoading.hedges">
        <div class="bg-warm-100 animate-pulse rounded-lg h-24"></div>
      </template>
      <template x-if="!arbLoading.hedges">
        <div>
          <template x-if="hedgeHistory.length === 0">
            <div class="text-center py-8 text-ink-400 text-sm bg-white border border-warm-200 rounded-lg">No hedge history</div>
          </template>
          <template x-if="hedgeHistory.length > 0">
            <div class="bg-white border border-warm-200 rounded-lg overflow-hidden">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-warm-100 text-xs text-ink-400">
                    <th class="text-left px-4 py-2 font-medium">Time</th>
                    <th class="text-left px-4 py-2 font-medium">Side</th>
                    <th class="text-right px-4 py-2 font-medium">Qty</th>
                    <th class="text-right px-4 py-2 font-medium">Price</th>
                    <th class="text-left px-4 py-2 font-medium">Exchange</th>
                    <th class="text-center px-4 py-2 font-medium">Result</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="h in hedgeHistory" :key="h.id || h.observed_at">
                    <tr class="border-b border-warm-50 last:border-0">
                      <td class="px-4 py-2 text-xs text-ink-500" x-text="KANet.formatTime(h.observed_at)"></td>
                      <td class="px-4 py-2 font-medium" :class="h.side === 'BUY' ? 'text-green-600' : 'text-red-500'" x-text="h.side || '—'"></td>
                      <td class="px-4 py-2 text-right font-mono text-ink-700" x-text="h.qty ? Number(h.qty).toLocaleString() : '—'"></td>
                      <td class="px-4 py-2 text-right font-mono text-ink-700" x-text="h.price ? Number(h.price).toFixed(5) : '—'"></td>
                      <td class="px-4 py-2 text-ink-600" x-text="(h.exchange || '—').toUpperCase()"></td>
                      <td class="px-4 py-2 text-center">
                        <template x-if="h.event_type === 'hedge_placed'"><span class="text-green-600">&#10004;</span></template>
                        <template x-if="h.event_type === 'hedge_failed'"><span class="text-red-500">&#10008; <span class="text-[10px]" x-text="h.error || ''"></span></span></template>
                        <template x-if="h.event_type === 'hedge_skipped'"><span class="text-amber-500">skipped</span></template>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </template>
        </div>
      </template>
    </div>

  </div>

</div>

<script>
function exchangeApp() {
  return {
    // ── State ──
    offers: [],
    groups: [],
    relays: [],
    myAddresses: [],
    currentAddress: null,
    filter: '',
    loading: true,
    activeTab: 'market',
    showForm: false,
    publishing: false,
    formError: '',
    formSuccess: '',
    form: {
      give_asset: '', give_amount: '', give_chain: '',
      want_asset: '', want_amount: '', want_chain: '',
      verification: 'manual', expires_minutes: '60',
      relayNodeId: '',
    },
    // Arbitrage tab state
    cexBalances: [],
    spreadRows: [],
    spreadsCachedAt: null,
    fundedExchanges: [],
    showOtherSpreads: false,
    arbOffers: [],
    hedgeHistory: [],
    dailyUsage: [],
    dailyTotal: null,
    dailyLimitInput: 10000,
    dailyLimitSaving: false,
    arbLoading: { balances: false, spreads: false, hedges: false, usage: false },
    arbInitialized: false,

    // Deal detail
    expandedId: null,
    actionMode: null, // null | 'payment' | 'dispute'
    actionLoading: false,
    actionError: '',
    paymentTx: '',
    paymentChain: 'bnb',
    disputeReason: '',

    // ── Computed ──
    get filtered() {
      if (!this.filter) return this.offers;
      return this.offers.filter(o => o.market_key === this.filter);
    },
    get myDeals() {
      return this.offers.filter(o => this.isMine(o));
    },
    get activeDeals() {
      return this.myDeals.filter(o =>
        ['open', 'matched', 'verifying', 'awaiting_manual_confirm'].includes(o.protocol_status)
      );
    },
    get completedDeals() {
      return this.myDeals.filter(o =>
        ['completed', 'disputed', 'timed_out', 'expired', 'cancelled'].includes(o.protocol_status)
      );
    },
    get actionableSpreads() {
      return this.spreadRows.filter(s => s.actionable);
    },
    get otherSpreads() {
      return this.spreadRows.filter(s => !s.actionable);
    },

    // ── Init ──
    async init() {
      await this.loadRelays();
      await this.loadOffers();
      setInterval(() => this.loadOffers(), 30000);
    },

    async loadRelays() {
      try {
        const res = await fetch('/api/exchange/agents');
        const data = await res.json();
        this.relays = data.agents || [];
        this.myAddresses = this.relays.map(r => r.address).filter(Boolean);
        if (this.relays.length && !this.form.relayNodeId) {
          this.form.relayNodeId = this.relays[0].id;
        }
        this.currentAddress = this.relays.find(r => r.id === this.form.relayNodeId)?.address || null;
      } catch {}
    },

    onAgentChange() {
      this.currentAddress = this.relays.find(r => r.id === this.form.relayNodeId)?.address || null;
    },

    async loadOffers() {
      try {
        const res = await fetch('/api/exchange/offers?limit=200');
        const data = await res.json();
        this.offers = data.offers || [];
        this.groups = data.groups || [];
      } catch (e) {
        console.error('Failed to load offers:', e);
      } finally {
        this.loading = false;
      }
    },

    // ── Role helpers (scoped to current Agent) ──
    isMaker(o) { return this.currentAddress && o.maker === this.currentAddress; },
    isTaker(o) { return this.currentAddress && o.taker === this.currentAddress; },
    isMine(o) { return this.isMaker(o) || this.isTaker(o); },

    // ── Action visibility ──
    canConfirm(o) {
      if (o.protocol_status !== 'awaiting_manual_confirm') return false;
      if (this.isMaker(o) && !o.maker_confirmed_at) return true;
      if (this.isTaker(o) && !o.taker_confirmed_at) return true;
      return false;
    },
    canSubmitPayment(o) {
      if (o.verification !== 'cross_chain_tx') return false;
      if (!['matched', 'verifying'].includes(o.protocol_status)) return false;
      if (!this.isTaker(o)) return false;
      try { const m = JSON.parse(o.verification_meta || '{}'); return !m.payment_tx; } catch { return true; }
    },
    canDispute(o) {
      return ['matched', 'verifying', 'awaiting_manual_confirm'].includes(o.protocol_status) &&
        (this.isMaker(o) || this.isTaker(o));
    },

    // ── Detail panel ──
    toggleDetail(id) {
      if (this.expandedId === id) { this.expandedId = null; }
      else { this.expandedId = id; this.actionMode = null; this.actionError = ''; this.paymentTx = ''; this.disputeReason = ''; }
    },

    // ── Timeline ──
    getTimeline(o) {
      const steps = [];
      steps.push({ label: 'Published', done: true, time: o.broadcast_at });

      const isMatched = !!o.matched_at;
      steps.push({
        label: 'Matched',
        done: isMatched,
        active: o.protocol_status === 'matched',
        time: o.matched_at,
        detail: o.taker ? 'by ' + KANet.shortAddr(o.taker) : '',
      });

      if (o.verification === 'manual') {
        const awaitDone = o.protocol_status === 'completed' || !!o.maker_confirmed_at && !!o.taker_confirmed_at;
        const parts = [];
        if (o.maker_confirmed_at) parts.push('maker confirmed');
        if (o.taker_confirmed_at) parts.push('taker confirmed');
        steps.push({
          label: 'Confirmation',
          done: awaitDone,
          active: o.protocol_status === 'awaiting_manual_confirm',
          time: o.maker_confirmed_at || o.taker_confirmed_at,
          detail: parts.length ? parts.join(', ') : (isMatched ? 'waiting for both parties' : ''),
        });
      } else {
        let verifyDetail = '';
        try {
          const m = JSON.parse(o.verification_meta || '{}');
          if (m.payment_tx) verifyDetail = 'TX: ' + m.payment_tx.slice(0, 16) + '...';
        } catch {}
        steps.push({
          label: 'Verification',
          done: ['completed', 'disputed'].includes(o.protocol_status) && !!o.verifying_started_at,
          active: o.protocol_status === 'verifying',
          time: o.verifying_started_at,
          detail: verifyDetail || (o.protocol_status === 'verifying' ? 'checking payment...' : ''),
        });
      }

      // Terminal state
      if (o.completed_at) {
        steps.push({ label: 'Completed', done: true, time: o.completed_at });
      } else if (o.disputed_at) {
        steps.push({ label: 'Disputed', done: true, time: o.disputed_at, detail: 'escalated' });
      } else if (o.timed_out_at) {
        steps.push({ label: 'Timed out', done: true, time: o.timed_out_at });
      } else if (o.cancelled_at) {
        steps.push({ label: 'Cancelled', done: true, time: o.cancelled_at });
      } else if (['expired'].includes(o.protocol_status)) {
        steps.push({ label: 'Expired', done: true, time: o.expires_at });
      } else {
        steps.push({ label: 'Settlement', done: false });
      }

      return steps;
    },

    // ── Status helpers ──
    statusBadge(s) {
      return {
        'bg-green-50 text-green-700': s === 'open',
        'bg-blue-50 text-blue-700': s === 'matched',
        'bg-amber-50 text-amber-700': s === 'verifying' || s === 'awaiting_manual_confirm',
        'bg-green-100 text-green-800': s === 'completed',
        'bg-red-50 text-red-600': s === 'disputed' || s === 'timed_out',
        'bg-warm-100 text-ink-500': s === 'cancelled' || s === 'expired',
      };
    },
    statusLabel(s) {
      const map = { awaiting_manual_confirm: 'awaiting confirm', timed_out: 'timed out' };
      return map[s] || s;
    },

    // ── Market actions ──
    async publishOffer() {
      this.formError = ''; this.formSuccess = '';
      if (!this.form.give_asset || !this.form.give_amount || !this.form.want_asset || !this.form.want_amount) {
        this.formError = 'Fill in all required fields'; return;
      }
      this.publishing = true;
      try {
        const res = await fetch('/api/exchange/publish', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(this.form),
        });
        const data = await res.json();
        if (data.ok) {
          this.formSuccess = `Offer published! ID: ${data.offer_id?.slice(0, 8)}`;
          this.showForm = false;
          this.form.give_asset = ''; this.form.give_amount = ''; this.form.give_chain = '';
          this.form.want_asset = ''; this.form.want_amount = ''; this.form.want_chain = '';
          await this.loadOffers();
        } else { this.formError = data.error || 'Broadcast failed'; }
      } catch (e) { this.formError = e.message; }
      finally { this.publishing = false; }
    },

    async acceptOffer(offer) {
      if (!this.form.relayNodeId && this.relays.length) this.form.relayNodeId = this.relays[0].id;
      if (!this.form.relayNodeId) { alert('No agent available'); return; }
      const name = this.relays.find(r => r.id === this.form.relayNodeId)?.name || 'Agent';
      if (!confirm(`${name} accepts: ${offer.give_amount} ${offer.give_asset} \u2192 ${offer.want_amount} ${offer.want_asset}?`)) return;
      try {
        const res = await fetch('/api/exchange/accept', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: offer.id }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); this.activeTab = 'deals'; }
        else { alert(data.error || 'Accept failed'); }
      } catch (e) { alert(e.message); }
    },

    async cancelOffer(offer) {
      if (!confirm('Cancel this offer?')) return;
      try {
        const res = await fetch('/api/exchange/cancel', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: offer.id }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); } else { alert(data.error || 'Cancel failed'); }
      } catch (e) { alert(e.message); }
    },

    // ── Deal actions ──
    async confirmDeal(o) {
      const role = this.isMaker(o) ? 'maker' : 'taker';
      this.actionLoading = true; this.actionError = '';
      try {
        const res = await fetch('/api/exchange/confirm', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id, role }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); this.actionMode = null; }
        else { this.actionError = data.error || 'Confirm failed'; }
      } catch (e) { this.actionError = e.message; }
      finally { this.actionLoading = false; }
    },

    async submitPayment(o) {
      if (!this.paymentTx) return;
      this.actionLoading = true; this.actionError = '';
      try {
        const res = await fetch('/api/exchange/submit-payment', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id, payment_tx: this.paymentTx, payment_chain: this.paymentChain }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); this.actionMode = null; this.paymentTx = ''; }
        else { this.actionError = data.error || 'Submit failed'; }
      } catch (e) { this.actionError = e.message; }
      finally { this.actionLoading = false; }
    },

    async disputeDeal(o) {
      if (!this.disputeReason) return;
      this.actionLoading = true; this.actionError = '';
      try {
        const res = await fetch('/api/exchange/dispute', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id, reason: this.disputeReason }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); this.actionMode = null; this.disputeReason = ''; }
        else { this.actionError = data.error || 'Dispute failed'; }
      } catch (e) { this.actionError = e.message; }
      finally { this.actionLoading = false; }
    },

    // ── Arbitrage Tab Methods ──

    async loadArbitrageData() {
      if (this.arbInitialized) return;
      this.arbInitialized = true;
      await Promise.all([this.loadBalances(), this.loadSpreads(), this.loadArbOffers(), this.loadHedgeHistory(), this.loadDailyUsage()]);
      // Auto-refresh spreads every 30s while tab is active
      setInterval(() => { if (this.activeTab === 'arb') this.loadSpreads(); }, 30000);
    },

    async loadBalances() {
      this.arbLoading.balances = true;
      try {
        const res = await fetch('/api/trade/balances?bust=' + Date.now());
        const data = await res.json();
        const accounts = await fetch('/api/trade/accounts').then(r => r.json());
        const defaultId = (accounts || []).find(a => a.is_default)?.id;
        this.cexBalances = (data.balances || []).map(b => ({ ...b, isDefault: b.accountId === defaultId }));
      } catch (e) {
        this.cexBalances = [{ exchange: 'error', kas: null, usdt: null, error: e.message }];
      } finally {
        this.arbLoading.balances = false;
      }
    },

    async loadSpreads() {
      this.arbLoading.spreads = true;
      try {
        const res = await fetch('/api/trade/spreads');
        const data = await res.json();
        this.spreadRows = data.spreads || [];
        this.spreadsCachedAt = data.cachedAt || null;
        this.fundedExchanges = data.funded_exchanges || [];
      } catch {
        this.spreadRows = [];
      } finally {
        this.arbLoading.spreads = false;
      }
    },

    async loadArbOffers() {
      try {
        const res = await fetch('/api/exchange/offers?limit=200');
        const data = await res.json();
        const allOffers = data.offers || [];
        this.arbOffers = allOffers.filter(o =>
          ['open', 'matched', 'verifying'].includes(o.protocol_status) && this.myAddresses.includes(o.maker)
        );
      } catch {
        this.arbOffers = [];
      }
    },

    async loadHedgeHistory() {
      this.arbLoading.hedges = true;
      try {
        const res = await fetch('/api/agent/activity-log?limit=200');
        const data = await res.json();
        const logs = data.log || data.events || data || [];
        const hedges = (Array.isArray(logs) ? logs : [])
          .filter(e => e.event_type && e.event_type.startsWith('hedge'))
          .slice(0, 20)
          .map(e => {
            const p = typeof e.payload === 'string' ? JSON.parse(e.payload || '{}') : (e.payload || {});
            return { ...e, side: p.side, qty: p.qty, price: p.price, exchange: p.exchange, error: p.error };
          });
        this.hedgeHistory = hedges;
      } catch {
        this.hedgeHistory = [];
      } finally {
        this.arbLoading.hedges = false;
      }
    },

    async loadDailyUsage() {
      this.arbLoading.usage = true;
      try {
        const res = await fetch('/api/trade/daily-usage');
        const data = await res.json();
        this.dailyUsage = data.exchanges || [];
        this.dailyTotal = data.total || null;
        this.dailyLimitInput = data.total?.limit_kas || 10000;
      } catch {
        this.dailyUsage = [];
        this.dailyTotal = null;
      } finally {
        this.arbLoading.usage = false;
      }
    },

    async saveDailyLimit() {
      const v = parseInt(this.dailyLimitInput);
      if (!v || v < 100) return;
      this.dailyLimitSaving = true;
      try {
        const res = await fetch('/api/trade/daily-limit', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ limit_kas: v }),
        });
        const data = await res.json();
        if (data.ok) await this.loadDailyUsage();
      } catch {}
      finally { this.dailyLimitSaving = false; }
    },

    arbAgentName(address) {
      const r = this.relays.find(r => r.address === address);
      return r ? r.name : (address ? address.slice(0, 14) + '...' : 'Unknown');
    },

    async cancelArbOffer(o) {
      if (!confirm('Cancel this offer?')) return;
      o._cancelling = true;
      try {
        const res = await fetch('/api/exchange/cancel', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadArbOffers(); await this.loadOffers(); }
      } catch {}
      finally { o._cancelling = false; }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

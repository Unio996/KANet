<%~ include('partials/page-open', { _page: 'exchange', pageTitle: 'Exchange', ...it }) %>

<div class="h-full flex flex-col" x-data="exchangeApp()">

  <!-- ═══ DISCOVERY BAR + WALLET ═══ -->
  <div class="flex-shrink-0 bg-white border-b border-warm-200 relative">
    <div class="px-5 py-2.5 flex items-center gap-5 text-xs overflow-x-auto">
      <!-- Market metrics -->
      <div class="flex items-center gap-1.5">
        <span class="text-ink-400">KAS</span>
        <span class="text-ink-700 font-semibold tabular-nums" x-text="kasPrice ? '$' + kasPrice.toFixed(5) : '—'"></span>
      </div>
      <div class="w-px h-4 bg-warm-200"></div>
      <div class="flex items-center gap-1.5">
        <span class="text-ink-400">Open</span>
        <span class="text-ink-600 font-medium tabular-nums" x-text="openOffers.length"></span>
      </div>
      <div x-show="overview.totalCompleted >= 5" class="flex items-center gap-1.5">
        <span class="text-ink-400">Settled</span>
        <span class="text-green-600 font-medium tabular-nums" x-text="overview.totalCompleted"></span>
      </div>
      <!-- Wallet summary (click to expand) -->
      <div class="w-px h-4 bg-warm-200"></div>
      <button @click="openWalletPanel('kas')" class="flex items-center gap-1 hover:text-brand-500 transition-colors">
        <span class="text-ink-400">KAS</span>
        <span class="font-semibold tabular-nums text-ink-700" x-text="(wallet.kas||0).toFixed(1)"></span>
        <span x-show="wallet.kasLocked>0" class="text-[10px] text-orange-500 tabular-nums" x-text="'('+(wallet.kasLocked||0).toFixed(1)+' locked)'"></span>
      </button>
      <template x-for="c in chainSummary" :key="c.chain">
        <button @click="openWalletPanel(c.chain)" class="flex items-center gap-1 hover:text-brand-500 transition-colors">
          <span class="text-ink-400 text-[10px]" x-text="c.name"></span>
          <span class="tabular-nums text-ink-600" x-text="((c.usdt||0)>0?(c.usdt||0).toFixed(2)+' USDT':'') + ((c.usdc||0)>0?((c.usdt||0)>0?' / ':'')+(c.usdc||0).toFixed(2)+' USDC':'') + ((c.usdt||0)===0&&(c.usdc||0)===0?'0 USDT':'')"></span>
          <span x-show="c.locked>0" class="text-[10px] text-orange-500 tabular-nums" x-text="'('+(c.locked||0).toFixed(2)+' locked)'"></span>
        </button>
      </template>
      <!-- Add wallet -->
      <button @click="showAddWallet = true" class="text-ink-400 hover:text-brand-500 transition-colors text-[11px] flex items-center gap-0.5">
        <span class="text-sm leading-none">+</span> Wallet
      </button>
      <!-- Agent selector -->
      <div class="ml-auto flex items-center gap-2">
        <select x-model="form.relayNodeId" @change="onAgentChange()"
          class="pl-2 pr-6 py-1 border border-warm-200 rounded text-xs bg-white">
          <template x-for="r in relays" :key="r.id">
            <option :value="r.id" x-text="r.name"></option>
          </template>
        </select>
      </div>
    </div>

    <!-- ═══ WALLET POPUP PANEL (below discovery bar) ═══ -->
    <div x-show="walletPanel" x-transition class="absolute top-full left-0 right-0 z-30 bg-white border-b border-warm-200 shadow-lg p-4 max-h-80 overflow-y-auto">
      <div class="flex items-center justify-between mb-3">
        <h4 class="text-sm font-semibold text-ink-700" x-text="walletPanel==='kas'?'Kaspa Wallet':(walletPanel?.toUpperCase()+' Wallets')"></h4>
        <button @click="walletPanel=null" class="text-ink-400 hover:text-ink-600 text-xs">Close</button>
      </div>

      <!-- KAS wallet detail -->
      <template x-if="walletPanel==='kas'">
        <div class="space-y-2 text-[12px]">
          <div class="flex items-center justify-between"><span class="text-ink-400">Address</span>
            <span class="text-[10px] text-brand-500 cursor-pointer tabular-nums" @click="copyAddr(agentAddr)" x-text="agentAddr" title="Click to copy"></span></div>
          <div class="flex items-center justify-between"><span class="text-ink-400">Balance</span><span class="font-semibold tabular-nums" x-text="(wallet.kas||0).toFixed(2)+' KAS'"></span></div>
          <div x-show="wallet.kasLocked>0" class="flex items-center justify-between"><span class="text-ink-400">Locked</span><span class="tabular-nums text-orange-600" x-text="(wallet.kasLocked||0).toFixed(2)+' KAS'"></span></div>
          <div class="flex items-center justify-between"><span class="text-ink-400">Available</span><span class="tabular-nums text-green-600" x-text="((wallet.kas||0)-(wallet.kasLocked||0)).toFixed(2)+' KAS'"></span></div>
          <div x-data="{showSend:false,sendAddr:'',sendAmt:''}" class="mt-2">
            <button @click="showSend=!showSend" class="text-[11px] text-brand-500 hover:text-brand-700">Withdraw KAS</button>
            <div x-show="showSend" class="mt-2 space-y-2">
              <input x-model="sendAddr" placeholder="Target kaspa:q... address" class="w-full border border-warm-300 rounded px-2 py-1.5 text-[11px] bg-warm-50 focus:border-brand-400 focus:outline-none" />
              <input x-model.number="sendAmt" placeholder="Amount (KAS)" type="number" class="w-full border border-warm-300 rounded px-2 py-1.5 text-[11px] bg-warm-50 focus:border-brand-400 focus:outline-none" />
              <button @click="$dispatch('send-kas',{addr:sendAddr,amt:sendAmt})" class="w-full py-1.5 rounded bg-red-50 text-red-600 border border-red-200 text-[11px] font-semibold hover:bg-red-100">Send</button>
            </div>
          </div>
        </div>
      </template>

      <!-- Multi-chain wallet detail -->
      <template x-if="walletPanel && walletPanel!=='kas'">
        <div class="space-y-3">
          <template x-for="w in panelWallets" :key="w.id||w.address">
            <div class="p-3 rounded-lg border border-warm-200 bg-warm-50">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-brand-500 cursor-pointer tabular-nums" @click="copyAddr(w.address)" x-text="w.address" title="Click to copy"></span>
                <span x-show="w.isDefault" class="text-[9px] bg-brand-50 text-brand-600 px-1.5 py-0.5 rounded">default</span>
              </div>
              <div class="grid grid-cols-4 gap-2 text-[11px]">
                <div><span class="text-ink-400">USDT</span><div class="font-medium tabular-nums text-ink-700" x-text="(w.usdt||0).toFixed(2)"></div></div>
                <div><span class="text-ink-400">USDC</span><div class="font-medium tabular-nums text-ink-700" x-text="(w.usdc||0).toFixed(2)"></div></div>
                <div><span class="text-ink-400" x-text="w.chain==='polygon'?'MATIC':w.chain==='bnb'?'BNB':w.chain==='eth'?'ETH':w.chain==='sol'?'SOL':w.chain==='tron'?'TRX':w.chain?.toUpperCase()"></span><div class="font-medium tabular-nums text-ink-700" x-text="(w.gas||0).toFixed(4)"></div></div>
                <div x-show="w.locked>0"><span class="text-ink-400">Locked</span><div class="font-medium tabular-nums text-orange-600" x-text="(w.locked||0).toFixed(2)+' USDT'"></div></div>
              </div>
              <div class="flex gap-2 mt-2">
                <button @click="copyAddr(w.address)" class="px-2 py-1 rounded text-[10px] bg-warm-100 text-ink-400 hover:text-ink-700 border border-warm-200">Copy</button>
                <button @click="withdrawPrompt(w)" class="px-2 py-1 rounded text-[10px] bg-warm-100 text-ink-400 hover:text-red-600 border border-warm-200">Withdraw</button>
                <button @click="showPrivkeyFor(w)" class="px-2 py-1 rounded text-[10px] bg-warm-100 text-ink-400 hover:text-orange-600 border border-warm-200">Private Key</button>
              </div>
            </div>
          </template>
          <button @click="createWallet(walletPanel)" class="w-full py-2 rounded-lg border border-dashed border-warm-300 text-[11px] text-ink-400 hover:text-brand-500 hover:border-brand-300 transition-all">
            + Create new <span x-text="walletPanel?.toUpperCase()"></span> wallet
          </button>
        </div>
      </template>
    </div>
  </div>

  <!-- ═══ SPLIT PANE ═══ -->
  <div class="flex-1 flex min-h-0">

    <!-- ── LEFT PANE (360px) ── -->
    <div class="w-[360px] flex-shrink-0 border-r border-warm-200 flex flex-col bg-white
                max-md:w-full" :class="selectedOffer && 'max-md:hidden'">

      <!-- Left tabs -->
      <div class="flex border-b border-warm-200 flex-shrink-0">
        <button @click="leftTab = 'market'"
          :class="leftTab === 'market' ? 'border-brand-500 text-brand-600 font-medium' : 'border-transparent text-ink-400 hover:text-ink-600'"
          class="flex-1 px-3 py-2.5 text-xs border-b-2 -mb-px transition-colors">Market</button>
        <button @click="leftTab = 'deals'"
          :class="leftTab === 'deals' ? 'border-brand-500 text-brand-600 font-medium' : 'border-transparent text-ink-400 hover:text-ink-600'"
          class="flex-1 px-3 py-2.5 text-xs border-b-2 -mb-px transition-colors flex items-center justify-center gap-1">
          My Deals
          <span x-show="activeDeals.length" class="bg-brand-500 text-white text-[9px] leading-none px-1.5 py-0.5 rounded-full"
            x-text="activeDeals.length"></span>
        </button>
        <button @click="leftTab = 'history'"
          :class="leftTab === 'history' ? 'border-brand-500 text-brand-600 font-medium' : 'border-transparent text-ink-400 hover:text-ink-600'"
          class="flex-1 px-3 py-2.5 text-xs border-b-2 -mb-px transition-colors">History</button>
      </div>

      <!-- Offer list -->
      <div class="flex-1 overflow-y-auto">

        <!-- Loading -->
        <div x-show="loading" class="p-8 text-center text-ink-400 text-xs">Loading offers...</div>

        <!-- MARKET tab: open offers sorted by price -->
        <div x-show="leftTab === 'market' && !loading">
          <!-- Empty state -->
          <div x-show="openOffers.length === 0" class="p-8 text-center">
            <div class="text-ink-400 text-sm mb-1">No open offers</div>
            <template x-if="lastCompleted">
              <div class="text-xs text-ink-400 mb-4">
                Last trade: <span class="text-green-600 font-medium" x-text="lastCompleted.give_amount + ' ' + lastCompleted.give_asset"></span>
                settled <span x-text="KANet.relativeTime(lastCompleted.completed_at)"></span>
              </div>
            </template>
            <button @click="showForm = true" class="text-xs text-brand-500 hover:text-brand-700 font-medium">Be the first maker</button>
          </div>
          <!-- Offer list items -->
          <template x-for="o in openOffers" :key="o.id">
            <div @click="selectOffer(o)" class="px-4 py-3 border-b border-warm-100 cursor-pointer transition-colors"
              :class="selectedOffer?.id === o.id ? 'bg-brand-50 border-l-2 border-l-brand-500' : 'hover:bg-warm-50 border-l-2 border-l-transparent'">
              <!-- Row 1: side + amount + price -->
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded"
                  :class="o.give_asset === 'KAS' ? 'bg-red-100 text-red-600' : 'bg-green-100 text-green-700'"
                  x-text="o.give_asset === 'KAS' ? 'SELL' : 'BUY'"></span>
                <span class="text-sm font-semibold text-ink-700 tabular-nums" x-text="o.give_amount + ' ' + o.give_asset"></span>
                <span class="text-ink-300 text-xs">&rarr;</span>
                <span class="text-sm text-ink-600 tabular-nums" x-text="o.want_amount + ' ' + o.want_asset"></span>
              </div>
              <!-- Row 2: price badge + chains + countdown -->
              <div class="flex items-center gap-2 mt-1.5">
                <template x-if="priceComparison(o)">
                  <span class="text-[10px] font-medium tabular-nums" :class="priceColor(o)"
                    x-text="'$' + priceComparison(o).offerPrice.toFixed(5) + ' (' + (priceComparison(o).diffPct >= 0 ? '+' : '') + priceComparison(o).diffPct + '%)'"></span>
                </template>
                <template x-for="ch in getChains(o)" :key="ch">
                  <span class="text-[9px] px-1 py-0.5 bg-warm-100 text-ink-500 rounded uppercase" x-text="ch"></span>
                </template>
                <span class="ml-auto text-[10px] text-ink-400 tabular-nums" x-text="KANet.countdown(o.expires_at)"></span>
              </div>
              <!-- Row 3: maker + reputation + role -->
              <div class="flex items-center gap-2 mt-1 flex-wrap">
                <span class="text-[10px] text-ink-400 font-mono" x-text="KANet.shortAddr(o.maker)"></span>
                <template x-if="getReputation(o.maker)">
                  <span class="text-[10px] text-yellow-500" x-text="KANet.starRating(getReputation(o.maker).stars)"></span>
                </template>
                <template x-if="getReputation(o.maker)">
                  <span class="text-[9px] px-1.5 py-0.5 rounded-full font-medium"
                    :class="KANet.riskBadge(getReputation(o.maker).risk).css"
                    x-text="getReputation(o.maker).totalTrades === 0 ? 'New' : getReputation(o.maker).completed + ' trades'"></span>
                </template>
                <span x-show="isMaker(o)" class="text-[9px] px-1 py-0.5 bg-brand-50 text-brand-600 rounded font-medium">you</span>
              </div>
            </div>
          </template>
        </div>

        <!-- MY DEALS tab: active deals where I am maker or taker -->
        <div x-show="leftTab === 'deals' && !loading">
          <div x-show="activeDeals.length === 0" class="p-8 text-center text-ink-400 text-xs">No active deals</div>
          <template x-for="o in activeDeals" :key="o.id">
            <div @click="selectOffer(o)" class="px-4 py-3 border-b border-warm-100 cursor-pointer transition-colors"
              :class="selectedOffer?.id === o.id ? 'bg-brand-50 border-l-2 border-l-brand-500' : 'hover:bg-warm-50 border-l-2 border-l-transparent'">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded"
                  :class="isMaker(o) ? 'bg-brand-50 text-brand-600' : 'bg-green-50 text-green-700'"
                  x-text="isMaker(o) ? 'MAKER' : 'TAKER'"></span>
                <span class="text-sm font-semibold text-ink-700 tabular-nums" x-text="o.give_amount + ' ' + o.give_asset + ' → ' + o.want_amount + ' ' + o.want_asset"></span>
              </div>
              <div class="flex items-center gap-2 mt-1.5">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium" :class="statusBadge(o.protocol_status)"
                  x-text="statusLabel(o.protocol_status)"></span>
                <span class="text-[10px] text-ink-400" x-text="KANet.relativeTime(o.matched_at || o.broadcast_at)"></span>
              </div>
            </div>
          </template>
        </div>

        <!-- HISTORY tab: terminal state offers -->
        <div x-show="leftTab === 'history' && !loading">
          <div x-show="completedDeals.length === 0" class="p-8 text-center text-ink-400 text-xs">No history yet</div>
          <template x-for="o in pagedHistory" :key="o.id">
            <div @click="selectOffer(o)" class="px-4 py-3 border-b border-warm-100 cursor-pointer transition-colors"
              :class="selectedOffer?.id === o.id ? 'bg-brand-50 border-l-2 border-l-brand-500' : 'hover:bg-warm-50 border-l-2 border-l-transparent'">
              <div class="flex items-center gap-2">
                <span class="text-sm text-ink-600 tabular-nums" x-text="o.give_amount + ' ' + o.give_asset + ' → ' + o.want_amount + ' ' + o.want_asset"></span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium" :class="statusBadge(o.protocol_status)"
                  x-text="statusLabel(o.protocol_status)"></span>
              </div>
              <div class="text-[10px] text-ink-400 mt-1" x-text="KANet.relativeTime(o.completed_at || o.timed_out_at || o.cancelled_at || o.updated_at)"></div>
            </div>
          </template>
          <!-- Pagination -->
          <div x-show="historyTotalPages > 1" class="flex items-center justify-center gap-3 py-3 text-xs text-ink-400">
            <button @click="historyPage = Math.max(1, historyPage - 1)" :disabled="historyPage <= 1"
              class="px-2 py-1 rounded hover:bg-warm-100 disabled:opacity-30">&larr;</button>
            <span x-text="historyPage + ' / ' + historyTotalPages"></span>
            <button @click="historyPage = Math.min(historyTotalPages, historyPage + 1)" :disabled="historyPage >= historyTotalPages"
              class="px-2 py-1 rounded hover:bg-warm-100 disabled:opacity-30">&rarr;</button>
          </div>
        </div>
      </div>

      <!-- Publish button (fixed at bottom of left pane) -->
      <div class="flex-shrink-0 p-3 border-t border-warm-200">
        <button @click="showForm = !showForm"
          class="w-full py-2.5 bg-brand-500 text-white rounded-lg text-xs font-semibold hover:bg-brand-600 transition-colors">
          + Publish Offer
        </button>
      </div>
    </div>

    <!-- ── RIGHT PANE ── -->
    <div class="flex-1 overflow-y-auto bg-warm-50
                max-md:w-full" :class="!selectedOffer && 'max-md:hidden'">

      <!-- Mobile back button -->
      <button x-show="selectedOffer" @click="selectedOffer = null"
        class="md:hidden flex items-center gap-1 px-4 py-2 text-xs text-brand-500 border-b border-warm-200 w-full bg-white">
        &larr; Back to list
      </button>

      <!-- Empty state -->
      <div x-show="!selectedOffer && !showForm" class="flex items-center justify-center h-full">
        <div class="text-center py-20">
          <div class="text-4xl mb-3 opacity-30">&#9878;</div>
          <div class="text-sm text-ink-400">Select an offer to view details</div>
          <div class="text-xs text-ink-300 mt-1">or publish your own</div>
        </div>
      </div>

      <!-- ── PUBLISH FORM ── -->
      <div x-show="showForm && !selectedOffer" class="p-6 max-w-lg mx-auto">
        <div class="bg-white border border-warm-200 rounded-xl p-6">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-sm font-semibold text-ink-700">Publish Offer</h3>
            <button @click="showForm = false" class="text-ink-400 hover:text-ink-600 text-xs">Close</button>
          </div>
          <!-- Market price reference -->
          <div x-show="kasPrice" class="mb-5 bg-warm-50 rounded-lg px-4 py-2.5 text-xs flex items-center justify-between">
            <span class="text-ink-500">Market: <span class="font-semibold text-ink-700" x-text="'$' + (kasPrice||0).toFixed(5) + '/KAS'"></span></span>
            <span x-show="formPriceDiff() !== null" class="font-medium"
              :class="Math.abs(formPriceDiff()) < 0.3 ? 'text-ink-500' : (formPriceDiff() > 2 ? 'text-red-500' : 'text-green-600')"
              x-text="formPriceDiff() !== null ? ((formPriceDiff() >= 0 ? '+' : '') + formPriceDiff().toFixed(1) + '%') : ''"></span>
          </div>
          <!-- Quick templates -->
          <div class="flex gap-2 mb-4">
            <button @click="fillSellTemplate()" class="px-3 py-1.5 bg-red-50 text-red-600 rounded text-xs font-medium hover:bg-red-100">Sell KAS</button>
            <button @click="fillBuyTemplate()" class="px-3 py-1.5 bg-green-50 text-green-600 rounded text-xs font-medium hover:bg-green-100">Buy KAS</button>
          </div>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-[10px] font-medium text-ink-500 uppercase tracking-wider mb-1">I give</label>
              <div class="flex gap-2">
                <input x-model="form.give_amount" type="text" placeholder="Amount"
                  class="flex-1 px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
                <input x-model="form.give_asset" type="text" placeholder="KAS"
                  class="w-20 px-3 py-2 border border-warm-200 rounded-lg text-sm uppercase focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-medium text-ink-500 uppercase tracking-wider mb-1">I want</label>
              <div class="flex gap-2">
                <input x-model="form.want_amount" type="text" placeholder="Amount"
                  class="flex-1 px-3 py-2 border border-warm-200 rounded-lg text-sm focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
                <input x-model="form.want_asset" type="text" placeholder="USDT"
                  class="w-20 px-3 py-2 border border-warm-200 rounded-lg text-sm uppercase focus:ring-1 focus:ring-brand-300 focus:border-brand-300" />
              </div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 mb-5">
            <div>
              <label class="block text-[10px] font-medium text-ink-500 uppercase tracking-wider mb-1">Verification</label>
              <select x-model="form.verification" class="w-full px-3 py-2 border border-warm-200 rounded-lg text-sm">
                <option value="cross_chain_tx">Cross-chain TX</option>
                <option value="kaspa_tx">Kaspa TX</option>
                <option value="manual">Manual</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-medium text-ink-500 uppercase tracking-wider mb-1">Expires</label>
              <select x-model="form.expires_minutes" class="w-full px-3 py-2 border border-warm-200 rounded-lg text-sm">
                <option value="30">30 min</option>
                <option value="60" selected>1 hour</option>
                <option value="360">6 hours</option>
              </select>
            </div>
          </div>
          <div x-show="formError" class="text-xs text-red-600 mb-3" x-text="formError"></div>
          <div x-show="formSuccess" class="text-xs text-green-600 mb-3" x-text="formSuccess"></div>
          <button @click="publishOffer()" :disabled="publishing"
            class="w-full py-2.5 bg-brand-500 text-white rounded-lg text-sm font-semibold hover:bg-brand-600 disabled:opacity-50 transition-colors">
            <span x-show="!publishing">Publish</span>
            <span x-show="publishing">Broadcasting...</span>
          </button>
        </div>
      </div>

      <!-- ── DEAL DETAIL ── -->
      <div x-show="selectedOffer" class="p-6 max-w-2xl">

        <!-- Deal header -->
        <div class="mb-5">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold px-2 py-1 rounded"
              :class="selectedOffer?.give_asset === 'KAS' ? 'bg-red-100 text-red-600' : 'bg-green-100 text-green-700'"
              x-text="selectedOffer?.give_asset === 'KAS' ? 'SELL' : 'BUY'"></span>
            <span class="text-xl font-bold text-ink-700 tabular-nums"
              x-text="(selectedOffer?.give_amount || '') + ' ' + (selectedOffer?.give_asset || '')"></span>
            <span class="text-ink-300">&rarr;</span>
            <span class="text-xl font-bold text-ink-700 tabular-nums"
              x-text="(selectedOffer?.want_amount || '') + ' ' + (selectedOffer?.want_asset || '')"></span>
          </div>
          <div class="flex items-center gap-3 mt-2 text-xs text-ink-400">
            <template x-if="selectedOffer && priceComparison(selectedOffer)">
              <span class="font-medium tabular-nums" :class="priceColor(selectedOffer)"
                x-text="'$' + priceComparison(selectedOffer).offerPrice.toFixed(5) + '/KAS (' + (priceComparison(selectedOffer).diffPct >= 0 ? '+' : '') + priceComparison(selectedOffer).diffPct + '% vs market)'"></span>
            </template>
            <span class="flex items-center gap-1.5">
              Maker: <span class="font-mono" x-text="KANet.shortAddr(selectedOffer?.maker || '')"></span>
              <template x-if="selectedOffer && getReputation(selectedOffer.maker)">
                <span class="text-yellow-500" x-text="KANet.starRating(getReputation(selectedOffer.maker).stars)"></span>
              </template>
              <template x-if="selectedOffer && getReputation(selectedOffer.maker)">
                <span class="px-1.5 py-0.5 rounded-full text-[10px] font-medium"
                  :class="KANet.riskBadge(getReputation(selectedOffer.maker).risk).css"
                  x-text="KANet.riskBadge(getReputation(selectedOffer.maker).risk).text"></span>
              </template>
            </span>
            <span x-show="selectedOffer?.taker">Taker: <span class="font-mono" x-text="KANet.shortAddr(selectedOffer?.taker || '')"></span></span>
          </div>
        </div>

        <!-- Pipeline stepper -->
        <div class="bg-white border border-warm-200 rounded-xl p-5 mb-4">
          <div class="flex items-center justify-between mb-4">
            <template x-for="(step, i) in getTimeline(selectedOffer || {})" :key="i">
              <div class="flex items-center" :class="i > 0 && 'flex-1'">
                <div x-show="i > 0" class="flex-1 h-px mx-2" :class="step.done ? 'bg-green-400' : 'bg-warm-200'"></div>
                <div class="flex flex-col items-center gap-1">
                  <div class="w-3 h-3 rounded-full flex-shrink-0 transition-all"
                    :class="step.done ? 'bg-green-500' : (step.active ? 'bg-brand-500 ring-4 ring-brand-100 animate-pulse' : 'bg-warm-300')"></div>
                  <span class="text-[9px] whitespace-nowrap" :class="step.done || step.active ? 'text-ink-600 font-medium' : 'text-ink-400'" x-text="step.label"></span>
                </div>
              </div>
            </template>
          </div>
          <!-- Step detail (timestamp + info) -->
          <template x-for="(step, i) in getTimeline(selectedOffer || {})" :key="'d'+i">
            <div x-show="step.time || step.detail" class="text-[10px] text-ink-400 flex items-center gap-2 mt-1">
              <span class="font-medium text-ink-500" x-text="step.label + ':'"></span>
              <span x-show="step.time" x-text="KANet.relativeTime(step.time)"></span>
              <span x-show="step.detail" class="text-ink-500" x-text="step.detail"></span>
            </div>
          </template>
        </div>

        <!-- Trust information -->
        <div class="bg-white border border-warm-200 rounded-xl p-5 mb-4">
          <!-- Lock status -->
          <div class="flex items-start gap-3 mb-3">
            <div class="text-xl mt-0.5" x-text="selectedOffer?.protocol_status !== 'open' || isMaker(selectedOffer) ? '&#128274;' : '&#128275;'"
              :class="selectedOffer?.protocol_status !== 'open' ? 'opacity-100' : 'opacity-40'"></div>
            <div>
              <!-- Maker viewing own offer -->
              <template x-if="selectedOffer && isMaker(selectedOffer) && selectedOffer.protocol_status === 'open'">
                <div>
                  <div class="text-sm font-medium text-ink-700">Your <span x-text="selectedOffer.give_amount + ' ' + selectedOffer.give_asset"></span> is locked</div>
                  <div class="text-xs text-ink-400 mt-0.5">Visible to potential takers. Expires <span x-text="KANet.countdown(selectedOffer.expires_at)"></span>.</div>
                </div>
              </template>
              <!-- Maker viewing matched offer -->
              <template x-if="selectedOffer && isMaker(selectedOffer) && ['matched','verifying','delivering'].includes(selectedOffer.protocol_status)">
                <div>
                  <div class="text-sm font-medium text-ink-700">Your <span x-text="selectedOffer.give_amount + ' ' + selectedOffer.give_asset"></span> is locked</div>
                  <div class="text-xs text-ink-400 mt-0.5">Buyer is paying. If no payment in 30 minutes, your KAS will be auto-released.</div>
                </div>
              </template>
              <!-- Taker viewing open offer -->
              <template x-if="selectedOffer && !isMine(selectedOffer) && selectedOffer.protocol_status === 'open'">
                <div>
                  <div class="text-sm font-medium text-green-700">Seller has locked <span x-text="selectedOffer.give_amount + ' ' + selectedOffer.give_asset"></span> in escrow</div>
                  <div class="text-xs text-ink-400 mt-0.5">System will verify your payment and deliver automatically.</div>
                </div>
              </template>
              <!-- Taker viewing active deal -->
              <template x-if="selectedOffer && isTaker(selectedOffer) && ['matched','verifying','delivering'].includes(selectedOffer.protocol_status)">
                <div>
                  <div class="text-sm font-medium text-ink-700">Trade in progress</div>
                  <div class="text-xs text-ink-400 mt-0.5" x-text="selectedOffer.protocol_status === 'verifying' ? 'Verifying your payment on-chain...' : (selectedOffer.protocol_status === 'delivering' ? 'Delivering KAS to your wallet...' : 'Awaiting payment...')"></div>
                </div>
              </template>
              <!-- Completed -->
              <template x-if="selectedOffer && selectedOffer.protocol_status === 'completed'">
                <div>
                  <div class="text-sm font-medium text-green-700">Trade completed</div>
                  <div class="text-xs text-ink-400 mt-0.5" x-text="'Settled ' + KANet.relativeTime(selectedOffer.completed_at)"></div>
                </div>
              </template>
              <!-- Timed out -->
              <template x-if="selectedOffer && selectedOffer.protocol_status === 'timed_out'">
                <div>
                  <div class="text-sm font-medium text-amber-600">Timed out</div>
                  <div class="text-xs text-ink-400 mt-0.5">Buyer did not pay in time. KAS has been released.</div>
                </div>
              </template>
              <!-- Disputed -->
              <template x-if="selectedOffer && selectedOffer.protocol_status === 'disputed'">
                <div>
                  <div class="text-sm font-medium text-red-600">Disputed</div>
                  <div class="text-xs text-ink-400 mt-0.5">Your funds are protected. Awaiting resolution.</div>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- On-chain proof — every step has TX -->
        <div x-show="selectedOffer?.broadcast_tx_id && !selectedOffer?.broadcast_tx_id?.startsWith('pending_')"
          class="bg-white border border-warm-200 rounded-xl p-5 mb-4">
          <div class="text-[10px] font-semibold text-ink-400 uppercase tracking-wider mb-3">On-chain Proof</div>
          <div class="space-y-2 text-[10px]">
            <!-- Publish TX (Kaspa) -->
            <div x-show="selectedOffer?.broadcast_tx_id && !selectedOffer?.broadcast_tx_id?.startsWith('pending_')" class="flex items-center gap-2">
              <span class="text-ink-400 w-16 flex-shrink-0">Publish</span>
              <a :href="KANet.explorerTxUrl('kaspa', selectedOffer?.broadcast_tx_id)" target="_blank" rel="noopener"
                class="text-brand-500 hover:text-brand-700 font-mono truncate" x-text="selectedOffer?.broadcast_tx_id"></a>
              <button @click="KANet.copy(selectedOffer?.broadcast_tx_id)" class="text-ink-300 hover:text-brand-500 flex-shrink-0" title="Copy">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
            </div>
            <!-- Accept TX (Kaspa) -->
            <div x-show="selectedOffer?.taker_tx_id && !selectedOffer?.taker_tx_id?.startsWith('pending_')" class="flex items-center gap-2">
              <span class="text-ink-400 w-16 flex-shrink-0">Accept</span>
              <a :href="KANet.explorerTxUrl('kaspa', selectedOffer?.taker_tx_id)" target="_blank" rel="noopener"
                class="text-brand-500 hover:text-brand-700 font-mono truncate" x-text="selectedOffer?.taker_tx_id"></a>
              <button @click="KANet.copy(selectedOffer?.taker_tx_id)" class="text-ink-300 hover:text-brand-500 flex-shrink-0" title="Copy">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
            </div>
            <!-- Payment TX (cross-chain: BNB/ETH/SOL/TRON) -->
            <div x-show="getPaymentTx(selectedOffer || {})" class="flex items-center gap-2">
              <span class="text-ink-400 w-16 flex-shrink-0">Payment</span>
              <a :href="KANet.explorerTxUrl(selectedOffer?.taker_chain || 'kaspa', getPaymentTx(selectedOffer || {}))" target="_blank" rel="noopener"
                class="text-brand-500 hover:text-brand-700 font-mono truncate" x-text="getPaymentTx(selectedOffer || {})"></a>
              <button @click="KANet.copy(getPaymentTx(selectedOffer || {}))" class="text-ink-300 hover:text-brand-500 flex-shrink-0" title="Copy">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
              <span class="text-ink-300 uppercase" x-text="selectedOffer?.taker_chain || ''"></span>
            </div>
          </div>
        </div>

        <!-- ── INLINE ACCEPT (for open offers not mine) ── -->
        <div x-show="selectedOffer?.protocol_status === 'open' && !isMine(selectedOffer)"
          class="bg-white border-2 border-green-200 rounded-xl p-5 mb-4">
          <div class="text-xs font-semibold text-ink-600 uppercase tracking-wider mb-4">Accept This Offer</div>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="bg-green-50 rounded-lg p-3 text-center">
              <div class="text-[10px] text-green-600 uppercase font-medium mb-1">You receive</div>
              <div class="text-lg font-bold text-green-700" x-text="(selectedOffer?.give_amount || '') + ' ' + (selectedOffer?.give_asset || '')"></div>
            </div>
            <div class="bg-red-50 rounded-lg p-3 text-center">
              <div class="text-[10px] text-red-500 uppercase font-medium mb-1">You pay</div>
              <div class="text-lg font-bold text-red-600" x-text="(selectedOffer?.want_amount || '') + ' ' + (selectedOffer?.want_asset || '')"></div>
            </div>
          </div>
          <!-- Chain selection -->
          <template x-if="getChains(selectedOffer).length > 0">
            <div class="mb-4">
              <label class="block text-[10px] font-medium text-ink-500 uppercase tracking-wider mb-2">Payment chain</label>
              <div class="flex gap-2">
                <template x-for="ch in getChains(selectedOffer)" :key="ch">
                  <button @click="acceptChain = ch; loadChainBalance(ch)"
                    class="px-3 py-2 rounded-lg border text-xs font-medium uppercase transition-colors"
                    :class="acceptChain === ch ? 'border-brand-500 bg-brand-50 text-brand-700' : 'border-warm-200 text-ink-500 hover:border-brand-300'">
                    <span x-text="ch"></span>
                  </button>
                </template>
              </div>
            </div>
          </template>
          <!-- Token selection (P2a: multi-token support) -->
          <template x-if="getChains(selectedOffer).length > 0 && acceptChain">
            <div class="mb-4">
              <label class="block text-[10px] font-medium text-ink-500 uppercase tracking-wider mb-2">Pay with</label>
              <div class="flex gap-2">
                <template x-for="tk in ['usdt','usdc','dai']" :key="tk">
                  <button @click="acceptPaymentAsset = tk"
                    class="px-3 py-2 rounded-lg border text-xs font-medium uppercase transition-colors"
                    :class="acceptPaymentAsset === tk ? 'border-brand-500 bg-brand-50 text-brand-700' : 'border-warm-200 text-ink-500 hover:border-brand-300'"
                    x-text="tk"></button>
                </template>
              </div>
            </div>
          </template>
          <!-- Balance check -->
          <div x-show="acceptBalance !== null" class="mb-4 px-4 py-2.5 rounded-lg text-xs"
            :class="acceptBalanceOk ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-600'">
            <span x-text="(acceptChain || '').toUpperCase()"></span> wallet:
            <span class="font-semibold" x-text="acceptBalance?.toFixed(2) + ' ' + (acceptPaymentAsset || 'USDT').toUpperCase()"></span>
            <span x-text="acceptBalanceOk ? ' — sufficient' : ' — insufficient'"></span>
          </div>
          <div class="text-[10px] text-ink-400 mb-4">System will auto-pay from your wallet after confirmation.</div>
          <div x-show="acceptError" class="text-xs text-red-600 mb-3" x-text="acceptError"></div>
          <button @click="confirmAccept()"
            :disabled="acceptLoading || (getChains(selectedOffer).length > 0 && !acceptChain) || (acceptBalance !== null && !acceptBalanceOk)"
            class="w-full py-3 bg-green-500 text-white rounded-lg text-sm font-semibold hover:bg-green-600 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
            <span x-show="!acceptLoading">Accept Offer</span>
            <span x-show="acceptLoading">Processing...</span>
          </button>
        </div>

        <!-- ── CANCEL (my open offer) ── -->
        <div x-show="selectedOffer?.protocol_status === 'open' && isMaker(selectedOffer)" class="mb-4">
          <button @click="cancelOffer(selectedOffer)"
            class="px-4 py-2 bg-warm-200 text-ink-600 rounded-lg text-xs font-medium hover:bg-warm-300 transition-colors">Cancel Offer</button>
        </div>

        <!-- ── DEAL ACTIONS (matched/verifying) ── -->
        <div x-show="selectedOffer && canConfirm(selectedOffer)" class="mb-4">
          <button @click="confirmDeal(selectedOffer)" :disabled="actionLoading"
            class="px-4 py-2.5 bg-green-500 text-white rounded-lg text-xs font-semibold hover:bg-green-600 disabled:opacity-50 transition-colors">
            Confirm Delivery
          </button>
        </div>

        <!-- Dispute -->
        <div x-show="selectedOffer && canDispute(selectedOffer)" class="mb-4">
          <div x-show="!showDispute">
            <button @click="showDispute = true" class="text-xs text-red-500 hover:text-red-700">Raise dispute</button>
          </div>
          <div x-show="showDispute" class="bg-red-50 border border-red-200 rounded-lg p-4">
            <input x-model="disputeReason" type="text" placeholder="Reason for dispute"
              class="w-full px-3 py-2 border border-red-200 rounded text-xs bg-white mb-2" />
            <div class="flex gap-2">
              <button @click="disputeDeal(selectedOffer)" :disabled="!disputeReason || actionLoading"
                class="px-3 py-1.5 bg-red-500 text-white rounded text-xs font-medium disabled:opacity-50">Confirm Dispute</button>
              <button @click="showDispute = false" class="px-3 py-1.5 text-xs text-ink-400">Cancel</button>
            </div>
          </div>
        </div>

        <div x-show="actionError" class="text-xs text-red-600 mb-3" x-text="actionError"></div>
      </div>
    </div>
  </div>

  <!-- ═══ OPERATOR TOOLS (collapsible) ═══ -->
  <div class="flex-shrink-0 border-t border-warm-200" x-data="{ opsOpen: false }">
    <button @click="opsOpen = !opsOpen; if (opsOpen && !arbInitialized) loadArbitrageData(); if (opsOpen) { loadSeedData(); loadLimits(); }"
      class="w-full px-5 py-2.5 text-xs text-ink-400 hover:text-ink-600 flex items-center gap-2 transition-colors">
      <span :class="opsOpen && 'rotate-90'" class="transition-transform">&#9654;</span>
      Operator Tools
    </button>
    <div x-show="opsOpen" x-transition class="border-t border-warm-100">
      <!-- Arb/Seed sub-tabs -->
      <div class="flex border-b border-warm-200 px-5">
        <button @click="opsTab = 'arb'"
          :class="opsTab === 'arb' ? 'border-brand-500 text-brand-600' : 'border-transparent text-ink-400'"
          class="px-3 py-2 text-xs border-b-2 -mb-px">Arbitrage</button>
        <button @click="opsTab = 'seed'"
          :class="opsTab === 'seed' ? 'border-brand-500 text-brand-600' : 'border-transparent text-ink-400'"
          class="px-3 py-2 text-xs border-b-2 -mb-px">Seeder</button>
      </div>
      <div class="p-5 max-h-[32rem] overflow-y-auto">
        <!-- Arb content placeholder — preserved from existing -->
        <div x-show="opsTab === 'arb'" class="text-xs text-ink-500">
          <div class="grid grid-cols-3 gap-4 mb-4">
            <template x-for="b in cexBalances" :key="b.exchange">
              <div class="bg-white border border-warm-200 rounded-lg p-3">
                <div class="font-medium text-ink-600" x-text="b.exchange"></div>
                <div class="tabular-nums" x-text="(b.kas != null ? Number(b.kas).toFixed(1) + ' KAS' : '—')"></div>
                <div class="tabular-nums" x-text="(b.usdt != null ? '$' + Number(b.usdt).toFixed(2) : '—')"></div>
              </div>
            </template>
          </div>
          <div class="text-ink-400">Full arbitrage dashboard available in /trading page.</div>
        </div>
        <!-- Seed + Limits + Asset Status -->
        <div x-show="opsTab === 'seed'" class="text-xs text-ink-500 space-y-4">
          <!-- Seeder Controls -->
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" :checked="seedConfig.enabled" @change="toggleSeeder()" class="rounded" />
              <span>Seeder enabled</span>
            </label>
            <button @click="triggerSeed()" :disabled="seedTriggering"
              class="px-3 py-1 bg-brand-500 text-white rounded text-xs disabled:opacity-50">
              <span x-show="!seedTriggering">Seed Now</span>
              <span x-show="seedTriggering">Seeding...</span>
            </button>
          </div>

          <!-- Today Stats -->
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-white border border-warm-200 rounded-lg p-2.5 text-center">
              <div class="text-lg font-semibold text-ink-700" x-text="seedStats.seeded || 0"></div>
              <div class="text-ink-400">Published</div>
            </div>
            <div class="bg-white border border-warm-200 rounded-lg p-2.5 text-center">
              <div class="text-lg font-semibold text-green-600" x-text="seedStats.taken || 0"></div>
              <div class="text-ink-400">Taken</div>
            </div>
            <div class="bg-white border border-warm-200 rounded-lg p-2.5 text-center">
              <div class="text-lg font-semibold" :class="(seedStats.net_usdt || 0) >= 0 ? 'text-green-600' : 'text-red-500'"
                x-text="(seedStats.net_usdt >= 0 ? '+$' : '-$') + Math.abs(seedStats.net_usdt || 0).toFixed(2)"></div>
              <div class="text-ink-400">Net P&L</div>
            </div>
          </div>

          <!-- Asset Status -->
          <div class="bg-warm-50 border border-warm-200 rounded-lg p-3">
            <div class="font-medium text-ink-600 mb-2">Asset Status</div>
            <div class="grid grid-cols-2 gap-2">
              <div class="flex justify-between">
                <span class="text-ink-400">KAS Balance</span>
                <span class="text-ink-700 tabular-nums font-medium" x-text="limitsData.status?.kas_balance != null ? Number(limitsData.status.kas_balance).toFixed(1) + ' KAS' : '—'"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-ink-400">Locked</span>
                <span class="text-orange-600 tabular-nums font-medium" x-text="Number(limitsData.status?.locked_kas || 0).toFixed(1) + ' KAS'"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-ink-400">Open Exposure</span>
                <span class="text-ink-700 tabular-nums font-medium" x-text="Number(limitsData.status?.current_exposure_kas || 0).toFixed(1) + ' KAS'"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-ink-400">Available</span>
                <span class="text-green-600 tabular-nums font-medium" x-text="Number(limitsData.status?.available_kas || 0).toFixed(1) + ' KAS'"></span>
              </div>
            </div>
            <!-- Exposure bar -->
            <div class="mt-2 h-2 bg-warm-200 rounded-full overflow-hidden">
              <div class="h-full bg-brand-500 rounded-full transition-all"
                :style="'width:' + Math.min(100, (limitsData.status?.current_exposure_kas || 0) / (limitsData.limits?.total_exposure_kas || 20000) * 100) + '%'"></div>
            </div>
            <div class="text-right text-ink-400 mt-0.5" x-text="Number(limitsData.status?.current_exposure_kas || 0).toFixed(0) + ' / ' + Number(limitsData.limits?.total_exposure_kas || 20000) + ' KAS'"></div>
          </div>

          <!-- Seeder Config -->
          <div class="bg-warm-50 border border-warm-200 rounded-lg p-3">
            <div class="font-medium text-ink-600 mb-2">Seeder Config</div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-2">
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Sell Spread %</span>
                <input type="number" step="0.1" min="0" x-model.number="seedConfig.sell_spread_pct"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Buy Spread %</span>
                <input type="number" step="0.1" min="0" x-model.number="seedConfig.buy_spread_pct"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Amount (KAS)</span>
                <input type="number" min="1" x-model.number="seedConfig.amount_kas"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Expires (min)</span>
                <input type="number" min="5" x-model.number="seedConfig.expires_minutes"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
            </div>
            <button @click="saveSeedConfig()" :disabled="seedSaving"
              class="mt-2 px-3 py-1 bg-brand-500 text-white rounded text-xs disabled:opacity-50 w-full">
              <span x-show="!seedSaving">Save Seeder Config</span>
              <span x-show="seedSaving">Saving...</span>
            </button>
          </div>

          <!-- Exchange Limits -->
          <div class="bg-warm-50 border border-warm-200 rounded-lg p-3">
            <div class="font-medium text-ink-600 mb-2">Exchange Limits</div>
            <div class="grid grid-cols-3 gap-x-3 gap-y-2">
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Per Offer (KAS)</span>
                <input type="number" min="10" x-model.number="limitsForm.per_offer_kas"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Total Exposure (KAS)</span>
                <input type="number" min="100" x-model.number="limitsForm.total_exposure_kas"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
              <label class="flex flex-col gap-0.5">
                <span class="text-ink-400">Price Guard %</span>
                <input type="number" min="1" max="50" step="0.5" x-model.number="limitsForm.price_deviation_pct"
                  class="border border-warm-300 rounded px-2 py-1 text-ink-700 bg-white w-full" />
              </label>
            </div>
            <button @click="saveLimits()" :disabled="limitsSaving"
              class="mt-2 px-3 py-1 bg-brand-500 text-white rounded text-xs disabled:opacity-50 w-full">
              <span x-show="!limitsSaving">Save Limits</span>
              <span x-show="limitsSaving">Saving...</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ ADD WALLET MODAL (full overlay, above everything) ═══ -->
  <div x-show="showAddWallet" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" @click.self="showAddWallet = false">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-80" @click.stop>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-ink-700">Add Wallet</h3>
        <button @click="showAddWallet = false" class="text-ink-400 hover:text-ink-600">&times;</button>
      </div>
      <p class="text-xs text-ink-400 mb-4">Select a chain to create a new wallet for this Agent.</p>
      <div class="space-y-2">
        <template x-for="ch in [{id:'bnb',name:'BNB (BSC)',desc:'USDT/BNB'},{id:'eth',name:'Ethereum',desc:'USDT/ETH'},{id:'sol',name:'Solana',desc:'USDT/SOL'},{id:'tron',name:'TRON',desc:'USDT/TRX'},{id:'polygon',name:'Polygon',desc:'USDC/MATIC'}]" :key="ch.id">
          <button @click="addingWallet = ch.id; createWallet(ch.id).then(() => { addingWallet = false; showAddWallet = false; })" :disabled="addingWallet"
            class="w-full flex items-center justify-between px-4 py-3 rounded-lg border border-warm-200 hover:border-brand-400 hover:bg-brand-50 transition-all text-left disabled:opacity-50">
            <div>
              <div class="text-sm font-medium text-ink-700" x-text="ch.name"></div>
              <div class="text-[11px] text-ink-400" x-text="ch.desc"></div>
            </div>
            <span x-show="addingWallet === ch.id" class="text-xs text-brand-500">Creating...</span>
            <span x-show="addingWallet !== ch.id" class="text-ink-300 text-lg">&rarr;</span>
          </button>
        </template>
      </div>
    </div>
  </div>

</div>

<script>
function exchangeApp() {
  return {
    // ── State ──
    offers: [],
    groups: [],
    relays: [],
    myAddresses: [],
    currentAddress: null,
    loading: true,
    leftTab: 'market',
    opsTab: 'arb',
    selectedOffer: null,
    kasPrice: null,
    overview: { totalCompleted: 0, avgSettlement: null, volume24h: null },
    showForm: false,
    showDispute: false,
    publishing: false,
    formError: '',
    formSuccess: '',
    form: {
      give_asset: '', give_amount: '', give_chain: '',
      want_asset: '', want_amount: '', want_chain: '',
      verification: 'cross_chain_tx', expires_minutes: '60',
      relayNodeId: '',
    },

    // Accept state
    acceptChain: null,
    acceptPaymentAsset: 'usdt',
    acceptBalance: null,
    acceptBalanceOk: false,
    acceptLoading: false,
    acceptError: '',

    // Deal actions
    actionLoading: false,
    actionError: '',
    paymentTx: '',
    paymentChain: 'bnb',
    disputeReason: '',

    // Seed state
    seedConfig: { enabled: false, sell_spread_pct: 1.0, buy_spread_pct: 1.0, amount_kas: 100, expires_minutes: 30, sell_agent_id: '', buy_agent_id: '' },
    limitsData: { limits: { per_offer_kas: 5000, total_exposure_kas: 20000, price_deviation_pct: 5 }, status: {} },
    limitsForm: { per_offer_kas: 5000, total_exposure_kas: 20000, price_deviation_pct: 5 },
    limitsSaving: false,
    wallet: { kas: 0, kasLocked: 0, chains: [] },
    walletPanel: null,
    agentAddr: '',
    showAddWallet: false,
    addingWallet: false,
    seedOrders: [],
    seedStats: { seeded: 0, taken: 0, net_usdt: 0 },
    seedTriggering: false,
    seedSaving: false,

    // Arb state
    cexBalances: [],
    spreadRows: [],
    spreadsCachedAt: null,
    fundedExchanges: [],
    arbOffers: [],
    hedgeHistory: [],
    dailyUsage: [],
    dailyTotal: null,
    dailyLimitInput: 10000,
    dailyLimitSaving: false,
    arbLoading: { balances: false, spreads: false, hedges: false, usage: false },
    arbInitialized: false,

    // Reputation
    reputationMap: {},

    // Polling
    _detailPoll: null,

    // ── Computed ──
    get openOffers() { return this.offers.filter(o => o.protocol_status === 'open'); },
    get myDeals() { return this.offers.filter(o => this.isMine(o)); },
    get activeDeals() {
      return this.myDeals.filter(o =>
        ['open', 'matched', 'verifying', 'awaiting_manual_confirm', 'delivering'].includes(o.protocol_status));
    },
    get completedDeals() {
      return this.myDeals.filter(o =>
        ['completed', 'disputed', 'timed_out', 'expired', 'cancelled'].includes(o.protocol_status))
        .sort((a, b) => {
          const ta = a.completed_at || a.timed_out_at || a.cancelled_at || a.updated_at || '';
          const tb = b.completed_at || b.timed_out_at || b.cancelled_at || b.updated_at || '';
          return tb.localeCompare(ta); // descending — newest first
        });
    },
    historyPage: 1,
    historyPageSize: 10,
    get pagedHistory() {
      const start = (this.historyPage - 1) * this.historyPageSize;
      return this.completedDeals.slice(start, start + this.historyPageSize);
    },
    get historyTotalPages() {
      return Math.max(1, Math.ceil(this.completedDeals.length / this.historyPageSize));
    },
    get lastCompleted() {
      return this.offers.find(o => o.protocol_status === 'completed') || null;
    },

    // ── Init ──
    async init() {
      await this.loadRelays();
      await Promise.all([this.loadOffers(), this.loadKasPrice()]);
      this.loadWallet(); // async, don't block
      setInterval(() => this.loadOffers(), 30000);
      setInterval(() => this.loadKasPrice(), 60000);
      setInterval(() => this.loadWallet(), 15000); // wallet balances refresh
      // KAS withdraw via send-kas event (from wallet panel inline form)
      this.$el?.addEventListener('send-kas', async (e) => {
        const { addr, amt } = e.detail || {};
        if (!addr || !amt || !this.form?.relayNodeId) return;
        if (!confirm('Send ' + amt + ' KAS to ' + addr + '?')) return;
        try {
          const r = await fetch('/api/relay/' + this.form.relayNodeId + '/transfer', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ target: addr, amount: String(amt) }) });
          const d = await r.json();
          if (d.txId) { alert('Sent! TX: ' + d.txId); this.walletPanel = null; await this.loadWallet(); }
          else alert('Error: ' + (d.error || 'Unknown'));
        } catch (e) { alert('Error: ' + e.message); }
      });
    },

    async loadKasPrice() {
      try {
        const res = await fetch('/api/trade/kas-price');
        const data = await res.json();
        this.kasPrice = data?.price || null;
      } catch {}
    },

    async loadRelays() {
      try {
        const res = await fetch('/api/exchange/agents');
        const data = await res.json();
        this.relays = data.agents || [];
        this.myAddresses = this.relays.map(r => r.address).filter(Boolean);
        if (this.relays.length && !this.form.relayNodeId) {
          this.form.relayNodeId = this.relays[0].id;
        }
        this.currentAddress = this.relays.find(r => r.id === this.form.relayNodeId)?.address || null;
      } catch {}
    },

    onAgentChange() {
      this.currentAddress = this.relays.find(r => r.id === this.form.relayNodeId)?.address || null;
      this.walletPanel = null;
      this.loadWallet();
    },

    async loadOffers() {
      try {
        const res = await fetch('/api/exchange/offers?limit=200');
        const data = await res.json();
        this.offers = data.offers || [];
        this.groups = data.groups || [];
        // Compute overview stats from offers
        const completed = this.offers.filter(o => o.protocol_status === 'completed');
        this.overview.totalCompleted = completed.length;
        if (completed.length >= 5) {
          const times = completed.filter(o => o.matched_at && o.completed_at).map(o =>
            (new Date(o.completed_at) - new Date(o.matched_at)) / 1000);
          if (times.length) {
            const avg = times.reduce((a, b) => a + b, 0) / times.length;
            const m = Math.floor(avg / 60); const s = Math.round(avg % 60);
            this.overview.avgSettlement = m + 'm ' + s + 's';
          }
        }
        // Update selected offer if still exists
        if (this.selectedOffer) {
          const updated = this.offers.find(o => o.id === this.selectedOffer.id);
          if (updated) this.selectedOffer = updated;
        }
        // Fetch reputation for visible makers
        this.loadReputations();
      } catch (e) {
        console.error('Failed to load offers:', e);
      } finally {
        this.loading = false;
      }
    },

    async loadReputations() {
      const makers = [...new Set(this.offers.map(o => o.maker).filter(Boolean))];
      const unknown = makers.filter(m => !this.reputationMap[m]);
      if (!unknown.length) return;
      try {
        const res = await fetch('/api/exchange/reputation/batch?addresses=' + unknown.join(',') + (this.currentAddress ? '&my_address=' + this.currentAddress : ''));
        const data = await res.json();
        Object.assign(this.reputationMap, data);
      } catch {}
    },

    getReputation(addr) { return this.reputationMap[addr] || null; },

    // ── Selection ──
    selectOffer(o) {
      this.selectedOffer = o;
      this.showForm = false;
      this.acceptChain = null;
      this.acceptBalance = null;
      this.acceptError = '';
      this.actionError = '';
      this.showDispute = false;
      // Auto-select single chain
      const chains = this.getChains(o);
      if (chains.length === 1) { this.acceptChain = chains[0]; this.loadChainBalance(chains[0]); }
      // Start fast polling for active deals
      this._startDetailPoll(o);
    },

    _startDetailPoll(o) {
      if (this._detailPoll) clearInterval(this._detailPoll);
      const active = ['matched', 'verifying', 'delivering', 'awaiting_manual_confirm'];
      if (active.includes(o.protocol_status)) {
        this._detailPoll = setInterval(() => this.loadOffers(), 5000);
      }
    },

    // ── Helpers ──
    isMaker(o) { return o && this.currentAddress && o.maker === this.currentAddress; },
    isTaker(o) { return o && this.currentAddress && o.taker === this.currentAddress; },
    isMine(o) { return this.isMaker(o) || this.isTaker(o); },

    getChains(o) {
      if (!o) return [];
      try {
        const m = JSON.parse(o.verification_meta || '{}');
        return (m.accepted_chains || []).map(c => c.chain);
      } catch { return []; }
    },

    priceComparison(o) {
      if (!o || !this.kasPrice || this.kasPrice <= 0) return null;
      const giveKas = o.give_asset === 'KAS';
      const wantKas = o.want_asset === 'KAS';
      if (!giveKas && !wantKas) return null;
      const kasAmt = parseFloat(giveKas ? o.give_amount : o.want_amount);
      const usdtAmt = parseFloat(giveKas ? o.want_amount : o.give_amount);
      if (!kasAmt || !usdtAmt) return null;
      const offerPrice = usdtAmt / kasAmt;
      const diffPct = ((offerPrice - this.kasPrice) / this.kasPrice * 100).toFixed(1);
      return { offerPrice, diffPct: parseFloat(diffPct), isSell: giveKas };
    },

    priceColor(o) {
      const pc = this.priceComparison(o);
      if (!pc) return '';
      const absDiff = Math.abs(pc.diffPct);
      if (absDiff < 0.3) return 'text-ink-500';
      if (pc.isSell) return pc.diffPct < 0 ? 'text-green-600' : (pc.diffPct > 2 ? 'text-red-500' : 'text-amber-500');
      return pc.diffPct > 0 ? 'text-green-600' : (pc.diffPct < -2 ? 'text-red-500' : 'text-amber-500');
    },

    getPaymentTx(o) {
      if (!o) return null;
      if (o.payment_tx) return o.payment_tx;
      try { const m = JSON.parse(o.verification_meta || '{}'); return m.payment_tx || null; } catch { return null; }
    },

    getExplorerUrl(o) {
      const tx = this.getPaymentTx(o);
      if (!tx) return '#';
      const chain = o?.taker_chain || '';
      if (chain === 'bnb') return 'https://bscscan.com/tx/' + tx;
      if (chain === 'eth') return 'https://etherscan.io/tx/' + tx;
      if (chain === 'sol') return 'https://solscan.io/tx/' + tx;
      if (chain === 'tron') return 'https://tronscan.org/#/transaction/' + tx;
      return '#';
    },

    getTimeline(o) {
      if (!o || !o.id) return [];
      const steps = [];
      steps.push({ label: 'Published', done: true, time: o.broadcast_at });

      const isMatched = !!o.matched_at;
      steps.push({
        label: 'Matched', done: isMatched,
        active: o.protocol_status === 'matched',
        time: o.matched_at,
        detail: o.taker ? 'by ' + KANet.shortAddr(o.taker) : '',
      });

      if (o.verification === 'manual') {
        const awaitDone = o.protocol_status === 'completed' || (!!o.maker_confirmed_at && !!o.taker_confirmed_at);
        const parts = [];
        if (o.maker_confirmed_at) parts.push('maker confirmed');
        if (o.taker_confirmed_at) parts.push('taker confirmed');
        steps.push({
          label: 'Confirmation', done: awaitDone,
          active: o.protocol_status === 'awaiting_manual_confirm',
          time: o.maker_confirmed_at || o.taker_confirmed_at,
          detail: parts.length ? parts.join(', ') : (isMatched ? 'waiting for both' : ''),
        });
      } else {
        let verifyDetail = '';
        try { const m = JSON.parse(o.verification_meta || '{}'); if (m.payment_tx) verifyDetail = 'TX: ' + m.payment_tx.slice(0, 12) + '...'; } catch {}
        steps.push({
          label: 'Verification',
          done: ['completed', 'disputed', 'delivering'].includes(o.protocol_status) && !!o.verifying_started_at,
          active: o.protocol_status === 'verifying',
          time: o.verifying_started_at,
          detail: verifyDetail || (o.protocol_status === 'verifying' ? 'checking payment...' : ''),
        });
      }

      if (o.delivering_at || o.protocol_status === 'delivering') {
        steps.push({
          label: 'Delivering', done: !!o.completed_at,
          active: o.protocol_status === 'delivering',
          time: o.delivering_at,
          detail: o.protocol_status === 'delivering' ? 'sending KAS...' : '',
        });
      }

      if (o.completed_at) steps.push({ label: 'Completed', done: true, time: o.completed_at });
      else if (o.disputed_at) steps.push({ label: 'Disputed', done: true, time: o.disputed_at });
      else if (o.timed_out_at) steps.push({ label: 'Timed out', done: true, time: o.timed_out_at });
      else if (o.cancelled_at) steps.push({ label: 'Cancelled', done: true, time: o.cancelled_at });
      else if (o.protocol_status === 'expired') steps.push({ label: 'Expired', done: true, time: o.expires_at });
      else steps.push({ label: 'Settlement', done: false });

      return steps;
    },

    statusBadge(s) {
      return {
        'bg-green-50 text-green-700': s === 'open',
        'bg-blue-50 text-blue-700': s === 'matched',
        'bg-amber-50 text-amber-700': s === 'verifying' || s === 'awaiting_manual_confirm' || s === 'delivering',
        'bg-green-100 text-green-800': s === 'completed',
        'bg-red-50 text-red-600': s === 'disputed' || s === 'timed_out',
        'bg-warm-100 text-ink-500': s === 'cancelled' || s === 'expired',
      };
    },
    statusLabel(s) {
      const map = { awaiting_manual_confirm: 'awaiting confirm', timed_out: 'timed out' };
      return map[s] || s;
    },

    canConfirm(o) {
      if (!o || o.protocol_status !== 'awaiting_manual_confirm') return false;
      if (this.isMaker(o) && !o.maker_confirmed_at) return true;
      if (this.isTaker(o) && !o.taker_confirmed_at) return true;
      return false;
    },
    canDispute(o) {
      return o && ['matched', 'verifying', 'awaiting_manual_confirm'].includes(o.protocol_status) &&
        (this.isMaker(o) || this.isTaker(o));
    },

    // ── Publish form ──
    formPriceDiff() {
      if (!this.kasPrice) return null;
      const ga = this.form.give_asset?.toUpperCase();
      const wa = this.form.want_asset?.toUpperCase();
      const gAmt = parseFloat(this.form.give_amount);
      const wAmt = parseFloat(this.form.want_amount);
      if (!gAmt || !wAmt) return null;
      let offerPrice;
      if (ga === 'KAS' && wa === 'USDT') offerPrice = wAmt / gAmt;
      else if (ga === 'USDT' && wa === 'KAS') offerPrice = gAmt / wAmt;
      else return null;
      return ((offerPrice - this.kasPrice) / this.kasPrice * 100);
    },
    fillSellTemplate() {
      this.form.give_asset = 'KAS'; this.form.give_amount = '100';
      this.form.want_asset = 'USDT';
      this.form.want_amount = this.kasPrice ? (100 * this.kasPrice * 1.01).toFixed(4) : '';
      this.form.verification = 'cross_chain_tx';
    },
    fillBuyTemplate() {
      this.form.give_asset = 'USDT'; this.form.want_asset = 'KAS';
      this.form.want_amount = '100';
      this.form.give_amount = this.kasPrice ? (100 * this.kasPrice * 0.99).toFixed(4) : '';
      this.form.verification = 'kaspa_tx';
    },

    // ── Actions ──
    async publishOffer() {
      this.formError = ''; this.formSuccess = '';
      if (!this.form.give_asset || !this.form.give_amount || !this.form.want_asset || !this.form.want_amount) {
        this.formError = 'Fill in all required fields'; return;
      }
      this.publishing = true;
      try {
        const res = await fetch('/api/exchange/publish', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(this.form),
        });
        const data = await res.json();
        if (data.ok) {
          this.formSuccess = 'Offer published!';
          this.showForm = false;
          this.form.give_asset = ''; this.form.give_amount = '';
          this.form.want_asset = ''; this.form.want_amount = '';
          await this.loadOffers();
        } else { this.formError = data.error || 'Broadcast failed'; }
      } catch (e) { this.formError = e.message; }
      finally { this.publishing = false; }
    },

    async loadChainBalance(chain) {
      if (!this.form.relayNodeId) return;
      try {
        // Use wallets API which already has cached balances
        const res = await fetch(`/api/relay/${this.form.relayNodeId}/wallets`);
        const data = await res.json();
        const wallet = (data?.chains || []).find(w => w.chain === chain && w.isDefault);
        const bal = parseFloat(wallet?.usdtBalance || 0);
        const needed = parseFloat(this.selectedOffer?.want_amount || 0);
        this.acceptBalance = bal;
        this.acceptBalanceOk = bal >= needed;
      } catch { this.acceptBalance = null; }
    },

    async confirmAccept() {
      if (!this.form.relayNodeId) { this.acceptError = 'No agent'; return; }
      this.acceptLoading = true; this.acceptError = '';
      try {
        const body = { relayNodeId: this.form.relayNodeId, offer_id: this.selectedOffer.id };
        if (this.acceptChain) body.selected_chain = this.acceptChain;
        if (this.acceptPaymentAsset) body.payment_asset = this.acceptPaymentAsset;
        const res = await fetch('/api/exchange/accept', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (data.ok) {
          this.leftTab = 'deals';
          await this.loadOffers();
          // Re-select to see updated state
          const updated = this.offers.find(o => o.id === this.selectedOffer.id);
          if (updated) this.selectOffer(updated);
        } else { this.acceptError = data.error || 'Accept failed'; }
      } catch (e) { this.acceptError = e.message; }
      finally { this.acceptLoading = false; }
    },

    async cancelOffer(o) {
      if (!confirm('Cancel this offer?')) return;
      try {
        const res = await fetch('/api/exchange/cancel', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id }),
        });
        const data = await res.json();
        if (data.ok) { this.selectedOffer = null; await this.loadOffers(); }
        else { alert(data.error || 'Cancel failed'); }
      } catch (e) { alert(e.message); }
    },

    async confirmDeal(o) {
      const role = this.isMaker(o) ? 'maker' : 'taker';
      this.actionLoading = true; this.actionError = '';
      try {
        const res = await fetch('/api/exchange/confirm', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id, role }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); }
        else { this.actionError = data.error || 'Confirm failed'; }
      } catch (e) { this.actionError = e.message; }
      finally { this.actionLoading = false; }
    },

    async disputeDeal(o) {
      if (!this.disputeReason) return;
      this.actionLoading = true; this.actionError = '';
      try {
        const res = await fetch('/api/exchange/dispute', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ relayNodeId: this.form.relayNodeId, offer_id: o.id, reason: this.disputeReason }),
        });
        const data = await res.json();
        if (data.ok) { await this.loadOffers(); this.showDispute = false; this.disputeReason = ''; }
        else { this.actionError = data.error || 'Dispute failed'; }
      } catch (e) { this.actionError = e.message; }
      finally { this.actionLoading = false; }
    },

    // ── Arbitrage ──
    async loadArbitrageData() {
      if (this.arbInitialized) return;
      this.arbInitialized = true;
      await Promise.all([this.loadBalances(), this.loadSpreads()]);
    },
    async loadBalances() {
      this.arbLoading.balances = true;
      try {
        const res = await fetch('/api/trade/balances?bust=' + Date.now());
        const data = await res.json();
        this.cexBalances = data.balances || [];
      } catch { this.cexBalances = []; }
      finally { this.arbLoading.balances = false; }
    },
    async loadSpreads() {
      try { const data = await fetch('/api/trade/spreads').then(r => r.json()); this.spreadRows = data.spreads || []; } catch {}
    },

    // ── Seeder ──
    async loadSeedData() {
      const [cfg, status, priceData] = await Promise.allSettled([
        fetch('/api/exchange/seeder/config').then(r => r.json()),
        fetch('/api/exchange/seeder/status').then(r => r.json()),
        fetch('/api/trade/kas-price').then(r => r.json()),
      ]);
      if (cfg.status === 'fulfilled' && cfg.value) Object.assign(this.seedConfig, cfg.value);
      if (status.status === 'fulfilled' && status.value) {
        this.seedOrders = status.value.active_orders || [];
        this.seedStats = status.value.today || {};
      }
      if (priceData.status === 'fulfilled') this.kasPrice = priceData.value?.price || null;
    },
    async toggleSeeder() { this.seedConfig.enabled = !this.seedConfig.enabled; await this.saveSeedConfig(); },
    async saveSeedConfig() {
      this.seedSaving = true;
      try { await fetch('/api/exchange/seeder/config', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(this.seedConfig) }); } catch {}
      finally { this.seedSaving = false; }
    },
    async triggerSeed() {
      this.seedTriggering = true;
      try {
        await fetch('/api/exchange/seeder/trigger', { method: 'POST' });
        await new Promise(r => setTimeout(r, 1500));
        await this.loadSeedData(); await this.loadOffers();
      } catch {}
      finally { this.seedTriggering = false; }
    },
    // ── Wallet (Market pattern) ──
    async loadWallet() {
      if (!this.form?.relayNodeId) return;
      try {
        const data = await fetch('/api/relay/' + this.form.relayNodeId + '/wallets').then(r => r.json());
        this.agentAddr = data.kaspa?.address || '';
        const allWallets = (data.chains || []).map(w => ({
          id: w.id, chain: w.chain, name: w.chain === 'polygon' ? 'POLYGON' : w.chain.toUpperCase(),
          address: w.address, label: w.label || (w.isDefault ? 'default' : ''),
          isDefault: w.isDefault,
          usdt: w.usdtBalance || 0, usdc: w.usdcBalance || 0, gas: w.nativeBalance || 0, locked: 0,
        }));
        try {
          const locks = await fetch('/api/trade/fund-locks?relay_node_id=' + encodeURIComponent(this.form.relayNodeId)).then(r => r.json());
          const lockArr = Array.isArray(locks) ? locks : (locks.locks || []);
          const lockedMap = {};
          for (const l of lockArr) { if (l.status === 'locked') lockedMap[l.asset] = (lockedMap[l.asset] || 0) + l.amount; }
          for (const w of allWallets) w.locked = lockedMap['usdt_' + w.chain] || 0;
          this.wallet = { kas: data.kaspa?.balance || 0, kasLocked: lockedMap['kas'] || 0, chains: allWallets };
        } catch {
          this.wallet = { kas: data.kaspa?.balance || 0, kasLocked: 0, chains: allWallets };
        }
      } catch {}
    },
    get panelWallets() {
      if (!this.walletPanel || this.walletPanel === 'kas') return [];
      return this.wallet.chains.filter(w => w.chain === this.walletPanel);
    },
    get chainSummary() {
      const map = {};
      for (const w of this.wallet.chains) {
        const key = w.chain;
        if (!map[key]) map[key] = { name: w.name, chain: key, usdt: 0, usdc: 0, locked: 0, count: 0 };
        map[key].usdt += w.usdt || 0;
        map[key].usdc += w.usdc || 0;
        map[key].locked += w.locked || 0;
        map[key].count++;
      }
      return Object.values(map);
    },
    openWalletPanel(chain) {
      if (this.walletPanel === chain) { this.walletPanel = null; return; }
      this.walletPanel = chain;
    },
    copyAddr(addr) {
      if (!addr) return;
      try { navigator.clipboard.writeText(addr); } catch {
        const ta = document.createElement('textarea'); ta.value = addr;
        document.body.appendChild(ta); ta.select(); document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const el = event?.target;
      if (el) { const prev = el.textContent; el.textContent = 'Copied!'; setTimeout(() => { el.textContent = prev; }, 1500); }
    },
    withdrawPrompt(wallet) {
      const chainName = wallet.chain?.toUpperCase();
      const gasName = wallet.chain === 'polygon' ? 'MATIC' : wallet.chain === 'bnb' ? 'BNB' : wallet.chain === 'eth' ? 'ETH' : wallet.chain === 'sol' ? 'SOL' : wallet.chain === 'tron' ? 'TRX' : chainName;
      const choice = prompt('Withdraw:\n  1 = USDT (' + (wallet.usdt||0).toFixed(2) + ' available)\n  2 = ' + gasName + ' (' + (wallet.gas||0).toFixed(4) + ' available)\n\nEnter 1 or 2:');
      if (!choice) return;
      const asset = choice.trim() === '2' ? 'native' : 'usdt';
      const assetLabel = asset === 'native' ? gasName : 'USDT';
      const toAddr = prompt('Target address (' + chainName + '):');
      if (!toAddr) return;
      const amt = prompt('Amount (' + assetLabel + '):');
      if (!amt || isNaN(amt)) return;
      if (!confirm('Send ' + amt + ' ' + assetLabel + '\nTo: ' + toAddr + '\nChain: ' + chainName)) return;
      this.doWithdraw(wallet, toAddr, parseFloat(amt), asset);
    },
    async doWithdraw(wallet, toAddr, amount, asset = 'usdt') {
      try {
        const r = await fetch('/api/trade/withdraw', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ walletId: wallet.id, chain: wallet.chain, to: toAddr, amount, asset }) });
        const d = await r.json();
        if (d.ok || d.txHash) { alert('Sent! TX: ' + (d.txHash || '').slice(0, 20) + '...'); await this.loadWallet(); }
        else alert('Error: ' + (d.error || 'Unknown'));
      } catch (e) { alert('Error: ' + e.message); }
    },
    async showPrivkeyFor(wallet) {
      if (!confirm('Show private key? Keep it safe.')) return;
      try {
        const r = await fetch('/api/relay/' + this.form.relayNodeId + '/wallets/' + wallet.id + '/privkey').then(r => r.json());
        if (r.privkey) prompt('Private key (Ctrl+C to copy):', r.privkey);
        else alert(r.error || 'Could not retrieve');
      } catch { alert('Failed'); }
    },
    async createWallet(chain) {
      try {
        await fetch('/api/relay/' + this.form.relayNodeId + '/wallets', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ chain }) });
        await this.loadWallet();
        this.openWalletPanel(chain);
      } catch (e) { alert('Failed: ' + e.message); }
    },
    async loadLimits() {
      try {
        const qs = this.form?.relayNodeId ? `?relayNodeId=${this.form.relayNodeId}` : '';
        const data = await fetch('/api/exchange/limits' + qs).then(r => r.json());
        this.limitsData = data;
        this.limitsForm = { ...data.limits };
      } catch {}
    },
    async saveLimits() {
      this.limitsSaving = true;
      try {
        const res = await fetch('/api/exchange/limits', {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(this.limitsForm),
        });
        const data = await res.json();
        if (data.ok) await this.loadLimits();
      } catch {}
      finally { this.limitsSaving = false; }
    },
  };
}
</script>

<%~ include('partials/page-close', it) %>

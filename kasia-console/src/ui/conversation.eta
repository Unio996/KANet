<%~ include('partials/page-open', { _page: 'conversations', pageTitle: '', ...it }) %>
<style>
.thinking-dots span { display:inline-block; width:6px; height:6px; margin:0 2px; border-radius:50%; background:#9ca3af; animation:thinking 1.4s infinite; }
.thinking-dots span:nth-child(2) { animation-delay:.2s; }
.thinking-dots span:nth-child(3) { animation-delay:.4s; }
@keyframes thinking { 0%,80%,100%{opacity:.3;transform:scale(.8)} 40%{opacity:1;transform:scale(1)} }
.custom-scroll::-webkit-scrollbar { width:6px; }
.custom-scroll::-webkit-scrollbar-track { background:transparent; }
.custom-scroll::-webkit-scrollbar-thumb { background:#d4d0c8; border-radius:3px; }
.custom-scroll::-webkit-scrollbar-thumb:hover { background:#9496a1; }
</style>
</main>

    <!-- Top bar -->
    <header class="bg-white border-b border-warm-300 px-6 py-4 flex items-center justify-between flex-shrink-0">
      <div class="flex items-center space-x-3">
        <a href="/conversations" class="text-ink-300 hover:text-ink-500 transition-colors">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </a>
        <div>
          <h1 class="text-lg font-semibold text-ink-700"><%= it.conv.remote_name || it.t.unnamed_contact %></h1>
          <p class="text-xs text-ink-300 font-mono"><%= it.conv.remote_address %>
            <% if (it.conv.remote_identity_id) { %>
            <a href="/identities" class="ml-2 text-brand-500 hover:text-brand-700" title="<%= it.t.nav_identities %>">
              <svg class="h-3.5 w-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </a>
            <% } %>
          </p>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-brand-50 text-brand-600 border border-brand-100"><%= it.conv.network || 'mainnet' %></span>
        <% if (it.conv.status === 'active') { %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-emerald-500"></span><%= it.t.status_active %>
        </span>
        <% } else { %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-warm-100 text-ink-400 border border-warm-300">
          <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-ink-300"></span><%= it.conv.status %>
        </span>
        <% } %>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1 overflow-y-auto p-6 custom-scroll"
      x-data="{
        timeline: <%= JSON.stringify((it.timeline || []).map(function(item) {
          return {
            _type: item._type || 'event',
            content_text: item.content_text || null,
            content: item.content || null,
            text: item.text || null,
            payload: item.payload || null,
            reply_text: item.reply_text || null,
            reply: item.reply || null,
            txid: item.txid || null,
            summary: item.summary || null,
            created_at: item.created_at || null,
            dir: item.dir || null,
            _temp: false,
            _error: false
          };
        })) %>,
        msg: '',
        loading: false,
        result: '',
        resultType: '',
        thinking: false,
        convId: '<%= it.conv.id %>',

        getContent(item) {
          const c = item.content_text || item.content || item.text || item.payload;
          if (c === null || c === undefined || c === '') return '（无内容）';
          return String(c);
        },

        getReplyContent(item) {
          const c = item.reply_text || item.content || item.text || item.reply;
          if (c === null || c === undefined || c === '') return '（无内容）';
          return String(c);
        },

        isHandshake(item) {
          if (!item._type) return false;
          return String(item._type).toLowerCase().indexOf('handshake') !== -1;
        },

        handshakeLabel(item) {
          const t = String(item._type || '').toLowerCase();
          if (t.indexOf('accept') !== -1 || t.indexOf('confirm') !== -1) return '\uD83E\uDD1D 握手已接受';
          return '\uD83E\uDD1D 握手已发送';
        },

        scrollToBottom() {
          this.$nextTick(() => {
            const el = document.getElementById('timeline-end');
            if (el) el.scrollIntoView({ behavior: 'smooth' });
          });
        },

        async send() {
          if (!this.msg.trim() || this.loading) return;
          const msgText = this.msg.trim();
          this.loading = true;
          this.thinking = true;
          this.result = '';

          // Optimistic rendering: push temp message
          const tempMsg = {
            _type: 'reply',
            content_text: null,
            content: msgText,
            text: null,
            payload: null,
            reply_text: msgText,
            reply: null,
            txid: null,
            summary: null,
            created_at: new Date().toISOString(),
            dir: 'out',
            _temp: true,
            _error: false
          };
          this.timeline.push(tempMsg);
          this.msg = '';
          this.scrollToBottom();

          try {
            const res = await fetch('/conversations/' + this.convId + '/reply', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ message: msgText })
            });
            const data = await res.json();
            if (res.ok) {
              // Replace temp message with real one
              const idx = this.timeline.indexOf(tempMsg);
              if (idx !== -1) {
                this.timeline[idx] = {
                  ...tempMsg,
                  _temp: false,
                  _error: false,
                  created_at: data.created_at || tempMsg.created_at,
                  reply_text: data.reply_text || data.content || msgText
                };
              }
              this.resultType = 'success';
              this.result = '<%= it.t.reply_sent %>';
              setTimeout(() => { this.result = ''; }, 3000);
            } else {
              // Mark temp message as error
              const idx = this.timeline.indexOf(tempMsg);
              if (idx !== -1) {
                this.timeline[idx] = { ...tempMsg, _temp: false, _error: true };
              }
              this.resultType = 'error';
              this.result = data.error || '<%= it.t.reply_failed %>';
            }
          } catch (e) {
            // Mark temp message as error
            const idx = this.timeline.indexOf(tempMsg);
            if (idx !== -1) {
              this.timeline[idx] = { ...tempMsg, _temp: false, _error: true };
            }
            this.resultType = 'error';
            this.result = '<%= it.t.network_error %>' + e.message;
          } finally {
            this.loading = false;
            this.thinking = false;
            this.scrollToBottom();
          }
        }
      }"
      x-init="scrollToBottom()"
    >
      <div class="max-w-3xl mx-auto flex flex-col space-y-6">

        <!-- Timeline -->
        <div class="space-y-3" id="timeline">
          <template x-if="timeline.length === 0">
            <div class="text-center py-16 text-sm text-ink-300">
              <svg class="mx-auto h-10 w-10 text-ink-200 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <%= it.t.no_messages %>
            </div>
          </template>

          <template x-for="(item, idx) in timeline" :key="idx">
            <div>
              <!-- Handshake system event -->
              <template x-if="isHandshake(item)">
                <div class="flex items-center justify-center py-1">
                  <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-medium bg-warm-100 text-ink-300 border border-warm-300" x-text="handshakeLabel(item)"></span>
                </div>
              </template>

              <!-- Inbound message: left bubble -->
              <template x-if="item._type === 'message' && !isHandshake(item)">
                <div class="flex items-end space-x-2.5">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-warm-200 flex items-center justify-center">
                    <svg class="w-4 h-4 text-ink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  </div>
                  <div class="max-w-[70%]">
                    <div class="bg-white border border-warm-200 rounded-xl rounded-bl-sm px-4 py-2.5 shadow-sm">
                      <p class="text-sm text-ink-600 whitespace-pre-wrap break-words" x-text="getContent(item)"></p>
                    </div>
                    <p class="text-[11px] text-ink-300 mt-1 ml-1" x-text="item.created_at ? new Date(item.created_at).toLocaleString() : ''"></p>
                  </div>
                </div>
              </template>

              <!-- Outbound reply: right bubble -->
              <template x-if="item._type === 'reply' && !isHandshake(item)">
                <div class="flex items-end justify-end space-x-2.5">
                  <div class="max-w-[70%]">
                    <div class="rounded-xl rounded-br-sm px-4 py-2.5 shadow-sm"
                      :class="item._error ? 'bg-red-50 border border-red-200' : item._temp ? 'bg-brand-50 border border-brand-100 opacity-70' : 'bg-brand-50 border border-brand-100'">
                      <p class="text-sm whitespace-pre-wrap break-words"
                        :class="item._error ? 'text-red-600' : 'text-ink-600'"
                        x-text="getReplyContent(item)"></p>
                    </div>
                    <div class="flex items-center justify-end mt-1 mr-1 space-x-1.5">
                      <template x-if="item._temp">
                        <span class="text-[11px] text-ink-200">发送中...</span>
                      </template>
                      <template x-if="item._error">
                        <span class="text-[11px] text-red-400">发送失败</span>
                      </template>
                      <template x-if="!item._temp && !item._error">
                        <p class="text-[11px] text-ink-300">
                          <span><%= it.t.ai_reply_label %></span>
                          <span x-text="item.created_at ? new Date(item.created_at).toLocaleString() : ''"></span>
                        </p>
                      </template>
                    </div>
                  </div>
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-100 flex items-center justify-center">
                    <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  </div>
                </div>
              </template>

              <!-- TX record: centered pill -->
              <template x-if="item._type === 'tx'">
                <div class="flex items-center justify-center py-1">
                  <div class="flex items-center space-x-2 bg-warm-100 border border-warm-300 rounded-full px-4 py-1.5 text-xs text-ink-400">
                    <svg class="w-3.5 h-3.5 text-ink-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>TX:</span>
                    <span class="font-mono truncate max-w-[200px]" x-bind:title="item.txid" x-text="item.txid"></span>
                    <span class="text-ink-300">&middot;</span>
                    <span x-text="item.created_at ? new Date(item.created_at).toLocaleString() : ''"></span>
                  </div>
                </div>
              </template>

              <!-- Generic system event (non-handshake) -->
              <template x-if="item._type !== 'message' && item._type !== 'reply' && item._type !== 'tx' && !isHandshake(item)">
                <div class="flex items-center justify-center py-1">
                  <p class="text-xs text-ink-300 bg-warm-100 border border-warm-200 px-4 py-1.5 rounded-full">
                    <span x-text="item.summary ? item.summary : (item._type || '（无内容）')"></span>
                    <span class="text-ink-200"> &middot; </span>
                    <span x-text="item.created_at ? new Date(item.created_at).toLocaleString() : ''"></span>
                  </p>
                </div>
              </template>
            </div>
          </template>

          <!-- Thinking indicator -->
          <template x-if="thinking">
            <div class="flex items-end justify-end space-x-2.5">
              <div class="max-w-[70%]">
                <div class="bg-brand-50 border border-brand-100 rounded-xl rounded-br-sm px-4 py-3 shadow-sm">
                  <div class="thinking-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                </div>
              </div>
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
            </div>
          </template>

          <div id="timeline-end"></div>
        </div>

        <!-- Manual Reply form -->
        <div class="bg-white rounded-xl border border-warm-300 p-4 sticky bottom-4 shadow-sm">
          <label class="block text-sm font-medium text-ink-500 mb-2"><%= it.t.manual_reply_label %></label>
          <textarea
            x-model="msg"
            rows="3"
            placeholder="<%= it.t.reply_placeholder %>"
            class="w-full px-3 py-2.5 border border-warm-300 rounded-lg text-sm text-ink-600 placeholder-ink-200 focus:outline-none focus:ring-2 focus:ring-brand-300 focus:border-brand-300 resize-none bg-warm-50 transition-colors"
            @keydown.ctrl.enter="send()"
          ></textarea>
          <div class="flex items-center justify-between mt-3">
            <div>
              <p x-show="result" x-text="result" x-cloak
                :class="resultType === 'success' ? 'text-emerald-600' : 'text-red-500'"
                class="text-sm font-medium"></p>
              <p class="text-xs text-ink-300" x-show="!result"><%= it.t.ctrl_enter_hint %></p>
            </div>
            <button
              @click="send()"
              :disabled="loading || !msg.trim()"
              :class="loading || !msg.trim()
                ? 'bg-warm-200 cursor-not-allowed text-ink-300 border-warm-300'
                : 'bg-brand-600 hover:bg-brand-700 text-white border-brand-600 shadow-sm'"
              class="px-5 py-2 text-sm font-medium rounded-lg transition-all flex items-center space-x-2 border"
            >
              <svg x-show="loading" x-cloak class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
              <span x-text="loading ? '<%= it.t.btn_sending %>' : '<%= it.t.btn_send_reply %>'"></span>
            </button>
          </div>
        </div>

      </div>
<%~ include('partials/page-close', it) %>

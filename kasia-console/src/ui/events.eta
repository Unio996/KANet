<%~ include('partials/page-open', { _page: 'events', pageTitle: it.t.page_events, headerRight: '<a href="/events/export.csv" class="flex items-center space-x-1.5 px-3 py-1.5 text-sm text-ink-500 border border-warm-300 rounded-md hover:bg-warm-100 transition-colors"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg><span>' + it.t.btn_export_csv + '</span></a>', ...it }) %>

<script src="https://unpkg.com/htmx.org@1.9.10"></script>

      <!-- Stats cards -->
      <div class="p-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4">
          <p class="text-xs text-ink-400 uppercase tracking-wider"><%= it.t.stat_total %></p>
          <p class="mt-1 text-2xl font-bold text-ink-700"><%= it.stats ? it.stats.total : 0 %></p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4">
          <p class="text-xs text-ink-400 uppercase tracking-wider"><%= it.t.level_error %></p>
          <p class="mt-1 text-2xl font-bold text-red-600"><%= it.stats ? it.stats.errors : 0 %></p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4">
          <p class="text-xs text-ink-400 uppercase tracking-wider"><%= it.t.level_warn %></p>
          <p class="mt-1 text-2xl font-bold text-yellow-600"><%= it.stats ? it.stats.warns : 0 %></p>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4">
          <p class="text-xs text-ink-400 uppercase tracking-wider"><%= it.t.stat_today %></p>
          <p class="mt-1 text-2xl font-bold text-brand-500"><%= it.stats ? it.stats.today : 0 %></p>
        </div>
      </div>

      <!-- Filter bar -->
      <div class="bg-white rounded-lg shadow-sm border border-warm-200 p-4 mb-4">
        <form method="GET" action="/events" class="flex flex-wrap gap-3">
          <select
            name="level"
            class="px-3 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
          >
            <option value="" <%= !it.level ? 'selected' : '' %>><%= it.t.filter_all_levels %></option>
            <option value="error" <%= it.level === 'error' ? 'selected' : '' %>><%= it.t.level_error %></option>
            <option value="warn" <%= it.level === 'warn' ? 'selected' : '' %>><%= it.t.level_warn %></option>
            <option value="info" <%= it.level === 'info' ? 'selected' : '' %>><%= it.t.level_info %></option>
            <option value="debug" <%= it.level === 'debug' ? 'selected' : '' %>><%= it.t.level_debug %></option>
          </select>

          <select
            name="source"
            class="px-3 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
          >
            <option value="" <%= !it.source ? 'selected' : '' %>><%= it.t.filter_all_sources %></option>
            <option value="relay" <%= it.source === 'relay' ? 'selected' : '' %>>relay</option>
            <option value="adapter" <%= it.source === 'adapter' ? 'selected' : '' %>>adapter</option>
            <option value="system" <%= it.source === 'system' ? 'selected' : '' %>>system</option>
          </select>

          <div class="flex-1 relative min-w-[200px]">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-ink-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input
              type="text"
              name="search"
              value="<%= it.search || '' %>"
              placeholder="<%= it.t.search_events_ph %>"
              class="w-full pl-9 pr-4 py-2 border border-warm-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            />
          </div>

          <button type="submit" class="px-4 py-2 bg-brand-500 text-white text-sm font-medium rounded-md hover:bg-brand-600 transition-colors">
            <%= it.t.btn_filter %>
          </button>
          <% if (it.level || it.source || it.search) { %>
          <a href="/events" class="px-4 py-2 bg-warm-100 text-ink-600 text-sm font-medium rounded-md hover:bg-warm-200 transition-colors">
            <%= it.t.btn_reset %>
          </a>
          <% } %>
        </form>
      </div>

      <!-- Events table -->
      <div class="bg-white rounded-lg shadow-sm border border-warm-200 overflow-hidden">
        <table class="min-w-full divide-y divide-warm-200">
          <thead class="bg-warm-100">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider w-36"><%= it.t.col_time %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_scope %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_type %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_source %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider w-20"><%= it.t.col_level %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-ink-400 uppercase tracking-wider"><%= it.t.col_summary %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-warm-100">
            <% if (!it.events || it.events.length === 0) { %>
            <tr>
              <td colspan="6" class="px-4 py-10 text-center text-sm text-ink-300">
                <% if (it.level || it.source || it.search) { %>
                <%= it.t.no_match_events %>
                <% } else { %>
                <%= it.t.no_events_yet %>
                <% } %>
              </td>
            </tr>
            <% } else { %>
            <% it.events.forEach(function(ev) { %>
            <tr class="hover:bg-warm-100 transition-colors">
              <td class="px-4 py-3 text-xs text-ink-400 whitespace-nowrap" title="<%= it.fmtDate(ev.created_at) %>">
                <div><%= it.relativeTime(ev.created_at) %></div>
                <div class="text-ink-300 font-mono text-xs mt-0.5"><%= it.fmtDate(ev.created_at).split('T')[0] %></div>
              </td>
              <td class="px-4 py-3 text-sm text-ink-500">
                <span class="font-mono text-xs bg-warm-100 px-1.5 py-0.5 rounded"><%= ev.scope || '—' %></span>
              </td>
              <td class="px-4 py-3 text-sm text-ink-500">
                <span class="text-xs text-ink-400"><%= ev.event_type || '—' %></span>
              </td>
              <td class="px-4 py-3 text-sm text-ink-500">
                <span class="text-xs font-mono text-indigo-600"><%= ev.source || '—' %></span>
              </td>
              <td class="px-4 py-3">
                <% if (ev.level === 'error') { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700"><%= it.t.level_error %></span>
                <% } else if (ev.level === 'warn') { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-700"><%= it.t.level_warn %></span>
                <% } else if (ev.level === 'info') { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700"><%= it.t.level_info %></span>
                <% } else { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-warm-100 text-ink-500"><%= it.t.level_debug %></span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-sm text-ink-600 max-w-xs">
                <p class="truncate" title="<%= ev.summary %>"><%= ev.summary || '—' %></p>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination -->
        <% if (it.totalPages && it.totalPages > 1) { %>
        <div class="px-4 py-3 border-t border-warm-200 flex items-center justify-between text-sm text-ink-500">
          <span>
            <%= it.t.pg_page %> <%= it.page %> <%= it.t.pg_of %> <%= it.totalPages %><%= it.t.pg_suffix %>
            <% if (it.totalCount) { %><%= it.t.pg_comma_total %> <%= it.totalCount %> <%= it.t.pg_records %><% } %>
          </span>
          <div class="flex gap-2">
            <% if (it.page > 1) { %>
            <a
              href="/events?page=<%= it.page - 1 %><%= it.level ? '&level=' + it.level : '' %><%= it.source ? '&source=' + it.source : '' %><%= it.search ? '&search=' + it.search : '' %>"
              class="px-3 py-1 rounded border border-warm-300 hover:bg-warm-100 transition-colors"
            ><%= it.t.btn_prev %></a>
            <% } %>
            <% if (it.page < it.totalPages) { %>
            <a
              href="/events?page=<%= it.page + 1 %><%= it.level ? '&level=' + it.level : '' %><%= it.source ? '&source=' + it.source : '' %><%= it.search ? '&search=' + it.search : '' %>"
              class="px-3 py-1 rounded border border-warm-300 hover:bg-warm-100 transition-colors"
            ><%= it.t.btn_next %></a>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      </div>

<%~ include('partials/page-close', it) %>

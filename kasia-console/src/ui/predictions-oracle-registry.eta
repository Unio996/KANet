<%~ include('partials/page-open', { _page: 'predictions-oracle-registry', pageTitle: 'Oracle Registry', ...it }) %>

<!-- Oracle v0.3 sub #7 D1 — Markets › Predictions › Oracle Registry sub-page -->
<!-- 显 active oracle (= 24h TTL filter) + Trust Score 1-100 + 绿/黄/红 + capability tag filter -->

<div x-data="oracleRegistryPage()" x-init="init()" class="max-w-5xl mx-auto px-4 py-6 font-body text-ink-700">

  <header class="mb-6">
    <h1 class="text-2xl font-display text-ink-800">Oracle 注册名单</h1>
    <p class="text-xs text-ink-500 mt-1">活跃 oracle (= 24h 内 announce / vote / settle 活动) — 按 Trust Score 排序</p>
  </header>

  <!-- Filter bar -->
  <div class="flex flex-wrap items-center gap-3 mb-4 p-3 bg-warm-50 rounded-lg">
    <label class="text-xs text-ink-500">档位:</label>
    <select x-model="filter.tier" class="text-xs px-2 py-1 rounded border border-warm-300">
      <option value="">全部</option>
      <option value="1">Tier 1 KANet 精选</option>
      <option value="2">Tier 2 stake-bonded</option>
      <option value="3">Tier 3 system rule</option>
    </select>
    <label class="text-xs text-ink-500">能力 tag:</label>
    <input type="text" x-model="filter.capabilityTag" @input.debounce.300ms="loadOracles()"
           placeholder="e.g. weather / sports / finance"
           class="text-xs px-2 py-1 rounded border border-warm-300 w-48">
    <span class="text-xs text-ink-400 ml-auto">
      <span x-text="oracles.length"></span> active oracle
    </span>
  </div>

  <!-- Oracle list -->
  <template x-if="loading">
    <div class="text-center py-12 text-ink-400 text-sm">loading...</div>
  </template>

  <template x-if="!loading && filteredOracles.length === 0">
    <div class="text-center py-12 text-ink-400 text-sm">
      <div>暂无活跃 oracle 匹配筛选条件</div>
      <div class="mt-2 text-xs">Phase 0 testnet 启动期, oracle pool 等社区涌现</div>
    </div>
  </template>

  <div class="space-y-2">
    <template x-for="o in filteredOracles" :key="o.relay_node_id">
      <div class="bg-warm-50 rounded-lg p-3 flex items-center gap-3 hover:bg-warm-100 transition cursor-pointer"
           @click="openDetail(o)" title="点击看判定历史 + 准确率">
        <!-- Trust Score dot (= 绿/黄/红) -->
        <div class="flex-shrink-0">
          <div class="w-3 h-3 rounded-full"
               :class="trustColor(o.trust_score)"
               :title="'Trust Score: ' + o.trust_score + ' (= ' + auditModeLabel(o.audit_mode) + ')'"></div>
        </div>
        <!-- Identity -->
        <div class="flex-1 min-w-0">
          <div class="text-sm font-medium text-ink-700" x-text="o.name || o.relay_node_id.slice(0, 8)"></div>
          <div class="text-[11px] text-ink-400 font-mono truncate" x-text="o.pubkey.slice(0, 30) + '...'"></div>
        </div>
        <!-- Trust Score number + audit_mode hover -->
        <div class="text-right">
          <div class="text-lg font-display"
               :class="trustTextColor(o.trust_score)"
               x-text="o.trust_score"></div>
          <div class="text-[10px] text-ink-400"
               x-text="o.total_votes + ' votes / ' + (o.accuracy_pct || 0) + '% accuracy'"></div>
        </div>
        <!-- audit_mode badge (= Tier 1/2/3) -->
        <div class="flex-shrink-0">
          <span class="text-[10px] px-2 py-0.5 rounded"
                :class="tierBadgeClass(o.tier)"
                x-text="'Tier ' + o.tier"></span>
        </div>
        <!-- Capabilities -->
        <div class="hidden md:block flex-shrink-0 max-w-[200px]">
          <div class="flex flex-wrap gap-1 justify-end">
            <template x-for="tag in (o.capabilities || []).slice(0, 3)">
              <span class="text-[10px] px-1.5 py-0.5 bg-warm-200 rounded text-ink-600" x-text="tag"></span>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Oracle 详情 modal (= Bettor r128 piece 3: 用户据此选信谁) -->
  <div x-show="detailModal" x-cloak class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4"
       @click="detailModal = null" @keydown.escape.window="detailModal = null">
    <div class="bg-white rounded-lg max-w-lg w-full max-h-[85vh] overflow-y-auto" @click.stop>
      <template x-if="detailModal">
        <div class="p-5">
          <!-- header -->
          <div class="flex items-center justify-between mb-4">
            <div>
              <div class="text-base font-medium text-ink-800" x-text="detailModal.name || detailModal.relay_node_id.slice(0,8)"></div>
              <div class="text-[10px] text-ink-400 font-mono" x-text="detailModal.relay_node_id"></div>
            </div>
            <button @click="detailModal = null" class="text-ink-400 hover:text-ink-700 text-xl">✕</button>
          </div>

          <!-- loading -->
          <div x-show="detailLoading" class="text-center py-8 text-ink-400">加载判定历史...</div>

          <!-- reputation agg -->
          <div x-show="!detailLoading && detailRep">
            <div class="grid grid-cols-3 gap-2 mb-4">
              <div class="bg-warm-50 rounded p-2 text-center">
                <div class="text-lg font-display" :class="detailAccuracyColor()" x-text="detailRep?.history?.accuracy != null ? Math.round(detailRep.history.accuracy*100)+'%' : '—'"></div>
                <div class="text-[10px] text-ink-400">准确率</div>
              </div>
              <div class="bg-warm-50 rounded p-2 text-center">
                <div class="text-lg font-display text-ink-700" x-text="(detailRep?.history?.correct_votes||0)+'/'+(detailRep?.history?.total_votes||0)"></div>
                <div class="text-[10px] text-ink-400">判对/总投</div>
              </div>
              <div class="bg-warm-50 rounded p-2 text-center">
                <div class="text-lg font-display text-ink-700" x-text="'T'+(detailRep?.registry?.tier ?? '?')"></div>
                <div class="text-[10px] text-ink-400">Tier / <span x-text="detailRep?.registry?.status||'?'"></span></div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2 mb-4 text-xs">
              <div class="flex justify-between bg-emerald-50 rounded px-3 py-1.5">
                <span class="text-ink-500">累计 reward</span>
                <span class="text-emerald-700 font-medium" x-text="(detailRep?.history?.total_reward||0).toFixed(2)+' KAS'"></span>
              </div>
              <div class="flex justify-between bg-red-50 rounded px-3 py-1.5">
                <span class="text-ink-500">累计 slash</span>
                <span class="text-red-700 font-medium" x-text="(detailRep?.history?.total_slashed||0).toFixed(2)+' KAS'"></span>
              </div>
            </div>
            <div class="text-[11px] text-ink-400 mb-1" x-text="'silent '+(detailRep?.history?.silent_count||0)+' 次 · 共参与 '+(detailRep?.history?.total_history||0)+' 单'"></div>
          </div>

          <!-- 最近 10 单 trace -->
          <div x-show="!detailLoading" class="mt-4">
            <div class="text-xs font-medium text-ink-600 mb-2">最近判定 (= 验单)</div>
            <template x-if="detailHistory.length === 0">
              <div class="text-[11px] text-ink-400 py-2">暂无判定历史</div>
            </template>
            <div class="space-y-1">
              <template x-for="h in detailHistory" :key="h.id">
                <div class="flex items-center gap-2 text-[11px] bg-warm-50 rounded px-2 py-1.5">
                  <span class="font-mono text-ink-400 truncate flex-1" x-text="(h.market_id||'').slice(-16)"></span>
                  <span class="px-1.5 py-0.5 rounded font-medium"
                        :class="h.vote === h.consensus_outcome ? 'bg-emerald-100 text-emerald-700' : (h.vote==='silent' ? 'bg-warm-200 text-ink-500' : 'bg-red-100 text-red-700')"
                        x-text="h.vote || '—'"></span>
                  <span class="text-ink-400">共识 <span x-text="h.consensus_outcome||'?'"></span></span>
                  <span x-show="h.reward_amount > 0" class="text-emerald-600" x-text="'+'+(h.reward_amount||0).toFixed(1)"></span>
                  <span x-show="h.slashed_amount > 0" class="text-red-600" x-text="'-'+(h.slashed_amount||0).toFixed(1)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Phase 0 transition gate status (= 跟 sub #8 联动) -->
  <div class="mt-8 p-3 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-800">
    <div class="font-medium mb-1">📍 Phase 0 testnet only</div>
    <div>Phase 1 mainnet 启用条件 (4 件):</div>
    <ul class="mt-1 pl-4 space-y-0.5 text-[11px]">
      <li>≥3 cycle testnet on-chain e2e PASS</li>
      <li>Owner explicit publish ack</li>
      <li>KANet Foundation reference 实施 publish (MIT)</li>
      <li>≥1 第三方 deploy announce</li>
    </ul>
  </div>

</div>

<script>
function oracleRegistryPage() {
  return {
    loading: true,
    oracles: [],
    filter: { tier: '', capabilityTag: '' },
    // Bettor r128 piece 3 — oracle detail modal
    detailModal: null,
    detailLoading: false,
    detailRep: null,
    detailHistory: [],

    async init() {
      await this.loadOracles();
    },

    // Open oracle detail (= reputation agg + 最近 10 单 trace)
    async openDetail(o) {
      this.detailModal = o;
      this.detailLoading = true;
      this.detailRep = null;
      this.detailHistory = [];
      try {
        const [repR, histR] = await Promise.all([
          fetch('/api/oracle/' + encodeURIComponent(o.relay_node_id) + '/reputation'),
          fetch('/api/oracle/' + encodeURIComponent(o.relay_node_id) + '/history?limit=10'),
        ]);
        const repJ = await repR.json();
        const histJ = await histR.json();
        this.detailRep = repJ.ok ? repJ : null;
        this.detailHistory = histJ.ok ? (histJ.history || []) : [];
      } catch (e) {
        console.warn('oracle detail load fail', e);
      }
      this.detailLoading = false;
    },

    detailAccuracyColor() {
      const a = this.detailRep?.history?.accuracy;
      if (a == null) return 'text-ink-400';
      if (a >= 0.8) return 'text-emerald-600';
      if (a >= 0.5) return 'text-amber-600';
      return 'text-red-600';
    },

    async loadOracles() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.filter.tier) params.set('tier', this.filter.tier);
        if (this.filter.capabilityTag) params.set('capability_tag', this.filter.capabilityTag);
        const r = await fetch('/api/oracle/registry?' + params.toString());
        const j = await r.json();
        this.oracles = (j.oracles || []).map(o => ({
          ...o,
          // backend 返 trust_score 计算 (= tier base + reputation modifier); UI fallback fallback
          trust_score: o.trust_score ?? this.computeTrustFallback(o),
          accuracy_pct: o.total_votes ? Math.round((o.correct_votes / o.total_votes) * 100) : 0,
        }));
      } catch (e) {
        console.warn('oracle registry load fail', e);
        this.oracles = [];
      }
      this.loading = false;
    },

    get filteredOracles() {
      // backend 已 filter, UI 加 tier client-side filter for live switch
      return this.oracles.filter(o => !this.filter.tier || String(o.tier) === this.filter.tier);
    },

    // tier base score + 历史 modifier (= fallback if backend 0 trust_score)
    computeTrustFallback(o) {
      const tierBase = { 1: 90, 2: 65, 3: 40 }[o.tier] || 40;
      const accuracyModifier = o.total_votes > 5 ?
        Math.round(((o.correct_votes / o.total_votes) - 0.5) * 20) : 0;
      return Math.max(1, Math.min(100, tierBase + accuracyModifier));
    },

    trustColor(score) {
      if (score >= 80) return 'bg-green-500';
      if (score >= 50) return 'bg-amber-500';
      return 'bg-red-500';
    },

    trustTextColor(score) {
      if (score >= 80) return 'text-green-700';
      if (score >= 50) return 'text-amber-700';
      return 'text-red-700';
    },

    auditModeLabel(mode) {
      return ({ tier1: 'KANet 精选', tier2: 'stake-bonded', tier3: 'system rule', consensual: '共识 settle' })[mode] || mode;
    },

    tierBadgeClass(tier) {
      return ({
        1: 'bg-green-100 text-green-700',
        2: 'bg-amber-100 text-amber-700',
        3: 'bg-red-100 text-red-700'
      })[tier] || 'bg-gray-100 text-gray-700';
    },
  };
}
</script>

<%~ include('partials/page-close', { ...it }) %>

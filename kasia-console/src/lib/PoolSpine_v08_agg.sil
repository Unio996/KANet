// PoolSpine_v08_agg — #31 two-P2SH-by-route AGGREGATE version (J1 SS-域裁 2026-06-15).
//
// 性质: 小池 (≤MAX_K winner, 单 TX 全付) 的 spine 合约 = settle_aggregate + dispute_reveal + refund_maker_unjoined.
//   **去 settle_chunk** (那 28,971B/93% 的 47-winner×depth-8 merkle unroll 是 31KB 真凶, 拖累 aggregate 路 → 连 8p
//   都 on-chain INFEASIBLE). 本 version redeem ≈ 2.2KB (settle_aggregate 1937 + dispute/refund 231) → 6×spine ≈ 13KB
//   = 13 broadcast-chunk → 立即可行, 解锁 8p aggregate e2e.
//
// ⚠ two-P2SH-by-route (非 by-entry-type): aggregate-version 与 chunk-version 各自洽 (各含 own settle + dispute + refund)
//   → 避免拆-by-entry 的 fund-access 破口 (小池锁此 version 有全 spend-path: aggregate settle / dispute / refund).
//   按 ROUTE 拆有效 (settle_chunk 28KB 出去); 按 entry-type 拆无效 (dispute/refund 仅 231B/0.7%). 见 J1 SS-域裁.
//
// ⚠ ctor16 **与 PoolSpine_v08_chunk 逐字相同** (同 builder computeSpineP2SH_v08 + 同 8p fixture ctor + version-选择
//   migration-determinism 干净: 同 market 两 version 只换合约体不换 ctor). maxWinnersPerChunk/init_*/maxChunkFee 是
//   settle_chunk-only 参数, 本 version 未引用 (unused baked ctor const, 无害; 保留为 ctor 一致性).
//
// ⚠ ENTRY-ORDER/SELECTOR 移位 (去 settle_chunk 致): 本 version entry 顺序 = settle_aggregate(entry0/OP_0) →
//   dispute_reveal(entry1/OP_1) → refund_maker_unjoined(entry2/OP_2). v08_chunk 中 settle_aggregate 是 entry1/OP_1.
//   **@J2 ④a relay settle_aggregate scriptSig selector 对本 version 必用 OP_0 (非 OP_1)**. (silverscript dispatch by
//   source entry order; 删 settle_chunk → 后续 entry 全前移一位.)
//
// 派生自 PoolSpine_v08_chunk.sil.draft (settle_aggregate/dispute/refund 逐字, freeze-ref 见 §7). 不改任何 require 逻辑.

pragma silverscript ^0.1.0;

contract PoolSpine_v08_agg(
    // —— 继承 v07 ctor 锚 (同值 → 同 logical market; v08 = 新脚本新 P2SH) ——
    byte[32] makerPk,
    byte[32] brokerPk,
    byte[32] poolMerkleRoot,
    int      deadline,
    byte[32] marketMetadataHash,
    byte[32] market_id,
    int      shard_id,
    int      shard_count,
    int      oracleBondAmount,
    // —— v08 chunk 新增 (本 agg version 未引用, 保留为 ctor16 一致性 → 同 builder/fixture/migration-determinism) ——
    int      maxWinnersPerChunk,
    int      init_hwm,
    byte[32] init_plan_commit,
    int      init_total_winners,
    int      maxChunkFee,
    // —— v07-anchor (settle_aggregate min-bet/dust + refund_maker_unjoined output 范围 引用) ——
    int      makerStakeAmount,
    int      minerFee
) {
    // entry 0 — settle_aggregate (小池 ≤MAX_K 单 TX 全付; committee-sig≥4 + depth-8 merkle + payout sighash-attest).
    //   (PoolSpine_v08_chunk.sil.draft entry1 逐字; v08 中是 entry1/OP_1, 本 version 去 settle_chunk 后是 entry0/OP_0.)
    entrypoint function settle_aggregate(
        sig       c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig,
        byte[32]  committeePkHash,     // blake2b(c0||c1||c2||c3||c4) — binds for dispute_reveal
        int       winner,              // 0 = YES, 1 = NO
        byte[32]  sidesMerkleRoot,
        byte[32]  c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
        // FIX (J2 r105 catch): each committee member's position in poolMerkleRoot tree (= leaf index 0..255 for depth-8).
        // silverc has no native position-aware merkle climb → bits are derived per-level via (idx / 2^level) % 2.
        int       c0Idx, int c1Idx, int c2Idx, int c3Idx, int c4Idx,
        // v0.7 sharding: cross-shard global totals + commit anchor.
        // globalYesTotal_sompi + globalNoTotal_sompi = SUM across ALL N shards (= attested by committee
        // sig sighash covering this scriptSig). global_commit_id = blake2b(globalYes||globalNo||market_id||shard_count)
        // per Bettor G6 spec. Off-chain settler ensures all shards use SAME values.
        int       globalYesTotal_sompi,
        int       globalNoTotal_sompi,
        byte[32]  global_commit_id,
        byte[32]  c0s0, byte[32] c0s1, byte[32] c0s2, byte[32] c0s3, byte[32] c0s4, byte[32] c0s5, byte[32] c0s6, byte[32] c0s7,
        byte[32]  c1s0, byte[32] c1s1, byte[32] c1s2, byte[32] c1s3, byte[32] c1s4, byte[32] c1s5, byte[32] c1s6, byte[32] c1s7,
        byte[32]  c2s0, byte[32] c2s1, byte[32] c2s2, byte[32] c2s3, byte[32] c2s4, byte[32] c2s5, byte[32] c2s6, byte[32] c2s7,
        byte[32]  c3s0, byte[32] c3s1, byte[32] c3s2, byte[32] c3s3, byte[32] c3s4, byte[32] c3s5, byte[32] c3s6, byte[32] c3s7,
        byte[32]  c4s0, byte[32] c4s1, byte[32] c4s2, byte[32] c4s3, byte[32] c4s4, byte[32] c4s5, byte[32] c4s6, byte[32] c4s7
    ) {
        // ① path A threshold t=4-of-5: each sig bound to ITS committee PK; counter requires ≥4 valid.
        // if (checkSig false) → branch skipped (no contract failure); require enforces threshold.
        // Tolerates 1 absent/equivocating committee member.
        int validSigs = 0;
        if (checkSig(c0Sig, pubkey(c0Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c1Sig, pubkey(c1Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c2Sig, pubkey(c2Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c3Sig, pubkey(c3Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c4Sig, pubkey(c4Pk))) { validSigs = validSigs + 1; }
        require(validSigs >= 4);
        require(winner == 0 || winner == 1);

        // ② committee commitment — binds revealed committee to a hash usable by dispute_reveal.
        byte[] cConcat0 = c0Pk + c1Pk;
        byte[] cConcat1 = cConcat0 + c2Pk;
        byte[] cConcat2 = cConcat1 + c3Pk;
        byte[] cConcat3 = cConcat2 + c4Pk;
        byte[32] committeeHash = blake2b(cConcat3);
        require(committeeHash == committeePkHash);

        // ③ depth-8 position-aware merkle proof per committee PK against ctor-baked poolMerkleRoot.
        // FIX (J2 r105 catch + J1 r125 own): hardcoded leaf-left order ONLY verifies position 0 →
        // 5 committee members can't all be at pos 0, legitimate settle FAIL = protocol liveness 0%.
        // silverc has no native position-aware climb → bits derived per-level via (idx / 2^level) % 2.
        // c0 merkle proof against poolMerkleRoot (depth-8 position-aware climb).
        require(c0Idx >= 0); require(c0Idx < 256);
        byte[32] c0Cur = blake2b(byte[](c0Pk));
        int c0b0 = c0Idx % 2;
        if (c0b0 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s0)); } else { c0Cur = blake2b(byte[](c0s0) + byte[](c0Cur)); }
        int c0b1 = (c0Idx / 2) % 2;
        if (c0b1 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s1)); } else { c0Cur = blake2b(byte[](c0s1) + byte[](c0Cur)); }
        int c0b2 = (c0Idx / 4) % 2;
        if (c0b2 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s2)); } else { c0Cur = blake2b(byte[](c0s2) + byte[](c0Cur)); }
        int c0b3 = (c0Idx / 8) % 2;
        if (c0b3 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s3)); } else { c0Cur = blake2b(byte[](c0s3) + byte[](c0Cur)); }
        int c0b4 = (c0Idx / 16) % 2;
        if (c0b4 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s4)); } else { c0Cur = blake2b(byte[](c0s4) + byte[](c0Cur)); }
        int c0b5 = (c0Idx / 32) % 2;
        if (c0b5 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s5)); } else { c0Cur = blake2b(byte[](c0s5) + byte[](c0Cur)); }
        int c0b6 = (c0Idx / 64) % 2;
        if (c0b6 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s6)); } else { c0Cur = blake2b(byte[](c0s6) + byte[](c0Cur)); }
        int c0b7 = (c0Idx / 128) % 2;
        if (c0b7 == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s7)); } else { c0Cur = blake2b(byte[](c0s7) + byte[](c0Cur)); }
        require(c0Cur == poolMerkleRoot);

        // c1 merkle proof against poolMerkleRoot (depth-8 position-aware climb).
        require(c1Idx >= 0); require(c1Idx < 256);
        byte[32] c1Cur = blake2b(byte[](c1Pk));
        int c1b0 = c1Idx % 2;
        if (c1b0 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s0)); } else { c1Cur = blake2b(byte[](c1s0) + byte[](c1Cur)); }
        int c1b1 = (c1Idx / 2) % 2;
        if (c1b1 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s1)); } else { c1Cur = blake2b(byte[](c1s1) + byte[](c1Cur)); }
        int c1b2 = (c1Idx / 4) % 2;
        if (c1b2 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s2)); } else { c1Cur = blake2b(byte[](c1s2) + byte[](c1Cur)); }
        int c1b3 = (c1Idx / 8) % 2;
        if (c1b3 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s3)); } else { c1Cur = blake2b(byte[](c1s3) + byte[](c1Cur)); }
        int c1b4 = (c1Idx / 16) % 2;
        if (c1b4 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s4)); } else { c1Cur = blake2b(byte[](c1s4) + byte[](c1Cur)); }
        int c1b5 = (c1Idx / 32) % 2;
        if (c1b5 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s5)); } else { c1Cur = blake2b(byte[](c1s5) + byte[](c1Cur)); }
        int c1b6 = (c1Idx / 64) % 2;
        if (c1b6 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s6)); } else { c1Cur = blake2b(byte[](c1s6) + byte[](c1Cur)); }
        int c1b7 = (c1Idx / 128) % 2;
        if (c1b7 == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s7)); } else { c1Cur = blake2b(byte[](c1s7) + byte[](c1Cur)); }
        require(c1Cur == poolMerkleRoot);

        // c2 merkle proof against poolMerkleRoot (depth-8 position-aware climb).
        require(c2Idx >= 0); require(c2Idx < 256);
        byte[32] c2Cur = blake2b(byte[](c2Pk));
        int c2b0 = c2Idx % 2;
        if (c2b0 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s0)); } else { c2Cur = blake2b(byte[](c2s0) + byte[](c2Cur)); }
        int c2b1 = (c2Idx / 2) % 2;
        if (c2b1 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s1)); } else { c2Cur = blake2b(byte[](c2s1) + byte[](c2Cur)); }
        int c2b2 = (c2Idx / 4) % 2;
        if (c2b2 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s2)); } else { c2Cur = blake2b(byte[](c2s2) + byte[](c2Cur)); }
        int c2b3 = (c2Idx / 8) % 2;
        if (c2b3 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s3)); } else { c2Cur = blake2b(byte[](c2s3) + byte[](c2Cur)); }
        int c2b4 = (c2Idx / 16) % 2;
        if (c2b4 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s4)); } else { c2Cur = blake2b(byte[](c2s4) + byte[](c2Cur)); }
        int c2b5 = (c2Idx / 32) % 2;
        if (c2b5 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s5)); } else { c2Cur = blake2b(byte[](c2s5) + byte[](c2Cur)); }
        int c2b6 = (c2Idx / 64) % 2;
        if (c2b6 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s6)); } else { c2Cur = blake2b(byte[](c2s6) + byte[](c2Cur)); }
        int c2b7 = (c2Idx / 128) % 2;
        if (c2b7 == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s7)); } else { c2Cur = blake2b(byte[](c2s7) + byte[](c2Cur)); }
        require(c2Cur == poolMerkleRoot);

        // c3 merkle proof against poolMerkleRoot (depth-8 position-aware climb).
        require(c3Idx >= 0); require(c3Idx < 256);
        byte[32] c3Cur = blake2b(byte[](c3Pk));
        int c3b0 = c3Idx % 2;
        if (c3b0 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s0)); } else { c3Cur = blake2b(byte[](c3s0) + byte[](c3Cur)); }
        int c3b1 = (c3Idx / 2) % 2;
        if (c3b1 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s1)); } else { c3Cur = blake2b(byte[](c3s1) + byte[](c3Cur)); }
        int c3b2 = (c3Idx / 4) % 2;
        if (c3b2 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s2)); } else { c3Cur = blake2b(byte[](c3s2) + byte[](c3Cur)); }
        int c3b3 = (c3Idx / 8) % 2;
        if (c3b3 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s3)); } else { c3Cur = blake2b(byte[](c3s3) + byte[](c3Cur)); }
        int c3b4 = (c3Idx / 16) % 2;
        if (c3b4 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s4)); } else { c3Cur = blake2b(byte[](c3s4) + byte[](c3Cur)); }
        int c3b5 = (c3Idx / 32) % 2;
        if (c3b5 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s5)); } else { c3Cur = blake2b(byte[](c3s5) + byte[](c3Cur)); }
        int c3b6 = (c3Idx / 64) % 2;
        if (c3b6 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s6)); } else { c3Cur = blake2b(byte[](c3s6) + byte[](c3Cur)); }
        int c3b7 = (c3Idx / 128) % 2;
        if (c3b7 == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s7)); } else { c3Cur = blake2b(byte[](c3s7) + byte[](c3Cur)); }
        require(c3Cur == poolMerkleRoot);

        // c4 merkle proof against poolMerkleRoot (depth-8 position-aware climb).
        require(c4Idx >= 0); require(c4Idx < 256);
        byte[32] c4Cur = blake2b(byte[](c4Pk));
        int c4b0 = c4Idx % 2;
        if (c4b0 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s0)); } else { c4Cur = blake2b(byte[](c4s0) + byte[](c4Cur)); }
        int c4b1 = (c4Idx / 2) % 2;
        if (c4b1 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s1)); } else { c4Cur = blake2b(byte[](c4s1) + byte[](c4Cur)); }
        int c4b2 = (c4Idx / 4) % 2;
        if (c4b2 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s2)); } else { c4Cur = blake2b(byte[](c4s2) + byte[](c4Cur)); }
        int c4b3 = (c4Idx / 8) % 2;
        if (c4b3 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s3)); } else { c4Cur = blake2b(byte[](c4s3) + byte[](c4Cur)); }
        int c4b4 = (c4Idx / 16) % 2;
        if (c4b4 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s4)); } else { c4Cur = blake2b(byte[](c4s4) + byte[](c4Cur)); }
        int c4b5 = (c4Idx / 32) % 2;
        if (c4b5 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s5)); } else { c4Cur = blake2b(byte[](c4s5) + byte[](c4Cur)); }
        int c4b6 = (c4Idx / 64) % 2;
        if (c4b6 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s6)); } else { c4Cur = blake2b(byte[](c4s6) + byte[](c4Cur)); }
        int c4b7 = (c4Idx / 128) % 2;
        if (c4b7 == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s7)); } else { c4Cur = blake2b(byte[](c4s7) + byte[](c4Cur)); }
        require(c4Cur == poolMerkleRoot);

        // Payout structure enforcement (Bettor r13/r15 fund-safety):
        //   outputs[0]       = broker fee (P2PK brokerPk)
        //   outputs[1..5]    = 5 committee bond-return + fee-share (P2PK c0Pk..c4Pk, fixed N=5)
        //   outputs[6..]     = bettor winner payouts, attested by TX sighash (= SIGHASH_ALL covers
        //                      every output's scriptPubKey + value); per-bettor amounts in outputs[6..]
        //                      cryptographically bound to committee consent. Each PoolSide enforces its
        //                      own bettor-merkle-proof at claim time (Bettor r15 split).
        require(tx.inputs.length >= 1);
        require(tx.outputs.length >= 6);

        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));
        require(tx.outputs[0].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[0].value >= 1000);  // v0.7 dust floor (= 1000 sompi, J2 d649f16)

        byte[34] c0Lock = new ScriptPubKeyP2PK(pubkey(c0Pk));
        require(tx.outputs[1].scriptPubKey == byte[](c0Lock));
        require(tx.outputs[1].value >= oracleBondAmount);

        byte[34] c1Lock = new ScriptPubKeyP2PK(pubkey(c1Pk));
        require(tx.outputs[2].scriptPubKey == byte[](c1Lock));
        require(tx.outputs[2].value >= oracleBondAmount);

        byte[34] c2Lock = new ScriptPubKeyP2PK(pubkey(c2Pk));
        require(tx.outputs[3].scriptPubKey == byte[](c2Lock));
        require(tx.outputs[3].value >= oracleBondAmount);

        byte[34] c3Lock = new ScriptPubKeyP2PK(pubkey(c3Pk));
        require(tx.outputs[4].scriptPubKey == byte[](c3Lock));
        require(tx.outputs[4].value >= oracleBondAmount);

        byte[34] c4Lock = new ScriptPubKeyP2PK(pubkey(c4Pk));
        require(tx.outputs[5].scriptPubKey == byte[](c4Lock));
        require(tx.outputs[5].value >= oracleBondAmount);

        // Integer-overflow guards on baked ctor amounts.
        require(oracleBondAmount > 0);
        require(oracleBondAmount < 1000000000000000);   // <1M KAS per oracle bond
        require(makerStakeAmount > 0);
        require(makerStakeAmount < 1000000000000000);   // <1M KAS per maker stake
        require(minerFee > 0);
        require(minerFee < 100000000);                  // <1 KAS miner fee

        // ⑥ min-bet (ctor): makerStakeAmount >= MIN_BET_SOMPI = 1e8 = 1 KAS (anti-bot floor, dust safety).
        require(makerStakeAmount >= 100000000);

        // ⑦ min-pot global: globalYes + globalNo (sompi) must exceed minimum to guarantee
        //    smallest winner share > dust (single-shard floor; committee-attested global sum).
        require(globalYesTotal_sompi >= 0);
        require(globalNoTotal_sompi >= 0);
        require(globalYesTotal_sompi + globalNoTotal_sompi >= 10000000000);
        require(globalYesTotal_sompi < 1000000000000000000);  // 1e18 sanity upper
        require(globalNoTotal_sompi < 1000000000000000000);

        // ⑦b min-pot LOSING-SIDE floor (Owner 终裁 6/1 min-pot option A, J1 r245/4 catch):
        //    losingPool = globalYes*winner + globalNo*(1-winner); force >= 5 × oracleBondAmount
        //    (= N_committee × bond, prevents KIP-9 dust on 5 committee bond_return outputs).
        int oneMinusWinner = 1 - winner;
        int losingPool = globalYesTotal_sompi * winner + globalNoTotal_sompi * oneMinusWinner;
        require(losingPool >= 5 * oracleBondAmount);

        // ⑧ shard identity (ctor): basic sanity.
        require(shard_id >= 0);
        require(shard_count >= 1);
        require(shard_id < shard_count);

        // ⑨ commit anchor (Bettor G6 cross-shard binding): committee sigs cover scriptSig args via sighash
        //    → global_commit_id/globalYes/globalNo implicitly attested. NOTE pass commit so auditable on chain.
        require(global_commit_id != poolMerkleRoot);  // sanity: commit ≠ accidental zero or pool root
    }

    // entry 1 — dispute_reveal: triggered when a settle outcome is disputed. Each committee
    // member's individual sig over disputeOutcomeHash is required (unanimous t=5 here, since
    // dispute mode is about establishing individual accountability for slashing).
    // (PoolSpine_v08_chunk.sil.draft entry2 逐字; 本 version 去 settle_chunk 后是 entry1/OP_1.)
    entrypoint function dispute_reveal(
        byte[32]  committeePkHash,
        byte[32]  disputeOutcomeHash,
        byte[32]  c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
        sig       c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig
    ) {
        byte[] dConcat0 = c0Pk + c1Pk;
        byte[] dConcat1 = dConcat0 + c2Pk;
        byte[] dConcat2 = dConcat1 + c3Pk;
        byte[] dConcat3 = dConcat2 + c4Pk;
        byte[32] dHash  = blake2b(dConcat3);
        require(dHash == committeePkHash);

        require(checkSig(c0Sig, pubkey(c0Pk)));
        require(checkSig(c1Sig, pubkey(c1Pk)));
        require(checkSig(c2Sig, pubkey(c2Pk)));
        require(checkSig(c3Sig, pubkey(c3Pk)));
        require(checkSig(c4Sig, pubkey(c4Pk)));

        require(tx.inputs.length >= 1);
        require(tx.outputs.length >= 1);
    }

    // entry 2 — refund_maker_unjoined (v0.7 红线 8/9): maker recovers stake. Fee NOT hardcoded —
    // settler picks dynamically (KIP-9 mass × mempool floor). SS守上下限 [makerStake-MAX_FEE, makerStake-MIN_FEE].
    // FRONT-RUN FIX (Bettor r388/r389): REFUND_GRACE_SEC = 7200 (2h) >= 委员结算 SLA; tx.time DAA-gated.
    // (PoolSpine_v08_chunk.sil.draft entry3 逐字; 本 version 去 settle_chunk 后是 entry2/OP_2.)
    entrypoint function refund_maker_unjoined(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= (deadline + 7200) * 1000);  // grace 修 (bug 10d Path A ms 模式)

        require(tx.inputs.length >= 1);
        require(tx.outputs.length == 1);

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));

        // fee 范围 [MIN_FEE=50000, MAX_FEE=1e8]: output = makerStakeAmount - fee.
        require(tx.outputs[0].value <= makerStakeAmount - 50000);
        require(tx.outputs[0].value >= makerStakeAmount - 100000000);
        require(tx.outputs[0].value >= 1000);  // dust floor (J2 d649f16)
    }
}

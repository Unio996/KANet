// PredictionEscrowUnanimous5 v3 — KANet Phase 4a SS escrow (testnet TN12)
//
// Bettor r232 reject D simplification + accept E pre-handshake — 加 双 stake P2P:
//   - maker + taker pre-handshake (= 链下) → 双方真 pubkey → 真 P2SH addr
//   - maker 锁 stake_maker → P2SH (= 1st UTXO)
//   - taker 锁 stake_taker → 同 P2SH (= 2nd UTXO)
//   - settle: 5 oracle 全签 + 一致 winner → spendable (= 双 input sum - minerFee) 拆 winner + broker
//   - refund_both: deadline 过 双方 staked → 拆 maker_stake + taker_stake 各回
//   - refund_maker_unjoined: deadline 过 taker 没 stake → maker 拿回单边 stake
//
// 跟 v2.1 diff:
//   - ctor 加 makerStakeAmount + takerStakeAmount (= 13 params)
//   - settle 改 inputs.length == 2 (= 双 UTXO 必)
//   - refund 拆 2 entrypoints: refund_both / refund_maker_unjoined
//   - 删除 v2.1 activeInputIndex == 0 (= 2-input case 不能强制 0)
//
// 编译: silverc.exe PredictionEscrowUnanimous5.sil --ctor args.json
pragma silverscript ^0.1.0;

contract PredictionEscrowUnanimous5(
    byte[32] makerPk,
    byte[32] takerPk,
    byte[32] brokerPk,
    byte[32] oracle1Pk,
    byte[32] oracle2Pk,
    byte[32] oracle3Pk,
    byte[32] oracle4Pk,
    byte[32] oracle5Pk,
    int deadline,
    int minerFee,
    int brokerFeePct,
    int oracleFeePct,
    int makerStakeAmount,
    int takerStakeAmount
) {

    // settle_dispute — 5 oracle 全签 + 一致 winner → oracle 介入 dispute path
    //   Oracle v0.3 R7 truth matrix "1V1 escrow dispute settle":
    //     broker 1% × notional + oracle 1% × notional (= total 2%), user 付 2%
    //   ctor oracleFeePct (range 5-20 bps×100 e.g. 100 = 1%, baked into spine)
    //   winner: 0 = maker won, 1 = taker won
    //   inputs.length == 2 (= 双 stake locked)
    //   outputs.length == 7 (= winner + broker + 5 oracle fee outputs)
    //   Layer 2 SS defense-in-depth (= J1 #12 dynamic formula, NWT r13 ACK):
    //     require(spendable * oracleFeePct >= 1_250_000_000_000)
    //     = 12500 KAS × 10^8 sompi unit, 等价 (spendable × oracleFeePct / 10000 / 5) >= 0.25 KAS per oracle output
    //     防 KIP-9 storage mass 撞 cap (= 5 oracle outputs 小 pot 量化撞墙, J1 #10 catch)
    entrypoint function settle_dispute(
        sig sig1,
        sig sig2,
        sig sig3,
        sig sig4,
        sig sig5,
        int winner
    ) {
        require(checkSig(sig1, pubkey(oracle1Pk)));
        require(checkSig(sig2, pubkey(oracle2Pk)));
        require(checkSig(sig3, pubkey(oracle3Pk)));
        require(checkSig(sig4, pubkey(oracle4Pk)));
        require(checkSig(sig5, pubkey(oracle5Pk)));

        require(winner == 0 || winner == 1);
        require(tx.inputs.length == 2);
        require(tx.outputs.length == 7);

        int spendable = tx.inputs[0].value + tx.inputs[1].value - minerFee;

        // Layer 2 SS defense-in-depth: spendable × oracleFeePct >= 12500 KAS × 10^8 sompi
        // 防 KIP-9 storage mass 撞 cap (= J1 #12 dynamic formula)
        require(spendable * oracleFeePct >= 1250000000000);

        int brokerFeeAmount = spendable * brokerFeePct / 10000;
        int oracleFeeAmount = spendable * oracleFeePct / 10000;
        int oraclePerFee = oracleFeeAmount / 5;
        int distributableAmount = spendable - brokerFeeAmount - oracleFeeAmount;

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        byte[34] takerLock = new ScriptPubKeyP2PK(pubkey(takerPk));
        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));
        byte[34] oracle1Lock = new ScriptPubKeyP2PK(pubkey(oracle1Pk));
        byte[34] oracle2Lock = new ScriptPubKeyP2PK(pubkey(oracle2Pk));
        byte[34] oracle3Lock = new ScriptPubKeyP2PK(pubkey(oracle3Pk));
        byte[34] oracle4Lock = new ScriptPubKeyP2PK(pubkey(oracle4Pk));
        byte[34] oracle5Lock = new ScriptPubKeyP2PK(pubkey(oracle5Pk));

        if (winner == 0) {
            require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        } else {
            require(tx.outputs[0].scriptPubKey == byte[](takerLock));
        }
        require(tx.outputs[0].value == distributableAmount);
        require(tx.outputs[1].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[1].value == brokerFeeAmount);
        require(tx.outputs[2].scriptPubKey == byte[](oracle1Lock));
        require(tx.outputs[2].value == oraclePerFee);
        require(tx.outputs[3].scriptPubKey == byte[](oracle2Lock));
        require(tx.outputs[3].value == oraclePerFee);
        require(tx.outputs[4].scriptPubKey == byte[](oracle3Lock));
        require(tx.outputs[4].value == oraclePerFee);
        require(tx.outputs[5].scriptPubKey == byte[](oracle4Lock));
        require(tx.outputs[5].value == oraclePerFee);
        require(tx.outputs[6].scriptPubKey == byte[](oracle5Lock));
        require(tx.outputs[6].value == oraclePerFee);
    }

    // settle_consensual — 双方 mutual confirm + 0 oracle (= "正常 settle" path)
    //   Oracle v0.3 R7 truth matrix "1V1 escrow 正常 settle (双方 confirm)":
    //     broker 1% × notional + oracle 0 (= user 付 1%)
    //   maker + taker mutual sig → winner 由协商定 (= UI sub #7 consensual button trigger)
    //   J1 #C1 fix: winner-binding explicit outputs verify (= UNCONSTRAINED winner attack 防)
    //   inputs.length == 2 + outputs.length == 2 (= winner + broker only, 0 oracle output)
    entrypoint function settle_consensual(
        sig makerSig,
        sig takerSig,
        int winner
    ) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(checkSig(takerSig, pubkey(takerPk)));
        require(winner == 0 || winner == 1);
        require(tx.inputs.length == 2);
        require(tx.outputs.length == 2);

        int spendable = tx.inputs[0].value + tx.inputs[1].value - minerFee;
        int brokerFeeAmount = spendable * brokerFeePct / 10000;
        int winnerAmount = spendable - brokerFeeAmount;

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        byte[34] takerLock = new ScriptPubKeyP2PK(pubkey(takerPk));
        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));

        // J1 #C1 fix: winner-binding explicit outputs verify (= UNCONSTRAINED winner attack 防)
        if (winner == 0) {
            require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        } else {
            require(tx.outputs[0].scriptPubKey == byte[](takerLock));
        }
        require(tx.outputs[0].value == winnerAmount);
        require(tx.outputs[1].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[1].value == brokerFeeAmount);
    }

    // refund_both — deadline 过, maker + taker 双 staked → 按 ctor stake 比例 split
    //   触发场景: oracle 分歧 (= revote 仍不一致) OR DoS (= 1 oracle 不签)
    entrypoint function refund_both(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= deadline * 1000);  // bug 10d fix Path A
        require(tx.inputs.length == 2);
        require(tx.outputs.length == 2);

        int spendable = tx.inputs[0].value + tx.inputs[1].value - minerFee;
        int totalStake = makerStakeAmount + takerStakeAmount;
        int makerRefund = spendable * makerStakeAmount / totalStake;
        int takerRefund = spendable - makerRefund;

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        byte[34] takerLock = new ScriptPubKeyP2PK(pubkey(takerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        require(tx.outputs[0].value == makerRefund);
        require(tx.outputs[1].scriptPubKey == byte[](takerLock));
        require(tx.outputs[1].value == takerRefund);
    }

    // refund_maker_unjoined — deadline 过, 仅 maker staked (= taker 没 join handshake 后 stake)
    //   触发场景: maker stake locked 后 taker 没在 deadline 前 stake → maker 单边 refund
    entrypoint function refund_maker_unjoined(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= deadline * 1000);  // bug 10d fix Path A
        require(tx.inputs.length == 1);
        require(this.activeInputIndex == 0);
        require(tx.outputs.length == 1);

        int amount = tx.inputs[0].value - minerFee;
        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        require(tx.outputs[0].value == amount);
    }
}

// PredictionEscrowUnanimous5 v2 — KANet Phase 4a SS escrow (testnet TN12)
//
// Bettor r225 reviewer audit v2 加固 — 修 4 漏洞:
//   1. fee 数额 enforce (= require .value 精确 against spendable × fee_pct)
//   2. winner=1 分支去 maker_fee (= maker 输不拿 fee, 简化 2-output 模式)
//   3. tx.outputs.length 限定 (= 2 settle / 1 refund, 防 dust output 蚂蚁吸)
//   4. broker 强制 (= Phase 4a 不支持零 broker, Phase 4b 加 conditional)
//
// 设计:
//   - maker 单边锁 stake (= 跟 Phase 3a 现实 align, taker 不押)
//   - settle: winner 拿 spendable - brokerFee, broker 拿 brokerFee
//   - refund: maker 拿全 spendable (= deadline 过, oracle 不一致 OR DoS)
//
// 编译: silverc.exe PredictionEscrowUnanimous5.sil --ctor args.json
pragma silverscript ^0.1.0;

contract PredictionEscrowUnanimous5(
    byte[32] makerPk,
    byte[32] takerPk,
    byte[32] brokerPk,
    byte[32] oracle1Pk,
    byte[32] oracle2Pk,
    byte[32] oracle3Pk,
    byte[32] oracle4Pk,
    byte[32] oracle5Pk,
    int deadline,
    int minerFee,
    int brokerFeePct
) {

    // settle — 5 oracle 全签 + 一致 winner → 2-way split
    //   winner: 0 = maker won, 1 = taker won
    entrypoint function settle(
        sig sig1,
        sig sig2,
        sig sig3,
        sig sig4,
        sig sig5,
        int winner
    ) {
        require(checkSig(sig1, pubkey(oracle1Pk)));
        require(checkSig(sig2, pubkey(oracle2Pk)));
        require(checkSig(sig3, pubkey(oracle3Pk)));
        require(checkSig(sig4, pubkey(oracle4Pk)));
        require(checkSig(sig5, pubkey(oracle5Pk)));

        require(winner == 0 || winner == 1);
        require(tx.inputs.length == 1);
        require(this.activeInputIndex == 0);
        require(tx.outputs.length == 2);

        int spendable = tx.inputs[0].value - minerFee;
        int brokerFeeAmount = spendable * brokerFeePct / 10000;
        int winnerAmount = spendable - brokerFeeAmount;

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        byte[34] takerLock = new ScriptPubKeyP2PK(pubkey(takerPk));
        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));

        if (winner == 0) {
            require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        } else {
            require(tx.outputs[0].scriptPubKey == byte[](takerLock));
        }
        require(tx.outputs[0].value == winnerAmount);
        require(tx.outputs[1].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[1].value == brokerFeeAmount);
    }

    // refund — deadline 过, maker 拿回全 stake (- minerFee)
    //   触发: revote 仍分歧 OR oracle DoS 不签 OR 任何原因 settle 不上链
    entrypoint function refund(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= deadline);
        require(tx.inputs.length == 1);
        require(this.activeInputIndex == 0);
        require(tx.outputs.length == 1);

        int amount = tx.inputs[0].value - minerFee;
        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        require(tx.outputs[0].value == amount);
    }
}

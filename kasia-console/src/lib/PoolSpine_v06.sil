// PoolSpine_v06.sil — v0.6 anonymous-pool oracle prediction spine, **depth-8** (pool ≤256)
// Bettor r3 lock + Owner ack 5/30 + Bettor r10 finding (depth-4 too small) + J2 r102 attack math
// + Bettor r12 lock (depth-8 ACK, J1 SS t-agnostic) + **Bettor r19 lock (path A, t=4-of-5, 5/30)**.
//
// What changed from v0.5 PoolSpine.sil:
// - v0.5: ctor baked 3 oracle PKs; settle = checkSig×3 against individuals (identities public).
// - v0.6: ctor bakes ONE poolMerkleRoot (snapshot of the public oracle pool at market create);
//   committee is selected per-event by off-chain stake-weighted VRF and reaches consensus via
//   individual Schnorr sigs — settle verifies ≥4 of 5 individual sigs (threshold counter) + merkle
//   proof that each committee member is in the ctor pool.
//
// Pre-vote anonymity: identities hidden DURING voting (= prevents directed bribery). Settlement
// reveals the 5 committee PKs (= pool is public + selection is per-event random, acceptable per
// Owner ack via Bettor r19). MuSig2 "full anonymity at settle" was infeasible without silverc
// KeyAgg primitive — caused the J1 r119 aggSig-aggPk-unbound fund-loss hole.
//
// SS validation per spec §1 (post-r19 path A):
//   ① threshold counter: ≥4 of 5 individual checkSig (= Owner ack 97.7% liveness, 4-of-5)
//   ② blake2b(c0||c1||c2||c3||c4) == committeePkHash — binds revealed committee to dispute commitment
//   ③ for each c_i: depth-8 merkle proof verifies c_i ∈ poolMerkleRoot — committee subset of pool
//
// The combined ① + ③ closes the v0.6 first-draft aggSig-aggPk-unbound hole (J1 r118/r119 +
// Bettor r17 catch): committee PKs are bound to the pool via merkle (③), AND each PK directly
// signed the settlement (①). No KeyAgg derivation needed; impersonation requires forging an
// individual committee member's private key.
//
// Slash granularity is fork A (iii) per spec §1: aggregate fast path keeps individuals
// pre-vote-anonymous; dispute_reveal entrypoint requires individual sigs matching the commitment
// for per-oracle bond forfeiture. (Bond redirection at the SS-output level is structural and
// lives in the pool-bond contract layer.)
//
// Fixed scope:
// - committee size N = 5 (spec allows 5–7; locked at 5 for first ship)
// - threshold t = 4 (Owner ack via Bettor r19: 97.7% liveness, tolerates 1 absent/equivocating)
// - pool merkle depth = 8 (pool ≤ 256, future-proof per Bettor r10 finding + J2 r102 attack math)
// - dispute_reveal binding via committeePkHash arg (off-chain coordinator-provided)
//
// Counter pattern per J1 r120 probe (silverc supports `int v=0; if(checkSig(...)) v=v+1;` —
// validated at 223 script bytes for 5 sigs + 1 require).
//
// Backward compat (spec §7): v0.5 PoolSpine.sil untouched, v0.5 markets continue. v0.6 opt-in
// via pool.js protocol_version='v0.6' branch (new contract = new P2SH = inherently distinct).

pragma silverscript ^0.1.0;

contract PoolSpine_v06(
    byte[32] makerPk,
    byte[32] brokerPk,
    byte[32] poolMerkleRoot,    // depth-8 blake2b root of pool snapshot
    int deadline,
    int minerFee,
    int brokerFeePct,
    int oracleFeePct,
    int oracleBondAmount,
    int makerStakeAmount,
    byte[32] marketMetadataHash
) {

    // entry 0 — settle_aggregate (path A): 5 individual committee sigs (≥4 valid) + depth-8 merkle proofs.
    entrypoint function settle_aggregate(
        sig       c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig,
        byte[32]  committeePkHash,     // blake2b(c0||c1||c2||c3||c4) — binds for dispute_reveal
        int       winner,              // 0 = YES, 1 = NO
        byte[32]  sidesMerkleRoot,
        byte[32]  c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
        byte[32]  c0s0, byte[32] c0s1, byte[32] c0s2, byte[32] c0s3, byte[32] c0s4, byte[32] c0s5, byte[32] c0s6, byte[32] c0s7,
        byte[32]  c1s0, byte[32] c1s1, byte[32] c1s2, byte[32] c1s3, byte[32] c1s4, byte[32] c1s5, byte[32] c1s6, byte[32] c1s7,
        byte[32]  c2s0, byte[32] c2s1, byte[32] c2s2, byte[32] c2s3, byte[32] c2s4, byte[32] c2s5, byte[32] c2s6, byte[32] c2s7,
        byte[32]  c3s0, byte[32] c3s1, byte[32] c3s2, byte[32] c3s3, byte[32] c3s4, byte[32] c3s5, byte[32] c3s6, byte[32] c3s7,
        byte[32]  c4s0, byte[32] c4s1, byte[32] c4s2, byte[32] c4s3, byte[32] c4s4, byte[32] c4s5, byte[32] c4s6, byte[32] c4s7
    ) {
        // ① path A threshold t=4-of-5: each sig bound to ITS committee PK; counter requires ≥4 valid.
        // if (checkSig false) → branch skipped (no contract failure); require enforces threshold.
        // Tolerates 1 absent/equivocating committee member.
        int validSigs = 0;
        if (checkSig(c0Sig, pubkey(c0Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c1Sig, pubkey(c1Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c2Sig, pubkey(c2Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c3Sig, pubkey(c3Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c4Sig, pubkey(c4Pk))) { validSigs = validSigs + 1; }
        require(validSigs >= 4);
        require(winner == 0 || winner == 1);

        // ② committee commitment — binds revealed committee to a hash usable by dispute_reveal.
        byte[] cConcat0 = c0Pk + c1Pk;
        byte[] cConcat1 = cConcat0 + c2Pk;
        byte[] cConcat2 = cConcat1 + c3Pk;
        byte[] cConcat3 = cConcat2 + c4Pk;
        byte[32] committeeHash = blake2b(cConcat3);
        require(committeeHash == committeePkHash);

        // ③ depth-8 merkle proof per committee PK against ctor-baked poolMerkleRoot.
        // Hardcoded leaf-left order (= matches J2.1 pool-merkle-builder convention).
        byte[32] c0Leaf  = blake2b(byte[](c0Pk));
        byte[]   c0St0   = c0Leaf + c0s0;  byte[32] c0L0 = blake2b(c0St0);
        byte[]   c0St1   = c0L0   + c0s1;  byte[32] c0L1 = blake2b(c0St1);
        byte[]   c0St2   = c0L1   + c0s2;  byte[32] c0L2 = blake2b(c0St2);
        byte[]   c0St3   = c0L2   + c0s3;  byte[32] c0L3 = blake2b(c0St3);
        byte[]   c0St4   = c0L3   + c0s4;  byte[32] c0L4 = blake2b(c0St4);
        byte[]   c0St5   = c0L4   + c0s5;  byte[32] c0L5 = blake2b(c0St5);
        byte[]   c0St6   = c0L5   + c0s6;  byte[32] c0L6 = blake2b(c0St6);
        byte[]   c0St7   = c0L6   + c0s7;  byte[32] c0Root = blake2b(c0St7);
        require(c0Root == poolMerkleRoot);

        byte[32] c1Leaf  = blake2b(byte[](c1Pk));
        byte[]   c1St0   = c1Leaf + c1s0;  byte[32] c1L0 = blake2b(c1St0);
        byte[]   c1St1   = c1L0   + c1s1;  byte[32] c1L1 = blake2b(c1St1);
        byte[]   c1St2   = c1L1   + c1s2;  byte[32] c1L2 = blake2b(c1St2);
        byte[]   c1St3   = c1L2   + c1s3;  byte[32] c1L3 = blake2b(c1St3);
        byte[]   c1St4   = c1L3   + c1s4;  byte[32] c1L4 = blake2b(c1St4);
        byte[]   c1St5   = c1L4   + c1s5;  byte[32] c1L5 = blake2b(c1St5);
        byte[]   c1St6   = c1L5   + c1s6;  byte[32] c1L6 = blake2b(c1St6);
        byte[]   c1St7   = c1L6   + c1s7;  byte[32] c1Root = blake2b(c1St7);
        require(c1Root == poolMerkleRoot);

        byte[32] c2Leaf  = blake2b(byte[](c2Pk));
        byte[]   c2St0   = c2Leaf + c2s0;  byte[32] c2L0 = blake2b(c2St0);
        byte[]   c2St1   = c2L0   + c2s1;  byte[32] c2L1 = blake2b(c2St1);
        byte[]   c2St2   = c2L1   + c2s2;  byte[32] c2L2 = blake2b(c2St2);
        byte[]   c2St3   = c2L2   + c2s3;  byte[32] c2L3 = blake2b(c2St3);
        byte[]   c2St4   = c2L3   + c2s4;  byte[32] c2L4 = blake2b(c2St4);
        byte[]   c2St5   = c2L4   + c2s5;  byte[32] c2L5 = blake2b(c2St5);
        byte[]   c2St6   = c2L5   + c2s6;  byte[32] c2L6 = blake2b(c2St6);
        byte[]   c2St7   = c2L6   + c2s7;  byte[32] c2Root = blake2b(c2St7);
        require(c2Root == poolMerkleRoot);

        byte[32] c3Leaf  = blake2b(byte[](c3Pk));
        byte[]   c3St0   = c3Leaf + c3s0;  byte[32] c3L0 = blake2b(c3St0);
        byte[]   c3St1   = c3L0   + c3s1;  byte[32] c3L1 = blake2b(c3St1);
        byte[]   c3St2   = c3L1   + c3s2;  byte[32] c3L2 = blake2b(c3St2);
        byte[]   c3St3   = c3L2   + c3s3;  byte[32] c3L3 = blake2b(c3St3);
        byte[]   c3St4   = c3L3   + c3s4;  byte[32] c3L4 = blake2b(c3St4);
        byte[]   c3St5   = c3L4   + c3s5;  byte[32] c3L5 = blake2b(c3St5);
        byte[]   c3St6   = c3L5   + c3s6;  byte[32] c3L6 = blake2b(c3St6);
        byte[]   c3St7   = c3L6   + c3s7;  byte[32] c3Root = blake2b(c3St7);
        require(c3Root == poolMerkleRoot);

        byte[32] c4Leaf  = blake2b(byte[](c4Pk));
        byte[]   c4St0   = c4Leaf + c4s0;  byte[32] c4L0 = blake2b(c4St0);
        byte[]   c4St1   = c4L0   + c4s1;  byte[32] c4L1 = blake2b(c4St1);
        byte[]   c4St2   = c4L1   + c4s2;  byte[32] c4L2 = blake2b(c4St2);
        byte[]   c4St3   = c4L2   + c4s3;  byte[32] c4L3 = blake2b(c4St3);
        byte[]   c4St4   = c4L3   + c4s4;  byte[32] c4L4 = blake2b(c4St4);
        byte[]   c4St5   = c4L4   + c4s5;  byte[32] c4L5 = blake2b(c4St5);
        byte[]   c4St6   = c4L5   + c4s6;  byte[32] c4L6 = blake2b(c4St6);
        byte[]   c4St7   = c4L6   + c4s7;  byte[32] c4Root = blake2b(c4St7);
        require(c4Root == poolMerkleRoot);

        // Payout structure enforcement (Bettor r13/r15 fund-safety):
        //   outputs[0]       = broker fee (P2PK brokerPk)
        //   outputs[1..5]    = 5 committee bond-return + fee-share (P2PK c0Pk..c4Pk, fixed N=5)
        //   outputs[6..]     = bettor winner payouts, bound via 5-of-N sigs over sidesMerkleRoot;
        //                      each PoolSide_v06 enforces its own bettor-merkle-proof at claim time
        //                      (per Bettor r15 split + matches v0.5 PoolSide.sil architecture).
        require(tx.inputs.length >= 1);
        require(tx.outputs.length >= 6);

        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));
        require(tx.outputs[0].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[0].value > 0);

        byte[34] c0Lock = new ScriptPubKeyP2PK(pubkey(c0Pk));
        require(tx.outputs[1].scriptPubKey == byte[](c0Lock));
        require(tx.outputs[1].value >= oracleBondAmount);

        byte[34] c1Lock = new ScriptPubKeyP2PK(pubkey(c1Pk));
        require(tx.outputs[2].scriptPubKey == byte[](c1Lock));
        require(tx.outputs[2].value >= oracleBondAmount);

        byte[34] c2Lock = new ScriptPubKeyP2PK(pubkey(c2Pk));
        require(tx.outputs[3].scriptPubKey == byte[](c2Lock));
        require(tx.outputs[3].value >= oracleBondAmount);

        byte[34] c3Lock = new ScriptPubKeyP2PK(pubkey(c3Pk));
        require(tx.outputs[4].scriptPubKey == byte[](c3Lock));
        require(tx.outputs[4].value >= oracleBondAmount);

        byte[34] c4Lock = new ScriptPubKeyP2PK(pubkey(c4Pk));
        require(tx.outputs[5].scriptPubKey == byte[](c4Lock));
        require(tx.outputs[5].value >= oracleBondAmount);

        // Integer-overflow guards on baked ctor amounts.
        require(oracleBondAmount > 0);
        require(oracleBondAmount < 1000000000000000);   // <1M KAS per oracle bond
        require(makerStakeAmount > 0);
        require(makerStakeAmount < 1000000000000000);   // <1M KAS per maker stake
        require(minerFee > 0);
        require(minerFee < 100000000);                  // <1 KAS miner fee
    }

    // entry 1 — dispute_reveal: triggered when a settle outcome is disputed. Each committee
    // member's individual sig over disputeOutcomeHash is required (unanimous t=5 here, since
    // dispute mode is about establishing individual accountability for slashing).
    entrypoint function dispute_reveal(
        byte[32]  committeePkHash,
        byte[32]  disputeOutcomeHash,
        byte[32]  c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
        sig       c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig
    ) {
        byte[] dConcat0 = c0Pk + c1Pk;
        byte[] dConcat1 = dConcat0 + c2Pk;
        byte[] dConcat2 = dConcat1 + c3Pk;
        byte[] dConcat3 = dConcat2 + c4Pk;
        byte[32] dHash  = blake2b(dConcat3);
        require(dHash == committeePkHash);

        require(checkSig(c0Sig, pubkey(c0Pk)));
        require(checkSig(c1Sig, pubkey(c1Pk)));
        require(checkSig(c2Sig, pubkey(c2Pk)));
        require(checkSig(c3Sig, pubkey(c3Pk)));
        require(checkSig(c4Sig, pubkey(c4Pk)));

        require(tx.inputs.length >= 1);
        require(tx.outputs.length >= 1);
    }

    // entry 2 — refund_maker_unjoined: maker recovers stake if no bettor joined.
    entrypoint function refund_maker_unjoined(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= deadline * 1000);  // bug 10d Path A: LOCK_TIME_THRESHOLD requires ms
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        require(tx.outputs[0].value == makerStakeAmount - minerFee);
    }
}

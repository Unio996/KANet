// PoolSpine.sil v0.5 hybrid first draft — B2 pool spine anchor contract
//
// Architecture: Hybrid = Option D (oracle settlement message) + Angle 2 (multi-UTXO per-bettor side)
//
// Role:
// - PoolSpine = market anchor (= maker stake + 3 oracle bonds locked here)
// - PoolSide = per-bettor stake contract (= bettor pubkey + direction baked, 1 side P2SH per bettor)
// - At settle: 1 big TX consumes spine + N sides as inputs, outputs proportional payouts
// - 3 oracle 3-of-3 unanimous (= or 2-of-3 with 1 forfeit per v0.5)
// - Bettors registered via Merkle root (= sides_merkle_root in oracle settlement message)
//
// v0.5 simplifications (= 6 rounds adversarial converge):
// - Scope: 50 bettors max per market
// - Pot cap $100 KAS testnet + scope to small mainnet pot
// - L3 challenge defer Phase 5+
// - Forfeit silent only (= not dissent signed oracle)

pragma silverscript ^0.1.0;

contract PoolSpine(
    byte[32] makerPk,
    byte[32] brokerPk,
    byte[32] oracle1Pk,
    byte[32] oracle2Pk,
    byte[32] oracle3Pk,
    int deadline,             // unix seconds, after which forfeit/refund eligible
    int minerFee,             // sompi for chain TX
    int brokerFeePct,         // basis points
    int oracleFeePct,         // basis points — Oracle v0.3 R7 truth matrix (range 5-20%, 500-2000 bps)
                              //   prediction settle: losingPool × oracleFeePct / 10000 平分 3 oracle (合并 outputs[last 3] per J1 #2 选项 A)
                              //   公式 sediment: distributablePool = losingPool − brokerFee − oracleFee
                              //   KIP-10 loop verify + 真 enforce 跟 broker fee 一起 Phase 2 implement (= 不 NWT sub 4 scope)
                              //   Layer 2 SS defense-in-depth deferred (= 等 Phase 2 KIP-10 loop spendable compute 时一起加 require)
                              //   Layer 1 console create-time reject enforce per pool.js (= dynamic formula 12500 / oracleFeePct_bps × 100M sompi)
    int oracleBondAmount,     // per-oracle bond locked at deploy
    int makerStakeAmount,     // maker initial stake at deploy
    byte[32] marketMetadataHash  // sha256 of market spec (= condition_id, outcome_token_id, resolution_rule)
) {
    // entry 0 — settle_unanimous: 3 oracle 全签 + winner OP + sides_merkle_root verify
    // TX inputs: spine + all bettor sides (= N+1 inputs)
    // TX outputs: 1 broker fee + N winner payouts (= proportional to winner side stakes) + 3 oracle bonds returned + 0-2 burns (= depends on actual N)
    // KIP-10 used: OpTxInputCount + OpTxInputAmount + OpTxOutputSpk + OpTxOutputAmount
    entrypoint function settle_unanimous(
        sig sig1, sig sig2, sig sig3,
        int winner,                       // 0 = YES wins, 1 = NO wins
        byte[32] sidesMerkleRoot          // Merkle root of all bettor sides (= scriptPubKey hashes)
    ) {
        // Phase 1: 3 oracle unanimous verify
        require(checkSig(sig1, pubkey(oracle1Pk)));
        require(checkSig(sig2, pubkey(oracle2Pk)));
        require(checkSig(sig3, pubkey(oracle3Pk)));
        require(winner == 0 || winner == 1);

        // Phase 2: structure check
        // inputs.length = 1 spine + N sides
        // outputs.length = 1 broker + N bettor + 3 oracle bond
        require(tx.inputs.length >= 4);  // spine + 3 oracle bonds min OR spine + maker + 2 bettors min
        require(tx.outputs.length >= 4); // similar lower bound

        // Phase 3: oracle bond returns (= each oracle gets bond back since all signed)
        byte[34] oracle1Lock = new ScriptPubKeyP2PK(pubkey(oracle1Pk));
        byte[34] oracle2Lock = new ScriptPubKeyP2PK(pubkey(oracle2Pk));
        byte[34] oracle3Lock = new ScriptPubKeyP2PK(pubkey(oracle3Pk));

        // Convention: last 3 outputs are oracle bond returns (= bondAmount each)
        // Off-chain settler must construct TX with this ordering.
        // TODO Phase 2 iteration: KIP-10 loop verify each oracle output position + amount

        // Phase 4: broker fee (= output[0])
        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));
        require(tx.outputs[0].scriptPubKey == byte[](brokerLock));
        // brokerFeeAmount = (total_pool - oracle_bonds_returned) * brokerFeePct / 10000
        // total_pool sum via OpTxInputAmount loop (= deferred for first draft)

        // Phase 5: winner payouts (= outputs[1] through outputs[1+N-1])
        // Each output[1+i] goes to a bettor on winning side
        // Side claim verifies Merkle proof at claim time
        // sidesMerkleRoot baked into spine settle TX sig (= oracle committed)
        // TODO Phase 2: full Merkle verify per output via OP_BLAKE2B + OP_CAT

        // FIRST DRAFT: minimum viable verification
        // Phase 1 satisfies 3-of-3 unanimous + winner OP arg + Merkle root in scriptSig
        // Production version needs full output enumeration via KIP-10 loop
    }

    // entry 1 — settle_majority_forfeit_1 (v0.5 spec core liveness): 2 oracle sign + 1 silent 24h timeout
    // silent_oracle_index identifies which oracle (0/1/2) was silent (= bond forfeited)
    // Other 2 oracle sigs verified. Generic entry handles all 3 silent cases via index.
    entrypoint function settle_majority_forfeit_1(
        sig sigA,
        sig sigB,
        int silentOracleIndex,  // 0 = oracle1 silent, 1 = oracle2 silent, 2 = oracle3 silent
        int winner,
        byte[32] sidesMerkleRoot
    ) {
        // bug 10d fix (Path A): Kaspa LOCK_TIME_THRESHOLD 500B requires ms-scale operand
        require(tx.time >= deadline * 1000);
        require(winner == 0 || winner == 1);
        require(silentOracleIndex >= 0 && silentOracleIndex <= 2);

        // verify the 2 signed oracles per silent index
        // silent=0 (oracle1) → sigA=oracle2, sigB=oracle3
        // silent=1 (oracle2) → sigA=oracle1, sigB=oracle3
        // silent=2 (oracle3) → sigA=oracle1, sigB=oracle2
        if (silentOracleIndex == 0) {
            require(checkSig(sigA, pubkey(oracle2Pk)));
            require(checkSig(sigB, pubkey(oracle3Pk)));
        } else {
            if (silentOracleIndex == 1) {
                require(checkSig(sigA, pubkey(oracle1Pk)));
                require(checkSig(sigB, pubkey(oracle3Pk)));
            } else {
                require(checkSig(sigA, pubkey(oracle1Pk)));
                require(checkSig(sigB, pubkey(oracle2Pk)));
            }
        }

        // structure: spine + sides + 2 surviving oracle bonds returned
        // silent oracle bond forfeited (= split per v0.5 spec: 50% bettors / 25% maker / 25% remaining oracles)
        // simplified for first iteration: outputs verify via Phase 2 KIP-10 loop
        require(tx.inputs.length >= 4);
        require(tx.outputs.length >= 4);
    }

    // entry 2 — refund_all_unanimous_silent: all 3 oracle silent 24h, maker triggers
    // All bettor sides released back to bettors via their own claim path
    // Maker single-sig sufficient since no settlement decision needed
    entrypoint function refund_unanimous_silent(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= deadline * 1000);  // bug 10d fix Path A

        // Maker recovers stake + all 3 oracle bonds forfeited to maker
        // Bettor sides released independently via their own refund path
        require(tx.outputs.length >= 1);

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        // maker gets stake + 3 bonds (= total forfeit)
        require(tx.outputs[0].value == makerStakeAmount + oracleBondAmount * 3 - minerFee);
    }

    // entry 2 — refund_maker_unjoined: no bettor joined, only spine UTXO + maker stake
    entrypoint function refund_maker_unjoined(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= deadline * 1000);  // bug 10d fix Path A
        require(tx.inputs.length == 1);   // only spine
        require(tx.outputs.length == 1);

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        require(tx.outputs[0].value == makerStakeAmount - minerFee);
    }

    // entry 4 — refund_disagreement: 3 oracle votes split (Gap 1A 3-dissent / Gap 1B 1-silent)
    // Per area-4 + Owner 5/23 burn 钦定: full refund to maker + dissent oracle bonds. Silent
    // oracle bond (Gap 1B only) is BURNED (= not assigned to any output, sompi flow into
    // minerFee). 2-of-3 oracle sig (= dropped maker sig per area-4 Gap 7 to prevent
    // losing-maker rug-via-refund-race). DISAGREEMENT_TIMEOUT SS-hardcoded at 300 sec
    // (testnet 5 min per area-7 T5; mainnet rebuild with different value = different P2SH).
    //
    // signingPair selects which 2 of 3 oracles sign:
    //   0 = oracle1 + oracle2; 1 = oracle1 + oracle3; 2 = oracle2 + oracle3
    // silentOracleIndex semantics:
    //  -1 = Gap 1A (all 3 voted, all dissent) → 4 outputs = maker + 3 oracle bonds, any signingPair
    //   0/1/2 = Gap 1B (this oracle silent) → 3 outputs = maker + 2 dissent oracle bonds,
    //          signingPair forced to (2 - silentOracleIndex) per P6 defense-in-depth.
    entrypoint function refund_disagreement(
        sig oracleSig1,
        sig oracleSig2,
        int signingPair,
        int silentOracleIndex
    ) {
        // bug 10d fix (Path A): Kaspa LOCK_TIME_THRESHOLD 500B requires ms-scale operand.
        // (deadline + 300) sec * 1000 = deadline_ms + 300_000 ms (= preserved 5min buffer).
        require(tx.time >= (deadline + 300) * 1000);
        require(signingPair >= 0 && signingPair <= 2);
        require(silentOracleIndex >= -1 && silentOracleIndex <= 2);

        // P6 constraint 2: signingPair must NOT include silentOracleIndex (Gap 1B only)
        if (silentOracleIndex == 0) {
            require(signingPair == 2);
        } else {
            if (silentOracleIndex == 1) {
                require(signingPair == 1);
            } else {
                if (silentOracleIndex == 2) {
                    require(signingPair == 0);
                }
            }
        }

        // Sig verify per signingPair
        if (signingPair == 0) {
            require(checkSig(oracleSig1, pubkey(oracle1Pk)));
            require(checkSig(oracleSig2, pubkey(oracle2Pk)));
        } else {
            if (signingPair == 1) {
                require(checkSig(oracleSig1, pubkey(oracle1Pk)));
                require(checkSig(oracleSig2, pubkey(oracle3Pk)));
            } else {
                require(checkSig(oracleSig1, pubkey(oracle2Pk)));
                require(checkSig(oracleSig2, pubkey(oracle3Pk)));
            }
        }

        // P6 constraint 1: outputs.length strict equality with silentOracleIndex sentinel
        if (silentOracleIndex == -1) {
            require(tx.outputs.length == 4);
        } else {
            require(tx.outputs.length == 3);
        }

        // output[0] = maker refund (= makerStakeAmount - minerFee, maker bears the fee per
        // area-4 Gap 9 — consistent with refund_unanimous_silent).
        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));
        require(tx.outputs[0].value == makerStakeAmount - minerFee);

        // outputs[1..N] = surviving (= non-silent) oracle bond returns. Full KIP-10
        // ordering / amount verification deferred for first iteration (= matches existing
        // settle_unanimous + forfeit_1 entries' TODO). The oracle sigs over the sighash
        // already bind output destinations, so off-chain settler-built TXs are protected.
    }
}

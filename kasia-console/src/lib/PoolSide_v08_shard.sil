// PoolSide_v08_shard.sil — bshard sharded per-bettor side (J1, 2026-06-15). 显式 State 变体.
//
// 与 PoolSide_v07 差异(两处):
//   (1) **6 字段从 ctor → 显式 State**(field_prolog len>0) → validateOutputStateWithTemplate 可 template(J1 leaf register
//       绑此; J2 template-artifact 生成器需显式 State 才能切 prefix/state/suffix). 现 v07 纯 ctor → field_prolog len=0 不可 template.
//   (2) **claim_winner 替委员 4-of-5 attestation → fold-root 绑定**(J2 spec + NWT struct-syntax): claim 引 fold-root UTXO,
//       readInputStateWithTemplate 读链上 fold 派生 globalYes/No(实值非 witness) + root.count==shard_count(全折锚) → parimutuel. 零委员 merkle.
//
// 新合约新 P2SH(不碰老 v07 市场, 同 v06→v07 precedent). refund 保留 v07 逐字.
// 单 author = J1(SS 我域); template artifact + off-chain = J2; claim 语义 J2 给 spec; struct-syntax = NWT(kcc20-minter 模式); NWT co-verify PoC-5.

pragma silverscript ^0.1.0;

contract PoolSide_v08_shard(
    // —— init for 显式 State (6 字段, ctor 注入 → State; 顺序 = J2 schema L64-70) ——
    byte[32] init_bettorPk,
    byte[32] init_spineP2shHash,        // = 本 shard 的 spine(PoolSide 天然 scope 到片)
    byte[32] init_poolMerkleRoot,
    byte[32] init_marketMetadataHash,
    int      init_direction,             // 0=YES 1=NO
    int      init_deadline,
    // —— 非-State ctor(claim fold-root 绑定常量; 不进 template state 区) ——
    int      shard_id,                   // 片身份
    int      shard_count,                // 关池片数(claim 验 root.count==此 → 全折完 ROOT 非中间 fold, NWT 命门)
    byte[32] fold_template_hash          // fold-root template hash(readInputStateWithTemplate 自验, J2 artifact 给真值, byte-match)
) {
    // —— 显式 State(6 字段; validateOutputStateWithTemplate 的 state 区) ——
    byte[32] bettorPk = init_bettorPk;
    byte[32] spineP2shHash = init_spineP2shHash;
    byte[32] poolMerkleRoot = init_poolMerkleRoot;
    byte[32] marketMetadataHash = init_marketMetadataHash;
    int      direction = init_direction;
    int      deadline = init_deadline;

    // fold-root 的 State 布局(= PoolShard_fold 的 {local_yes, local_no, count}); readInputStateWithTemplate 绑此 struct.
    struct FoldRootState {
        int local_yes;
        int local_no;
        int count;
    }

    // entry 0 — claim_winner (fold-root 绑定, 替 v07 委员 4-of-5; J2 spec + NWT struct-syntax 自取另一半).
    //   ① readInputStateWithTemplate 读 fold-root globalYes/No 实值 —— 原语**自验 foreign template hash + P2SH commitment**
    //      → claim 自动绑实 fold 合约(非假) = NWT PoC-5 经此原语堵.
    //   ② require(root.count == shard_count) → 读的是**全折完 ROOT**(非中间 fold 部分 global, 否则错额) = NWT 命门.
    //   ③ payout = parimutuel(本 stake, root.local_yes/no, 赢向) + spent-once(本 side UTXO 花) + 输向无 payout(direction==winner gate).
    entrypoint function claim_winner(
        sig bettorSig,
        int settlementWinner,            // 0=YES 1=NO(赢向; direction gate 绑)
        int fold_root_input_idx,         // fold-root UTXO 在 inputs 的位(ref)
        int fold_prefix_len,             // fold template prefix 长(J2 artifact)
        int fold_suffix_len              // fold template suffix 长
    ) {
        require(checkSig(bettorSig, pubkey(bettorPk)));     // bettor 授权自取
        require(settlementWinner == 0 || settlementWinner == 1);
        require(direction == settlementWinner);             // 我在赢向(输向无 payout)

        // ① 读 fold-root 链上派生 global(实值非 witness); 原语自验 fold template hash + P2SH(PoC-5).
        FoldRootState root = readInputStateWithTemplate(fold_root_input_idx, fold_prefix_len, fold_suffix_len, fold_template_hash);
        // ② 必全折完 ROOT(非中间 fold) —— NWT 命门(中间 fold 部分 global → 错额).
        require(root.count == shard_count);
        require(root.count > 0);

        // ③ parimutuel payout (totalPool/winnerPool 来自链上 fold 实 global).
        int notWinner = 1 - settlementWinner;
        int winnerPool = root.local_yes * notWinner + root.local_no * settlementWinner;
        int totalPool = root.local_yes + root.local_no;
        require(winnerPool > 0);
        require(tx.inputs.length >= 1);                     // inputs[0]=本 side UTXO(spent-once 自取) + fold-root ref + fee-UTXO
        int payout = tx.inputs[0].value * totalPool / winnerPool;

        // 出 bettor(spent-once: 本 side UTXO 被花 → 不可双领).
        require(tx.outputs.length >= 1);
        byte[34] bettorLock = new ScriptPubKeyP2PK(pubkey(bettorPk));
        require(tx.outputs[0].scriptPubKey == byte[](bettorLock));
        require(tx.outputs[0].value <= payout);
        require(tx.outputs[0].value >= payout - 100000000); // fee [0, 1KAS]
        require(tx.outputs[0].value >= 1000);               // dust floor
    }

    // entry 1 — refund_market_cancelled (保留 v07 逐字; bettor 过 deadline+grace 自退).
    entrypoint function refund_market_cancelled(sig bettorSig) {
        require(checkSig(bettorSig, pubkey(bettorPk)));
        require(tx.time >= (deadline + 7200) * 1000);
        require(tx.inputs.length >= 1);
        require(tx.outputs.length == 1);
        byte[34] bettorLock = new ScriptPubKeyP2PK(pubkey(bettorPk));
        require(tx.outputs[0].scriptPubKey == byte[](bettorLock));
        require(tx.outputs[0].value <= tx.inputs[0].value - 1000);
        require(tx.outputs[0].value >= tx.inputs[0].value - 100000000);
        require(tx.outputs[0].value >= 1000);
    }
}

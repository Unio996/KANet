// RootStub_probe_p27.sil — J1 binary-search stub (probe-only, 非生产). pad=27 dummy require → 目标模板尺寸阶梯.
// J2 :3200 canonical 编译此 + seal→ 探 land/bust, binary-search 最大 fit 模板字节 = THE 阈值. dummy require 不影响语义(纯字节填充).
pragma silverscript ^0.1.0;
contract RootStub(int init_local_yes,int init_local_no,int init_count,int init_pool_value,int init_closed,int init_winningSide,byte[32] init_payoutRoot){
 int local_yes=init_local_yes; int local_no=init_local_no; int count=init_count; int pool_value=init_pool_value; int closed=init_closed; int winningSide=init_winningSide; byte[32] payoutRoot=init_payoutRoot;
 entrypoint function passthrough(int outIdx){
  require(count + 0 >= 0);
  require(count + 1 >= 0);
  require(count + 2 >= 0);
  require(count + 3 >= 0);
  require(count + 4 >= 0);
  require(count + 5 >= 0);
  require(count + 6 >= 0);
  require(count + 7 >= 0);
  require(count + 8 >= 0);
  require(count + 9 >= 0);
  require(count + 10 >= 0);
  require(count + 11 >= 0);
  require(count + 12 >= 0);
  require(count + 13 >= 0);
  require(count + 14 >= 0);
  require(count + 15 >= 0);
  require(count + 16 >= 0);
  require(count + 17 >= 0);
  require(count + 18 >= 0);
  require(count + 19 >= 0);
  require(count + 20 >= 0);
  require(count + 21 >= 0);
  require(count + 22 >= 0);
  require(count + 23 >= 0);
  require(count + 24 >= 0);
  require(count + 25 >= 0);
  require(count + 26 >= 0);
  validateOutputState(outIdx,{local_yes:local_yes,local_no:local_no,count:count,pool_value:pool_value,closed:closed,winningSide:winningSide,payoutRoot:payoutRoot});
  require(tx.outputs[outIdx].value==pool_value);
 }
}
// PoolSide.sil v0.5 hybrid first draft — B2 per-bettor side contract
//
// 1 PoolSide P2SH per bettor. Bettor locks stake at deploy time.
// At settle: side can be spent either via spine settle TX (= cooperative, winner takes pool share)
// OR via individual claim with oracle settlement message (= bettor self-claims with Merkle proof).
//
// Ctor params:
// - bettorPk: bettor's pubkey (= unique per side)
// - direction: 0 = YES, 1 = NO (= which side bettor bets on)
// - stakeAmount: sompi amount bettor locked
// - spineP2shHash: 32-byte hash of spine P2SH (= verifies side belongs to specific market)
// - 3 oracle pubkeys (= same as spine, for cross-market consistency check)
// - deadline (= same as spine)
// - marketMetadataHash (= same as spine, prevents cross-market reuse)

pragma silverscript ^0.1.0;

contract PoolSide(
    byte[32] bettorPk,
    byte[32] spineP2shHash,
    byte[32] oracle1Pk,
    byte[32] oracle2Pk,
    byte[32] oracle3Pk,
    byte[32] marketMetadataHash,
    int direction,          // 0 = YES, 1 = NO
    int stakeAmount,
    int deadline
) {
    // entry 0 — settled_via_spine: side consumed by spine settle TX
    // Triggered when spine settle TX includes this side as input.
    // Verification: one of TX inputs is spine UTXO (= scriptPubKey hash matches spineP2shHash).
    // KIP-10 OpTxInputSpk used to verify spine reference.
    entrypoint function settled_via_spine() {
        // Phase 1: verify one input is the spine UTXO
        // For first draft: trust spine settle entry to validate everything
        // (= side just allows itself to be consumed by spine settle, gets payout via output)
        require(tx.inputs.length >= 2);  // spine + this side minimum

        // Phase 2 iteration TODO: loop KIP-10 OpTxInputSpk to find spine in inputs,
        // verify spine P2SH hash matches baked spineP2shHash
        // For now: minimum check passes, spine settle entry does heavy verification
    }

    // entry 1 — claim_winner: bettor self-claims with oracle settlement message + Merkle proof
    // v2: full Merkle proof verify (= max depth 6 unrolled for v0.5 50-bettor cap)
    // Required: bettor sig + 3 oracle sigs + settlement params + Merkle siblings (6 layers)
    entrypoint function claim_winner(
        sig bettorSig,
        sig oracleSig1,
        sig oracleSig2,
        sig oracleSig3,
        int settlementWinner,
        int totalYesPool,
        int totalNoPool,
        byte[32] sidesMerkleRoot,
        byte[32] sibling0,
        byte[32] sibling1,
        byte[32] sibling2,
        byte[32] sibling3,
        byte[32] sibling4,
        byte[32] sibling5
    ) {
        require(checkSig(bettorSig, pubkey(bettorPk)));
        require(checkSig(oracleSig1, pubkey(oracle1Pk)));
        require(checkSig(oracleSig2, pubkey(oracle2Pk)));
        require(checkSig(oracleSig3, pubkey(oracle3Pk)));
        require(direction == settlementWinner);

        // Merkle proof verify: this side's identity (= bettorPk hash) climbs 6 levels to root
        // First draft: simplified using bettorPk as leaf, full canonical version uses sha256(bettorPk||direction||stakeAmount)
        byte[32] leaf = blake2b(byte[](bettorPk));
        byte[] step0 = leaf + sibling0;
        byte[32] level0 = blake2b(step0);
        byte[] step1 = level0 + sibling1;
        byte[32] level1 = blake2b(step1);
        byte[] step2 = level1 + sibling2;
        byte[32] level2 = blake2b(step2);
        byte[] step3 = level2 + sibling3;
        byte[32] level3 = blake2b(step3);
        byte[] step4 = level3 + sibling4;
        byte[32] level4 = blake2b(step4);
        byte[] step5 = level4 + sibling5;
        byte[32] root = blake2b(step5);
        require(root == sidesMerkleRoot);

        // Payout calculation (= simplified, production version handles edge cases)
        int totalPool = totalYesPool + totalNoPool;
        int winnerPool = totalYesPool;
        int payout = stakeAmount * totalPool / winnerPool;

        require(tx.outputs.length == 1);
        byte[34] bettorLock = new ScriptPubKeyP2PK(pubkey(bettorPk));
        require(tx.outputs[0].scriptPubKey == byte[](bettorLock));
        require(tx.outputs[0].value == payout);
    }

    // entry 1.5 — consumed_by_oracle_settlement: any party can spend this side for redistribution
    // when oracle settlement message designates target_addr (= winning bettor address)
    // Path B mechanism: side becomes "public claim ticket" releasable by oracle
    entrypoint function consumed_by_oracle_settlement(
        sig oracleSig1,
        sig oracleSig2,
        sig oracleSig3,
        int settlementWinner,
        byte[32] targetAddr  // pubkey of bettor to receive payout
    ) {
        require(checkSig(oracleSig1, pubkey(oracle1Pk)));
        require(checkSig(oracleSig2, pubkey(oracle2Pk)));
        require(checkSig(oracleSig3, pubkey(oracle3Pk)));

        // Only losing side can be redistributed by oracle (= winners self-claim via claim_winner)
        require(direction != settlementWinner);

        // Output to target_addr from oracle settlement (= winning bettor)
        require(tx.outputs.length == 1);
        byte[34] targetLock = new ScriptPubKeyP2PK(pubkey(targetAddr));
        require(tx.outputs[0].scriptPubKey == byte[](targetLock));
        require(tx.outputs[0].value == stakeAmount - 1000);  // minerFee placeholder
    }

    // entry 2 — refund_market_cancelled: maker triggered refund, bettor recovers own stake
    // Verification: maker sig (= bettor proves market cancelled via maker sig on refund TX)
    entrypoint function refund_market_cancelled(sig bettorSig) {
        require(checkSig(bettorSig, pubkey(bettorPk)));
        // bug 10d fix (cycle 5 Path A): Kaspa Crescendo LOCK_TIME_THRESHOLD = 500B.
        // operand < 500B → DAA score (= testnet ~10M, never reaches 1.78B sec value).
        // Multiply by 1000 → operand ≥ 500B → ms interpretation matches tx.lockTime ms.
        require(tx.time >= deadline * 1000);

        require(tx.outputs.length == 1);
        byte[34] bettorLock = new ScriptPubKeyP2PK(pubkey(bettorPk));
        require(tx.outputs[0].scriptPubKey == byte[](bettorLock));
        require(tx.outputs[0].value == stakeAmount - 1000);  // minerFee placeholder
    }
}

// PoolSpine_v07_shard — #26 bshard 件1 shard 叶 (J1 草稿 seed, 待 J2 Q5 mass 实测 + NWT attack-PoC).
//
// 性质: DRAFT (.sil.draft, 非编译路) — seed J2 编译量 op<201/bytecode<10000B 定 MAX_FOLD_K (件2 fold 依赖)
//       + NWT 件1 attack-PoC. impl plan 63d3ac35 件1. SS 原语真读 DECL.md (VaultNM L208-265 state 语法 +
//       conserve_and_bump N:M + readInputState + OpInputCovenantId, 非凭记忆).
//
// 设计 (5-agent §4 收敛 2026-06-14): 每片 = 独立 shard UTXO 携 localYes/localNo (script state, J2 Q2 定:
//   两标量塞不进单 value field → 必 state). 关池后 fold 树 (件2 PoolFold.sil) readInputState 读各片 local
//   → 链上层次求和到 1 root UTXO 携 globalYes/globalNo → commit 硬校验 (件3). by-root determinism (件4).
//
// NWT 件1 attack-surface 焊 (r-msg threat model):
//   ① 叶 state genesis (最尖): 创建时 localYes==0 && localNo==0 起 (init_* 必 0, ctor 焊) + register 单调增
//      → fold readInputState 拿不可篡改的真 tally. (防 #1b 叶后改 / 伪 genesis)
//   ③ conserve 溢出: localYes/localNo 上界 assert (< MAX_TALLY) 防 fold 求和近 2^128 wrap (BigInt sompi
//      零 float 已对, 加上界).
//
// ⚠ 开放集成点 (待 §4 设计讨论 + J2 fold 调度域定, 本草稿先立 state+register 结构):
//   - pot 模型: shard UTXO 是否同时携【本金 pot】(本片 staked 总额) 供 settle 分账? vs side_lock 独立?
//     (现 v07: 资金锁 per-bettor side_lock P2SH; shard pot 是否聚合本金 = 滚动分片 §2.A 设计点).
//   - bet_stake == 真 staked UTXO value 绑定: register 时 require bet 对应 side_lock UTXO 真值 (introspection
//     tx.inputs[].value, 同 #27a side_lock 思路) — 防伪 tally 灌水.
//   - rolling 分片 ("填满即挂钩"): 片满 → 新片开 + 锚同 market_id (ctor 已有 shard_id/shard_count/market_id).

pragma silverscript ^0.1.0;

contract PoolSpine_v07_shard(
    // —— market 锚 (== PoolSpine_v07, 所有片同值锚同 logical market) ——
    byte[32] makerPk,
    byte[32] brokerPk,
    byte[32] poolMerkleRoot,
    int      deadline,
    byte[32] marketMetadataHash,
    int      shard_id,            // 0..shard_count-1
    int      shard_count,
    byte[32] market_id,
    // —— shard 叶 state genesis (NWT 攻击面①: 必 0 起) ——
    int      init_localYes,      // 创建时 == 0 (ctor 调用方焊 0; SS 侧 register 单调增防后改)
    int      init_localNo,
    // —— fold covenant 循环界 (①合并: fold entrypoint 并入本叶合约同 cov_id, Bettor r637+NWT 拍) ——
    int      max_fold_ins,       // = MAX_FOLD_K (fold for 循环界, Q5 mass 实测定; register_bet binding=auth from=1 无循环不需界)
    int      max_fold_outs       // = 1 (fold k→1; 对齐 conserve_and_bump to=max_outs 模板)
) {
    // —— 可变 state (UTXO 携值, fold 经 readInputState 读) ——
    int localYes = init_localYes;
    int localNo  = init_localNo;

    // 上界 (NWT ③ conserve 溢出): 单片 tally 上限, 防 fold 求和 wrap. testnet 占位, mass/经济实定.
    // 21e6 KAS * 1e8 sompi = 2.1e15 << 2^128, 留足头.
    // (用 require 显式上界比靠类型隐式安全 — silverc int 是 big, 无溢出但 fold 多片求和要逻辑上界.)

    // —— entry: register_bet (transition covenant) ——
    // 一注加入本片: prev(localYes,localNo) → new = prev + 本注 (方向对应 tally), 另一边不变.
    // NWT ①: genesis 0 起 + 此处单调增 (new >= prev) → tally 链上不可篡改累计 = fold 读真值.
    //
    // SS 校准 (DECL.md 实读, J2 r-msg 两点修):
    //   ① transition mode 必声明返回值 (DECL.md L136-153): transition 函数【计算并 return 新 state】,
    //      非 verification 式把 new_states 当入参 require-校验. 故签名去 new_states 入参 + 加 `: (State)` 返回型
    //      + 末尾 return 新 state object. (verification 范式见 conserve_and_bump; 件1 叶 register 是 transition.)
    //   ② binding=auth 非 cov (DECL.md Rule 5/8 L44-51): register = 1 shard 入→1 shard 出 (from=1,to=1) 真 1:1.
    //      Rule 5: from==1 → 默认 auth; Rule 8: 显写 binding=cov+from=1 触发 warning 荐 auth. 1:1 用 auth =
    //      更省 op (单 entrypoint vs cov 双 leader/delegate) + this.activeInputIndex 直取 prev_state.
    //      bettor side_lock stake 是 tx.inputs[1] 普通 introspection 校验 (非 covenant 续延 state), auth 只守
    //      shard spine 续延正确 = 语义对. (件2 fold = N:M conserve → 那里才 binding=cov, 与叶 register 不冲突.)
    #[covenant(binding = auth, from = 1, mode = transition)]
    function register_bet(State prev_state, int bet_direction, int bet_stake, sig bettor_sig) : (State) {
        require(bet_stake > 0);
        require(bet_direction == 0 || bet_direction == 1);

        // NWT 攻击面#1 (hard-req, J2 r1146 fold/pot 域确认非可选): bet_stake 必绑【真 side_lock UTXO value】—
        // OpInputCovenantId 白名单只认输入 cov_id (= 是 shard/side_lock 模板), 不认 tally 增量的【值】; 不绑则
        // 攻击者喂小 side_lock 却 register 大 bet_stake = 伪 tally 灌水 → fold globalYes/No 失真 → 假 settle 分账.
        // 绑定 = introspection tx.inputs[side_lock_idx].value == bet_stake (同 #27a side_lock daa-anchor: tally
        // 增量锚链上真本金, 非 caller 自报). side_lock_idx = register TX 里 side_lock UTXO 输入位 (= bettor 在
        // side_p2sh 锁的本注, 现 join 进本片). bettor_sig 验本注归属.
        require(tx.inputs.length >= 2);                       // [0]=shard cov 输入, [1]=side_lock 本注输入 (顺序待 J2 TX 构造域定)
        require(tx.inputs[1].value == bet_stake);             // tally 增量 == 链上真锁本金 (防灌水, NWT #1)
        require(checkSig(bettor_sig, tx.inputs[1].scriptPubKey));  // 本注归属 (占位: side_lock redeem 验本人, 待 J2 接口定 — side_lock P2SH 已绑 bettor_pk)

        // 方向对应 tally 增, 另一边不变 (transition: 计算新 tally, 非 require 校验入参).
        int newLocalYes = prev_state.localYes;
        int newLocalNo  = prev_state.localNo;
        if (bet_direction == 0) {
            newLocalYes = prev_state.localYes + bet_stake;
        }
        if (bet_direction == 1) {
            newLocalNo  = prev_state.localNo + bet_stake;
        }

        // NWT ①: 单调增 (bet_stake>0 已蕴含, 显式焊防任何减/重置 — fold 读真值前提).
        require(newLocalYes >= prev_state.localYes);
        require(newLocalNo  >= prev_state.localNo);

        // NWT ③: 上界防 fold 求和 wrap (单片 tally < MAX_TALLY ≈ 2.1e15 sompi << 2^128).
        require(newLocalYes < 2100000000000000);
        require(newLocalNo  < 2100000000000000);

        // transition 续延: 返回新 shard state (编译期 lower 为 validateOutputState 校验输出片 == 此).
        return({ localYes: newLocalYes, localNo: newLocalNo });
    }

    // —— entry: fold (N:M conserve covenant, #26 件2 ①合并进本叶合约) ——
    // N 输入(本模板 shard 叶 + 同模板中间 UTXO) → 1 输出(聚合中间/root). readInputState 逐片读 tally → 逐 sompi
    // 精确求和 → conserve EXACT → root.localYes/localNo = globalYes/globalNo (件3 settle_aggregate introspect 读).
    //
    // ①合并红利 (Bettor r637 + NWT 拍, DECL L271-294 验证驱动): register_bet + fold 共本合约【一脚本=一 cov_id】
    //   → fold 的 OpCovInputCount(cov_id) 只数本模板输入 → shards(register_bet 路径写的)+中间(fold 路径写的) 天然
    //   在 fold covenant group, 假/外来 UTXO(异脚本=异 cov_id)物理上不在 group 进不来 = provenance by-construction
    //   (NWT 攻击面①结构满足, 零手动白名单 op). 零 committee-sig: fold permissionless, conserve 精确(out==Σin)无法偷值.
    //
    // SS: conserve_and_bump N:M 模板 (DECL L224-246 源 + L266-306 lowering): binding=cov + State[] prev_states
    //   由 silverc lower 为 cov_id=OpInputCovenantId → for(k,0,OpCovInputCount(cov_id),max){readInputState(OpCovInputIdx(cov_id,k))}.
    #[covenant(binding = cov, from = max_fold_ins, to = max_fold_outs, mode = verification)]
    function fold(State[] prev_states, State[] new_states) {
        require(prev_states.length >= 1);
        require(new_states.length == 1);        // fold k→1 (单输出聚合; to=max_fold_outs 但语义恒 1)

        int sumYes = 0;
        int sumNo  = 0;
        for(i, 0, prev_states.length, max_fold_ins) {
            sumYes = sumYes + prev_states[i].localYes;
            sumNo  = sumNo  + prev_states[i].localNo;
        }

        // conserve EXACT (非 conserve_and_bump 的 >=): tally 是计数非可烧 value → 输出必逐 sompi 等于求和
        // (fold trustless 核心: root tally 链上派生 = Σ叶真值, 无创造/销毁/谎报空间).
        require(new_states[0].localYes == sumYes);
        require(new_states[0].localNo  == sumNo);

        // NWT ③ overflow: 防多片求和近 2^128 wrap (单 root tally < MAX_TALLY ≈ 2.1e15 sompi << 2^128).
        require(new_states[0].localYes < 2100000000000000);
        require(new_states[0].localNo  < 2100000000000000);
    }

    // —— settle / dispute_reveal / refund: 单片市场 (shard_count==1) 复用 PoolSpine_v07 现有 entry 不动 ——
    //   (多片 settle 走 fold-root 派生 globalYes/globalNo + commit 硬校验, 件3 接入; 单片 == 现行为, 守回归).
    //   件3: settle_aggregate 的 globalYes/No 从 fold-root introspection 读 (非 committee-sig 背书) → trustless 升级.
}

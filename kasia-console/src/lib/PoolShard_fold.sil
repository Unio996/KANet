// PoolShard_fold.sil — bshard §4 (a) 同合约: shard 叶 register-accumulate + 层次 fold conserve (J1, 2026-06-15).
//
// (a) 叶+fold 同合约(同 cov_id; J2 撤 (b) 改 (a), DECL SS-safety auto conserve_and_bump). 一套合约两 entry:
//   • register_bet: shard 叶每注 covenant-accumulate localYes/No + count (singleton transition) + **validateOutputStateWithTemplate
//     绑 PoolSide output**(NWT PoC-1b: 增量==实存 deposit value + 方向绑 + 一注一 PoolSide=double-count). 叶≤32 注封口(count<32).
//   • fold: k 叶/中间 → 1 partial-sum (== 严格守恒 双量 + leaf_count + root commit). 关池后跑.
//
// 对抗审 bake: PoC-1 provenance(auto OpInputCovenantId)/PoC-2 conserve ==双量(非vault>=)/PoC-3 root commit/PoC-4 leaf_count/
//   PoC-1b register(本文件 register_bet: validateOutputStateWithTemplate 绑实 PoolSide + 值/方向/double-count).
// 叶累积无溢出(per-shard ≤32 注; stake*(1-side)=stake|0 非真乘). artifact(ps_prefix/suffix/hash)= ctor const(J2 PoolSide-artifact, byte-match).

pragma silverscript ^0.1.0;

contract PoolShard_fold(
    byte[32] market_id,        // 跨片锚 (fold commit 绑)
    byte[32] commit_v2,        // root commit 硬校验目标 (= blake2b(globalYes‖globalNo‖market_id‖shard_count))
    int      shard_count,      // 关池锚: root.count 必 == 此
    int      max_fan_in,       // fold 叉数上限 (编译界)
    // —— register_bet 用: PoolSide expectedTemplateHash(J2 PoolSide-artifact, byte-match). prefix/suffix 走 witness(验 blake2b==此) ——
    byte[32] ps_tmpl_hash,     // PoolSide expectedTemplateHash(= blake2b(prefix‖suffix)); validateOutputStateWithTemplate 验 witness prefix/suffix 对此.
                               //   per-market: PoolSide template 含 spine_template_hash(non-State ctor, USE)→烤 market_id→per-market.
                               //   此 hash 挡死 THEFT(外市场模板 hash≠此→register fail), 但【State 字段 spineP2shHash 是 witness 不被它绑】.
    byte[32] spine_p2sh_hash,  // ★ Bettor verify-flag 修a(链上绑死, value-SOURCE 铁律): = 本市场 spine P2SH(= J2 PoolSide.init_spineP2shHash 同值).
                               //   register_bet 验 PoolSide.spineP2shHash==此 → 否则攻击者建 template对/State spineP2shHash错 的 PoolSide:
                               //   bump leaf(stake 实存)但自己 claim 永不可满足(L65 spine 比对)→ deposit 砖死 → Σleaf>Σclaimable(破确定性 invariant→
                               //   IF builder 数砖死笔→settle 超兑 insolvency). 绑死后: 每笔累进 leaf 的 stake 都有可满足 claim 路 → Σleaf==Σclaimable.
    int      seal_count,       // 封口数 (= SHARD_SEAL_COUNT=32; count>=此 拒新注)
    // —— genesis state (叶 = 0/0/0 由 register 累积; 中间/root fold UTXO 由 fold cov 产) ——
    int      init_local_yes,
    int      init_local_no,
    int      init_count
) {
    int local_yes = init_local_yes;
    int local_no  = init_local_no;
    int count     = init_count;

    // PoolSide State 布局(= PoolSide_v08_shard 6 显式 State 字段; validateOutputStateWithTemplate 绑此 struct).
    struct PoolSideState {
        byte[32] bettorPk;
        byte[32] spineP2shHash;
        byte[32] poolMerkleRoot;
        byte[32] marketMetadataHash;
        int      direction;            // 0=YES 1=NO (= 本注 side, 绑)
        int      deadline;
    }

    // —— entry: register_bet (shard 叶每注 accumulate; singleton transition 花叶→产 bumped 叶 + 验 PoolSide deposit) ——
    //   NWT PoC-1b: validateOutputStateWithTemplate 验 output[psOutIdx] 真是 PoolSide(template hash+P2SH 原语自验)+ 完整 State
    //   (bettorPk/方向...)→ 增量 == introspect(实 deposit value) + 方向绑(side→对栏) + 一注一新 PoolSide(double-count).
    entrypoint function register_bet(
        int      side,                 // 0=YES 1=NO (= PoolSide.direction, 绑)
        int      psOutIdx,             // PoolSide deposit output 位
        int      leafOutIdx,           // 本叶 continuation output 位(builder 控 layout)
        byte[32] bettorPk,             // 本注 bettor (= PoolSide State, validateOutputStateWithTemplate 绑)
        byte[32] spineP2shHash,
        byte[32] poolMerkleRoot,
        byte[32] marketMetadataHash,
        int      ps_deadline,
        byte[]   ps_prefix,            // PoolSide template prefix (witness; 验 blake2b(prefix‖suffix)==ps_tmpl_hash, 假过不了)
        byte[]   ps_suffix             // PoolSide template suffix (witness)
    ) {
        require(count < seal_count);                       // 未封口才收注(count>=seal_count 拒)
        require(side == 0 || side == 1);

        // ★ Bettor 修a(NWT/J2 同意根治): 绑 PoolSide.spineP2shHash 到本市场 spine(链上 value-SOURCE). ps_tmpl_hash 挡 THEFT 但
        //   spineP2shHash 是 witness State 不被它绑 → 不绑则攻击者建 template对/spineP2shHash错 的 PoolSide bump leaf(stake 实存)
        //   但自己 claim 永砖死(L65 spine 比对不满足)→ Σleaf>Σclaimable(破确定性 invariant; IF builder 数砖死笔→settle 超兑).
        //   绑死 → 每笔累进 leaf 的 stake 都有可满足 claim 路 → Σleaf==Σclaimable.
        require(spineP2shHash == spine_p2sh_hash);

        // PoC-1b: 验 output[psOutIdx] 真是 PoolSide template + 完整 State(方向==side) → 绑实 claimable deposit(非任意 real-KAS).
        validateOutputStateWithTemplate(psOutIdx, {
            bettorPk: bettorPk,
            spineP2shHash: spineP2shHash,
            poolMerkleRoot: poolMerkleRoot,
            marketMetadataHash: marketMetadataHash,
            direction: side,                               // 方向绑: PoolSide.direction == 本注 side
            deadline: ps_deadline
        }, ps_prefix, ps_suffix, ps_tmpl_hash);

        int stake = tx.outputs[psOutIdx].value;            // introspect 实 deposit value(链实非 witness)
        require(stake >= 100000000);                       // 1 KAS min-bet floor

        // 增量 == stake, 方向绑(stake*(1-side)=stake|0, 非真乘无溢; per-shard ≤32 注 总不溢). double-count: 一注一新 PoolSide output.
        validateOutputState(leafOutIdx, {
            local_yes: local_yes + stake * (1 - side),
            local_no:  local_no + stake * side,
            count:     count + 1
        });
    }

    // —— entry: fold (k→1 conserve; == 严格守恒 双量 + leaf_count + root commit 硬校验; 关池后跑) ——
    #[covenant(binding = cov, from = max_fan_in, to = 1, mode = verification)]
    function fold(State[] prev_states, State[] new_states) {
        require(new_states.length == 1);

        int yes_sum = 0;
        int no_sum = 0;
        int count_sum = 0;
        for (i, 0, prev_states.length, max_fan_in) {
            yes_sum = yes_sum + prev_states[i].local_yes;
            no_sum = no_sum + prev_states[i].local_no;
            count_sum = count_sum + prev_states[i].count;
        }

        require(new_states[0].local_yes == yes_sum);       // PoC-2: == 非 >= (双量严格守恒)
        require(new_states[0].local_no == no_sum);
        require(new_states[0].count == count_sum);         // PoC-4: leaf_count 守恒

        if (count_sum == shard_count) {                    // PoC-3: root commit 硬校验(globalYes/No 链上派生真值)
            byte[] commit_pre0 = byte[](yes_sum, 16) + byte[](no_sum, 16);
            byte[] commit_pre1 = commit_pre0 + byte[](market_id);
            byte[] commit_pre2 = commit_pre1 + byte[](shard_count, 4);
            require(blake2b(commit_pre2) == commit_v2);
        }
    }
}

// RootClose.sil — cascade convert-split ROOT-CLOSE 合约 (J1, 2026-06-20; 拆 PoolRoot 降 SIZE).
//
// 拆分动因: PoolRoot(2289B, close+claim+refund)被 seal_to_root 揭示时撞 9999 双重承重(P1 seal 目标 + P2 convert
//   花费), claim_draw 的 merkle for-loop 是字节大头 → 移去 RootClaim.sil。RootClose = 3-entry 极简(无 merkle)。
// 职责 = 写结算(close_commit 委员 4-of-5) + 退款(refund_draw) + 桥到 claim(convert_to_claim → RootClaim foreign-template)。
// 7-field state {local_yes, local_no, count, pool_value, closed, winningSide, payoutRoot}。
// **RootClose 只能经 FoldNode.seal_to_root 创建**(foreign-template, root_tmpl_hash=本合约模板焊进 FoldNode);
//   genesis outcome 由 seal 硬设 canonical(closed:0/winningSide:0/payoutRoot:init)= committee-bypass。
// tri-state closed{0=open,1=settled,2=cancelled} write-once: close(0→1) vs 首refund(0→2 flip)抢 closed==0 = XOR;
//   convert gate closed==1 / refund gate closed!=1∧timeout 置 closed=2 → late-close 永挡 → refund-then-close insolvency 杜绝(F2)。
// 承重 = output-bind weld(close 不动钱 / refund draw-down -stake / convert 全池→RootClaim value-conserve)+ Σin==Σout。
//
// ⚠ DRAFT (spec docs/2026-06-19-cascade-convert-split-spec.md 未 push 到 origin; close_commit+refund_draw 从 PoolRoot.sil
//   verbatim, convert_to_claim 按 R2(对称全7字段)+ R2c(closed/winningSide/payoutRoot 从 self committee-stamped fields
//   读非 witness + require closed==1)+ seal_to_root foreign-template 桥模式起草。spec 到对齐承重细节后定稿。

pragma silverscript ^0.1.0;

contract RootClose(
    byte[32] ps_tmpl_hash,        // dust PoolSide-ticket expectedTemplateHash (refund_draw 读 spent-once 凭证)
    byte[32] shard_pool_id,       // 本 pool 身份 (ticket 记此; per-instance P2SH 唯一性锚)
    // (P1 trim 2026-06-20: 删 shard_count + close 的 count==shard_count 深度防御 — RootClose 只经 FoldNode.seal_to_root
    //  创建, seal 已 require(count==shard_count) → RootClose.count==shard_count 结构保证, 此防御 provably 冗余。省 ~Δu 过 P1 9999 墙。)
    // —— committee (close_commit 4-of-5 attest winningSide+payoutRoot) ——
    byte[32] c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
    int      deadline,            // close post-deadline; refund timeout deadline+grace
    byte[32] claim_tmpl_hash,     // RootClaim expectedTemplateHash (convert_to_claim foreign-template 桥; baked)
    // —— genesis State (7-field; 实际由 seal_to_root 提供, init_* 仅定义 State 布局) ——
    int      init_local_yes,
    int      init_local_no,
    int      init_count,
    int      init_pool_value,
    int      init_closed,
    int      init_winningSide,
    byte[32] init_payoutRoot
) {
    int local_yes   = init_local_yes;
    int local_no    = init_local_no;
    int count       = init_count;
    int pool_value  = init_pool_value;
    int closed      = init_closed;
    int winningSide = init_winningSide;
    byte[32] payoutRoot = init_payoutRoot;

    // dust PoolSide-ticket State (refund 读 spent-once 凭证)
    struct Tk {
        byte[32] bettorPk;
        int      direction;
        int      stake;
        byte[32] shardPoolId;
    }

    // —— entry 0: close_commit (写 outcome; committee 4-of-5; write-once; value 不变) —— [PoolRoot verbatim]
    entrypoint function close_commit(
        sig c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig,
        int      rootOutIdx,
        int      new_winningSide,      // 0=YES 1=NO
        byte[32] new_payoutRoot        // off-chain BigInt 算 (winner+fee leaves, Σ==totalPool)
    ) {
        require(closed == 0);                              // write-once
        require(tx.time >= deadline * 1000);               // post-deadline
        require(new_winningSide == 0 || new_winningSide == 1);

        int validSigs = 0;
        if (checkSig(c0Sig, pubkey(c0Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c1Sig, pubkey(c1Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c2Sig, pubkey(c2Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c3Sig, pubkey(c3Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c4Sig, pubkey(c4Pk))) { validSigs = validSigs + 1; }
        require(validSigs >= 4);

        validateOutputState(rootOutIdx, {
            local_yes:  local_yes,
            local_no:   local_no,
            count:      count,
            pool_value: pool_value,
            closed:     1,
            winningSide: new_winningSide,
            payoutRoot: new_payoutRoot
        });
        // ★ output-bind weld: root value 不变 (close 只写 state 不动钱)
        require(tx.outputs[rootOutIdx].value == pool_value);
    }

    // —— entry 1: refund_draw (市场取消 → bettor 退本金; timeout∧未settled; flip closed 0→2) —— [PoolRoot verbatim]
    entrypoint function refund_draw(
        int      poolOutIdx,           // 重建 pool continuation
        int      payoutOutIdx,         // refund output to bettor
        int      ticketInIdx,
        int      ticket_prefix_len,
        int      ticket_suffix_len
    ) {
        require(closed != 1);                              // 未 settled (settled 走 convert→claim, 互斥)
        require(tx.time >= (deadline + 7200) * 1000);      // deadline+grace 超时才可取消 (防 betting 期早退)

        Tk tk = readInputStateWithTemplate(ticketInIdx, ticket_prefix_len, ticket_suffix_len, ps_tmpl_hash);
        require(tk.shardPoolId == shard_pool_id);          // ticket 属本 pool

        // refund = 本人 stake (1:1 退本金, parimutuel 不适用)
        byte[34] bettorLock = new ScriptPubKeyP2PK(pubkey(tk.bettorPk));
        require(tx.outputs[payoutOutIdx].scriptPubKey == byte[](bettorLock));
        require(tx.outputs[payoutOutIdx].value == tk.stake);

        validateOutputState(poolOutIdx, {
            local_yes:  local_yes,
            local_no:   local_no,
            count:      count,
            pool_value: pool_value - tk.stake,
            closed:     2,                                 // ★ F2: 首 refund flip 0→2 = 隐式 cancel, write-once 锁死 late-close
            winningSide: winningSide,
            payoutRoot: payoutRoot
        });
        // ★ output-bind weld: pool value == pool_value - stake
        require(tx.outputs[poolOutIdx].value == pool_value - tk.stake);
    }

    // —— entry 2: convert_to_claim (settled RootClose → RootClaim foreign-template 桥; 全池 value-conserve) ——
    //   R2 对称: 全 7-field 桥 (account 4 + outcome 3)。R2c: closed/winningSide/payoutRoot 从【self committee-stamped
    //   contract fields 读, 非 witness】(防盗池: convert 不能伪造 outcome) + require(closed==1)。同 seal_to_root 模式。
    entrypoint function convert_to_claim(
        int      claimOutIdx,
        byte[]   claim_prefix,         // RootClaim redeem state 区前段 (witness; blake2b(prefix‖suffix)==claim_tmpl_hash 焊)
        byte[]   claim_suffix
    ) {
        require(closed == 1);                              // 仅 settled 可转 claim (R2c gate; refund 路 closed==2 走 refund_draw)
        // 产 RootClaim genesis: 全 7-field carry。account 4 真值 + outcome 3 从【self 委员盖章 fields】(非 witness, R2c 防盗池)。
        validateOutputStateWithTemplate(claimOutIdx, {
            local_yes:   local_yes,
            local_no:    local_no,
            count:       count,
            pool_value:  pool_value,
            closed:      closed,                           // R2c: self (==1, 委员盖章), 非 witness
            winningSide: winningSide,                      // R2c: self (委员盖章), 非 witness
            payoutRoot:  payoutRoot                        // R2c: self (委员盖章), 非 witness
        }, claim_prefix, claim_suffix, claim_tmpl_hash);
        // ★ output-bind weld (跨合约边界 value 守恒): RootClaim value == 全池 pool_value
        require(tx.outputs[claimOutIdx].value == pool_value);
    }
}

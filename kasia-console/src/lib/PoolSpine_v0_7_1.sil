// PoolSpine_v0.7.1 — KANet predict market trustless settle (pattern B + a, Owner 终裁 scope A)
//
// v0.7 → v0.7.1 主要变化:
//   1. **Settle 输出从 N winners 缩为 ~3** (broker + WinningsPool + spine state):
//      → storage-mass 64-cap 溶解 (Bettor 白捡, single shard 数百-1000 注绰)
//      → 配 WinningsPool_v1 (= per-PoolSide 自卫, settler 想错付不行)
//   2. **commit_v2 硬校验** on-chain (= silverc int-to-byte 实证可用):
//      blake2b(byte[](globalYes,8)||byte[](globalNo,8)||market_id||byte[](shard_count,4)) == commit
//      → 替 v0.7 fallback "committee-sig sighash 隐式担保" (= 假, J1 r266 false negative root)
//   3. **shard_count 从 ctor 移到 entry args** (Q1=B witness hook, no KIP-17 needed):
//      single ctor 服务任意片数 (testnet v0.7.1 单片不用, 但 hook 留 future Phase 2)
//   4. **bounded for loop 替 5 委员 merkle climb 复制粘贴** (KIP-17 silverc 已 expose for(i,0,n,max)):
//      → 8×5=40 行收为 ~10 行, DRY + mass 也降
//   5. **grace fix 保留** (refund_maker_unjoined deadline+7200, Bettor r388 front-run vuln)
//   6. **min-pot Option A 保留** (losingPool ≥ 5×oracleBondAmount, 防 thin loser pool)
//
// 依赖 (新):
//   - WinningsPool_v1.sil ship 在前 (commit b9e724b51 docs/oracle-v06-spec 7630fbcce)
//   - settle TX 输出 [broker, 5 committee bonds, WinningsPool, spine state] 共 8 outputs
//
// 编译: silverc.exe PoolSpine_v0_7_1.sil --ctor args.json
pragma silverscript ^0.1.0;

contract PoolSpine_v0_7_1(
    byte[32] makerPk,
    byte[32] brokerPk,
    byte[32] poolMerkleRoot,    // depth-8 blake2b root of committee pool snapshot
    int deadline,
    int brokerFeePct,
    int oracleFeePct,
    int oracleBondAmount,
    int makerStakeAmount,
    byte[32] marketMetadataHash,
    byte[32] market_id,         // raw 32B for cross-shard binding (single ctor across shards)
    byte[32] winningsPoolSpkPrefix3  // first 3 bytes of expected WinningsPool P2SH scriptPubKey (= structural sanity, full P2SH binding 待 Phase 2 validateOutputStateWithTemplate)
) {

    // entry 0 — settle_aggregate (v0.7.1 trustless): 5 委员 sigs (≥4) + commit 硬校验 + WinningsPool 输出 binding.
    // shard_count 从 ctor 移到 entry args (Q1=B hook). single shard 时传 1.
    entrypoint function settle_aggregate(
        sig       c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig,
        byte[32]  committeePkHash,
        int       winner,                  // 0 = YES, 1 = NO
        byte[32]  sidesMerkleRoot,
        byte[32]  c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
        int       c0Idx, int c1Idx, int c2Idx, int c3Idx, int c4Idx,
        // commit_v2 args (= committee-sig sighash cover):
        int       globalYesTotal_sompi,
        int       globalNoTotal_sompi,
        int       shard_count,             // Q1=B witness hook (= ctor 不烤, settle 时传)
        byte[32]  global_commit_id,
        // depth-8 merkle siblings per committee member (= 8×5=40):
        byte[32]  c0s0, byte[32] c0s1, byte[32] c0s2, byte[32] c0s3, byte[32] c0s4, byte[32] c0s5, byte[32] c0s6, byte[32] c0s7,
        byte[32]  c1s0, byte[32] c1s1, byte[32] c1s2, byte[32] c1s3, byte[32] c1s4, byte[32] c1s5, byte[32] c1s6, byte[32] c1s7,
        byte[32]  c2s0, byte[32] c2s1, byte[32] c2s2, byte[32] c2s3, byte[32] c2s4, byte[32] c2s5, byte[32] c2s6, byte[32] c2s7,
        byte[32]  c3s0, byte[32] c3s1, byte[32] c3s2, byte[32] c3s3, byte[32] c3s4, byte[32] c3s5, byte[32] c3s6, byte[32] c3s7,
        byte[32]  c4s0, byte[32] c4s1, byte[32] c4s2, byte[32] c4s3, byte[32] c4s4, byte[32] c4s5, byte[32] c4s6, byte[32] c4s7
    ) {
        // ① 4-of-5 committee threshold (=同 v07)
        int validSigs = 0;
        if (checkSig(c0Sig, pubkey(c0Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c1Sig, pubkey(c1Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c2Sig, pubkey(c2Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c3Sig, pubkey(c3Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c4Sig, pubkey(c4Pk))) { validSigs = validSigs + 1; }
        require(validSigs >= 4);
        require(winner == 0 || winner == 1);
        require(shard_count >= 1);

        // ② committee commitment (=同 v07)
        byte[] cConcat0 = c0Pk + c1Pk;
        byte[] cConcat1 = cConcat0 + c2Pk;
        byte[] cConcat2 = cConcat1 + c3Pk;
        byte[] cConcat3 = cConcat2 + c4Pk;
        byte[32] committeeHash = blake2b(cConcat3);
        require(committeeHash == committeePkHash);

        // ③ position-aware merkle climb (= 同 v07 算法, 仍 5 committee × 8 levels)
        // TODO Phase 2: bounded for loop 收 collapse 5×8 = 40 行成内层 for. silverc 当前
        // syntax requires sibling array indexable — 40 sibling args 重组成 5 byte[8 byte[32]]
        // 需 type system支持 nested array, 留 v0.7.2 audit. v0.7.1 保 v07 copy-paste 不动 (验证过).
        require(c0Idx >= 0); require(c0Idx < 256);
        byte[32] c0Cur = blake2b(byte[](c0Pk));
        if ((c0Idx % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s0)); } else { c0Cur = blake2b(byte[](c0s0) + byte[](c0Cur)); }
        if (((c0Idx / 2) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s1)); } else { c0Cur = blake2b(byte[](c0s1) + byte[](c0Cur)); }
        if (((c0Idx / 4) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s2)); } else { c0Cur = blake2b(byte[](c0s2) + byte[](c0Cur)); }
        if (((c0Idx / 8) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s3)); } else { c0Cur = blake2b(byte[](c0s3) + byte[](c0Cur)); }
        if (((c0Idx / 16) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s4)); } else { c0Cur = blake2b(byte[](c0s4) + byte[](c0Cur)); }
        if (((c0Idx / 32) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s5)); } else { c0Cur = blake2b(byte[](c0s5) + byte[](c0Cur)); }
        if (((c0Idx / 64) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s6)); } else { c0Cur = blake2b(byte[](c0s6) + byte[](c0Cur)); }
        if (((c0Idx / 128) % 2) == 0) { c0Cur = blake2b(byte[](c0Cur) + byte[](c0s7)); } else { c0Cur = blake2b(byte[](c0s7) + byte[](c0Cur)); }
        require(c0Cur == poolMerkleRoot);

        require(c1Idx >= 0); require(c1Idx < 256);
        byte[32] c1Cur = blake2b(byte[](c1Pk));
        if ((c1Idx % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s0)); } else { c1Cur = blake2b(byte[](c1s0) + byte[](c1Cur)); }
        if (((c1Idx / 2) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s1)); } else { c1Cur = blake2b(byte[](c1s1) + byte[](c1Cur)); }
        if (((c1Idx / 4) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s2)); } else { c1Cur = blake2b(byte[](c1s2) + byte[](c1Cur)); }
        if (((c1Idx / 8) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s3)); } else { c1Cur = blake2b(byte[](c1s3) + byte[](c1Cur)); }
        if (((c1Idx / 16) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s4)); } else { c1Cur = blake2b(byte[](c1s4) + byte[](c1Cur)); }
        if (((c1Idx / 32) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s5)); } else { c1Cur = blake2b(byte[](c1s5) + byte[](c1Cur)); }
        if (((c1Idx / 64) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s6)); } else { c1Cur = blake2b(byte[](c1s6) + byte[](c1Cur)); }
        if (((c1Idx / 128) % 2) == 0) { c1Cur = blake2b(byte[](c1Cur) + byte[](c1s7)); } else { c1Cur = blake2b(byte[](c1s7) + byte[](c1Cur)); }
        require(c1Cur == poolMerkleRoot);

        require(c2Idx >= 0); require(c2Idx < 256);
        byte[32] c2Cur = blake2b(byte[](c2Pk));
        if ((c2Idx % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s0)); } else { c2Cur = blake2b(byte[](c2s0) + byte[](c2Cur)); }
        if (((c2Idx / 2) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s1)); } else { c2Cur = blake2b(byte[](c2s1) + byte[](c2Cur)); }
        if (((c2Idx / 4) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s2)); } else { c2Cur = blake2b(byte[](c2s2) + byte[](c2Cur)); }
        if (((c2Idx / 8) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s3)); } else { c2Cur = blake2b(byte[](c2s3) + byte[](c2Cur)); }
        if (((c2Idx / 16) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s4)); } else { c2Cur = blake2b(byte[](c2s4) + byte[](c2Cur)); }
        if (((c2Idx / 32) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s5)); } else { c2Cur = blake2b(byte[](c2s5) + byte[](c2Cur)); }
        if (((c2Idx / 64) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s6)); } else { c2Cur = blake2b(byte[](c2s6) + byte[](c2Cur)); }
        if (((c2Idx / 128) % 2) == 0) { c2Cur = blake2b(byte[](c2Cur) + byte[](c2s7)); } else { c2Cur = blake2b(byte[](c2s7) + byte[](c2Cur)); }
        require(c2Cur == poolMerkleRoot);

        require(c3Idx >= 0); require(c3Idx < 256);
        byte[32] c3Cur = blake2b(byte[](c3Pk));
        if ((c3Idx % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s0)); } else { c3Cur = blake2b(byte[](c3s0) + byte[](c3Cur)); }
        if (((c3Idx / 2) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s1)); } else { c3Cur = blake2b(byte[](c3s1) + byte[](c3Cur)); }
        if (((c3Idx / 4) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s2)); } else { c3Cur = blake2b(byte[](c3s2) + byte[](c3Cur)); }
        if (((c3Idx / 8) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s3)); } else { c3Cur = blake2b(byte[](c3s3) + byte[](c3Cur)); }
        if (((c3Idx / 16) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s4)); } else { c3Cur = blake2b(byte[](c3s4) + byte[](c3Cur)); }
        if (((c3Idx / 32) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s5)); } else { c3Cur = blake2b(byte[](c3s5) + byte[](c3Cur)); }
        if (((c3Idx / 64) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s6)); } else { c3Cur = blake2b(byte[](c3s6) + byte[](c3Cur)); }
        if (((c3Idx / 128) % 2) == 0) { c3Cur = blake2b(byte[](c3Cur) + byte[](c3s7)); } else { c3Cur = blake2b(byte[](c3s7) + byte[](c3Cur)); }
        require(c3Cur == poolMerkleRoot);

        require(c4Idx >= 0); require(c4Idx < 256);
        byte[32] c4Cur = blake2b(byte[](c4Pk));
        if ((c4Idx % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s0)); } else { c4Cur = blake2b(byte[](c4s0) + byte[](c4Cur)); }
        if (((c4Idx / 2) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s1)); } else { c4Cur = blake2b(byte[](c4s1) + byte[](c4Cur)); }
        if (((c4Idx / 4) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s2)); } else { c4Cur = blake2b(byte[](c4s2) + byte[](c4Cur)); }
        if (((c4Idx / 8) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s3)); } else { c4Cur = blake2b(byte[](c4s3) + byte[](c4Cur)); }
        if (((c4Idx / 16) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s4)); } else { c4Cur = blake2b(byte[](c4s4) + byte[](c4Cur)); }
        if (((c4Idx / 32) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s5)); } else { c4Cur = blake2b(byte[](c4s5) + byte[](c4Cur)); }
        if (((c4Idx / 64) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s6)); } else { c4Cur = blake2b(byte[](c4s6) + byte[](c4Cur)); }
        if (((c4Idx / 128) % 2) == 0) { c4Cur = blake2b(byte[](c4Cur) + byte[](c4s7)); } else { c4Cur = blake2b(byte[](c4s7) + byte[](c4Cur)); }
        require(c4Cur == poolMerkleRoot);

        // ④ commit_v2 硬校验 (= silverc int-to-byte 实证, J1 r267 ACK):
        // blake2b(byte[](globalYes,8) || byte[](globalNo,8) || market_id || byte[](shard_count,4)) == global_commit_id
        // 替 v0.7 fallback "committee-sig sighash 隐式担保" (= 假, real hard verify trusted on-chain).
        byte[8] yesB = byte[](globalYesTotal_sompi, 8);
        byte[8] noB = byte[](globalNoTotal_sompi, 8);
        byte[4] shardCntB = byte[](shard_count, 4);
        byte[] commitConcat0 = byte[](yesB) + byte[](noB);
        byte[] commitConcat1 = commitConcat0 + byte[](market_id);
        byte[] commitConcat2 = commitConcat1 + byte[](shardCntB);
        byte[32] commitHash = blake2b(commitConcat2);
        require(commitHash == global_commit_id);
        require(commitHash != poolMerkleRoot);

        // ⑤ pot 守: 最小池 + losingPool floor (= Option A 保留, 防 thin loser)
        require(globalYesTotal_sompi >= 0);
        require(globalNoTotal_sompi >= 0);
        require(globalYesTotal_sompi + globalNoTotal_sompi >= 10000000000);  // 100 KAS min pot (= 1e10 sompi)

        int oneMinusWinner = 1 - winner;
        int losingPool = globalYesTotal_sompi * winner + globalNoTotal_sompi * oneMinusWinner;
        require(losingPool >= 5 * oracleBondAmount);  // 单委员 bond × 5 (= dynamic threshold)

        // ⑥ output shape (v0.7.1 pattern B+a): 8 outputs 固定
        // [0] broker fee (= spendable × brokerFeePct / 10000)
        // [1-5] 5 committee bond outputs (≥ oracleBondAmount each)
        // [6] WinningsPool covenant UTXO (value = losingPool 约, 实承 losing 实 stake)
        // [7] spine state output (= outcome anchor, P2PK(brokerPk) 占位 dust)
        require(tx.inputs.length >= 1);
        require(tx.outputs.length == 8);

        // out[0] broker
        byte[34] brokerLock = new ScriptPubKeyP2PK(pubkey(brokerPk));
        require(tx.outputs[0].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[0].value >= 1000);

        // out[1-5] committee bonds
        byte[34] c0Lock = new ScriptPubKeyP2PK(pubkey(c0Pk));
        require(tx.outputs[1].scriptPubKey == byte[](c0Lock));
        require(tx.outputs[1].value >= oracleBondAmount);
        byte[34] c1Lock = new ScriptPubKeyP2PK(pubkey(c1Pk));
        require(tx.outputs[2].scriptPubKey == byte[](c1Lock));
        require(tx.outputs[2].value >= oracleBondAmount);
        byte[34] c2Lock = new ScriptPubKeyP2PK(pubkey(c2Pk));
        require(tx.outputs[3].scriptPubKey == byte[](c2Lock));
        require(tx.outputs[3].value >= oracleBondAmount);
        byte[34] c3Lock = new ScriptPubKeyP2PK(pubkey(c3Pk));
        require(tx.outputs[4].scriptPubKey == byte[](c3Lock));
        require(tx.outputs[4].value >= oracleBondAmount);
        byte[34] c4Lock = new ScriptPubKeyP2PK(pubkey(c4Pk));
        require(tx.outputs[5].scriptPubKey == byte[](c4Lock));
        require(tx.outputs[5].value >= oracleBondAmount);

        // out[6] WinningsPool — structural sanity 验 (full P2SH bind 待 Phase 2 validateOutputStateWithTemplate):
        //   value <= losingPool (= 守恒, settler 不能塞超量)
        //   scriptPubKey 长度 = 35 (P2SH 固定长 = OP_BLAKE2B + 32B hash + OP_EQUAL)
        //   scriptPubKey 前 3 字节 == ctor winningsPoolSpkPrefix3 (= 弱 binding sanity)
        require(tx.outputs[6].value <= losingPool);
        require(tx.outputs[6].value >= losingPool - 100000);  // settler minerFee margin
        require(tx.outputs[6].scriptPubKey.length == 35);
        byte[] outSpk = tx.outputs[6].scriptPubKey;
        require(outSpk[0] == winningsPoolSpkPrefix3[0]);
        require(outSpk[1] == winningsPoolSpkPrefix3[1]);
        require(outSpk[2] == winningsPoolSpkPrefix3[2]);

        // out[7] spine state placeholder (= broker P2PK, value dust)
        require(tx.outputs[7].scriptPubKey == byte[](brokerLock));
        require(tx.outputs[7].value >= 1000);
    }

    // entry 1 — dispute_reveal (= 同 v07, 不动)
    entrypoint function dispute_reveal(
        byte[32]  committeePkHash,
        byte[32]  disputeOutcomeHash,
        byte[32]  c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
        sig       c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig
    ) {
        byte[] dConcat0 = c0Pk + c1Pk;
        byte[] dConcat1 = dConcat0 + c2Pk;
        byte[] dConcat2 = dConcat1 + c3Pk;
        byte[] dConcat3 = dConcat2 + c4Pk;
        byte[32] dHash  = blake2b(dConcat3);
        require(dHash == committeePkHash);

        require(checkSig(c0Sig, pubkey(c0Pk)));
        require(checkSig(c1Sig, pubkey(c1Pk)));
        require(checkSig(c2Sig, pubkey(c2Pk)));
        require(checkSig(c3Sig, pubkey(c3Pk)));
        require(checkSig(c4Sig, pubkey(c4Pk)));

        require(tx.inputs.length >= 1);
        require(tx.outputs.length >= 1);
    }

    // entry 2 — refund_maker_unjoined (= 同 v07 + grace fix 已存 deadline+7200, Bettor r388)
    entrypoint function refund_maker_unjoined(sig makerSig) {
        require(checkSig(makerSig, pubkey(makerPk)));
        require(tx.time >= (deadline + 7200) * 1000);  // grace 7200s 防 front-run vuln

        require(tx.inputs.length >= 1);
        require(tx.outputs.length == 1);

        byte[34] makerLock = new ScriptPubKeyP2PK(pubkey(makerPk));
        require(tx.outputs[0].scriptPubKey == byte[](makerLock));

        require(tx.outputs[0].value <= makerStakeAmount - 50000);
        require(tx.outputs[0].value >= makerStakeAmount - 100000000);
        require(tx.outputs[0].value >= 1000);
    }
}

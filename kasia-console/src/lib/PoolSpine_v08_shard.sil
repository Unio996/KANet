// PoolSpine_v08_shard.sil — bshard per-shard spine close-commit (J1, 2026-06-15). Bettor nail-1.
//
// 职责: 关池时把 {winningSide, payoutRoot, fold_tmpl_hash, shard_count} **写一次、不可改、post-close-only** 进 spine state →
//   PoolSide claim **花此 spine + 原样重建**(serial spend+recreate, Kaspa 无 ref-input) → claim 同 TX readInputStateWithTemplate
//   读其 state → 验 winner(finding-1) + merkle-prove payout(finding-2). committee 4-of-5 attest(committee-trust 锚, trust-scoping 一致).
//
// ⚠ 2026-06-15 CORRECTION(Bettor/NWT/J2 三方源证): Kaspa **无 ref-input/read-only-input**(全 tx.inputs 消费) → 原"claim
//   ref-input 读不消费"假设错(我违 verify-primitive 铁律). 裁: **(a) serial spend+recreate**(claim_passthrough entry).
// write-once immutable: closed flag. close_commit require(closed==0)→写 closed=1; claim_passthrough require(closed==1)→重建
//   IDENTICAL state(逐字段不变, 只 outpoint 变, 值改不了/毁不掉). 两 entry 都不能改已写的 closeCommit = immutable(NWT req-1).
//   ⚠ trade-off(testnet 文档化): claims **serialize**(K winner ~K 块, 非真并行独立自取)+ griefer spam passthrough→claimer 重试(烧 fee 非致命).
// committee = baked ctor(market-create oracle 指派 5 pk)→ 4-of-5 sig. market_id 必 USE(blake2b 引用 bake)→ per-market P2SH(J2 task#5 fix).
// State 布局 = PoolSide_v08_shard SpineCloseCommit struct 逐字段对齐(含 closed → claim 验 closed==1). 单 author J1.

pragma silverscript ^0.1.0;

contract PoolSpine_v08_shard(
    // —— baked committee (oracle, market-create 指派; 4-of-5 attest winningSide+payoutRoot) ——
    byte[32] c0Pk, byte[32] c1Pk, byte[32] c2Pk, byte[32] c3Pk, byte[32] c4Pk,
    byte[32] market_id,                 // 跨片锚
    int      deadline,                  // post-close 闸(close_commit 须 deadline 过)
    // —— genesis State (closeCommit 空; open 态) ——
    int      init_closed,               // genesis 0
    int      init_winningSide,          // genesis 0
    byte[32] init_payoutRoot,           // genesis ZERO32
    byte[32] init_fold_tmpl_hash,       // genesis ZERO32
    int      init_shard_count           // genesis 0
) {
    // —— State (= PoolSide SpineCloseCommit struct 对齐: closed, winningSide, payoutRoot, fold_tmpl_hash, shard_count) ——
    int      closed = init_closed;
    int      winningSide = init_winningSide;
    byte[32] payoutRoot = init_payoutRoot;
    byte[32] fold_tmpl_hash = init_fold_tmpl_hash;
    int      shard_count = init_shard_count;

    // entry 0 — close_commit: 关池写一次(committee 4-of-5 attest, post-close, immutable).
    entrypoint function close_commit(
        sig c0Sig, sig c1Sig, sig c2Sig, sig c3Sig, sig c4Sig,
        int      spine_out_idx,          // 新 spine continuation 的 output 位(builder 控 layout; validateOutputState 验它真是 spine cont)
        int      new_winningSide,        // oracle 裁的赢向(0=YES 1=NO; committee sighash attest)
        byte[32] new_payoutRoot,         // 链下 BigInt 算的 payoutRoot(committee sighash attest)
        byte[32] new_fold_tmpl_hash,     // 关池后已知的 fold-root template hash
        int      new_shard_count         // 关池片数
    ) {
        require(closed == 0);                          // ★ write-once: 已 closed 拒(immutable)
        require(tx.time >= deadline * 1000);           // post-close-only(deadline 过)
        require(new_winningSide == 0 || new_winningSide == 1);
        require(new_shard_count > 0);
        require(blake2b(byte[](market_id)) != market_id);           // ★ USE market_id(J2 catch: 否则 dead→不 baked→spine P2SH 无 market_id→跨市场碰撞). 引用即 bake→per-market P2SH.

        // committee 4-of-5 (sighash 覆盖 new_* → attest winningSide+payoutRoot, = committee-trust 锚).
        int validSigs = 0;
        if (checkSig(c0Sig, pubkey(c0Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c1Sig, pubkey(c1Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c2Sig, pubkey(c2Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c3Sig, pubkey(c3Pk))) { validSigs = validSigs + 1; }
        if (checkSig(c4Sig, pubkey(c4Pk))) { validSigs = validSigs + 1; }
        require(validSigs >= 4);

        // 写 closeCommit (continuation, closed=1; 续锁本 spine cov → 只此一次写定值).
        validateOutputState(spine_out_idx, {
            closed: 1,
            winningSide: new_winningSide,
            payoutRoot: new_payoutRoot,
            fold_tmpl_hash: new_fold_tmpl_hash,
            shard_count: new_shard_count
        });
    }

    // entry 1 — claim_passthrough (Bettor 裁 ref-input 缺失的 serial claim-read 路): claim 花当前 spine + 原样重建,
    //   下个 claim 用新 outpoint(serial spend+recreate; 无 ref-input). 无 committee sig(值 immutable, 任谁过都改不了).
    //   ⚠ NWT req: recreate **IDENTICAL** closed state(逐字段从当前 State 原样写)→ 否则 passthrough 破 req-1 immutability.
    entrypoint function claim_passthrough(int spine_out_idx) {
        require(closed == 1);                          // 只 closed spine 可 passthrough(open 态走 close_commit)
        require(blake2b(byte[](market_id)) != market_id);           // market_id baked(per-market P2SH, 同 close_commit)
        validateOutputState(spine_out_idx, {           // ★ recreate IDENTICAL(逐字段 = 当前 State, 不可改/毁): immutable 守; out_idx builder 控(bettor payout 用 output 0)
            closed: closed,
            winningSide: winningSide,
            payoutRoot: payoutRoot,
            fold_tmpl_hash: fold_tmpl_hash,
            shard_count: shard_count
        });
    }
}

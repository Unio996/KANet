// PoolFold_v07 — #26 bshard 件2 fold covenant (J1 草稿 seed, 待 J2 Q5 mass 实测定 MAX_FOLD_K).
//
// 性质: DRAFT (.sil.draft, 非编译路) — seed J2 silverc 量 fold entrypoint op<201 / bytecode<10000B
//       → 反推 MAX_FOLD_K (fold 叉数硬限 → 树深 → 大池 fold TX 笔数). impl plan 63d3ac35 §1 件2.
//
// 作用 (§4 收敛 + impl plan §0): 关池后链上 fold — N 个 shard/中间 UTXO (各携 localYes/localNo) →
//   readInputState 读各片 tally → 逐 sompi 精确求和 → 产 1 中间/root UTXO 携聚合 tally. 层次复用
//   (中间 UTXO 同模板 → 可再被上层 fold 吃) → k→1 归并到单 root. root.localYes/localNo = globalYes/No.
//   **件3**: settle_aggregate 的 globalYes/No 从"committee-sig 背书(链下算)" 改成 "fold-root introspection
//   读(链上派生真值)" → 连 committee 都不能谎报全局和 (trustless 升级).
//
// SS 原语真读 DECL.md (非凭记忆):
//   - conserve_and_bump N:M 模板 (DECL L224-246 源 + L266-306 lowering): binding=cov + State[] prev_states
//     由编译期 lower 为 `cov_id=OpInputCovenantId; for(k,0,OpCovInputCount(cov_id),max){readInputState(OpCovInputIdx(cov_id,k))}`
//     → 我只写高层 conserve, silverc 自动 lower 成读-循环. new_states 由 validateOutputState 校验输出 == 此.
//
// ⚠⚠ 关键设计点 (DECL L271-294 验证暴露, impl plan 写时未验 — 必 Bettor/J2 共识):
//   `OpCovInputCount(cov_id)` / `OpCovInputIdx(cov_id,k)` **只数/取同 cov_id(同 SS 脚本模板)的输入**.
//   → 若 PoolFold 是【独立合约】, 其 cov_id ≠ 叶 PoolSpine_v07_shard 的 cov_id → fold 的 conserve auto-form
//     **读不到叶 shards** (叶不在 fold 的 covenant group). level-0 (叶→中间) fold 直接断.
//   **解法**:
//     ① (荐) 叶+fold 同一 cov 模板: 把本 fold entrypoint **并进 PoolSpine_v07_shard.sil** (register_bet
//        leaf-accum + fold aggregate 两 entrypoint 共一脚本 = 一 cov_id). 则 fold 的 covenant group 自然含
//        shards(register_bet 路径写的)+中间(fold 路径写的). provenance(NWT ★#1)免费 = OpCovInputCount 只认
//        本脚本 cov_id → 假 UTXO(异脚本)不在 group 进不来, 无需手动白名单.
//     ② 手动 OpInputCovenantId 白名单: fold 遍历 tx.inputs 逐个 require(cov_id ∈ {fold模板,叶模板}) — op 更高
//        (每输入多 1 introspection+require), MAX_FOLD_K 更小. 仅当①不可行才用.
//   **本草稿先以独立合约形量 fold-loop op (op 成本两结构同, 量法不变)**; 真实施按①并进叶合约 (= 件1/件2
//   结构合并, 待 Bettor 裁). MAX_FOLD_K 用本量值 (auto-form 下界; 若走②再加 per-input whitelist op 重量).

pragma silverscript ^0.1.0;

contract PoolFold_v07(
    int      max_ins,            // = MAX_FOLD_K (fold 叉数上限, Q5 mass 实测定; for 循环编译期界)
    int      max_outs,           // = 1 (fold k→1; 保留 param 对齐 conserve_and_bump 模板, deploy 设 1)
    byte[32] market_id,          // 市场锚: 同 market 的 shards/中间共此 ctor → cov_id 区分不同 market 的 fold group
    int      shard_count,        // 片数锚 (件3 commit_id = blake2b(...‖shard_count) 用)
    int      init_localYes,      // 中间 UTXO genesis 占位 (实际 state 由父 fold validateOutputState 设为 sum)
    int      init_localNo
) {
    // —— state (UTXO 携值, 上层 fold / settle readInputState 读) ——
    int localYes = init_localYes;
    int localNo  = init_localNo;

    // —— entry: fold (N:M conserve covenant, 零 committee-sig 纯结构强制) ——
    // N 输入(shard 叶 + 同模板中间) → 1 输出(聚合中间/root). 逐 sompi 精确求和 + conserve 校验.
    // 零 sig: fold 是 permissionless 聚合 — conserve 精确(out==Σin)保证无法偷值, 任意节点可提交真 fold TX.
    #[covenant(binding = cov, from = max_ins, to = max_outs, mode = verification)]
    function fold(State[] prev_states, State[] new_states) {
        require(prev_states.length >= 1);
        require(new_states.length == 1);        // fold k→1 (单输出聚合; to=max_outs 但语义恒 1)

        // 逐输入读 tally 求和 (silverc lower: readInputState(OpCovInputIdx(cov_id,k)) over covenant group).
        int sumYes = 0;
        int sumNo  = 0;
        for(i, 0, prev_states.length, max_ins) {
            sumYes = sumYes + prev_states[i].localYes;
            sumNo  = sumNo  + prev_states[i].localNo;
        }

        // conserve EXACT (非 conserve_and_bump 的 >=): tally 是计数非可烧 value → 输出必逐 sompi 等于求和.
        // (这是 fold trustless 的核心: root tally 链上派生 = Σ叶真值, 无创造/销毁/谎报空间.)
        require(new_states[0].localYes == sumYes);
        require(new_states[0].localNo  == sumNo);

        // NWT ③ overflow: 防多片求和近 2^128 wrap (单 root tally < MAX_TALLY ≈ 2.1e15 sompi << 2^128).
        require(new_states[0].localYes < 2100000000000000);
        require(new_states[0].localNo  < 2100000000000000);
    }

    // —— 件3 接入点 (本草稿不含, 标注): settle_aggregate 改从 fold-root introspection 读 globalYes/No,
    //    require(blake2b(byte[](globalYes,16)‖byte[](globalNo,16)‖market_id‖byte[](shard_count,N))==commit_v2).
    //    globalYes/No = root.localYes/localNo (fold 链上派生) 非 entry-arg(committee 签) → 背书真上链.
}

// OracleStake_v1 — KANet Oracle v0.3 onchain stake-derived oracle pool (Phase-2)
//
// Decision: docs/2026-06-01-onchain-stake-oracle-pool-DECISION.md (5-agent 共识 乙路线)
// §2.1 e1 RESOLVED: Option C 锁 — v1 drop e1, Phase5 = OracleStake_v2 加 slash entry
//   (J1 r255 证伪 Option B: silverc tx context 仅 inputs/outputs/time/activeInputIndex,
//    无 getUtxo()/链查询 primitive → governance UTXO 验证做不到)
//
// 设计原则:
//   - 每 oracle 独立 P2SH stake UTXO (ctor stakerPkX + lockUntilDaa 唯一确定 addr)
//   - 池 = 链上 OracleStake_v1 P2SH UTXO 集合 (跨节点扫链派生, 非 DB 表)
//   - v1 仅 e0 self-unstake; 无 slash 路径 (cost-of-capital + off-chain re-enroll veto 兜底)
//   - Phase 5 升级 = OracleStake_v2 silverc rewrite (新 P2SH addr, 显式版本号迁移)
//
// 锁时语义 (silverc tx.time = tx.lockTime literal):
//   - Kaspa LOCK_TIME_THRESHOLD = 500_000_000_000; lockTime < 500B → DAA score; >= 500B → ms epoch
//   - testnet-12 daa 当前 ~5e8, 远 < 500B → DAA score mode 安全
//   - lockUntilDaa 必 ≥ max(参投 market resolutionDaa) + cooldown_N (caller 保证)
//
// v0.7 红线 8 应用 (Bettor r257 catch, v0.6 同款雷):
//   - 不烤 minerFee 进 ctor (= mempool min-fee 数月后涨过焊死值 → stake 永锁)
//   - output 范围 [in − MAX_FEE, in − MIN_FEE], staker 动态选 fee by TX mass
//   - MIN_FEE = 1000 sompi (允许任意大小 stake unstake)
//   - MAX_FEE = 100_000_000 sompi = 1 KAS (防 over-fee 自损)
//   - dust floor 1000 sompi
//
// 红线 9 (fee-UTXO append) NOT 应用 (Bettor r258/v2 review footgun catch):
//   - e0 self-unstake stake >> fee, 永不需要 append
//   - inputs.length >= 1 + output 卡 inputs[0]−fee → append UTXO 全烧 = footgun
//   - 严格 inputs.length == 1 去 footgun, 不损 functionality
//
// 编译: silverc.exe OracleStake_v1.sil --ctor args.json
//   args.json: { stakerPkX: <32B x-only>, lockUntilDaa: <int> }
pragma silverscript ^0.1.0;

contract OracleStake_v1(
    byte[32] stakerPkX,
    int lockUntilDaa
) {

    // e0 timeout_unlock — staker 自助 unstake, lockUntilDaa 过 + 自签
    //   触发: 所有参投 market 已 settled + cooldown 过, 安全退出
    //   inputs.length == 1 (= 严格单 stake UTXO, 红线 9 不应用 footgun catch)
    //   outputs.length == 1 → P2PK(stakerPk), value 在 fee 范围内
    entrypoint function timeout_unlock(sig stakerSig) {
        require(checkSig(stakerSig, pubkey(stakerPkX)));
        require(tx.time >= lockUntilDaa);

        require(tx.inputs.length == 1);
        require(this.activeInputIndex == 0);
        require(tx.outputs.length == 1);

        byte[34] stakerLock = new ScriptPubKeyP2PK(pubkey(stakerPkX));
        require(tx.outputs[0].scriptPubKey == byte[](stakerLock));

        // v0.7 红线 8: fee 范围 [MIN_FEE=1000, MAX_FEE=1e8] not hardcoded ctor minerFee.
        require(tx.outputs[0].value <= tx.inputs[0].value - 1000);
        require(tx.outputs[0].value >= tx.inputs[0].value - 100000000);
        require(tx.outputs[0].value >= 1000);  // dust floor
    }
}

pragma silverscript ^0.1.0;
// InstantSplit.sil — Kaspa 即时分账结算模板 (J2, 2026-09-27; D-034 §7 收敛, 设计稿
// docs/2026-09-27-j2-instant-split-covenant-template-design-v0.2.md, NWT 两轮攻击面审通过)。
//
// 一次性终态纯 P2SH 合约(设计 §2.1): 无 State/covenant 续约, 资金进入是普通付款(不需要
// populateGenesisCovenants), 两个入口(split/refund)二选一花掉即终结——UTXO 模型本身防重放,
// 不需要 nullifier 位图(对比 PayoutShard 的 merkle+位图, 那是因为它的 UTXO 领取后仍存在)。
//
// 参与者固定三类(商家/broker/引荐人可选), 仅 KAS, 不引入新代币(D-034 §7)。收款人全部按标准
// P2PK 地址处理(TUTORIAL.md "Simple Covenant" 范式: ctor 烤 pubkey, entry 内用
// `new ScriptPubKeyP2PK(pk)` 现场构造 36 字节 scriptPubKey 再比对——不烤成品 scriptPubKey 字节,
// 避免链下自行拼版本前缀/脚本字节出现差异, 交给编译器内建原语保证与链上表示一致)。
//
// split: 任何人可触发, 零签名, 无下界时间检查(设计 §2.3 SHOULD: 时间优势在收款方)。
//   hasChange 两分支按"真实超额 e = 资金输入值 - 收款人总额"互斥穷尽(MUST-新1, NWT 第二轮):
//     hasChange=false ⟺ e <= max_split_fee(超额并入矿工费, 受上限约束)
//     hasChange=true  ⟺ e >  max_split_fee(超额显式找零回付款人, 不留给触发者/矿工)
//   tx.inputs.length==1(追加项——防"同地址多笔资金合并进一笔 split 烧掉其中一笔"的销毁攻击)。
// refund: deadline_ms 之后任何人可触发, 零签名, 同样锁 tx.inputs.length==1, 全额(减手续费上限)
//   退付款人——不管当初是多付还是少付, 退的是链上真实余额。调用方广播时必须把交易自身
//   lockTime 设为 >= deadline_ms(墙钟 CLTV 语义要求 tx 自身 locktime 类型与阈值域匹配, 否则
//   kaspad 报 "mismatched locktime types" 而非正常的 require 判定——这不是本合约的 require, 是
//   底层 txscript 对 temporal()/CLTV 的前置校验, SDK buildRefundTx 已处理)。
//
// max_split_fee / max_refund_fee 的数值来源: docs 设计稿 §4.5 六步法(真实编译产物 + tx-mass-ub.mjs
// 实测三种交易形状 mass, ×100 sompi/gram, ×5-10 安全倍数), 本文件不烤死具体数字——由调用方
// (SDK createSplitProtocol)在 ctor 阶段传入, 每个订单可以用同一套(或不同)运营常量。
//
// 🔴 结构性残余风险(设计稿 §4.6, Bettor 转 NWT 口头补充): 这两个上限是 genesis 时烤死的 ctor
// 常量, 无法应对订单存续期间网络最低费率大幅上调——安全倍数只降低概率, 不能证明永不锁死。
// 缓解手段是缩短 deadline_ms(SDK 默认 72 小时), 不是本合约能在共识层解决的问题。

contract InstantSplit(
    pubkey   merchant_pk,
    int      merchant_amount,
    pubkey   broker_pk,
    int      broker_amount,
    bool     has_referrer,
    pubkey   referrer_pk,
    int      referrer_amount,
    pubkey   payer_refund_pk,
    int      deadline_ms,
    int      max_split_fee,
    int      max_refund_fee,
    byte[32] rule_commit,      // 纯审计冗余, 不参与任何 require(设计 §2.6)
    byte[16] order_nonce       // 强制字段, 防地址碰撞(设计 §2.2/§2.6), 不参与任何 require
) {
    pubkey   m_pk         = merchant_pk;
    int      m_amt        = merchant_amount;
    pubkey   b_pk         = broker_pk;
    int      b_amt        = broker_amount;
    bool     has_ref      = has_referrer;
    pubkey   r_pk         = referrer_pk;
    int      r_amt        = referrer_amount;
    pubkey   refund_pk    = payer_refund_pk;
    int      dl_ms        = deadline_ms;
    int      max_s_fee    = max_split_fee;
    int      max_r_fee    = max_refund_fee;
    byte[32] rcommit      = rule_commit;
    byte[16] nonce        = order_nonce;

    entry split(bool hasChange) {
        require(tx.inputs.length == 1);

        byte[36] mSpk = new ScriptPubKeyP2PK(m_pk);
        byte[36] bSpk = new ScriptPubKeyP2PK(b_pk);
        require(tx.outputs[0].value == m_amt);
        require(tx.outputs[0].scriptPubKey == byte[](mSpk));
        require(tx.outputs[1].value == b_amt);
        require(tx.outputs[1].scriptPubKey == byte[](bSpk));

        if (has_ref) {
            byte[36] rSpk = new ScriptPubKeyP2PK(r_pk);
            require(tx.outputs[2].value == r_amt);
            require(tx.outputs[2].scriptPubKey == byte[](rSpk));
            int recipientsTotal = m_amt + b_amt + r_amt;
            if (hasChange) {
                byte[36] refundSpk = new ScriptPubKeyP2PK(refund_pk);
                require(tx.inputs[this.activeInputIndex].value - recipientsTotal > max_s_fee);
                require(tx.outputs.length == 4);
                require(tx.outputs[3].scriptPubKey == byte[](refundSpk));
                require(tx.outputs[3].value >= tx.inputs[this.activeInputIndex].value - recipientsTotal - max_s_fee);
            } else {
                require(tx.outputs.length == 3);
                require(tx.inputs[this.activeInputIndex].value - recipientsTotal <= max_s_fee);
            }
        } else {
            int recipientsTotal = m_amt + b_amt;
            if (hasChange) {
                byte[36] refundSpk = new ScriptPubKeyP2PK(refund_pk);
                require(tx.inputs[this.activeInputIndex].value - recipientsTotal > max_s_fee);
                require(tx.outputs.length == 3);
                require(tx.outputs[2].scriptPubKey == byte[](refundSpk));
                require(tx.outputs[2].value >= tx.inputs[this.activeInputIndex].value - recipientsTotal - max_s_fee);
            } else {
                require(tx.outputs.length == 2);
                require(tx.inputs[this.activeInputIndex].value - recipientsTotal <= max_s_fee);
            }
        }
    }

    entry refund() {
        require(tx.inputs.length == 1);
        require(tx.time >= temporal(dl_ms));
        require(tx.outputs.length == 1);
        byte[36] refundSpk = new ScriptPubKeyP2PK(refund_pk);
        require(tx.outputs[0].scriptPubKey == byte[](refundSpk));
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - max_r_fee);
    }
}

# Console server
PORT=3100

# Encryption key for sensitive config values (32 bytes hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONSOLE_ENCRYPTION_KEY=

# Ingest secret - shared with relay and adapter
# Auto-generated on first run if not set, stored in DB
# Copy the displayed secret to relay/adapter env as INGEST_SECRET
INGEST_SECRET=

# Adapter URL (for manual reply passthrough)
ADAPTER_URL=http://localhost:3000

# SQLite database path
DB_PATH=./data/console.db

@@ -0,0 +1,354 @@
+//! D-c: relay-mode self-triggered IBD — pure per-peer state machine (no I/O), so the decision logic is unit-testable
+//! without a router. `IbdFlow::start_impl` drives it from the idle (timeout) branch of `relay_receiver.recv()`.
+//!
+//! Design: docs/2026-09-06-bettor-dc-relay-mode-self-trigger-ibd-design-v0.1.md §4 + §9 (v0.1.1, NWT red-team items).
+//! Rules (design §4.2 / §9): per-peer exponential backoff (×2, capped); "compare before contending" (peer sink must have
+//! strictly greater blue work AND daa >= local + DAA_MARGIN); CAS failure does not enqueue; only peers that completed at
+//! least one IBD with us are eligible (fake-sink DoS mitigation, §9④); transient errors back off, protocol errors keep the
+//! original `return Err` (disconnect) semantics (§9⑥).
+
+use kaspa_p2p_lib::common::ProtocolError;
+use std::time::{Duration, Instant};
+
+/// Peer sink must be at least this many DAA ahead of the local sink to be worth an IBD (design §9⑤, ≈1 min at 10 bps).
+pub const DAA_MARGIN: u64 = 600;
+/// Initial backoff after a failed self-trigger attempt; doubles up to `SelfTriggerCfg::backoff_max`.
+pub const BACKOFF_BASE: Duration = Duration::from_secs(60);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SelfTriggerCfg {
+    /// Sink-timestamp lag at/above which we self-trigger. `Duration::ZERO` disables the feature entirely
+    /// (the flow then behaves exactly as before: plain `relay_receiver.recv()`).
+    pub lag_threshold: Duration,
+    /// Idle interval of the `relay_receiver` wait after which the self-trigger check runs.
+    pub check_interval: Duration,
+    /// Cap for the exponential backoff.
+    pub backoff_max: Duration,
+}
+
+impl SelfTriggerCfg {
+    pub fn from_secs(lag_secs: u64, check_secs: u64, backoff_max_secs: u64) -> Self {
+        Self {
+            lag_threshold: Duration::from_secs(lag_secs),
+            check_interval: Duration::from_secs(check_secs.max(1)),
+            backoff_max: Duration::from_secs(backoff_max_secs.max(1)),
+        }
+    }
+    pub fn enabled(&self) -> bool {
+        !self.lag_threshold.is_zero()
+    }
+}
+
+/// Why the idle branch decided not to (or to) attempt a self-trigger this round.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Gate {
+    Disabled,
+    IbdRunning,
+    /// Peer never completed an IBD with us (design §9④): not eligible yet.
+    NotEligible,
+    /// Still inside backoff; remaining time.
+    Backoff(Duration),
+    /// Sink lag below threshold; current lag.
+    LagBelow(Duration),
+    /// Attempt now; current lag.
+    Ready(Duration),
+}
+
+/// How a failure in the self-trigger branch must be handled (design §9⑥).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ErrClass {
+    /// Timeout / peer state oddity: back off and keep the flow (and the connection) alive.
+    Transient,
+    /// Protocol / data-validity errors (finality conflict, pruning-point inconsistencies, malformed or unexpected
+    /// messages, consensus rule errors): keep the original semantics — propagate `Err` so the flow exits and the
+    /// peer is disconnected.
+    Protocol,
+    /// The connection is already gone; the flow must exit.
+    Closed,
+}
+
+/// Where in the self-trigger sequence an error happened (NWT review MUST③: classification is per stage).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Stage {
+    /// `get_syncer_chain_block_locator(None, None)` — we are the requester; any odd reply is the peer's momentary state.
+    Locator,
+    /// `request_single_block` — same: we are the requester.
+    Block,
+    /// `ibd()` itself — the original IBD error semantics apply (finality / pruning-point / consensus errors disconnect).
+    Ibd,
+}
+
+pub fn classify(err: &ProtocolError, stage: Stage) -> ErrClass {
+    if matches!(err, ProtocolError::ConnectionClosed) {
+        return ErrClass::Closed;
+    }
+    match stage {
+        // Requester stages: timeouts, unexpected/malformed replies, empty locators, header-only blocks — all are
+        // "peer did not give us what we asked for right now": back off and keep the connection (MUST③).
+        Stage::Locator | Stage::Block => ErrClass::Transient,
+        Stage::Ibd => match err {
+            ProtocolError::Timeout(_) => ErrClass::Transient,
+            // Empty locator inside negotiation = peer momentarily has nothing to offer (design §4.1).
+            ProtocolError::Other(s) if s.starts_with("Expecting initial syncer chain block locator") => ErrClass::Transient,
+            _ => ErrClass::Protocol,
+        },
+    }
+}
+
+#[derive(Debug)]
+pub struct SelfTriggerState {
+    backoff: Duration,
+    backoff_until: Option<Instant>,
+    completed_ibd_once: bool,
+    not_eligible_logged: bool,
+    /// Counters for logs / acceptance (§6 补 iv: stale-drop count must stay bounded).
+    pub stale_dropped: u64,
+    pub triggers: u64,
+    pub failures: u64,
+}
+
+impl Default for SelfTriggerState {
+    fn default() -> Self {
+        Self {
+            backoff: BACKOFF_BASE,
+            backoff_until: None,
+            completed_ibd_once: false,
+            not_eligible_logged: false,
+            stale_dropped: 0,
+            triggers: 0,
+            failures: 0,
+        }
+    }
+}
+
+impl SelfTriggerState {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Mark that this peer completed an IBD with us (natural or self-triggered) — makes it eligible (design §9④).
+    pub fn mark_completed_ibd(&mut self) {
+        self.completed_ibd_once = true;
+    }
+
+    pub fn completed_ibd_once(&self) -> bool {
+        self.completed_ibd_once
+    }
+
+    pub fn current_backoff(&self) -> Duration {
+        self.backoff
+    }
+
+    /// Returns true exactly once: the first time the caller sees `Gate::NotEligible` (so ops get one info line
+    /// explaining why no self-trigger happens until the first completed IBD — NWT review SHOULD②).
+    pub fn take_not_eligible_notice(&mut self) -> bool {
+        if self.not_eligible_logged {
+            return false;
+        }
+        self.not_eligible_logged = true;
+        true
+    }
+
+    /// Decide whether to attempt a self-trigger this idle round. Pure function of the inputs.
+    pub fn gate(&self, cfg: &SelfTriggerCfg, now: Instant, ibd_running: bool, lag: Duration) -> Gate {
+        if !cfg.enabled() {
+            return Gate::Disabled;
+        }
+        if ibd_running {
+            return Gate::IbdRunning;
+        }
+        if !self.completed_ibd_once {
+            return Gate::NotEligible;
+        }
+        if let Some(until) = self.backoff_until
+            && now < until
+        {
+            return Gate::Backoff(until - now);
+        }
+        if lag < cfg.lag_threshold {
+            return Gate::LagBelow(lag);
+        }
+        Gate::Ready(lag)
+    }
+
+    /// Record a failed attempt: doubles the backoff (capped) and arms `backoff_until`. Returns the backoff applied.
+    pub fn record_failure(&mut self, cfg: &SelfTriggerCfg, now: Instant) -> Duration {
+        self.failures += 1;
+        let applied = self.backoff.min(cfg.backoff_max);
+        self.backoff_until = Some(now + applied);
+        self.backoff = (applied * 2).min(cfg.backoff_max);
+        applied
+    }
+
+    /// Record a successful self-triggered IBD: backoff returns to base, no armed backoff.
+    pub fn record_success(&mut self) {
+        self.triggers += 1;
+        self.backoff = BACKOFF_BASE;
+        self.backoff_until = None;
+        self.completed_ibd_once = true;
+    }
+}
+
+/// "Compare before contending" (design §9⑤): the peer's sink must have strictly greater blue work and be at least
+/// `DAA_MARGIN` DAA ahead of the local sink. `blue_work` is compared as the caller's ordered type via `Ord`.
+pub fn should_contend<W: PartialOrd>(local_blue_work: W, local_daa: u64, peer_blue_work: W, peer_daa: u64) -> bool {
+    peer_blue_work > local_blue_work && peer_daa >= local_daa.saturating_add(DAA_MARGIN)
+}
+
+/// Sink lag from the sink header timestamp (ms since epoch), same source as `MiningRuleEngine::is_nearly_synced`.
+/// Clock skew making the sink "in the future" yields zero lag (never negative).
+pub fn sink_lag(now_unix_ms: u64, sink_timestamp_ms: u64) -> Duration {
+    Duration::from_millis(now_unix_ms.saturating_sub(sink_timestamp_ms))
+}
+
+/// First-wait jitter ∈ [0, check_interval) so flows created together do not all check in the same instant (§9 Q4).
+pub fn initial_jitter(cfg: &SelfTriggerCfg, rand_unit: f64) -> Duration {
+    let f = rand_unit.clamp(0.0, 0.999_999);
+    cfg.check_interval.mul_f64(f)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cfg() -> SelfTriggerCfg {
+        SelfTriggerCfg::from_secs(480, 60, 1800)
+    }
+    fn eligible() -> SelfTriggerState {
+        let mut s = SelfTriggerState::new();
+        s.mark_completed_ibd();
+        s
+    }
+    const S: fn(u64) -> Duration = Duration::from_secs;
+
+    #[test]
+    fn self_trigger_disabled_when_lag_secs_zero() {
+        let c = SelfTriggerCfg::from_secs(0, 60, 1800);
+        assert!(!c.enabled());
+        assert_eq!(eligible().gate(&c, Instant::now(), false, S(10_000)), Gate::Disabled);
+    }
+
+    #[test]
+    fn timeout_branch_skips_when_ibd_running() {
+        assert_eq!(eligible().gate(&cfg(), Instant::now(), true, S(10_000)), Gate::IbdRunning);
+    }
+
+    #[test]
+    fn not_eligible_before_first_completed_ibd() {
+        assert_eq!(SelfTriggerState::new().gate(&cfg(), Instant::now(), false, S(10_000)), Gate::NotEligible);
+        let mut s = SelfTriggerState::new();
+        s.mark_completed_ibd();
+        assert!(matches!(s.gate(&cfg(), Instant::now(), false, S(10_000)), Gate::Ready(_)));
+    }
+
+    #[test]
+    fn timeout_branch_skips_within_backoff() {
+        let mut s = eligible();
+        let t0 = Instant::now();
+        let applied = s.record_failure(&cfg(), t0);
+        assert_eq!(applied, BACKOFF_BASE);
+        assert!(matches!(s.gate(&cfg(), t0 + S(30), false, S(10_000)), Gate::Backoff(_)));
+        assert!(matches!(s.gate(&cfg(), t0 + S(60), false, S(10_000)), Gate::Ready(_)));
+    }
+
+    #[test]
+    fn lag_below_threshold_no_request() {
+        assert_eq!(eligible().gate(&cfg(), Instant::now(), false, S(479)), Gate::LagBelow(S(479)));
+    }
+
+    #[test]
+    fn lag_at_threshold_is_ready() {
+        assert_eq!(eligible().gate(&cfg(), Instant::now(), false, S(480)), Gate::Ready(S(480)));
+    }
+
+    #[test]
+    fn backoff_doubles_to_cap() {
+        let mut s = eligible();
+        let c = cfg();
+        let t0 = Instant::now();
+        let mut seen = vec![];
+        for i in 0..8 {
+            seen.push(s.record_failure(&c, t0 + S(i * 10_000)).as_secs());
+        }
+        assert_eq!(seen, vec![60, 120, 240, 480, 960, 1800, 1800, 1800]);
+    }
+
+    #[test]
+    fn ibd_ok_resets_backoff() {
+        let mut s = eligible();
+        let c = cfg();
+        let t0 = Instant::now();
+        s.record_failure(&c, t0);
+        s.record_failure(&c, t0);
+        assert!(s.current_backoff() > BACKOFF_BASE);
+        s.record_success();
+        assert_eq!(s.current_backoff(), BACKOFF_BASE);
+        assert!(matches!(s.gate(&c, t0, false, S(10_000)), Gate::Ready(_)));
+        assert_eq!(s.triggers, 1);
+    }
+
+    #[test]
+    fn not_newer_no_contend() {
+        // equal blue work ⇒ no; greater blue work but daa margin not met ⇒ no; both ⇒ yes
+        assert!(!should_contend(100u64, 1000, 100u64, 5000));
+        assert!(!should_contend(100u64, 1000, 101u64, 1000 + DAA_MARGIN - 1));
+        assert!(should_contend(100u64, 1000, 101u64, 1000 + DAA_MARGIN));
+        assert!(!should_contend(100u64, 1000, 99u64, 1_000_000));
+    }
+
+    #[test]
+    fn sink_lag_never_negative() {
+        assert_eq!(sink_lag(1_000_000, 1_500_000), Duration::ZERO);
+        assert_eq!(sink_lag(1_500_000, 1_000_000), Duration::from_millis(500_000));
+    }
+
+    #[test]
+    fn initial_jitter_within_check_interval() {
+        let c = cfg();
+        assert_eq!(initial_jitter(&c, 0.0), Duration::ZERO);
+        assert!(initial_jitter(&c, 0.5) >= S(29) && initial_jitter(&c, 0.5) <= S(31));
+        assert!(initial_jitter(&c, 1.0) < c.check_interval);
+        assert!(initial_jitter(&c, 7.0) < c.check_interval);
+    }
+
+    #[test]
+    fn classify_ibd_stage_transient_vs_protocol() {
+        let s = Stage::Ibd;
+        assert_eq!(classify(&ProtocolError::Timeout(S(1)), s), ErrClass::Transient);
+        assert_eq!(classify(&ProtocolError::ConnectionClosed, s), ErrClass::Closed);
+        assert_eq!(
+            classify(&ProtocolError::Other("Expecting initial syncer chain block locator to contain at least one element"), s),
+            ErrClass::Transient
+        );
+        assert_eq!(
+            classify(&ProtocolError::Other("peer is in a finality conflict with the local pruning point"), s),
+            ErrClass::Protocol
+        );
+        assert_eq!(classify(&ProtocolError::Other("pruning points are violating finality"), s), ErrClass::Protocol);
+        assert_eq!(classify(&ProtocolError::OtherOwned("expected block a but got b".into()), s), ErrClass::Protocol);
+        assert_eq!(classify(&ProtocolError::Other("sent header of x where expected block with body"), s), ErrClass::Protocol);
+    }
+
+    #[test]
+    fn classify_requester_stages_are_transient_except_closed() {
+        for s in [Stage::Locator, Stage::Block] {
+            assert_eq!(classify(&ProtocolError::Timeout(S(1)), s), ErrClass::Transient);
+            assert_eq!(classify(&ProtocolError::UnexpectedMessage("IbdChainBlockLocator", None), s), ErrClass::Transient);
+            assert_eq!(classify(&ProtocolError::Other("sent header of x where expected block with body"), s), ErrClass::Transient);
+            assert_eq!(classify(&ProtocolError::OtherOwned("expected block a but got b".into()), s), ErrClass::Transient);
+            assert_eq!(
+                classify(&ProtocolError::Other("peer is in a finality conflict with the local pruning point"), s),
+                ErrClass::Transient
+            );
+            assert_eq!(classify(&ProtocolError::ConnectionClosed, s), ErrClass::Closed);
+        }
+    }
+
+    #[test]
+    fn not_eligible_notice_fires_once() {
+        let mut s = SelfTriggerState::new();
+        assert!(s.take_not_eligible_notice());
+        assert!(!s.take_not_eligible_notice());
+        assert!(!s.take_not_eligible_notice());
+    }
+}

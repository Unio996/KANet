        "span": "entrypoint function recovery_daa(int selfInIdx) {\n        int e = OpTxInputDaaScore(selfInIdx) + n_probe;         // d + N: 锚在自身输入(被花 UTXO)的创建 DAA\n        require(e >= 0);\n        require(e < 500000000000);                               // LOCK_TIME_THRESHOLD: 守住 DAA 域, 不得漂到时间类\n        require(tx.time >= e);                                   // = CLTV(e): 块 DAA > tx.lockTime >= e\n        require(phase == 1);\n        byte[32] self_cov = OpInputCovenantId(selfInIdx);\n        require(OpCovOutputCount(self_cov) == 0);\n    }",

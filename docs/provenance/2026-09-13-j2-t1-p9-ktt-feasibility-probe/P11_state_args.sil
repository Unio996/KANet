pragma silverscript ^0.1.0;
// P11: 模板 hash / 前后缀长度 作为【状态字段】(运行期值) 喂 readInputStateWithTemplate;
//      validateOutputStateWithTemplate 的前后缀字节由 witness 供、hash 由状态供 ⇒ 换值 template_hash 应不变
contract P11Host(int init_m_prefix_len, int init_m_suffix_len, byte[32] init_m_hash, byte[32] init_c_hash, int init_nonce) {
    struct Foreign { int amount; byte[32] owner; }
    int      m_prefix_len = init_m_prefix_len;
    int      m_suffix_len = init_m_suffix_len;
    byte[32] m_hash       = init_m_hash;
    byte[32] c_hash       = init_c_hash;
    int      nonce        = init_nonce;

    #[covenant.singleton]
    function use(State prevState, State newState, int m_idx, int out_k, Foreign out_state, byte[] c_prefix, byte[] c_suffix) {
        require(newState.m_prefix_len == prevState.m_prefix_len);
        require(newState.m_suffix_len == prevState.m_suffix_len);
        require(newState.m_hash == prevState.m_hash);
        require(newState.c_hash == prevState.c_hash);
        require(newState.nonce == prevState.nonce + 1);
        Foreign m = readInputStateWithTemplate(m_idx, prevState.m_prefix_len, prevState.m_suffix_len, prevState.m_hash);
        require(m.amount > 0);
        validateOutputStateWithTemplate(out_k, out_state, c_prefix, c_suffix, prevState.c_hash);
        require(OpOutputCovenantId(out_k) == m.owner);
    }
}

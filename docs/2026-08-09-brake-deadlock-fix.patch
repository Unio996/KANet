 $MAX_ROUNDS  = if ($env:TN12_MAX_ROUNDS)  { [int]$env:TN12_MAX_ROUNDS }  else { 0 }    # 0 = run forever
+# Duty cycle used while braked. Must stay well under POLL_SEC's cadence so each poll still

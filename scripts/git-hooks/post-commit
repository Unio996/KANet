#!/usr/bin/env bash
# KANet post-commit hook (T-NWT-2026-04-27)
# commit 完自动跑相关 domain 的 test-framework case, 失败 broadcast dev-coord.
#
# 设计原则 (Owner 钦定 '自治测试'):
# - 异步: 不阻塞 commit, 后台跑
# - 智能选择: 看 git diff 改了什么, 推测影响哪个 domain
# - 失败 broadcast: 链上通知三方 + agent (dev-coord channel)
# - 成功不打扰: PASS 静默, 失败才喧闹
#
# Bypass: 本 hook 不阻塞 commit, 跑测失败也不影响 commit. 失败信息 = warning.
# 完全跳过: 删 hook 文件 OR git config core.hooksPath /dev/null

set +e  # 不阻塞: 跑测失败也不阻 commit (post-commit 已经过了)

KANET_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
LOG_DIR="$KANET_ROOT/logs"
LOG="$LOG_DIR/post-commit-test.log"
mkdir -p "$LOG_DIR"

# Auto-refresh D:/kanet-sync.bundle so :9201 static server serves fresh master HEAD.
# (NWT :9202 + J2 :9203 走 live regen 每 GET; J1 :9201 是 Owner-owned static service,
# kill 越界, post-commit hook auto refresh = static 文件每 commit 自动同步, 无 race.)
# 三方 22:50 align option B (J1 446717a2 propose + NWT dd9991f3 ack).
git bundle create D:/kanet-sync.bundle master >/dev/null 2>&1 || true

# 取本次 commit 改的文件
COMMIT_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)

if [ -z "$COMMIT_FILES" ]; then
  exit 0
fi

# domain 推断: file path → domain
# broker domain triggers:
#   - kasia-console/src/services/broker-*.js
#   - kasia-console/src/services/{exchange-machine,asset-registry,chains,price-oracle,evm-transfer}*.js
#   - kasia-console/src/api/conversations.js
#   - kasia-console/test-framework/cases/broker/*.test.mjs (case 改自身)
#   - kasia-console/test-framework/personas/*.mjs (persona 改触发所有 domain)
#   - kasia-console/test-framework/lib/*.mjs (lib 改触发所有 domain — runner 影响全域)
# 未来 seeker domain 加同模式
#
# NWT N16.5 5/18 (b) 补强: exchange domain + system domain (Playwright UI) 加 cron 触发
# - exchange: kasia-console/src/api/exchange.js + services/exchange-machine*.js + services/exchange-verifiers*.js + cases/exchange/*
# - system: src/ui/*.eta + cases/system/*.test.mjs (Playwright UI smoke 自动)
infer_domains() {
  local domains=""
  if echo "$COMMIT_FILES" | grep -qE 'kasia-console/(src/services/(broker-|exchange-machine|asset-registry|chains|price-oracle|evm-transfer)|src/api/conversations|test-framework/cases/broker)'; then
    domains="$domains broker"
  fi
  if echo "$COMMIT_FILES" | grep -qE 'kasia-console/(src/api/exchange|src/services/exchange-(machine|verifiers|orders|client)|test-framework/cases/exchange)'; then
    domains="$domains exchange"
  fi
  # NWT N16.5 (b): system domain = Playwright UI cases. 触发 condition: UI eta / api 改动 / system case 自身改.
  if echo "$COMMIT_FILES" | grep -qE 'kasia-console/(src/ui/.*\.eta|src/api/(exchange|conversations|relay)|test-framework/cases/system)'; then
    domains="$domains system"
  fi
  # framework 核心改动 → 跑所有 domain
  if echo "$COMMIT_FILES" | grep -qE 'kasia-console/test-framework/(lib|personas|adversarial)'; then
    [ -z "$domains" ] && domains="broker exchange system"
  fi
  # dedup
  echo "$domains" | tr ' ' '\n' | sort -u | tr '\n' ' '
}

DOMAINS=$(infer_domains)

# 没有相关 domain → 跳
if [ -z "$DOMAINS" ]; then
  exit 0
fi

# 检查 console 是否在跑 (test-framework 用 /api/agent/reply)
if ! curl -sf http://127.0.0.1:3100/api/chat/channels >/dev/null 2>&1; then
  echo "[post-commit] console 不在跑, 跳过 framework verify (commit 已提交)" | tee -a "$LOG"
  exit 0
fi

COMMIT_HASH=$(git rev-parse --short HEAD)
COMMIT_MSG=$(git log -1 --pretty=%s | tr -d '\r' | head -c 80)

echo "" >> "$LOG"
echo "═══ post-commit $COMMIT_HASH $(date '+%H:%M:%S') ═══" >> "$LOG"
echo "files: $(echo "$COMMIT_FILES" | head -c 200)" >> "$LOG"
echo "domains: $DOMAINS" >> "$LOG"

# 异步跑: 后台 fork, post-commit 立刻返
# NWT N16.5 5/18 补强 (a)+(c):
# (a) case count + duration metric: 每 domain 跑完 log "[post-commit] $DOMAIN: PASS N cases in Ts" (PASS) OR FAIL detail
# (c) failure broadcast 含 first FAIL case name + first error line (不仅 count)
(
  cd "$KANET_ROOT/kasia-console"

  for DOMAIN in $DOMAINS; do
    echo "[post-commit] running framework: --domain=$DOMAIN" >> "$LOG"
    START_S=$(date +%s)
    OUTPUT=$(node scripts/test.mjs --domain="$DOMAIN" --quiet 2>&1)
    EXIT_CODE=$?
    END_S=$(date +%s)
    DURATION_S=$((END_S - START_S))
    echo "$OUTPUT" >> "$LOG"

    # (a) metric: parse 'Summary: N PASS / M FAIL / T run' 行
    SUMMARY_LINE=$(echo "$OUTPUT" | grep -E '^Summary:' | tail -1)
    CASE_COUNT=$(echo "$SUMMARY_LINE" | grep -oE '[0-9]+ run' | grep -oE '[0-9]+' || echo "?")
    PASS_COUNT=$(echo "$SUMMARY_LINE" | grep -oE '[0-9]+ PASS' | grep -oE '[0-9]+' || echo "?")
    FAIL_COUNT=$(echo "$SUMMARY_LINE" | grep -oE '[0-9]+ FAIL' | grep -oE '[0-9]+' || echo "?")

    if [ $EXIT_CODE -ne 0 ]; then
      # (c) failure: 首 FAIL case name + first error line
      FAIL_CASE=$(echo "$OUTPUT" | grep -E '^✗ FAIL \|' | head -1 | sed 's/^✗ FAIL | //;s/ (.*//;s/$//' | head -c 80)
      FAIL_REASON=$(echo "$OUTPUT" | grep -A 5 '^✗ FAIL' | grep -E '✗|error|FAIL|TypeError|SyntaxError' | head -2 | head -c 200)

      BROADCAST_MSG="🚨 [post-commit] $COMMIT_HASH 撞 framework regression
commit: $COMMIT_MSG
domain: $DOMAIN ($CASE_COUNT cases, ${DURATION_S}s, $PASS_COUNT PASS / $FAIL_COUNT FAIL)
first FAIL: $FAIL_CASE
reason: $FAIL_REASON

trace: $LOG"

      # 用 NWT relay 广播 (硬编码 NWT relayId, 因 hook 在哪个 agent 名下不一定)
      # 失败也不重试, hook 是 best-effort 通知
      curl -sf -X POST http://127.0.0.1:3100/api/chat/send \
        -H "Content-Type: application/json" \
        -d "$(node -e "
          const msg = process.argv[1];
          process.stdout.write(JSON.stringify({
            relayId: '5b236c08-03d0-456c-953d-e10001610938',
            channel: 'dev-coord',
            message: msg,
          }));
        " "$BROADCAST_MSG")" >> "$LOG" 2>&1 || echo "[post-commit] broadcast failed (console maybe down)" >> "$LOG"

      echo "[post-commit] $DOMAIN: FAIL ($CASE_COUNT cases, ${DURATION_S}s, $PASS_COUNT PASS / $FAIL_COUNT FAIL) — first '$FAIL_CASE'" >> "$LOG"
    else
      echo "[post-commit] $DOMAIN: PASS ($CASE_COUNT cases, ${DURATION_S}s)" >> "$LOG"
    fi
  done
) &

# 不等子进程, post-commit 立刻返
disown 2>/dev/null || true
exit 0

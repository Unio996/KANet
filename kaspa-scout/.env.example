# Console API
CONSOLE_URL=http://localhost:3100
INGEST_SECRET=your_ingest_secret_here

# Scan mode: 'rpc' (real-time blocks) or 'indexer' (timed polling)
SCAN_MODE=rpc

# RPC mode settings
KASPA_RPC_URL=ws://127.0.0.1:17110
KASPA_NETWORK=mainnet

# Indexer mode settings (fallback)
SCAN_INTERVAL_MS=30000
KASIA_INDEXER_URL=https://indexer.kasia.fyi

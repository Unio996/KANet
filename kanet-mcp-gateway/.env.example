# Public MCP listener. Keep localhost-bound and publish through an HTTPS reverse proxy.
KANET_MCP_HOST=127.0.0.1
KANET_MCP_PORT=3215

# Token presented by Codex to the MCP endpoint. Generate at least 32 random bytes.
KANET_MCP_TOKEN=replace-with-a-long-random-token

# Separate token used only from Gateway to Console. It must match Console's value.
KANET_MCP_INTERNAL_TOKEN=replace-with-a-different-long-random-token

# Explicit Console endpoint; do not expose Console itself to the public network.
KANET_CONSOLE_URL=http://127.0.0.1:3200

# Optional hardening when binding beyond localhost (comma-separated hostnames).
KANET_MCP_ALLOWED_HOSTS=

KANET_MCP_REQUEST_TIMEOUT_MS=30000

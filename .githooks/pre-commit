#!/bin/sh
# KANet pre-commit hook — 真装版 (2026-06-29 真落地·非 CLAUDE.md 假声明)
#
# 激活 (新 clone 一次性 setup):
#   git config core.hooksPath .githooks
#
# 内容:
#   ① lint-kanet (block on fail): 只扫 staged 文件 (~1-2s)
#   ② check-tree-fresh (warn-not-block): 落后 canonical 超阈值 LOUD warn

# ① lint-kanet: staged .js/.mjs/.cjs/.sil 文件
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.(js|mjs|cjs|sil)$')
if [ -n "$STAGED" ]; then
  node scripts/lint-kanet.mjs $STAGED
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "[pre-commit] ✗ lint-kanet 失败·commit 拦截. 修完再 commit."
    echo "  手动重跑: node scripts/lint-kanet.mjs $STAGED"
    exit 1
  fi
fi

# ② check-tree-fresh: warn-not-block (|| true 确保 warn 不挡 commit)
node scripts/check-tree-fresh.mjs || true

# ③ check-tests-fresh: warn-not-block (2026-07-28, Bettor 06:50 裁定 A 部分)
#   回答的是【有没有人在跑用例】, 不是【跑的结果对不对】——本仓无 CI 无 cron,
#   而 pre-commit 是唯一一个"一定会有人经过"的位置。
node scripts/check-tests-fresh.mjs || true

# ④ check-worktree-junctions: block-on-fail (2026-09-14, Bettor 1281/1287 派工·规则81机制化，
#   设计 docs/2026-09-14-kanetui-worktree-junction-gate-mechanical-design-v0.1.md，J2 审 GREEN-with-notes)
#   跨树 →LIVE/external 链存在 = 本机 worktree 处于危险状态(删任一侧树都可能连坐)，不该让这种
#   状态下还能继续往前推进。退出码 1=发现坏链，3=扫描自身出错(git worktree list 失败等)——
#   两者都拦，文案分开方便一眼看出是哪一档，不需要读日志文本猜。
node scripts/check-worktree-junctions.mjs --all
STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo ""
  if [ $STATUS -eq 3 ]; then
    echo "[pre-commit] ✗ 跨树 junction 检查本身出错(未能扫完，不是扫完发现干净)·commit 拦截."
  else
    echo "[pre-commit] ✗ 检测到跨树 junction (→LIVE 或 external)·commit 拦截."
  fi
  echo "  规则81: 删 worktree 前先拆链 (cmd: rmdir <link> / PowerShell: [System.IO.Directory]::Delete(link,\$false))"
  echo "  手动重跑: node scripts/check-worktree-junctions.mjs --all"
  exit 1
fi

exit 0
